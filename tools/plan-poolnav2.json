{
  "url": "http://127.0.0.1:8123/_test-update.html",
  "width": 390, "height": 844, "dpr": 2, "outDir": "shots/reg",
  "preScript": "window.__errs=[];window.addEventListener('error',function(e){window.__errs.push(e.message)});",
  "shots": [
    { "name": "Q01", "wait": 4000, "after": 300,
      "js": "(function(){document.querySelector('[data-tab=overview]').click();return 'ok'})()" },
    { "name": "Q02-pool", "after": 6000, "wait": 200,
      "js": "(function(){var b=Array.from(document.querySelectorAll('[data-act=ov-mode]')).filter(function(x){return x.dataset.m==='pool'})[0];b.click();return 'ok'})()" },
    { "name": "Q03-more", "after": 6000, "wait": 200,
      "js": "(function(){var b=document.querySelector('[data-act=pool-more]');if(!b)return{noMore:true};b.click();return 'ok'})()" },
    { "name": "Q04-star", "after": 1000, "wait": 200,
      "js": "(function(){var cards=Array.from(document.querySelectorAll('.actcard[data-act=pool-student]'));var s=cards.filter(function(c){return c.dataset.name.indexOf('星野')>=0})[0];if(!s)return{noStar:true,names:cards.map(function(c){return c.dataset.name})};s.click();return new Promise(function(r){setTimeout(function(){r({picker:!!document.getElementById('pick-modal'),items:Array.from(document.querySelectorAll('[data-act=pick-item]')).map(function(x){return x.textContent.replace('›','').trim()}),detail:(document.querySelector('.hero-info h2')||{}).textContent})},1500)})})()" },
    { "name": "Q05-pick", "after": 600, "wait": 100,
      "js": "(function(){var b=document.querySelector('[data-act=pick-item]');if(!b)return{noItem:true};b.click();return new Promise(function(r){setTimeout(function(){r({detailName:(document.querySelector('.hero-info h2')||{}).textContent,pickerGone:!document.getElementById('pick-modal')})},1500)})})()" },
    { "name": "Q06-miss", "after": 600, "wait": 100,
      "js": "(function(){var b=document.querySelector('[data-act=back]');if(b)b.click();return new Promise(function(r){setTimeout(function(){var cards=Array.from(document.querySelectorAll('.actcard[data-act=pool-student]'));var m=cards.filter(function(c){return c.dataset.name.indexOf('綺羅羅')>=0||c.dataset.name.indexOf('繪里香')>=0})[0];if(!m)return r({noMiss:true});m.click();setTimeout(function(){var root=document.getElementById('nt-view');r({docOverlay:!!root,toast:(document.querySelector('.toast')||{}).textContent})},3000)},700)})})()" },
    { "name": "Q07-errs", "after": 500, "wait": 100,
      "js": "(function(){return {errs:window.__errs}})()" }
  ]
}
