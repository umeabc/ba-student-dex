{
  "url": "http://127.0.0.1:8123/_test-update.html",
  "width": 390, "height": 844, "dpr": 2, "outDir": "shots/reg",
  "preScript": "window.__errs=[];window.addEventListener('error',function(e){window.__errs.push(e.message)});",
  "shots": [
    { "name": "P01", "wait": 4000, "after": 300,
      "js": "(function(){document.querySelector('[data-tab=overview]').click();return 'ok'})()" },
    { "name": "P02-pool", "after": 6000, "wait": 200,
      "js": "(function(){var b=Array.from(document.querySelectorAll('[data-act=ov-mode]')).filter(function(x){return x.dataset.m==='pool'})[0];b.click();return 'ok'})()" },
    { "name": "P03-click", "after": 6000, "wait": 200,
      "js": "(function(){var c=document.querySelector('.actcard[data-act=pool-student]');if(!c)return{noCard:true};var name=c.dataset.name;c.click();return new Promise(function(r){setTimeout(function(){r({poolName:name,detailName:(document.querySelector('.hero-info h2')||{}).textContent,picker:!!document.getElementById('pick-modal'),detailOpen:document.getElementById('detail').classList.contains('in')})},1500)})})()" },
    { "name": "P04-back", "after": 600, "wait": 100,
      "js": "(function(){var b=document.querySelector('[data-act=back]');if(b)b.click();return new Promise(function(r){setTimeout(function(){r({list:document.querySelectorAll('.actcard').length})},800)})})()" },
    { "name": "P05-ambiguous", "after": 500, "wait": 100,
      "js": "(function(){var b=Array.from(document.querySelectorAll('[data-act=pool-tag]')).filter(function(x){return x.textContent==='全部'})[0];if(b)b.click();return new Promise(function(r){setTimeout(function(){var cards=Array.from(document.querySelectorAll('.actcard[data-act=pool-student]'));var star=cards.filter(function(c){return c.dataset.name.indexOf('星野')>=0})[0];if(!star)return r({noStar:true,names:cards.slice(0,6).map(function(c){return c.dataset.name})});star.click();setTimeout(function(){r({picker:!!document.getElementById('pick-modal'),items:Array.from(document.querySelectorAll('[data-act=pick-item]')).map(function(x){return x.textContent.replace('›','').trim()})})},1200)},800)})})()" },
    { "name": "P06-pick", "after": 500, "wait": 100,
      "js": "(function(){var b=document.querySelector('[data-act=pick-item]');if(!b)return{noItem:true};var t=b.textContent;b.click();return new Promise(function(r){setTimeout(function(){r({picked:t.replace('›','').trim(),detailName:(document.querySelector('.hero-info h2')||{}).textContent})},1500)})})()" },
    { "name": "P07-errs", "after": 500, "wait": 100,
      "js": "(function(){return {errs:window.__errs}})()" }
  ]
}
