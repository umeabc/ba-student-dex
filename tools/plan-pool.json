{
  "url": "http://127.0.0.1:8123/_test-update.html",
  "width": 390, "height": 844, "dpr": 3, "outDir": "shots",
  "preScript": "window.__errs=[];window.addEventListener('error',function(e){window.__errs.push('error: '+e.message)});",
  "shots": [
    { "name": "PK1-activity", "wait": 2600, "after": 300,
      "js": "(function(){var m=document.getElementById('update-modal');if(m){var b=document.querySelector('[data-act=modal-close]');if(b)b.click();}document.querySelector('[data-tab=overview]').click();return 'ok'})()" },
    { "name": "PK2-pool", "after": 6000, "wait": 200,
      "js": "(function(){var b=Array.from(document.querySelectorAll('[data-act=ov-mode]')).filter(function(x){return x.dataset.m==='pool'})[0];if(!b)return{noBtn:true};b.click();return {actCards:document.querySelectorAll('.actcard').length}})()" },
    { "name": "PK3-pool-loaded", "after": 6000, "wait": 300,
      "js": "(function(){var cards=document.querySelectorAll('.actcard');return {cards:cards.length,sections:Array.from(document.querySelectorAll('.section-title')).map(function(x){return x.textContent}),first:cards[0]?cards[0].querySelector('.t').textContent:null,imgs:document.querySelectorAll('.actcard .thumb img').length,loaded:Array.from(document.querySelectorAll('.actcard .thumb img')).filter(function(i){return i.src.indexOf('blob:')===0}).length,count:(document.querySelector('.topbar-title .count')||{}).textContent,errs:window.__errs}})()" },
    { "name": "PK4-shot", "after": 400, "wait": 100, "js": "'x'" },
    { "name": "PK5-tag", "after": 500, "wait": 100,
      "js": "(function(){var b=Array.from(document.querySelectorAll('[data-act=pool-tag]')).filter(function(x){return x.textContent==='限定'})[0];if(!b)return{noBtn:true};b.click();return 'ok'})()" },
    { "name": "PK6-filtered", "after": 900, "wait": 200,
      "js": "(function(){return {cards:document.querySelectorAll('.actcard').length,sections:Array.from(document.querySelectorAll('.section-title')).map(function(x){return x.textContent}),errs:window.__errs}})()" }
  ]
}
