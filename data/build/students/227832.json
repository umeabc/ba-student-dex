/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 梓","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/315788.png","url":"https://www.gamekee.com/ba/77111.html"},{"name":"★3 梓（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/270258.png","url":"https://www.gamekee.com/ba/81811.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"蔚蓝档案。","off":""},{"label":"卡池抽取","jp":"白洲アズサ、補習授業部チームに合流した。ターゲットを見つけたら教えてほしい。","fan":"白洲梓，与补课部小队合流。发现目标的话，请告诉我。","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生。私の方は準備万端だ。","fan":"欢迎回来，老师。我这边已经准备万全。","off":""},{"label":"登陆2","jp":"水分補給はしているか？体調管理は大事だ。ちょっと待ってて。","fan":"有补充水分吗？管理好身体很重要。稍等一下。","off":""},{"label":"大厅1","jp":"どう？かっこいい？選手のユニフォームらしい。\nスカートが少し短いけど、そのぶん動きやすいんだ。","fan":"怎么样？帅气吗？听说是选手的队服。\n裙子是短了一点，不过相应地，动起来更方便。","off":""},{"label":"大厅2","jp":"先生の力になりたい。何か私に手伝えることはある？","fan":"我想帮上老师的忙。有什么我能帮忙的事吗？","off":""},{"label":"大厅3","jp":"パラソル……これはとても良い装備だ。\n上空の赤外線カメラから隠れられる。","fan":"遮阳伞……这是非常好的装备。\n可以避开上空的红外线摄像机。","off":""},{"label":"大厅4","jp":"補習授業部のみんなと、先生が好き。だから毎日が楽しみなんだ。","fan":"我喜欢补课部的大家，还有老师。所以我期待着每一天。","off":""},{"label":"大厅5","jp":"二人きりの時は、コードネームを使わないでいい。","fan":"只有我们两个人的时候，不用叫代号也可以。","off":""},{"label":"回忆大厅1","jp":"あぁ……先生。ごめん。想定以上に日差しが強くて……油断していた。ちょっと……休憩……。","fan":"啊……老师。抱歉。\n阳光比预想的还强……是我大意了。让我稍微……休息一下……。","off":""},{"label":"回忆大厅2","jp":"……うん、大丈夫。すぐに回復する。最近はずいぶんと弛んでいたみたいだ。訓練不足を痛感する。今後は先生を失望させないようにするから。……本当に、ごめん。","fan":"……嗯，我没事。马上就能恢复。\n最近我似乎松懈了不少。深感训练不足。\n今后，我不会再让老师失望了。……真的，对不起。","off":""},{"label":"回忆大厅3","jp":"……あっ。謝ることじゃない、のか……そうか。昔だったら……ひどく怒られていただろうから。癖で、つい。","fan":"……啊。\n原来……不用道歉吗。这样啊。\n换作以前……一定会被狠狠骂一顿吧。是习惯，不由自主。","off":""},{"label":"回忆大厅4","jp":"……風が吹いている。昔は、風向きを見て、弾道への影響や……色んなことを気にしてた。でも、今は違う。","fan":"……有风在吹。以前，我会观察风向，考虑对弹道的影响……在意各种各样的事情。\n不过，现在不一样了。","off":""},{"label":"回忆大厅5","jp":"ただ涼しくて……心地よくて――それを先生と一緒に感じることができて……幸せだ。","fan":"只是很凉爽……很舒服――\n能把这些和老师一起感受……我很幸福。","off":""},{"label":"咖啡馆1","jp":"不思議なものがたくさんあるな……来るたびに新鮮な気持ちになる。","fan":"不可思议的东西真多啊……每次来都有新鲜的感觉。。","off":""},{"label":"咖啡馆2","jp":"ここはいろんな人が集まっていて楽しい。","fan":"这里聚集了各种各样的人，很有趣。","off":""},{"label":"咖啡馆3","jp":"なんだかじっと見られているような……。","fan":"总觉得一直被人盯着似的……。","off":""},{"label":"咖啡馆4","jp":"パラソル、どこかに置きたいな。","fan":"遮阳伞，真想找个地方放下。","off":""},{"label":"咖啡馆5","jp":"どこか休憩できる場所は……。","fan":"哪里有可以歇一会儿的地方……。","off":""}],"好感度":[{"label":"好感度1","jp":"嬉しい、楽しい……。他に表現できる言葉があればいいのに。","fan":"开心，愉快……。\n要是有别的词能表达就好了。","off":""},{"label":"好感度2","jp":"今は知ってる。全てが虚しいわけじゃないって。","fan":"我现在知道了。并非一切都是空虚的。","off":""},{"label":"好感度3","jp":"これまで結んできた絆を大切にしたいんだ。","fan":"我想珍惜至今结下的羁绊。","off":""},{"label":"好感度4","jp":"ありがとう。そばにいてくれる先生が、好きだ。","fan":"谢谢。我喜欢陪在我身边的老师。","off":""}],"战斗":[{"label":"编入队伍1","jp":"私が必要？分かった。","fan":"需要我吗？明白了。","off":""},{"label":"编入队伍2","jp":"先生も準備はいい？","fan":"老师也准备好了吗？","off":""},{"label":"拎起","jp":"感謝する、先生。ちょうど上から見下ろしたかったんだ。","fan":"感谢你，老师。我正好想从上面俯视一下。","off":""},{"label":"普通技能","jp":"あっ、忘れてた。んっ。","fan":"啊，差点忘了。嗯。","off":""},{"label":"EX动画1","jp":"私が力になれるなら。","fan":"如果我能帮上忙的话。","off":""},{"label":"EX动画2","jp":"これで元気になるなら、いいんだけど。","fan":"如果这样能让你打起精神，那就好。","off":""},{"label":"EX动画3","jp":"教え通りに。","fan":"按照教导来。","off":""},{"label":"EX技能1","jp":"支援、到着。","fan":"支援，抵达。","off":""},{"label":"EX技能2","jp":"手伝いに来た。","fan":"我来帮忙了。","off":""},{"label":"EX技能3","jp":"進入開始！","fan":"突入开始！","off":""}],"成长":[{"label":"升级1","jp":"ありがとう。先生には助けてもらってばかりだ。","fan":"谢谢。我总是受老师照顾。","off":""},{"label":"升级2","jp":"もっと強くなる。……大切な人を守れるように。","fan":"我会变得更强。……为了能守护重要的人。","off":""},{"label":"升级3","jp":"先生の期待に応えていきたい。","fan":"我想回应老师的期待。","off":""},{"label":"升级4","jp":"先生の支援があるから、安心して戦える。","fan":"因为有老师的支援，我才能安心战斗。","off":""},{"label":"获得专武","jp":"いつもありがとう、先生。私は、先生の力になりたい。いつか……先生の決意を、私にも背負わせてほしい。","fan":"一直以来谢谢你，老师。我，想成为老师的力量。总有一天……老师的决心，也希望能让我一同背负。","off":""}],"事件":[{"label":"学生生日","jp":"別に、それほど特別な日だとは思ってない。……幸せな日は、誕生日だけじゃないから。","fan":"我并不觉得这是什么特别的日子。\n……因为幸福的日子，并不只有生日。","off":""},{"label":"老师生日","jp":"先生、お誕生日おめでとう。私に祝わせてくれて、嬉しい。","fan":"老师，生日快乐。能让我来祝贺，我很高兴。","off":""},{"label":"万圣节","jp":"先生、シャーレは危険だ！変な格好の不審者が大量に入り込んでる！\nひとまず全員気絶させた。今のうちに早く逃げよう！私の後についてきて！","fan":"老师，夏莱有危险！有一群打扮奇怪的可疑人员大批混进来了！\n总之先把所有人弄晕了。趁现在快逃！跟在我后面！","off":""},{"label":"新年","jp":"あけましておめでとう。これからもずっと……ずっと、よろしく。","fan":"新年快乐。今后也一直……一直，请多指教。","off":""},{"label":"圣诞节","jp":"プレゼントをもらったんだ。まさか、もらえるとは思ってなかった……すごく、嬉しい。","fan":"我收到礼物了。\n没想到，没想到居然能收到……非常，开心。","off":""}],"活动":[{"label":"活动登陆1","jp":"ゲヘナカップへようこそ、先生。","fan":"欢迎来到格黑娜杯，老师。","off":""},{"label":"活动登陆2","jp":"大切な思い出を作りたい。そのためにも、まずは安全第一だ。","fan":"我想留下珍贵的回忆。为此，首先要安全第一。","off":""},{"label":"活动大厅1","jp":"暑いのか？パラソル、一緒に使う？","fan":"热吗？要不要一起用遮阳伞？","off":""},{"label":"活动大厅2","jp":"撫でられるのは好きだけど……今は人が多いから、また後で……。","fan":"被摸头我倒是喜欢……但现在人太多了，还是之后再说……。","off":""},{"label":"活动大厅3","jp":"みんなと色んな経験ができるといいな。","fan":"要是能和大家一起经历各种事情就好了。","off":""},{"label":"活动大厅4","jp":"友達、たくさん作れるだろうか。","fan":"我能交到很多朋友吗。","off":""},{"label":"活动事件1","jp":"私も、みんなを見習わないと。","fan":"我也得向大家学习才行。","off":""},{"label":"活动事件2","jp":"ガソリンと火薬のにおいが充満してて……わくわくする。","fan":"汽油和火药的味道弥漫在空气里……让人兴奋。","off":""},{"label":"活动结束","jp":"みんなが最善を出し合って、日常に戻っていく。こういうのが好きなんだ。","fan":"大家都拿出自己最好的表现，然后回归日常。我喜欢这样。","off":""},{"label":"活动任务1","jp":"どうしたんだ、先生？もしかして、一緒に写真を撮りたいのか？\nミッションのリストにはなかったと思うけど。","fan":"怎么了，老师？难道是想和我一起拍照吗？\n任务清单上应该没有这一项吧。","off":""},{"label":"活动任务2","jp":"先生は指示と目標が明確だから、とてもやりやすい。","fan":"老师的指示和目标都很明确，做起来非常顺手。","off":""},{"label":"活动任务每日结束","jp":"目標達成。今日はもう十分だ。","fan":"目标达成。今天已经足够了。","off":""},{"label":"活动任务登录1","jp":"任務開始。","fan":"任务开始。","off":""},{"label":"活动任务登陆2","jp":"最優先事項から片づけよう。","fan":"从最优先事项开始处理吧。","off":""},{"label":"活动任务获取1","jp":"当然の報酬だ。先生の努力の賜物だな。","fan":"这是应得的报酬。是老师努力的成果。","off":""},{"label":"活动任务获取2","jp":"うん、満足いく結果だ。","fan":"嗯，令人满意的结果。","off":""},{"label":"minigame_combo_1","jp":"戦果拡大、成功だな。","fan":"扩大战果，成功了呢。","off":""},{"label":"minigame_combo_2","jp":"ゴールは目前だ。","fan":"终点就在眼前。","off":""},{"label":"minigame_combo_3","jp":"ターゲットを無力化、次！","fan":"目标已被压制，下一个！","off":""},{"label":"minigame_complete","jp":"ふん、完璧な作戦だった。","fan":"哼，真是完美的作战。","off":""},{"label":"minigame_geasget_1","jp":"現地調達できるのはありがたい。","fan":"能在现场补充物资真是帮大忙了。","off":""},{"label":"minigame_geasget_2","jp":"装備の確保に、やりすぎはない。","fan":"搜集装备这件事，怎么做都不为过。","off":""},{"label":"minigame_geasget_3","jp":"有効活用しよう。","fan":"好好利用它吧。","off":""},{"label":"minigame_get_1","jp":"私も力になれて嬉しい。","fan":"能帮上忙，我也很高兴。","off":""},{"label":"minigame_get_2","jp":"どうだろう？少しは先生に返せているか？","fan":"怎么样？有稍微回报到老师吗？","off":""},{"label":"minigame_login_1","jp":"実践形式の訓練はいつでも歓迎だ。","fan":"实战形式的训练，随时欢迎。","off":""},{"label":"minigame_login_2","jp":"制圧と優勝以外にも、目標が山のようにあるんだな。","fan":"除了压制和夺冠之外，目标还堆积如山啊。","off":""},{"label":"minigame_select_1","jp":"私でよければ、いくらでも手伝う。","fan":"要是不嫌弃我的话，无论多少忙我都帮。","off":""},{"label":"minigame_select_2","jp":"準備完了、いつでもいける。","fan":"准备完毕，随时可以出发。","off":""},{"label":"minigame_select_3","jp":"専門は白兵戦だけど、戦車も問題ない。","fan":"虽然我的专长是白刃战，不过坦克也没问题。","off":""},{"label":"minigame_shout_1","jp":"次弾準備！","fan":"准备下一发炮弹！","off":""},{"label":"minigame_shout_2","jp":"砲尾、確保！","fan":"炮尾，闭锁确认！","off":""},{"label":"minigame_shout_3","jp":"戦車砲準備、閉鎖機を開け！","fan":"坦克炮准备，打开炮闩！","off":""},{"label":"minigame_start_1","jp":"ハンター待機中、指示を求む。","fan":"猎人待命中，请指示。","off":""},{"label":"minigame_start_2","jp":"戦車、前進！","fan":"坦克，前进！","off":""},{"label":"minigame_start_3","jp":"グリーンライトだ、行こう。","fan":"绿灯亮了，出发吧。","off":""},{"label":"minigame_touch_1","jp":"相手にとって不足なし。楽しみだ。\n最近、少し筋肉が落ちた気がする。もっと訓練しないと。","fan":"作为对手正合适。我很期待。\n最近感觉肌肉有点退化了。得多加训练才行。","off":""},{"label":"minigame_touch_2","jp":"ん、なんだ？用事があるなら、いつでも無線で呼べばいい。","fan":"嗯，怎么了？如果有事，随时用无线电叫我就行。","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/28/75819974mvs0v3ec.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/28/22504341mvs0v7hq.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/28/85249747mvs0v8og.ogg","",""],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com