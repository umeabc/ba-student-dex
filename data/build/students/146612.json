ttps://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/224006.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/918040.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"967"},{"name":"攻击力","value":"115"},{"name":"治愈力","value":"246"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/447331.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/921418.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★2 椿","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/12/354563.png","url":"https://www.gamekee.com/ba/68177.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive..."},{"label":"卡池抽取","jp":"今回は、ガイドだよ。修行も案内も頑張るね…はぁ…","fan":"这次是做导游。不管是修行还是做导游都会加油…哈啊…","off":"这次我来当导游啦~不管是修行还是导游工作，我都会努力的~哈啊~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生。お帰りなさい。…ところで、今何時…？","fan":"你好，老师。欢迎回来。…说起来，现在多少点了…？","off":"你好，老师，快请进。话说……现在几点啦？"},{"label":"登陆2","jp":"おやすみなさい。挨拶もしたし、先生も一緒に寝よう？","fan":"晚安。既然已经打了招呼，老师也来一起睡吗？","off":"晚安~招呼也打过啦，老师来一起睡吧……嗯？"},{"label":"大厅1","jp":"はぁぁ…いや、寝てないよ。シャーレが寝やすいどこなのかな、試してみただけだよ。","fan":"哈啊…没在睡觉哦。只是试试夏莱是不是能睡好觉的地方。","off":"哈啊~没有，我没睡~我只是在测试沙勒睡起来舒不舒服而已~"},{"label":"大厅2","jp":"熟睡枕と布団、アイマスクと耳栓、全部用意されてるよ。後は先生が来るだけ。","fan":"熟睡枕头和被子，眼罩和耳塞，全都准备好了。就等老师到来。","off":"助眠用的枕头和被子，还有眼罩和耳塞，我都准备好啦……接下来，只用等老师来啦。"},{"label":"大厅3","jp":"うふふ…いつか二人だけで、どこか旅立つのもいいかもね。夢の国とか。","fan":"唔呼呼…如果有一天，我们两人能结伴出游也不错呢。目的地的话，梦之国之类的。","off":"诶嘿嘿，要是有一天，就我们两个人去哪旅行也不错呢。比如说……去梦乡。"},{"label":"大厅4","jp":"ガイドに必要なのは、説明する力だと思い。自分が知ってることをうまく教えてあげないといけないから。","fan":"对导游来说，需要有说明事物的能力。不能好好表达出自己的所知可不行呢","off":"对导游来说，重要的是拥有讲解的能力。要把自己知道的东西给别人讲清楚。"},{"label":"大厅5","jp":"私だって、いつも寝ることばっか考えてるわけじゃないんだよ。…うん、先生と、会う時とか。","fan":"我也不是一直只知道睡觉哦。…嗯，和老师见面的时候不会只想着睡觉","off":"我也不是一直都那么讲道理的哦~嗯……比如说，和老师见面的时候。"},{"label":"回忆大厅1","jp":"ふぁ…ちょっと足が痛いかも…この靴はまだ慣れていなくて、うん。","fan":"哈啊…脚有点痛呢…还没有习惯这双鞋子，嗯。","off":"呜……腿，有点痛呢。这双鞋……穿着还不习惯……嗯。"},{"label":"回忆大厅2","jp":"どうしたの、先生？こっちをじっと見て？","fan":"怎么了，老师？一直看着这边？","off":"怎么啦，老师？这样盯着我看……"},{"label":"回忆大厅3","jp":"え？私がなんかいつもと違う感じが見えてる？","fan":"诶？我看起来和平时不一样？","off":"嗯……？感觉我和平时看起来不一样……？"},{"label":"回忆大厅4","jp":"ふふん…変なの…でも先生がそう言う風に私を見てくれるんだったら、それも悪くないかも？","fan":"…真是奇怪呢…如果老师是那样看我的，也不错呢。","off":"……真奇怪。诶，不过，能让老师这样看着我的话……好像，也不错。"},{"label":"回忆大厅5","jp":"ねぇ、先生。今日は私たち二人ども、いい夢見られるたら、いいね。","fan":"老师。如果我们两人今天能做个美梦，那该多好。","off":"那个，老师……要是今天我们俩……都能做个好梦，就好了呢~"},{"label":"咖啡馆1","jp":"みんな、こっちだよ～あれ、私一人...？","fan":"大家，在这边哦~诶？怎么就剩我一个了…？","off":"各位，这边走~诶，就我一个人吗……？"},{"label":"咖啡馆2","jp":"人を案内する夢...？夢じゃなかったのかな…？","fan":"做了一个当导游的梦…？原来不是梦吗…？","off":"给大家当导游的梦，原来，不是梦吗……？"},{"label":"咖啡馆3","jp":"人は人生の三分の一を寝て過ごすんだって。","fan":"听说人的生命有三分之一都是在睡眠中度过的。","off":"据说，人一生三分之一的时间都在睡觉……"},{"label":"咖啡馆4","jp":"よく寝るのは大事だよ、思ってる以上にね。","fan":"好好睡觉可是很重要的，比想象中还要重要。","off":"优质的睡眠是很重要的！比想象中更加重要！"},{"label":"咖啡馆5","jp":"百鬼夜行のことなら、任せて。","fan":"如果是百鬼夜行的事，交给我吧。","off":"百鬼夜行的事情，就交给我吧~"}],"好感度":[{"label":"好感度1","jp":"どこに案内しようか、先生？やっぱり寝室がいい？","fan":"需要我为你导游吗，老师？果然还是卧室更好？","off":"该带你去哪呢，老师~还是卧室比较好吧……"},{"label":"好感度2","jp":"今の私は睡眠ガイド、春日ツバキ。不眠症がひどくなったら呼んでね。","fan":"现在的我是睡眠导游，春日椿。如果失眠状况日益严重，要呼叫我哦。","off":"现在我是，睡眠向导春日椿。如果失眠变严重了，就叫我吧~"},{"label":"好感度3","jp":"普通のガイドもちゃんとできるよ、これも修行の一環だし。","fan":"普通的导游也能做哦 ，这也是修行的一环。","off":"普通的导游工作我也能胜任。这，也是修行的一部分。"},{"label":"好感度4","jp":"先生と一緒にいると、修行がうまくいくみたい。うん、ガイドも熟睡も、それ以外も。","fan":"和老师在一起，修行十分顺利。嗯，导游也好睡眠也好，其他事也十分顺利。","off":"和老师在一起，修行，好像也变得更顺利了。嗯……不管是导游，睡眠，还是别的，都……"}],"战斗":[{"label":"编入队伍1","jp":"どこを案内すればいい?","fan":"该带你去哪里呢？","off":""},{"label":"编入队伍2","jp":"夜眠れなかったら、行ってね。","fan":"要是晚上睡不着的话，就来吧。","off":""},{"label":"拎起","jp":"列を離れないで…はぁ…","fan":"请不要离开队列…哈啊…","off":""},{"label":"普通技能","jp":"はい、いい夢見てね。","fan":"做了一个好梦呢。","off":"好啦，做个好梦吧~"},{"label":"EX动画1","jp":"はいはい、そこまでね。","fan":"好了好了，到此为止哦。","off":"嗯……？好了好了，到此为止……！"},{"label":"EX动画2","jp":"そこまで、そこまで。","fan":"到此为止，到此为止。","off":"嗯？停一停，停一停！"},{"label":"EX动画3","jp":"皆、出発だよ。","fan":"大家，要出发了~","off":"啊呜……各位，出发咯~！"},{"label":"EX技能1","jp":"こっちだよ、こっち。順番に、そうそう。","fan":"在这边，在这边哦。按顺序来。","off":"这边啦，这边！一个一个来！对，就这样~"},{"label":"EX技能2","jp":"こっちこっち、案内してあげる。","fan":"在这边，由我来带路。","off":"这边，这边走！我来给你们带路！"},{"label":"EX技能3","jp":"急がずに。うん、こっちだよ。","fan":"不要着急。嗯，往这边走。","off":"别着急，嗯，是这边~"}],"成长":[{"label":"升级1","jp":"今日も修行中…睡眠が増えたんじゃないかたって？勘違いだよ、多分。","fan":"今天也是修行中…似乎睡眠量增加了…？那是错觉哦，大概。","off":"我今天也在修行。你说，总觉得我睡得更多了？应该……是错觉吧。"},{"label":"升级2","jp":"修行のために、もっと心機一転しじゃなきゃ…まずは、枕から変えてみようかな。","fan":"为了修行，更要鼓足精神…首先从换枕头开始吧。","off":"为了修行，我需要转换一下心境……嗯，就从换个枕头开始吧~"},{"label":"升级3","jp":"ガイドとは、どこかに誰かを案内をすること。私は夢の国のガイドだよ","fan":"所谓导游，就是在引导某人到达某处。我是梦之国的导游哦","off":"导游的工作，就是带领某人前往某处……而我，就是梦乡的导游~"},{"label":"升级4","jp":"修行の成果が感じられるね、今日はぐっすり眠りそう。","fan":"感受到了修行的成果呢，看来今天可以睡个好觉了","off":"能感觉到修行的成果呢~今天，应该能睡个好觉~"},{"label":"获得专武","jp":"ありがとう、先生。先生の睡眠を遮る敵は、私が倒してあげる","fan":"谢谢你，老师。妨碍老师睡眠的敌人，就由我来解决","off":"谢谢你，老师~！干扰老师睡眠的敌人，就让我来打倒吧！"}],"事件":[{"label":"学生生日","jp":"そうだ。今日私の誕生日だったね。誕生日プレゼントは先生の膝枕がいいな..","fan":"这样啊。今天是我的生日呢。生日礼物，老师的膝枕就好。","off":"对了，今天是我的生日来着？生日礼物……是老师的膝枕就好了，嗯……"},{"label":"老师生日","jp":"誕生日だね、先生。うふふ、おめでとう、おめでとう。プレゼントとして、今日は眠るまで私が一緒にいてあげる。","fan":"今天是老师的生日呢。恭喜恭喜。作为礼物，今天我会一直陪着老师，直到入睡","off":"老师，今天是你的生日呢~诶嘿嘿，生日快乐，生日快乐哦~礼物的话……就是今天我会陪着你，直到你睡着~"},{"label":"万圣节","jp":"ハロウィーン…夢の中のような風景が見られる日だね。うふふ、こういう日は何をどうガイドしたらいいのかな...？","fan":"万圣节…每到这种时候就能看到如梦般的风景。唔呼呼，这种日子该如何履行导游的职责呢…？","off":"万圣节……？是街头巷尾都会变得像梦中的风景一样的日子呢……诶嘿嘿，这种日子，该带老师逛些什么呢？"},{"label":"新年","jp":"新年になったね…一年の始まり、ある意味一年の一番最初の朝。朝は弱いけど、新年は好き。","fan":"新年到了…一年的开始，从某种意义上来说是新年的第一个早晨。虽然对早晨很不擅长，但是喜欢新年。","off":"新年到啦……一年伊始，如果把一年比作一天，那今天就是这一年最早的早晨！我虽然是早起困难户，但新年，还是很喜欢的~"},{"label":"圣诞节","jp":"メリー～クリスマス～百鬼夜行の外ではこう挨拶するだって…？","fan":"圣诞~快乐~，听说百鬼夜行外都是这样打招呼的…？","off":"Merry Christmas……听说百鬼夜行外面的地方，是这么打招呼的……对嘛？"},{"label":"春节","jp":"","fan":"老师，新年快乐~听说今天要守岁，那，就交给老师吧~我先去睡了……毕竟，春宵一刻值千金嘛~","off":"老师，新年快乐~听说今天要守岁，那，就交给老师吧~我先去睡了……毕竟，春宵一刻值千金嘛~"},{"label":"中秋","jp":"","fan":"老师，听说今天是山海经的节日呢……要我带你来一场月宫之旅嘛？这，也是导游的修行~","off":"老师，听说今天是山海经的节日呢……要我带你来一场月宫之旅嘛？这，也是导游的修行~"}],"活动":[{"label":"活动登陆1","jp":"お帰り、先生。百鬼夜行にようこそ...","fan":"欢迎回来，老师。欢迎来到百鬼夜行…","off":"老师……你来啦。欢迎来到，百鬼夜行……"},{"label":"活动登陆2","jp":"今日は私が先生を案内してあげる。ガイド、春日ツバキ、頑張ります…は","fan":"由我来给老师带路。导游，春日椿，加油","off":"今天，我来为老师带路。导游春日椿，会加油的~啊呜……"},{"label":"活动大厅1","jp":"ええ～どうしたの、先生？居眠りしてるように見えだから、起こしてみたって？","fan":"诶~怎么了，老师？看我在打瞌睡所以想叫醒我？","off":"诶……？你怎么了，老师……嗯，看你好像在犯困，就叫你一声……"},{"label":"活动大厅2","jp":"ふふん、くすぐったい…でも、その程度で私の修行を止めることはできないよ。","fan":"呼呼，好痒…不过，这种程度可阻止不了我的修行","off":"嗯……好痒……但这点小事，是妨碍不了我的修行的……"},{"label":"活动大厅3","jp":"ずっとそうやっていたずらしたら、ベッドで一緒に横になっちゃうよ？...うん？むしろそうしたいの...？","fan":"再继续恶作剧，就把老师绑到床上一起躺着哦？…嗯？不如说这样刚好…？","off":"总这样恶作剧的话，我要跟你一起躺床上了哦？……嗯？你说，你反而想这样……？"},{"label":"活动大厅4","jp":"もしかして、気にしてほしいの？そんなことしなくでも、私は十分先生のこと気にしてるのに。","fan":"难道说，老师想引起我的注意？即便不做那种事，我也十分在意老师哦","off":"难道是想让我多关心你一下嘛？……用不着这样，我已经很关心老师啦~"},{"label":"活动事件1","jp":"百鬼夜行は、どうだった？ちゃんと楽しんでる？","fan":"百鬼夜行，如何？有好好享受吗？","off":"百鬼夜行怎么样？玩得，开心嘛？"},{"label":"活动事件2","jp":"行きたい所があったら、いつでも言って。百鬼夜行なら、案内できるから","fan":"如果有想去的地方，无论何时都可以告诉我。如果是百鬼夜行，我会为老师带路。","off":"如果有想去的地方，随时告诉我。在百鬼夜行的话，我可以给你带路。"},{"label":"活动结束","jp":"お祭り、凄かったね。百鬼夜行には、またほかのお祭りも沢山あるよ...待てるね...","fan":"祭典，很厉害呢。在百鬼夜行还有很多其他的祭典…要耐心等待哦…","off":"庆典，很棒吧~百鬼夜行还有很多别的庆典，我，等着老师哦~"},{"label":"活动任务1","jp":"うんん...そんなに揺らさないで、先生。...うん？いや、寝てない...寝てないてっば...","fan":"唔嗯…不要摇了，老师。…嗯？没有睡哦，都说了没有睡…","off":"嗯……别那样叫我起床啦，老师……嗯？没有……我没睡啦，真的没睡……"},{"label":"活动任务2","jp":"次の目的地に案内してあげる、先生。その前に少しだけ寝てるから。","fan":"我来带老师去下一个目的地。在此之前先小憩一下","off":"我带你去下一个目的地，老师，你先等我，稍微眯一会……"},{"label":"活动任务每日结束","jp":"うん、今日の日課はこれで終わりだね。そのまま帰るの？一緒にいいどこで眠らない？","fan":"嗯，今天的日程已经完成了。就这样回去了？一起找个好地方睡觉吧？","off":"嗯，今天的工作到这里就结束啦……要直接回去嘛，要不要一起找个舒服的地方，睡一觉？"},{"label":"活动任务登录1","jp":"毎日の日課をちゃんとやらないと、いい夢を見られないたって…","fan":"每天的日程表如果不好好完成，可不会做好梦呢。","off":"要是没好好做