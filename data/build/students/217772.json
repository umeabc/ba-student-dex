829/images/w_300/h_237/191981/2026/5/24/49581630mqs26o6j.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/191981/2026/5/24/21719242mqs27hv3.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/191981/2026/5/24/87200235mqs26cl4.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/191981/2026/5/24/58395867mqs26vtu.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/191981/2026/5/24/70163959mqs27230.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/191981/2026/5/24/05665196mqs265hk.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/191981/2026/5/24/97851741mqs26k6m.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/191981/2026/5/24/49581630mqs26o6j.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"瞬(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/5/24/99728814mqrzncot.png","url":"https://www.gamekee.com/ba/tj/709616.html"},{"name":"瞬(幼女)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/109167.png","url":"https://www.gamekee.com/ba/86656.html"},{"name":"瞬","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/269505.png","url":"https://www.gamekee.com/ba/68522.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！えへへ。","fan":"碧蓝档案~嘿嘿~","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは！先生！「シュエリン」は、先生と遊びたいです！","fan":"你好！老师！雪玲想和老师一起玩！","off":""},{"label":"登陆2","jp":"はい！「シュエリン」ですよ！水着に着替えてきちゃいました。どうでしょう、先生？可愛いですか？","fan":"是的！是雪玲哦！我换好泳装了。老师觉得如何呢？可爱吗？","off":""},{"label":"大厅1","jp":"今の私は、教官ではありません！なので…普段できないことを、い～っぱいしちゃいます！","fan":"现在的我不是教官！所以……我做了很多平常不能做的事情！","off":""},{"label":"大厅2","jp":"大きくなるにつれて、体感時間が短くなっていくと聞きました。子供の時は、目に映るものがすべて新鮮で輝いていて…だから時間がゆっくりだったんです。今の私は身体は小さいですが、色々なことを知っているので――もしかしたら、同年代の他の子よりも、体感時間が短くなってるかもしれませんね。","fan":"我听说随着年龄成长，体感时间也会跟着变短。小时候，映入眼帘的一切都既新鲜又耀眼…所以才会感觉时间过的很慢。现在的我虽然身体娇小，但已经知道许多事情——说不定，我的体感时间会比同龄的孩子更短。","off":""},{"label":"大厅3","jp":"先生、先生！着替えてきた「シュエリン」と一緒に行きたい場所、ありますか？私は先生と一緒なら、どこでも良いですよ！","fan":"老师，老师！有想和换好衣服雪莉一起去的地方吗？只要和老师在一起，去哪里都好！","off":""},{"label":"大厅4","jp":"水遊び、楽しいですね♪でも…本当は、先生と遊べるならなんでも嬉しいです！","fan":"玩水真开心呢♪不过…其实只要能和老师一起玩，怎样都很开心！","off":""},{"label":"大厅5","jp":"もしも私が溺れちゃったら…それが「ふり」だとしても、先生は助けに来てくれますか？なんとなく…そういうのに憧れちゃうだけです。本当にやったりはしませんよ？","fan":"如果我溺水的话…就算是假装的，老师会来救我吗？我只是…有点憧憬那种事而已。真的不会真的做哦？","off":""},{"label":"咖啡馆1","jp":"美味しいそうな匂いがします！","fan":"有股很香的味道！","off":""},{"label":"咖啡馆2","jp":"あのジュース，どんな味がするでしょう？","fan":"那个果汁，是什么味道呢？","off":""},{"label":"咖啡馆3","jp":"水着でここに来て大丈夫でしょうか？","fan":"真的可以穿着泳装来这里吗？","off":""},{"label":"咖啡馆4","jp":"体が軽い！最高です！","fan":"身体好轻快！这种感觉最棒了！","off":""},{"label":"咖啡馆5","jp":"このままずっとここに居たいぐらいですが、やっぱりお外で遊びたいです！","fan":"虽然很想一直待在这里，不过还是想到外面玩！","off":""}],"好感度":[{"label":"好感度1","jp":"トロピカルフルーツが食べたくなってきました……先生はどんなフルーツが好きですか？","fan":"突然好想吃热带水果……老师有什么喜欢的水果吗？","off":""},{"label":"好感度2","jp":"先生は何をして遊びたいですか？私は……おんぶしてもらいたいです！それから……えへへっ、秘密です！","fan":"老师想玩什么呢？我想……让老师背背！然后……欸嘿嘿，保密！","off":""},{"label":"好感度3","jp":"小さい頃、水遊びに熱中しすぎて夏風邪を引いちゃったことがあるんです。……って、「今」も小さかったですね。とにかく！先生も夏風邪には注意するんですよ！","fan":"小的时候，有过因太沉迷玩水而感冒。说起来，我现在还是小孩子呢。总之！老师也要注意不要感冒了！","off":""},{"label":"好感度4","jp":"今の私が経験する出来事は、過去の上書きになるんでしょうか？でもきっと、違いますよね。だって、こうして過ごしている全ての時間が、新しい思い出になっているんですから。","fan":"现在我所经历的这些事，会成为对过去的覆盖吗？肯定不会是这样的。因为，像这样度过的时光，都成为了新的回忆。","off":""}],"战斗":[{"label":"编入队伍1","jp":"先生とおでかけ！ですね！","fan":"和老师一起出门！","off":""},{"label":"编入队伍2","jp":"えへへっ、とっても楽しみです！","fan":"欸嘿嘿，很有意思呢！","off":""},{"label":"拎起","jp":"わわわっ！？落ちちゃうかと思いました……えへへ。","fan":"呜哇哇！我还以为会掉下去呢……欸嘿嘿。","off":""},{"label":"任命队长1","jp":"小さくても、できるんですよ！","fan":"就算变小了，也是能做到的！","off":""},{"label":"任命队长2","jp":"任せてください！","fan":"交给我吧！","off":""},{"label":"切换形态","jp":"じゃじゃーん！シュエリンです！","fan":"锵锵！是雪玲哦！","off":""},{"label":"普通技能","jp":"さて……どうですか！","fan":"那么……这招怎么样！","off":""},{"label":"EX动画1","jp":"んん……。先生～！","fan":"呜呜……老师~","off":""},{"label":"EX动画2","jp":"あいたた……。助けてくださ～い！","fan":"痛痛痛……帮帮我嘛！","off":""},{"label":"EX动画3","jp":"うぅーん……。抱っこしてください～！","fan":"呜呜……要抱抱~","off":""},{"label":"EX技能1","jp":"頑張りますねっ！","fan":"加油！","off":""},{"label":"EX技能2","jp":"よいしょ！","fan":"好了！","off":""},{"label":"EX技能3","jp":"行きますよ！","fan":"要上了哦！","off":""},{"label":"战斗开始1","jp":"みなさん、よろしくお願いします！","fan":"请大家多多关照！","off":""},{"label":"战斗开始2","jp":"私が先頭に立ちますね！","fan":"我来打头阵！","off":""},{"label":"获得BUFF","jp":"ありがとうございます！","fan":"谢谢！","off":""},{"label":"施放BUFF","jp":"これからですよ","fan":"战斗才刚刚开始","off":""},{"label":"掩体","jp":"隠れます！","fan":"隐蔽！","off":""},{"label":"被CC1","jp":"あ、たッ","fan":"啊，痛","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"被CC3","jp":"ひどいですよ","fan":"好过分","off":""},{"label":"回避","jp":"ちょちょいのちょい、です！","fan":"小菜一碟！","off":""},{"label":"队伍移动1","jp":"次は何でしょうか？","fan":"接下来是什么？","off":""},{"label":"队伍移动2","jp":"あそこですね！","fan":"在那边！","off":""},{"label":"回复","jp":"元気になりました！","fan":"恢复元气了！","off":""},{"label":"中途退出","jp":"ううん、くらくらします","fan":"呜，头晕晕的","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"いかがですか","fan":"这招如何","off":""},{"label":"角色移动","jp":"あっちに行きましょう！","fan":"去那边吧！","off":""},{"label":"战斗胜利1","jp":"勝ちました！先生が見ていてくれたおかげです！","fan":"赢啦！多亏了老师在旁守望！","off":""},{"label":"战斗胜利2","jp":"えへへ。やりました！褒めてください！","fan":"欸嘿嘿。我做到了！快夸我！","off":""},{"label":"关卡完成1","jp":"えへへ、先生、見てました？","fan":"欸嘿嘿，老师，看到了吗？","off":""},{"label":"关卡完成2","jp":"いってきます！","fan":"我要出发了！","off":""},{"label":"战斗失败1","jp":"ごめんなさい、先生","fan":"老师，对不起","off":""},{"label":"战斗失败2","jp":"ううん、力不足だったみたいです","fan":"呜，力量好像还不够","off":""}],"成长":[{"label":"升级1","jp":"私、成長したみたいです！えっと……いいこと、なんですよね？あれ？","fan":"我好像成长了一些！嗯……这是好事对吧？欸？","off":""},{"label":"升级2","jp":"この姿になると、色々なことを考えちゃいます。身体は大きくなったけれど、果たして成長しているのか……あっ、なんだか感傷的になっちゃいましたね！今のは聞かなかったことに……。","fan":"一旦变成小孩子，不禁会思考起很多事。只有身体成长了，这能算是成长吗……啊，突然就变成感伤的话题了，就当作没听到吧……","off":""},{"label":"升级3","jp":"今の私は、期間限定の泡沫……。だからこそ、この時間を大切にしたいんです。先生とこうやって過ごす瞬間は、かけがえのない宝物ですから。","fan":"现在的我，只是转瞬即逝的泡沫……正因如此，才要好好珍惜这段时间。和老师度过的一个个瞬间，都是无可代替的宝物。","off":""},{"label":"升级4","jp":"む……なんだか、また大きくなった気がします……えっ、私、何か変なこと言いました？","fan":"唔……总觉得又成长了……欸，我难道说了什么奇怪的话吗？","off":""},{"label":"获得专武","jp":"こうして先生と一緒に避暑に来られて、とっても楽しいです！改めて……いつもありがとうございます、先生！","fan":"能像这样和老师一起来避暑，我感到很开心！再次感谢老师长久以来的照顾！","off":""}],"事件":[{"label":"学生生日","jp":"今日、私の誕生日なんです！先生、誕生日プレゼントはなんですか？…ふふっ、子供はプレゼントがあるものだと思っているんですよ？なので――今日は、いっぱい甘やかしてくださいね？","fan":"今天是我的生日！老师，您的生日礼物是什么呢？…呵呵，小孩子可是觉得礼物是理所当然的哦？因此——今天请尽情地宠溺我吧。","off":""},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！…今度、私の誕生日も、お祝いしてくださいね？","fan":"老师，生日快乐！…下次也请帮我庆祝生日吧？","off":""},{"label":"万圣节","jp":"先生！お菓子ってありますか？トリックオアトリートで持っていかれちゃう前に、いくつか食べておきたくて…！","fan":"老师！这里有点心吗？在被抢走之前，我想先吃掉几样……！","off":""},{"label":"新年","jp":"年が明けましたね。あけましておめでとうございます、先生！シュエリンはまた一つ、お姉さんになりました！…この姿で言うのは、なんだか不思議な気分ですね。","fan":"新的一年到了。老师，新年快乐！雪玲又向成为大姐姐前进了一步！…以这副模样说这种话，感觉真是不可思议。","off":""},{"label":"圣诞节","jp":"クリスマスですよ、先生！この一年、私は「良い子」だったでしょうか？先生サンタが来てくれたら…嬉しいです。","fan":"圣诞节快到了哦，老师！以这一年表现来看，我是个乖孩子吗？要是老师能扮作圣诞老人来的话…我会很开心哦。","off":""}],"活动":[{"label":"抽卡1","jp":"当たりです！すごいです！あっちで商品と交換できるみたいですよ！","fan":"大奖！好厉害！好像可以在那边用商品交换哦！","off":""},{"label":"抽卡2","jp":"わあ！すごい！先生、もっと近くで見せてください！","fan":"哇啊！好厉害！老师，靠近一点让我仔细看看！","off":""},{"label":"抽卡3","jp":"これは一体何でしょう……？きっとすごいものですよ！","fan":"这到底是什么……？一定是很厉害的东西！","off":""},{"label":"抽卡4","jp":"コンプリートでしょうか？お疲れさまでした、先生！","fan":"完美的结果，对吧？辛苦了，老师！","off":""},{"label":"抽卡商店1","jp":"えへへっ、どうでしょう？新鮮ですか？あれ、どうかされたんですか？もしかして「シュエリン」とは……。遊びたくないのですか？","fan":"嘿嘿嘿，怎么样？不觉得新鲜吗？咦，你怎么了？难道说……不想和雪玲一起玩吗？","off":""},{"label":"抽卡商店2","jp":"先生と一緒にいる時が、一番幸せです。だって……。自分の気持ちに素直になれますから。子供の身体になるのって、最高～です！","fan":"和老师在一起的时候，是最幸福的。因为……这样我就能坦率地面对自己将。变成小孩的身体，真是太棒了～！","off":""},{"label":"抽卡商店关闭","jp":"あっ、先生！えへへ。お待ちしてました！やることぜーんぶ終わってるなら……遊びに行きませんか？もちろん……二人きり、で。","fan":"啊，老师！欸嘿嘿，我等你很久了！既然要做的事都做完了……要不要去玩？当然……只有我们两个人一起。","off":""},{"label":"抽卡商店登录1","jp":"こんにちは！お待ちしてました！先生のシュエリンですよ！","fan":"您好！久等了！我是老师的雪玲！","off":""},{"label":"抽卡商店登录2","jp":"先生、おかえりなさい！え？シュエリンで大丈夫なのか……？ふふっ、私はいつでも大丈夫ですよ！","fan":"老师，欢迎回来！咦？用雪玲形态没问题吗……？呵呵，我随时都OK哦！","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/5/26/09838734mqts525m.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/13/31773659mv6t0zai.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/5/24/31327351mqs7o73g.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/13/57541077mv6t10mv.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/5/24/56301409mqs7o8ee.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/13/40602393mv6t11od.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/5/24/49397344mqs7oa5y.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/13/48950744mv6t13km.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/5/24/58108162mqs7obt8.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/13/89629794mv6t14od.ogg"],"大厅及咖啡馆|大厅3":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/5/24/79177888mqs7odcw.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/13/30719957mv6t16at.ogg"],"大厅及咖啡馆|大厅4":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/5/24/51271591mqs7oer8.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/13/10535506mv6t17hh.ogg"],"大厅及咖啡馆|大厅5":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/5/24/62639702mqs7og5k.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/1