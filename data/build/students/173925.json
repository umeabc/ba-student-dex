images/w_146/h_116/829/72324/2025/5/9/389065.webp","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/72324/2025/5/9/81170.webp","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 花凛（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/9/276657.png","url":"https://www.gamekee.com/ba/89275.html"},{"name":"★3 花凛","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_220/h_220/829/72324/2025/5/9/712219.png","url":"https://www.gamekee.com/ba/67011.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"ミレニアムサイエンススクールの角楯カリン、準備はできてる。……こ、この服装、大丈夫そうか？","fan":"我是千禧年科技学园的角楯花凛，已经准备完成。……这、这身衣服，看起来没问题吧？","off":"千禧年科技学院，角楯花凛，准备就绪。……穿，穿这身衣服，真的不要紧吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ああ、先生。待ってた。\n……なんでって？護衛に理由が必要だろうか。","fan":"啊，老师。正等着您呢。\n……原因？对护卫来说不需要理由。","off":"啊，老师，我正等着你呢。……为什么？护卫还需要理由吗？"},{"label":"登陆2","jp":"おかえり、先生。それから、お疲れ様。","fan":"欢迎回来，老师。还有，辛苦了。","off":"老师，你来了。辛苦你了。"},{"label":"大厅1","jp":"うん？ああ、今日は制服を着ている。……理由？\nふふ……なんだろうな。当ててみてくれ。","fan":"嗯？啊。今天也穿着制服……您问理由吗？\n哼哼……为什么呢。猜猜看。","off":"嗯？如你所见，我今天穿了制服。你问为什么？……要猜猜看吗？"},{"label":"大厅2","jp":"いつもと違う服装だからか、少し勘が鋭くなっているようだ。","fan":"也许是因为服装和平常不一样，似乎感觉都变得敏锐了些。","off":"可能是因为穿了和平时不同的衣服，总觉得直觉变得更敏锐了。"},{"label":"大厅3","jp":"制服を着る機会があまりなくて……変なところはないだろうか？\nそうは言ったが……み、見すぎだ先生！","fan":"平时都没有什么机会穿制服……没有什么奇怪的地方吧？\n话虽如此……看太久了，老师！","off":"我平时不怎么穿制服的……有没有哪里看起来别扭？但你一直盯着我看的话，我会不好意思的……！"},{"label":"大厅4","jp":"任務遂行に支障はない。これまで通り、遠慮なく言ってほしい。","fan":"这身衣服对完成任务毫无影响。希望您能和之前一样，有事和我说。","off":"放心吧，这对执行任务没有影响。像平时那样有事尽管说就可以了。"},{"label":"大厅5","jp":"おはようございます、先生。今日も一日、よろしくお願いします。\n生徒として挨拶をしてみたのだけど……へ、変だっただろうか？","fan":"早上好，老师。今天也请多指教。\n想试着用学生的方式打招呼……会、会不会觉得奇怪？","off":"你好啊，老师。今天一天也请多关照了。用学员的方式打了个招呼……会，会很奇怪吗？"},{"label":"回忆大厅1","jp":"……あっ！先生！ま、待ってくれ！このまま渡すのは、ちょっと……！","fan":"……啊！老师！等、等等！就这样给您的话，有点……","off":"老，老师，你，你先等等。我想了想，这个就这样给你好像不太好……！"},{"label":"回忆大厅2","jp":"その、私が脚で挟んでしまったもの、だから……\nこれは私が食べるから、先生はこっちを……！","fan":"这根被我用大腿夹过了，所以……\n我吃这根，老师就吃另一根……！","off":"因，因为我是用腿夹住的，所以感觉有点脏……这个我来吃吧，老师干脆吃我的这个……！"},{"label":"回忆大厅3","jp":"……あ。これは私の食べかけ……","fan":"……啊。这根已经咬过一口了……","off":"……啊。对了，这个已经被我吃过一口了……"},{"label":"回忆大厅4","jp":"ち、違う！そういう意味じゃなくて……！\nやっぱこっちの……！では、なくて！","fan":"不、不是的！我不是那个意思！\n果然还是这根……！不、不对！","off":"啊，不是，等等！不是的，我绝对不是那个意思……！还是给你这个…………！啊，不对不对！"},{"label":"回忆大厅5","jp":"本当に、そんなつもりは……！\nど、どちらを渡しても……うう……\nわ、私はどうすれば……！","fan":"我真的没有那个意思……！\n不管怎么选都……呜呜……\n我、我到底该怎么办……！","off":"才，才不是！我真的，真的没有那个意思！不，不管给哪个都……！呜呜……我该怎么办……！"},{"label":"咖啡馆1","jp":"どこかに鏡は……","fan":"哪里有镜子呢……","off":"要是有面镜子就好了。"},{"label":"咖啡馆2","jp":"時間ができた……先生はどこに……","fan":"腾出时间了……老师在哪呢……","off":"有点闲呐……老师什么时候来呢……"},{"label":"咖啡馆3","jp":"ここは可愛い家具が多いな……気に入った。","fan":"这里有很多可爱的家具呢……我喜欢。","off":"好多可爱的家具呢……我很喜欢。"},{"label":"咖啡馆4","jp":"敵の気配はなさそうだ。警戒を少し緩める。","fan":"似乎没有敌人呢。可以稍微放松警惕。","off":"看样子这里没有敌人。可以放松警戒一下了。"},{"label":"咖啡馆5","jp":"この辺の掃除を…………いや、制服のときは止めておこう。","fan":"把这边清扫一下……算了，穿制服的时候还是别想这些了。","off":"打扫一下这里吧…………唔，穿着制服还是算了。"}],"好感度":[{"label":"好感度1","jp":"先生はこの格好、どう思う……？","fan":"老师觉得这身衣服，怎么样……？","off":"老师，我穿制服的样子……怎么样？"},{"label":"好感度2","jp":"今日は先生の身辺警護を行う、この服装なら、怪しまれることもないだろう……","fan":"今天要担任老师的贴身护卫，穿这套衣服的话，应该不会被怀疑吧……","off":"今天我会贴身护卫老师。穿这身衣服……应该会更自然吧。"},{"label":"好感度3","jp":"制服姿で先生の隣に立つのは何だか新鮮で……いいな……","fan":"穿着制服站在老师旁边，有些新鲜呢……感觉不错……","off":"穿着制服和老师见面……有种和平时不一样的感觉，我挺喜欢的。"},{"label":"好感度4","jp":"任務中ではあるが、先生と話す時間は作れる、いつでも声をかけてくれ。","fan":"虽然说正在执行任务，不过还是能挤出时间和老师说话。有事请吩咐。","off":"那个，虽然是在执行任务……但留给老师的时间还是有的，随时都可以叫我。"}],"战斗":[{"label":"编入队伍1","jp":"ガイドを探しているのか？","fan":"你在找向导吗？","off":"需要向导吗？"},{"label":"编入队伍2","jp":"この格好で仕事をするのか……？","fan":"穿成这样工作……？","off":"工作……穿这身衣服去也可以的话……好吧"},{"label":"拎起","jp":"丈が…気になる…","fan":"有点在意…裙子的尺寸…","off":"跟平时的衣服相比……这个……有点短"},{"label":"普通技能","jp":"ターゲット、確認！","fan":"目标确认！","off":"目标，确认！"},{"label":"EX动画1","jp":"その……えっと……危ない！","fan":"那个……嗯……危险！","off":"呃，就是……等等，危险！"},{"label":"EX动画2","jp":"あ……それは……伏せろ！","fan":"啊……那个是……快趴下！","off":"呃，就是……嗯？躲好！"},{"label":"EX动画3","jp":"ちょっと私では……こっちに！","fan":"现在有点……在这边！","off":"我也不太清楚……啊！这边！"},{"label":"EX技能1","jp":"危険を排除した、もう大丈夫だ。","fan":"已排除危险，没问题了。","off":"危险已经排除。可以放心了。"},{"label":"EX技能2","jp":"問題ない、私が解決する。","fan":"没问题，我来解决。","off":"不用担心。我会解决的。"},{"label":"EX技能3","jp":"援護開始、後は任せてくれ。","fan":"开始援护，后面就交给我吧。","off":"实施掩护。狙击交给我吧。"}],"成长":[{"label":"升级1","jp":"先生、この恩は、絶対に忘れない。","fan":"老师的这份恩情，我绝对不会忘记。","off":"老师，这份恩情……我绝不会忘记的。"},{"label":"升级2","jp":"いつもの格好ではないが、この姿でしかできない仕事もあるから。","fan":"虽然不是平常那身打扮，不过也存在用这种姿态才能完成的任务。","off":"虽然这身日常打扮与战斗无关，但，它一定也有派上用场的时候吧。"},{"label":"升级3","jp":"私にここまで…？有難う、この力で先生を守って見せる！","fan":"您为了我做到这种地步……？谢谢，我一定会用这份力量保护老师！","off":"竟然对我如此厚爱……谢谢。我会用这份力量守护老师的。"},{"label":"升级4","jp":"先生……分かった……期待に応えられるよう、善処する！","fan":"老师……我明白了……为了回应您的期望，我定将全力以赴。","off":"原来老师对我如此期待……我明白了。我会全力以赴，不负所望。"},{"label":"获得专武","jp":"いつでも、どんな姿でも、先生のために駆けつけると誓おう。","fan":"无论何时，无论以何种姿态，我誓会为老师奔赴。","off":"无论何时、无论何地，无论穿着女仆装还是制服，我都随时准备着守护老师。"}],"事件":[{"label":"学生生日","jp":"誕生日……ありがとう。今日は一日中、先生と一緒にいられるのか……嬉しい。","fan":"生日……谢谢您。今天一天，能和老师在一起吗……好开心。","off":"生日……谢谢你。今天一整天都能和老师在一起……我很开心。"},{"label":"老师生日","jp":"お誕生日おめでとう。欲しいものがあれば言ってくれ。先生が喜ぶものを、贈りたいんだ。","fan":"生日快乐。如果有什么想要的东西请告诉我。\n我想送一份能让老师高兴的礼物。","off":"生日快乐，老师。有什么想要的尽管说。我想送老师你喜欢的东西。"},{"label":"万圣节","jp":"ハロウィーンか。普段あまり制服を着ないから\nなんだかもう仮装をしているような気分だ。","fan":"万圣节吗。因为平常不怎么穿制服，所以有一种已经变装的感觉。","off":"万圣节到了啊。可能是因为我平时不太穿制服，现在这身打扮反而像变装一样。"},{"label":"新年","jp":"先生、明けましておめでとう。今年はもう少し、こうして私と……\nな、何でもない。","fan":"老师，新年快乐。今年能否也像这样，和我一起……\n没、没什么。","off":"新年快乐，老师。今年要是能像这样多见见面……啊，没什么。"},{"label":"圣诞节","jp":"クリスマスを過ごすのに、この服装は平凡すぎる気が…………似合ってるから大丈夫？あ、ありがとう。","fan":"明明是在过圣诞节，感觉这身衣服太过普通……很适合所以没关系？谢、谢谢夸奖。","off":"感觉这身装扮对过节来说有些普通……诶？很适合我……？谢，谢谢。"},{"label":"春节","jp":"","fan":"新春快乐，老师。难得度过这么热闹的节日，今天我也会暂时歇口气，换下平时的女仆装扮。那么……能请你陪我度过，普通学员的一天吗？这次我一定会找到最适合我们的方式。","off":"新春快乐，老师。难得度过这么热闹的节日，今天我也会暂时歇口气，换下平时的女仆装扮。那么……能请你陪我度过，普通学员的一天吗？这次我一定会找到最适合我们的方式。"},{"label":"中秋","jp":"","fan":"今天好像是叫做中秋的日子呢，老师。满月之下，一切风平浪静，没有紧急任务，能穿着这身制服和老师一起静静度过……就像老师教过我的，即使是平凡无奇的一天，只属于我们的回忆也会让它变得特别，你说对吗？","off":"今天好像是叫做中秋的日子呢，老师。满月之下，一切风平浪静，没有紧急任务，能穿着这身制服和老师一起静静度过……就像老师教过我的，即使是平凡无奇的一天，只属于我们的回忆也会让它变得特别，你说对吗？"}],"活动":[{"label":"活动登陆1","jp":"お、お疲れ、先生。……言い慣れないな。","fan":"辛苦了，老师……这样说还是不太习惯。","off":"你，你好，老师。……打招呼的方式和平时不太一样，有点别扭呢。"},{"label":"活动登陆2","jp":"もう少し可愛い挨拶を……い、今のは独り言だ！","fan":"有没有更可爱的打招呼方式……刚、刚刚的只是自言自语！","off":"要用更可爱的方式…………啊，刚才是在自言自语！"},{"label":"活动大厅1","jp":"ど、どうしたんだ？依頼か？","fan":"怎、怎么了？有委托吗？","off":"呃，怎，怎么了？有什么需要我做的事吗？"},{"label":"活动大厅2","jp":"こ、これはミレニアム指定の制服だけど……？何か変なところでもあるのか？","fan":"这、这是千禧年指定的制服哦……？有什么奇怪的地方吗？","off":"这，这只是千禧年的普通制服……有什么奇怪的地方吗？"},{"label":"活动大厅3","jp":"えっと……先生。せっかくの制服だ、からその、私と一緒に……","fan":"嗯……老师。我难得穿一回制服，所以，和我一起……","off":"那个……老师。难得穿了制服，要不要一起……"},{"label":"活动大厅4","jp":"……や、やはり、何でもない。気にしないでくれ。","fan":"……还、还是算了，没什么。请不要在意。","off":"……啊，算了，没什么。抱歉。"},{"label":"活动事件1","jp":"まったく……気が休まらない。","fan":"真的是……心烦意乱。","off":"这次活动比想象中还要混乱啊……"},{"label":"活动事件2","jp":"あと少しだ、先生。一緒に頑張ろう。","fan":"再坚持一下，老师。一起加油吧。","off":"还差一点就要结束了。加油，老师。"},{"label":"活动结束","jp":"終わったんだな。終わってみると逆に……名残惜しく感じる。","fan":"结束了。这个时候反而觉得……有些不舍。","off":"这么快就结束了。感觉……有点依依不舍呢。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/948070.mp3","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/29/1780059823726_1780058736000_agtoxvprhd_9jy8ufwk7c.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/4/391842.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/810564.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/29/1780059825709_1780058734000_lkgk8yggms_r8qs7o4xrt.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/4/203950.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/980845.mp3","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/29/1780059827608_1780058879669_om7i3oz6ri_sgn9xqpngh.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/4/901777.mp3"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.