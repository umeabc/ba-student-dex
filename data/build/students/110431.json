5.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/72581.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":[]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/157597/2025/5/11/809385.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/72581.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/855153.png","name":"倾尽茱莉全力的巧克力","desc":"茱莉为了送给老师而倾尽全力制作的手工巧克力。即使不尝味道，光是看着也可以感受到茱莉百分百的真心。"},"ability":{"attrs":[{"name":"生命值","value":"755"},{"name":"攻击力","value":"158"},{"name":"治愈力","value":"229"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/749295.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/162843.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 朱莉（打工）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/157597/2025/5/11/438716.png","url":"https://www.gamekee.com/ba/649361.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue…Blue Archive."},{"label":"卡池抽取","jp":"ゲヘナ学園、給食部のジュリといいます。\nお腹が空いたら、いつでも私に言ってくださいね？","fan":"格黑娜学园，配餐部的朱莉。\n如果肚子饿了，无论何时都可以和我说我哦？","off":"我是歌赫娜供餐部的朱莉。肚子饿了，请随时告诉我哦～"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生。お腹空いてないですか？","fan":"欢迎回来，老师。肚子饿了吗？","off":"欢迎回来，老师。您饿不饿呢～"},{"label":"登陆2","jp":"おかえりなさい、先生。ご飯にしますか？\nそれとも…お・や・つ？","fan":"欢迎回来，老师。要吃饭吗？\n还是说…来・点・小・吃？","off":"欢迎回来，老师。需要用餐吗？还是来些……小、点、心？"},{"label":"大厅1","jp":"料理に酸味を出すためには、香辛料を入れるのと、塩酸を入れるのと、どちらがいいのでしょうか…？","fan":"为了让料理散发出酸味，放香辛料还是放盐酸呢，到底哪个好呢…？","off":"想给饭菜里增加酸味的话，是放调味料好呢，还是放盐酸好呢？"},{"label":"大厅2","jp":"食材が生きているというのはそれだけ新鮮ということですから良いことですよね？","fan":"食材还活着所以非常新鲜，这样很不错吧？","off":"食材还在活蹦乱跳，就说明我的食材很新鲜呢。这不是好事嘛？"},{"label":"大厅3","jp":"なんか、焦げ臭いです…？","fan":"怎么闻到，糊了的味道…？","off":"好像有股……烧焦的味道。"},{"label":"大厅4","jp":"…あら、私ったら！パイをオーブンに入れっばなしだったことを忘れてました！","fan":"…哎呀，我真是的！忘记了把派放进烤箱了！","off":"哎呀，我可真是的！我忘了派还放在烤箱里呢！"},{"label":"大厅5","jp":"うう…。なんで私は料理をするたびに、失敗ばかりするのでしょう…。","fan":"呜呜…为什么我每次做饭都会失败呢…","off":"呃……为什么我每次做饭都会失败呢……"},{"label":"回忆大厅1","jp":"あっ、見てください先生！\nこの真っ赤に実ったトマト、すっごく美味しそうだと思いませんか？","fan":"啊， 请看看这个，老师！\n这颗红彤彤熟透了的番茄，不觉得看起来就十分的美味吗？","off":"-"},{"label":"回忆大厅2","jp":"えへん、これも給食部としての成果です。 丹精込めて作った甲斐がありました！\nあ、あっちのトマトもすごく良い感じに……","fan":"嘿嘿，这也是我身为供餐部一员的成果。用心努力去栽培果然是值得的！\n啊，那边的番茄也长得很不错……","off":"-"},{"label":"回忆大厅3","jp":"えっと、あ、あれ、なのですが、その……何だかちょっと距離が……？\nこの近さですと、あの、私……。","fan":"唔，嗯……就，就在，那边……话说……距离是不是有点\n距离这么近的话，唔，我……","off":"-"},{"label":"回忆大厅4","jp":"（あ、先生の香りが……）\n（な、何だか急に、胸がドキドキしてきました……！？）","fan":"（啊，是老师的味道……）\n（总，总觉得心脏突然跳得好快呀……？！）","off":"-"},{"label":"回忆大厅5","jp":"だっ、大丈夫です、はい！ご心配なく……！\nただその何と言いますか、えっと……\n何だか顔が熱くなってきて、その……！うぅ……！","fan":"没，没事的！对！不用担心我……！\n只是这该怎么说呢？就是……\n不知道为什么，总觉得脸热得发烫，这……！","off":"-"},{"label":"回忆大厅6","jp":"","fan":"","off":"-"},{"label":"回忆大厅7","jp":"","fan":"","off":"-"},{"label":"咖啡馆1","jp":"う～ん、甘い香り…。","fan":"嗯~，甜甜的香味…。","off":"（嗅嗅）嗯～！甜甜的香味！"},{"label":"咖啡馆2","jp":"これも食べられますかね？","fan":"这个也能吃吗？","off":"嗯……这个也可以吃吧～"},{"label":"咖啡馆3","jp":"とりあえず一回、揚げてみようかな…。","fan":"先炸一次吧…","off":"要不先试着……炸一下吧？"},{"label":"咖啡馆4","jp":"あら。とても良いところですね。","fan":"哎呀。是个很好的地方呢。","off":"哎呀……这里真是个好地方～！"},{"label":"咖啡馆5","jp":"ここは美味しいお料理が作れそうです。","fan":"在这里好像能做出好吃的菜。","off":"感觉在这里，可以做出美味的料理！"}],"好感度":[{"label":"好感度1","jp":"先生と一緒に過ごす時間は、お料理をしてる時と同じくらい楽しいです。","fan":"和老师度过的时间，跟做饭一样快乐。","off":"和老师一起度过的时光，就和做饭的时候，一样开心！"},{"label":"好感度2","jp":"最高の香辛料は…まさしく愛です♡","fan":"最棒的香料…还得是爱呀♡","off":"最棒的调味料，就是爱！"},{"label":"好感度3","jp":"この幸せを味で表現する為には、どんな食材入れればいいのか悩みますね。","fan":"为了用味道来表现这种幸福，我很烦恼应该放入什么样的食材。","off":"如果要用味道来表达这份幸福，应该放入什么样的材料呢……？好烦恼啊……"},{"label":"好感度4","jp":"先生と一緒に食べるお料理なら、どのようなお料理でも美味しいです。","fan":"如果是和老师一起吃的菜，无论什么菜都很好吃。","off":"只要是和老师一次吃饭，无论是什么样的饭菜，都会很好吃！"}],"战斗":[{"label":"编入队伍1","jp":"では、実力を発揮してみましょうか。","fan":"那么，就让我来发挥实力试试吧。","off":"那么，就来发挥一下实力看看吧！"},{"label":"编入队伍2","jp":"私にお任せください～","fan":"请交给我吧~","off":"请交给我吧！"},{"label":"拎起","jp":"うう……また逃げられてしまいました。","fan":"呜…… 又让它跑掉了。","off":""},{"label":"普通技能","jp":"私もお手伝いしますね！","fan":"我也来帮忙啦！","off":"我也会帮忙的哦！"},{"label":"EX动画1","jp":"せーのっ…あららっ！？","fan":"一、二......哎呀！？","off":"一、二……哎呀！"},{"label":"EX动画2","jp":"このままひっくり返せば…あれっ？！","fan":"就这样翻个面…咦？！","off":"只要再这样翻个面……啊啊！"},{"label":"EX动画3","jp":"これで完成です！…ちょっと待って！？","fan":"这样就完成了！…等等！？","off":"这样就完成啦！……啊！等一下！"},{"label":"EX技能1","jp":"あ、あれっ？","fan":"诶，啊咧？","off":"啊……诶？！"},{"label":"EX技能2","jp":"皆さんが食べちゃだめなのに～。","fan":"明明大家都不能吃的～","off":"大家……不可以吃哦！"},{"label":"EX技能3","jp":"皆さんの分ではありません～！","fan":"这不是大家的份儿～！","off":"啊……这不是给你们吃的！"},{"label":"载具协同1","jp":"-","fan":"","off":""},{"label":"载具协同2","jp":"-","fan":"","off":""},{"label":"战斗开始1","jp":"気をつけて、いってらっしゃい！","fan":"路上小心！","off":"路上小心哦。慢走～！"},{"label":"战斗开始2","jp":"補給なら心配しないでください。","fan":"补给的话请不要担心。","off":"补给的事情请不用担心！"},{"label":"获得BUFF","jp":"さあ、美味しいご飯が届きますよ。","fan":"好了，美味的饭来咯。","off":""},{"label":"特殊载具","jp":"","fan":"","off":"好啦，美味的饭菜送来了哦～"},{"label":"特殊载具","jp":"","fan":"","off":"各位，吃饭的时间到了哦～"}],"成长":[{"label":"升级1","jp":"これでもっと、美味しいご飯が作れるようになれますでしょうか？","fan":"这样一来能做出更好吃的饭吗？","off":"这样……我是不是就可以做出更美味的饭菜了呢～"},{"label":"升级2","jp":"お料理上手になる為にも、体力は必須です！","fan":"为了变得擅长料理，体力是必须的！","off":"为了烹饪出更可口的饭菜，体力是必不可少的！"},{"label":"升级3","jp":"なんだかお料理がしたくなりますね！","fan":"总觉得想做饭了呢！","off":"诶嘿，突然很想做饭啦！"},{"label":"升级4","jp":"もっと美味しいお料理を作るために頑張ります！","fan":"为了能做出更美妙的料理而努力！","off":"我会尽全力做出美味的料理的！"},{"label":"获得专武","jp":"ふふ、この銃をお料理に使うと、お肉の食感がぐんと柔らかくなりますね！","fan":"呵呵，使用这把枪做菜的话，肉的口感会变得很软呢！","off":"诶嘿嘿，如果用这把枪来做饭，肉的质地应该会柔软很多的！"}],"事件":[{"label":"学生生日","jp":"私の誕生日プレゼントですか？\nふふ…。その言葉だけでも十分嬉しいですよ。","fan":"我的生日礼物吗？\n呵呵…光是一声生日祝贺就足够让我高兴了。","off":"我的生日礼物……？诶嘿嘿，有您这句话，我就已经很开心啦。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！\n先生に差し上げようとケーキを焼いたのですが、\nそれがその…。逃げちゃいました…。","fan":"祝你生日快乐，老师！\n为了送给老师，我烤了蛋糕\n但是就是那个…蛋糕逃跑了…","off":"祝您生日快乐，老师。我本来烤了一个蛋糕准备送给老师，可是……蛋糕……逃走了。"},{"label":"万圣节","jp":"ハロウィーンになるとなぜか私の作ったお菓子が人気なんです。\nいたずらにぴったり…？だとか。","fan":"到了万圣节，不知道为什么我做的点心就变得很受欢迎。\n非常适合恶作剧…？据说是这样。","off":"不知道为什么，一到万圣节，我做的点心就很受欢迎。他们说什么……很适合用来搞……恶作剧……？"},{"label":"新年","jp":"お正月を迎えたのでおせち料理を作ってみました。\nよろしければ味見していただいてもいいでしょうか？","fan":"因为迎来了新年，所以试着做了年菜。\n如果可以的话可以尝尝吗？","off":"快到正月啦。我试着准备了一些年节菜。不知道您能不能帮我尝一下味道呢？"},{"label":"圣诞节","jp":"えー、その、クリスマスだから七面鳥を焼いたのですけれど…\n生きてて動くローストターキーはだめですよね…？","fan":"嗯，那个，因为是圣诞节所以烤了火鸡…\n活着的还能活蹦乱跳的烤火鸡果然还是不行的吧…？","off":"嗯……那个，因为圣诞节到了，所以我烤了火鸡。但是火鸡烤熟了……应该，是不会活蹦乱跳的吧……"},{"label":"春节","jp":"","fan":"我在年夜饭里加入了很多很多的爱～老师，趁它还没逃走，快来尝尝吧～！","off":"我在年夜饭里加入了很多很多的爱～老师，趁它还没逃走，快来尝尝吧～！"},{"label":"中秋","jp":"","fan":"不知道为什么，歌赫娜的大家好像不怎么欢迎我做的月饼。……啊，老师，您会吃的吧，一定会的吧！","off":"不知道为什么，歌赫娜的大家好像不怎么欢迎我做的月饼。……啊，老师，您会吃的吧，一定会的吧！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/18/367417.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/18/841992.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/662434.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/18/930331.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/18/705845.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/298341.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/11/545164.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/18/776199.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/148714.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/11/581030.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0