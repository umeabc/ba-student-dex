/wiki2.0/images/w_304/h_240/829/408107/2025/11/25/828312.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/408107/2025/11/25/571140.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 满","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_352/h_352/829/191981/2025/11/25/531660.png","url":"https://www.gamekee.com/ba/tj/155255.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルゥ～！こほん……アーカイブ？","fan":"碧蓝~！咳咳……档案？","off":""},{"label":"卡池抽取","jp":"先生殿～調子はどう？今回は潜入任務だよ！よろしくね！","fan":"老师殿下～情况如何？这次是潜入任务呢！拜托你了！","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生殿、待ってたよ～！ツクヨがヘアアイロンを貸してくれたんだけど……使い方知ってる？","fan":"老师殿下，等你很久啦~！月咏借给我一个直发夹……你知道这个怎么用吗？","off":""},{"label":"登陆2","jp":"お待ちしておりました、先生。\n……違う。いくらドレスだからってこれは違う気がする。","fan":"久等了，老师\n……不对。就算是穿着礼服再怎么说这打招呼的感觉也不太对……","off":""},{"label":"大厅1","jp":"綺麗な服であるほど、不便なものなのかなぁ……。","fan":"越是美丽的衣服，就越是不便吗……","off":""},{"label":"大厅2","jp":"この服……動きにくいけど、道具を隠せる場所が多いのは良いよね。","fan":"这件衣服……虽然行动不方便，但是有很多能藏道具的地方，这点还是不错的。","off":""},{"label":"大厅3","jp":"忍者とは、その心に宿るもの……！\nだからドレスを着ていても、忍者は忍者なのだっ！","fan":"忍者之道，在于心中所持的信念……！\n就算穿着礼服，忍者也还是忍者！","off":""},{"label":"大厅4","jp":"ラーメン、食べたいけど……この格好じゃなぁ……。","fan":"虽然想吃拉面……不过这身衣服不太方便呢……","off":""},{"label":"大厅5","jp":"これがミチル流ドレスコード～！ふっふっふ！","fan":"这就是小满流着装！哼哼！","off":""},{"label":"回忆大厅1","jp":"中身は……指輪、だね！？\n手裏剣の飾りがついてて、良い感じ……じゃん！？","fan":"里面是……戒指！？\n上面还有手里剑的装饰，感觉不错嘛……！？","off":""},{"label":"回忆大厅2","jp":"……え？先生殿、つけるの……？\nあ、いや、いいんだけど……。","fan":"诶？老师殿下，要为我戴上吗……？\n啊，不是，也行啦……","off":""},{"label":"回忆大厅3","jp":"（あれ……？指輪を、相手に渡す……？\nこれって……告白、みたいな――！？）","fan":"（诶……？把戒指给对方……？\n就像……告白一样——！？）","off":""},{"label":"回忆大厅4","jp":"ちょっ、ちょっと待って先生殿！\n別に狙ってたわけじゃなくて……！でも、えっと……！","fan":"等等，等等！老师殿下！\n我也不是有什么企图啦……！不过，嗯……！","off":""},{"label":"回忆大厅5","jp":"うぅ……うああぁ～～っ！！","fan":"呜呜……呜哇~！？","off":""},{"label":"咖啡馆1","jp":"ふふ……私に気がつく人がいたらどうしよう……？","fan":"要是有人注意到我该怎么办……？","off":""},{"label":"咖啡馆2","jp":"このドレス……ここで着るのはやり過ぎ……？","fan":"在这穿这身礼服……果然太显眼了吗……？","off":""},{"label":"咖啡馆3","jp":"（ドレスと、コーヒー……あっ！このネタ使えるかも……！）","fan":"（礼服和咖啡……啊！这个梗说不定能用得上……！）","off":""},{"label":"咖啡馆4","jp":"いつか絶対……！ここでファンミーティングを……！","fan":"（总有一天一定要……！在这里举办粉丝见面会……！）","off":""},{"label":"咖啡馆5","jp":"（よし！とりあえず……人目につかない場所はどこだろ？）","fan":"（好咧！总之……先找个不会引人注目的地方先吧？）","off":""}],"好感度":[{"label":"好感度1","jp":"これはちょっと恥ずかしい、かも……。","fan":"也许，有点羞耻……","off":""},{"label":"好感度2","jp":"この髪型、どうかな？結構頑張って、セットしたんだけど……。","fan":"这个发型吗？这可是费了番工夫才搞好的……","off":""},{"label":"好感度3","jp":"えっ、可愛い……？先生殿ってば、またまたぁ……ふ、ふへへっ……。","fan":"诶，可爱……？老师殿下真是的，又来这套……呜嘿嘿……","off":""},{"label":"好感度4","jp":"この格好なら、先生殿のボディガードとして……そばにいてもいい……？","fan":"如果以这身装扮的话……我可以作为老师殿下的护卫……待在你身边吗……？","off":""}],"战斗":[{"label":"编入队伍1","jp":"あ、あー。こちらアンダーカバーゼロワン。……ってこれでいいんだっけ？","fan":"啊，啊——这里是特工01……这样就行了吧？","off":""},{"label":"编入队伍2","jp":"私たちの作戦場所は……ここだね！","fan":"我们的作战场所……就在这里！","off":""},{"label":"拎起","jp":"このドレスは任務のためで……！で、でも……その、先生殿は、どう思う？","fan":"这身礼服就是为了任务才……！不，不过……那个，老师殿下，觉得如何？","off":""},{"label":"普通技能","jp":"秘儀を伝授して進ぜよう！","fan":"将秘技传授于你吧！","off":""},{"label":"EX动画1","jp":"これがミチル流……うにゃああっ！？","fan":"这就是小满流……呜喵！？","off":""},{"label":"EX动画2","jp":"とくと見よ！これが最新のカメ、らぁ～～っ！？","fan":"看好了！这就是最新的相机——啊！？","off":""},{"label":"EX动画3","jp":"少女忍法帖ミチルっち、スタ～とぉぉおっ！？","fan":"少女忍法贴，开始——唔哦哦！？","off":""},{"label":"EX技能1","jp":"キャッ、チ……うにゃああっ！？","fan":"呀——呜喵！？","off":""},{"label":"EX技能2","jp":"ふぅ……めっ、目が～っ！？","fan":"呜……眼，眼睛——！？","off":""},{"label":"EX技能3","jp":"ふぅ……オフショットはだめぇ！","fan":"呜……花絮什么的不要啊！","off":""}],"成长":[{"label":"升级1","jp":"この感覚……これが、シンデレラフィット……！","fan":"这个感觉……这就是歪打正着……！","off":""},{"label":"升级2","jp":"服装が変わっても、心持ちまで変わるわけじゃないよ！","fan":"即使服装变了，心境也不会有变化！","off":""},{"label":"升级3","jp":"こんな珍しい物をくれるってことは……先生殿も、忍者の道を行きたくなったの？","fan":"老师送我如此珍贵的礼物，也就是说……老师也想踏上忍者之道吗？","off":""},{"label":"升级4","jp":"ふふっ、どう？私……可愛いく……いや、強くなった？","fan":"哼哼，如何？我……变得更可爱……不对，变强了？","off":""},{"label":"获得专武","jp":"いいの……？私に、こんな……！でも、先生殿の判断なら！うん！ありがとう！","fan":"这样好吗……？给我这么贵重的礼物……！不过如果是老师殿下的判断的话肯定没错！嗯！谢谢！","off":""}],"事件":[{"label":"学生生日","jp":"あ、先生殿。今日は私の誕生日配信があるんだ。\n誕生日プレゼントってことで……先生殿も、スペシャルゲストとして出演してくれない？\nえっ、いいの！？じゃあ早く！こっち座って、カメラ見て！","fan":"啊，老师殿下。今天有我的生日直播。\n作为生日礼物……老师能以特别嘉宾的身份出镜吗？\n诶，可以吗！？那么快点！在这里坐好，看相机！","off":""},{"label":"老师生日","jp":"ふっふっふ……今日は先生殿のために、おめかししてきたよ！……ん？私がプレゼントなのかって？\nちっ、違ぁう！いや、別にそれでもいいけど……あっ、そうじゃなくて！うにゃああっ……！！","fan":"哼哼哼……今天我可是特意为老师打扮了一番呢！嗯？礼物是不是我自己？\n才，才不是！不，虽然那样也行……啊，不是这样的！呜喵……！","off":""},{"label":"万圣节","jp":"ん？このまきびし？もちろん、キャンディを狙う者たちへの罠を――\n……じょ、冗談だよ。まきびしの形のキャンディだってば。","fan":"嗯？这些撒菱？当然是为冲着糖果来的人准备的陷阱——\n只，只是玩笑啦。是撒菱形状的糖果。","off":""},{"label":"新年","jp":"あけましておめでとう～先生殿♪やっぱお正月と言ったら時代劇だよね！というわけで……時代劇のリレー上映会、いっしょにどう？","fan":"新年快乐~老师殿下。说到正月，果然还是会想到时代剧！所以说……一起参加时代剧连映会吧？","off":""},{"label":"圣诞节","jp":"先生殿、知ってた！？サンタの正体は……変装した忍者なんだって……！","fan":"老师殿下，你知道吗！？传说圣诞老人的真身……其实是变装的忍者……！","off":""}],"活动":[{"label":"活动登陆1","jp":"潜入任務に持って行くなら、おにぎりか兵糧丸か――ん？先生殿！いらっしゃい！","fan":"要执行潜入任务的话，得准备些饭团或者兵粮丸——嗯？老师殿下！欢迎光临！","off":""},{"label":"活动登陆2","jp":"先生殿……良い格好じゃん。こういう感じも新鮮だね。","fan":"老师殿下……这身打扮很不错嘛。这种风格也很新鲜呢。","off":""},{"label":"活动大厅1","jp":"なんかヒマだなぁ……。ん？こういうこと言うと絶対何か起きるって？","fan":"好闲啊……嗯？只要说出这句话就一定会发生什么？","off":""},{"label":"活动大厅2","jp":"うぅ……これ、キツくて動きにくい……。みんなこれの何がいいの！？","fan":"呜呜……这身衣服行动不怎么方便……这衣服到底哪里好了！？","off":""},{"label":"活动大厅3","jp":"服装は忍者の条件にあらず……なれば、忍者を忍者たらしめるものは何か……！？","fan":"服装并非忍者的必要条件……那么，究竟什么才是定义忍者的本质……！？","off":""},{"label":"活动大厅4","jp":"とくと見よ……！ドレスごとき、忍者にとって何の障害でもない、ということを……！","fan":"看好了……！区区礼服对忍者而言，根本构不成任何阻碍……！","off":""},{"label":"活动事件1","jp":"だ～～っ！なんでファッションショーで戦い始めるのさっ！？","fan":"搞什么啊——！怎么会在时装秀上突然打起来！？","off":""},{"label":"活动事件2","jp":"ツクヨに会いたい……。元気かな……ラーメン、ちゃんと食べれてるといいけど……。","fan":"好想见月咏啊……她还好吗……要是有好好吃拉面就好了……","off":""},{"label":"活动结束","jp":"忍術研究部、完全復活！先生殿も！こっちこっち！","fan":"忍术研究部，完全复活！老师殿下也快来这边！","off":""},{"label":"活动商店1","jp":"選択は慎重に、購入は大胆に……！それがグッズを買う時の掟……！","fan":"慎重选择，大胆购买……！这就是购买周边的铁律……！","off":""},{"label":"活动商店2","jp":"いつかここに、少女忍法帖ミチルっちのグッズを……！","fan":"总有一天，我要让这里铺满少女忍法贴小满亲的周边……！","off":""},{"label":"活动商店关闭","jp":"ふっふん～早く閉めて、新しい忍者定食を食べに行こーよ！","fan":"哼哼~早点关店，去吃新的忍者套餐吧！","off":""},{"label":"活动商店登录1","jp":"いらっしゃい、先生殿！ゆっくり見てってね。\nあ！でも、この商品なんだけど、私が思うには――","fan":"欢迎，老师殿下！慢慢看哦。\n啊！不过，这件商品依我来看——","off":""},{"label":"活动商店登录2","jp":"無い物以外、ぜーんぶあるよ！ふっふっふ！","fan":"除了没有的东西，其他的都有！哼哼哼！","off":""},{"label":"活动商店购买1","jp":"おぉ～それかぁ。良い選択じゃん？","fan":"哦哦~买那个吗。不错的选择嘛。","off":""},{"label":"活动商店购买2","jp":"そう！忍者ならそれを選ばなくっちゃね！","fan":"正是如此！是忍者的话就应该选那个！","off":""},{"label":"活动商店购买3","jp":"こちら、温めま……あっ、間違えた。","fan":"可以到这边热一下……啊，搞错了。","off":""},{"label":"活动商店购买4","jp":"おお……！それはまさに！イチオシ商品！\nまあ、全部イチオシなんだけど！","fan":"哦哦……！那个正是！第一推荐的商品！\n不过，这里全都是第一推荐的商品！","off":""},{"label":"烹饪店登录1","jp":"あ、先生殿も来たんだね！……私？どれにするか悩んでたとこ。","fan":"啊，老师殿下来了！我？我正在纠结选哪个。","off":""},{"label":"烹饪店登录2","jp":"んん～いい匂い――\nだけでもないけど！まあ、いってみよー！","fan":"嗯嗯~好香啊——\n不只是香啦！试试吧！","off":""},{"label":"烹饪店1","jp":"麺とスープ……それはまさに忍者と忍術……。","fan":"面和汤……简直像是忍者和忍术……","off":""},{"label":"烹饪店2","jp":"先生殿はどんなラーメンが好き？","fan":"老师殿下喜欢什么拉面？","off":""},{"label":"烹饪店烹饪1","jp":"えっ……これ、ラーメンなの……？","fan":"诶……这是，拉面吗……？","off":""},{"label":"烹饪店烹饪2","jp":"悪くないけど……悪くはない……ほんと、それだけ……。","fan":"也不算差……不算差……真的，仅此而已……","off":""},{"label":"烹饪店烹饪3","jp":"んっ、なかなかやるじゃん……？","fan":"嗯，这不是很能干嘛……？","off":""},{"label":"烹饪店烹饪4","jp":"うにゃっ……！？こ、この味は……！","fan":"呜喵……！？这，这个味道……！","off":""},{"label":"烹饪店烹饪5","jp":"おぉ……！新しい忍術をひらめけそうな味だよ……！！","fan":"哦哦……！这味道仿佛能激发出全新的忍术灵感啊……！","off":""},{"label":"烹饪店结束","jp":"ごちそうさまでした……もう何も入んない……。","fan":"谢谢款待……已经一口都吃不下了……","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/408107/2025/11/25/674493.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/191981/2026/5/6/1780680479569_1780063524000_gywgpcw45n_zyri27bksz.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/408107/2025/11/25/142872.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/191981/2026/5/6/1780680480848_1780063526000_i6n8rb5bs4_2uig5uru5w.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/408107/2025/11/25/989071.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/191981