kee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/424017.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/777601.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/879441.png","name":"温泉蛋巧克力","desc":"惠特意亲手制作的巧克力。乍一看真的很像温泉蛋，所以容易搞混。惠做了很多，需要多少应有尽有。"},"ability":{"attrs":[{"name":"生命值","value":"1350"},{"name":"攻击力","value":"78"},{"name":"治愈力","value":"205"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/280756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"惠（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/43637/2025/6/24/102114.png","url":"https://www.gamekee.com/ba/671483.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive~"},{"label":"卡池抽取","jp":"やっほ～！どこ削ってほしい？\nそれとも掘り起こしとく？なんでも言って～！","fan":"想要铲平哪里？还是想要挖掘？\n什么都可以哦~！","off":"哟吼~！想让我把哪里推倒？还是想让我在哪里挖坑？尽管开口吧~！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おっ、先生！おかえり～。\n今日は何する？温泉作る？","fan":"噢，老师！欢迎回来~！\n今天要做什么？温泉开发？","off":"啊，老师~欢迎回来~！今天要做些什么呢？温泉开发怎么样~！"},{"label":"登陆2","jp":"待ってたよ、先生！\n何でも言って！\nすぐに取りかかるから！","fan":"等你很久了！老师！\n有什么要帮忙的就说哦！\n会立刻帮你的！","off":"老师，我正等你呢~！有什么事你尽管说，我马上就去做~！"},{"label":"大厅1","jp":"んで、私ここで何すればいいの？\nあっためてあげよっか？\nそれとも…。","fan":"所以，我要在这里做什么呢？\n给你取暖吧？\n还是说......","off":"所以，我要在这里做什么呢？给你暖暖身子……？还是说……"},{"label":"大厅2","jp":"ん？仕事がない時？\n…なにしてたっけ？\nあ！仕事探してた！","fan":"嗯？没有工作的时候都会干什么？\n嗯...会干什么来着？\n啊！会找事来做！","off":"嗯？没有开发温泉的时候，我都在做什么……？嗯……我都在做什么来着……啊！我在找温泉开发~"},{"label":"大厅3","jp":"もつれてるの見ると我慢できないんだよね。\n全部削って、最初からやり直したほうが早い！","fan":"弯弯绕绕缠在一起看起来很难受呢！\n全部清除掉，从头开始更好！","off":"啊，我最讨厌东西纠缠到一起了！还是快刀斩乱麻，从头开始更方便！"},{"label":"大厅4","jp":"お腹空いたの？カップ麺でも作ろっか？\nえ？道具？…これで作るよ～♪","fan":"肚子饿了吗？要不给你做个泡面？\n诶？道具？用这个来做~♪","off":"肚子饿啦？那给你煮杯泡面啊~？诶，没有工具……？那就用这个吧~！"},{"label":"大厅5","jp":"出力調整はできるのかって？\nできるよ？多分。\nやったことないけどね！","fan":"你问这个能不能调整火力？\n大概能吧。虽然我没有试过就是了！","off":"你问能不能调整火力……？能吧……应该。虽然我没试过~"},{"label":"回忆大厅1","jp":"あ～！やっぱ先生だったんだ！\n待ってたよ！忙しかった？ごめん！\nでも急いでて！","fan":"果然是老师啊~等你很久了哟！\n老师很忙吗？抱歉！不过快跟我来吧！","off":"哈~！果然是老师，我正等你呢！老师很忙吗？不好意思，但我这边也很急~！"},{"label":"回忆大厅2","jp":"ああ～それはそうなんだけど…\nこれ、湧き続ける温泉じゃないんだ。\nあと数時間しかなくて！\n枯れちゃう前に、先生に来て欲しかったんだ！","fan":"啊啊~虽然是那样的，这个，并不是会源源不断涌出水来的喷泉哦。\n过几个小时，温泉的水源就会枯竭，在它消失之前，想让老师来一次！","off":"啊~确实是这样。不过，这点温泉可不会一直涌出温泉水哦~应该……只剩下几个小时了！我希望老师能在温泉干涸之前赶到这里！"},{"label":"回忆大厅3","jp":"…え？そうだよ？\n一人で作ったよ！","fan":"诶？是的哦。是我一个人挖的哦！","off":"诶？是哦？这就是我一个人做的哦~"},{"label":"回忆大厅4","jp":"こう見えても温泉開発部だし！\nそれに、お湯を求める人を見て見ぬふりなんてできないし。\nなにより、先生が関わってるってなったらね！…ひひっ！","fan":"别看我这样，好歹也是温泉开发部的部员！\n而且，也没办法忽视那些渴望泡温泉的人。\n更重要的是，还和老师有关系呢！","off":"别看我这样，我可是温泉开发部的！再说了，对于需要热水的人，我可不能视而不见~更重要的是，这可是和老师有关呀~嘿嘿~！"},{"label":"回忆大厅5","jp":"ささ！遠慮しないで入って！\n今が一番いい温度だから！\nメグ特製の先生専用温泉だよ！！","fan":"快点来泡温泉吧！现在正是最佳温度！\n惠特制的、老师专用温泉哦！","off":"快快快，不要再客气了~快进来吧！现在温度刚刚好呢~！这可是特别准备的，老师专属温泉哦~！"},{"label":"咖啡馆1","jp":"ここが、先生の…？おおっ…！！","fan":"这里就是老师的......！？唔哦！！","off":"这里就是……老师的……哦哦……！"},{"label":"咖啡馆2","jp":"温泉…は湧かないよねぇ。","fan":"温泉...在哪呢~没有呢","off":"温泉在……这里应该不会有吧。"},{"label":"咖啡馆3","jp":"ま、先生の場所だし。ここは例外にしとこっと。","fan":"毕竟是老师的地盘，就当作是例外吧！","off":"啊……毕竟这里是老师的地盘~就当作例外吧！"},{"label":"咖啡馆4","jp":"あれ？あの人は…ハッ！","fan":"诶？那个人是...？哈！","off":"啊，那个人是……啊！"},{"label":"咖啡馆5","jp":"人が多いね。わちゃわちゃしてていいじゃん！","fan":"人很多嘛！这么热闹真是不错！","off":"人真多呀~！热热闹闹的真好啊~！"}],"好感度":[{"label":"好感度1","jp":"えっと～うん？なんだろう？よくわかんないや、なんだろうこれ？","fan":"诶，这是什么啊？不是很明白耶，这是神马？","off":"呃……诶？什么情况？我不太懂……这是什么情况啊？"},{"label":"好感度2","jp":"先生といると楽しい！理由？なんでだろうね？考えてことないや！","fan":"和老师在一起真是开心！为什么会开心？为什么呢？没有想过呢！","off":"和老师在一起好开心~！诶？旅游……？为什么呢？我从来没想过……"},{"label":"好感度3","jp":"何か手伝えることある？何となく…そういう気分！","fan":"有什么我能帮忙的吗？不知不觉…就是那种感觉！","off":"有什么需要我帮忙的嘛？……没什么，就是，突然很想帮老师！"},{"label":"好感度4","jp":"おっかしいな―別に暑がれじゃないなのに、先生と一緒にいると、なんか熱いだよね。","fan":"真是奇怪啊，明明不是天气很热，只要和老师在一起，总觉得身体微微发烫呢。","off":"好奇怪啊……我平时也不怕热，但只要和老师在一起，我都会觉得有些热呢……"}],"战斗":[{"label":"编入队伍1","jp":"ガツンと行ってみよう！","fan":"让我们上吧！","off":"热火朝天地开始吧~！"},{"label":"编入队伍2","jp":"火力は～十分だよね！","fan":"火力充足！","off":"火力，可是非常充足的~！"},{"label":"拎起","jp":"-","fan":"（喊叫）","off":"哟哈诶~！"},{"label":"任命队长1","jp":"撤去許可おりたって！","fan":"拆除许可已经下发了！","off":"已经拿到特殊许可啦~！"},{"label":"任命队长2","jp":"片付けるものがいっぱい！","fan":"有好多要清理的东西！","off":"要清理的东西好多呀~！"},{"label":"普通技能","jp":"こんなのはどう？","fan":"这个怎么样？","off":"这些怎么样啊~！"},{"label":"EX动画1","jp":"あははははは！","fan":"啊哈哈哈哈！","off":"啊哈哈哈哈~！"},{"label":"EX动画2","jp":"行け行け行け行け～","fan":"冲冲冲~","off":"冲啊冲啊冲啊冲啊~！"},{"label":"EX动画3","jp":"まだまだ足りないよね！","fan":"还不够满足！","off":"还不够还不够~！"},{"label":"EX技能1","jp":"いっ~ぱい上げちゃう！","fan":"火力全开！","off":"火力全开~！"},{"label":"EX技能2","jp":"遠慮しないでいいよ！","fan":"不用那么客气也可以哦！","off":"不用这么客气~！"},{"label":"EX技能3","jp":"どう？気持ちいいよね！","fan":"怎么样？很舒服吧！","off":"怎么样~爽吧~！"},{"label":"战斗开始1","jp":"全部削っちゃう～","fan":"全部都消失吧~","off":"全都拆掉吧~！"},{"label":"战斗开始2","jp":"温泉開発の時間だよ！","fan":"现在是温泉开发时间！","off":"现在是温泉开发的时间哦~！"},{"label":"获得BUFF","jp":"うお～ありがとう。","fan":"哦~感谢。","off":"哦~谢谢~！"},{"label":"施放BUFF","jp":"いっちょやるか。","fan":"开始干活吧。","off":"要不要来一节~！"},{"label":"掩体","jp":"うあ～危ない危ない。","fan":"唔哇~好险好险。","off":"啊！好危险好危险~！"},{"label":"被CC1","jp":"ッウ！","fan":"唔！","off":"呃啊！"},{"label":"被CC2","jp":"クッ！","fan":"库！","off":"呀啊！"},{"label":"被CC3","jp":"な…なに!?","fan":"什…什么！？","off":"怎……怎么回事！"},{"label":"回避","jp":"あれ？今何かした？","fan":"啊咧？刚刚发生什么了？","off":"诶？刚刚发生什么了？"},{"label":"队伍移动1","jp":"はい！次！","fan":"好！下一处！","off":"好，继续！"},{"label":"队伍移动2","jp":"クリア！","fan":"完成！","off":"完成~！"},{"label":"回复","jp":"ありがとう！頑張っちゃうよ！","fan":"感谢！要加油上了哦！","off":"谢谢，我打起精神了~！"},{"label":"中途退出","jp":"グフ！","fan":"（喊叫）","off":"呜哇！"},{"label":"战斗喊叫","jp":"どりゃ！","fan":"（喊叫）","off":"呀啊！"},{"label":"战斗喊叫","jp":"わはははは～","fan":"哇哈哈哈~","off":"啊哈哈哈哈~！"},{"label":"战斗喊叫","jp":"は！","fan":"哈！","off":"哈！"},{"label":"角色移动","jp":"-","fan":"（喊叫）","off":"喝！"},{"label":"战斗胜利1","jp":"みんな～お疲れ様～","fan":"大家~辛苦了！","off":"哇~大家都辛苦啦~！"},{"label":"战斗胜利2","jp":"手応え十分！","fan":"手感很好！","off":"我现在手感火热~！"},{"label":"关卡完成1","jp":"あれ？もう終わり？","fan":"啊咧？这就结束了吗？","off":"啊？这就结束啦~？"},{"label":"关卡完成2","jp":"はぁ～気持ちいい！","fan":"哈啊~心情舒畅！","off":"呀啊~好爽~！"},{"label":"战斗失败1","jp":"うう―もっと持ってくればよっかた。","fan":"呜呜，要是再多带点东西来就好了","off":"啊……早知道就多带些过来了！"},{"label":"战斗失败2","jp":"あれ？どうしてこうなったの？","fan":"啊咧？为什么会变成这样呢？","off":"诶……怎么会变成这样……"}],"成长":[{"label":"升级1","jp":"おお！何これ！力が湧いてくるんだけど！","fan":"哦哦！什么啊这是！力量涌上来了！","off":"哦啊~什么情况~？感觉我身上现在充满了力量！"},{"label":"升级2","jp":"支援してくれてありがとう！私も頑張らないと！","fan":"感谢你的支援！我也必须要加油了呢！","off":"多谢你的支援！我也要更加努力了！"},{"label":"升级3","jp":"こういうの大歓迎だよ！嬉しい！ありがとう、先生！","fan":"支援大欢迎！好高兴！谢谢老师！","off":"这些我当然是举双手欢迎了~！好开心！老师，谢谢你！"},{"label":"升级4","jp":"期待しててね！頑張るよ！","fan":"好好期待我的表现吧！我会加油的！","off":"你就拭目以待吧，我会加油的！"},{"label":"获得专武","jp":"あれっ、くれるの？なんで？\nう～ん。私、バカだからよく分かんないけど…。\nま、一生懸命やりゃなんとかなるよね！\nあははは！！","fan":"欸！？这个是给我的吗？为什么？\n嗯~我是个笨蛋所以不太明白......\n嘛，总之只要努力做好就行了吧！啊哈哈哈！！","off":"啊，这是给我的嘛？为什么……？啊，我这个人比较笨，所以搞不明白。不过，只要拼尽全力就可以了吧~啊哈哈哈~！"}],"事件":[{"label":"学生生日","jp":"そ！今日は、私の誕生日！誕生日プレゼントで欲しいもの…？\n削れるなにか？","fan":"对了！今天，是我的生日！有什么想要的礼物吗...？比如说铲点什么？","off":"对，今天是我的生日！……你问我想要什么生日礼物？比如……可以推倒的什么东西~！"},{"label":"老师生日","jp":"お誕生日おめでとう、先生！\n今日はアツい日だね！","fan":"生日快乐，老师！\n今天真是个热辣的日子呢！","off":"祝你生日快乐老师！今天真是一个火热的日子呀~！"},{"label":"万圣节","jp":"街に不思議な格好の子がいっぱい…。\n今日は風紀委員に見つかっても逃げられるかも？","fan":"街上好多奇装怪服的孩子...\n难道说今天可以从风纪委员会手里被放过一马？","off":"外面有很多穿着奇装异服的孩子呢……难道今天可以从风纪委员会手里逃过一劫？"},{"label":"新年","jp":"あけましておめでとう～！\n今年はもっとたくさんの仕事を…障害物と掘れる土地をください！！","fan":"新年快乐~！\n今年请赐予我更多更多超级多的...铲除障碍物、开发土地之类的工作！！","off":"新年快乐~！新年请赐予我更多的工作！比如，拆除障碍物，和挖掘土地之类的~！"},{"label":"圣诞节","jp":"今日だっけ？いい子にしてたらプレゼントが贈られる日って。\nいいね！私は何がもらえんのかな？楽しみ！","fan":"今天？听说是乖孩子收到礼物的日子呢。\n真不错！我会收到什么呢？好期待啊！","off":"是今天吧，给好孩子送礼物的节日~真好，我会收到什么礼物呢~已经开始期待了！"},{"label":"春节","jp":"","fan":"老师，新春快乐~！新的一年，一定会和天惠神力喷出的火焰一样，红红火火的！","off":"老师，新春快乐~！新的一年，一定会和天惠神力喷出的火焰一样