25574muy18szr.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/14687271muy194ez.webp"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/98243175muxxagn3.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/78409466muxxao86.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/72856367muy17wlu.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/31287961muy183op.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/21080239muy18bvs.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/04125574muy18szr.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/14687271muy194ez.webp"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ、アンド・ピース。","fan":"Blue Archive，与和平。","off":""},{"label":"卡池抽取","jp":"ワイルドハント芸術学院、オカルト研究会の\n椎名ツムギです。ええ、ギターは持っていますよ――\n「ラブ・アンド・ピース」。……は大事ですから。","fan":"我是狂猎艺术学院神秘学研究会的椎名䌷。\n嗯，我是带着吉他的哦，毕竟——\n「爱与和平」……是很重要的。","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生。\n今日も私の芸術に――\nお付き合いください。","fan":"你好，老师。\n今天也请陪我一起——\n沉浸于我的艺术吧。","off":""},{"label":"登陆2","jp":"ふふっ、心弾む一日に\nなりそうです。……先生も、\nそう思いませんか？","fan":"呵呵，今天看来会是让人心潮澎湃的一天呢。\n……老师，你不这么觉得吗？","off":""},{"label":"大厅1","jp":"音楽は魂の共通言語……そう言われています。言葉を交わさずとも、互いの心に触れ合うことができますから。では、一曲――\n聞いていただけますか？","fan":"音乐是灵魂的通用语言……人们是这么说的。\n因为就算不交谈，也能触碰到彼此的心。那么，一曲——能请您听听看吗？","off":""},{"label":"大厅2","jp":"人魚姫は、愛する人のために自らの声を差し出しました。ええ、それはあまりに気高く――美しい決断です。ふふっ……私にもいつか、それほどの感情を抱ける方が現れるのでしょうか？","fan":"人鱼公主为了心爱的人献出了自己的声音。嗯，那是何等高贵——而美丽的决断。\n呵呵……有朝一日，我的生命里也会出现让我怀抱那般感情的人吗？","off":""},{"label":"大厅3","jp":"意外と、童話のオリジナルは残酷な物語が多いんです。当時、子どものために紡がれたものではなかったからなのでしょう。芸術とはそういうもの……時代の潮流によっていかようにでも形を変えるのです。","fan":"意外的是，童话的原版里残酷的故事还挺多的。\n大概是因为当年它们并不是为孩子而编织的吧。\n艺术就是这样的东西……会随时代的潮流，改变成任何形态。","off":""},{"label":"大厅4","jp":"先生にとってのデスメタルとは、どのようなものですか？私にとっては――――「人生」。……でしょうか。デスメタルに触れてから、私の物語に色が増えたのですから。もちろん、良い意味ですよ？ふふっ。","fan":"对老师来说，死亡金属是什么样的东西？对我来说——是「人生」……大概吧。\n因为自从接触了死亡金属，我的故事就增添了色彩。当然是好的意义上哦？呵呵。","off":""},{"label":"大厅5","jp":"デスメタルをはじめたきっかけ……ですか？ふふっ、内緒です。誰にだって、一つや二つくらいあるでしょう？――「聖域」に\n隠した謎、が。","fan":"我接触死亡金属的契机……吗？呵呵，保密。不管是谁，都会有一两个的吧？\n——藏在「圣域」里的谜团，之类的。","off":""},{"label":"回忆大厅0","jp":"誰の心にだって、\n闇は存在するもの。それぞれ悩みを抱え、\n迷い――道を歩んでいる。","fan":"无论谁的心中，都存在着黑暗。\n各自怀着烦恼，迷茫——走在自己的道路上。","off":""},{"label":"回忆大厅1","jp":"――私も、そうです。この道で良いのか、と。\n悩む時もあります。","fan":"——我也一样。\n也会烦恼，想着这条路究竟对不对。","off":""},{"label":"回忆大厅2","jp":"そんな私に、\n先生は言ってくれましたよね。私が自由に――後悔のない日々を\n過ごせるよう、支える、と。","fan":"对那样的我，老师你对我说过吧。\n会支持我，让我能自由地——度过没有后悔的日子。","off":""},{"label":"回忆大厅3","jp":"ですから、先生は……。――「私の闇を照らす光」\nだったのです。","fan":"所以，老师你……。\n——就是「照亮我黑暗的光」。","off":""},{"label":"回忆大厅4","jp":"私の光であるあなたへ、\nこの曲を捧げましょう。感謝を込めた、旋律を……\n聞いてください。","fan":"这首曲子，献给你——我的光芒。\n饱含感谢的，旋律……请聆听。","off":""},{"label":"咖啡馆1","jp":"ふふっ、ここで\nライブを\nしてみたいですね。","fan":"呵呵，真想在这里办一场现场演出呢。","off":""},{"label":"咖啡馆2","jp":"あの飾り……\n打楽器に\n使えそうですね。","fan":"那个装饰……\n好像能当打击乐器用呢。","off":""},{"label":"咖啡馆3","jp":"この辺りなら\n「お菓子の家」を\n作れそうです。","fan":"在这一带的话好像能搭一座「糖果屋」。","off":""},{"label":"咖啡馆4","jp":"BGMを流すなら……\nデスメタルが\nぴったりですね","fan":"要放背景音乐的话……\n死亡金属再合适不过了呢","off":""},{"label":"咖啡馆5","jp":"ここは、みなさんの\n思い出が宿る場所……\n私にとっても、\nそうかもしれません。","fan":"这里是承载着大家回忆的地方……\n对我来说，或许也是如此。","off":""}],"好感度":[{"label":"好感度1","jp":"音楽とは、アーティストと心を通わせること。\n……であるのなら、\n今この瞬間も音楽と呼べるのではないでしょうか？ふふっ。","fan":"所谓音乐，就是与艺术家心灵相通。\n……若真是如此，\n那此刻这个瞬间，不也可以称作音乐吗？呵呵。","off":""},{"label":"好感度2","jp":"ふと……心の音色を奏でたくなりました。\n言葉にできない想いも、旋律になら乗せることができますから。","fan":"忽然……想奏响心中的音色。\n因为无法言说的思念，\n若是用旋律，或许就能够承载。","off":""},{"label":"好感度3","jp":"シンデレラの気持ちがいまなら理解できます。\n12時を目前にして……このまま、\n時間が止まってくれればいいのに、と。\nどれほど願ったことでしょう。","fan":"现在我终于理解灰姑娘的心情了。\n眼看着就要到12点……就这样，要是时间能停下来就好了。\n我曾无数次这样祈祷过。","off":""},{"label":"好感度4","jp":"人は生きていく限り、変化していくもの。\nけれど、今のこの気持ちだけは……\n永遠に変わらないでほしい、とそう思っています。","fan":"人只要活着，就会不断变化。\n但是，唯有此刻这份心情……\n希望它永远不要改变，我是这么想的。","off":""}],"战斗":[{"label":"编入队伍1","jp":"開演の準備は整っています。","fan":"开演的准备工作已经就绪。","off":""},{"label":"编入队伍2","jp":"今日は何を聞きたいですか？","fan":"今天想听什么呢？","off":""},{"label":"拎起","jp":"ふふっ、この子も、立派な楽器ですよ？","fan":"呵呵，这孩子也是件出色的乐器哦？","off":""},{"label":"任命队长1","jp":"ここが、今宵のステージですね！","fan":"这里就是今宵的舞台呢！","off":""},{"label":"任命队长2","jp":"ツムギ音楽隊、出発です！","fan":"䌷音乐队，出发！","off":""},{"label":"普通技能","jp":"ふふ、インスピレーションが湧いてきました。","fan":"呵呵，灵感涌上来了。","off":""},{"label":"EX动画1","jp":"饗宴の幕開けです。","fan":"饗宴开幕。","off":""},{"label":"EX动画2","jp":"この瞬間を、待っていました。","fan":"我一直在等待这一刻。","off":""},{"label":"EX动画3","jp":"みなさん、準備は良いですか？","fan":"各位，准备好了吗？","off":""},{"label":"EX技能1","jp":"これが社会の福祉だぁぁ！！","fan":"这就是社会的福祉啊啊！！","off":""},{"label":"EX技能2","jp":"平和……平和だけがあればいい！","fan":"和平……只要有和平就够了！","off":""},{"label":"EX技能3","jp":"ラブ・アンド・ピーーーース！","fan":"爱与和——平——！","off":""},{"label":"战斗开始1","jp":"悪魔の召喚儀式……ご一緒にいかがですか？","fan":"恶魔的召唤仪式……要不要一起来？","off":""},{"label":"战斗开始2","jp":"さあ、鎮魂歌を奏でましょう。","fan":"来吧，奏响镇魂曲吧。","off":""},{"label":"获得BUFF","jp":"「友情」……は大事ですから。","fan":"毕竟「友情」……是很重要的。","off":""},{"label":"施放BUFF","jp":"BPMを上げていきましょう！","fan":"提高BPM（节拍）吧！","off":""},{"label":"掩体","jp":"小休止としましょう。","fan":"稍作小憩吧。","off":""},{"label":"被CC1","jp":"ああっ！","fan":"啊！","off":""},{"label":"被CC2","jp":"あらっ！","fan":"哎呀！","off":""},{"label":"被CC3","jp":"くっ…","fan":"呃…","off":""},{"label":"回避","jp":"ふふっ、可愛いですね","fan":"呵呵，真可爱呢。","off":""},{"label":"队伍移动1","jp":"パフォーマンスの場所を変えましょうか。","fan":"把表演的地点换一换吧。","off":""},{"label":"队伍移动2","jp":"あちらで待っている方がいますね。","fan":"那边有正在等着的人呢。","off":""},{"label":"回复","jp":"……温かい。","fan":"……好温暖。","off":""},{"label":"中途退出","jp":"少し、はしゃぎすぎてしまったようです…","fan":"似乎有点得意忘形了…","off":""},{"label":"战斗喊叫","jp":"えい！","fan":"嘿！","off":""},{"label":"战斗喊叫","jp":"はっ！","fan":"哈！","off":""},{"label":"战斗喊叫","jp":"ふふっ！","fan":"呵呵！","off":""},{"label":"角色移动","jp":"せーのっ！","fan":"预~备！","off":""},{"label":"战斗胜利1","jp":"次の饗宴を楽しみにしています。","fan":"期待下一场盛宴。","off":""},{"label":"战斗胜利2","jp":"ラブ・アンド・ピース、ですね。","fan":"爱与和平，对吧。","off":""},{"label":"关卡完成1","jp":"ふふっ、音楽隊の演奏はいかがでしたか？","fan":"呵呵，音乐队的演奏如何？","off":""},{"label":"关卡完成2","jp":"公演の感想、ぜひお聞かせください","fan":"请务必告诉我您对演出的感想。","off":""},{"label":"战斗失败1","jp":"ウサギの穴へ…あら、踏み外してしまいました…","fan":"去往兔子洞…哎呀，一脚踩空了…","off":""},{"label":"战斗失败2","jp":"糸車の針に刺されて、深き微睡みへ、落ちてゆきます…","fan":"被纺车的针刺伤，向着深沉的微睡坠落…","off":""}],"成长":[{"label":"升级1","jp":"先生のおかげで、降りてきました。作曲においては――\n「インスピレーション」\nが何よりも大事ですから。","fan":"多亏了老师，我才迎来了灵感。\n毕竟在作曲上——「灵感」\n比什么都重要。","off":""},{"label":"升级2","jp":"ええ、喜ばしいことです。\n新しい成長の扉を開くことができるのですから。","fan":"嗯，这是值得高兴的事。\n因为能够打开新的成长之门。","off":""},{"label":"升级3","jp":"ふふっ……奥底で眠っていた何かが、\n今、目覚めた気がします。","fan":"呵呵……我感觉沉睡在深处的\n某样东西，此刻苏醒了。","off":""},{"label":"升级4","jp":"成長を実感したとしても、自惚れてはいけません。\n果てなき芸術の世界では――\n――「チャレンジ」。\n……が大事ですから。","fan":"就算切实感受到成长，也不能自满。\n在无尽的艺术世界里——「挑战」。\n……是很重要的。","off":""},{"label":"获得专武","jp":"ありがとうございます、先生。\nこの子がいれば、\nどこでも演奏会が開けそうです。\n平和へと導く――煉獄の旋律を。","fan":"谢谢你，老师。\n有了这孩子，感觉在哪里都能开演奏会。\n奏响引领向和平的——炼狱之旋律。","off":""}],"事件":[{"label":"学生生日","jp":"よく、友人の誕生日に歌を歌っているのですが……。先生は、どのようにお祝いをなさるのですか？よければ……私のために、歌っていただけませんか？","fan":"我经常在朋友生日的时候唱歌……。老师是怎样庆祝的呢？可以的话……能为我，唱一首吗？","off":""},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。先生のためのバースデーソング――ええ、ありきたりなものであってはいけません。私の方でアレンジしてみたのですが……聞いていきますか？","fan":"生日快乐，老师。献给老师的生日歌——嗯，可不能是平庸之作。\n我这边试着重新编曲了……要听听看吗？","off":""},{"label":"万圣节","jp":"今日ほど、デスメタルが似合う日もないと思います。では、始めましょうか。戻ってきた魂に捧げる、鎮魂歌を。","fan":"我想没有比今天更适合死亡金属的日子了。那么，开始吧。为归来的亡魂献上的，镇魂曲。","off":""},{"label":"新年","jp":"まるで何も書き込まれていないスコアのような日、ですね。あけましておめでとうございます、先生。私とこの楽譜に――新たな音を刻んでいきましょう。","fan":"就像是还没写上任何音符的乐谱的一天这样呢。新年快乐，老师。\n让我们在这份乐谱上——与我一起刻下新的音符吧。","off":""},{"label":"圣诞节","jp":"今年の楽章も、そろそろ終わりが近づいてきましたね。先生の一年は、どんな旋律でしたか？明るいものであったなら……私も嬉しいです。","fan":"今年的乐章，也快要接近终点了呢。\n老师的一年，是怎样的旋律呢？若是明朗的旋律……我也会很高兴的。","off":""}],"活动":[{"label":"活动登陆1","jp":"ようこそ。夢と\n希望のワンダーランドへ。","fan":"欢迎。来到充满梦想与希望的仙境。","off":""},{"label":"活动登陆2","jp":"ふふっ、先生を導く\nことができて光栄です。","fan":"呵呵，能引导老师，\n是我的荣幸。","off":""},{"label":"活动大厅1","jp":"先生もコープス・\nペイントを\nしてみませんか？私にお任せください。\n素敵に仕上げて\n見せますよ？","fan":"老师要不要也试试尸妆？\n就交给我吧。\n我会帮你化得很漂亮的哦？","off":""},{"label":"活动大厅2","jp":"…やはり、バニーガールの\n格好でお迎えすべきで\nしたでしょうか？","fan":"……果然，我应该穿兔女郎装来迎接才对吗？","off":""},{"label":"活动大厅3","jp":"私のギターは、\n平和を歌っています。……ええ、\n嘘はついてませんとも。","fan":"我的吉他，歌唱着和平。\n……嗯，我可没有说谎。","off":""},{"label":"活动大厅4","jp":"ふふっ。\nセッションで触れる\n魂の共鳴も素敵ですが……指先のふれあいも、\n大切にしていきたい\nですね。","fan":"呵呵。\n合奏时触及的灵魂共鸣固然美妙……\n但指尖的触碰，我也想好好珍惜呢。","off":""},{"label":"活动事件1","jp":"みなさんの努力が、\n実を結びますように。","fan":"愿大家的努力，都能结出果实。","off":""},{"label":"活动事件2","jp":"そろそろ……\nエンディングの\nお時間ですね。饗宴の準備は\nできています。","fan":"差不多……\n到终章的时间了呢。\n饗宴已经准备好了。","off":""},{"label":"活动结束","jp":"先生の魂に残る\n調べであったのなら、\n幸いです。","fan":"这旋律若是能留在老师的灵魂中，那就太好了。","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/42679649muxxkoa6.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/87494351muxxku6w.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/67352317muxxkxeh.ogg","",""],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/04971939muxxl0rw.ogg","",""],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/74738321muxxlb68.ogg","",""],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/48746661muxxlm2a.ogg","",""],"大厅及咖啡馆|大厅3":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/99493193muxxlpqr.ogg","",""],"大厅及咖啡馆|大厅4":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1017575/2026/9/7/53146963muxxlusb.ogg","",""],"大厅及咖啡馆|大厅5":["https://cdnim