":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/12/218317.png","url":"https://www.gamekee.com/ba/618557.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー…アーカイブ…","fan":"碧蓝…档案…","off":"Blue...Archive...zzz"},{"label":"卡池抽取","jp":"夢かと思った、今この瞬間…。\nこんにちは。先生。これからよろしくね。","fan":"此时此刻，就像做梦一样…\n你好。老师。今后请多关照啦。","off":"刚才有一瞬间，我还以为是在做梦……老师，你好~以后请多多关照啦~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ふぁ～。おはよう…先生。\nえ？朝じゃない？別にいいでしょ～","fan":"啊欠~。早上好...老师。\n诶？不是早上吗？没关系啦~","off":"呃啊……早上好，老师！嗯……？已经不是早上啦……？……嗯，不要在意细节"},{"label":"登陆2","jp":"ふあ。先生…ごめん…\nもうちょっと寝る。先生も…ここに横になる？","fan":"啊欠。老师...抱歉...\n再让我睡会吧。老师也...躺下来睡会？","off":"嗯……老师，抱歉……我再多睡一会儿……要不，老师您也躺这儿~"},{"label":"大厅1","jp":"ふあー…あれ？先生。来てた？","fan":"啊欠...啊咧？老师。您来啦？","off":"呃啊……诶？老师，您来啦……？"},{"label":"大厅2","jp":"昼寝にちょうどいい時間なのに…\n一旦寝て起きたら、もっと仕事も捗るんじゃないかな？","fan":"明明是午睡的好时间…\n睡一觉起来，工作也会有更大的进展吧？","off":"现在正是睡午觉的时候啊……睡一觉起来，工作也会更有效率吧？"},{"label":"大厅3","jp":"夜に何をしてたらそんなに眠いのかって？\nふふっ。先生になら教えてあげようかな～","fan":"晚上做了什么才那么困？\n呵呵。如果是老师的话，我就姑且告诉你吧~","off":"你问我昨天晚上干了什么今天这么困？……诶嘿嘿，看在老师的面子上，要不，我就告诉你吧？"},{"label":"大厅4","jp":"ふぁ…ん…。起きてから一番初めに会う人が先生だとは…いいね。","fan":"唔...嗯...。醒来见到的第一个人是老师...真好啊。","off":"啊……嗯……睡醒起来第一个看见的人就是老师，真好~"},{"label":"大厅5","jp":"（このまま時間が止まってほしい。なんだか、すごく心地いい気持ち）","fan":"（好想时间就停留在此刻。总觉得很舒服）","off":"（真希望时间就这么停下来……感觉，真的好舒服啊~）"},{"label":"回忆大厅1","jp":"先生…来てくれたんだね…","fan":"老师...您来了呢...","off":"老师……嗯……你来啦？"},{"label":"回忆大厅2","jp":"うん、今は修行中…。座禅をしてた…。","fan":"嗯，现在正在修行中...。在打坐...。","off":"嗯……我正在……修行……坐禅呢……"},{"label":"回忆大厅3","jp":"居眠りしてたんじゃないの、って…？\n違うよ…。これも、れっきとした、修行の一環だから…。","fan":"真的不是在打瞌睡吗...？\n才不是呢...。这也是修行的一环...。","off":"你说我只是在打瞌睡……？才没有呢……这可是……正经的……修行的一个环节…"},{"label":"回忆大厅4","jp":"近場にこんな、修行にぴったりの場所があったなんて…。\n幸せ。まるで、夢を見てるみたいな気分…。\nこの幸せも、全部、先生のおかげなのかな…？","fan":"附近竟然有这么适合修行的地方…。\n真幸福。简直就像在做梦一样…。\n这份幸福，全部都是托老师的福吧…？","off":"没想到附近还有这么适合修行的地方……真幸福~……感觉……像在做梦一样……我能这么幸福，也全是……因为有老师在吧……"},{"label":"回忆大厅5","jp":"ん…ほら、先生もそんなところにいないで、私と一緒に…。…寝よ？","fan":"唔...哎呀，老师也别站在那里，和我一起...。...睡觉吧？","off":"嗯……老师，您也别光站着啊……快来一起……小睡一会吧……"},{"label":"咖啡馆1","jp":"あはは！あー…笑ったら眠くなった。","fan":"啊哈哈！啊——...笑着笑着就觉得困了。","off":"啊哈哈哈~啊……一笑，就感觉犯困啦……"},{"label":"咖啡馆2","jp":"わ～ここならゆっくりできそう～","fan":"哇~这里好像可以好好睡一觉~","off":"啊……这里，感觉可以好好休息一下~"},{"label":"咖啡馆3","jp":"うふふふっ。新しい枕が届くよ。楽しみすぎる","fan":"嘿嘿嘿嘿。新枕头到了。超级期待。","off":"诶嘿嘿嘿~新的枕头马上就到啦，真的好期待啊~"},{"label":"咖啡馆4","jp":"あはは！さ、さっき…！\n夢で…先生が…\nああ、もうダメ、面白すぎる！あはは。","fan":"啊哈哈！刚、刚刚...！\n梦里...老师...\n啊啊，我快不行了，太好笑了！啊哈哈。","off":"啊哈哈哈，刚……刚才……老师……在梦里……啊，不行了……太搞笑了……啊哈哈……"},{"label":"咖啡馆5","jp":"あはは！あ～よく寝た！\nうん？そんな姿を見るのは初めて？","fan":"啊哈哈！啊~睡得真舒服！\n嗯？第一次见我这个姿势？","off":"啊哈哈哈，啊……睡得好舒服~嗯……？第一次见我这个样子嘛~"},{"label":"咖啡馆6","jp":"なんだか眠たくなるようなのんびりとした空間だね～","fan":"是让人想睡觉的悠闲空间呢~","off":"这个地方让人感觉好放松，不知不觉都有点犯困了～"},{"label":"咖啡馆7","jp":"夢を見てる気分なの。なんでだろう？","fan":"像是在做梦一样。这是为什么呢？","off":"总感觉是在做梦，为什么呢？"}],"好感度":[{"label":"好感度1","jp":"暖かい日差し、ふかふかの枕、柔らかい布団、\nそして……先生……。……良いね。","fan":"温暖的阳光，松软的枕头，柔软的被子，\n还有……老师……\n……真好啊。","off":"温暖的阳光，蓬松的枕头，柔软的被子，还有……老师，真好~"},{"label":"好感度2","jp":"世界で一番嫌いなもの？目覚まし時計。\nでも、先生の声は嫌いじゃないよ？","fan":"世界上最讨厌的东西？闹钟。\n但是，我不讨厌老师叫我起床的声音哦？","off":"世界上最讨厌的东西……？……闹钟。但是，我不讨厌老师叫我的声音。"},{"label":"好感度3","jp":"わ、私だって一応本気を出す時はあるよ…。\n戦う時と…先生と一緒にいる時。","fan":"我，我也有认真的时候哦…。\n战斗的时候和…和老师在一起的时候。","off":"我、我有时候也会认真的！比如，战斗的时候……还有，和老师在一起的时候。"},{"label":"好感度4","jp":"幸せだけど、怖い。今この瞬間が夢のように目覚めてしまいそうで。","fan":"很幸福，但也害怕。害怕这个瞬间睁开眼梦就醒了。","off":"我很幸福，但是也很害怕……我怕现在这一刻，会像做梦一样醒过来。"}],"战斗":[{"label":"编入队伍1","jp":"わかった、今起きるから～","fan":"知道了，我现在就起床~","off":"明白了……我现在就起……"},{"label":"编入队伍2","jp":"ふぅ～、それじゃ、また帰ってきてから寝るね～","fan":"呼~这样的话，那就回去再睡吧~","off":"啊~……那我，回来再睡啦~\n拎起"},{"label":"拎起","jp":"ふわ…意外と快適？","fan":"轻飘飘的…意外地舒适？","off":"喔……还挺，舒服的…"},{"label":"任命队长1","jp":"はぁ～。あの子たちは、睡眠とらないのかな？","fan":"呼啊~。那些孩子们不睡觉的吗？","off":"嗯……那些孩子，不睡觉的嘛？"},{"label":"任命队长2","jp":"ふぅ、しゅっぱ～つ。がんばって～。…え、私も行くの？","fan":"呼，出~发。加油~。...诶，我也要去吗？","off":"嗯……出发~加油~！……诶？我也要去嘛？"},{"label":"普通技能","jp":"傷？寝て起きたら治るよ。","fan":"伤？睡一觉起来就好啦。","off":"伤口……？睡一觉就好啦~"},{"label":"EX动画1","jp":"よっと。じゃあ行こっか！","fan":"好咧，那就走吧！","off":"好嘞~那我们走吧~！"},{"label":"EX动画2","jp":"守らなきゃいけないものがあるの！","fan":"我也有必须要守护的东西！","off":"我有必须要保护的东西！"},{"label":"EX动画3","jp":"さあ、修行の成果を見せるよ！","fan":"好，就让你见识下我修行的成果！","off":"来，给你展示一下训练的成果吧！"},{"label":"EX技能1","jp":"誰も私の昼寝は、いや、先生の邪魔はさせない！","fan":"谁也别想打扰我的午觉，不对，是谁也别想打扰老师！","off":"谁也休想打扰我睡午……啊，不对，是休想妨碍老师！"},{"label":"EX技能2","jp":"私が先頭に立つよ、行こう！","fan":"让我打头阵，走吧！","off":"我来带头，走吧~"},{"label":"EX技能3","jp":"痛くない…痛くない......","fan":"我不疼…我不疼......","off":"不疼……不疼……！"},{"label":"战斗开始1","jp":"私の後に、ついてきて。","fan":"跟在我身后。","off":"跟在我后边~"},{"label":"战斗开始2","jp":"私が前に立つね。","fan":"我会挡在前面哦。","off":"我站在前面哦~"},{"label":"获得BUFF","jp":"私の出番だねぇ。","fan":"到我出场了呢。","off":"轮到我了吧~"},{"label":"施放BUFF","jp":"うわぁ……力を感じる……。","fan":"哇啊……感受到了力量……。","off":"我……我感受到了力量……"},{"label":"被CC1","jp":"-","fan":"（哭哭）","off":"噫……"},{"label":"被CC2","jp":"痛い","fan":"痛","off":"好疼……！"},{"label":"被CC3","jp":"痛","fan":"痛","off":"哎呀……！"},{"label":"回避","jp":"邪魔だなぁ……","fan":"真碍事啊……","off":"好烦呐……"},{"label":"队伍移动1","jp":"ここはもう安全。","fan":"这里已经安全了。","off":"这里安全啦~"},{"label":"队伍移动2","jp":"早く終わらせて寝たい…","fan":"好想快点结束去睡觉.","off":"好想早点结束，回去睡觉……"},{"label":"回复","jp":"あ～り～が～と～","fan":"听我说~谢~谢~你","off":"谢~谢~你~呀~"},{"label":"中途退出","jp":"眠い……","fan":"好困……","off":"好困……"},{"label":"战斗喊叫","jp":"-","fan":"呀","off":"呀！"},{"label":"战斗喊叫","jp":"","fan":"","off":"前进！"},{"label":"战斗喊叫","jp":"-","fan":"哈","off":"啊！"},{"label":"角色移动","jp":"ちょっと位置かわるね～","fan":"稍微换个位置哦~","off":"换个位置哦~"},{"label":"战斗胜利1","jp":"ふぅ…はぁ。役に立てて、よかった。","fan":"呼...呼啊。派上了用场就好。","off":"呃啊……能帮上忙就"},{"label":"战斗胜利2","jp":"ふぅ……はぁ。これで、安心して眠れるね。","fan":"呼...呼啊。这下子可以安心睡觉了。","off":"啊……这样就能安心睡觉啦~"},{"label":"关卡完成1","jp":"お疲れ様～先生。…もう、寝てもいい？","fan":"辛苦啦～老师。...可以睡觉了吗？","off":"老师辛苦啦~我现在可以睡了嘛~"},{"label":"关卡完成2","jp":"はぁ…終わった～、終わったよ～。おやすみなさ～い。","fan":"呼啊...结束啦~结束咯~。晚安啦","off":"啊啊……结束啦、结束啦~晚安~"},{"label":"战斗失败1","jp":"ご、ごめん。ちょっと居眠りしてた。","fan":"抱、抱歉。稍微打了个盹儿。","off":"对、对不起……我打了会瞌睡……"},{"label":"战斗失败2","jp":"眠ってたつもりだったけど……気絶、してたんだね。","fan":"本来打算睡觉的……但是没想到昏倒","off":"我以为我睡着了，原来是昏过去了……"}],"成长":[{"label":"升级1","jp":"ん？よく眠れたからか…なんだか成長した気分だなぁ。","fan":"嗯？睡了个好觉...总觉得成长了许多呢。","off":"嗯……？是不是因为睡了个好觉呢，怎么有种成长了的感觉呀？"},{"label":"升级2","jp":"やっぱり…先生といるときは元気が出る！","fan":"果然...只要有老师在就充满了精神！","off":"果然，和老师在一起的时候，就会有精神。"},{"label":"升级3","jp":"今なら…冬眠もできそう。","fan":"现在...好像可以冬眠了。","off":"现在……感觉可以冬眠了"},{"label":"升级4","jp":"夢を見るのもいいけど……これからは先生と、夢を叶えたい！","fan":"虽然做梦也很好……但今后想和老师一起，实现梦想！","off":"做梦虽然很好，不过以后……我想和老师一起实现梦想。"},{"label":"获得专武","jp":"この武器は……夢なのかな……ずっと願ってたことが、叶った。","fan":"这件武器......是梦吗……一直以来期盼的事情，成真了。","off":"这件武器……我是不是在做梦啊……我一直以来的愿望，实现了！"}],"事件":[{"label":"学生生日","jp":"今日が…私の誕生日…？\n記念にもっと寝ないと…それがいいね。","fan":"今天...是我的生日…？\n为了纪念就多睡一会儿...这样不错吧。","off":"今天，是我的生日吗……？那作为纪念，再睡一会……也挺好的。"},{"label":"老师生日","jp":"お誕生日おめでとう先生。\n私が膝枕してあげるからひと眠りする？","fan":"祝你生日快乐老师。\n给您膝枕，要不要小睡一会儿？","off":"老师，生日快乐~！要不要枕着我的腿，睡上一觉？"},{"label":"万圣节","jp":"今日は、眠るにはもったいない日だね。\n街に出ようよ、先生。\nきっと起きてても、夢を見てるような気分になれるから。","fan":"今天真是睡不着的日子啊。\n我们上街吧，老师。\n即使起床了，也会有做梦的感觉。","off":"今天睡觉可有点浪费了……出去逛街吧，老师~反正就算醒着，感觉也会像做梦一样美妙~"},{"label":"新年","jp":"明けましておめでとう。今年はもうちょっと頑張って起きてるね。","fan":"新年快乐。今年也要努力从床上爬起来呢。","off":"新年快乐~今年，我会更加努力地保持清醒哟。"},{"label":"圣诞节","jp":"クリスマスは好き…。\n百鬼夜行では少し珍しい祭りだけど\nたくさんの人が幸せそうな顔をする、聖なる夜だからね。","fan":"喜欢圣诞节...。\n虽然在百鬼夜行很少有节日庆祝，\n但是让这么多人露出幸福的笑颜，也就只有平安夜了呢。","off":"我喜欢圣诞节。虽然我们百鬼夜行很少会办这种庆典，但是它能让很多很多的人脸上洋溢着幸福，是个美好的夜晚。"},{"label":"春节","jp":"","fan":"老师~新春快乐~新的一年，老师要和我一起修行嘛？","off":"老师~新春快乐~新的一年，老师要和我一起修行嘛？"},{"label":"中秋","jp":"","fan":"月亮……明亮皎洁，真美啊！这样的晚上，用来睡觉就太浪费了……老师，我们一起……看看月亮吧！","off":"月亮……明亮皎洁，真美啊！这样的晚上，用来睡觉就太浪费了……老师，我们一起……看看月亮吧！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/705234.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/156033.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/3/9/64840.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/397275.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/341519.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/3/9/181878.ogg"],"大厅