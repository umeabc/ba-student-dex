},"sameName":[{"name":"★3 日富美（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_252/h_204/408107/2026/9/28/99090866mvs3kebh.png","url":"https://www.gamekee.com/ba/83596.html"},{"name":"★3 日富美","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_503/408107/2026/9/28/39935604mvs3mu16.png","url":"https://www.gamekee.com/ba/66256.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！","fan":"蔚蓝档案！","off":""},{"label":"卡池抽取","jp":"え？この衣装ですか？支給品のユニフォームですよ？えへへっ……よろしくお願いします！","fan":"诶？这套衣服吗？是配给的制服哦？诶嘿嘿……请多指教！","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"今日も頑張りましょう、先生！私も隣でお手伝いします！","fan":"今天也一起加油吧，老师！我也会在旁边帮忙的！","off":""},{"label":"登陆2","jp":"おかえりなさい、先生！準備はばっちりです！","fan":"欢迎回来，老师！准备得妥妥当当！","off":""},{"label":"大厅1","jp":"ドライブ日和ですね、先生！ん？天気は関係ありませんよ。いつでもドライブ日和です！","fan":"正是兜风的好日子呢，老师！嗯？跟天气没关系哦。不管什么时候都是兜风的好日子！","off":""},{"label":"大厅2","jp":"私、戦車の扉、閉めたっけ…？あうぅ！ちょっと確認してきます！","fan":"我把、坦克的门，给关上了吗……？啊呜！我去确认一下！","off":""},{"label":"大厅3","jp":"はい？その衣装、似合ってる？え、えへへ…もー、なんですか急に…。","fan":"诶？这套衣服，适合我吗？诶、诶嘿嘿……真是的，怎么突然这样……。","off":""},{"label":"大厅4","jp":"先生、疲れていませんか？膝枕…しましょうか？","fan":"老师，您累了吗？要我给您做……膝枕吗？","off":""},{"label":"大厅5","jp":"外出の予定はありますか？戦車で送っていきますよ！","fan":"您有出门的安排吗？我用坦克送您过去哦！","off":""},{"label":"回忆大厅1","jp":"はあ～戦車冷たくて気持ちいい……。やっぱり日陰は涼しいですね……。戦車を使った秘密基地、先生はいかがですか？","fan":"哈啊～坦克周围凉凉的，好舒服……。果然背阴的地方\n就是凉快呢……。用坦克搭一个秘密基地，老师觉得怎么样？","off":""},{"label":"回忆大厅2","jp":"……とても静かですよね。エンジンを切っていると、装甲が周りの音を吸収してくれるんです。呼吸や心臓の鼓動まで聞こえちゃうくらい静かで……。","fan":"……真的很安静呢。把引擎关掉之后，装甲就会把周围的声音都吸收掉。安静到连呼吸和心跳都能听得见呢……。","off":""},{"label":"回忆大厅3","jp":"私はこの空間が大好きです。まるで、世界に二人きりになったみたいで――あ、あはは！私みたいな普通の生徒と一緒にいても、面白くないかもしれませんが……。","fan":"我特别喜欢这个空间。就好像世界上只剩下我们两个人一样——啊、啊哈哈！跟我这样普通的学生待在一起，也许会很没意思吧……。","off":""},{"label":"回忆大厅4","jp":"えっ？あっ、やっ、えっと、その……！あはは……先生にはいつも、元気をもらってばかり、ですね。あ、あれ？なんだか暑くなってきましたね！ペ、ペンキ、早く乾くといいな……！","fan":"诶？啊、呀，那个，就是……！啊哈哈……我总是从老师那里得到满满的活力呢。\n啊、咦？总觉得越来越热了呢！\n油、油漆要是能快点干就好了……！","off":""},{"label":"回忆大厅5","jp":"（し、心臓の音が……先生に聞こえちゃったらどうしよう）\n（音楽を流すか、エンジンをかければよかった……！）\n（あうぅ……恥ずかしい……）","fan":"（心、心跳的声音……要是被老师听见了该怎么办啊）\n（早点放点音乐，或者把引擎打着就好了……！）\n（啊呜……好丢脸……）","off":""},{"label":"咖啡馆1","jp":"ふぅ…ここはとても過ごしやすいです。クルセイダーちゃんのクーラー、早く直さないと…。","fan":"呼……这里待着真舒服。十字军酱的空调，得赶快修好才行……。","off":""},{"label":"咖啡馆2","jp":"みなさん個性的で、ちょっと羨ましいです…。","fan":"大家各有各的个性，让人有点羡慕呢……。","off":""},{"label":"咖啡馆3","jp":"わあ、すごく可愛いです！","fan":"哇，好可爱啊！","off":""},{"label":"咖啡馆4","jp":"（だ、大胆な格好です…）","fan":"（好、好大胆的打扮……）","off":""},{"label":"咖啡馆5","jp":"（やっぱり、私は普通な方、ですね…）","fan":"（我果然还是比较普通吧……）","off":""}],"好感度":[{"label":"好感度1","jp":"先生？あの……この衣装――え？どんな格好をしていても、好き……？え、えへへ……。","fan":"老师？那个……这身衣服——诶？不管我穿成什么样，都喜欢……？诶、诶嘿嘿……。","off":""},{"label":"好感度2","jp":"あうぅ……先生には感謝してもしきれないです。\nいつも、ありがとうございます。","fan":"啊呜……我对老师的感谢怎么说都说不完。\n一直以来，真的谢谢您。","off":""},{"label":"好感度3","jp":"一緒に、戦車に乗りませんか？戦車の中は安全ですから。それに、私が先生をお守りできますし。","fan":"要不要一起坐坦克？坦克里面很安全。而且，我还能保护老师。","off":""},{"label":"好感度4","jp":"「ヒフミは特別な存在だよ」、って言ってくださったこと……私、忘れません。本当に嬉しいです、先生。ありがとうございます。","fan":"您说过「日富美对我来说是特别的存在」……那句话，我不会忘记的。真的很开心，老师。谢谢您。","off":""}],"战斗":[{"label":"编入队伍1","jp":"そろそろレースが始まるんですね！","fan":"比赛差不多要开始了呢！","off":""},{"label":"编入队伍2","jp":"目標は完走、です！","fan":"目标是，跑完全程！","off":""},{"label":"拎起","jp":"ひゃっ！？先生！？","fan":"呀！？老师！？","off":""},{"label":"任命队长1","jp":"コースの確認はしましたか？","fan":"赛道的确认做过了吗？","off":""},{"label":"任命队长2","jp":"私も頑張ります！","fan":"我也会努力的！","off":""},{"label":"普通技能","jp":"レーシングペロロ様！お願いします！","fan":"赛车佩洛洛大人！拜托您了！","off":""},{"label":"EX动画1","jp":"TOT射撃、開始します！","fan":"TOT射击，开始！","off":""},{"label":"EX动画2","jp":"効力射、お願いします！","fan":"效力射，拜托了！","off":""},{"label":"EX动画3","jp":"砲尾確保、発砲します！","fan":"炮尾确认完毕，开炮！","off":""},{"label":"EX技能1","jp":"至近弾に注意してください！","fan":"请注意近失弹！","off":""},{"label":"EX技能2","jp":"夾叉を確認！素敵です！","fan":"确认夹叉！太棒了！","off":""},{"label":"EX技能3","jp":"次弾装填、お願いします！","fan":"下一发装填，拜托了！","off":""},{"label":"战斗开始1","jp":"作戦スタートです！","fan":"作战开始！","off":""},{"label":"战斗开始2","jp":"一緒なら大丈夫です！","fan":"在一起就没问题的！","off":""},{"label":"获得BUFF","jp":"ありがとうございます！頑張ります！","fan":"谢谢您！我会加油的！","off":""},{"label":"施放BUFF","jp":"最善を尽くします","fan":"我会竭尽全力。","off":""},{"label":"被CC1","jp":"わっ！","fan":"哇啊！","off":""},{"label":"被CC2","jp":"痛っ！","fan":"好痛！","off":""},{"label":"被CC3","jp":"大丈夫です！","fan":"我没事！","off":""},{"label":"回避","jp":"避けました！","fan":"躲开了！","off":""},{"label":"队伍移动1","jp":"視野を確保します！","fan":"确保视野！","off":""},{"label":"队伍移动2","jp":"私が前を行きます！","fan":"我在前面开路！","off":""},{"label":"回复","jp":"ありがとうございます、助かりました！","fan":"谢谢您，帮大忙了！","off":""},{"label":"中途退出","jp":"まだ、大丈夫です！","fan":"我还能坚持，没事的！","off":""},{"label":"战斗喊叫","jp":"えい！","fan":"嘿！","off":""},{"label":"战斗喊叫","jp":"はっ！","fan":"哈！","off":""},{"label":"战斗喊叫","jp":"ていっ！","fan":"喝！","off":""},{"label":"角色移动","jp":"ふぁいっ、おー！","fan":"嘿咻，冲——！","off":""},{"label":"战斗胜利1","jp":"みなさん、お疲れ様でした！","fan":"大家辛苦了！","off":""},{"label":"战斗胜利2","jp":"また1つ、経験を積めました！","fan":"又积累了一份经验！","off":""},{"label":"关卡完成1","jp":"危険地帯を抜けました！","fan":"已经通过危险地带了！","off":""},{"label":"关卡完成2","jp":"無事に終わりました……みなさんのおかげです！","fan":"顺利结束了……多亏了大家！","off":""},{"label":"战斗失败1","jp":"撤退ですね。煙幕、展開！","fan":"要撤退了呢。烟幕，展开！","off":""},{"label":"战斗失败2","jp":"怪我をされた方はこちらへ！戦車で運びます！","fan":"受伤的人请到这边来！用坦克送大家过去！","off":""}],"成长":[{"label":"升级1","jp":"ありがとうございます！これで少しは……特別になれたでしょうか？","fan":"谢谢您！这样我是不是……稍微变得特别一点了呢？","off":""},{"label":"升级2","jp":"この格好でシャーレにいて、変……じゃないでしょうか？","fan":"我穿着这身待在夏莱，会不会……很奇怪呢？","off":""},{"label":"升级3","jp":"いいんですか！？なんの取り柄もない私に、こんなに……。","fan":"真的可以吗！？对我这样一无长处的人，这么……。","off":""},{"label":"升级4","jp":"私、もっと頑張りますね！……先生のご期待に、応えたいんです！","fan":"我，会更加努力的！……因为我想回应老师的期待！","off":""},{"label":"获得专武","jp":"ありがとうございます！この銃、取り回しがいいので戦車の中でも扱いやすいんです。","fan":"谢谢您！这把枪用起来很顺手，在坦克里也很好操作。","off":""}],"事件":[{"label":"学生生日","jp":"私の誕生日を祝ってくださって、ありがとうございます！\n欲しいもの、ですか？うーん…。\n特に思いつきません…欲しいものは、全部持っているので。友達も、先生も！","fan":"您愿意为我庆祝生日，真的非常感谢！\n有想要的东西，吗？嗯——……。\n我一时想不出来呢……因为想要的东西，我已经全都拥有了。包括朋友，还有老师！","off":""},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！「特別」な日を一緒に過ごせて…えへへ、嬉しいです！","fan":"生日快乐，老师！能陪您度过这个「特别」的日子……诶嘿嘿，我好开心！","off":""},{"label":"万圣节","jp":"ハロウィンは、こわ～いものが現れる日。\n今日、クルセイダーちゃんに給油した時のレシートが…本当に怖かったです…。","fan":"万圣节，是可怕～的东西会出现的日子。\n今天给十字军酱加油时的发票……真的好可怕……。","off":""},{"label":"新年","jp":"あけましておめでとうございます、先生！\nえ、寒くないかって？はい、大丈夫です。クルセイダーちゃんのヒーターはすごく温かいんですよ！","fan":"新年快乐，老师！\n诶，您问我冷不冷？嗯，没问题的。十字军酱的暖炉可暖和了呢！","off":""},{"label":"圣诞节","jp":"今日はクリスマス！サンタさんが忙しくなる日ですね！\nサンタさんのトナカイって何馬力なんでしょう？馬より速いのでしょうか…？","fan":"今天是圣诞节！是圣诞老人要忙起来的日子呢！\n圣诞老人的驯鹿到底有多少马力呢？会比马跑得还快吗……？","off":""}],"活动":[{"label":"活动登陆1","jp":"ついに本戦ですね！先生！","fan":"终于到正式比赛了呢！老师！","off":""},{"label":"活动登陆2","jp":"完走目指して頑張ります！","fan":"我会以跑完全程为目标努力的！","off":""},{"label":"活动大厅1","jp":"この衣装ですか？公式のユニフォームです！","fan":"这套衣服吗？这是官方制服哦！","off":""},{"label":"活动大厅2","jp":"あ、先生も分かりますか？\nこれ、とっても良い素材が使われてるんです！","fan":"啊，老师也看得出来吗？\n这个呀，用的可是非常好的料子呢！","off":""},{"label":"活动大厅3","jp":"個性豊かな戦車がこんなに……！\n先生、一緒に観に行きませんか？","fan":"这么多个性十足的坦克……！\n老师，要不要一起去看看？","off":""},{"label":"活动大厅4","jp":"先生も戦車、好きですか？\nえへへっ、一緒ですね！私も大好きです！","fan":"老师也喜欢坦克吗？\n诶嘿嘿，我们一样呢！我也超喜欢的！","off":""},{"label":"活动事件1","jp":"みなさん、結果を気にせず楽しめたらいいのですが……。","fan":"大家要是不在意结果，能开开心心地享受就好了呢……。","off":""},{"label":"活动事件2","jp":"みなさんが、笑顔であれますように！","fan":"愿大家，都能一直面带笑容！","off":""},{"label":"活动结束","jp":"この大会が、みなさんにとって――\n大切な青春の思い出になっていたら嬉しいです。","fan":"如果这场大会，对大家来说——\n能成为珍贵的青春回忆的话，我会很高兴的。","off":""},{"label":"活动商店1","jp":"ペロロ様のグッズですか？\n売り場までご案内します！","fan":"佩洛洛大人的周边吗？\n我带您去卖场吧！","off":""},{"label":"活动商店2","jp":"えっ？私が必要……？\n私でよければ、何でも言ってくださいね！","fan":"诶？需要我……？\n只要是我能行的，什么都可以跟我说哦！","off":""},{"label":"活动商店关闭","jp":"お買い忘れはありませんか？\n最後までお付き合いします！","fan":"有没有漏买的东西呢？\n我会陪您到最后的！","off":""},{"label":"活动商店登陆1","jp":"欲しいものがあれば\nおっしゃってくださいね！","fan":"有想要的东西\n就尽管跟我说哦！","off":""},{"label":"活动商店登陆2","jp":"何かお探しですか？\nお手伝いしますよ！","fan":"您在找什么吗？\n我来帮您吧！","off":""},{"label":"活动商店购买1","jp":"それ、すっごく良いですよね！分かります！","fan":"那个真的超棒的！我可是知道的！","off":""},{"label":"活动商店购买2","jp":"買えるときに貯めておくのも大事ですから。","fan":"能在买得起的时候先囤起来也很重要呢。","off":""},{"label":"活动商店购买3","jp":"お買い物って、楽しいですよね！","fan":"买东西真的很开心呢！","off":""},{"label":"活动商店购买4","jp":"他のものも見ていきませんか？","fan":"要不要也看看其他东西呢？","off":""},{"label":"minigame_combo_1","jp":"先生、連続記録更新ですよ！","fan":"老师，连击记录刷新了哦！","off":""},{"label":"minigame_combo_2","jp":"次の標的を狙います！","fan":"瞄准下一个目标！","off":""},{"label":"minigame_combo_3","jp":"これまで頑張ってきた成果ですね！","fan":"这就是我们一直以来努力的成果呢！","off":""},{"label":"minigame_complete","jp":"目標達成です！あっという間でしたね！","fan":"目标达成！真是一眨眼的工夫呢！","off":""},{"label":"minigame_geasget_1","jp":"部品みたいです。何かに使えるかもしれません。","fan":"好像是零件。说不定能派上什么用场呢。","off":""},{"label":"minigame_geasget_2","jp":"交換したかった部品だ！嬉しいです！","fan":"这正是我一直想换的零件！太高兴了！","off":""},{"label":"minigame_geasget_3","jp":"早速アップグレードしてみますね！","fan":"我这就去尝试升级改良看看！","off":""},{"label":"minigame_get_1","jp":"こんなにたくさん……！嬉しいです！やりましたね、先生！","fan":"这么多……！好开心！做到了呢，老师！","off":""},{"label":"minigame_get_2","jp":"えへへっ、先生のおかげです！","fan":"诶嘿嘿，都是托老师的福！","off":""},{"label":"minigame_login_1","jp":"先生、今日も一緒に頑張りましょう！","fan":"老师，今天也一起加油吧！","off":""},{"label":"minigame_login_2","jp":"結果を出すのも大事ですが、安全第一ですよ！","fan":"拿出成绩固然重要，但安全第一哦！","off":""},{"label":"minigame_select_1","jp":"私でいいんですか？嬉しいです、よろしくお願いします！","fan":"选我就可以了吗？好高兴，请多指教！","off":""},{"label":"minigame_select_2","jp":"私みたいな普通の生徒でいいんですか？","fan":"选我这种普通的学生真的可以吗？","off":""},{"label":"minigame_select_3","jp":"準備完了です！先生！","fan":"准备完毕了！老师！","off":""},{"label":"minigame_shout_1","jp":"排煙機、作動します！","fan":"排烟机，启动！","off":""},{"label":"minigame_shout_2","jp":"排気にご注意ください！","fan":"请注意尾气排放！","off":""},{"label":"minigame_shout_3","jp":"次弾装填、お願いします！","fan":"下一发炮弹装填，拜托了！","off":""},{"label":"minigame_start_1","jp":"エンジンは温まってますよ！発進！","fan":"引擎已经预热完毕了！出发！","off":""},{"label":"minigame_start_2","jp":"さあ、出発しますよ！","fan":"好啦，我们要出发啰！","off":""},{"label":"minigame_start_3","jp":"シートベルトはちゃんと締めましたか？","fan":"安全带都有好好系上吗？","off":""},{"label":"minigame_touch_1","jp":"あうっ。\n……ほっぺに何かついてましたか？","fan":"啊呜。\n……我脸上沾到什么了吗？","off":""},{"label":"minigame_touch_2","jp":"偉いね、って……あれ？　私に言ってますか？まだ何もしてませんよ！？","fan":"「真了不起」……咦？　是在对我说吗？我还什么都没做哦！？","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/28/94688433mvsavczj.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamek