/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/184875.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/871707.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 铃美（魔法）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_508/h_509/829/191981/2025/9/23/22514.png","url":"https://www.gamekee.com/ba/tj/680458.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"自警団任務の延長ですね。\nトリニティの安全のためなら、いくらでも協力します。","fan":"自警团任务延长了呢。\n如果是为了三一的安全的话，我随时可以协助。","off":"这算自警团任务的拓展吗……？如果是为了崔尼蒂的安全，那我会全力配合的。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ、先生。\nお忙しいとは思いますが、それでも、できるだけお会いしたいです。","fan":"欢迎，老师。\n虽然我想您一定很忙，但是即便如此，如果可以的话还是想见见您。","off":"您来啦，老师。我想您应该很忙，但还是希望，能尽量跟您多见几面。"},{"label":"登陆2","jp":"先生、お待ちしておりました。\n早く一緒にパトロールに行きましょう。","fan":"老师，我正在等着您。\n快点一起去巡逻吧。","off":"老师，我等您很久了。快一起出去巡逻吧。"},{"label":"大厅1","jp":"私ってそんなに冷たい印象ですか…？","fan":"在您的印象里，我就是这么的冰冷吗…？","off":"我看起来，有那么冷冰冰的吗？"},{"label":"大厅2","jp":"自警団の活動ですか？\nもちろん大変ですが…\n誰かがやらないといけない事ですから。","fan":"自警团的活动吗？\n当然很辛苦了...\n但是这也是必须有人要做的工作。","off":"自警团的活动……？……虽然确实很累，但总要有人去做的。"},{"label":"大厅3","jp":"休んでいる暇はありません。","fan":"没有休息的闲暇时间。","off":"现在还不能休息哦。"},{"label":"大厅4","jp":"正義というものは、一つの小さなことから正すのが大事なのです。","fan":"正义这个东西，从小开始纠正是很重要的。","off":"所谓正义，就是勿以恶小而为之、勿以善小而不为。"},{"label":"大厅5","jp":"何か…私、失礼なことでも？","fan":"什么...我，做了什么失礼的事情吗？","off":"我……有没有……失礼之处？"},{"label":"回忆大厅1","jp":"……綺麗ですね。\nここからなら、星が掴めてしまいそうです。","fan":"……真美啊。\n在这里好像伸手就能摘到星星一样。","off":""},{"label":"回忆大厅2","jp":"ここ最近はこうしてゆっくりと、落ち着いた時間も過ごすことができて……。\n……先生と出会った頃から、かもしれません。","fan":"最近好像变得可以像这样悠闲地，安稳地度过一天了……\n……大概是，遇见了老师的缘故。","off":""},{"label":"回忆大厅3","jp":"……先生。よろしければこれからも、一緒に居ていただけますでしょうか。","fan":"老师……如果可以的话，以后也可以这样陪着我吗。","off":""},{"label":"回忆大厅4","jp":"私はいつも、つまらないことばかり口にしてしまうかもしれませんが……","fan":"虽然我可能总是说一些无聊的话……","off":""},{"label":"回忆大厅5","jp":"それでもいつかは、私も……。\n……はい。いつか、きっと。","fan":"即便如此，我也想有一天……\n是的……未来的某天，一定会。","off":""},{"label":"咖啡馆1","jp":"休憩も任務の一部です。","fan":"休息也是任务的一部分。","off":"休息，也是任务的一部分。"},{"label":"咖啡馆2","jp":"ここのセキュリティは…素晴らしいですね。\n非の打ち所がありません。","fan":"这里的安保…真是太棒了。\n无可非议。","off":"这里的安保……真的很棒，无可挑剔。"},{"label":"咖啡馆3","jp":"（ここは平和ですね）","fan":"（这里很和平呢）","off":"这里很和平啊。"},{"label":"咖啡馆4","jp":"（あ…この飾り、可愛い…）","fan":"（啊...这个装饰，好可爱...）","off":"啊，这个装饰，真的好可爱。"},{"label":"咖啡馆5","jp":"（多分、こんな可愛い物は私には似合わない…）","fan":"（大概，这么可爱的东西不适合我...）","off":"这种……可爱的东西，和我很不搭吧。"}],"好感度":[{"label":"好感度1","jp":"いつも頼りになります。ありがとうございます、先生。","fan":"感谢您一直以来的照顾。谢谢，老师。","off":"您总是这么可靠。非常感谢您，老师。"},{"label":"好感度2","jp":"先生と一緒のパトロールはいつもより短く感じます。何ででしょうか？","fan":"和老师一起的巡逻总感觉时间过得比平常要快，这是为什么呢？","off":"和老师一起巡逻，会感觉时间比平时过的要快。这是为什么呢？"},{"label":"好感度3","jp":"こういうのは幸せというんでしょうか。\nパトロールを終えたときの高揚感とはまた違いますね。","fan":"这就是幸福吗。\n和巡逻结束时的高昂感又不一样。","off":"这就是所谓的幸福吗？和结束巡逻的时候那种爽快的感觉……并不一样。"},{"label":"好感度4","jp":"先生。これからもずっと…私と一緒にいてほしいです。","fan":"老师。希望你今后...也能一直和我在一起。","off":"老师，我希望您以后也可以……一直在我身边。"}],"战斗":[{"label":"编入队伍1","jp":"次のパトロール任務ですか？","fan":"下一个巡逻任务是？","off":"又该执行巡逻任务了吗？"},{"label":"编入队伍2","jp":"よろしくお願いします。","fan":"请多多关照。","off":"请您多多指教。"},{"label":"拎起","jp":"問題でもありましたか？","fan":"有什么问题吗？","off":"是有……什么问题吗？"},{"label":"任命队长1","jp":"この地域のパトロールを開始します。","fan":"开始这块片区的巡逻。","off":"开始在本地区进行巡逻。"},{"label":"任命队长2","jp":"はぁ、いつになったらこの活動も終わるのやら…","fan":"啊，什么时候这个活动也会结束呢…","off":"嗯……这种巡逻活动，什么时候能够结束呢？"},{"label":"普通技能","jp":"逃しません！","fan":"别想逃！","off":"别想逃！"},{"label":"EX动画1","jp":"腰を抜かさせてあげましょう！","fan":"让你目瞪口呆！","off":"给你一个小小的惊喜吧！"},{"label":"EX动画2","jp":"天罰の光を！","fan":"天罚之光啊！","off":"天罚之光！"},{"label":"EX动画3","jp":"これは痛いですよ！","fan":"这下会很痛的哦！","off":"这可是很痛的！"},{"label":"EX技能1","jp":"今です！","fan":"就是现在！","off":"就是现在！"},{"label":"EX技能2","jp":"閃光弾、投擲！！","fan":"闪光弹，投掷！","off":"闪光弹，投掷！"},{"label":"EX技能3","jp":"前方へ閃光弾を！","fan":"向前方投掷闪光弹！","off":"朝前方投闪光弹！"},{"label":"战斗开始1","jp":"これより作戦区域に入ります。","fan":"现在进入作战区域。","off":"现在进入作战区域。"},{"label":"战斗开始2","jp":"みなさん警戒しつつ注意を怠らないように。突撃！","fan":"大家注意禁戒，不要懈怠。突击！","off":"全员提高警惕，不要懈怠。出击！"},{"label":"获得BUFF","jp":"私の番ですね。","fan":"到了我出手了呢。","off":"轮到我了！"},{"label":"施放BUFF","jp":"行きます。","fan":"我上了。","off":"我要上了！"},{"label":"掩体","jp":"隠れます。","fan":"隐藏起来。","off":"有掩体！"},{"label":"被CC1","jp":"-","fan":"-","off":"呃！"},{"label":"被CC2","jp":"-","fan":"-","off":"怎么会……！"},{"label":"被CC3","jp":"-","fan":"-","off":"啊……！"},{"label":"回避","jp":"無駄です。","fan":"没用的。","off":"白费功夫！"},{"label":"队伍移动1","jp":"ここはもう安全です。","fan":"这里已经安全了。","off":"这里已经安全了。"},{"label":"队伍移动2","jp":"次の目標地点へ移動しましょう。","fan":"移动到下一个目标地点吧。","off":"移动到下一个目标地点吧。"},{"label":"回复","jp":"助かりました。感謝を。","fan":"帮了大忙了。谢谢你。","off":"帮大忙了，感谢。"},{"label":"中途退出","jp":"遅すぎたか……。","fan":"太迟了吗……。","off":"太晚了吗……"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"哈！"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"呀！"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"啪！"},{"label":"角色移动","jp":"移動します。","fan":"移动。","off":"前进！"},{"label":"战斗胜利1","jp":"パトロールを終了します。","fan":"结束巡逻。","off":"结束巡逻。"},{"label":"战斗胜利2","jp":"簡単な任務でした。","fan":"很简单的任务。","off":"简单的任务。"},{"label":"关卡完成1","jp":"本区域の整理を完了しました。","fan":"本区域的整理完成了。","off":"本地区的整顿已经完成。"},{"label":"关卡完成2","jp":"この地域はもう安全です。みなさん、お疲れ様でした。","fan":"这个地区已经安全了。大家辛苦了。","off":"这个地区已经安全了。各位，都辛苦了。"},{"label":"战斗失败1","jp":"うっ…、油断しました…","fan":"呜……我大意了…","off":"呃……我太大意了……"},{"label":"战斗失败2","jp":"退却を…要請します…","fan":"请求…撤退…","off":"请求……撤退……"}],"成长":[{"label":"升级1","jp":"これなら、パトロールの役に立てそうです。","fan":"这样一来，好像有助于巡逻。","off":"这样的话……对巡逻应该会有所帮助。"},{"label":"升级2","jp":"うむん……悪くないですね。","fan":"唔姆嗯……还不错啊。","off":"嗯，还不错。"},{"label":"升级3","jp":"いい感じです。","fan":"感觉很好。","off":"感觉很好。"},{"label":"升级4","jp":"これからもよろしくお願いします。","fan":"今后也请多多关照。","off":"今后也请您多多关照了。"},{"label":"获得专武","jp":"やはり手慣れた武器を使うのが一番ですね。","fan":"还是使用称手的武器最好啦。","off":"毕竟，还是称手的武器最好。"}],"事件":[{"label":"学生生日","jp":"生まれた日を記念することに大きな意味はないと\n言いますが、先生に祝っていただけるなんて…\nなんだかとっても得をした気分ですね。","fan":"虽然说纪念出生的日子没有什么大的意义，但是老师竟然祝贺我…\n总觉得很值得呢。","off":"虽然庆祝自己出生的日子这件事意义不是很大。但是能收到老师的祝福……总感觉，还挺赚的。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。\n今日は先生のお誕生日ですし、パトロールの代わりにのんびりお散歩でもいかがですか？","fan":"祝你生日快乐，老师。\n今天是老师的生日，可以用悠闲地散步来代替巡逻吗？","off":"祝您生日快乐，老师。既然今天是老师的生日，就不要巡逻了。我们轻轻松松地散个步，怎么样？"},{"label":"万圣节","jp":"変な人たちが街にたくさん…。\nハロウィンって、こういうお祭りなんですか？","fan":"街上好多奇怪的人…。\n万圣节就是这样的节日吗？","off":"街上到处都是奇怪的人……万圣节，原来就是这样的节日啊。"},{"label":"新年","jp":"先生の、新年の目標はなんですか?\n私は…いつも通り、頑張ってパトロールをすることです。","fan":"老师，您的新年的目标是什么？\n我…和往常一样，要努力巡逻。","off":"老师，您的新年目标是什么？我的目标……和以前一样，就是努力巡逻。"},{"label":"圣诞节","jp":"連休を目前にして、皆さんの気が緩む時期ですね。\nこういう時こそ、もっと厳しくパトロールしましょう!","fan":"连休在即，正是大家松懈的时期。\n正是这种时候，我们才要更严格地巡逻吧！","off":"长假马上就要来了。这段时间大家都有些松懈。越是这种时候，就越要加强巡逻。"},{"label":"春节","jp":"","fan":"到处都好热闹啊……不过，越是这种时候，就越不能放松警惕。老师，我们一起去巡逻吧。","off":"到处都好热闹啊……不过，越是这种时候，就越不能放松警惕。老师，我们一起去巡逻吧。"},{"label":"中秋","jp":"","fan":"今天街上没什么人呢……我也可以暂时休息一下，不急着去巡逻了。老师……您要，一起看看月亮吗？","off":"今天街上没什么人呢……我也可以暂时休息一下，不急着去巡逻了。老师……您要，一起看看月亮吗？"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/768721.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/228582.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/219310.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/260961.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/528984.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/308785.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/786192.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/920189.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/750066.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/285060.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/721984.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/343