iki2.0/images/w_304/h_240/829/43637/2025/5/10/464672.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/658906.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/36959.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/598050.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/417149.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/107526.png","name":"皋月的秘密食谱巧克力","desc":"内含硬币状手工巧克力的高级礼盒。据说皋月为了提升与老师的亲密度，使用了秘密食谱制作。"},"ability":{"attrs":[{"name":"生命值","value":"673"},{"name":"攻击力","value":"143"},{"name":"治愈力","value":"228"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/473978.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/585439.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"皋月(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/6/30/26543303ms6vxw75.png","url":"https://www.gamekee.com/ba/tj/714037.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー、アーカイブ～","fan":"碧蓝档案～","off":"Blue Archive~"},{"label":"卡池抽取","jp":"待たせたわね、先生。\n万魔殿の情報部長、京極サツキよ。\nふふっ、よろしく。","fan":"久等了呢，老师。\n万魔殿的情报部长，京极皋月。\n呵呵，请多关照。","off":"不好意思呀，等很久了吧老师。我是万魔殿的情报部长，京极皋月。诶嘿，请多关照哟~？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生。\n今日の当番は私よ。ふふっ。\n先生は万魔殿の協力者候補。\nこの機にじ～っくり、観察させてもらおうかしら。ふふ。","fan":"你好，老师。\n今天轮到我值日哦。呵呵。\n老师可是万魔殿的候补助力者。\n我会好好~利用这个机会观察老师的。呵呵。","off":"你好呀，老师。我是今天的值日员哦，诶嘿~老师可是万魔殿合作候选人，得趁现在好好观察一下，诶嘿嘿~"},{"label":"登陆2","jp":"あら？私を誰だと思っているの？\nシャーレの仕事くらい、一瞬で終わらせてあげる。","fan":"啊啦？可别小看我了哦？\n夏莱的工作而已，我一眨眼就能帮您处理完。","off":"嗯，你以为我是谁？区区沙勒的工作强度，分分钟的事情啦~"},{"label":"大厅1","jp":"京極サツキ、万魔殿の情報部長を務めているわ。\nまあ、知ってると思うけど。ふふっ。","fan":"京极皋月，是万魔殿的情报部长。\n不过，我想您应该对我有所了解。呵呵。","off":"我是京极皋月，万魔殿的情报部长。我想你已经听说啦，嘿嘿~"},{"label":"大厅2","jp":"デスクの角に足をぶつけないよう、気をつけなさい。\n……だってそれ、痛いじゃない。","fan":"请小心别让桌子角磕到腿了哦。\n......因为磕到会很痛的哦。","off":"小心脚趾别磕到书桌脚上，我最讨厌疼了。"},{"label":"大厅3","jp":"シャーレの機密情報ってどこにあるのかしらね……\n……意外と給湯室にあったりして？\nふふっ。お菓子のラインナップから調べてみようかしら。","fan":"夏莱的机密情报在哪里能找到呢……\n……竟然在茶水间？\n呵呵。那就从零食的供应情况开始调查一下吧。","off":"沙勒的机密情报，会在哪里呢……？说不定在茶水间？嘿嘿……从零食开始调查吧？"},{"label":"大厅4","jp":"先生、NKウルトラ計画に興味はあるかしら？\n今なら破格の条件で迎え入れてあげる。","fan":"老师，您对NK超级计划感兴趣吗？\n现在可以破格邀请您加入哦。","off":"老师，对我们NKUltra计划有没有兴趣？现在有机会破格让你加入哦？"},{"label":"大厅5","jp":"この振り子をよくみて……\nさあ……\n先生は退勤したくなぁ～る……\n仕事をサボりたくなぁ～る……\n……常にそう？ふぅん。","fan":"仔细看这个钟摆……\n来吧……\n老师想下班了吧……\n想偷懒了吧……\n……时不时这样想？嗯？","off":"好好看着这枚硬币……好，老师想下班了~想偷懒了~不催眠也是这样？嗯……也有道理。"},{"label":"回忆大厅0","jp":"うう……なによ、これ……？\nへ、変だわ……\n先生の命令に、従わないといけない気持ちに……","fan":"唔……这是、什么……？\n好、好奇怪啊……\n感觉不得不、遵从老师的命令……","off":"嗯……这是，怎么回事？好，好奇怪……感觉，必须要服从老师的命令……"},{"label":"回忆大厅1","jp":"え、えっ……はい……\n……私は、風紀委員会と……仲良く、します。\n……でもマコトちゃんならまだしも、私は別に仲が悪いわけじゃないのよ。","fan":"诶、诶……好的……\n……我要、跟风纪委员会……好好、相处。\n……但是真琴酱暂且不提，我其实并没有跟她们关系很差哦。","off":"呜，呜……？好的……我要和，风纪委员会……好好相……呜……本来我们关系就没有很差……小真琴，另当别论……"},{"label":"回忆大厅2","jp":"う、うん？\nくっ……私は……先生に……意地悪……しませ、ん……","fan":"嗯、嗯？\n咕……我……不会再……欺负……老师、了……","off":"呜，呜？……我，不会再，捉弄，老师了……呜……"},{"label":"回忆大厅3","jp":"ひ、卑怯よ！\n大人のくせに、催眠で私に好き勝手して！","fan":"太、太卑鄙了!\n明明是大人、却用催眠来随意摆弄我！","off":"太，太卑鄙了……！身为大人，竟然趁我不备操控人家做这种事……！"},{"label":"回忆大厅4","jp":"ふん、この私に催眠をかけるだなんて……\n油断ならないわね、先生。\nどう？私のNKウルトラ計画に参加する気はない？","fan":"哼，竟然对我用催眠什么的……\n真是让人不能放松警惕呢、老师。\n如何？我的NK超级计划有兴趣参与吗？","off":"哼……竟然对我用了催眠术，面对老师，还是不能大意啊……怎么样？加入我的NKUltra计划吧？"},{"label":"回忆大厅5","jp":"は、はい……ご命令なら……","fan":"好、好的……如果这是命令的话…….","off":"好，好的……既然的老师的命令……"},{"label":"咖啡馆1","jp":"シャーレの情報収集といきましょう。","fan":"让我来收集点夏莱的情报吧。","off":"来收集一下沙勒的情报吧？"},{"label":"咖啡馆2","jp":"ふ～ん？いい感じじゃない。","fan":"哼~？感觉不错嘛。","off":"嗯……？这感觉，不赖嘛。"},{"label":"咖啡馆3","jp":"ここにあの子たちを潜入させて……","fan":"如果让那些孩子们潜入这里的话......","off":"把那些孩子安插到这里……"},{"label":"咖啡馆4","jp":"うち以外の尋問技術、気になるわね……","fan":"咱家以外的审问技术，很在意呢......","off":"我有点好奇，其他学院的拷问套路呢。"},{"label":"咖啡馆5","jp":"催眠術の練習台……\n誰かなってくれないかしら？","fan":"催眠术练习台……\n谁来做我的练习搭子呢？","off":"催眠术……有谁愿意接受实验呢？"}],"好感度":[{"label":"好感度1","jp":"これも信頼を築いていく過程、でしょう？","fan":"这也是构筑信任的过程，对吧？","off":"这是……互相建立信任的过程吧？"},{"label":"好感度2","jp":"私のこと、信じてるわよね？先、生~？","fan":"您信任着我吗，老、师~？","off":"你是相信我的吧，老师？"},{"label":"好感度3","jp":"先生との距離が縮まった気がするわ。\nそれも……かなり。ふふっ。","fan":"感觉和老师的距离更近了呢。\n这样也……不错。呵呵。","off":"诶嘿嘿，和老师的关系越来越近了……这算是，亲密的关系？"},{"label":"好感度4","jp":"先生にはこの先もずうっと、私のそばにいてもらおうかしら。\n……拒否権？あると思うの？ふふっ。","fan":"老师今后也请一直在我身边吧。\n……否决权？您认为有吗？呵呵。","off":"老师今后也一直待在我身边哦？……不想？你以为这是你想不想的问题吗？嘿嘿~"}],"战斗":[{"label":"编入队伍1","jp":"例のアレをお披露目する時がきたのね。","fan":"是时候展示那个东西了呢。","off":"轮到我的催眠术大显身手了？"},{"label":"编入队伍2","jp":"あら、私の催眠術が必要なの？","fan":"哎呀，需要我的催眠术吗？","off":"果然还是少不了我吧？"},{"label":"拎起","jp":"そんなに引っ張らなくてもいいのに〜","fan":"不要拉得这么用力啦~","off":"不用抓那么紧啦~"},{"label":"普通技能","jp":"弱点は……ここね。","fan":"弱点……是这里呢。","off":"弱点……在这里呢~？"},{"label":"EX动画1","jp":"あなたは段々つよくなぁ～る、つよくなぁ～る……","fan":"你会不断变强的~、变强的~","off":"你会越来越强……越来越强……"},{"label":"EX动画2","jp":"さあ、私のために頑張って頂戴。","fan":"来，请为了我努力吧。","off":"来，为我加油吧~"},{"label":"EX动画3","jp":"どう？強くなってきたの、分かるかしら？","fan":"如何？感受到自己变强了吗？","off":"怎么样，有没有感觉变强了~？"},{"label":"EX技能1","jp":"ほら、効いてきたでしょう？","fan":"看，起效果了吧？","off":"怎么样？起效了吧~？"},{"label":"EX技能2","jp":"万魔殿、総攻撃よ！","fan":"万魔殿、总攻来了哦！","off":"万魔殿，全体总攻~！"},{"label":"EX技能3","jp":"ふふ、これが私の力。","fan":"呵呵，这就是我的力量。","off":"诶嘿，这就是我的实力。"}],"成长":[{"label":"升级1","jp":"ふふ……いい感じね。順調じゃない？","fan":"呵呵……感觉不错呢。很顺利嘛？","off":"诶嘿，感觉不错，很顺利嘛~"},{"label":"升级2","jp":"すこし、強くなった気がするわ。","fan":"感觉到一股很强大的力量呢。","off":"感觉变强了点呢……"},{"label":"升级3","jp":"ふふっ、この調子で頼むわよ、先生？","fan":"呵呵，现在这么好的状态都多亏了老师哦？","off":"诶嘿，以后请按这样的标准保持哦，老师~"},{"label":"升级4","jp":"ふぅ……これで目標は達成できたも同然。\n感謝するわ、先生。","fan":"呼……这下能够完成目标了。\n非常感谢，老师。","off":"呼……总算达成目标了。多谢了，老师~"},{"label":"获得专武","jp":"あら、用意がいいじゃない。\nふふ、助かるわ先生。","fan":"啊拉，感谢您的好意。\n呵呵，帮大忙了老师。","off":"诶？准备的还挺周到嘛。嘿嘿，帮大忙了，老师~"}],"事件":[{"label":"学生生日","jp":"ふ～ん、私の誕生日、覚えていたの。\nさすがはシャーレの情報収集能力。\n私たちのライバルなだけあるわね。\nそれはそうと……お祝いの言葉、感謝するわ。","fan":"哼~我的生日，您还记得嘛。\n不愧是夏莱的情报收集能力。\n看来我们是竞争对手了哦。\n不过话说回来......谢谢、您的生日祝福。","off":"嗯~？连我的生日都记得啊。不愧是沙勒的情报啊，够格做我们的竞争对手。总之谢了老师，这份心意……我收下了。"},{"label":"老师生日","jp":"今日は先生の誕生日でしょう？\nええ、もちろん覚えてるわ。\n万魔殿の協力者候補として、先生の存在は貴重だもの。\n……まぁ、そうでなくても覚えていたと思うけど。\nふふ、お誕生日おめでとう、先生。","fan":"今天是老师的生日吧？\n我有好好记在心上哦。\n因为作为万魔殿的候补助力者，老师的存在可是很重要的。\n......不过嘛，就算不是如此我也会好好记住的。\n呵呵，生日快乐，老师。","off":"今天是老师的生日吧~？我知道。作为万魔殿的预备合作伙伴，老师的资料，我们必须了如指掌~嗯……不过就算和万魔殿没关系，我也绝对不会忘记哦？诶嘿，生日快乐，老师~"},{"label":"万圣节","jp":"ハロウィーンはイブキが楽しみにしている日なの。\nお菓子の用意はいいかしら？\nふふっ、私も楽しみにしてるのよ。","fan":"万圣节是伊吹很期待的日子呢。\n您准备了糖果了吗？\n呵呵，那我也很期待哦。","off":"万圣节呀~是小伊吹很期待的日子。糖果准备好了吗？诶嘿，我也很期待哦~"},{"label":"新年","jp":"明けましておめでとう、先生。\n今年こそ、先生に協力してもらった上で、NKウルトラ計画に進展があるといいわね。","fan":"新年快乐，老师。\n今年如果有老师的帮助的话，NK超级计划的进展一定能够更加顺利。","off":"新年快乐，老师~希望今年能得到老师协助，NKUltra计划也能顺利推进！"},{"label":"圣诞节","jp":"先生、好き？\n……クリスマスムードのことよ。\n……勘違いしたって、何を？","fan":"老师、喜欢吗？\n……圣诞氛围。\n……有点不对吗，是指什么？","off":"老师，喜欢吗？……我是说，圣诞节的气氛怎么样？没反应过来……？什么意思……？"},{"label":"春节","jp":"","fan":"老师，看！这是从山海经学院那搞来的烟花棒！携带起来很轻便，重点是很亮！这个春节，不用怕停电啦~","off":"老师，看！这是从山海经学院那搞来的烟花棒！携带起来很轻便，重点是很亮！这个春节，不用怕停电啦~"},{"label":"中秋","jp":"","fan":"很多人望着月亮，会情不自禁地开始想念……难道，月亮其实是一个巨大的催眠装置？！","off":"很多人望着月亮，会情不自禁地开始想念……难道，月亮其实是一个巨大的催眠装置？！"}],"活动":[{"label":"活动登陆1","jp":"いらっしゃい、先生。好きなだけ見ていって頂戴。","fan":"欢迎，老师。喜欢的随便看看。","off":"快请进，老师，请尽情参观~想看什么都可以！"},{"label":"活动登陆2","jp":"私たち万魔殿が手掛けたパーティーだもの。\n先生も気に入るに決まってるわ。","fan":"这是我们万魔殿亲自举办的派对。\n老师肯定也会喜欢的。","off":"这可是我们万魔殿精心准备的活动，老师也一定会喜欢的！"},{"label":"活动大厅1","jp":"ふ～ん、そんなにちょっかいを出して…\n何をされたいの？","fan":"哼~那么多管闲事……\n你想做什么？","off":"嗯……总是戳来戳去的，想做什么呢~？"},{"label":"活动大厅2","jp":"先生は、なにをご所望かしら？","fan":"老师、希望什么呢？","off":"老师~想要什么呢？"},{"label":"活动大厅3","jp":"ふふっ、先生…私に催眠をかけてみなさい。\nもちろん私には効かな…\nうん？遠慮しておく？\nふふっ、そんなこと言わずに…ほらほら。","fan":"呵呵，老师...请试试对我进行催眠吧。\n对我当然是没用的啦...\n嗯？想多了？\n呵呵，别说那种话啦...哎呀哎呀。","off":"诶嘿，老师……来对我试试催眠术吧，有没有效果就另说了。嗯……？你说你可以？诶嘿嘿，别光说不练嘛~来吧来吧~"},{"label":"活动大厅4","jp":"そんな風にぼんやりしていたら、\nマコトちゃんに絡まれてしまうわよ？\nほら、こっちに来なさい。","fan":"这么发呆下去的话，会被真琴找麻烦的吧？\n来这边。","off":"老师，一直那样傻站着的话，小心被卷进小真琴的阴谋计划里哦？来，往这边走。"},{"label":"活动事件1","jp":"あら、進捗が芳しくないようね。\nまあ、マコトちゃんがなんとかするんじゃない？","fan":"哎呀，进展好像不太顺利呢。\n不过，真琴会想办法的吧？","off":"嗯？好像进展不太顺利呢……嗯，小真琴总会有办法的。"},{"label":"活动事件2","jp":"ここで先生の手を借りることになるなんてね。\nふふっ、頼んだわよ、先生？","fan":"好像不得不要请老师伸出援手了呢。\n呵呵，拜托你了，老师？","off":"没想到会在这里让老师帮忙。诶嘿，那就交给你了，老师~"},{"label":"活动结束","jp":"パーティーはこれで終わり。\nね？私の言ったとおり、なんとかなったでしょう？","fan":"晚会到此就结束了。\n是吧？正如我所说，总算有办法了吧？","off":"派对到此就结束了~看吧，我说什么来着，事情总能解决的~"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/266282.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/18/140722.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/3/149342.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/377825.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/18/463440.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/3/159617.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/513345.mp3","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/18/351955.mp3","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/3/621971.mp3"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/501134.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/18/69138.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/3/191335.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/906473.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/18/799798.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/4/3/177984.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025