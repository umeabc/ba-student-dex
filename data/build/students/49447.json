230.html"},{"name":"NPC 桃井（冬装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/436639.png","url":"https://www.gamekee.com/ba/647098.html"},{"name":"NPC 桃井（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_303/h_301/829/191981/2026/0/18/473378.png","url":"https://www.gamekee.com/ba/690647.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive"},{"label":"卡池抽取","jp":"これから、すっごく面白い物語が始まるよ！","fan":"非常有趣的故事就此开始了喔！","off":"超~级有趣的故事即将开始咯~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生！早く任務を始めよう！","fan":"欢迎回来，老师！快点去做任务吧！","off":"老师你来啦~快点开始做任务吧！"},{"label":"登陆2","jp":"準備完了！行こう、先生！次のクエストをクリアしに！","fan":"准备好啦！我们走吧，老师！赶紧把下一关给通了！","off":"准 备 完 毕 ~\n老师快走，去完成下一个任务吧！"},{"label":"大厅1","jp":"ゲームを楽しめる人とゲームが上手い人は別なことも多いよ。\n先生はどっち？","fan":"享受玩游戏的人和玩游戏很厉害的人的区别还挺大的。\n老师又是哪一类呢？","off":"喜欢游戏和擅长游戏的人还挺不一样的\n老师属于哪一种呢？"},{"label":"大厅2","jp":"あっ！今日新作のゲームの発売日だった！","fan":"啊！今天是新游戏的发售日！","off":"啊，今天有新的游戏要发售来着！"},{"label":"大厅3","jp":"元々今日はレイドに行こうと思ってたのに！\n当番になっちゃうなんて……！\n·……まぁ、こっちも好きだからいいけど。","fan":"本来今天是打算去打团体战的！却在这儿值日……！\n……不过，这也是我心甘情愿就是了。","off":"本来今天想去打团队副本的，怎么偏偏轮到我值日啊……\n唉，算啦~值日……我也挺喜欢的"},{"label":"大厅4","jp":"先生！任務とかは後でいいからとりあえずゲームしに行こう！","fan":"老师！任务什么的待会再说，总之先来打游戏吧！","off":"老师！任务什么的以后再做，先去玩游戏吧！"},{"label":"大厅5","jp":"先生はいいな……。欲しいゲームがあったらいつでも買えるんでしょ？","fan":"老师就好啦……要是有想玩的游戏的话随时都能买，不对么？","off":"真羡慕老师啊……老师想买什么游戏都可以随便买吧？"},{"label":"回忆大厅1","jp":"見て、先生！こっち側のスタンプ、全部集められたよ！これでクエストクリア、だね！やった！","fan":"快看老师！我这边的印章全都集齐了喔，这下算是通关了吧，好耶！","off":"老师你快看！这里面的图章我已经全部盖满了！\n这样的话，任务就通关啦！对吧？耶——"},{"label":"回忆大厅2","jp":"最初どうなるかと思ったけど……。やっぱり先生と私、相性バッチリだね！","fan":"虽然一开始有些担心……。果然老师和我配合得很好呢！","off":"一开始还以为绝对不可能完成……\n果然老师和我两个，就是完美的搭档啊"},{"label":"回忆大厅3","jp":"って、うわぁっ！？先生？汗まみれじゃん！大丈夫？","fan":"哎呀，老师！？满头大汗的！没事吧？","off":"啊……啊？老师？？\n你怎么满头大汗啊，没事吧？"},{"label":"回忆大厅4","jp":"あはっ、大丈夫なら良かった。今日も先生のおかげで、すっごく楽しかったよ！","fan":"啊哈，没事就好。今天多亏老师了，我超开心的！","off":"啊哈哈，没什么事情那就好，今天真的多亏了老师，玩的超级开心"},{"label":"回忆大厅5","jp":"もしまたこういうイベントがあったら、その時もまた、一緒に参加しようね、先生！","fan":"要是下次还有这样的活动的话，那时我们再一起去参加吧！老师！","off":"如果下次还有这样子的活动\n那么到时候，我们再两人一起参加吧，老师！"},{"label":"咖啡馆1","jp":"あっ！唐突に良いシナリオのアイデアが浮かんだ！","fan":"啊！灵光乍现，想到个不错的剧本！","off":"啊，突然想到了一个不错的剧情！"},{"label":"咖啡馆2","jp":"やった！クリア！！","fan":"好耶！通关了！！","off":"好耶~通关~"},{"label":"咖啡馆3","jp":"ゲーム～ゲ～ム～ゲームがやりたい～","fan":"游戏～游戏～打游戏呀～想打游戏～","off":"游戏~游戏~我想玩游戏~"},{"label":"咖啡馆4","jp":"あれ？これちっちゃい時にやったあのシリーズじゃん！？","fan":"啊咧？这不是小时候玩过的那个系列吗！？","off":"诶？这不是我小时候玩过的那个系列吗？"},{"label":"咖啡馆5","jp":"うーん、これじゃ部員たちのおやつ代が足りない。アルバイトでもしようかな。","fan":"唔，这样下去部员们的零食钱不够了。要不打打工吧。","off":"嗯……开发部的零食钱快要不够了，要不去打个工吧？"}],"好感度":[{"label":"好感度1","jp":"私の好感度を上げたいなら、新作のゲームをも～っと買って！","fan":"要是想提高我的好感度，就给我买更～多的游戏吧！","off":"想提高我的好感度……那就多买点新游戏吧！"},{"label":"好感度2","jp":"な…なんて伏線……！このまま行ったらどうなっちゃうんだろう。","fan":"这……这是什么暗线……！这样发展下去会变成什么样呢。","off":"竟然还有这种伏笔？这样下去到底会变成什么样啊？"},{"label":"好感度3","jp":"あれ？もしかして今フラグ……。ち、違う！立ってない！","fan":"啊？难道说刚刚立了个flag……。才，才不是！才没有立呢！","off":"啊？刚才的难道是flag？啊，不行，不许立！"},{"label":"好感度4","jp":"最高のゲームを作るためには、やっぱり色んな経験が必要なの。…恋愛経験も、ね？","fan":"为了做出最棒的游戏，果然还是需要各种各样的经验。……恋爱经验也是，对吧？","off":"看来要做出最好的游戏，必须要积累各种各样的经验，\n应该……也包括……恋爱……经验吧？"}],"战斗":[{"label":"编入队伍1","jp":"任せてよー！","fan":"交给我吧！","off":"交给我吧！"},{"label":"编入队伍2","jp":"さぁ、私の番か！","fan":"好，轮到我咯！","off":"好，轮到我啦~"},{"label":"拎起","jp":"ひゃぁ！？ちょっ、これじゃぁゲームできないじゃん！","fan":"呀啊！等一下，这样就打不了游戏啦！","off":"啊，哎呀，这样我没法玩游戏啦！"},{"label":"任命队长1","jp":"早く終わらせてかーえろ！","fan":"快快搞完就回去吧！","off":"快点搞定回去吧~"},{"label":"任命队长2","jp":"私のエイムを見せてあげる！","fan":"就让你瞧瞧我的枪法！","off":"让你看看我的枪法！"},{"label":"普通技能","jp":"私……もう怒ったんだから！","fan":"我……已经生气啦！","off":"我生气啦！"},{"label":"EX动画1","jp":"よしこのまま……えっ！？ううーっ許せなーい！","fan":"好就这样一口气……诶！？呜呜不可饶恕！","off":"好……就这样！\n啊……饶不了你！"},{"label":"EX动画2","jp":"へぇー面白っ……えっ！？死んだ！？信じられなーい！","fan":"哎呀针不戳……诶！？死了！？我不信我不信！","off":"诶……真有意……\n啊？似了？太离谱了吧！"},{"label":"EX动画3","jp":"私の勝ち……えっ！？負けたじゃん！？もー！","fan":"是我赢辣……诶！？输了！？我服了！","off":"我赢……啊？怎么输了？\n气死我啦！"},{"label":"EX技能1","jp":"アイス奢らなきゃいけなくなったじゃん！あなたたちのせいだよー！","fan":"这下不得不请吃冰激凌了啦！都是你们害的啦！","off":"这下我得请冰激凌了呀……都怪你们！"},{"label":"EX技能2","jp":"悔しいっ……悔しいーーっ！","fan":"不甘心……不甘心！","off":"不甘心……我不甘心！"},{"label":"EX技能3","jp":"私の怒りの弾丸を食らえ！","fan":"食我愤怒的子弹吧！","off":"吃我这愤怒的子弹吧！"},{"label":"战斗开始1","jp":"うーん……パッドでの操作だったら自信あるんだけど……","fan":"唔……要是在平板上操作的话我倒是自信满满啦……","off":"嗯……要是能用手柄打的话我就有自信了"},{"label":"战斗开始2","jp":"勝利へのシナリオが見えた！","fan":"我已经看到胜利的剧本！","off":"我已经看到胜利的剧本啦！"},{"label":"获得BUFF","jp":"ありがとう！","fan":"谢谢！","off":""},{"label":"施放BUFF","jp":"いやーー！","fan":"呀——！","off":""},{"label":"掩体","jp":"隠れるところ見つけ！","fan":"找到掩体了！","off":""},{"label":"被CC1","jp":"いたいー！","fan":"好痛！","off":"疼死了"},{"label":"被CC2","jp":"助けてー！","fan":"队友呢？救一下啊！","off":"救人呐！"},{"label":"被CC3","jp":"許せない……！","fan":"不可饶恕！","off":"饶不了你！"},{"label":"回避","jp":"無駄だよ～","fan":"没用的哟~","off":""},{"label":"队伍移动1","jp":"ここはクリア。","fan":"这里通关了。","off":""},{"label":"队伍移动2","jp":"次のステージへ、前進！","fan":"前往——下一个关卡！","off":""},{"label":"回复","jp":"体力ゲージはいつも、注意深く確認しておかなきゃね！","fan":"要一直注意血条的变化喔！","off":"要随时关注体力槽哦！"},{"label":"中途退出","jp":"攻略本……読んでおけばよかった……","fan":"要是能看攻略……就好了……","off":"要是以前看过攻略就好了……"},{"label":"战斗喊叫","jp":"えぃー！","fan":"嘿——！","off":"嘿！"},{"label":"战斗喊叫","jp":"喰らえ！","fan":"吃我这招！","off":"看招！"},{"label":"战斗喊叫","jp":"行くよ！","fan":"要上了！","off":"瞄准啦！"},{"label":"特殊载具","jp":"レトロこそ、真の最先端だよ！","fan":"复古游戏才是真正的潮流前线啊！","off":""},{"label":"特殊载具","jp":"今からこのゲームはロボットものになるよ！","fan":"从现在开始，这个游戏要变成机器人游戏了！","off":""},{"label":"角色移动","jp":"こっちに行こう！","fan":"前往那边！","off":""},{"label":"战斗胜利1","jp":"クリア！次のステージへ！","fan":"通关！下一层！","off":"通啦~前往下一关！"},{"label":"战斗胜利2","jp":"私たちの勝利！","fan":"是我们胜利了！","off":"我们胜利啦！"},{"label":"关卡完成1","jp":"これぐらいなら難易度はez（イージー）って感じだね。","fan":"就这点程度这真是太easy啦。","off":"感觉这个难度应该是easy吧~"},{"label":"关卡完成2","jp":"クリア！","fan":"通关！","off":"通关！"},{"label":"战斗失败1","jp":"先生、諦めないで。リトライしよう！","fan":"老师，不要放弃。我们重新挑战一次吧！","off":"老师，不要放弃，重开一把！"},{"label":"战斗失败2","jp":"あー、もうー、クソゲーじゃん！","fan":"啊，真是的！根本就是垃圾游戏啊！","off":"啊——什么烂游戏啊！"}],"成长":[{"label":"升级1","jp":"経験値をもっともらえるようにして！","fan":"经验值摩多摩多！","off":"再多给我点经验值！"},{"label":"升级2","jp":"レベルアップっていつもときめく瞬間だよね！","fan":"升级什么的总是让人振奋不已呢！","off":"每次升级，都是一个让人心跳的瞬间呢！"},{"label":"升级3","jp":"もっと強くなりたい！そうすれば、皆を守れるお姉ちゃんになれるから！","fan":"我想变得更强！这样的话就能成为守护大家的姐姐了！","off":"我想变得更强，那样，就能成为一个保护大家的好姐姐啦！"},{"label":"升级4","jp":"これからの私の火力、ハンパじゃないよ！","fan":"从现在开始，我的火力可不是什么半吊子喔！","off":"以后我的火力可就不是闹着玩的啦！"},{"label":"获得专武","jp":"こ……これが……私の専用装備！\nこれで私も、超強化型JK！","fan":"这……这就是……我的专武！这样一来我也是超强化型JK了！","off":"这……这就是我的专用装备？\n这样一来，我也是超强化型JK了！"}],"事件":[{"label":"学生生日","jp":"先生！今日は私とミドリの誕生日なの！一緒にできる2人用ゲーム買って～。","fan":"老师！今天是我和小绿的生日！一起去买双人游戏吧～。","off":"老师！今天是我和小绿的生日！买个双人合作游戏嘛～"},{"label":"老师生日","jp":"先生！お誕生日おめでとう！今日はゲーム開発部のみんなと一緒に美味しいもの食べに行こう！","fan":"老师！生日快乐！今天和游戏开发部的大家一起去吃好吃的吧！","off":"老师！生日快乐！\n今天跟我们游戏开发部的大家一起去吃好吃的吧！"},{"label":"万圣节","jp":"わあ！ハロウィンだ！なんだかワクワクする！先生！早く飴ちょうだい！","fan":"哇！是万圣节！总觉得我好激动！老师！ 快给我糖吃！","off":"哇~万圣节！总觉得好兴奋啊！\n老师！快点给我糖！"},{"label":"新年","jp":"ハッピーニューイヤー！今年も楽しくゲームやろ！","fan":"新年快乐！今年也要快快乐乐打游戏吧！","off":"happy new year~\n今年也开心的玩游戏吧！"},{"label":"圣诞节","jp":"クリスマスか……うーん、先生が赤い服を着て、ゲーム機をプレゼントしてくれたら最高のクリスマスなのに！","fan":"圣诞节啊……唔，要是老师穿着红色的衣服，送我游戏机当礼物，那就是最棒的圣诞节了！","off":"圣诞节呀……\n啊，要是老师穿上红衣服送我游戏机，那就是最棒的圣诞节了"},{"label":"春节","jp":"","fan":"老师！新春快乐！\n今年会出什么有趣的新游戏呢？我已经等不及啦！","off":"老师！新春快乐！\n今年会出什么有趣的新游戏呢？我已经等不及啦！"},{"label":"中秋","jp":"","fan":"中秋节，当然要和家人团聚啦~\n我和小绿打算一起吃月饼打游戏，老师要一起来吗？","off":"中秋节，当然要和家人团聚啦~\n我和小绿打算一起吃月饼打游戏，老师要一起来吗？"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/73647.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/932638.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/81495.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/461011.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/305304.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/951066.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/196284.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/285844.ogg"