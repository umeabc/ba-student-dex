.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/11/219378.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/509712.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/946421.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/364151.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/11/455550.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/11/219378.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/509712.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/946421.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/364151.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"777"},{"name":"攻击力","value":"86"},{"name":"治愈力","value":"368"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/270193.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/675519.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★2 花绘","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/607683.png","url":"https://www.gamekee.com/ba/68915.html"},{"name":"NPC 花绘（护士装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_200/h_200/829/86082/2025/5/11/348346.png","url":"https://www.gamekee.com/ba/68915.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive~!"},{"label":"卡池抽取","jp":"メリークリスマ～ス！\nサンタさんの代わりに、ハナエが来ましたよ！","fan":"圣诞快乐~！\n花绘代圣诞老人来访了哟！","off":"圣诞快乐~！花江代替圣诞老人来啦！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生、先生！欲しいものはありませんか？\nサンタの私がプレゼントしちゃいますよ～！","fan":"老师，老师！有什么想要的东西吗？\n圣诞老人的我礼物多多哦~！","off":"老师，老师~！您有什么想要的吗？圣诞老人花江，来给您送礼物啦！"},{"label":"登陆2","jp":"先生、最近忙しそうですね……\n今日も帰りが遅かったですし、疲労がとれる簡単な手術をしましょうか？","fan":"老师，最近似乎很忙呢……\n今天也很晚才回来，让我为您做个消除疲劳的手术吧？","off":"老师，最近很忙嘛？今天来的也很晚呢……"},{"label":"大厅1","jp":"私は今日も元気です！\n先生はお変わりありませんか？","fan":"今天的我也是元气满满！\n老师您怎么样呢？","off":"今天的我也是充满干劲！老师呢？今天也打起精神了嘛？"},{"label":"大厅2","jp":"具合が悪いときは、ハナエを呼んでください！\n注射も手術もプレゼントしちゃいます！","fan":"身体不舒服的话，请随时呼叫花绘！\n无论是打针还是手术都免费当作礼物赠送您！","off":"有哪里不舒服的话，就来找花江吧~不管是手术、礼物还是打针，我这里都有哦~"},{"label":"大厅3","jp":"冬は凍傷に気を付けてくださいね！\n一歩でも間違えたら、患部を切断することになっちゃいますから！","fan":"冬天可要小心不要被冻伤哦！\n因为如果一不留神被冻伤的话，就不得不切掉患部了哦！","off":"冬天一定要小心冻伤哦！哪怕只是一点冻伤，可能都要截肢的！"},{"label":"大厅4","jp":"クリスマスが待ち遠しいですね！\n胸がワクワクしちゃいます！\n先生も楽しみだと嬉しいです！","fan":"终于迎来了圣诞节了呢！\n心里超级激动的呢！\n如果老师也一样期盼着圣诞节，我就超级开心了！","off":"我等不及要过圣诞节啦！心里激动地砰砰直跳。要是老师也一样期待就好啦！"},{"label":"大厅5","jp":"先生、先生！クリスマスプレゼントにおっきなウサギのぬいぐるみなんてどうですか？","fan":"老师，老师！作为圣诞礼物的大兔子玩偶怎么样？","off":"老师老师~您觉得，把巨大的兔子玩偶当成圣诞礼物怎么样？"},{"label":"回忆大厅1","jp":"これは……私なりのサンタさんをお迎えする準備です。","fan":"这是……为了迎接我自己的圣诞老人做的准备。","off":"这是……我为了迎接圣诞老人而做的准备！"},{"label":"回忆大厅2","jp":"サンタさんが寒くないよう、暖炉に火を入れて……\nクリスマスツリーを可愛く飾り付けるんです。","fan":"为了不让圣诞老人觉得冷，在壁炉里点了火……\n把圣诞树装饰得可可爱爱的。","off":"我在壁炉里生了火，这样圣诞老人就不会冷了~我还给圣诞树，挂上了可爱的装饰~"},{"label":"回忆大厅3","jp":"サンタさん、待ってますよ～って。\nそうすると、必ず靴下にプレゼントを入れてくれるんです！","fan":"圣诞老人，我在等你噢~。\n这样的话，他一定会把礼物放进我的袜子里的！","off":"这样，圣诞老人就知道我在等他了~只要这么做了，圣诞老人就一定会在我的袜子里塞上礼物的！"},{"label":"回忆大厅4","jp":"そして今年はですね……","fan":"然后今年呢……","off":"而且今年……！"},{"label":"回忆大厅5","jp":"サンタさんにお礼をしようと思っています！\nえへへ、どうでしょう？\n手作りクッキーと新鮮なミルクです！","fan":"我想向圣诞老人道谢！\n嘿嘿，怎么样？\n手工曲奇和新鲜的牛奶！","off":"我也一定要给圣诞老人送礼物~诶嘿嘿，您看这个怎么样？这可是我自制的曲奇和新鲜的牛奶哦~！"},{"label":"咖啡馆1","jp":"こんにちは！サンタ服だけどハナエですよ～！","fan":"你好呀！虽然身着圣诞老人服装，但是是花江哦~！","off":"您好呀~虽然穿着圣诞老人的衣服，但我是花江哦~"},{"label":"咖啡馆2","jp":"手術とプレゼントが必要な人～、いませんか～？","fan":"这里有需要做手术或者是礼物的人吗~？","off":"有需要做手术或者礼物的人嘛~"},{"label":"咖啡馆3","jp":"クリスマスでも救護騎士団の準備はバッチリです！","fan":"即使在圣诞节，救护骑士团也做足了准备！","off":"就算是圣诞节，救护骑士团也随时待命！"},{"label":"咖啡馆4","jp":"煙突は……どこにあるのでしょう？","fan":"烟囱……在哪里呢？","off":"烟囱……在哪里？"},{"label":"咖啡馆5","jp":"クリスマスにチャリティーイベントがあるんです。\n私もそこでみんなと一緒に歌いますよ～","fan":"圣诞节将会举行慈善活动哦。\n到时候我也会在那里和大家一起歌唱的~","off":"今年圣诞节也会举办慈善活动哦~我会在活动上和大家一起唱歌的！"}],"好感度":[{"label":"好感度1","jp":"クリスマスに大切なもの…？\nそれはもちろん、愛ですよ！","fan":"在圣诞节十分重要的东西是…？\n那当然是爱啦！","off":"圣诞节最重要的是……当然是爱啦~！"},{"label":"好感度2","jp":"先生、マッハ2で走る橇に興味はありませんか？","fan":"老师，您对以2马赫的速度行驶的雪橇有兴趣吗？","off":"老师，您对时速两马赫的雪橇感兴趣嘛？"},{"label":"好感度3","jp":"今の私と同じぐらい、みんなが幸せでありますように！","fan":"希望大家都能够像现在的我一样幸福！","off":"希望大家，都能像现在的我一样幸福！"},{"label":"好感度4","jp":"一つだけプレゼントが貰えるなら、私は先生との時間がいいです～！","fan":"如果要送我什么礼物的话，那就送我和老师相处的时间吧~！","off":"如果我也能要一个礼物的话……我想要和老师共处的时间！"}],"战斗":[{"label":"编入队伍1","jp":"サンタとして頑張りますね！","fan":"作为圣诞老人要努力呢！","off":"我会努力扮演圣诞老人的！"},{"label":"编入队伍2","jp":"任せてください～！","fan":"请交给我吧~！","off":"就交给我吧~"},{"label":"拎起","jp":"先生にプレゼントです！","fan":"这是给老师的礼物！","off":"这是给老师的惊喜哦~！"},{"label":"普通技能","jp":"治療が必要な方はどこですか～","fan":"需要治疗的人在哪儿呢~","off":"需要治疗的孩子在哪里？"},{"label":"EX动画1","jp":"みんなのプレゼントですよ！","fan":"送给大家的礼物！","off":"这是给大家的礼物哦~"},{"label":"EX动画2","jp":"今日一日はサンタですから～！","fan":"因为今天一天我是圣诞老人~！","off":"今天一天我都是圣诞老人~"},{"label":"EX动画3","jp":"みんなに幸せを届けします！","fan":"给大家带来幸福！","off":"我要给大家带来幸福~！"},{"label":"EX技能1","jp":"はい、プレゼントをどうぞ。","fan":"来，礼物拿好。","off":"来，收下这份礼物吧~"},{"label":"EX技能2","jp":"受け取ってください～","fan":"请收下吧~","off":"好好收下吧~"},{"label":"EX技能3","jp":"気に入ってもらえましたか","fan":"还满意吗~","off":"圣诞老人……啊，还没来。……但救护骑士团到啦！"}],"成长":[{"label":"升级1","jp":"サンタさんって本当にすごいです！\nでも、今はわたしがサンタなので本物に近付けるよう、頑張ります！","fan":"圣诞老人真的很了不起！\n但是，我作为圣诞老人，要向圣诞老人本人靠近，我会努力！","off":"圣诞老人真的很了不起……！不过，既然我现在是圣诞老人，那我就要努力向本尊学习！"},{"label":"升级2","jp":"この服を着たからには、頑張りますよ！先生も手伝ってくれますか","fan":"既然穿上了这身衣服，我就会加油的！老师可以帮帮我吗","off":"既然穿上了这身衣服，我就会好好努力！可以请老师也帮帮我嘛？"},{"label":"升级3","jp":"本物のサンタさんにはなれなくても、皆に幸せを届けたいです～！","fan":"虽然不能成为真正的圣诞老人，但还是想给大家带去幸福~！","off":"就算当不了真正的圣诞老人，我依然想给大家带来幸福！"},{"label":"升级4","jp":"いつの日か、みんなが幸せになれますように！","fan":"希望哪一天大家都可以变得幸福！","off":"希望有一天，大家都能得到幸福~！"},{"label":"获得专武","jp":"よし、準備オッケーです！","fan":"好咧，准备OK啦！","off":"很好，准备完毕~！"}],"事件":[{"label":"学生生日","jp":"今日は私の誕生日です！\nプレゼントは……\n先生が欲しいです！えへへ。","fan":"今天是我的生日！\n礼物嘛……\n我想要老师！诶嘿嘿。","off":"今天是我的生日~礼物嘛……我想要老师~嘿嘿~"},{"label":"老师生日","jp":"わあ、お誕生日おめでとうございます！\nはい、こちら！プレゼントの中にプレゼントを入れてみました！\nどうでしょう！えっ……マトリョーシカみたい……ですか？","fan":"哇，祝您生日快乐！\n来，拿着！礼物里面还塞有礼物哦，我试着准备的！\n怎么样！诶……像俄罗斯套娃一样吗……？","off":"哇哦~祝您生日快乐~是的，我在这个礼物里还放了礼物！怎么样~……嗯，您觉得，像套娃一样……？"},{"label":"万圣节","jp":"ハロウィンも大好きなお祭りの一つです！\nでも……なんだか治療や手術が必要な人が多そうですね？","fan":"万圣节是我最喜欢的节日之一！\n但是……总觉得需要治疗和手术的人有很多呢？","off":"万圣节到啦~过节真开心呀！但总觉得，今天很多人看起来都需要治疗和手术呢……"},{"label":"新年","jp":"先生、もう新年ですよ！\nあけましておめでとうございます！\nクリスマスは過ぎちゃったけど、まだサンタ服でも\n大丈夫でしょうか？","fan":"老师，新年已经到了啊！\n新年快乐！\n不过圣诞节已经过去了，还穿着圣诞老人服装真的没问题吗？","off":"老师，新年已经到啦！祝您新年快乐~！虽然圣诞节已经过去了，但我还穿着圣诞服，这样没关系嘛……？"},{"label":"圣诞节","jp":"先生、クリスマスですよ！\n今年もサンタさん、来てくれるかなぁ。","fan":"老师，今天是圣诞节哦！\n今年圣诞老人也会来的吧。","off":"老师，今天是圣诞节~！圣诞老人今年也会来的吧……？"},{"label":"春节","jp":"","fan":"老师，圣诞老人花江祝您新春快乐~！诶，您说圣诞老人现在应该在休假……？呃……这……这是为了老师的幸福和健康，才特意加班的！","off":"老师，圣诞老人花江祝您新春快乐~！诶，您说圣诞老人现在应该在休假……？呃……这……这是为了老师的幸福和健康，才特意加班的！"},{"label":"中秋","jp":"","fan":"听说月亮上生活着一群可爱的小兔子~！那圣诞老人会给它们送圣诞礼物嘛？……那怎么才能上去呢？","off":"听说月亮上生活着一群可爱的小兔子~！那圣诞老人会给它们送圣诞礼物嘛？……那怎么才能上去呢？"}],"活动":[{"label":"活动登陆1","jp":"先生、いよいよクリスマスがやってきました！\n私もクリスマスモードですよ～！","fan":"老师，圣诞节终于来了！\n我也切换到了圣诞模式哟～！","off":"老师，圣诞节终于到啦，我也进入圣诞模式啦~！"},{"label":"活动登陆2","jp":"先生は何か欲しいものありますか？\n私がサンタさんにお願いの手紙を書きますよ！","fan":"老师有什么想要的东西吗？\n我可以给圣诞老人写一封请求信哦！","off":"老师有什么想要的嘛？我可以写信告诉圣诞老人~！"},{"label":"活动大厅1","jp":"先生、どうしました？\n何かありましたか？","fan":"老师，怎么了？\n有什么事吗？","off":"老师，怎么啦？有什么事嘛？"},{"label":"活动大厅2","jp":"そんなにジッと見つめられると……\nこの格好、変ですか？","fan":"您这样盯着我看……\n我这个样子很奇怪吗？","off":"您一直这样盯着我……我这身衣服，很奇怪嘛？"},{"label":"活动大厅3","jp":"どうしました？何か忘れ物でも……？えっ、違う？","fan":"怎么了吗？是有什么东西忘拿了……？诶，不是吗？","off":"您怎么了？是忘记什么东西了嘛？……诶，不是嘛？"},{"label":"活动大厅4","jp":"ううう……そんなにあちこち触ってくるなら……\n私だって先生のこと、いっぱい触りかえしちゃいます！","fan":"呜呜呜……这样到处摸的话……\n我也会把老师摸回来的！","off":"呃呃……如果您继续这样戳我，那我也要戳老师了哦！"},{"label":"活动事件1","jp":"一緒に頑張りましょう、先生！","fan":"一起加油吧，老师！","off":"一起加油吧，老师！"},{"label":"活动事件2","jp":"あと少しです！達成感はありますけど……\nちょっと寂しくもなりますね。","fan":"还有一点了！虽然还是有成就感……\n但是有点寂寞呢。","off":"还有一点了！虽然还是有成就感……\n但是有点寂寞呢。"},{"label":"活动结束","jp":"もうお開きのお時間ですね。\n後片付け、お手伝いしますよ！","fan":"已经到散场的时间了。\n我会帮你收拾的！","off":"已经到散场的时间了。\n我会帮你收拾的！"},{"label":"活动任务1","jp":"このリスト、ここで合ってたっけ？\n……あれ、どっちだろ？","fan":"这个名单在这里对吗？\n……咦，是哪一个呢？","off":"这份清单，对的上嘛？诶，到、到底是哪个……！"},{"label":"活动任务2","jp":"なんだかお仕事がいっぱいですね……。\nこれも手術できちゃえばいいのに。","fan":"总觉得工作很多呢……。\n这个也能做手术就好了。","off":"工作好多啊……如果这个也能用手术解决就好了。"},{"label":"活动任务每日结束","jp":"目標は毎日コツコツ達成するのが大切ですよね。\n今日もよく頑張りました、先生！","fan":"每天孜孜不倦地达成目标是很重要的。\n今天也很努力，老师！","off":"每天坚持完成目标很重要！今天您也好好努力了呢，老师~"},{"label":"活动任务登录1","jp":"今日のやる事はこちらです！","fan":"今天要做的事就在这里啦！","off":"这是今天要做的工作！"},{"label":"活动任务登陆2","jp":"一つずつ、焦らずいきましょう！","fan":"不要着急，一个一个慢慢来！","off":"不要着急，一项一项完成吧~"},{"label":"活动任务获取1","jp":"すごい！さすが先生です！","fan":"真厉害！不愧是老师！","off":"真厉害，不愧是老师~"},{"label":"活动任务获取2","jp":"お疲れさまでした、先生。\n私もうれしいです！","fan":"辛苦了，老师。\n我也很高兴！","off":"辛苦了老师~我也很开心~！"},{"label":"活动商店1","jp":"あれっ、何かありましたか？","fan":"嗯？有什么事吗？","off":"嗯？出什么事了嘛？"},{"label":"活动商店2","jp":"今日のハナエサンタは幸せをお届けしますよ～！","fan":"今天的花绘会带来幸福哦~！","off":"今天的圣诞老人花江，要给大家带来幸福！"},{"label":"活动商店关闭","jp":"チャリティーイベントは終了しました！\nまだ手元に抽選券があるなら、私が引き換えますよ！","fan":"慈善活动结束了！\n如果手上还有抽奖券的话，可以到我这里兑换哦！","off":"慈善活动已经结束了，如果还有抽奖券的话，可以找我兑换！"},{"label":"活动商店登陆1","jp":"救護騎士団主催のチャリティーイベントを開催中です！","fan":"救护骑士团主办的慈善活动正在进行中！","off":"救护骑士团主办的慈善活动，正在进行中！"},{"label":"活动商店登陆2","jp":"あっ、先生！ようこそ！くじはいかがですか？","fan":"啊，老师！欢迎光临！来抽一签吗？","off":"啊，老师~欢迎~！要来抽个签嘛？"},{"label":"活动商店购买1","jp":"わあっ、大当たり！","fan":"哇，大奖！","off":"哇~抽中了大奖诶！"},{"label":"活动商店购买2","jp":"えへへ。私のプレゼント、気に入ってもらえたら嬉しいです！","fan":"诶嘿嘿。我的礼物，如果您能满意我就太高兴了！","off":"诶嘿嘿，希望您喜欢我送的礼物~！"},{"label":"活动商店购买3","jp":"わあっ……！こんなものが入ってたなんて……！","fan":"哇……！这里面居然有这么好的东西……！","off":"哇~！里面居然还有这些好东西！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0