iki2.0/images/w_300/h_237/829/72324/2025/5/9/460881.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/867699.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"678"},{"name":"攻击力","value":"132"},{"name":"治愈力","value":"226"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/623874.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/628472.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★2 朱音","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/9/204800.png","url":"https://www.gamekee.com/ba/66752.html"},{"name":"★3 朱音（制服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/191981/2025/6/23/927668.png","url":"https://www.gamekee.com/ba/645973.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"ご主人様のメイド、アカネです。\nいえ…今はご主人様のウサギさん、と申し上げるべきでしょうか？","fan":"这里是主人的女仆，朱音。\n不…我似乎应该说，今天是主人的兔女郎？","off":"我是主人的女仆，茜。\n哦不，现在应该说我是主人的兔兔了吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お待ちしておりました、ご主人様。\nアカネはご主人様だけの忠実なウサギです。ぴょんぴょん！","fan":"恭候您多时了，主人。\n朱音是只属于主人的忠实兔子。蹦蹦跳跳！","off":"我正等你呢。主人。\n茜是只属于主人的忠诚兔兔，蹦蹦。"},{"label":"登陆2","jp":"おかえりなさいませ、ご主人様。準備は全て終わっております…\n勤勉なウサギですから。","fan":"欢迎回来，主人。全部都已经准备好了。\n因为我是一只勤劳的兔子。","off":"欢迎回来，主人，所有准备工作都已经完成了，因为我是一只勤劳的兔兔。"},{"label":"大厅1","jp":"ウサギになりきるのは楽しいか…ですか？\nうふふ、そうですね…どう見えます？","fan":"变成兔子……开心吗？\n呵呵，让我想想……您觉得呢？","off":"问我变成兔兔开不开心？这个，您觉得呢？"},{"label":"大厅2","jp":"ご要望がありましたら、いつでもお申し付けください。\nお待ちしておりますので。","fan":"如果有什么希望的事情的话，无论何时都可以和我说我。\n我随时待命。","off":"如果你想要什么，请随时告诉我，我一直都在。"},{"label":"大厅3","jp":"ご主人様とのこの一瞬は、私にとってかけがえのない大切な時間です。","fan":"与主人在一起的每个瞬间，于我来说都是无可替代的珍贵的时光。","off":"和主人一起度过的每个瞬间，对我来说都是无可替代的宝贵时光。"},{"label":"大厅4","jp":"爆弾は一番効率的な掃除道具なんですよ。\nじょ、冗談です…そんな目で見ないでください、ご主人様。","fan":"炸弹可是效率最高的打扫道具哦。\n开、开玩笑啦……请别用这个眼神看着我，主人。","off":"炸弹是最有效的打扫工具之一。\n我，我开玩笑的，请不要那样看着我，主人。"},{"label":"大厅5","jp":"ウサギになりきる事は、より完璧なエージェントに近づくための一歩。\nもしくは、より完璧なメイドに近づくための一歩かもしれませんね。","fan":"完完全全变成兔子，是向变成更加完美的特工靠近的一步。\n或者说，是向完美的女仆靠近的一步。","off":"我认为成为兔兔是成为完美特工的一种方式，又或者是成为更完美女仆的一种方式。"},{"label":"回忆大厅1","jp":"申し訳ございません……\nこんな考え、メイドとしては失格のはずなのに。\n私……自信をなくしておりました。","fan":"非常抱歉……\n这么想来，作为女仆我真是不合格。\n我……没有自信了。","off":"非常抱歉，有这样的想法是我身为女仆的失职。我失去了自信。"},{"label":"回忆大厅2","jp":"ご主人様はいつも多くのものを背負っていて、\nそれなのに大丈夫だと笑っていて。","fan":"主人身上背负了那么多，\n即便如此也总是笑着说没关系。","off":"主人一直背负着很多重担，可即便如此，你还是会笑着说，没关系。"},{"label":"回忆大厅3","jp":"私は…全然その重荷を、代わりに持って差し上げられず…。","fan":"而我呢…却完全没有替您分担重担…。","off":"我没能替你背负那份重担。"},{"label":"回忆大厅4","jp":"ですが、ご主人様のお言葉で、再び前を向けそうです。","fan":"但是，听了主人您这番话，我又有了再次向前的动力。","off":"可是听了主人的话，我再一次找回了自信。"},{"label":"回忆大厅5","jp":"これからも、ふつつかものですが何卒よろしくお願いいたします。ご主人様。","fan":"朱音虽不才，但从今以后也要请您多多关照了。主人。","off":"虽然我还有很多不足之处，但今后还是请主人多多关照啦。"},{"label":"咖啡馆1","jp":"綺麗に整頓されていますね。掃除は…大切です。","fan":"整理得干干净净了呢。打扫卫生……很重要的。","off":"收拾干净了，打扫卫生是很重要的。"},{"label":"咖啡馆2","jp":"いらっしゃいませ。ご注文は紅茶ですか？…ふふっ。","fan":"欢迎光临。点一杯红茶吗？……呵呵。","off":"欢迎光临。要点一杯红茶吗？"},{"label":"咖啡馆3","jp":"ご主人様は本当に…特別なお方なのです。","fan":"主人真是一位……很特别的人呢。","off":"主人真的是一个很特别的人。"},{"label":"咖啡馆4","jp":"もう少し整理できるところは…","fan":"もう少し整理できるところは…","off":"哪里还需要再整理一下吗？"},{"label":"咖啡馆5","jp":"この際、ご主人様と一緒にウサギの道を歩んでみるのも…？","fan":"这个时候，和主人一起去兔子街…？","off":"趁此机会，和主人一起漫步在兔兔之路上。"}],"好感度":[{"label":"好感度1","jp":"ウサギには愛が必要なんですよ。ぴょんぴょん！","fan":"兔子可是需要爱来浇灌的哦。蹦蹦！","off":"兔兔需要爱哦，蹦蹦！"},{"label":"好感度2","jp":"ありがとうございます、ご主人様。これからもご期待ください。","fan":"非常感谢，主人。今后也请期待我的表现吧。","off":"多谢主人，今后也请拭目以待吧。"},{"label":"好感度3","jp":"全てご主人のおかげです。本当に全てが…","fan":"一切都多亏了主人。真的一切都多亏了您…","off":"这一切都是主人的功劳。真的，所有一切。"},{"label":"好感度4","jp":"ウサギのアカネを、逃がさないでくださいね。","fan":"请您不要从兔子朱音的身边离开。","off":"请不要错过兔兔茜啊~"}],"战斗":[{"label":"编入队伍1","jp":"さあ、それではお掃除を始めましょうか。","fan":"那么，开始打扫吧。","off":"好了，那就开始打扫吧。"},{"label":"编入队伍2","jp":"普段より胸が高鳴って、これも、ご主人と一緒にいるからでしょうか。","fan":"比起平常更加心潮澎湃，这大概也许是，因为和主人在一起的缘故吧。","off":"感觉心跳得比平时更快呢，这是因为和主人在一起吗？"},{"label":"拎起","jp":"お掃除の視界がありますね。","fan":"清扫工作的视野已经确认了。","off":""},{"label":"普通技能","jp":"ここに置いておきますね。","fan":"放在这里了哦。","off":"放在这里了。"},{"label":"EX动画1","jp":"こちらが本日の掃除対象でしょうか。","fan":"这位就是今日的扫除对象吗。","off":"这是今天要打扫的目标吗？"},{"label":"EX动画2","jp":"こんなに散らかして…","fan":"这样散乱着…","off":"弄得真乱。"},{"label":"EX动画3","jp":"綺麗に片付けてしまいましょう。","fan":"让我来打扫整洁吧。","off":"让我来收拾干净吧。"},{"label":"EX技能1","jp":"はい、どうぞ。","fan":"来，请。","off":"好了，请拿好。"},{"label":"EX技能2","jp":"私の気持ちを受け取ってくださいませ。","fan":"请您收下我的这份心意。","off":"请收下我的心意。"},{"label":"EX技能3","jp":"どうぞご堪能ください。","fan":"请尽情享用。","off":"来，请尽情享用哦。"},{"label":"被CC4","jp":"\\","fan":"\\","off":"\\"},{"label":"被CC6","jp":"\\","fan":"\\","off":"\\"}],"成长":[{"label":"升级1","jp":"少しは、お役に立てておりますでしょうか。","fan":"我是否，稍微能帮上点您什么呢。","off":"有没有稍微帮到您一点呢？"},{"label":"升级2","jp":"メイトとしても、ウサギとしても、ご主人様のお役に立てますように。","fan":"作为女仆也好，作为兔女郎也好，都希望能成为主人的左膀右臂。","off":"无论是身为女仆还是身为兔兔，我都希望能帮上主人的忙。"},{"label":"升级3","jp":"成長しましたよ。ぴょんぴょん！","fan":"我成长了哦。蹦蹦！","off":"兔兔成长了。"},{"label":"升级4","jp":"ご主人様のご期待にお答えできるように、洗練されてきました。","fan":"为了能回应主人的期待，我变得更加干脆利落了。","off":"为了不辜负主人的期待，我一直在好好锻炼。"},{"label":"获得专武","jp":"これでもっと完璧な…「ウサギ」になれますね。","fan":"这下一来就能成为更完美的…「兔子」了哦。","off":"这样就能成为更完美的兔兔了呢。"}],"事件":[{"label":"学生生日","jp":"私の誕生日を覚えてくださっていたのですか？\nありがとうございます、ご主人様。これ以上に嬉しいことはございません。","fan":"您还记得我的生日啊？\n非常感谢您，主人。我真是太开心了。","off":"您竟然记得我的生日，谢谢您。主人。茜实在太高兴了。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、ご主人様！\n本日は、ウサギからの特別なご奉仕を、期待していてくださいね？\nウサギの特別な奉仕、ですか？うふふ…さあ、何でしょうね？\n大丈夫。怖くないですよ～さあ、よしよし…。","fan":"祝您生日快乐，主人！\n今天有没有期待着兔子的特别侍奉呢？\n兔子的特别侍奉，会是什么呢？呵呵…会是什么呢？\n没关系的。不要害怕哦~那么，来吧来吧…。","off":"生日快乐，主人，请期待兔兔今天的特别服务。\n你问兔兔的特别服务是什么？这个会是什么呢？\n没关系，不需要害怕。好啦，乖乖。"},{"label":"万圣节","jp":"あ、ハロウィーンですね。\n私のこの格好も、今日だけは普通に見えますね。\nそれで…どんなイタズラがいいですか？\nお菓子をくださっても、イタズラはしますからね？","fan":"啊，是万圣节呢。\n我的这身打扮，唯独在今天显得格外普通呢。\n话说…我要做什么恶作剧比较好呢？\n不给糖的话我可就要捣蛋咯？","off":"今天是万圣节，我这身打扮在今天看起来应该很普通。\n对了，主人喜欢什么样的恶作剧？\n就算给我糖的话，我也会捣蛋的。"},{"label":"新年","jp":"あけましておめでとうございます、ご主人様。\n…もう新年ですね。今年は本当に良い事がたくさんありますように…。","fan":"新年快乐，主人。\n…又到了新年了啊。真心希望今年会有好事发生…","off":"新年快乐，主人新年到了，希望今年好事多多。"},{"label":"圣诞节","jp":"クリスマスですね、ご主人様。\nご主人様となら毎日が特別ですが…今日はとびきり特別な日です。\n寒がっているウサギのために…おそばにいてくださりませんか？","fan":"今天是圣诞节呢，主人。\n虽然和主人在一起的每一天都是特别的…但今天更是特别的一天。\n今天能请您陪伴在…寂寞冷的兔子身边吗？","off":"今天是圣诞节，主人。\n和主人在一起每天都很特别，但今天是更加特别的一天，\n您愿意留下来陪着怕冷的兔兔吗？"},{"label":"春节","jp":"","fan":"真是热闹的节日啊，今年的兔兔倩也会一如既往的为主人服务啊。","off":"真是热闹的节日啊，今年的兔兔倩也会一如既往的为主人服务啊。"},{"label":"中秋","jp":"","fan":"今天是特别的一天呢，让兔兔倩为主人准备好月饼和茶水吧。","off":"今天是特别的一天呢，让兔兔倩为主人准备好月饼和茶水吧。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/283180.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/14112.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/797826.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/654619.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/619126.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/692795.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/192862.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/191327.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/40683.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/551893.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/761109.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/731383.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/9/921512.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/571101.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72