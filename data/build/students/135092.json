9/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/13/427499.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/13/875624.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 艾米","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/13/442637.png","url":"https://www.gamekee.com/ba/68820.html"},{"name":"★3 艾米（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_235/h_235/829/191981/2026/0/18/606166.png","url":"https://www.gamekee.com/ba/690663.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"いつもよりちょっと体が軽いかも、涼しいからかな。","fan":"感觉身体比平常轻快，是因为比较凉爽吗。","off":"感觉身体比平时轻盈……是因为天气很凉快吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰り、先生。部屋涼しくおいたよ。","fan":"欢迎回来，老师。我已经提前让房间凉快下来了哦。","off":"老师，欢迎你。房间已经凉快下来啦。"},{"label":"登陆2","jp":"お疲れ様、先生。...どうして驚くの？","fan":"辛苦了，老师。…为什么会惊讶？","off":"辛苦啦，老师。\n……嗯？为什么这么惊讶？"},{"label":"大厅1","jp":"「どうしてずっとこの格好」なのか？気に入ってるから？","fan":"为什么一直都是这身打扮？因为喜欢？","off":"问我为什么还是这身打扮？\n……因为喜欢啊。"},{"label":"大厅2","jp":"ここ、暑すぎる...エアコンの温度下げてもいい？","fan":"这里也太热了…把空调温度再调低些可以吗？","off":"这里，好热……\n空调温度可以调低点儿吗？"},{"label":"大厅3","jp":"やっぱり、ジャケット脱ごうかな…","fan":"果然还是把外套脱了吧…","off":"看来，还是得脱掉羽绒服。"},{"label":"大厅4","jp":"下着はダメで、水着は大丈夫...？いったい何が違うの？防水機能の有り無し…？","fan":"不能只穿着内衣，但是泳装却可以…？到底有什么区别呢？是防水性能的差别吗…？","off":"内衣不行，泳装就可以？……到底有什么区别？有没有防水功能的区别吗？"},{"label":"大厅5","jp":"机の下から、こんな雑誌を見つかったよ、いい資料がいっぱい。...どうしたの、先生？慌てっちゃて？","fan":"从桌子下面发现了这样的杂志，有很多上好的资料呢。…怎么了老师？为什么这么慌张？","off":"我在桌子底下发现了这种杂志，里面有好多很不错的资料。\n……怎么了，老师？怎么这么慌张？"},{"label":"回忆大厅1","jp":"えん？寒くないよ、大丈夫。","fan":"嗯？不冷哦，没事的。","off":"嗯？不冷呀，没事的。"},{"label":"回忆大厅2","jp":"逆に、今が涼しくて丁度いいぐらい。","fan":"相反，不如说凉爽的恰到好处。","off":"恰恰相反，现在很凉快，刚刚好呢。"},{"label":"回忆大厅3","jp":"いい気分～先生も入る？","fan":"心情都愉悦了起来~老师也一起吗？","off":"好舒服啊~\n老师也想进来吗？"},{"label":"回忆大厅4","jp":"ふぅん～いいけど...","fan":"嗯~倒是也行…","off":"嗯~那好吧。"},{"label":"回忆大厅5","jp":"もうちょっとしたら出るから、少しだけ待っててね、先生。","fan":"再泡一会儿就出来，再等等哦，老师。","off":"我过会就出去。稍微等我一下哦~老师。"},{"label":"咖啡馆1","jp":"ヒマリ先輩がいない、今のうちに…","fan":"趁着日鞠前辈不在…","off":"趁日鞠前辈不在……"},{"label":"咖啡馆2","jp":"ここにかき氷があれば完璧なんだけど…","fan":"要是有刨冰就完美了…","off":"这里要是有刨冰就完美了……"},{"label":"咖啡馆3","jp":"エアコンのスイッチは…","fan":"空调开关在…","off":"空调开关……"},{"label":"咖啡馆4","jp":"熱くなってきた…ここ、人多いし...","fan":"逐渐热起来了…毕竟这里人很多呢…","off":"越来越热了……是因为人多吗？"},{"label":"咖啡馆5","jp":"ここなら、一生暮らせそう。","fan":"感觉能在这里住一辈子。","off":"感觉在这里，能待上一辈子……"}],"好感度":[{"label":"好感度1","jp":"ありがどう、先生。","fan":"谢谢，老师。","off":"谢谢你，老师。"},{"label":"好感度2","jp":"いつも助けられてばかりだね。","fan":"总是受老师帮助呢。","off":"我一直，在接受你的帮助。"},{"label":"好感度3","jp":"変なの、暑いのに、なんだか気分がいい…","fan":"奇怪…明明很热，却又觉得心情不错…","off":"好奇怪……虽然很热，但不知道为什么，心情很好……"},{"label":"好感度4","jp":"先生が一緒なら、暑い所も嫌じゃないかも。","fan":"和老师在一起，就算是下火海也没那么讨厌呢。","off":"跟老师在一起，很热的地方，好像也没那么难受了。"}],"战斗":[{"label":"编入队伍1","jp":"わかった。任せて。","fan":"明白了。交给我吧。","off":""},{"label":"编入队伍2","jp":"コンディションは絶好調だよ。","fan":"状态绝佳哦。","off":""},{"label":"拎起","jp":"うーん、涼しい。","fan":"唔——，真凉快。","off":""},{"label":"普通技能","jp":"はい、自信作だよ。","fan":"这是我的自信之作。","off":"给，这是我的自信之作。"},{"label":"EX动画1","jp":"ここが、ペンギンパラダイス？","fan":"这里是企鹅乐园吗？","off":"这里是，企鹅天堂吗？"},{"label":"EX动画2","jp":"みんな楽しそう。","fan":"大家都很开心呢。","off":"大家看起来都好开心。"},{"label":"EX动画3","jp":"私もやってみたいな、流氷ダイブ。","fan":"我也想试试浮冰潜水。","off":"跳进浮冰下面，我也想试试。"},{"label":"EX技能1","jp":"こっちおいて。","fan":"来这边。","off":"来这边~"},{"label":"EX技能2","jp":"ぶつからないよう、気を付けてね。","fan":"小心点，不要撞到了哦。","off":"小心别碰着~"},{"label":"EX技能3","jp":"順番を守って。","fan":"排好队。","off":"按顺序来~"}],"成长":[{"label":"升级1","jp":"私に投資することが最高効率？","fan":"投资我，是最有效率的行动？","off":"投资我最有效率……？"},{"label":"升级2","jp":"特訓な成果が出たみたい、良かった。","fan":"看来特训还是有成果的，太好了。","off":"特训成果体现出来了，太好了。"},{"label":"升级3","jp":"まだ足りない。もっと昇進しないと。","fan":"还不够，还要更加精进。","off":"还不够，需要更加努力。"},{"label":"升级4","jp":"ここまでこれたのは、先生のおかけだよ。","fan":"我能够走到这一步，全都是多亏了老师。","off":"能走到今天这一步，都是多亏了老师帮忙。"},{"label":"获得专武","jp":"服や環境変わっても、これがあれば、もう大丈夫。","fan":"无论服装或环境如何变化，只要有这个就没关系。","off":"就算衣服和环境换了，有它，我就安心了。"}],"事件":[{"label":"学生生日","jp":"先生が一緒に過ごしてくれるって言うから、最高効率の誕生日プランを作ってきたの。今日は一秒も無駄にしたくない。","fan":"因为老师说了会陪我过生日，所以指定了最有效率的生日计划。今天连一秒也不想浪费，","off":"老师说会陪我，所以，我制定了最高效的生日计划。今天，我一秒钟也不想浪费。"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。今日は先生の好きな服て過ごそうと思うんだけど…何かリクエストとかある？","fan":"生日快乐，老师。我想着今天就穿老师喜欢的衣服来庆祝…老师有什么要求吗？","off":"生日快乐，老师。今天，我打算穿你喜欢的衣服。你有什么特殊的要求吗？"},{"label":"万圣节","jp":"ハロウィーンっていいよね。どんな服でも、みんな喜んでくれるし。","fan":"万圣节真是个不错的日子。不管穿什么衣服，大家都会笑脸相迎。","off":"万圣节挺好的诶~不管穿什么，大家都会喜欢。"},{"label":"新年","jp":"明けましておめでとう、先生。今年は、自分でも納得できる実力を身につけたいな。","fan":"新年快乐，老师。今年的愿望是获得让自己都能认可的实例。","off":"新年快乐，老师。希望今年我能拥有让自己满意的实力。"},{"label":"圣诞节","jp":"クリスマスだね。この日に合う服が持って来たから、着替えて...ええと、今の格好一番？","fan":"圣诞节呢。正好带了一套符合节日氛围的衣服，现在就换上…诶？现在的装扮就很适合？","off":"到圣诞节了诶~我带了适合今天穿的衣服，这就去换上。\n……诶？现在的样子，就是最好的？"},{"label":"春节","jp":"","fan":"春节，是我最喜欢的节日之一了。其他还有圣诞节，元旦，情人节……\n诶？你问为什么都是冬天的节日？\n……你猜？","off":"春节，是我最喜欢的节日之一了。其他还有圣诞节，元旦，情人节……\n诶？你问为什么都是冬天的节日？\n……你猜？"},{"label":"中秋","jp":"","fan":"今天的月亮，好亮好圆呐……\n听说月表温差很大，夜晚可以达到零下一百五十度……而且月亮上也有海，虽然海里没有水，听起来，是个很棒的地方。\n如果能到那里去的话，我也会穿着泳装的。","off":"今天的月亮，好亮好圆呐……\n听说月表温差很大，夜晚可以达到零下一百五十度……而且月亮上也有海，虽然海里没有水，听起来，是个很棒的地方。\n如果能到那里去的话，我也会穿着泳装的。"}],"活动":[{"label":"minieventlobby_1","jp":"ヒマリ部長、忙しそう。…でも楽しそうだから、大丈夫か。","fan":"日鞠部长看起来很忙呢……不过似乎乐在其中，应该没问题吧。","off":""},{"label":"minieventlobby_2","jp":"寒かったらこっちにおいで、先生。そのほうが、お互い効率が良いと思うし？","fan":"老师要是觉得冷的话就过来这边吧？这样对我们来说效率都更高哦？","off":""},{"label":"minieventlobby_3","jp":"気温とコンディションは密接な関係にあるんだ。だから、ここは快適で気に入ってる。","fan":"气温和身体状态是密切相关的。所以我很喜欢这个舒适的地方。","off":""},{"label":"minieventlobby_4","jp":"お疲れ様、先生。それ、ちょっと見せて？","fan":"老师辛苦了。那个，可以让我看看吗？","off":""},{"label":"minieventlobby_5","jp":"先生がいてくれると、作戦の成功率が上昇するの。……私も、調子良いし。","fan":"有老师在的话，作战成功率就会提升呢。......我的状态也不错。","off":""},{"label":"minieventlogin_1","jp":"先生、こんにちは。新しい基地はどう？","fan":"老师，您好。新基地感觉如何？","off":""},{"label":"minieventlogin_2","jp":"やることがたくさん……一つずつ、片づけていこっか。","fan":"要做的事情还有很多......我们一件一件来处理吧。","off":""},{"label":"minieventlogin_3","jp":"おかえり、先生。なんでも言ってね。","fan":"欢迎回来，老师。有什么需要尽管说。","off":""},{"label":"minieventshop_1","jp":"うん？どうしたの？……呼んでみただけ？なんで……？……まぁ、先生がそうしたいなら、いっか。","fan":"嗯？怎么了？......只是叫叫我？为什么......？......嘛，如果老师想这样的话，也行吧。","off":""},{"label":"minieventshop_2","jp":"コレを持って、アレすると、ナンカでるんだって。……私もよく分かってないんだけど、部長の説明によるとそんなところらしいよ。","fan":"听说拿着这个，做那个的话，就会出来什么东西。......我也不太清楚，不过根据部长的说明，大概就是这么回事吧。","off":""},{"label":"minieventshop_3","jp":"分析中はやることがあんまりないんだ。……先生の膝の上、座っていい？","fan":"分析的时候没什么事情可做。......老师，我可以坐在您的膝盖上吗？","off":""},{"label":"minieventshop_4","jp":"体温が変数になっちゃうから、分析中は近寄らないように、って言われたの……分かってはいるんだけど、ちょっと寂しいかも。","fan":"他们告诉我分析的时候不要靠近，因为体温会变成干扰变量......道理我都明白，但或许有点寂寞呢。","off":""},{"label":"minieventshop_5","jp":"この場所……好きかも。部室の一部、ここに持ってきたらダメかな？","fan":"这个地方......我可能有点喜欢。能把部室的一部分搬到这里来吗？","off":""},{"label":"minieventshop_buy_1","jp":"はい、どうぞ。……こういうの、「物々交換」って言うんだっけ？","fan":"给，请收好。......这种情况，是叫做\"以物易物\"来着吗？","off":""},{"label":"minieventshop_buy_2","jp":"結果が出たよ。どれにする？","fan":"结果出来了。您要选哪个？","off":""},{"label":"minieventshop_buy_3","jp":"うん。それ、いいね。","fan":"嗯。那个，不错呢。","off":""},{"label":"minieventshop_buy_4","jp":"結果にもバリエーションがあったらいいんだけど。……現状で十分？そっか。","fan":"真希望结果也能有点变化呢。......现在这样就已经足够了？这样啊。","off":""},{"label":"minieventshop_buy_5","jp":"あんまりよく分からないけど、これが先生の役に立つといいな。","fan":"虽然不太明白，但希望这个能对老师有帮助就好了。","off":""},{"label":"minieventshop_login_1","jp":"ここは先生が集めてくれたものを……分析する場所。多分。","fan":"这里是分析老师收集来的东西的......场所。大概。","off":""},{"label":"minieventshop_login_2","jp":"サンプルが多いに越したことはないから。よろしくね。","fan":"样本当然是越多越好呢。拜托您了。","off":""},{"label":"minieventshop_login_3","jp":"いいところに来てくれたね。効率が大事って、先生も分かってくれた？","fan":"来得正好呢。老师也明白效率很重要了吧？","off":""},{"label":"minieventboxshop_1","jp":"ヒマリ部長がなにかを変えたみたい… 私としてはちょっと物足りないかも。 結果がハッキリしてる方が好きだし。","fan":"日鞠部长好像改变了些什么...我个人觉得可能有点不太满足。我更喜欢结果明确的方式。","off":""},{"label":"minieventboxshop_2","jp":"この方式、トキは気に入ってるんだって。 ……顔に出ないだけで、 トキって大抵のことはなんでも楽しむタイプだよね。","fan":"听说时很喜欢这种方式。......虽然不表露在脸上，但时她基本上是无论什么事都能乐在其中的类型呢。","off":""},{"label":"minieventboxshop_3","jp":"方法論……にはあまり詳しくないけど、 何かが変わったってことは、わかるよ。","fan":"方法论...我不太懂，但我明白有些事情确实发生了变化。","off":""},{"label":"minieventboxshop_4","jp":"ハズレを引いたら、先生をおいていっちゃうかも？ ……今のは冗談。運がよくても悪くても、私は先生の隣にいるよ。","fan":"要是抽到了\"空签\"，我说不定会把老师丢下自己走掉哦？......刚才那是玩笑。无论运气好坏，我都会待在老师身边的。","off":""},{"label":"minieventboxshop_5","jp":"結果が気に入らなかったら、私に言って。 慰めてあげる。","fan":"要是对结果不满意的话，就跟我说吧。我会安慰您的。","off":""},{"label":"minieventboxshop_300","jp":"先生と私たちの努力で得られた結果、だね。 おめでとう、先生。乾杯でもする？","fan":"这是依靠老师和我们的努力得到的结果呢。恭喜您，老师。要干杯庆祝一下吗？","off":""},{"label":"minieventboxshop_login_1","jp":"ここからは、サンプルの調べ方をちょっと変えてみるね。","fan":"从这里开始，我们要稍微改变一下调查样本的方式了哦。","off":""},{"label":"minieventboxshop_login_2","jp":"運を試せる場所……なんだって。 不確かなのは、未来だけでいいのにね","fan":"据说是个能测试运气的地方......要是只有未来是无法确定的该多好。","off":""},{"label":"minieventboxshop_login_3","jp":"先生の運にかけてみよっか。 じゃあ、私の分もよろしくね。","fan":"我们来赌赌老师的运气吧。那么，我那份也拜托您了。","off":""},{"label":"minieventboxshop_spbuy_1","jp":"当たりだね。おめでとう、先生。","fan":"中奖了呢。恭喜您，老师。","off":""},{"label":"minieventboxshop_spbuy_2","jp":"大当たりって、本当にあったんだ……。","fan":"大奖，原来真的存在啊......","off":""},{"label":"minieventboxshop_spbuy_3","jp":"驚いた……先生は本当に運がいいんだね。","fan":"真令人惊讶......老师的运气真的很好呢。","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/660196.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2025/7/3/108105.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/83476.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/408826.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2025/7/3/828608.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/536053.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/867506.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2025/7/3/941200.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/341317.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/608756.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_