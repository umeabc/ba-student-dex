":["Lv1","Lv30","Lv40","Lv50","Lv60"],"rows":[{"label":"攻击力","values":["73","266","332","339","465"]},{"label":"生命值","values":["1291","4694","5868","7041","8216"]},{"label":"治愈力","values":["180","653","817","980","1143"]}]},"skill":{"name":"骑士团的意志+","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_85/h_85/829/86082/2025/5/11/677354.png","description":"","levels":[{"lv":1,"text":"防御力增加200，生命值增加14%"},{"lv":2,"text":"防御力增加210，生命值增加14.7%"},{"lv":3,"text":"防御力增加220，生命值增加15.4%"},{"lv":4,"text":"防御力增加260，生命值增加18.2%"},{"lv":5,"text":"防御力增加270，生命值增加18.9%"},{"lv":6,"text":"防御力增加280，生命值增加19.6%"},{"lv":7,"text":"防御力增加320，生命值增加22.4%"},{"lv":8,"text":"防御力增加330，生命值增加23.1%"},{"lv":9,"text":"防御力增加340，生命值增加23.8%"},{"lv":10,"text":"防御力增加380，生命值增加26.6%"}]},"star3":"屋外战适应性强化至SS","star3Icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/673843.png","star4":"爆炸克制率增加10%"},"favoriteItem":{"icon":"","name":"","desc":"","t1":"","t2mats":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"蒼森 ミネ","kana":"蒼森 あおもり","twName":"美祢","cnName":"美祢","age":"17岁","birthday":"11月23日","height":"168cm","hobby":"收集医疗用品","designer":"-","artist":"ni02","cv":"日 | 堀江由衣\n中 | 菊花花\n韩 | 안영미（安荣美）","hallLevel":"6","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"我时刻准备着","bio":"三一综合学园所属，救护骑士团的团长。虽然她意志坚定又正直，但也是有着过激的一面的白衣战士。\n貌似整个圣三一都在流传着「美祢进行破坏，骑士团进行治疗」这样的关于救护骑士团的传闻。即使这样，她也有着通过整理自己的装备、邀请知己开办茶会这些事情治愈心灵的一面。另外，她对红茶的造诣也很深，能与委员会的莲见所匹敌。","sourceUrl":""},"giftTiers":[{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/11/77773.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/589993.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/618478.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/128643.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/11/77773.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/589993.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/618478.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/128643.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/845565.png","name":"小鸡造型巧克力","desc":"美祢在情人节赠送的可爱巧克力。虽然似乎只是医疗用品，包装却十分高级而美丽。"},"ability":{"attrs":[{"name":"生命值","value":"2062"},{"name":"攻击力","value":"76"},{"name":"治愈力","value":"214"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/999325.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/512012.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 美弥（偶像）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_707/h_708/829/86082/2025/5/11/816365.png","url":"https://www.gamekee.com/ba/68785.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！","fan":"碧蓝档案！","off":"Blue Archive."},{"label":"卡池抽取","jp":"救護騎士団団長、蒼森ミネと申します。\n救護が必要な方はどちらでしょうか？","fan":"救护骑士团团长，苍森美祢。\n请问需要救护的是哪一位呢？","off":"我是救护骑士团的团长，苍森美祢。\n需要救护的人在哪里？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそお越しくださいました、先生。\n本日もキヴォトスの平和のため、共に励みましょう。","fan":"欢迎，老师。\n为了今天基沃托斯也一如既往的和平，我们共同努力吧。","off":"老师，欢迎光临，今天也一起为了基沃托斯的和平努力吧。"},{"label":"登陆2","jp":"先生、今日は何かあったのですか？\nいえ、待つのは慣れていますので、お気になさらず。","fan":"老师，今天发生什么事了吗？\n没什么，我已经习惯了等待，所以您不用放在心上。","off":"老师，今天有什么事吗？没关系，我早已习惯等待了，您不用担心。"},{"label":"大厅1","jp":"どうかなさいましたか？私の手が必要でしたら、いつでもお呼びください。","fan":"有何贵干吗？如果需要我的帮助的话，请随时叫我。","off":"有什么事吗？如果需要帮助的话，请随时叫我。"},{"label":"大厅2","jp":"今日も忙しそうですね…何かお手伝いさせてください。","fan":"今天似乎也很忙呢...请让我帮您一点什么吧。","off":"今天您似乎也很忙呢，有什么我帮得上忙的事情吗？"},{"label":"大厅3","jp":"お疲れの時はいつでもおっしゃってください。\n紅茶にお茶菓子、膝枕…私に出来ることでしたら、何なりと。","fan":"如果您累了的话，请随时和我说。\n红茶配茶点心、膝枕...只要是我能做的，无论什么都可以。","off":"如果您累了，请随时告诉我。\n红茶。点心。膝枕，凡是我做得到的，您都可以提。"},{"label":"大厅4","jp":"救護騎士団の出番など、ないに越したことはありません。\nそんな穏やかな日々が続きますように。","fan":"救护骑士团的出场什么的，希望不需要才好\n希望这样安稳的日子能够继续下去。","off":"救护骑士团没有用武之地才是好事，希望这样和平的日子能够继续下去。"},{"label":"大厅5","jp":"救護騎士団の建物も悪くありませんが、こちらもなかなか素敵ですね。\nいっそのこと、支部を移転するというのも…\nあ、いえ。独り言ですのでお構いなく。","fan":"虽然救护骑士团的建筑也不错，但这里的也很漂亮呢。\n干脆迁移支部…\n啊，不。我是自言自语，请别放在心上。","off":"虽然救护骑士团那边也不错，但这边也很漂亮，要不然干脆把分部搬过来。\n不，没什么，我只是自言自语，请不要在意。"},{"label":"回忆大厅1","jp":"先生、大丈夫ですか？\nお怪我などはありませんか？","fan":"老师，您没事吧？\n没有受伤吧？","off":"老师，您还好吗？有没有受伤？"},{"label":"回忆大厅2","jp":"夜の空気は気持ちが良いですね…。\n草の香りに、川のせせらぎ…心が落ち着きます。","fan":"晚上的空气很舒服呢…。\n青草的香味，河流的潺潺流水…心情平静下来。","off":"夜晚的空气真让人心情舒畅呢。青草的芬芳，潺潺的水声，让心灵都平静下来了。"},{"label":"回忆大厅3","jp":"…どうされましたか？\n眩しい…ですか…？","fan":"……您怎么了？\n有些耀眼吗…？","off":"您怎么了？\n是觉得太耀眼了吗？"},{"label":"回忆大厅4","jp":"ふふ、確かにそうかもしれませんね。","fan":"呵呵，可能确实是这样呢。","off":"也许确实会。"},{"label":"回忆大厅5","jp":"落ち着かないようでしたら、私にもたれたり膝でお休みいただいても構いませんよ。ご心配なさらないでください。\nたとえ何があっても、私が必ず先生をお守りしますので。","fan":"如果心情不能平复下来的话，靠在我身上或者膝盖休息也没关系。请不要担心。\n不管发生什么，我一定会保护老师的。","off":"如果放心不下，您可以靠着我，或者躺到我的腿上休息一会儿。\n请不要担心，无论发生什么，我都会守护好老师的。"},{"label":"咖啡馆1","jp":"救護が必要な方は…いらっしゃいませんか？","fan":"有…需要救护的人吗？","off":"这里有没有需要救护的人呢？"},{"label":"咖啡馆2","jp":"ここは…気持ちが安らぎますね。","fan":"这里…让人心情很平静呢。","off":"这个地方真让人放松啊。"},{"label":"咖啡馆3","jp":"ここでお茶会を開くのはどうでしょう？","fan":"在这里开茶会怎么样？","off":"在这里办场茶会怎么样？"},{"label":"咖啡馆4","jp":"誰にでも休息は必要です。もちろん、救護騎士団にも。","fan":"无论是谁都需要休息。当然，救护骑士团也是。","off":"无论是谁，都需要好好休息，救护骑士团也不例外。"},{"label":"咖啡馆5","jp":"健康と美容のために、食後に一杯の紅茶を。","fan":"为了健康和养颜，饭后喝一杯红茶。","off":"饭后一杯茶，健康又美丽。"}],"好感度":[{"label":"好感度1","jp":"あまり慣れない感情ですね。ふわふわとしていて、胸が温かくなるような…くすぐったい気分です。","fan":"有些陌生的心情...柔软的、让心底温热的...痒痒的感觉。","off":"这种心情有些陌生，又柔和又温暖，还有些痒痒的。"},{"label":"好感度2","jp":"お気づきでしょうか。先生が私を少しずつ変えているのだと","fan":"您注意到了吗。因为老师我稍微改变了一些","off":"您发现了吗？老师，您正在一点点改变我。"},{"label":"好感度3","jp":"私が何かお力になれたか…","fan":"我能成为谁的力量吗...","off":"有什么我能帮上忙的吗？"},{"label":"好感度4","jp":"先生はいつも返しきれないほどのものを私に与えるんですから。困ったお方です。本当に、ふふ…","fan":"老师总是给我各种东西，让我回也回不过来。真是麻烦呢。真是的，呵呵...","off":"老师总是给予我这么多，让我难以为报，您真的让我很为难呢。"}],"战斗":[{"label":"编入队伍1","jp":"かしこまりました。参りましょう。","fan":"我明白了。出发吧。","off":"好的，我们出发。"},{"label":"编入队伍2","jp":"救護騎士団の出番ですね。","fan":"到了救护骑士团出场的时候了呢。","off":"轮到救护骑士团出场了。"},{"label":"拎起","jp":"な、何が起きているのでしょうか。","fan":"发、发生什么了吗。","off":"有有情况吗？"},{"label":"任命队长1","jp":"お任せを。私が先頭に立ちます。","fan":"交给我吧。我打头阵。","off":"我来打头阵，交给我吧。"},{"label":"任命队长2","jp":"すべての人々に恵みを。","fan":"愿赐予所有人恩惠。","off":"为所有人献上祝福。"},{"label":"普通技能","jp":"全力で参ります！","fan":"全力以赴。","off":"我将全力以赴！"},{"label":"EX动画1","jp":"参ります！","fan":"我上了！","off":"我上了。"},{"label":"EX动画2","jp":"そちらですね。","fan":"在那边呢。","off":"原来在那里。"},{"label":"EX动画3","jp":"下がってください！","fan":"请退后！","off":"大家请退后。"},{"label":"EX技能1","jp":"戦場に救護の手を！","fan":"向战场伸出救援之手！","off":"向战场伸出救援之手。"},{"label":"EX技能2","jp":"誇りと信念を、胸に刻み！","fan":"骄傲与信念，铭刻于心！","off":"心怀信念和荣耀。"},{"label":"EX技能3","jp":"最後の、その瞬間まで！","fan":"直至最后一刻！","off":"战斗到最后一刻。"},{"label":"战斗开始1","jp":"私が前に出ますので、背中をお願いします。","fan":"我会冲在前面，后背就拜托了。","off":"我会冲在前面，掩护就交给你们了。"},{"label":"战斗开始2","jp":"救護騎士団、参ります！","fan":"救护骑士团，参上！","off":"救护骑士团出发。"},{"label":"获得BUFF","jp":"ありがとうございます。","fan":"非常感谢。","off":"非常感谢。"},{"label":"施放BUFF","jp":"まだです。","fan":"还没结束。","off":"还没结束。"},{"label":"被CC1","jp":"-","fan":"-","off":"-"},{"label":"被CC2","jp":"そんな…","fan":"怎么这样...","off":"竟然——"},{"label":"被CC3","jp":"この程度！","fan":"就这点程度！","off":"这点小伤。"},{"label":"回避","jp":"無力化します！","fan":"让你白费力气！","off":"对我不管用。"},{"label":"队伍移动1","jp":"進みましょう。","fan":"继续前进。","off":"继续前进。"},{"label":"队伍移动2","jp":"移動します。","fan":"进行移动。","off":"开始移动。"},{"label":"回复","jp":"ありがとうございます。楽になりました。","fan":"非常感谢。我轻松多了。","off":"非常感谢，我好多了。"},{"label":"中途退出","jp":"少々…苦しいですね…。","fan":"有点…痛苦啊…","off":"有点不好受。"},{"label":"战斗喊叫","jp":"はぁ！","fan":"哈！","off":"-"},{"label":"战斗喊叫","jp":"やぁ！","fan":"呀！","off":"-"},{"label":"战斗喊叫","jp":"は！や！","fan":"哈！呀","off":"-"},{"label":"角色移动","jp":"次はどちらでしょうか。","fan":"下一处地点在哪里。","off":"接下来去哪儿？"},{"label":"战斗胜利1","jp":"無事に、救護が完了しました。","fan":"救援顺利完成。","off":"救护顺利完成。"},{"label":"战斗胜利2","jp":"私たちの勝利です。したし、油断は禁物ですよ。","fan":"属于我们的胜利。但是，也不能放松警惕。","off":"我们胜利了，但千万不能掉以轻心。"},{"label":"关卡完成1","jp":"皆さん、お怪我はありませんか？","fan":"大家没受伤吧？","off":"诸位都没受伤吧。"},{"label":"关卡完成2","jp":"救護が必要な方を、誰一人逃さない。当然のことです。","fan":"需要救护的人，一个都不能放过。这是当然的事！","off":"我们不会漏掉任何一个需要救护的人，这是理所应当的。"},{"label":"战斗失败1","jp":"まさかこのような…。申し訳ありません。私が力不足なばかりに…","fan":"竟然输了...。非常抱歉。是我不中用...","off":"没想到竟然会输，非常抱歉，都怪我实力不足。"},{"label":"战斗失败2","jp":"あまりご自身を責めないでください。きっと大丈夫ですから。","fan":"请不要太责怪自己。因为一定会好起来的。","off":"请不要太自责，一定不会有事的。"}],"成长":[{"label":"升级1","jp":"私に…どうしてここまで","fan":"为什么...要对我这么好","off":"您为什么如此厚待我？"},{"label":"升级2","jp":"ありがとうございます、先生。","fan":"谢谢您，老师。","off":"老师，谢谢您。"},{"label":"升级3","jp":"ふふ。私が救護受けることになってしまいましたね。","fan":"呵呵。我也成为被救护的对象了呢。","off":"没想到我也得到了救护呢。"},{"label":"升级4","jp":"よろしければ今度お茶でもいかがですか？何かお礼がしたいのです。","fan":"方便的话今天来喝杯茶吧？我想多少报答您一些。","off":"方便的话，下次一起喝杯茶怎么样？我也想报答你。"},{"label":"获得专武","jp":"お気遣いくださりありがとうございます。\n…私の全てを賭して、先生のお力となりましょう。","fan":"谢谢您的关心。\n……赌上我的全部，成为老师的力量吧。","off":"感谢您的关照，我愿用我的一切成为老师的力量。"}],"事件":[{"label":"学生生日","jp":"…覚えていてくださったのですね。\nありがとうございます…とても、うれしいです。\nでは…今日は少しだけ甘えさせていただいても、よろしいでしょうか？ふふ。","fan":"……你还记得呢。\n非常谢谢…我很高兴。\n那么…今天稍微让我撒娇一下，可以吗？呵呵。","off":"原来您还记得呢？谢谢，我真的很开心。\n今天让我稍微撒撒娇也可以吧。"},{"label":"老师生日","jp":"先生、お誕生日おめでとうございます。\n様々な怪我に対応できる救急箱をご用意したのですが、いかがでしょう…？\n…お気持ちだけで十分？そう、ですか…","fan":"老师，祝您生日快乐。\n我为您准备了能应对各种各样的伤的急救箱，怎么样…？\n……“有你这份心意就够了\"？这样啊…","off":"老师，祝您生日快乐，我准备了可以处理各种伤势的急救箱，您觉得怎么样？有这份心意就够了是吗？"},{"label":"万圣节","jp":"ハロウィーンの日になると「素敵な騎士のコスプレですね」と言われるのです。\n私にとっては普段着なのですが…毎年、無念でなりません。","fan":"到了万圣节，就会被人说“真是很棒的骑士cosplay啊”。\n但对我来说只是平时穿的衣服……每年都很无语啊。","off":"每到万圣节都会有人对我说好棒的骑士cosplay啊。可对我来说，这只是日常的穿着，每年都让人无奈"},{"label":"新年","jp":"新年明けましておめでとうございます。\nさあ、先生…参りましょうか。\n今年も皆さんに救いの手を差し伸べるのです。","fan":"祝您新年快乐。\n好了，老师…我们走吧。\n今年也要向大家伸出救援之手。","off":"祝您新年快乐。好了，老师，我们出发吧，今年我也会向大家伸出救护之手。"},{"label":"圣诞节","jp":"クリスマスというのは、「感謝」を「分け合う」ための日と聞きます。\nその…先生、クリスマスプレゼントは何がよろしいですか？","fan":"听说圣诞节是为了“分享”“感谢”的日子。\n那个…老师，你想要什么圣诞礼物？","off":"听说圣诞节是分享和感恩的日子，那个老师您喜欢什么样的圣诞礼物呢？"},{"label":"春节","jp":"","fan":"老师，祝您新春快乐。新的一年里，让我们共同努力，把救护带到整个基沃托斯。","off":"老师，祝您新春快乐。新的一年里，让我们共同努力，把救护带到整个基沃托斯。"},{"label":"中秋","jp":"","fan":"走吧，老师让我们出发。什么？您说今天可是中秋节，越是这种阖家团圆的节日，我们就越该保证大家的平安。不过如果老师愿意，等巡逻结束后，我们可以一起去赏月。","off":"走吧，老师让我们出发。什么？您说今天可是中秋节，越是这种阖家团圆的节日，我们就越该保证大家的平安。不过如果老师愿意，等巡逻结束后，我们可以一起去赏月。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/667206.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/738079.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/312439.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/832074.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/792769.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/748471.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/107932.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/838279.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/730676.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/24668.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/128845.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/760155.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/463579.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/401886.ogg","https://cdnimg-v2.gamekee.com/wiki2