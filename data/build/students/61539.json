ges/w_146/h_116/829/103682/2025/5/13/568618.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/13/507952.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/13/93925.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"728"},{"name":"攻击力","value":"94"},{"name":"治愈力","value":"237"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/321705.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/583583.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 纱绫","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/846644.png","url":"https://www.gamekee.com/ba/68521.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"blue archive"},{"label":"卡池抽取","jp":"なんなのだ、せっかくの休日だったのに……\nま、先生の呼び出しなら仕方ないのだ","fan":"什么嘛，难得的休息日……\n算了，老师叫我出来的话就没办法了呢。","off":"搞什么，难得休息一次。不过既然是老师叫我出来的那就没办法了。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ふう、ふう……あ、あれ？来てたのだ？\n……これ、一緒に食べる？","fan":"呼呼……欸，啊咧？来了啊？\n……这个，要一起吃吗？","off":"你来了，一起吃吗"},{"label":"登陆2","jp":"待ってたのだ！！\n全く、ぼく様を待たせるなんて……\n罰として今度実験に付き合うように！\nふっふっふっふっ……！","fan":"我在等你呢！\n真是的，居然让本大爷等着……\n作为惩罚这次要陪我做实验！\n呼呼呼呼……！","off":"我等你很久了，居然让小爷我等你，就罚你配合实验好了，哼哼哼。"},{"label":"大厅1","jp":"うむ、刀削麵のこのモチっとした食感はやはり、いつ食べても美味しい……\nこの世における真理の一つなのだ。","fan":"唔姆，刀削面这筋道的口感，无论什么时候吃都很美味呢……\n这就是世上唯一的真理。","off":"啊，刀削面还是得筋道点才好吃，这可是颠扑不破的真理。"},{"label":"大厅2","jp":"なに、ぼく様が普通の食べ物を食べるのがおかしいのか？\nそんな、ぼく様はネズ助じゃないし！","fan":"什么。本大爷吃正常的食物很奇怪吗？\n什么啊，本大爷又不是鼠助！","off":"干嘛？小爷我吃点普通的东西有这么奇怪吗？我又不是鼠鼠。"},{"label":"大厅3","jp":"ぼく様に似合ってて素敵な服……？\nうーはっはっはっ！\nそりゃあもちろん、ぼく様は何を着ても似合うのだ！","fan":"超级适合本大爷的帅气服装……？\n哇哈哈哈！\n那是当然，本大爷穿什么都好看！","off":"这件衣服很适合我，哈哈哈，那是当然小爷我穿什么都好看。"},{"label":"大厅4","jp":"インスピレーションは研究室の外でもいっぱいもらえるからな。\nキンをからかう時とか、メイをいじめる時とか……。","fan":"在研究室外也可以获得很多灵感呐。\n捉弄金的时候，欺负梅的时候……","off":"在研究室外面也能找到很多灵感，比如说动一下金，或者折腾一下梅。"},{"label":"大厅5","jp":"うん……？漏れてる？何が？","fan":"唔……？漏出来了？什么漏出来了","off":"是不是有什么东西漏了？"},{"label":"回忆大厅1","jp":"ふふ……なるほど、これは中々すごい匂いなのだ……。\n確かにこのまま食べるのは難しそうだし……。","fan":"呵呵……原来如此，这里面有很厉害的味道……\n确实就这样吃的话很难下咽呢……","off":"呵呵，嗯，这味道真的很冲啊。\n直接吃下去确实有点困难。"},{"label":"回忆大厅2","jp":"じゃあ、まず匂いを消すために消臭剤を1さじ……。\nあとは嗅覚を鈍らせるために、からしの粉を2さじ……。","fan":"那么，首先为了消除味道，要来一勺除臭剂……。\n然后为了使嗅觉迟钝，加入2勺芥末粉……。","off":"为了去除异味，先撒一点除臭剂。\n然后要让嗅觉变迟钝，再撒一点芥末粉。"},{"label":"回忆大厅3","jp":"美味しくなあれ～なのだ～。","fan":"变美味～了呐~","off":"就这样改，变美味吧。"},{"label":"回忆大厅4","jp":"あ、あれっ？間違えて、からし粉を入れすぎてしまったのだ！","fan":"啊，啊咧？搞错了，芥末粉放多了！","off":"一不小心，芥末粉加多了。"},{"label":"回忆大厅5","jp":"まあ、気にするほどのことでも無いのだ。\n代わりに消臭剤をもう少し入れれば、多分大丈夫！","fan":"嗯，也不是什么值得在意的事情。\n再加入一些除臭剂，大概就没问题了！","off":"算了，应该没关系。\n再放点除臭剂中和一下就好了。"},{"label":"咖啡馆1","jp":"ほら、怖がらなくて良いんだぞ、ネズ助。","fan":"你看，不用害怕哦，鼠助。","off":"鼠鼠乖别怕。"},{"label":"咖啡馆2","jp":"おほ～、これはかなり……。","fan":"哦嚯~这真是……","off":"这还挺不错的。"},{"label":"咖啡馆3","jp":"チーズ味の飲み物はないのか？","fan":"没有芝士味的饮料吗？","off":"有没有奶酪味的饮料？"},{"label":"咖啡馆4","jp":"休日を過ごすのにはいい場所なのだ。","fan":"休息日来这里很适合呢。","off":"这地方挺适合度假的。"},{"label":"咖啡馆5","jp":"これ、実験には使えないのかな？","fan":"这个，能用来做实验吗？","off":"这个能不能拿去做实验呢？"}],"好感度":[{"label":"好感度1","jp":"さすが先生なのだ～！","fan":"不愧是老师呐~！","off":"不愧是老师。"},{"label":"好感度2","jp":"フヒヒ…ハッ？い、いや、ぼく様はこんな間抜けな笑い方はしない！うーはっはっはっー！","fan":"嘻嘻嘻…哈？本大爷才不会笑得这么傻！哇—哈哈哈—！","off":"不对，刚才笑错了，重来。"},{"label":"好感度3","jp":"先生を見ているとこみ上げるこの複雑な気持ちは何なのだ？本当に困った難題なのだ……。","fan":"看着老师就涌上心头的这种复杂的心情是什么？真的是很困扰的难题……","off":"怎么回事？为什么一看着老师心里就会浮现一种复杂的感情？到底是什么感情啊"},{"label":"好感度4","jp":"チーズか先生かでどっちかを選べと言うなら……。う～ん……両方選べる方法はないのか……？","fan":"如果说非要在芝士和老师之间做选择的话……。唔……不可以两个都选吗……？","off":"如果让我在老师和奶酪中选一个？\n就没办法两者兼得吗？"}],"战斗":[{"label":"编入队伍1","jp":"ようやくぼく様の出番か","fan":"终于到本大爷登场了吗","off":"终于轮到小爷我出场了。"},{"label":"编入队伍2","jp":"ぼく様のかっこいい活躍、期待してるといいのだ","fan":"本大爷的帅气发挥，请期待吧","off":"好好期待小爷我大展身手吧。"},{"label":"拎起","jp":"なに？ぼく様に何か問題でも？","fan":"什么？有什么要问本大爷的吗？","off":"怎么，有什么问题想问小爷我吗？"},{"label":"普通技能","jp":"これに耐えられるものなら耐えてみるのだ！","fan":"如果能忍受这个的话，就试着忍耐一下吧！","off":"能忍就忍着吧。"},{"label":"EX动画1","jp":"イヤッホォー！","fan":"呀ー嚯ー！","off":"呀哈。"},{"label":"EX动画2","jp":"思いっきり楽しむのだ！","fan":"尽情享受吧！","off":"尽情享受吧。"},{"label":"EX动画3","jp":"もっともっと速く","fan":"更快更快！","off":"再快点。再快点。"},{"label":"EX技能1","jp":"さあ、プレゼントなのだ！","fan":"来，给你个礼物！","off":"来吧，这是礼物。"},{"label":"EX技能2","jp":"ふっふ、これでもくらえ！","fan":"呼呼，接下这招！","off":"给你这个。"},{"label":"EX技能3","jp":"くらうのだ！","fan":"吃我这招！","off":"接下这招。"},{"label":"战斗开始1","jp":"秘蔵の武器を見せるときなのか","fan":"到了让你见识下秘密武器的时候了吗","off":"该让你们看看秘密武器啦。"},{"label":"战斗开始2","jp":"準備はできてるなぁ！ネズ助","fan":"准备完成了呐！鼠助","off":"准备好了吗？鼠鼠。"},{"label":"战斗胜利1","jp":"やっぱり予想した通りのたのだ","fan":"果然按预想那样完成了","off":"不出所料。"},{"label":"战斗胜利2","jp":"うははは！まさにこれだ！","fan":"哇哈哈哈！不愧是我！","off":"哈哈，就是这个。"}],"成长":[{"label":"升级1","jp":"こんなに強力な物を持ってくるとは……先生もなかなかやるのだ！","fan":"能搞来这么强力的东西……老师也很厉害嘛","off":"牛啊，老师，这种好东西你也搞得到。"},{"label":"升级2","jp":"う～ん、これはもの凄く強くなった気分なのだ！","fan":"唔~感觉变得超级强了呢！","off":"这是感觉变强了好多。"},{"label":"升级3","jp":"ふっふっふっ……ぼく様は現在進行形で成長してるのだ！","fan":"呼呼呼……本大爷正在以现在进行时成长中！","off":"小爷我成长的速度简直是肉眼可见。"},{"label":"升级4","jp":"これも新しい実験か？ふむ、悪くない！","fan":"这也是新实验？唔姆，不错嘛！","off":"这也是新实验吗？不错。"},{"label":"获得专武","jp":"ぼく様は研究だけでなく射撃の腕も天才なのだ！","fan":"本大爷不仅擅长研究，射击方面也是天才呐！","off":"小爷我不仅擅长研究，还精通射击，是个全能型人才。"}],"事件":[{"label":"学生生日","jp":"うう、不老不死の霊薬を作れないまま、また一つ歳を取ってしまったのだ……。\nうん？歳を取るのを気にしてるのかって？\nはは、まさか。シュン教官じゃあるまいし。","fan":"嗯，没能制作出长生不老的灵药，又老了一岁……。\n嗯？你在意上了年纪吗？\n哈哈，不会吧。又不是瞬教官。","off":"长生不老的灵药还没做出来，就又老了一岁……\n你说我太在意年龄了？\n怎么可能，我又不是瞬教官。"},{"label":"老师生日","jp":"お誕生日おめでとうなのだ、先生。\nプレゼントがない代わりに実験中の飲み物ならあるけど、飲んでみる？","fan":"生日快乐呐，老师。\n虽然没有礼物，但是有实验中的饮料，要喝吗？","off":"老师生日快乐啊，虽然没准备礼物，不过有个药正在做实验，你要试试吗？"},{"label":"万圣节","jp":"Trick or Treat！お菓子をくれないといたずらするのだ！\nもちろんお菓子をくれてもいたずらはするけどな、うーはっはっはっ！","fan":"Trick or Treat！不给零食就捣蛋！\n当然给我零食也会恶作剧的，哇——哈哈哈！","off":"今年我也能收到糖果了。"},{"label":"新年","jp":"先生と一緒に一年を始められるなんて……\nぼく様は今年も大吉に違いない！","fan":"竟然能和老师一起开始一年……\n我今年也一定是大吉！","off":"居然能跟老师一起开始新的一年，小爷我今年肯定也会吉星高照"},{"label":"圣诞节","jp":"先生、何か欲しい物はあるか？\n黄金は無いけど、手足が黄金の色に染まる薬ならあげられるぞ。ははは！","fan":"老师，有什么想要的东西吗？\n虽然没有黄金，但是可以给你手脚染上金黄色的药哦。哈哈哈！","off":"老师，你想要什么礼物呢？黄金我是没有，不过我可以送给你。能让手脚变成金黄色的药。"},{"label":"春节","jp":"","fan":"新春佳节就要和老师一起度过，小爷我接下来的一整年肯定都会顺顺利利的。","off":"新春佳节就要和老师一起度过，小爷我接下来的一整年肯定都会顺顺利利的。"},{"label":"中秋","jp":"","fan":"今天有好多人问小爷我能不能帮忙做月饼？\n哼炼丹房是制作灵药的地方，又不是糕饼作坊。\n不过如果是老师的话，倒也是可以一起烤月饼什么的。","off":"今天有好多人问小爷我能不能帮忙做月饼？\n哼炼丹房是制作灵药的地方，又不是糕饼作坊。\n不过如果是老师的话，倒也是可以一起烤月饼什么的。"}],"活动":[{"label":"活动登陆1","jp":"山海経高級中学校へようこそなのだ、先生！","fan":"欢迎来到山海经高级中学，老师！","off":"老师，欢迎你来山海经。"},{"label":"活动登陆2","jp":"ふっふっふ今日の約束はもちろん覚えてるよね、先生？","fan":"呵呵呵今天的约定当然记得吧，老师","off":"哼哼哼，老师，你该不会忘了今天有什么安排吧？"},{"label":"活动大厅1","jp":"シュン教官はどこに行ったのだ……？","fan":"瞬教官去哪里了……？","off":"瞬教官去哪儿了？"},{"label":"活动大厅2","jp":"ふっふっふ不老不死の霊薬を生み出せる日は近いのだ！","fan":"呵呵呵离制作出长生不死的灵药又近了一天！","off":"哼哼哼，很快就能做出长生不老药了"},{"label":"活动大厅3","jp":"おかしいのだ……「若返りの秘薬」に変なものは入れなかったはず……。","fan":"奇怪……“返老还童的秘药”里应该没有放奇怪的东西……。","off":"奇怪，回春秘药里也没加其他材料啊。"},{"label":"活动大厅4","jp":"……もしかして沸騰させてる時に、空中に舞っていたネズ助の毛が混ざったのだ！？","fan":"……莫非沸腾的时候，混进了空中飞舞的鼠助的毛！？","off":"难道是制作秘药的时候，鼠鼠的毛掉进去了？"},{"label":"活动事件1","jp":"この出張研究所はあくまで臨時のもの。\nだからもし欲しい材料があったら、早めに手に入れておくことをおススメするのだ","fan":"这个出差研究所毕竟是临时的。\n所以如果有想要的材料的话，建议早点拿到。","off":"驻外研究所只能临时营业，要是找到了不错的炼丹材料，可要抓紧来兑换啊"},{"label":"活动事件2","jp":"最近何だか、商会の雰囲気が怪しいのだ……\nこの出張研究所も、早めに畳んだ方が良いかもしれないな","fan":"最近总觉得商会的气氛很奇怪……\n这个出差研究所也早点叠起来比较好吧","off":"最近周边商会的气氛很不寻常，这个驻外研究所也得快点关门才行。"},{"label":"活动商店1","jp":"世の中に存在するほぼ全てのものは、錬丹術で生み出せるのだ","fan":"世上存在的几乎所有的东西，都是用炼丹术产生的！","off":"炼丹术可以制作出世界上存在的所有物质。"},{"label":"活动商店2","jp":"うーん……先生が言ってるその「青色の石」については、ぼく様もよく知らないのだ……","fan":"嗯……关于老师说的“青色石头”，本大爷也不太清楚……","off":"老师说的那个蓝色的石头，小爷我也不太清楚。"},{"label":"活动商店关闭","jp":"出張研究所、営業終了なのだ！\nあ、でも、もし残った材料とかがあれば、是非ぼく様に見せてほしい！","fan":"出差研究所，营业结束！\n啊，但是，如果还有剩下的材料的话，请一定要给我看看！","off":"驻外研究所停止营业了。不过如果还有剩下的材料，也可以拿给小爷我看看。"},{"label":"活动商店登陆1","jp":"ぼく様の出張研究所へようこそなのだ、先生！","fan":"欢迎来到本大爷的外派研究所，老师。","off":"欢迎来到小爷我的驻外研究所，老师。"},{"label":"活动商店登陆2","jp":"良い錬丹術の素材があったら、ぼく様が高く買い取るのだ！","fan":"如果有品质良好的炼丹术素材，本大爷愿意高价收购。","off":"如果有品质优良的炼丹材料，小爷我愿意高价收购。"},{"label":"活动商店购买1","jp":"悪くない選択だ！","fan":"不错的选择！","off":"选那个还不错。"},{"label":"活动商店购买2","jp":"ふふ、良い素材を集めてくれてありがとうなのだ","fan":"呵呵，谢谢你收集了不错的素材","off":"收集到了这么好的材料，谢了老师。"},{"label":"活动商店购买3","jp":"おお、素晴らしい選択なのだ！","fan":"哦哦，是个很棒的选择！","off":"明智的选择。"},{"label":"活动商店购买4","jp":"それは選ぶとは.....やっぱり先生は見る目があるのだ！ふふふ！","fan":"这个选择….果然老师有眼光啊！呵呵！","off":"选了那个，看来老师的眼光很不错，哼哼。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/195558.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/230817.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/6/665580.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/994445.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/176970.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/6/713936.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/97670.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/144036.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/6/182223.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/277975.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/890112.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/6/729032.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/317049.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/439998.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/6/906613.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/23/71815.ogg",