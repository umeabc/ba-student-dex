/5/13/290718.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/203360.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/426648.png","name":"細心包裝的巧克力","desc":"美咲准备的巧克力。从使用双色缎带细心制成的包装中，似乎能看见美咲隐藏的另一面"},"ability":{"attrs":[{"name":"生命值","value":"778"},{"name":"攻击力","value":"250"},{"name":"治愈力","value":"197"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/513779.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/602352.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 美咲（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/13/985684.png","url":"https://www.gamekee.com/ba/628806.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"……アリウススクワッドのミサキ。今は主のいない猟犬みたいなものだから……リードはあげる。好きに命令して。","fan":"……阿里乌斯战术小队的美咲。现在的我就如同丧家之犬……领导权交给你。随意吩咐。","off":"我是阿里乌斯战术小队的美咲。……也可以说是条没了主人的丧家犬。我的狗链在你手里，随你怎么命令吧。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"……ずっと待機してた。\nで、先生。今日の命令は何？","fan":"……一直在待命。\n那么，老师。今天的命令是什么？","off":"我一直在待命，老师。……那么，今天您有什么吩咐？"},{"label":"登陆2","jp":"何だか忙しそうだね。\nまあ、大人だからか。","fan":"总觉得老师很忙呢。\n这就是大人吗。","off":"你看起来很忙啊。……嗯，这就是大人吗？"},{"label":"大厅1","jp":"……何かあった？必要なら手伝うけど","fan":"……发生什么了吗？必要的话我会帮忙","off":"有什么事吗？我可以帮你。"},{"label":"大厅2","jp":"言われれば何だってする。何でも言って。","fan":"只要是老师说的我都会照做。所以不管是什么，请说。","off":"不管什么事情都行，有需要的就尽管说。"},{"label":"大厅3","jp":"必要とされるなら、何だって構わない。","fan":"如果老师需要的话，什么都没关系。","off":"如果需要帮忙，可以随时告诉我。"},{"label":"大厅4","jp":"雑談は、積極的にする方じゃない。\nそれが命令なら、まぁ、従うけど。","fan":"我不是喜欢闲聊的人。\n如果是命令的话，嘛，那就勉强说几句吧。","off":"我对闲聊并没多大兴趣。但如果那是命令……我会遵从的。"},{"label":"大厅5","jp":"私が、先生を楽しませられるようなタイプだと思う？","fan":"老师觉得我是能让你开心的类型吗？","off":"老师总不会觉得……我是个能让你开心的人吧。"},{"label":"回忆大厅1","jp":"……先生？帰ってきたんだ。何か、大事な忘れ物でも?","fan":"……老师？你回来了啊。是忘了什么重要的东西？","off":"老师……你回来啦……嗯……落下了什么重要的东西吗？"},{"label":"回忆大厅2","jp":"……私？私を、心配して……？","fan":"……我？担心，我吗……？","off":"我……你在……担心我……？"},{"label":"回忆大厅3","jp":"そんな、くだらないことまで気にするなんて…。暇なんだね、大人なのに。","fan":"竟然在意这种无聊的事情…。很闲啊，明明是大人。","off":"不会吧……竟然在这种小事上面花心思。身为一个大人，你还真闲呢。"},{"label":"回忆大厅4","jp":"この冷たくて騒がしい世の中も、私も。……どれだけ雨が降ったところで、洗い流されて綺麗にはならない。","fan":"无论是这这个冰冷而嘈杂的世界，抑或是我。……无论下多大的雨，都无法被洗刷干净。","off":"无论是这冰冷又嘈杂的世界，还是我……不管下多少雨……都不会……变得洁白无暇。"},{"label":"回忆大厅5","jp":"……そんなことないんだって。馬鹿みたいに、信じられたら……","fan":"你说没这回事。如果我能像个笨蛋一样，相信你的话就好了……","off":"如果我是个傻瓜就好了，这样我就能相信……一切并非如此。"},{"label":"咖啡馆1","jp":"少し騒がしいね。","fan":"稍微有点吵呢。","off":"有点吵啊……"},{"label":"咖啡馆2","jp":"……初めて見るものばっかり","fan":"……都是没见过的新鲜玩意","off":"都是第一次见到的东西。"},{"label":"咖啡馆3","jp":"……それ、楽しいの？","fan":"……这个，好玩吗？","off":"那个东西……好玩吗？"},{"label":"咖啡馆4","jp":"別に興味ない。","fan":"我没什么兴趣。","off":"我没兴趣。"},{"label":"咖啡馆5","jp":"…何をしてるの？","fan":"…在做什么？","off":"你在做什么？"}],"好感度":[{"label":"好感度1","jp":"なんだか興味があるみたいだけど……私のことは信じない方が良い……。","fan":"虽然好像对我有兴趣……但是不要相信我比较好……。","off":"你似乎对我有兴趣。……但最好别太相信我。"},{"label":"好感度2","jp":"うん。ありがとう","fan":"嗯。谢谢","off":"嗯，谢谢你。"},{"label":"好感度3","jp":"……少し、混乱してる。","fan":"……我稍微有点，混乱。","off":"我有点混乱……"},{"label":"好感度4","jp":"ともと拒否権はないし、好意はありがたく受け取っておく…。","fan":"本来就没有拒绝权，好意也感恩接受了…。","off":"从一开始我就没有拒绝的权利。多谢你的好意，我收下了。"}],"战斗":[{"label":"编入队伍1","jp":"役割は果たす。","fan":"发挥作用。","off":"我会尽到我的职责。"},{"label":"编入队伍2","jp":"命令？了解。","fan":"命令？了解。","off":"是命令吗？……知道了。"},{"label":"拎起","jp":"何？","fan":"干嘛？","off":"怎么了？"},{"label":"任命队长1","jp":"分かった。","fan":"我知道了。","off":"好吧。"},{"label":"任命队长2","jp":"じゃ、その通りにする。","fan":"那么，就按照这样去做吧。","off":"那我就按照你说的做了。"},{"label":"普通技能","jp":"少しは役に立つ。","fan":"发挥了点作用。","off":"多少能派上点用场。"},{"label":"EX动画1","jp":"全部無意味。","fan":"一切都无意义。","off":"全都没有意义。"},{"label":"EX动画2","jp":"意味なんてない。","fan":"毫无意义。","off":"没什么意义。"},{"label":"EX动画3","jp":"何もかも無駄。","fan":"一切皆是徒劳。","off":"凡事都是虚空。"},{"label":"EX技能1","jp":"塵は塵に帰るもの。","fan":"尘归尘土归土。","off":"尘归尘，土归土。"},{"label":"EX技能2","jp":"最初から分かってるのに","fan":"明明早就知道","off":"明明从一开始我就知道的……"},{"label":"EX技能3","jp":"これで分かった？","fan":"这下明白了吗？","off":"这下你懂了吗？"},{"label":"战斗开始1","jp":"お望み通りに","fan":"如您所愿","off":"如你所愿。"},{"label":"战斗开始2","jp":"交戦、開始","fan":"交战，开始","off":"开始交战。"},{"label":"获得BUFF","jp":"支援、確認。","fan":"支援，确认。","off":"支援，已收到。"},{"label":"施放BUFF","jp":"また戦える。","fan":"还能战斗。","off":"我还能继续战斗。"},{"label":"掩体","jp":"隠れる。","fan":"隐蔽。","off":"掩蔽。"},{"label":"被CC1","jp":"くっ","fan":"-","off":"咳……"},{"label":"被CC2","jp":"くぅっ","fan":"-","off":"……"},{"label":"被CC3","jp":"-","fan":"（受击音效）","off":"呃……啊……"},{"label":"回避","jp":"無駄だよ","fan":"没用的","off":"没用的。"},{"label":"队伍移动1","jp":"確保完了","fan":"确保完毕","off":"已占领目标地点。"},{"label":"队伍移动2","jp":"次のエリアへ","fan":"前往下一区域","off":"前往下个地区。"},{"label":"回复","jp":"救援を確認","fan":"救援确认","off":"确认收到支援。"},{"label":"中途退出","jp":"結局、こういうことになる","fan":"结果，还是到了这个局面","off":"最后，结果还是这样……"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"角色移动","jp":"-","fan":"-","off":"-"},{"label":"战斗胜利1","jp":"戦闘終了","fan":"战斗结束","off":"战斗结束。"},{"label":"战斗胜利2","jp":"勝ったよ。お望み通りに","fan":"赢了哦。如您所愿","off":"我们赢了，如你所愿。"},{"label":"关卡完成1","jp":"言われた通りにやった。それだけ","fan":"只是按照你说的做了。仅仅如此","off":"只是听命行事罢了。"},{"label":"关卡完成2","jp":"これに意味はあるの？","fan":"这有意义吗？","off":"这有什么意义吗？"},{"label":"战斗失败1","jp":"知ってた。こういう結末だって","fan":"早就知道，会是这种结局","off":"我就知道……最后会是这样的结果……"},{"label":"战斗失败2","jp":"大丈夫。慣れてるから","fan":"没事，习惯了","off":"没关系，我已经习惯了。"}],"成长":[{"label":"升级1","jp":"こんなことをする理由は何。","fan":"为什么要这样做。","off":"为什么要这么做？"},{"label":"升级2","jp":"理解ができない……これ、なんのために……","fan":"无法理解……到底是为什么……","off":"我不明白……这些……究竟是为了什么？"},{"label":"升级3","jp":"所詮捨て駒でしょ？いったい何を……","fan":"我终究还是弃子吧？所以到底是为什么……","off":"反正是要丢掉的弃子……到底是为什么？"},{"label":"升级4","jp":"あ……ありが、とう……","fan":"……谢谢……","off":"呃……谢谢……"},{"label":"获得专武","jp":"もうなんて理由が聞かないけど、私にわざわざこんなものを渡すなんて。私が知ってた世界に、あなたみたいな人はいなかった。……変な人\nこの力は、今は先生に託するよう","fan":"虽然不知道为什么，但特意给我这样的东西。在我所知的世界里，从来没有像老师这样的人。……奇怪的人。\n那这份力量，我要寄托给老师。","off":"虽然我不会再问你理由，但你竟然特意送我这种东西……在我认知的世界里，没有一个人会像你这样……真是个奇怪的人。那我的力量，暂时就交给老师吧。"}],"事件":[{"label":"学生生日","jp":"生まれた日を祝う意味は、今でもあんまりよく分からない。\nそもそも生まれなければ、死について考えることもなかったのに。\nまあ、これは、病気みたいなものなんだろうね。\nごめん、こういうことを言ったわけじゃなくて……その…ありがとう。","fan":"庆祝出生的日子的意义，我至今都不明白。\n如果原本没有出生的话，就不会考虑死亡的事。\n算了，好像说了病态的话呢。\n抱歉，本不该在今天说这样的话的......那个…谢谢你","off":"庆祝出生的日子有什么意义呢？如果当初没有出生，就不用为死亡感到悲伤了。"},{"label":"老师生日","jp":"私は、生まれた日を祝う意味を理解できなかった。\nでも……今は少しだけ感じる事がある。\n……あなたが、ここにいてくれてよかった。","fan":"从前我不能理解为什么要庆祝出生的日子。\n但是......如今好像有所感悟。\n......能在这世界遇到你真好。","off":"姑且我不能理解为什么要庆祝出生的日子，但是现在我有点理解了。……你，能在这里真是太好了。"},{"label":"万圣节","jp":"悪いけど、いたずら特に興味がないから。\nえっ？いたずらをしないなら、代わりに飴？それは…命令？","fan":"不好意思，我对恶作剧没什么兴趣。\n诶？不恶作剧的话，就收下糖果吧？这是…命令？","off":"什么……？不给糖……就捣蛋？这个……是命令吗？"},{"label":"新年","jp":"なんとか一年を終わらたね。今年はまた、どうなるのかわらかないけど","fan":"总算过完一年了呢。今年，又会变成这么样呢。","off":"一年又过去了。新的一年，还不知道会发生什么事呢。"},{"label":"圣诞节","jp":"ごめん、こういうお祝いには慣れてなくて、とにかく、いい雰囲気に未曾有さしたくないから、静かにしてるね","fan":"抱歉，我不太习惯这样庆祝的节日。总之，不想打扰这难得的好气氛，我会安安静静的。","off":"抱歉……我不太适应这样热闹的气氛，不过我也不想给它泼冷水。所以，我像这样在一旁安静待着就好。"},{"label":"春节","jp":"","fan":"新春……？我没兴趣，而且爆竹声很吵……要是今天下雨就好了。","off":"新春……？我没兴趣，而且爆竹声很吵……要是今天下雨就好了。"},{"label":"中秋","jp":"","fan":"团圆也没有意义吧，反正最后都会有人先离开……那样想太消极了……？好吧，既然你都这么说了，那我试着感受一下氛围吧。","off":"团圆也没有意义吧，反正最后都会有人先离开……那样想太消极了……？好吧，既然你都这么说了，那我试着感受一下氛围吧。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/23/289078.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/23/711298.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/23/110436.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/23/189451.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/23/807506.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/23/777094.ogg"],"大厅及咖啡