img-v2.gamekee.com/wiki2.0/images/w_47/h_54/829/157597/2025/5/11/49587.png"}],"uniqueWeapon":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_444/h_246/829/157597/2025/5/11/933385.png","name":"供餐部防身用枪typeA","desc":"枫香随身携带的冲锋枪。\n本来打算用它来压制食堂暴乱的问题儿童，但大多数时候不用它出场，对方就会老实下来。\n不怎么能用到它的样子。","table":{"cols":["Lv1","Lv30","Lv40","Lv50","Lv60"],"rows":[{"label":"攻击力","values":["152","210","262","314","367"]},{"label":"生命值","values":["499","1813","2266","2720","3173"]},{"label":"治愈力","values":["251","912","1140","1367","1596"]}]},"skill":{"name":"来收集新鲜的食材吧！+","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_85/h_85/829/157597/2025/5/11/704236.png","description":"","levels":[{"lv":1,"text":"治愈力增加948，治愈力增加14%"},{"lv":2,"text":"治愈力增加996，治愈力增加14.7%"},{"lv":3,"text":"治愈力增加1043，治愈力增加15.4%"},{"lv":4,"text":"治愈力增加1233，治愈力增加18.2%"},{"lv":5,"text":"治愈力增加1280，治愈力增加18.9%"},{"lv":6,"text":"治愈力增加1328，治愈力增加19.6%"},{"lv":7,"text":"治愈力增加1517，治愈力增加22.4%"},{"lv":8,"text":"治愈力增加1565，治愈力增加23.1%"},{"lv":9,"text":"治愈力增加1612，治愈力增加23.8%"},{"lv":10,"text":"治愈力增加1802，治愈力增加26.6%"}]},"star3":"屋内战适应性强化至B","star3Icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/157597/2025/5/11/790437.png","star4":"COST上限增加0.5"},"favoriteItem":{"icon":"","name":"","desc":"","t1":"","t2mats":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"爱清 フウカ","kana":"爱清 あいきよ","twName":"风华","cnName":"风香","age":"16岁","birthday":"4月30日","height":"159cm","hobby":"家庭料理、制作便当","designer":"-","artist":"ヌードル","cv":"日 | 菲鲁茲‧蓝\n中 | 宋媛媛\n韩 | 이주은（李珠恩）","hallLevel":"6","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"希望至少能过平静的一天 (T_T)","bio":"格黑娜学园所属，担任格黑娜学园餐厅的供餐部的部长。\n每天早上为学生们准备大量好吃的饭菜，是格黑娜学园里少见的温柔且认真的好学生。\n虽然做饭的手艺还算不错，但由于食堂人手不足，所以料理实力的评价正在下滑。但她并未就此放弃，为了提供更好的菜品而不断努力。","sourceUrl":""},"giftTiers":[{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","items":[]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/810281.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/640438.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":[]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/810281.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/640438.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/67283.png","name":"装着可可亚的马克杯","desc":"枫香为老师泡的可可亚。温暖而缱绻，就跟枫香温柔甜美的个性一样。因为注入了为老师的健康着想的心意，味道比实际上更香甜温暖。"},"ability":{"attrs":[{"name":"生命值","value":"868"},{"name":"攻击力","value":"158"},{"name":"治愈力","value":"332"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/523061.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/36111.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 枫香（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/11/13019.png","url":"https://www.gamekee.com/ba/579686.html"},{"name":"NPC 枫香（私服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/191981/2025/6/23/647982.png","url":"https://www.gamekee.com/ba/649439.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案。"},{"label":"卡池抽取","jp":"給食部のフウカです。\n食べたいものがあったら、いつでも仰ってください。","fan":"我是供食部的枫香。\n如果有想吃的东西的话，随时都可以告诉我。","off":"我是供餐部的枫香，有什么想吃的东西请随时吩咐。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お疲れ様です！\n温かい食事をご用意しましたけど、今召し上がりますか？","fan":"辛苦了！\n热腾腾的饭菜已经准备好了，现在就要开饭吗？","off":"辛苦了，我为您准备了热气腾腾的饭菜，您要现在就吃吗？"},{"label":"登陆2","jp":"先生、卵は半熟のままがいいですか？\nサニーサイドアップ？それとも卵焼き？","fan":"老师，鸡蛋要半熟的可以吗？\n单面的煎蛋？还是要全熟的呢？","off":"老师，您喜欢这样的半熟蛋呢还是太阳蛋？或者说，玉子烧？"},{"label":"大厅1","jp":"ご飯はちゃんと食べてますか？\n何か作りましょうか？","fan":"有好好按时吃饭吗？\n需要我给你做点什么吗？","off":"您有好好按时吃饭吗？要不要给您做点什么？"},{"label":"大厅2","jp":"皆のために料理を作るのは大変ですが、大丈夫です。","fan":"虽然要给大家准备饭菜很累，但是没关系。","off":"给大家做饭是很辛苦，不过没关系。"},{"label":"大厅3","jp":"あはは…。心配してくださるのですか？","fan":"啊哈哈...你是在担心我吗？","off":"哼哼哼，您这是在担心我吗？"},{"label":"大厅4","jp":"好きな食べ物、 気になります。 \nん？ 何でか、ですって？ 秘密です！","fan":"我想知道你喜欢吃什么。\n嗯？为什么要知道？\n这是秘密！","off":"我想知道，您到底喜欢吃什么样的食物，为什么想知道？这是秘密哦。"},{"label":"大厅5","jp":"うーん…。先生がもっと元気になるような料理、何が良いかな…。","fan":"嗯...有什么食物可以让老师更有精神一点呢...","off":"嗯，有没有什么好吃的能给老师补补身子呢？"},{"label":"回忆大厅1","jp":"こうなっていると思っていました…。\nまたインスタントばかり食べてましたね？","fan":"我就知道是这样。\n你又只吃速食食品了，对吧？","off":"我就知道会变成这个样子，您是不是又整天吃方便食品了呀？"},{"label":"回忆大厅2","jp":"ダメですよ、食事はちゃんと取らないと。","fan":"这样不行，一定要好好按时吃饭。","off":"这样可不行，饭一定要按时好好吃哦！"},{"label":"回忆大厅3","jp":"私がすぐ作りますから、ちょっと待っててください。","fan":"我马上帮你准备，你稍微等一会哦。","off":"我这就去给您好好做顿饭，请您在这里好好等一下。"},{"label":"回忆大厅4","jp":"もう、健康に気を付けないのは先生の悪い癖ですよ。","fan":"真是的，不注意健康是老师的坏习惯呢。","off":"老师，您一直这样不注意自己的健康可是不好的哦！"},{"label":"回忆大厅5","jp":"はい？ま、毎日私の作った料理が食べたい、ですか？\nあ、あはは…せ、先生さえよろしければ…。\nもちろん、私は構わないのですが…。","fan":"咦？你、你说让我每天给你准备料理吗？\n啊、哈哈...要是老师觉得可以的话...\n我当然是没关系的...","off":"嗯？您说您想每天都能够吃上我做的饭？额..只要老师愿意的话，我当然完全不会介意的.."},{"label":"咖啡馆1","jp":"スーパーに寄らなきゃかも…。","fan":"该去超市采购了...","off":"说不定还得去趟超市。"},{"label":"咖啡馆2","jp":"料理を始めましょうか。","fan":"开始做饭吧。","off":"那就开始做饭吧。"},{"label":"咖啡馆3","jp":"ここでも料理ができるかな？","fan":"在这里也可以做饭吗？","off":"这个地方能不能做饭呀？"},{"label":"咖啡馆4","jp":"今日の夕食は何にしよう…。","fan":"今天晚饭做什么好呢...","off":"今天的晚饭，做什么好呢？"},{"label":"咖啡馆5","jp":"このままじゃ、食材が足りないかも。","fan":"这样下去食材会不够用的。","off":"这样下去，食材就要不够了。"}],"好感度":[{"label":"好感度1","jp":"先生に美味しい料理を作って差し上げたいです。","fan":"想给老师做点好吃的料理呢。","off":"我想为老师，做些美味的料理。"},{"label":"好感度2","jp":"食事はちゃんと摂れてますか、先生？","fan":"老师，有在好好吃饭吗？","off":"老师，您有没有好好吃饭呀？"},{"label":"好感度3","jp":"どんな料理がお好きなのか、気になります。","fan":"好在意（老师）喜欢吃的是什么啊。","off":"我想知道，老师最喜欢吃什么？"},{"label":"好感度4","jp":"先生に、その…朝ごはんを作ってさしあげたいのですが…","fan":"老师，能不能...让我每天给你做早饭呢...","off":"我在想，可不可以..那个，给老师做早饭？"}],"战斗":[{"label":"编入队伍1","jp":"はい。","fan":"是。","off":"到。"},{"label":"编入队伍2","jp":"準備完了です。","fan":"准备齐全了。","off":"准备完毕。"},{"label":"拎起","jp":"お残しは許しませんよ！","fan":"不许剩饭哦！","off":""},{"label":"普通技能","jp":"食事の効果ですね！","fan":"是食物的效果呢！","off":"这就是用餐的效果哦！"},{"label":"EX动画1","jp":"よーし！","fan":"好！","off":"不错！"},{"label":"EX动画2","jp":"うんっ！完璧！","fan":"嗯！完美！","off":"嗯，完美！"},{"label":"EX动画3","jp":"これわ、すてきな出来！","fan":"这个是？做出好东西了！","off":"嗯，味道很棒！"},{"label":"EX技能1","jp":"栄養満点の料理です！","fan":"营养满分的料理！","off":"这道菜营养丰富哦！"},{"label":"EX技能2","jp":"食事の時間ですよ。","fan":"开饭啦！","off":"该吃饭啦！"},{"label":"EX技能3","jp":"おいしく召し上がれ。","fan":"请好好享用吧。","off":"尽情享用吧！"},{"label":"载具协同1","jp":"大変お待たせしました！給食部の配送者が到着しましたよ！","fan":"让您久等了！供给部的配送员来了！","off":"非常感谢您的耐心等待，后勤部的送货车已经到了！"},{"label":"载具协同2","jp":"お待たせしました！給食部の到着です！","fan":"久等了！供给部来了！","off":"让各位久等了，后勤部来了。"},{"label":"战斗开始1","jp":"給食部の支援、始めます。","fan":"供给部的支援开始了。","off":"供餐部，开始提供支援！"},{"label":"战斗开始2","jp":"準備できますだ。","fan":"做好准备了。","off":"我准备好了！"}],"成长":[{"label":"升级1","jp":"ありがとうございます、先生。","fan":"老师，谢谢你。","off":"老师，非常感谢您。"},{"label":"升级2","jp":"料理の実力もさらに上がったのでしょうか？","fan":"料理的水平也提高了吗？","off":"不知道烹饪水平是不是也提高了呢？"},{"label":"升级3","jp":"これでもう少しお役に立てるように。","fan":"这样就能稍微帮上点忙了。","off":"希望，能再多给您帮上一点忙。"},{"label":"升级4","jp":"え？私でいいのですか？","fan":"欸？我也可以吗？","off":"欸？把这些都给我，这样合适吗？"},{"label":"获得专武","jp":"あはは……こういった支援には慣れていませんが、\n先生のお役に立てるよう、最善を尽くします。","fan":"啊哈哈......虽然这样的支援我还不太习惯，\n但是为了老师，我会尽最大努力的。","off":"呵呵，我还真不习惯被这样支持，我会尽我所能帮助老师的。"}],"事件":[{"label":"学生生日","jp":"あれ…。私の誕生日ですか？\nあ、あはは…。いつも他の方のお誕生日ばかり気にしていたので…。\n…嬉しいです。ありがとうございます。","fan":"欸...今天是我的生日吗？\n啊哈哈......一直都是我在记着别人的生日呢...\n...谢谢你，我很开心。","off":"欸？我的生日？我平时尽是去注意别人的生日了，非常感谢您。"},{"label":"老师生日","jp":"先生。お誕生日おめでとうございます。\n今日みたいな日にはきっと、すごく特別なものを召し上がるかと思うのですが…。\nえっと、よ…よろしければ、私がお誕生日のお料理を作ってもいいでしょうか？","fan":"老师，祝你生日快乐。\n像今天这种日子，我想应该会做点特别的食物吧...\n那个...如果可以的话，能让我为你做生日料理吗？","off":"老师，祝您生日快乐，我想您在今天这样的日子，一定想吃一顿不同于往日的大餐，如果不介意的话，可以让我为您准备生日餐吗？"},{"label":"万圣节","jp":"カボチャのスープとか、カボチャパイとか、カボチャのグラタンとか、\n作れそうなものは全部作ってみようかと思いまして。\nハロウィーンですからね。先生はどんなのが好きですか？","fan":"南瓜汤啦，南瓜派啦，焗南瓜啦，\n我想把能做的都做一做。\n因为是万圣节呢。老师喜欢吃什么?","off":"南瓜汤呀、南瓜派呀、南瓜焗菜呀，能做的东西我全都想试着做一做，因为今天可是万圣节哦，老师，您喜欢什么样的饭菜呢？"},{"label":"新年","jp":"新しい一年が始まりますね！\nお雑煮を作ろうかと思うのですが、いかがでしょう？","fan":"新的一年开始了！\n我想煮年糕汤，怎么样?","off":"新的一年开始了，我在想要不要做一些年糕汤，老师您意向如何呢？"},{"label":"圣诞节","jp":"クリスマス…。\n特別な夕食を作ろうかと思っているのですが…。\nも、もちろん、先生がよろしければ！","fan":"圣诞节...\n我想做一次特别的晚餐...\n当，当然，如果老师方便的话！","off":"圣诞节..我在想要不要做一顿特殊的晚餐，当然，前提是老师觉得可以的话。"},{"label":"春节","jp":"","fan":"我准备了一桌年夜饭，\n不嫌弃的话，老师来尝尝吧。","off":"我准备了一桌年夜饭，\n不嫌弃的话，老师来尝尝吧。"},{"label":"中秋","jp":"","fan":"歌赫纳的大家会喜欢我做的月饼吗？\n哎？……您说您喜欢？真的是太好了。","off":"歌赫纳的大家会喜欢我做的月饼吗？\n哎？……您说您喜欢？真的是太好了。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/11/611397.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/663452.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/871095.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/11/219348.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/525356.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/538352.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/11/253842.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/865438.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/870655.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/11/44409.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/473027.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/598050.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/11/91990