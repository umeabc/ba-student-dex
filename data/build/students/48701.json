/w_252/h_204/829/72324/2025/5/5/428299.png","url":"https://www.gamekee.com/ba/89742.html"},{"name":"3★ 明日奈（制服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/5/271224.png","url":"https://www.gamekee.com/ba/645821.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案。"},{"label":"卡池抽取","jp":"ご主人様と一緒に！\n楽しい一日を始めちゃおう！","fan":"让我陪主人一起！\n开始愉快的一天吧！","off":"和主人一起，开始愉快的一天啦。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！いや、ご主人様！\nこんにちは！\n今日も一緒に頑張ろうね！","fan":"老师！啊不，主人！\n您好！\n今天也要一起加油哦！","off":"老师，不对，主人您好，今天也一起加油吧！"},{"label":"登陆2","jp":"どんなミッションでもどんと来いだよ！\n私とご主人様なら問題なし！","fan":"无论什么任务都请交给我吧！\n有我和主人在，一定没问题的！","off":"无论什么任务，都放马过来吧，只要我和主人搭档，就没问题。"},{"label":"大厅1","jp":"こんにちは！ご主人様！\n今日もせいいっぱい仕えてあげるね！","fan":"您好！主人！今天也会好好侍奉您的哦！","off":"您好主人，今天我也会努力侍奉你的。"},{"label":"大厅2","jp":"私に会いに来てくれたの？そうだよね？\nやっぱりご主人様は私のことが好きなんだね！","fan":"您是专程来看我的吧？是这样的吧？\n果然主人很爱我呢！","off":"你是来见我的吗，一定是吧，我就知道主人喜欢我。"},{"label":"大厅3","jp":"掃除と洗濯なら任せて！\n跡形も残さず片付けてあげる！","fan":"打扫和洗衣服就交给我吧！\n我会为您打扫得一尘不染的！","off":"打扫卫生和洗衣服的活就交给我吧，我会收拾的干干净净，不留一点痕迹。"},{"label":"大厅4","jp":"任務が入ってきたよ～\nさあさあ、ご主人様！\n早く解決しに行こう！","fan":"来任务了哦~\n好了好了，主人！\n快点去解决了吧！","off":"任务来啦，主人，我们快点去解决吧！"},{"label":"大厅5","jp":"休憩？そんなのいらない！\nそれより一緒に遊ぼう！","fan":"休息？那种事才不需要呢！\n相比起来还是一起来玩吧！","off":"休息？没必要，有那个时间不如一起玩啊。"},{"label":"回忆大厅1","jp":"…ふふっ、ご主人様に乗っかっちゃった！\nうん、身体も軽いし、今なら何でもできそう！","fan":"…呵呵，主人被骗了！\n嗯，现在身体很轻，感觉自己无所不能呢！","off":"哎呀，别这么盯着我看嘛。"},{"label":"回忆大厅2","jp":"うーん、何なんだろうなー、この感じ…\n…まあ良いか！じゃーん！\nいつものアスナちゃん、復活！","fan":"嗯，该怎么形容呢，这个感觉...\n...嘛算了！锵！\n和往常一样的明日奈，复活！","off":"嗯，其实我也会有害怕的时候。"},{"label":"回忆大厅3","jp":"これもご主人様のおかげだよ、\nありがとね！","fan":"这也是多亏了主人呢，谢谢哦！","off":"但是，我更害怕我的同伴受伤。"},{"label":"回忆大厅4","jp":"ふふっ。やっぱりこうしてご主人様の\nそばにいると、心が躍るなー。\n…なんだかちょっと、癖になっちゃいそう！","fan":"呵呵。果然这样子和主人呆在一起。心情都雀跃起来了。\n...怎么感觉，好像都要变成癖好了！","off":"所以不管什么时候，我都会站在最前面。"},{"label":"回忆大厅5","jp":"だからこれから時々こういう風に…ね？\nよろしく、私のご主人様！","fan":"所以说正式在这种时候才要这样...对吧？\n请多多关照，我的主人。","off":"主人也是，你只管跟在明日奈的身后就行啦，我一定会带你去充满快乐的地方。"},{"label":"咖啡馆1","jp":"らんらら～ん、今日はなんだか良いことがありそうな予感～。\nご主人様もそうでしょ？","fan":"啦啦啦~总觉得今天会发生什么好事~。\n主人也有这样的预感吗？","off":"啦啦啦，总感觉今天会发生什么好事呢？主人是不是也是这么觉得呢？"},{"label":"咖啡馆2","jp":"ご主人様、ようこそ～。私が元気づけてあげる！","fan":"主人，欢迎~我会帮你打起精神！","off":"主人，你来啦，我来帮你打起精神！"},{"label":"咖啡馆3","jp":"あっ！ご主人様だ！食事～？お風呂～？それとも…えへへ！","fan":"啊！是主人呀！您是要先吃饭~？还是先洗澡~？还是说…诶嘿嘿！","off":"啊，主人来啦，要吃饭，要洗澡，还是？嘿嘿嘿？"},{"label":"咖啡馆4","jp":"うーん…服がピッチピチ。太ったかな？それともまた…？","fan":"唔…这衣服紧紧的。是我胖了吗？难道说又…？","off":"嗯..衣服有点紧，难道是胖了？还是又.."},{"label":"咖啡馆5","jp":"暇だなぁ～何か漫画とかないかな～？","fan":"好闲呐~这里没有漫画什么的吗~？","off":"好无聊啊，有没有漫画书什么的?"},{"label":"咖啡馆6","jp":"るんるんるん～♪","fan":"啦啦啦～♪","off":"啦啦啦~"}],"好感度":[{"label":"好感度1","jp":"ご主人様は私に興味津々なんだね！","fan":"主人对我兴致盎然呢！","off":"哼，主人对我很感兴趣嘛~"},{"label":"好感度2","jp":"ご主人様が私のご奉仕を必要としてくれるなら、\nいつでも、どこでも、何でもするよ！","fan":"如果主人需要我的侍奉，无论何时何地，什么事都可以做哦！","off":"只要主人一声令下，我随时随地都能提供服务。"},{"label":"好感度3","jp":"ご主人様と一緒にいるの楽しい！これからも私と楽しく過ごそうね！","fan":"和主人在一起很开心！今后也要和我愉快地度过呢！","off":"和主人在一起可真开心啊，以后也要多和我一起玩哦！"},{"label":"好感度4","jp":"ご主人様、心配しないで。私はずっとご主人様のそばを離れないから！","fan":"主人，请别担心。因为我会一直陪在主人身边的！","off":"主人，不用担心，我永远都不会离开主人的。"}],"战斗":[{"label":"编入队伍1","jp":"アスナだよ！先生、よろしく！","fan":"这里是明日奈哦！主人，请多关照！","off":"明日奈报道，多关照啦老师。"},{"label":"编入队伍2","jp":"ふふっ！やっぱり私が必要なんだね！","fan":"呵呵！果然我是必要的呢！","off":"嗯哼，就知道不能没有我。"},{"label":"拎起","jp":"やっほー！まっかせてねー！","fan":"好耶！交给我吧！","off":"呀吼，交给我吧！"},{"label":"任命队长1","jp":"コールサインゼロワン、アスナ！いっくよー！","fan":"呼号01，明日奈！上了哦！","off":"呼号ZERO ONE 明日奈出动！"},{"label":"任命队长2","jp":"さぁ！それでは任務を始めてみようかなっと！","fan":"好了！该开始任务了！","off":"好，我们这就开始执行任务吧！"},{"label":"普通技能","jp":"覚悟しなさい！","fan":"请做好觉悟！","off":"脖子给我洗干净了！"},{"label":"EX动画1","jp":"アスナ、いっくよー！","fan":"明日奈，上了哦！","off":"明日奈，出击喽！"},{"label":"EX动画2","jp":"ふふっ！全っ然当たらないよ！","fan":"呵呵！完全打不中我呢！","off":"嗯哼，根本就打不中嘛！"},{"label":"EX动画3","jp":"イチかバチか、やってみようかな！","fan":"是骡子是马，拉出来遛遛吧！","off":"豁出去了，上吧！"},{"label":"EX技能1","jp":"誰にも私を止められない！","fan":"谁也无法阻止我！","off":"没人能挡的住我！"},{"label":"EX技能2","jp":"イッツ、ショウタイム！","fan":"It‘s Showtime！","off":"It's show time!"},{"label":"EX技能3","jp":"アスナ、ここに参上！","fan":"明日奈，在此参上！","off":"我明日奈就来会会你！"},{"label":"战斗开始1","jp":"全員、戦闘配置へ！派手にやってみようか！","fan":"全员，进入战斗状态！来华丽地大干一场吧！","off":"全体，做好战斗准备，我们战个痛快吧！"},{"label":"战斗开始2","jp":"C&Cエージェントの力を見せてあげる！","fan":"让你见识下C&C特工的实力！","off":"让他们见识一下，C&C特工的实力！"},{"label":"获得BUFF","jp":"-","fan":"-","off":""},{"label":"施放BUFF","jp":"-","fan":"-","off":""},{"label":"掩体","jp":"-","fan":"-","off":""},{"label":"被CC1","jp":"-","fan":"-","off":"呀！"},{"label":"被CC2","jp":"-","fan":"-","off":"救命啊！"},{"label":"被CC3","jp":"-","fan":"-","off":"饶不了你！"},{"label":"回避","jp":"-","fan":"-","off":""},{"label":"队伍移动1","jp":"-","fan":"-","off":""},{"label":"队伍移动2","jp":"-","fan":"-","off":""},{"label":"回复","jp":"最っ高！大好き！","fan":"太棒啦！最喜欢了！","off":"真棒！爱死你了！"},{"label":"中途退出","jp":"うん…ごめん…。","fan":"呜…抱歉…。","off":"嗯..抱歉."},{"label":"战斗喊叫","jp":"-","fan":"-","off":"嘿！"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"哈！"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"要上了！"},{"label":"角色移动","jp":"-","fan":"-","off":""},{"label":"战斗胜利1","jp":"よっしゃ～！ちょっとウォーミングアップできたかな。\nあれ？あはは…","fan":"好咧~！浅浅热身完毕。\n诶？啊哈哈…","off":"好耶！身体有点热乎起来了。"},{"label":"战斗胜利2","jp":"んぅ～すっごく良かった…あらら、見ちゃった？","fan":"唔~真不错…哎呀呀，被看见了吗？","off":"（伸懒腰）真痛快！哎呀，你在看哪呀？"},{"label":"关卡完成1","jp":"この空気、最高！","fan":"这份空气，最甜了！","off":"这种气氛真是棒极了！"},{"label":"关卡完成2","jp":"みんなお疲れ、すっごく良かったよ","fan":"大家辛苦了，真是非常不错呢","off":"大家辛苦了，打的真漂亮！"},{"label":"战斗失败1","jp":"う～ん、予想と違ったなぁ…","fan":"唔~和我想象中有点不同...","off":"嗯….跟我想的不一样啊…"},{"label":"战斗失败2","jp":"惜しかった…皆、ゴメン！","fan":"好可惜…大家，对不起！","off":"好可惜，大家抱歉！"}],"成长":[{"label":"升级1","jp":"これからが本番ね。","fan":"接下来才是正头戏呢。","off":"好戏还在后头呢。"},{"label":"升级2","jp":"あれ？なんだか頭がよくなった気分…！","fan":"啊咧？怎么觉得脑袋变得好使了...！","off":"哎？怎么感觉自己变聪明了?"},{"label":"升级3","jp":"ご主人様の期待に私は絶対何としても答えるから！","fan":"因为我无论如何都会回应主人对我的期待的！","off":"无论如何，我都绝对不会让主人失望的！"},{"label":"升级4","jp":"ふふっ。ご主人様は私に何を望んでいるの？今の私なら叶えてあげられるよ","fan":"呵呵。主人希望我做什么呢？现在的我的话不管是什么都可以帮你实现哦。","off":"哼哼，主人对我有什么期望吗？我现在就为你实现！"},{"label":"获得专武","jp":"ご主人様！見て見て！\n新しい武器が届いたの！\nキラキラしてて可愛いでしょ？！","fan":"主人！看呀看呀！\n新的武器到了！\n闪闪的很可爱吧？！","off":"主人，快看快看，新的武器送来了，闪闪发光的很可爱吧？"}],"事件":[{"label":"学生生日","jp":"ご主人様！今日はご主人様の可愛いメイドの誕生日だよ！\nプレゼントは何をくれるの？","fan":"主人！今天是主人的可爱女仆的生日哦！\n会给我什么礼物呢？","off":"主人！今天是你可爱女仆的生日，你准备送我什么礼物啊？"},{"label":"老师生日","jp":"ご主人様のお誕生日を世界一盛大にお祝いするの！","fan":"我要为主人举行一场世界第一盛大的生日祝贺！","off":"我会为主人献上全世界最热烈的生日祝福！"},{"label":"万圣节","jp":"わあ！ハロウィンだ！\n見て見て！ご主人様！町が活気で溢れてるよ！\n早く行ってみよ！","fan":"哇！是万圣节！\n看呀看呀！主人！小镇充满了活力！\n快点去看看吧！","off":"哇！万圣节欸，主人，你看你看，街上也太热闹了吧，我们快去看看吧！"},{"label":"新年","jp":"明けましておめでとうございます、私のご主人様。\n今年もよろしくお願いいたします…\nなんてね！今年も来年も最高に楽しませてあげる！","fan":"新年快乐，我的主人。\n今年也请多多关照...\n唔嘿！今年和明年都是最快乐的！","off":"恭祝您新春快乐，我的主人，今年也请多多关照，\n逗你的，今年明年我都会让您开开心心的！"},{"label":"圣诞节","jp":"メリークリスマス！\nサンタの代わりに、メイドがご主人様にプレゼントを渡しに来たよ！\nプレゼントは何かというと…ふふっ。","fan":"圣诞快乐！\n女仆代替圣诞老人来给主人送礼物咯！\n您猜礼物会是什么呢...呼呼。","off":"圣诞快乐，就由女仆来代替圣诞老人为主人送上礼物吧，\n你问礼物是什么？哼哼哼~"},{"label":"春节","jp":"","fan":"主——人——\n新春快乐！和明日奈一起开开心心的度过新的一年吧！\n今后也会这么一直开心下去的！","off":"主——人——\n新春快乐！和明日奈一起开开心心的度过新的一年吧！\n今后也会这么一直开心下去的！"},{"label":"中秋","jp":"","fan":"月饼已经准备好啦！\n今天能和主人团圆，真的好开心啊！","off":"月饼已经准备好啦！\n今天能和主人团圆，真的好开心啊！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/5/72715.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/819096.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/88984.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/5/632770.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/738657.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/67450.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/5/929087.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/761168.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/18/187145.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/5/600265.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72