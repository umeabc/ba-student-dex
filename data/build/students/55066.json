e":"NPC 柚子（冬装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/953939.png","url":"https://www.gamekee.com/ba/647100.html"},{"name":"★3 柚子（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_232/h_239/829/191981/2026/0/18/274123.png","url":"https://www.gamekee.com/ba/690661.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive"},{"label":"卡池抽取","jp":"ゲーム開発部、部長……ユズです。ほ、本当に……わたしを連れてってくれるんですか？","fan":"游戏开发部，部长……柚子。真…真的要……把我带上吗？","off":"我是……游戏开发部部长，柚子\n真的，要带上我吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"せ、先生。いらっしゃい。待ってました。","fan":"老，老师。您来了，我一直在等您。","off":"老，老师，您来了，\n我正等着您呢"},{"label":"登陆2","jp":"先生……お帰りなさい。","fan":"老师……欢迎回来。","off":"老师，欢迎回来"},{"label":"大厅1","jp":"先生の頼みなら……喜んでお受けします。","fan":"如果是老师的请求……我会欣然接受的。","off":"只要是老师的请求，我都会欣然接受"},{"label":"大厅2","jp":"はい。どんなことでもおっしゃってください。ベストを……尽くします！","fan":"是，无论什么都请尽管提，我会尽力做到最好！","off":"嗯，不管是什么事，您尽管说就好了，我都会尽力而为"},{"label":"大厅3","jp":"あ。猫も飼いたいです。ゲームと猫さえあれば、世の中を生きていけます。","fan":"啊，猫猫我也很想养。只要有游戏和猫猫，我就能够一直生活下去。","off":"啊，我也想养猫。只要有游戏和猫咪，我就能在这个世界上活下去"},{"label":"大厅4","jp":"……はい。先生。わたしも、強くなります。先生とみんなが……わたしを守ってくれたように、わたしもみんなの力になりたいです。","fan":"是，老师，我也会坚强起来的。我也会像老师和大家保护我那样，为大家竭尽全力的！","off":"嗯，老师，我也会变强的。\n就像老师和大家保护我一样，我也想为大家尽一份力。"},{"label":"大厅5","jp":"(この人に……相応しいわたしになりたい。)","fan":"（我想要成为配得上他的样子。）","off":"（我想变得，配得上这个人！）"},{"label":"回忆大厅1","jp":"先生とじゃなかったら……できなかったと思います。","fan":"如果不是老师……我想我肯定是做不到的。","off":"如果没有老师，我肯定做不到这些"},{"label":"回忆大厅2","jp":"みんなにプレゼントができたのは、先生のおかげです。","fan":"能够收到大家的礼物，也是多亏了老师。","off":"多亏了老师，我才能顺利的给大家送礼物"},{"label":"回忆大厅3","jp":"先生が助けてくれたように……\n先生にわたしが必要な瞬間が来たら、何でも言ってくださいね。","fan":"老师能帮到我这个地步……\n所以老师如果有需要我的时候，请尽管开口。","off":"老师帮助了我\n所以，老师在需要我的时候，还请尽管开口"},{"label":"回忆大厅4","jp":"……必ず、恩返しします。","fan":"……我一定，我回报这份恩情。","off":"我一定会报答您的！"},{"label":"咖啡馆1","jp":"うーん...隠れられる場所はないのかな...","fan":"嗯……有没有能藏起来的地方啊…","off":"呜……有没有什么地方能躲起来啊"},{"label":"咖啡馆2","jp":"ひゃっ！ど、どうしてここに！","fan":"咿呀！为…为什么在这里！","off":"呀……您……您怎么会在这？"},{"label":"咖啡馆3","jp":"きっと先生も……オトナな女性が好きなはず、だよね？","fan":"老师也肯定……更喜欢成熟的女性……吧？","off":"老师……应该……也喜欢成熟的女性吧？"},{"label":"咖啡馆4","jp":"本格的に、ゲームを勉強したい。","fan":"好想要，认真钻研游戏。","off":"我想更加正式的研究游戏！"},{"label":"咖啡馆5","jp":"ゆったりとした空間だね。こんなところですやすやしたいな。","fan":"真是宽敞舒适的地方啊。这样的地方让人想要呼呼大睡呢。","off":"这里感觉好舒服啊……\n我好想在这里睡觉觉……"}],"好感度":[{"label":"好感度1","jp":"め、迷惑…かけてないですよね？……それなら…いひひ…よかったです…！","fan":"我，我没给您添麻烦吧？……没有吗……诶嘿嘿…那就好…！","off":"没给您添麻烦吧？\n诶嘿嘿，那就好"},{"label":"好感度2","jp":"よく……わからないんです。本当によくわからない気持ちなのですが……うれしい……です。","fan":"我也不太明白……这份我自己也道不清的感情……但是……很开心……","off":"我不太明白，真的不太明白，现在的心情究竟是什么\n但是我很开心"},{"label":"好感度3","jp":"授業や指揮をしてくださる時……なんだか先生は……あの……本当に……格好いい、というか……。","fan":"老师……在上课和指挥我们的时候……我觉得真的……很帅气……","off":"总觉得老师担任顾问和指挥的时候……\n真的很帅"},{"label":"好感度4","jp":"わ、わたしも先生のこと……。えっと……その……。は、恥ずかしい！","fan":"我也对老师……就是……那个……我，我说不出口！","off":"我……我也对老师……\n呜……羞死人啦……"}],"战斗":[{"label":"编入队伍1","jp":"せ、先生が必要としてくれるのであれば……わたしも。","fan":"老，老师如果觉得有必要的话……我也同意。","off":"如果老师需要的话，我也……"},{"label":"编入队伍2","jp":"な、仲良くなれるように頑張ります……多分。","fan":"我，我会努力和大家好好相处的……大概。","off":"我会努力和大家成为好朋友的，应该吧……"},{"label":"拎起","jp":"わ、わたしをですか？うぅ……やってみます！","fan":"要，要选我吗？呜……我会尽力！","off":"选……选我吗？我试试看"},{"label":"任命队长1","jp":"ほ、他の人たちと一緒に……？が、頑張ります。","fan":"要……要和其他人一起……？我，我会加油的。","off":"和……和其他人一起？我会加油的"},{"label":"任命队长2","jp":"えっ！ベ、ベストは尽くします！","fan":"嘿！我会努力做到最好的！","off":"诶？我……我会尽力的"},{"label":"普通技能","jp":"っが...頑張ります……！","fan":"我…我会努力的……！","off":"我……我会加油"},{"label":"EX动画1","jp":"行きます……！","fan":"要上了……！","off":"我要上了"},{"label":"EX动画2","jp":"照準は、定まりました！","fan":"瞄准，已锁定！","off":"目标已瞄准"},{"label":"EX动画3","jp":"これは……面白いと思います！","fan":"这样的话……我觉得很有趣！","off":"我觉得，这个还挺好玩"},{"label":"EX技能1","jp":"レトロよ……永遠であれ！","fan":"经典……恒久流传！","off":"复古游戏啊，成为永恒吧！"},{"label":"EX技能2","jp":"覚悟してください！","fan":"做好觉悟吧！","off":"请做好觉悟吧！"},{"label":"EX技能3","jp":"これが……創作の苦しみです！","fan":"这也是……创作的辛酸！","off":"这，就是创作的痛苦！"},{"label":"战斗开始1","jp":"と、とりあえず、部長らしい姿を見せないと……！","fan":"总……总之，我一定要做好一个像样的部长……！","off":"总之……必须要有部长的样子"},{"label":"战斗开始2","jp":"落ちついて、気をつけながら進みましょう。","fan":"冷静下来，小心地前进吧。","off":"冷静下来，保持警惕前进吧！"},{"label":"获得BUFF","jp":"あ...ありがとうございます……！","fan":"非…非常感谢……！","off":"非……非常感谢"},{"label":"施放BUFF","jp":"頑張ります……！","fan":"我会加油的……！","off":"我会加油……"},{"label":"掩体","jp":"こ、ここに隠れて引きつけます、今のうちに！","fan":"我会躲在这里吸引火力，趁现在！","off":"我……我藏在这里吸引火力，趁现在！"},{"label":"被CC1","jp":"ひぃ……！","fan":"咿……！","off":"呀！"},{"label":"被CC2","jp":"痛い……","fan":"好痛……","off":"好疼"},{"label":"被CC3","jp":"だ……大丈夫です。","fan":"我……没事的。","off":"不要紧……"},{"label":"回避","jp":"これぐらいなら、だ……大丈夫です！","fan":"这种程度的话，没……没关系！","off":"就这样的话……没问题！"},{"label":"队伍移动1","jp":"なんとかやり遂げました、つ...続けて行きます！","fan":"总算搞定了，接…接着前进吧！","off":"总算完成了……继续前进！"},{"label":"队伍移动2","jp":"危ないところでした……","fan":"刚才好险啊……","off":"刚才好险啊……"},{"label":"回复","jp":"ご配慮……ありがとうございます！","fan":"谢谢……有劳费心了！","off":"十分感谢您的照顾！"},{"label":"中途退出","jp":"ひぃ……ごめんなさい……","fan":"咿……对不起……","off":"呜呜……对不起……"},{"label":"战斗喊叫","jp":"え...えい！","fan":"嘿……！","off":"哎！"},{"label":"战斗喊叫","jp":"はあ！","fan":"哈！","off":"哈——"},{"label":"战斗喊叫","jp":"行きます！","fan":"我要上了！","off":"我要上啦！"},{"label":"特殊载具","jp":"こ、これは......私が相乗します！","fan":"这…这是……让我来助你一臂之力！","off":""},{"label":"特殊载具","jp":"私は、エースパイロットです！ゲームでの話ですが...","fan":"我是王牌驾驶员！虽说只是在游戏里…","off":""},{"label":"角色移动","jp":"い、行きます！","fan":"我，我要上了！","off":"前……前进！"},{"label":"战斗胜利1","jp":"ふぅ……役に立って、嬉しいです。","fan":"呼……很开心能帮上忙。","off":"呼……能帮上忙，我很高兴！"},{"label":"战斗胜利2","jp":"お、お疲れ様でした！えへへ……","fan":"大家辛苦了！诶嘿嘿…","off":"大……大家辛苦了……诶嘿嘿"},{"label":"关卡完成1","jp":"ふぅ……良かったぁ……","fan":"呼……太好了……","off":"啊……太好了"},{"label":"关卡完成2","jp":"成功……！嬉しいです、こんな気分なんですね。","fan":"成功……！好开心，原来是这样的心情。","off":"好开心，原来成功是这样的心情呢~"},{"label":"战斗失败1","jp":"ご、ごめんなさい！","fan":"对……对不起！","off":"对……对不起！"},{"label":"战斗失败2","jp":"はぁ、だめぇ……！","fan":"啊，失败了……！","off":"啊……不行了……"}],"成长":[{"label":"升级1","jp":"先生のおかげで少し安心しました。","fan":"多亏了老师，稍微安心一些了。","off":"多亏了老师，可以稍微放心一点了"},{"label":"升级2","jp":"もっと自信のあるわたしになりたいです。","fan":"我想要变得更加自信一些。","off":"我……想变得更有自信！"},{"label":"升级3","jp":"怖いとき……ですか？うーん……先生がそばにいないとき……でしょうか。","fan":"害怕的时候……吗？嗯……大概是……老师不在我身边的时候吧……","off":"什么时候会害怕……\n唔……老师不在身边的时候吧？"},{"label":"升级4","jp":"わ、わたしはちっとも強くないですが……頑張ります！みんなのことが本当に好きだから。","fan":"虽，虽说我根本算不上有多厉害……但我会加油！毕竟我最喜欢大家了。","off":"我……我真的一点都不强\n但我会努力的，因为我真的很喜欢大家"},{"label":"获得专武","jp":"体の中で、力が漲ってる感じです。これが...勇気...でしょうか？","fan":"感觉身体里，力量涌现出来。这就是……勇气吗？","off":"身体里有种力量涌动的感觉\n这就是勇气吗？"}],"事件":[{"label":"学生生日","jp":"きょ、今日はわたしの誕生日です。キヴォトスの文化の日ですからね……忘れちゃダメですよ。","fan":"今天……是我的生日，也是基沃托斯的文化节……别忘了哦。","off":"今……今天是我的生日，也是基沃托斯的文化日\n所以……不可以忘记哦……"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。本当に……本当に……！","fan":"祝你生日快乐，老师。真心地…祝福你……！","off":"老师，祝您生日快乐！\n我是真心的！"},{"label":"万圣节","jp":"街が、光るカボチャと飴で溢れていますね。わ、わたしも行ってみたいです。先生と一緒に……。","fan":"街上到处都是发光的南瓜和糖果呢。我，我也想去……和老师一起……","off":"街上到处都是闪闪发光的南瓜和糖果诶\n我也想去看看，和老师一起"},{"label":"新年","jp":"明けましておめでとうございます。わたし、もっと成長した姿を、お見せしますから。","fan":"祝您新年快乐。我会让您看到我的成长的。","off":"新年快乐，我会让您看到我更加成熟的样子"},{"label":"圣诞节","jp":"メ、メリークリスマス……先生。サンタとゲームは……似ています。どちらもトキメキをプレゼントしてくれるので。","fan":"圣诞节快乐……老师。圣诞和游戏……很相似。都会给人带来心动不已的期待呢。","off":"圣诞快乐，老师。\n圣诞老人跟游戏有着相似之处，因为两者都会让人心跳加速"},{"label":"春节","jp":"","fan":"老师，新春快乐！\n今年我想做出更有趣的游戏……还想和老师更亲近一点","off":"老师，新春快乐！\n今年我想做出更有趣的游戏……还想和老师更亲近一点"},{"label":"中秋","jp":"","fan":"中秋节快乐，真的要和我一起过节吗……\n不是的……我当然很开心……诶嘿嘿","off":"中秋节快乐，真的要和我一起过节吗……\n不是的……我当然很开心……诶嘿嘿"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/827442.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/752275.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/950659.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/925535.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/475830.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/6456.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/649299.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/325354.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/19/45519.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com