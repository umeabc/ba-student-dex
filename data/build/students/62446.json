6082/2025/6/17/592914.png","url":"https://www.gamekee.com/ba/tj/645823.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"blue archive"},{"label":"卡池抽取","jp":"ったく、なんでこんな変な服を…\nま、意外と動きやすいから良いけどな、ははっ！","fan":"真是的，为啥要穿这怪衣服......\n算了，意外地还挺便于活动，哈哈！","off":"真是的，为什么要穿这么奇怪的衣服，\n不过活动起来倒是很方便，哈哈。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おっ、先生じゃねぇか！待ってたぜ、ちょっと面貸せよ","fan":"噢，这不是老师嘛！等你呐，来吧","off":"这不是老师吗？正等你呢。"},{"label":"登陆2","jp":"良いタイミングで来たじゃねぇか！おら、一緒に行くぞ先生！","fan":"这时机真不错嘛！来吧，一起出发吧老师！","off":"老师，你来的正是时候，我们去热闹一下吧。"},{"label":"大厅1","jp":"何でそんなじっと見てんだよ……。何か変か、これ？","fan":"为啥这么盯着我……有什么不对劲吗，这个？","off":"干嘛盯着我看？\n这衣服有什么奇怪的吗？"},{"label":"大厅2","jp":"……あん？スカジャン？これは譲れねぇんだよ、どんな格好でもな。","fan":"……啥？刺绣外套？这可不能脱，无论去哪我都要穿着它。","off":"外套这个可不能脱，去哪儿我都要穿着。"},{"label":"大厅3","jp":"あー、暇だ……何でも良いから仕事させてくれ。暇なのは性に合わねえ……。","fan":"啊，好闲呐……啥都行给我个活儿干吧。我和闲八字不合啊……","off":"无聊死了，不管什么都可以，随便给我安排点工作，我一闲下来就浑身难受。"},{"label":"大厅4","jp":"先生は何か欲しいもんとかねぇのか？\n……いや、別に、何かあんなら協力してやろうかと思って","fan":"老师有啥想要的东西吗？\n……没，我只是想着帮你干点啥","off":"老师没什么想要的吗？没事，我只是想问问要不要我帮忙。"},{"label":"大厅5","jp":"ちょっ、耳は触んな！？\n……や、よく考えたら別にこれ、あたしの耳じゃねーな……？","fan":"喂，别摸耳朵啊！？\n……不过，仔细想了下也没啥，毕竟也不是真的摸的我的耳朵、啊……？","off":"别摸我耳朵！\n不对，仔细想想，这好像也不是我的耳朵。"},{"label":"回忆大厅1","jp":"い、でぇ…","fan":"好痛…","off":"恩...呃啊"},{"label":"回忆大厅2","jp":"はぁ……な、何だよその目は。","fan":"哈……什、什么啊你这眼神。","off":"干嘛？为什么这样看着我？"},{"label":"回忆大厅3","jp":"……ん、OK。ちゃんと貼れたか？\nああ、大丈夫だな、サンキュ。","fan":"……嗯，OK。贴好了吗？\n啊，没关系了吧，谢谢。","off":"OK，\n贴好了吗？没问题了，谢了。"},{"label":"回忆大厅4","jp":"……言っとくけどあたし、普段はこういうこと誰かにやってもらったりしねぇから。先生だからお願いしたんであって……。","fan":"……话说，我平时不会让别人做这种事的。因为是老师所以拜托了……。","off":"话说在前头，一般来说，这种事我可不会随便让别人帮忙。\n因为是老师，所以才拜托你的。"},{"label":"回忆大厅5","jp":"……まあ良いや。相変わらず、先生は変なやつだな。","fan":"……算了。老师还是那么奇怪啊。","off":"算了，老师你还是这么奇怪。"},{"label":"回忆大厅6","jp":"ま、だからこそ……ってな。\n……もう分かってるだろうけど、こういうの、他のやつには言うんじゃねーぞ？","fan":"正因为如此……嘛。\n……虽然你可能明白了，但是这种事，不能对其他人说噢？","off":"所以怎么说呢？\n你应该明白吧，这件事可千万不能告诉别人哦"},{"label":"咖啡馆1","jp":"何だか、いつも以上に視線が……この服のせいか？","fan":"总觉得，视线比平时更……是因为这件衣服吗？","off":"感觉盯着我的家伙比平时还多，是因为这件衣服吗？"},{"label":"咖啡馆2","jp":"メイド服よりも動きやすいな、悪くねぇ","fan":"比女仆装更便于活动，还不错呢","off":"比女仆装方便多了，还不错。"},{"label":"咖啡馆3","jp":"あぁん？何見てんだこら？やる気か？あん？","fan":"啊？你在看什么啊？有干劲？啊？","off":"看什么？要干架吗？"},{"label":"咖啡馆4","jp":"……ふん、悪くねぇ場所だなまた今度来てやるとするか","fan":"……嗯，真是个不错的地方啊，下次还会再来吧","off":"这地方不错，以后可以经常来。"},{"label":"咖啡馆5","jp":"先生は……いねぇのか、出張中か？い、いや、別にどうでも良いけど……","fan":"老师呢……不在吗，出差了吗？不，不，没关系……","off":"老师不在吗？在出差吗？不不不，这和我又没关系。"}],"好感度":[{"label":"好感度1","jp":"おい、覚悟しとけよ。ここまで付き合っておいて、冗談でしたじゃ済まねぇからな。","fan":"喂，觉悟吧。交往到这个地步，开玩笑是不行的。","off":"做好心理准备，都到这一步了，可别说你在开玩笑。"},{"label":"好感度2","jp":"悪くねぇ気分だ……。はっ、やっ、なんでもねぇよ！","fan":"心情不错……。啊，哎呀，我啥都没说！","off":"感觉心情还不错，我什么都没说。"},{"label":"好感度3","jp":"はぁ……これは参ったな……。あぁ？なんだよ。こっち見んな！","fan":"啊……真是服了啊……。啊？啥呀。别看这边！","off":"真是的，干什么别看我。"},{"label":"好感度4","jp":"おかしいな……なんだか先生といると調子が狂っちまう。","fan":"好奇怪啊……总觉得和老师在一起的话状态会变乱。","off":"感觉怪怪的，不知道为什么和老师在一起我就会很奇怪。"}],"战斗":[{"label":"编入队伍1","jp":"ま、あたしがいた方が良いだろう。","fan":"啊，还是有我在比较好吧。","off":"看还是有我在比较好吧。"},{"label":"编入队伍2","jp":"見る目あるじゃねえか。","fan":"你小子眼光不错嘛。","off":"很有眼光。"},{"label":"拎起","jp":"おいこら、放せバカ！","fan":"喂你这白痴放我下来！","off":"喂喂，给我放手。"},{"label":"任命队长1","jp":"さぁ、早く始めようぜ！","fan":"那么，快点开始吧！","off":"好了，快点开始吧。"},{"label":"任命队长2","jp":"こうゆうのは任せとけ！","fan":"这点小事就包在我身上吧！","off":"这种事尽管交给我吧。"},{"label":"普通技能","jp":"こんなもんかよぉ！？","fan":"原来是这样啊！？","off":"就这？"},{"label":"EX动画1","jp":"あん？何見てんだゴラ！","fan":"啊？你在看啥啊可恶！","off":"看什么呢？臭小子。"},{"label":"EX动画2","jp":"見せもんじゃねぇぞ！","fan":"这可不是闹着玩的！","off":"看什么看？"},{"label":"EX动画3","jp":"打ちのめされたぇのか！？","fan":"想被打飞吗！？","off":"想死吗？你。"},{"label":"EX技能1","jp":"おりゃぁ、くらえぇ！","fan":"喂，吃我一招！","off":"吃我一招。"},{"label":"EX技能2","jp":"はっはっはっはっは！","fan":"哈哈哈哈哈！","off":"哈哈哈哈哈哈哈哈哈。"},{"label":"EX技能3","jp":"うおりゃぁぁぁぁ！","fan":"唔啊啊啊啊！","off":"我打。"},{"label":"战斗开始1","jp":"“待”ってたぜェ！！この“瞬間”をよォ！！","fan":"等的就是！此刻！！","off":"我等的就是现在。"},{"label":"战斗开始2","jp":"任せとけ、すぐに終わらせてやる！","fan":"交给我，三下五除二了结他们！","off":"交给我，马上解决。"},{"label":"获得BUFF","jp":"悪くねぇな！","fan":"不错嘛！","off":"不错嘛。"},{"label":"施放BUFF","jp":"さあ行くぜ！","fan":"好上吧！","off":"上吧。"},{"label":"掩体","jp":"焦んなくても相手してやるよ。","fan":"别急，待会出来我奉陪到底。","off":"别急，我出来就对付你。"},{"label":"被CC1","jp":"-","fan":"-","off":"-"},{"label":"被CC2","jp":"くっ！","fan":"咳！","off":"-"},{"label":"被CC3","jp":"がぁ！","fan":"呀！","off":"-"},{"label":"被CC4","jp":"\\","fan":"\\","off":"\\"},{"label":"被CC6","jp":"\\","fan":"\\","off":"\\"},{"label":"回避","jp":"はは！","fan":"哈哈！","off":"-"},{"label":"队伍移动1","jp":"さっさと行くぞ！","fan":"搞快出发吧！","off":"搞快点。"},{"label":"队伍移动2","jp":"まさかこんなもんじゃ終わらねぇよなぁ？","fan":"就这，难道这就结束了？","off":"这就完了。"},{"label":"回复","jp":"悪くねぇタイミングだ！","fan":"不错的时机嘛！","off":"时机不错。"},{"label":"中途退出","jp":"ぐぅ！","fan":"咳！","off":""},{"label":"战斗喊叫","jp":"はっ！","fan":"哈！","off":""},{"label":"战斗喊叫","jp":"ほら！","fan":"看招！","off":""},{"label":"战斗喊叫","jp":"くらえ！","fan":"吃我一招！","off":"接招。"},{"label":"角色移动","jp":"うっし！","fan":"好咧！","off":"-"},{"label":"战斗胜利1","jp":"っは、ウォーミングアップにもなりゃしねぇ。","fan":"哈，连热身都算不上。","off":"连热身都算不上。"},{"label":"战斗胜利2","jp":"楽勝楽勝！","fan":"简简单单！","off":"轻轻松松。"},{"label":"关卡完成1","jp":"あったりめぇの結果だな、私を誰だと思ってやがる？","fan":"理所当然的结果嘛，不看看我是谁","off":"这不是理所当然的吗？也不看看我是谁。"},{"label":"关卡完成2","jp":"あたしに掛かれぇばこれくらい朝飯前だ！","fan":"只要我出手，这种事不过是小菜一碟！","off":"只要我出手，这种事就是小菜一碟。"},{"label":"战斗失败1","jp":"ちっ、覚えとけよ、次は負けねぇ！","fan":"切，给我记着，下次不会再输给你！","off":"切，给我记着，下次我可不会再输了。"},{"label":"战斗失败2","jp":"信じらんねぇ、おかしいだろうがよぉ！？","fan":"不敢相信，真奇怪啊！？","off":"不会吧，这不对头。"}],"成长":[{"label":"升级1","jp":"はっ、悪くねぇな。ちゃんとお返しはしてやるから、待ってろよ！","fan":"哈，不错嘛。我会报答你的，给我等着！","off":"不错，我会好好回礼的，你就等着吧。"},{"label":"升级2","jp":"ははっ、良いじゃねえか！こういうのを待ってたんだ！","fan":"哈哈，真不错嘛！等的就是这个！","off":"哈哈，真不错，我正想要这个呢。"},{"label":"升级3","jp":"やるじゃねぇか、先生。後悔はさせねぇからよ。","fan":"有两把刷子嘛，老师。我不会让你后悔的。","off":"有两把刷子啊，老师你不会后悔的。"},{"label":"升级4","jp":"あぁ……これは悪くねぇ！おし、後は任せな！","fan":"啊……这真是不错！好了，之后就交给我吧！","off":"这个可真不错。好，剩下的就交给我。"},{"label":"获得专武","jp":"はっ、ここまでおぜん立てしてもらったら、思いっきり派手にやらねーとな……\nさあ、どこまで耐えられる？","fan":"啊，为我准备了这个啊，那我可必须要全力以赴，华丽地战斗一场了……\n看看能接我几招？","off":"为我准备了这个，那我就必须全力以赴，华丽的大干一场了。来试试看能接我几招。"}],"事件":[{"label":"学生生日","jp":"よぉ、先生！知ってるよな、今日は特別な日だぞ！\nあん？誕生日でテンション上がって着替えたのって……？\nばっ、ちげぇよ！？","fan":"哟，老师！知道的吧，今天可是特别的日子！\n啥？因为是生日情绪高涨换了衣服……？\n哈，好厉害啊！？","off":"哈哈，老师知道吧？今天是个特别的日子……\n因为过生日特意换上了这件衣服？怎么可能？"},{"label":"老师生日","jp":"よぉ、先生！誕生日おめでとさん！\nは？お祝いのためにわざわざ着てくれたの……って？\nべっ、別にそういうわけじゃねぇから！？","fan":"哟，老师！生日快乐！\n什么？你问是为了庆祝特意给你穿的吗……？\n咋，咋可能嘛！？","off":"老师生日快乐。\n为了给你庆生特意穿上这件衣服？当然不是！"},{"label":"万圣节","jp":"今日はどいつもこいつも変な服着てるから、合わせてやろうかなって\n思ってよ。これなら良いだろ、どうだ？","fan":"今天每个人都穿着奇怪的衣服，我在想要不要配合一下他们呢。\n还是就这样就好了，怎么样？","off":"今天大家都穿着奇怪的衣服，所以我也想配合一下，这么穿应该没问题吧。你觉得怎么样？"},{"label":"新年","jp":"よぉ、今年もよろしくな、先生。\n……こちらこそ？あぁ、背中は任せとけ！","fan":"哦，今年也请多关照，老师。\n……彼此彼此？啊，背后就交给我吧！","off":"今年也多多关照了老师，嗯，彼此彼此，哼，包在我身上。"},{"label":"圣诞节","jp":"クリスマスプレゼントは子供がもらうもの……？\n馬っ鹿、知ってるっての！？\n別に欲しくてここに来たわけじゃねぇから！？","fan":"圣诞礼物是孩子收的……？\n白痴，你知道吗！？\n才不是因为想要礼物才来这里的！？","off":"只有小孩子才有圣诞礼物，真的我当然知道了，我又不是为了礼物来的。"},{"label":"春节","jp":"","fan":"今天也拜托了老师，新春快乐。\n问我是不是特意穿了红色衣服？没……没那回事！","off":"今天也拜托了老师，新春快乐。\n问我是不是特意穿了红色衣服？没……没那回事！"},{"label":"中秋","jp":"","fan":"哟，老师要去高处一起赏月吗？\n我知道一个地方的景色很不错。","off":"哟，老师要去高处一起赏月吗？\n我知道一个地方的景色很不错。"}],"活动":[{"label":"活动登陆1","jp":"おらっ！仕事の時間だぞ、先生！","fan":"喂！到工作时间了，老师！","off":"好，该干活了，老师。"},{"label":"活动登陆2","jp":"油を売ってる暇はねぇ、行くぞ！","fan":"没时间磨磨唧唧了，快走吧！","off":"别磨蹭了，马上开始吧。"},{"label":"活动大厅1","jp":"何か手伝うことでもあるか、先生？","fan":"有啥我能帮你的吗，老师？","off":"还有什么事要干吗？老师。"},{"label":"活动大厅2","jp":"ははっ！悪くねぇな！","fan":"哈哈！真不错！","off":"哈哈，不错嘛。"},{"label":"活动大厅3","jp":"さて、こうしてる場合じゃねぇな。","fan":"好了，不是这样的场合吧。","off":"你不要磨磨唧唧的了。"},{"label":"活动大厅4","jp":"なっ、何をそんなじっと見てんだよ……。\nほら、さっさと仕事始めんぞ。","fan":"哈，你在看什么呢……。\n干嘛，赶紧开始干活儿吧。","off":"你看我干嘛？我脸上有活吗？快点干活。"},{"label":"活动事件1","jp":"やるからには徹底的にやるタイプでな。","fan":"我可是要做就做到彻底的类型的人啊。","off":"我呀，习惯提前把事情处理好。"},{"label":"活动事件2","jp":"おらっ、片付け始めんぞ！","fan":"喂，开始收拾吧！","off":"干净利落的收尾。"},{"label":"活动结束","jp":"後片付けなら任せとけ、あたしの専門分野だ！","fan":"善后交给我，这可是我的专长！","off":"收拾残局，我可是专家。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/5/16430.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/17/650481.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/image