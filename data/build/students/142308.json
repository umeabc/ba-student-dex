29/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 遥香 （正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/10/356248.png","url":"https://www.gamekee.com/ba/586545.html"},{"name":"★1 遥香","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/10/234415.png","url":"https://www.gamekee.com/ba/53921.html"},{"name":"NPC 遥香（特工）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/10/990445.png","url":"https://www.gamekee.com/ba/614748.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー……アーカイ……ブ。","fan":"碧蓝……档案。","off":""},{"label":"卡池抽取","jp":"お、お見苦しい格好かもしれませんが……よ、よろしくお願いします……。","fan":"这、这身打扮可能有点难看……还、还是请多多指教了。","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こ、こんにちは、先生！あ……ど、ドレス姿、や、やっぱり変、でしょうか……？","fan":"您、您好，老师！啊……穿、穿着礼服的样子，果、果然很奇怪吗……？","off":""},{"label":"登陆2","jp":"お、おかえりなさい、先生！ええと……気を引き締めようと思って、この格好にしたのですが……。","fan":"欢、欢迎回来！呃……为了能打起精神才穿成这样的……","off":""},{"label":"大厅1","jp":"いつでも命令してください……！爆弾はたくさんありますので！","fan":"请随时下令……！炸弹还有很多呢！","off":""},{"label":"大厅2","jp":"あ、あの……何か御用はありませんか？","fan":"那、那个……请问您有什么事吗？","off":""},{"label":"大厅3","jp":"……え？休んでていい？で、ですが、今は仕事中、ですよね……。","fan":"……诶？可以休息吗？可，可是现在还在工作吧……。","off":""},{"label":"大厅4","jp":"そ、そんなに見つめられると……は、恥ずかしいです……。","fan":"被、被人这样盯着看……好、好害羞啊……。","off":""},{"label":"大厅5","jp":"人事を尽くして……全力で……手段は問わずに……。","fan":"尽人事……全力而为……不择手段……。","off":""},{"label":"回忆大厅1","jp":"……雑草が好きなのは、美しいからじゃ、ないです。私は、雑草の硬いところが好きなんです。","fan":"……我喜欢杂草，并不是因为它们美丽。我，喜欢的是杂草的坚韧。","off":""},{"label":"回忆大厅2","jp":"どんな荒地でも強く根を張る、粘り強さ――それこそが、私の理想。","fan":"无论身处多么荒芜的土地，都能拥有扎根生长的韧性——这才是我的理想。","off":""},{"label":"回忆大厅3","jp":"美しくある必要はありません。輝かなくてもいいんです。","fan":"不需要有多美丽。也不需要光彩夺目。","off":""},{"label":"回忆大厅4","jp":"大切な人と、ただ過ごせるなら……。せ、先生と一緒にいられるのなら……。","fan":"只要能和重要的人，就这样一起度过时光……只要，可以跟老师在一起的话……","off":""},{"label":"回忆大厅5","jp":"私は、それで……好き、なんです。","fan":"我就……很喜欢了。","off":""},{"label":"咖啡馆1","jp":"（この格好……調子に乗っていると思われないでしょうか……？）","fan":"（这身打扮……会不会太张扬了呢？）","off":""},{"label":"咖啡馆2","jp":"えっと、一番目立たない場所は……。","fan":"嗯，最不起眼的地方在……。","off":""},{"label":"咖啡馆3","jp":"コーヒー、いい匂い……えへへ。","fan":"咖啡，好香……欸嘿嘿。","off":""},{"label":"咖啡馆4","jp":"ここにまで追ってきたりは……ないですよね？","fan":"应该不会……追到这里来吧？","off":""},{"label":"咖啡馆5","jp":"お土産にしたら……き、きっと喜んでくれますよね？","fan":"如果把这个作为礼物……大、大家一定会喜欢吧？","off":""}],"好感度":[{"label":"好感度1","jp":"ありがとうございます、ありがとうございます、ありがとうございます……！","fan":"谢谢、谢谢你、非常感谢……！","off":""},{"label":"好感度2","jp":"綺麗……ああ、このドレス、綺麗ですよね。えっ、わ、私が……！？","fan":"漂亮……啊，这件礼服好美。咦？我，给我穿吗！？","off":""},{"label":"好感度3","jp":"わ、私……こんなに幸せでいいんでしょうか……？","fan":"我、我真的……可以这么幸福吗？","off":""},{"label":"好感度4","jp":"ありがとうございます。私の大切な……先生……。","fan":"谢谢您。我重要的……老师……。","off":""}],"战斗":[{"label":"编入队伍1","jp":"い、いってきます！","fan":"我、我要上了！","off":""},{"label":"编入队伍2","jp":"さ、最善を……尽くします……！","fan":"我、我会……尽全力的！","off":""},{"label":"拎起","jp":"に、似合ってますか？そ、そんな……えへへ……。","fan":"合、合身吗？怎、怎么会……欸嘿嘿……。","off":""},{"label":"任命队长1","jp":"先生と一緒なら、どこへでも……！","fan":"只要和老师在一起，去哪里都行……！","off":""},{"label":"任命队长2","jp":"全員……潰します……！","fan":"将所有人……击溃……！","off":""},{"label":"普通技能","jp":"みんな……！頑張りましょう……！","fan":"大家……！一起加油吧……！","off":""},{"label":"EX动画1","jp":"せ、先生！？……この！","fan":"老、老师！？……你这混蛋！","off":""},{"label":"EX动画2","jp":"危ない！……許しません！","fan":"危险！……不可原谅！","off":""},{"label":"EX动画3","jp":"うわああ……！？……け、消してやる！","fan":"哇啊……！？消、消灭你！","off":""},{"label":"EX技能1","jp":"消えてください！","fan":"请消失吧！","off":""},{"label":"EX技能2","jp":"先生になんてことを……！","fan":"竟然对老师做出这种事……！","off":""},{"label":"EX技能3","jp":"食らえ……！","fan":"吃我一招……！","off":""},{"label":"战斗开始1","jp":"許さない許さない許さない……。","fan":"无法原谅无法原谅无法原谅……。","off":""},{"label":"战斗开始2","jp":"い、行きます！","fan":"我、我要上了！","off":""},{"label":"获得BUFF","jp":"ど、どうして私なんかに……！？","fan":"为、为什么是我……！？","off":""},{"label":"施放BUFF","jp":"","fan":"","off":""},{"label":"掩体","jp":"無駄です！","fan":"没有用的！","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"被CC3","jp":"","fan":"","off":""},{"label":"回避","jp":"この……！","fan":"这家伙……！","off":""},{"label":"队伍移动1","jp":"つ、次はどこですか？","fan":"下、下一个在哪里？","off":""},{"label":"队伍移动2","jp":"こっちは終わりました！","fan":"这边已经结束了！","off":""},{"label":"回复","jp":"こ、ここまでしていただかなくても……！","fan":"不、不用为我做到这种地步……！","off":""},{"label":"中途退出","jp":"引き下がちゃ……ダメなのに……","fan":"明明……还不能退场……","off":""},{"label":"战斗喊叫","jp":"止まってください！","fan":"请停下来！","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"当たってください！","fan":"请命中吧！","off":""},{"label":"角色移动","jp":"","fan":"","off":""},{"label":"战斗胜利1","jp":"つ、次も、必ず……！","fan":"下、下次一定会……！","off":""},{"label":"战斗胜利2","jp":"全部、みんなのおかげです……！","fan":"全都，多亏了大家……！","off":""},{"label":"关卡完成1","jp":"や、やっぱり先生はすごいです！","fan":"果、果然老师很厉害！","off":""},{"label":"关卡完成2","jp":"はい！ゴミはゴミ箱にぶち込みました！","fan":"好的！垃圾已经扔进垃圾桶了！","off":""},{"label":"战斗失败1","jp":"ぜ、全部私のせいです……申し訳ありません……！","fan":"全、全都是我的错……非常抱歉……！","off":""},{"label":"战斗失败2","jp":"もう……捨ててください……","fan":"已经……请抛弃我吧……","off":""}],"成长":[{"label":"升级1","jp":"本当に……もらっていいんですか……？","fan":"真的……可以收下吗……？","off":""},{"label":"升级2","jp":"こんなに貴重なものを私に……！？ど、どうお返しすれば……！","fan":"把这么贵重的东西给我……！？我、我要怎么回报才好……！","off":""},{"label":"升级3","jp":"私なんかのために……本当に、ありがとうございます……！","fan":"为了这样的我……真的，非常感谢您！","off":""},{"label":"升级4","jp":"この力があれば……先生の敵を全部薙ぎ払うことだって……！","fan":"只要有这份力量……即便是扫除老师的所有敌人也轻而易举……！","off":""},{"label":"获得专武","jp":"私なんかがこれをいただく資格なんて……い、いえ……先生が決めたことです。ありがとうございます！","fan":"我这种人有资格收下这个吗……不，既然是老师决定的事……非常感谢！","off":""}],"事件":[{"label":"学生生日","jp":"た、誕生日……私の！？えっ、ええっ！？祝ってくださるんですか！？ど、どうしましょう……パーティーの準備なんてできてなくて……。","fan":"生日……我的！？诶，诶诶！？要帮我庆祝吗！？怎、怎么办……我根本没做好派对的准备啊。","off":""},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。わ、私からのお祝いなんかでよければ……どうぞ、受け取ってください！","fan":"祝您生日快乐，老师。如、如果你愿意接受我的祝贺……请收下吧！","off":""},{"label":"万圣节","jp":"トリックオアトリート！あ、飴――がなければ弾丸を……！……こ、これで合ってますか？","fan":"Trick or Treat！啊，糖果——没有的话就用子弹……！……是、是这样吗？","off":""},{"label":"新年","jp":"明けましておめでとうございます……。あの……一年の始まりですよ……？私なんかと過ごしていて本当にいいんですか……？","fan":"新年快乐……那个，这可是新年的第一天……？和我这种人一起度过真的好吗……？","off":""},{"label":"圣诞节","jp":"メリークリスマス、です……！先生がご希望でしたら……サンタを捕獲してきます！","fan":"圣诞，快乐……！如果老师您希望的话……我可以去把圣诞老人抓来！","off":""}],"活动":[{"label":"活动登陆1","jp":"い、いつでもいけます！な、なんでも言ってください……！","fan":"我、随时都可以出发！请、请您尽管吩咐……！","off":""},{"label":"活动登陆2","jp":"あ、ありがとうございます……！えっ、あ、えっと……来てくださったことに対して、です。","fan":"谢、谢谢您……！呃，那个……我是指您能来这件事。","off":""},{"label":"活动大厅1","jp":"すみません！すみません！わ、私のせい、ですよね……","fan":"对不起！对不起！这、这都是我的错……","off":""},{"label":"活动大厅2","jp":"爆弾……弾薬……必要な物があれば何なりと……！","fan":"炸弹……弹药……需要什么尽管说！","off":""},{"label":"活动大厅3","jp":"なんだか大変な騒ぎになっていますね……。これを楽しいと思うのは……変、でしょうか？","fan":"感觉事情混乱起来了……。这种时候感到兴奋……会很奇怪，吗？","off":""},{"label":"活动大厅4","jp":"そういえば……オペラ……どんな内容だったんでしょう？どんな内容だったんでしょう？","fan":"说起来……那个歌剧的内容是什么？内容到底是什么呢？","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/191981/2026/4/29/1780057112909_1780057085669_vhj8ec1qnj_do7nu9oucb.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892432556_1779883551599_kp0vfbeg7e_rnjg89ggr7.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892434313_1779884879908_c2fc070dug_aj0spvlzix.ogg","",""],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892435937_1779884880200_xvzlsip7v7_efs2ps5qs1.ogg","",""],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892437572_1779883551601_pof86fk1cs_426rx0npuv.ogg","",""],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892439105_1779883551602_akaoosqdgo_996t71fthu.ogg","",""],"大厅及咖啡馆|大厅3":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892440825_1779884879602_g44n8i14jd_e7h019cm9r.ogg","",""],"大厅及咖啡馆|大厅4":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892442375_1779883551604_rvwb3ro9lh_7owe83908e.ogg","",""],"大厅及咖啡馆|大厅5":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892444306_1779883551604_znm8pvp7jk_k4gyn99ya2.ogg","",""],"大厅及咖啡馆|回忆大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/