/www.gamekee.com/ba/647107.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案","off":""},{"label":"卡池抽取","jp":"電子の領域を制する最も合理的な答えを、\n貴方に見せてあげる。","fan":"让我来为你揭示，\n支配电子领域最为合理的答案。","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"待っていたわ、先生。\n効率的な業務サポートを\n提供してあげる。\n合理的でしょう？","fan":"恭候多时了，老师。\n我将为您提供高效的业务支持。\n很合理吧？","off":""},{"label":"登陆2","jp":"仕事を始めるのね。\n何でも言ってちょうだい。","fan":"要开始工作了是吧。\n有什么需要尽管吩咐。","off":""},{"label":"大厅1","jp":"時間は流れていない……\nという話があるのだけれど。 \n過去、現在、未来が全て同じ\n瞬間に存在するという説よ。 \nその理論なら……\n今も、あの大きな事件の渦中に\nあるということになるわね。","fan":"时间其实并未流逝……\n曾有这样一种说法呢。\n过去、现在、未来都存在于\n同一瞬间的假说。\n按照那个理论的话……\n我们此刻，也依然身处\n那场巨大事件的漩涡中心呢。","off":""},{"label":"大厅2","jp":"正直、貴方のPCの\n中身に興味があるの。 \nこのスーツがあれば、\n先生のデバイス程度、\n容易にハッキングできる。\n……安心してちょうだい。\nそういったやり方は……\n好まないから。","fan":"坦白说，\n我对您电脑里的内容很感兴趣。\n只要有了这套装备，\n要入侵老师您的设备，\n简直易如反掌。\n……请放心。\n那种手段……\n我并不喜欢。","off":""},{"label":"大厅3","jp":"観測可能な世界の向こうには、\n何があるのかしら。\n私はその答えが知りたい。\n……貴方と一緒に、よ。","fan":"在可观测世界的彼端，\n究竟存在着什么呢？\n我想知道那个答案。\n……与你一起。","off":""},{"label":"大厅4","jp":"先生のスーツも\n用意すれば良かったわね。 \nそうしたら、一緒に概念空間を\n楽しむことができたのに。\n……現実でこのまま\n出かければ良い？\nこの格好ではダメよ。","fan":"真该给老师您也准备一套装备呢。\n那样就能和您一同领略概念空间的妙趣了。\n……现在就以这身行头\n直接出门合适吗？\n这身打扮可不行呢。","off":""},{"label":"大厅5","jp":"重力は、どこにでも存在する。\n……そう、貴方と私の間にも。\n私たちは無意識に、\n互いの方向へ落ちているのよ。","fan":"引力，无处不在。\n……是的，即便在你我之间。\n我们都在不知不觉中，\n向着彼此的方向坠落呢。","off":""},{"label":"回忆大厅1","jp":"ふぅ……落ち着いたわ。","fan":"呼……总算平静下来了。","off":""},{"label":"回忆大厅2","jp":"室内温度を\n考慮していなかったの。\n私としたことが……\n目の前の結果に、気を\n取られてしまったみたい……。","fan":"是我疏忽了……\n没考虑到室温的问题。\n明明不该犯这种错误……\n看来是太专注于眼前的结果了……","off":""},{"label":"回忆大厅3","jp":"……少し、休ませてちょうだい。\n暑さで、思考があまり……。","fan":"……请让我稍微休息一下。\n高温让我的思维有些……难以集中。","off":""},{"label":"回忆大厅4","jp":"……先生？\nどうしてそんな顔で……。","fan":"……老师？\n您为什么这样看着我……","off":""},{"label":"回忆大厅5","jp":"……あ！！\n（わ、私は……なにを……！？）","fan":"……啊！！\n（我、我这是……在说什么……！？）","off":""},{"label":"回忆大厅6","jp":"こ、これは\nわざとじゃないの……！\nごめんなさい……！\nわ、私はもう、\n大丈夫だから……！","fan":"这、这不是故意的……！\n对不起……！\n我、我已经没事了……\n所以……","off":""},{"label":"咖啡馆1","jp":"ここも概念空間の\n一種……要分析ね。","fan":"这里也是概念空间的一种类型呢……需要分析。","off":""},{"label":"咖啡馆2","jp":"片づけが上手く\nできるように\nなりたい……。","fan":"なりたい……。\n我想学会好好地整理打扫……","off":""},{"label":"咖啡馆3","jp":"……どうやら、\n先生の感性は\n私と近いようね。","fan":"……看来老师的感性和我很相近呢。","off":""},{"label":"咖啡馆4","jp":"「アバンギャルド君\nType.メイド」を\n作ったら、ここに\n置こうかしら。","fan":"等我把「前卫君\n·女仆形态」做好后，\n就放在这里吧。","off":""},{"label":"咖啡馆5","jp":"できる限り……\nきれいに使うわ。","fan":"我会尽量保持整洁地使用……","off":""}],"好感度":[{"label":"好感度1","jp":"突然、体が火照ってきたのだけれど……。スーツの保温機能のせい、かしら。","fan":"身体突然开始发热了呢……难道是这套装备的保温功能在运作？","off":""},{"label":"好感度2","jp":"これが……不確かなものが輪郭を持つ瞬間、なのね。","fan":"原来这就是……模糊之物获得轮廓的瞬间啊。","off":""},{"label":"好感度3","jp":"このやり取りに感じる既視感は……概念空間でシミュレーションしていたから……かもしれないわね。","fan":"这番对话带来的既视感……或许是因为我在概念空间里模拟过类似的场景吧。","off":""},{"label":"好感度4","jp":"先生はスーツ姿のほうが好き、なのかしら？……いえ、質問に深い意味は……ないわ。","fan":"老师更喜欢看我穿装备的样子吗？……不，这个问题并没有什么深意……","off":""}],"战斗":[{"label":"编入队伍1","jp":"電子戦が必要なのね？","fan":"需要进行电子战了吗？","off":""},{"label":"编入队伍2","jp":"このスーツの力、見せてあげる。","fan":"让你见识下这套装备的力量。","off":""},{"label":"拎起","jp":"少し……しめつけが苦しいのだけれど……。","fan":"这装备……稍微有些紧得不舒服呢……","off":""},{"label":"任命队长1","jp":"貴方の指揮と私の分析。合理的な組み合わせね。","fan":"你的指挥和我的分析。真是合理的组合呢。","off":""},{"label":"任命队长2","jp":"観測対象の分析は終わっているわ。あとは実戦だけ。","fan":"观测对象的分析已完成，接下来就只剩实战验证了。","off":""},{"label":"普通技能","jp":"最適化、完了。","fan":"最优化，完成。","off":""},{"label":"EX动画1","jp":"敗北は――決定事項よ","fan":"你的败北——已是既定事项。","off":""},{"label":"EX动画2","jp":"スキャン開始。お見通しよ。","fan":"开始扫描。一切尽在掌握。","off":""},{"label":"EX动画3","jp":"仮説の未来を――合理的な現実に。","fan":"将假设的未来——转化为合理的现实。","off":""},{"label":"EX技能1","jp":"ターゲットとして最適ね。","fan":"作为目标再合适不过了。","off":""},{"label":"EX技能2","jp":"制圧するわ。","fan":"开始压制。","off":""},{"label":"EX技能3","jp":"これが電子の力よ。","fan":"这就是电子之力。","off":""},{"label":"战斗开始1","jp":"現場対応も問題ないわ。","fan":"现场应对没有问题。","off":""},{"label":"战斗开始2","jp":"リソースを総動員しましょう","fan":"让我们全面调动资源吧。","off":""},{"label":"获得BUFF","jp":"合理的ね","fan":"很合理呢。","off":""},{"label":"施放BUFF","jp":"予測通り","fan":"符合预测。","off":""},{"label":"掩体","jp":"無駄よ","fan":"没用的。","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"被CC3","jp":"ジャミングが...","fan":"干扰系统被......","off":""},{"label":"回避","jp":"通らないわ。","fan":"此路不通。","off":""},{"label":"队伍移动1","jp":"戦況予測を続けるわ","fan":"我会持续进行战况预测。","off":""},{"label":"队伍移动2","jp":"次の概念空間へ","fan":"前往下一个概念空间。","off":""},{"label":"回复","jp":"荷が軽くなったわ。","fan":"负担减轻了呢。","off":""},{"label":"中途退出","jp":"現場は変数が多すぎる...","fan":"现场的不确定因素太多了...","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"角色移动","jp":"戦術的優位性の確保を。","fan":"确保战术上的优势地位。","off":""},{"label":"战斗胜利1","jp":"芸術的な勝利ね。","fan":"真是艺术性的胜利呢。","off":""},{"label":"战斗胜利2","jp":"これは貴方と見つけた、無限の可能性。","fan":"这是与你一同发现的，无限可能性。","off":""},{"label":"关卡完成1","jp":"合理的な指揮だったわね。","fan":"很合理的指挥呢。","off":""},{"label":"关卡完成2","jp":"概念空間の合理性が立証できたわね。","fan":"概念空间的合理性得到了验证呢。","off":""},{"label":"战斗失败1","jp":"ごめんなさい、分析が足りなかったわ。","fan":"抱歉，分析得不够充分。","off":""},{"label":"战斗失败2","jp":"これは......想定外だたは。","fan":".....这是预料之外的。","off":""}],"成长":[{"label":"升级1","jp":"装備のアップグレードに成功したわ。先生のおかげよ。","fan":"装备升级成功。这都多亏了老师呢。","off":""},{"label":"升级2","jp":"私たちは相互補完的関係。そう解釈して良いのかしら？","fan":"我们是互补的关系。这样理解可以吗？","off":""},{"label":"升级3","jp":"私にこれだけのリソースを投じるなんて……ええ、その意味は理解しているわ。","fan":"居然为我投入如此多的资源……嗯，我明白这其中的含义。","off":""},{"label":"升级4","jp":"先生のおかげで……「感謝」という感情に気づけたの。……話は、それだけよ。","fan":"托老师的福……我才意识到“感谢”这种感情的存在。……只是说说而已。","off":""},{"label":"获得专武","jp":"みんなを守って見せる……\nその強い意志が、\n私に引き金を引かせるの。","fan":"我一定会守护好大家……\n这份坚定的意志，\n将成为我行动的原动力。","off":""}],"事件":[{"label":"学生生日","jp":"ああ、今日は私の誕生日……\nだったのね。\n任務に没頭していたから、\n忘れていたわ。 \n何かに集中すると……他に\n気が回らなくなってしまうの。\n先生のおかげで、\n良い思い出ができたわ。\nありがとう。","fan":"啊，原来今天是我的生日……都忘记了。\n因为一直埋头于任务，完全没注意到呢。\n我一专注起来……就容易忽略其他事情。\n多亏了老师，我留下了美好的回忆。\n谢谢你。","off":""},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\nプレゼントに、\n業務サポート特化型の\nアバンギャルド君を用意したわ。\n……えっ？サポートなら\n私から直接、受けたい……？\nそ、それは……困るわ……。","fan":"老师，生日快乐。\n作为礼物，我准备了专门优化业务支持的前卫君为您服务。\n……诶？希望由我本人直接提供支持……？\n这、这可有点……让人困扰呢……","off":""},{"label":"万圣节","jp":"幽霊？私は信じていないわ。\n重力や電磁気力と\n相互作用できない存在は、\n私たちの目では\n捉えられないもの。\n……よく分からない？どうして？","fan":"幽灵？我可不相信那种东西。\n无法与重力或电磁力相互作用的存在，用我们的肉眼是捕捉不到的。\n……不太明白？怎么会呢？","off":""},{"label":"新年","jp":"先生、明けましておめでとう。\nお正月には、\n適した服装があるのでしょう？\n……これで大丈夫かしら。 \n大歓迎……？\nなら……良いのだけれど。","fan":"老师，新年快乐。\n正月里，应该穿适合的服装吧？\n……我这样打扮可以吗？\n非常欢迎……？\n那……我就放心了。","off":""},{"label":"圣诞节","jp":"今日は、ある人の\n誕生を祝う日らしいわね。\nあまりそういったものは\n理解できないのだけれど、\nこの時間を作ってもらえた\nことには……お礼を言うわ。","fan":"今天似乎是庆祝某个人诞生的日子呢。\n虽然我不太能理解这类事情，但还是要感谢你特意为我留出这段时间。","off":""}],"活动":[{"label":"活动登陆1","jp":"この結果を、どう解釈すれば……。","fan":"这个结果，该如何解读呢......","off":""},{"label":"活动登陆2","jp":"ここは格納庫……だったのだけれど、多目的室のようになってきたわね。","fan":"这里原本是机库……不过，渐渐变成多功能室了呢。","off":""},{"label":"活动登陆3","jp":"アップグレードの準備が完了したわ。","fan":"升级的准备已经完成。","off":""},{"label":"活动大厅1","jp":"何か、打開策を……。","fan":"得找个突破口......","off":""},{"label":"活动大厅2","jp":"預言者のコアは、ここで分析しましょう。","fan":"就在这里分析预言者的核心吧。","off":""},{"label":"carrier_monolog_1","jp":"（私はいま、ここにいる……)\n(これは合理的な行動なのかしら……？）","fan":"（此时此刻，我就在这里……这真的是合理的行为吗……？）","off":""},{"label":"carrier_monolog_2","jp":"（こういう状況だからこそ)\n(ゲームをするのは合理的なのかもしれないわね……）","fan":"（正因为是这样的状况，玩玩游戏说不定反而是合理的呢……）","off":""},{"label":"carrier_monolog_3","jp":"ここは、あらゆる可能性に備えて……。","fan":"此处，正是为应对一切可能性而准备之地……","off":""},{"label":"carrier_monolog_4","jp":"（厨房を作っておいたのだけれど……)\n(やはり非合理的だったかしら……）","fan":"（虽然事先布置了厨房……果然还是不够合理吗……）","off":""},{"label":"carrier_monolog_5","jp":"（会話を上手に切り出すには、どうしたら……）","fan":"（要怎样才能自然地开启对话呢……）","off":""},{"label":"carrier_select_1","jp":"念のため、モニタリングを続けているわ。","fan":"为防万一，我会继续监控的。","off":""},{"label":"carrier_select_2","jp":"ゲーム機……単純な装置とプログラムに過ぎないのに……。","fan":"游戏机……明明只是简单的设备和程序而已……。","off":""},{"label":"carrier_select_3","jp":"（ゲーム開発部……ずっと思っていたのだけれど、)\n(予測の難しい子たちね……）","fan":"（游戏开发部……我一直觉得……真是群难以预料的孩子呢……）","off":""},{"label":"carrier_select_4","jp":"実は私……レトルト食品の調理にも失敗することがあるの……。","fan":"其实我……有时候连速食食品都会搞砸呢……","off":""},{"label":"carrier_select_5","jp":"（他人と会話をする方法……)\n（やはり、先生に相談を……）","fan":"（与他人交谈的方法……果然还是该找老师商量……）","off":""}]},"voiceAudi