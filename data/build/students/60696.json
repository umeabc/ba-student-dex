images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43758/2025/5/13/607559.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43758/2025/5/13/43000.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 桐乃（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43758/2025/5/13/708271.png","url":"https://www.gamekee.com/ba/617236.html"},{"name":"NPC 桐乃（偶像）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43758/2025/5/13/821951.png","url":"https://www.gamekee.com/ba/639186.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"ヴァルキューレ警察学校のキリノです！\nみなさん、手を上にあげて本官の指示に従ってください！","fan":"瓦尔基里警察学校的桐乃！\n大家，举起手来，听从本警官指示！","off":"我是瓦尔基里的桐乃，全都举起手来听我指示。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰りなさい、先生。\nよろしければ、すぐにパトロールに出ようと思うのですが\nご一緒にいかがですか？","fan":"欢迎回来，老师。\n我打算去巡逻，如果可以的话老师要一起吗？","off":"你回来了，老师。\n不介意的话现在马上出去巡逻，怎么样？"},{"label":"登陆2","jp":"お帰りなさい、先生。\nここに来るまでに怪しい人はいませんでしたか？","fan":"欢迎回来，老师。\n我来之前这里有可疑的人经过吗？","off":"您回来啦？老师。\n来的路上有没有看到可疑的人呢？"},{"label":"大厅1","jp":"……？本官に、何か問題でもありましたか……？","fan":"……？有什么问题要问本警官吗……？","off":"有什么要问本警员的吗？"},{"label":"大厅2","jp":"もっと……キヴォトスの生徒たちの力になりたいです。","fan":"更加……想要成为基沃托斯学生们的力量。","off":"我想帮助基沃托斯的人们。"},{"label":"大厅3","jp":"この辺りは美味しいお店が多くて、\nパトロールや当番で来るのが毎回楽しみです。","fan":"这附近好吃的店有很多，\n每次都很期待来这边巡逻值日。","off":"这附近好吃的可多了，每次巡逻和值班都盼着能来这。"},{"label":"大厅4","jp":"も、もちろんパトロールをサボるわけではありません！","fan":"当、当然不能逃班！","off":"但我巡逻的时候可没有偷懒啊。"},{"label":"大厅5","jp":"ミランダ警告の3つ目って……なんでしたっけ？","fan":"米兰达警告[1]的第三条……是什么来着？","off":"米兰达警告的第三条是什么来着？"},{"label":"回忆大厅1","jp":"（ど、どうしましょう……！\nふんっ、んっ……！は、外れない……！）","fan":"（怎、怎么办……！\n唔，呜……！摘、摘不下来了……！）","off":"怎么办？这个手铐解不开啊。"},{"label":"回忆大厅2","jp":"……え？い、いやいや！\n仮にも警察に属する本官が、鍵を失くすわけがないではありませんか！","fan":"……诶？没、没事没事！\n作为警察的本警官，怎么可能把钥匙弄丢！","off":"不会的，身为警员怎么可能把钥匙弄丢呢？"},{"label":"回忆大厅3","jp":"で、ですから、これは……。\nだ、脱出訓練の予行演習です！ \n想定外の事態が起きて、万が一拘束されてしまった時のために……\nこれより本官が、 脱出の仕方をお見せします！","fan":"所、所以说，我只是……\n我、我只是在做逃脱的演练！\n如果发生了预料外的事情，对万一被束缚起来的时候进行的演练……\n所以说本警官，就让您看看逃脱的方法！","off":"这是……是在演示套上方法，嘿嘿。\n本警员在亲自演示意外情况下双手被扣住时该如何逃生。"},{"label":"回忆大厅4","jp":"ご安心ください！\n本官のようにしっかり訓練を積んだ者であれば、\nこれくらい簡単ですから！","fan":"请放心吧！\n如果您也像本警官一样常年训练的话，\n这点小事十分轻松！","off":"请放心，嘿，对我这种训练有素的警员来说，这种情况是小菜一碟。"},{"label":"回忆大厅5","jp":"くうううっ……！ふぬぬぬぬぬぬっ……！\n……ごめんなさい。 助けてください、先生ぇ……。","fan":"唔呜呜呜……！哎呀呀呀呀呀呀……！\n……抱歉。请帮帮我，老师……","off":"对不起，请帮帮我老师。"},{"label":"咖啡馆1","jp":"本日も異常なし！","fan":"今天也没有异常！","off":"正在执勤，没有异常。"},{"label":"咖啡馆2","jp":"今日もキヴォトスは平和ですね！","fan":"今天的基沃托斯也很和平呢！","off":"基沃托斯今天也很和平啊。"},{"label":"咖啡馆3","jp":"どれどれ、ここに隠れてる犯罪者はいませんよね？","fan":"我看看我看看，没有藏在这里的罪犯吧？","off":"我看看这里应该不会躲着犯罪分子吧？"},{"label":"咖啡馆4","jp":"こういうのは、ルール的にセーフなのでしょうか？","fan":"这样，在规则上来说是安全的吗？","off":"把这种东西带进来合法吗？"},{"label":"咖啡馆5","jp":"あの人、なんだか見たことあるような……もしかして指名手配犯？","fan":"那个人，总觉得在哪里见过……难道是通缉犯？","off":"那个人怎么感觉有点眼熟呢？难道是悬赏通缉犯？"}],"好感度":[{"label":"好感度1","jp":"さすが先生ですね！","fan":"不愧是老师呢！","off":"不愧是老师啊。"},{"label":"好感度2","jp":"本官もいつか先生のような立派な大人になりたいです！","fan":"本警官也想要成为像老师一样出色的大人！","off":"本警员总有一天也要成为老师这样优秀的大人。"},{"label":"好感度3","jp":"（本官はまったく、これが業務に過ぎないのに、勘違いをするところでした）","fan":"（本警官也真是的，与老师不过是业务上的往来，我想多了）","off":"这只是工作而已，本警员差点就误会了。"},{"label":"好感度4","jp":"先生と生徒が恋愛をするというのは、キヴォトスでは犯罪ではありません！\nい、言いたいことはそれだけです……。","fan":"老师和学生恋爱，在基沃托斯不是犯罪！\n我、我想说的就是这个……","off":"在基沃托斯，跨越身份的恋爱并不算犯罪。我想说的就是这个。"}],"战斗":[{"label":"编入队伍1","jp":"出動ですか！？","fan":"要出动了吗？","off":"要出动了吗？"},{"label":"编入队伍2","jp":"準備完了です！","fan":"准备完毕！","off":"准备完毕。"},{"label":"拎起","jp":"ちょちょ、ちょっと待ってください！","fan":"请、请等一下！","off":"等一下。"},{"label":"任命队长1","jp":"市民の安全を最優先で行きましょう。","fan":"以市民的安全为首，出发吧。","off":"始终把市民的安全放在第一位。"},{"label":"任命队长2","jp":"犯罪者はどこですか？","fan":"罪犯在哪里？","off":"犯人在哪？"},{"label":"普通技能","jp":"くらえ！","fan":"接招！","off":"看招。"},{"label":"EX动画1","jp":"あなたには黙秘権があります。う、うわぁ！","fan":"你有沉默的权利。哇、哇！","off":"你有权，保持沉默。"},{"label":"EX动画2","jp":"このキヴォトスでの犯罪は許されな……うわぁー！","fan":"这里是基沃托斯，不允许犯罪……哇——！","off":"在基沃托斯，任何罪行终将绳之以……啊。"},{"label":"EX动画3","jp":"警告します！投降しなければ……うわぁ！","fan":"警告你！不投降的话就……哇！","off":"警告，不投降的话……"},{"label":"EX技能1","jp":"どうしようどうしよう……えいや！","fan":"怎么办怎么办怎么办……啊不要！","off":"怎么办？怎么办？——呀。"},{"label":"EX技能2","jp":"こ、公権力を投入します！","fan":"行、行使公权力！","off":"刑事执法权。"},{"label":"EX技能3","jp":"こ、こ、これでも食らっちゃってください！","fan":"请、请、请吃我这招吧！","off":"吃我这招。"},{"label":"战斗开始1","jp":"迅速に制圧します！","fan":"迅速地压制！","off":"迅速镇压。"},{"label":"战斗开始2","jp":"犯罪者は許しません！","fan":"绝不宽容罪犯！","off":"绝不姑息罪犯。"},{"label":"获得BUFF","jp":"ご支援、感謝します！","fan":"感谢支援！","off":"谢您的支援。"},{"label":"施放BUFF","jp":"本官が戦陣を切ります！","fan":"本官将切入战线！","off":"本警员将带头出风。"},{"label":"掩体","jp":"隠れます！","fan":"藏起来！","off":"寻找掩体。"},{"label":"被CC1","jp":"きゃあ！","fan":"呀！","off":""},{"label":"被CC2","jp":"うわぁ！","fan":"哇！","off":""},{"label":"被CC3","jp":"あうぅ……","fan":"啊呜……","off":""},{"label":"回避","jp":"抵抗しても無駄です！","fan":"反抗是没用的！","off":"无谓的抵抗。"},{"label":"队伍移动1","jp":"ここはもう、安全地帯になりました。","fan":"这里已经是安全地带了。","off":"已确保安全。"},{"label":"队伍移动2","jp":"次の区域へ移動しましょう。","fan":"向下一个区域移动吧。","off":"向下个区域移动。"},{"label":"回复","jp":"あ、ありがとうございます。","fan":"谢、谢谢。","off":""},{"label":"中途退出","jp":"追加支援を……要請します……","fan":"请求……援军支援……","off":""},{"label":"战斗喊叫","jp":"やぁあ！","fan":"呀！","off":""},{"label":"战斗喊叫","jp":"はぁあ！","fan":"哈！","off":""},{"label":"战斗喊叫","jp":"動くな","fan":"别动","off":""},{"label":"特殊载具","jp":"ポーピ君一号、出動します！","fan":"-","off":""},{"label":"特殊载具","jp":"警察です。後ろに下がってください！","fan":"我是警察。请退后！","off":""},{"label":"角色移动","jp":"移動します！","fan":"进行移动！","off":"移动。"},{"label":"战斗胜利1","jp":"任務、完了しました！","fan":"任务完成了！","off":"任务完成。"},{"label":"战斗胜利2","jp":"右、左……ふぅ、ここはもう安全です。","fan":"右、左……呼，这里已经安全了。","off":"左侧确认，右侧确认。哎，这里已经安全了。"},{"label":"关卡完成1","jp":"市民の皆さん、キヴォトスは今日も安全です。","fan":"市民们，今天的基沃托斯也很安全。","off":"各位市民，今天的基沃托斯也很安全。"},{"label":"关卡完成2","jp":"今日もパトロールにご協力してくださってありがとうございます。","fan":"感谢您今天对巡逻的配合。","off":"感谢您今天对巡逻的协助。"},{"label":"战斗失败1","jp":"正義は敗北……しません……！うぅ。","fan":"正义不会……失败……！呜。","off":"警员是不会失败的。"},{"label":"战斗失败2","jp":"本官のミスです……","fan":"本警官的疏忽……","off":"是本警员的失误。"}],"成长":[{"label":"升级1","jp":"ずっとこうやって努力していれば、いつか警備部への発令をいただけるのでしょうか……？","fan":"如果一直这样努力的话，什么时候能获得警备部的发令呢……？","off":"继续这样努力的话，我会不会被调到警备局呢？"},{"label":"升级2","jp":"キヴォトスの安全のために精進します！","fan":"为了基沃托斯的安全我要更加精进！","off":"为了基沃托斯的安全，我会全力以赴。"},{"label":"升级3","jp":"えへへ、今日は良い成果ですね。","fan":"诶嘿嘿，今天成果很不错呢。","off":"今天的训练成功，很不错。"},{"label":"升级4","jp":"本官のために力を貸してくださってありがとうございます。","fan":"非常感谢您借与本警官力量。","off":"感谢您的协助。"},{"label":"获得专武","jp":"この銃にふさわしいくらい、扱いが上手なれるよう精進しますね……！","fan":"这把枪似乎很称手呢，为了熟练地使用它我要更加精进呢……！","off":"为了配得上这把枪，我会努力练习射击的。"}],"事件":[{"label":"学生生日","jp":"私の誕生日を覚えていてくださったなんて……\n感激しました、先生！","fan":"您还记得我的生日啊……\n十分感激，老师！","off":"居然还记得我的生日，我太感动了，老师。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。\nただし、いくら誕生日だからってルール違反はダメですよ？","fan":"生日快乐，老师。\n但是，即使是生日也不能违反规则哦？","off":"老师生日快乐，不过就算是生日违规也要受罚的哦。"},{"label":"万圣节","jp":"あっ、またみだらな格好で街を歩く生徒たちが……！","fan":"啊，好多穿得乱七八糟的学生走在大街上……！","off":"又有人衣衫不整的在街上走来走去了。"},{"label":"新年","jp":"明けましておめでとうございます、先生。\n今年もキヴォトスの治安のために一緒に頑張りましょう！","fan":"新年快乐，老师。\n今年也一起为了基沃托斯的治安而努力吧！","off":"好热闹，新年也不能放松对市民安全的维护，老师和本警员一起巡逻吧。"},{"label":"圣诞节","jp":"市民の安全を守ることは年中無休！\nクリスマスでも 油断できません！","fan":"全年无休守护市民的安全！\n即使是圣诞节也不可松懈！","off":"保卫市民安全的工作，全年无休，圣诞节也不能松懈。"},{"label":"春节","jp":"","fan":"新的一年开始，老师今年也为了基沃托斯的安全，一起努力吧。","off":"新的一年开始，老师今年也为了基沃托斯的安全，一起努力吧。"},{"label":"中秋","jp":"","fan":"今晚巡逻的时候抬起头可以看到月亮，哎哎，老师你看月亮是不是很圆？","off":"今晚巡逻的时候抬起头可以看到月亮，哎哎，老师你看月亮是不是很圆？"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/952675.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/272321.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/3/767389.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/185001.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/110927.