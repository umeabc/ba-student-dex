_240/829/103682/2025/5/13/348530.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"瞬（幼女）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/109167.png","url":"https://www.gamekee.com/ba/86656.html"},{"name":"雪玲(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/5/24/21663711mqrzl03w.png","url":"https://www.gamekee.com/ba/tj/709617.html"},{"name":"瞬","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/269505.png","url":"https://www.gamekee.com/ba/68522.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"訓育支援部梅花園の教官、シュンです。\nうちの子たちをよろしくお願いいたしますね、せ・ん・せ・い？","fan":"训练支援部梅花园的教官，瞬。这里的小孩子们也请你多多关照，老~师。","off":"我是教育支援部【梅花园】的教官，瞬。我家的孩子，就拜托给您咯，老~师~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ、先生。お食事になさいますか、お風呂に入られますか？\nそれとも…授業？","fan":"欢迎呢，老师。您要先吃饭还是先洗澡？\n还是说…上课？","off":"您来啦，老师~您想先用餐呢，还是先入浴呢~或者……先工作？"},{"label":"登陆2","jp":"前回、途中で終わってしまった授業を再開しましょう、ふふ。","fan":"重新开始上次中途结束的课吧，呵呵。","off":"那么，就从上次课程中断的部分开始吧~呵呵~"},{"label":"大厅1","jp":"もう～、先生は私に甘えちゃダメですよ。\nでもたまにでしたら…大目に見てあげますよ？","fan":"真是的~老师不能再宠我了。\n但是偶尔的话……我就不客气了吧？","off":"老师真是的……不可以这样对我撒娇哦~嗯……只是偶尔的话，我可以不追究。"},{"label":"大厅2","jp":"ふふっ、今日もよろしくお願いいたしますね？","fan":"呵呵，今天也请多多关照吧？","off":"嗯哼哼~今天也要麻烦您多多照顾了~"},{"label":"大厅3","jp":"は～い、シュンですよ～","fan":"在~是瞬哦~","off":"啊~我是瞬哦~"},{"label":"大厅4","jp":"いい子、いい子～","fan":"真乖，真乖~","off":"好孩子~好孩子~"},{"label":"大厅5","jp":"また触ると…\nこらっ、って叱っちゃいますよ？","fan":"再摸的话…\n就，就骂你了哦？","off":"您再碰我的话，我可要大声批评您了哦。"},{"label":"回忆大厅1","jp":"あら、おめざめになりましたか？","fan":"呀，醒了吗？","off":"哎呀……您醒啦？"},{"label":"回忆大厅2","jp":"今日は本当に楽しかったです。","fan":"今天真的很开心。","off":"今天，我真的感觉非常开心。呵呵……"},{"label":"回忆大厅3","jp":"あら、もう子供たちが帰ってくる時間ですね。そろそろお仕事にお戻りなったほうが良いのでわ。","fan":"呀，差不多快到孩子们回来的时间了呢。该准备回去工作了。","off":"哎呀，现在这个时间，孩子们已经快要回来了吧。您是不是，差不多也应该回去工作了呢？"},{"label":"回忆大厅4","jp":"いえ、はやり、うへへ。もう少しゆっくりにしてください、先生。今日の授業は私が代わりますので。","fan":"没什么，果然，呵呵。请放松一下吧，老师。今天我为你代课","off":"啊……要不然，嘿嘿，还是在这多放松一会吧。老师，今天的工作我会替您完成的。"},{"label":"回忆大厅5","jp":"ああ、かわいい…","fan":"啊，好可爱...","off":"啊……真是可爱，嘿嘿。"},{"label":"咖啡馆1","jp":"あらまあ、カワイイ…","fan":"哎呀，真可爱...","off":"哎哟，真可爱~"},{"label":"咖啡馆2","jp":"ふふ、愛くるしいですね～","fan":"呵呵，太可爱啦~","off":"诶嘿嘿嘿，太讨人喜欢了。"},{"label":"咖啡馆3","jp":"ふふ、次はここへみんなを一緒に連れてきての授業にしましょうか？","fan":"呵呵，下次带大家一起来这里上课吧？","off":"诶嘿，下次就带大家来这里一起训练吧。"},{"label":"咖啡馆4","jp":"お昼寝の時間はまだなのに…なんだか眠くなってきました…","fan":"还没到午睡的时间……但总觉得困了…","off":"还没有到午睡的时间呢……可是总觉得有点困。"},{"label":"咖啡馆5","jp":"リンカはきちんと、子供たちの面倒を見られているでしょうか…","fan":"不知道凛华有没有好好照顾孩子们呢……","off":"不知道凛华有没有好好照顾孩子们呢。"}],"好感度":[{"label":"好感度1","jp":"先生とご一緒していると、私もたまには子供みたいに甘えたくなります。","fan":"和老师在一起的话，我偶尔也会想像孩子一样撒娇。","off":"和老师在一起的时候，我偶尔也想像个孩子一样撒娇。"},{"label":"好感度2","jp":"先生は本当に特別な方ですね。生徒たちにとっても私にとっても。","fan":"老师真是个特别的人，对学生们来说是，对我来说也是。","off":"老师……真的是个很特别的人呢。无论是对孩子们来说，还是对我来说。"},{"label":"好感度3","jp":"先生との授業、楽しみにしています。","fan":"和老师的课程，好期待啊。","off":"我很期待，和老师一起上课。"},{"label":"好感度4","jp":"この瞬間が永遠に続くといいですね。","fan":"希望这一刻能永远持续下去。","off":"真希望此时此刻，能永远持续下去。"}],"战斗":[{"label":"编入队伍1","jp":"うっふふ。素晴らしい選択ですね。","fan":"呵呵，真是个明智的选择啊。","off":"诶嘿嘿，选的不错"},{"label":"编入队伍2","jp":"お姉さんにお任せください。","fan":"交给姐姐吧。","off":"就交给姐姐吧~"},{"label":"拎起","jp":"あら？なにか、問題が？","fan":"哎呀？怎么了，有什么问题吗？","off":"哎呀……怎么了吗？"},{"label":"任命队长1","jp":"言うこと聞かない悪い子は、どこかなー？","fan":"不听话的坏孩子，在哪里呢—？","off":"不听话的坏孩子在哪里呀~"},{"label":"任命队长2","jp":"さぁー、かくれんぼスタートね！","fan":"那么，捉迷藏开始咯！","off":"来，开始捉迷藏啦~"},{"label":"普通技能","jp":"よいしょー！","fan":"好咧—！","off":"嘿咻~"},{"label":"EX动画1","jp":"悪い子発見！","fan":"坏孩子，发现！","off":"找到坏孩子了~"},{"label":"EX动画2","jp":"うふ、お姉さんがやるのをよく見ていてね。","fan":"哼，好好看着姐姐是怎么做的吧。","off":"诶嘿，要认真看姐姐的示范哦"},{"label":"EX动画3","jp":"これで終わらせてしまいましょう！","fan":"这下彻底结束吧！","off":"就这样结束吧~"},{"label":"EX技能1","jp":"めっ、ですよ？","fan":"不可以哟。","off":"这样，可不乖哟~\nEX技能2"},{"label":"EX技能2","jp":"バァン！","fan":"邦！","off":"磅"},{"label":"EX技能3","jp":"バァーン！","fan":"邦——！","off":"磅~"},{"label":"战斗开始1","jp":"さあ、みんなでお散歩に行きましょうか！","fan":"那么，大家一起去散步吧！","off":"来，大家一起去散步吧~"},{"label":"战斗开始2","jp":"みんなー、道に迷わないように気をつけてねー","fan":"大家—注意不要迷路咯—","off":"小朋友们，注意不要迷路啊~"},{"label":"获得BUFF","jp":"お手伝いありがとうございます。","fan":"谢谢你的帮助。","off":"非常感谢您的帮助。"},{"label":"施放BUFF","jp":"さあ、ちょっとだけ本気で行きましょうか。","fan":"那么，稍微认真一点吧。","off":"好，现在就稍微认真一点吧~"},{"label":"掩体","jp":"隠れます！","fan":"藏起来了！","off":"隐蔽起来~"},{"label":"被CC1","jp":"あら？","fan":"哎呀？","off":"哎呀~"},{"label":"被CC2","jp":"んっ！","fan":"嗯！","off":"……"},{"label":"被CC3","jp":"あぁ…！","fan":"啊...！","off":"……！"},{"label":"回避","jp":"うふふ、そんないたずらは通用しませんよ？","fan":"呵呵，那样的恶作剧是行不通的哦？","off":"诶嘿嘿，这种恶作剧对我可没用哟~"},{"label":"队伍移动1","jp":"みんなー、こっちよー。","fan":"大家，这边哦。","off":"小朋友们，来这边~"},{"label":"队伍移动2","jp":"道に迷わないように、気を付けてね。","fan":"小心别迷路咯。","off":"当心不要迷路哦~"},{"label":"回复","jp":"あらありがとう。","fan":"呀，谢谢。","off":"哎呀，谢谢~"},{"label":"中途退出","jp":"これ以上は……ごめんなさい……","fan":"不能再继续了…...对不起...…","off":"我没办法坚持了……对不起……"},{"label":"战斗喊叫","jp":"行きまーす！","fan":"出发","off":"我要开枪啦~"},{"label":"战斗喊叫","jp":"せーの。","fan":"准备。","off":"一、二~"},{"label":"战斗喊叫","jp":"覚悟して","fan":"做好觉悟吧。","off":"做好准备哟~"},{"label":"角色移动","jp":"場所を移動しまーす。","fan":"移动位置咯。","off":"我们去下一个地方吧~"},{"label":"战斗胜利1","jp":"みんなご苦労様でした！","fan":"大家辛苦啦！","off":"感谢大家的辛勤工作~"},{"label":"战斗胜利2","jp":"次からは仲良くするんですよ？","fan":"下次要好好相处哦？","off":"下次，我们要好好相处哦~"},{"label":"关卡完成1","jp":"えらいえらーい。みんなよくできました！","fan":"真棒真棒。大家都做的不错呢！","off":"很棒很棒~大家都做的很好~"},{"label":"关卡完成2","jp":"よくできましたみんな。おうちに帰ったら復習するのを忘れないでね。","fan":"干的真棒呢大家。回家后不要忘记复习哦。","off":"大家都干的很好~回家之后，别忘了复习哟。"},{"label":"战斗失败1","jp":"み、みんな、ケガはなかった？","fan":"大，大家，没受伤吧？","off":"啊，大家没有受伤吧！"},{"label":"战斗失败2","jp":"ごめんなさい……私の不注意でした。","fan":"对不起......是我不小心","off":"对不起……都是因为我不够谨慎……"}],"成长":[{"label":"升级1","jp":"成長はいつも気持ちの良いことですね","fan":"成长真让是件让人心情愉悦的事呢。","off":"成长，总是令人愉快呢。"},{"label":"升级2","jp":"体の隅々まで力が染み渡って、気分が高揚しますね～","fan":"力量渗透到身体的各个角落，心情也高涨起来了呢~","off":"力量，渗透到身体的每一个角落……感觉精神好振奋呢~"},{"label":"升级3","jp":"心も体も丈夫になりました～","fan":"身心都变得强壮了~","off":"身心，都更加强韧了~"},{"label":"升级4","jp":"子供達に教えるためには、私が率先して成長しないといけないでしょ","fan":"为了教导孩子们，我必须带头成长对吧？","off":"要教导孩子们，我应该先成长起来。对不对~"},{"label":"获得专武","jp":"これを使いたくはなかったのですけど……\nびしっとした愛のムチも、時には必要なのです。","fan":"虽然不想用这个……但是偶尔也需要用到渗透了爱的鞭子。","off":"虽然我不想用这个……但有的时候，爱的鞭策也是必要的。"}],"事件":[{"label":"学生生日","jp":"ふう…また一つ、年を取ってしまいましたね…\n私の年ですか？ふふ、秘密ですよ。","fan":"啊，又老了一岁呢。你问我今年多大？呵呵，是秘密哟。","off":"啊……年纪，又增长了一岁啊。啊，您问我的岁数吗？……哼哼，保~密~"},{"label":"老师生日","jp":"♪Happy birthday to you~♪Happy birthday to you~♪Happy birthday Dear Sensei~♪Happy birthday to you~♪","fan":"♪祝你生日快乐~♪祝你生日快乐~♪亲爱的老师~♪祝你生日快乐~♪","off":"祝你生日快乐~祝你生日快乐~老师生日快乐~祝你生日快乐~"},{"label":"万圣节","jp":"あら、子供たちがどこかで飴をたくさん貰ってきたようですね。\nトリック…なんでしたっけ？","fan":"呀，小孩子们不知道从哪里拿到了一堆糖果呢。不给糖就...啊，是怎么说的来着？","off":"哎呀，孩子们不知道从哪里拿了这么多糖呢。嗯……不给糖……就怎么来着？"},{"label":"新年","jp":"ふふ、今年も一年、よろしくお願いしますね～。","fan":"呵呵，今年也请多多关照了。","off":"嘿嘿，新的一年，也请老师多多关照啊。"},{"label":"圣诞节","jp":"しっ、先生。サンタの変装がバレないように気を付けてくださいね。\n子供たちの純粋な心は、何よりも大切なものなんですから","fan":"嘘，老师，请不要暴露圣诞老人的伪装。孩子们纯洁的心比什么都重要。","off":"嘘，老师，请小心别让人发现圣诞老人是您假扮的哦。孩子们纯洁的心灵可是最珍贵的宝物。"},{"label":"春节","jp":"","fan":"新春快乐，老师。新的一年，无论是梅花园的孩子们，还是我，都还请您多多关照。","off":"新春快乐，老师。新的一年，无论是梅花园的孩子们，还是我，都还请您多多关照。"},{"label":"中秋","jp":"","fan":"玄武商会那边送来了一些月饼。梅花园的孩子们已经吃过了，剩下的，就由我和老师一起分享吧。嘿嘿","off":"玄武商会那边送来了一些月饼。梅花园的孩子们已经吃过了，剩下的，就由我和老师一起分享吧。嘿嘿"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/22/196770.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/22/124529.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/3/17/73856.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/22/929568.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/22/537100.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/3/17/110855.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/22/463612.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/529495/2025/5/22/803083.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/3/17/10851.o