""},"giftTiers":[{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","items":[]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/13/465725.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/86528.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/834595.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/7531.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/376305.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/252337.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/67447.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/13/465725.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/86528.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/834595.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/7531.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/376305.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/252337.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/67447.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/629374.png","name":"书本之友","desc":"加上了不会弄脏手的特殊涂层的巧克力。在以志美子为首的读书人之间很受欢迎。"},"ability":{"attrs":[{"name":"生命值","value":"754"},{"name":"攻击力","value":"87"},{"name":"治愈力","value":"229"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/549588.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/161435.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"NPC 志美子（魔法）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_500/h_507/829/191981/2025/9/22/214279.png","url":"https://www.gamekee.com/ba/680448.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"本の中の物語のように、私たちの物語が、始まります！","fan":"就像书中的故事一样，属于我们的故事，也开始了！","off":"就和书里的故事一样，我们的故事也要开始了！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰りなさい、先生！\n前にお渡しした本は読んでみましたか？","fan":"欢迎回来，老师！\n之前我给您的书要看看吗？","off":"欢迎回来，老师！\n之前我给您的书，您都看完了吗？"},{"label":"登陆2","jp":"今日はどんな本をおすすめしましょう？","fan":"今天推荐什么样的书呢？","off":"今天，给您推荐些什么书好呢？"},{"label":"大厅1","jp":"お小遣いをもらったら、まず本を買います。服や食事はその次です。","fan":"如果拿到零花钱的话，第一件事就是买书。衣服呀吃饭什么的可以先放放。","off":"拿到零花钱之后，我会先去买书，然后才会买衣服和吃的。"},{"label":"大厅2","jp":"どんな本が好きか、ですか？\nうーん…私は好き嫌いなく全部読みますから…。","fan":"您问我喜欢什么类型的书吗？\n唔……因为我没有讨厌或喜欢的，我什么书都读……","off":"您问我喜欢读什么书……？嗯……我不挑剔的，不管什么书我都会看。"},{"label":"大厅3","jp":"先生、その本はおすすめしませんよ。\nそこから4ページ先で、主人公があっけなく死んでしまいますから\n…あれ、私ネタバレしちゃいました？","fan":"老师，我不推荐您看这本书哦。\n因为从这里起4页之后，主人公就毫无悬念地死掉了\n……啊咧，我剧透了吗？","off":"老师，我不建议您看那本书哦。因为您再往下翻四页，主角就莫名其妙地死掉了。……呃，我是不是剧透了？"},{"label":"大厅4","jp":"ここにも、もう少し本があった方が良さそうなのですが…。\n私が何冊か、おすすめの本をお持ちしましょうか？","fan":"这里好像也有一些书比较好…。\n我给您拿几本推荐的书吧？","off":"这也应该再多放点书的。要不我带几本推荐的书过来吧~"},{"label":"大厅5","jp":"みんなにもっと、本を読んでほしいのですが…","fan":"我想让大家多读点书…","off":"真希望大家都能多读点书……"},{"label":"回忆大厅1","jp":"えっと……ぐ、偶然ですね。\nまさかぴったり同じタイミングで……。\n先に見つけて、先生にご報告したかったのですが……","fan":"那个……真、真巧呢。\n没想到正好一起找到了……。\n我还想着先找到来给老师报告的……","off":""},{"label":"回忆大厅2","jp":"……いえ。先に手をかけたのは私かもしれません……よね？\nうーん、どうしましょう。\nどうしてもと仰るのなら、譲っても良いのですが……","fan":"……不。说不定是我先拿到的……对吧？\n唔，怎么办呢。\n如果您无论如何都要争的话，我倒是可以让给您……","off":""},{"label":"回忆大厅3","jp":"……なんて、冗談です。\n貸し出し記録を付けて、すぐお渡しします。無事に見つかって何よりです。","fan":"……什么啊，开玩笑的。\n写好借书记录就给您。顺利找到真是太好了。","off":""},{"label":"回忆大厅4","jp":"どうでしたか？\n図書館でのこういった時間も……何だか楽しくありません？\n他では味わえない良さと言いますか、この場所ならではと言いますか……","fan":"您感觉如何呢？\n像这样在图书馆里的时间……不觉得很快乐吗？\n可以说是在其他地方体会不到，仅属于这个场所的快乐吧……","off":""},{"label":"回忆大厅5","jp":"……ですので、ぜひこれからも。\nお好きなタイミングでここに来てください。\n……私、 待ってますから！","fan":"所以，请今后也要来这里。\n您可以在喜欢的时间来这里。\n……因为，我会在这里等着老师！","off":""},{"label":"咖啡馆1","jp":"ふふふふふっ！\nフラグが立ちましたよ～。","fan":"呼呼呼呼呼！\n立起了flag哦~","off":"诶嘿嘿，竖旗咯~"},{"label":"咖啡馆2","jp":"ふふ、うふふ！\n良いアイデアが浮かびました！","fan":"呼呼，库呼呼！\n想到了一个好点子！","off":"诶嘿，诶嘿嘿……我想到了一个好主意。"},{"label":"咖啡馆3","jp":"本が足りていませんね。\n本棚をいっぱいにしないとです。","fan":"书不够地方放啦。\n必须要好多个书架。","off":"书有点少啊……看来，需要把书架放满一点。"},{"label":"咖啡馆4","jp":"わあ、本を読むのには最適なお部屋ですね。","fan":"哇，真是个适合看书的房间呢。","off":"啊……这个屋子，太适合看书了~"},{"label":"咖啡馆5","jp":"あっ、この本見たことありません！","fan":"啊，这本书我还没有见过！","off":"啊，这本书我没看过……"}],"好感度":[{"label":"好感度1","jp":"愛がどんなものか、知ってます！本でしっかり学びましたから","fan":"爱是什么，我知道的！因为我认真地从书里学习了。","off":"爱是什么……？我知道哦。我从书里学到了很多。"},{"label":"好感度2","jp":"ふふっ、まるでいい本を読んだ後のような幸せの気持ちです。","fan":"呼呼，这简直就像读了一本好书之后幸福的心情。","off":"啊，感觉好幸福~简直就像是，刚刚读完了一本好书。"},{"label":"好感度3","jp":"書物では学べないものがありました。例えば、先生のこととか。","fan":"也有书本里学不到的东西。比如说，关于老师的事情。","off":"也有一些东西，是我从书本中学不到的。比如说……关于老师的事情。"},{"label":"好感度4","jp":"知らなかったことを知ることができるのは、とてもうれしいことです。\n先生は私についてどれくらい知りたいですか。","fan":"知道了之前不知道的事情，是非常令人开心的一件事情。\n老师对于我的事情，有多想了解呢。","off":"能够学到新的知识，是一件非常值得高兴的事情。……老师，您想了解多少关于我的事情呢？"}],"战斗":[{"label":"编入队伍1","jp":"仕方ないですね…いきます！","fan":"没办法了呢…我上了！","off":"诶嘿嘿，真没办法呀。那我出发啦~"},{"label":"编入队伍2","jp":"私のことが欲しいのですか？","fan":"希望我上场吗？","off":"您需要我是嘛……？"},{"label":"拎起","jp":"素晴らしい物語に出会うととても幸せになるんです！","fan":"遇到精彩的故事就会非常幸福呢！","off":""},{"label":"普通技能","jp":"知識は心の糧ですね","fan":"知识是心灵的粮食呢。","off":"知识，真是心灵的食粮啊~"},{"label":"EX动画1","jp":"ふふ！面白いです！","fan":"呼呼！真有趣！","off":"好……好有意思啊~"},{"label":"EX动画2","jp":"おおー感動しました！","fan":"噢——感动到了！","off":"哦……我好感动~"},{"label":"EX动画3","jp":"ああ、これは愛？！","fan":"啊，这就是爱？！","off":"啊……这是，爱吗？"},{"label":"EX技能1","jp":"皆さん、もっと読書してください。","fan":"大家，请多多读书。","off":"各位，请多读书哦！"},{"label":"EX技能2","jp":"私と一緒に読書しましょう！","fan":"和我一起读书吧！","off":"和我一起来读书吧。"},{"label":"EX技能3","jp":"これもまた、本の力です！","fan":"这就是，书本的力量！","off":"这也算是，书本的力量！"},{"label":"战斗开始1","jp":"支援をお任せください～！","fan":"支援就交给我吧~！","off":"诶嘿，支援，就请交给我吧。"},{"label":"战斗开始2","jp":"えへへ、なんだか少しドキドキしましね。","fan":"诶嘿嘿，不知道为什么心怦怦跳起来了呢。","off":"诶嘿嘿，总觉得，有点激动啊。"}],"成长":[{"label":"升级1","jp":"ありがとうございます、先生！","fan":"谢谢，老师！","off":"老师，非常感谢！"},{"label":"升级2","jp":"本を読めば読むほど、強くなれます！","fan":"书读百遍，其意自现！","off":"书读的越多，就会变得越强。"},{"label":"升级3","jp":"本には、世界中の知恵が盛り込まれています！","fan":"书本中丰盈地承载着全世界的知识！","off":"书本中，包含了世界上所有的智慧！"},{"label":"升级4","jp":"また知識が増えましたねー！","fan":"知识又增加啦——！","off":"我的知识又增加啦……"},{"label":"获得专武","jp":"ふふ、返却期限を延滞してしまった方は覚悟してくださいね。","fan":"呵呵，逾期归还书籍的人可做好觉悟吧。","off":"诶嘿，借书逾期未还的人，请做好心理准备哟。"}],"事件":[{"label":"学生生日","jp":"ふふっ、私は心から本が好きですけど…。\n誕生日のたびに本ばかりをもらうのは、少しだけ残念でした。\n今日は、先生からの 特別なプレゼントが欲しいです！","fan":"呼呼，虽然我打心里喜欢着书…。\n但是在生日这天如果只收到书的话，还是多少有些遗憾。\n今天，想要老师送的特别礼物！","off":"诶嘿嘿，虽然我真的好爱看书，不过每次生日，大家送我的礼物都是书……总感觉，有点可惜……希望老师今天，能送我特别一点的礼物。"},{"label":"老师生日","jp":"お誕生日おめでとうございます。先生！\n欲しい本がありましたら、\n何でもおっしゃってくださいね！","fan":"生日快乐。老师！\n如果您有想看的书的话，\n都可以和我说哦！","off":"老师，祝您生日快乐！您有什么想看的书，请尽管告诉我吧。"},{"label":"万圣节","jp":"ハロウィーンが始まりました！\nふふっ、怪奇小説やホラー小説の\n特集を準備しないとですね。","fan":"万圣节开始啦！\n呼呼，必须要准备怪奇小说和恐怖小说的特集了呢。","off":"万圣节开始啦！嘿嘿，得准备怪奇小说和恐怖小说特辑啦。"},{"label":"新年","jp":"明けましておめでとうございます！\n今年も一年、よろしくお願いします。","fan":"新年快乐！\n今年一年也请多多关照了。","off":"恭祝新春快乐！今年，也请您多多指教啦。"},{"label":"圣诞节","jp":"メリークリスマ～ス。\n先生、今日は本当に特別な日なんですよ！\nこんな日に先生と 一緒にいられて…\n嬉しいです、ふふっ！","fan":"圣诞~快乐。\n老师，今天真的是很特别的一天哦！\n在这种日子能和老师在一起…\n我很开心，呼呼！","off":"圣诞快乐~！老师，今天是一个很特别的日子哦。这种日子能和老师在一起，真的很开心……嘿嘿。"},{"label":"春节","jp":"","fan":"祝您新春快乐。今年，也一起展开更精彩的旅程吧。不管是在书中，还是在生活中。","off":"祝您新春快乐。今年，也一起展开更精彩的旅程吧。不管是在书中，还是在生活中。"},{"label":"中秋","jp":"","fan":"老师，中秋节快乐。我看过的诗集里，有很多以中秋节为主题的作品呢。我最喜欢的是这句：但愿人长久，千里共婵娟。","off":"老师，中秋节快乐。我看过的诗集里，有很多以中秋节为主题的作品呢。我最喜欢的是这句：但愿人长久，千里共婵娟。"}