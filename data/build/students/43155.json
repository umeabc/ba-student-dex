om/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/188330.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/283726.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/77225.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/995886.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/84078.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/264432.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/49535.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/167702.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/188330.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/283726.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/883416.png","name":"幸运巧克力（自制）","desc":"千夏准备的命运巧克力，里面写着各式各样的句子。"},"ability":{"attrs":[{"name":"生命值","value":"858"},{"name":"攻击力","value":"56"},{"name":"治愈力","value":"336"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/333338.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/817564.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 千夏 （温泉）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/4/663431.png","url":"https://www.gamekee.com/ba/150145.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー、アーカイブ","fan":"碧蓝、档案。","off":"蔚蓝、档案。"},{"label":"卡池抽取","jp":"試練が怖いとき、苦難に負けそうなとき、私が一緒に立ち向かってあげましょう。","fan":"恐惧试炼的时候，快要向苦难低头的时候，让我陪您一起面对吧。","off":"当您害怕考验，无法战胜逆境的时候，就由我来陪您一起挑战吧。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ先生。先生の決裁待ちの書類がありますよ。","fan":"欢迎老师。这里是需要老师裁决的文件哦。","off":"您来了老师，这些文件需要您审批一下。"},{"label":"登陆2","jp":"風紀委員会は秩序を望みます。シャーレもそうではないのでしょうか？","fan":"风纪委员会期望秩序。夏莱也如此期望吗？","off":"风纪委员会最重视的就是秩序，沙勒应该也一样吧。"},{"label":"大厅1","jp":"一つ、私の秘密を教えますが…。\n私も注射はあまり好きではありません。","fan":"告诉您，我的一个秘密…。\n我不太喜欢打针。","off":"我偷偷告诉您一个秘密，其实..我也不太喜欢打针。"},{"label":"大厅2","jp":"バカは治療不可能です。ご存知なかったですか？","fan":"笨蛋是治不好的。您知道吗？","off":"傻是治不好的，您不知道吗？"},{"label":"大厅3","jp":"はい？少しは笑えと？\n…二人っきりの時だけなら、可能です。","fan":"什么？稍微笑一笑吗？\n...只能在，只有我们两个人的时候才可以。","off":"什么？让我多笑一笑？只有我们两个人的时候..可以。"},{"label":"大厅4","jp":"(…とりあえず気絶させて人工呼吸をすれば…）\n（それはノーカウント…？)","fan":"（...总之先敲昏再进行人工呼吸...）\n（这不算分吗...？）","off":"总之先弄晕，再做人工呼吸的话..那样不算吗？（心声）"},{"label":"大厅5","jp":"はい？何を考えているか、ですか？\n…何でもありません。","fan":"什么？我在想什么、吗？\n...没想什么。","off":"什么？您问我在想什么？我没想什么.."},{"label":"回忆大厅1","jp":"あ、あまり意識してませんでしたが…。\nこの状況はその、あまり良くないと言いますか…","fan":"我、之前没有太往那个方向想过...。\n怎么说，好像有点不太合适...","off":""},{"label":"回忆大厅2","jp":"あの、先生…？えっと、何か言っていただけないと、その…。\nあまり沈黙が続くと、かえって変な感じに…。","fan":"那个，老师...？就是，您一直不说话的话，有点...。\n如果一直沉默的话，反而有点怪怪的...。","off":""},{"label":"回忆大厅3","jp":"いえ、その催促とかではないのですが…！\nえっと、何と言えば良いのでしょうか…。\nこういう時は、どうしたら…。","fan":"不是的，我并不是在催促您出声...！\n那个，该怎么说呢...。\n这种时候，该做点什么...。","off":""},{"label":"回忆大厅4","jp":"…ふぅ。いえ…大丈夫です、はい。\nふふっ。本当に、困ってしまいます…\n何なんでしょうね、これは。","fan":"…呼。没...我没事，嗯。\n呵呵。真的是，有点伤脑筋呢...\n我这是怎么了。","off":""},{"label":"回忆大厅5","jp":"先生と一緒にいるというだけで、何故かいつも通りではいられなくて…。\n本当に、困りましたね…色々と…。","fan":"只要是和老师在一起，脑子里就不停地闪过各种画面...。\n真的是，很伤脑筋呢...各方面...。","off":""},{"label":"咖啡馆1","jp":"ここの衛生状態は…素晴らしいですね","fan":"这里的卫生条件...真不错呢。","off":"这里的卫生状况，非常不错！"},{"label":"咖啡馆2","jp":"体温平熱、脈拍正常。ふむ。問題ないですね","fan":"体温正常，脉象正常。呼姆。没问题呢","off":"体温正常，脉搏正常，嗯，没有问题。"},{"label":"咖啡馆3","jp":"そろそろ医薬品を確保しないと","fan":"差不多该准备医药品了。","off":"差不多该准备些医疗用品了。"},{"label":"咖啡馆4","jp":"ふむ。まあ、悪くはないです","fan":"呼姆。嘛，也不赖","off":"嗯，嗯..还算可以吧！"},{"label":"咖啡馆5","jp":"居心地が良いですね","fan":"真舒服呢。","off":"您看起来心情不错呀！"}],"好感度":[{"label":"好感度1","jp":"先生と一緒にいると心拍数に異常が見られます。\n私は医療担当なのに、困りますね…。","fan":"只要和老师在一起心率就会出现异常\n我作为医疗担当，真的很困扰呢...","off":"和老师在一起的时候，我的心率有些异常，明明自己就是负责医疗的，伤脑筋啊.."},{"label":"好感度2","jp":"ふふ、先生は変わっていますね。","fan":"呵呵，老师真的很奇怪呢。","off":"老师真是个奇怪的人。"},{"label":"好感度3","jp":"顔が熱い気がします、風邪ではないようなのですが…おかしいですね。","fan":"感觉脸好热，可是明明没有感冒...真奇怪呢。","off":"我的脸好热，应该没有感冒啊，好奇怪。"},{"label":"好感度4","jp":"先生は本当に手がかかる人ですね。\nそういうところも、嫌いではないですけど…。","fan":"老师真是爱管闲事的人呢。\n不过我也不讨厌这一点啦...","off":"老师真的是一个非常需要照顾的人，不过我并不讨厌您这一点。"}],"战斗":[{"label":"编入队伍1","jp":"医療支援はお任せください。","fan":"医疗支援请交给我吧。","off":"医疗支援请交给我吧。"},{"label":"编入队伍2","jp":"出撃の時間ですね。","fan":"到了出击的时间了。","off":"是时候出击了。"},{"label":"拎起","jp":"少し、我慢してくださいね。チクッとしますよ。","fan":"稍微忍耐一下哦。会有一点痛的。","off":""},{"label":"普通技能","jp":"バイタル正常。進んでください。","fan":"生命征象正常。请前进吧。","off":"生命体征正常，请继续前进。"},{"label":"EX动画1","jp":"痛いですか？ではこちらを。","fan":"疼吗？到我这边来吧。","off":"很疼么？那就用这个。"},{"label":"EX动画2","jp":"助けが必要なら、私にお任せください！","fan":"如果需要救助，就请交给我吧！","off":"如果需要帮助，就请交给我。"},{"label":"EX动画3","jp":"薬品ではありません。未来です。","fan":"不是药品。而是未来。","off":"这不是药品，是未来。"},{"label":"EX技能1","jp":"ここからは、あなたの意志にかかっています。","fan":"接下来就要靠你的意志了。","off":"从现在开始，就要靠您的意志了。"},{"label":"EX技能2","jp":"諦めないでください。","fan":"请不要放弃。","off":"请不要放弃。"},{"label":"EX技能3","jp":"私の薬があなたを救うでしょう。","fan":"我的药会救你的。","off":"我的药，应该可以救您。"},{"label":"战斗开始1","jp":"ちなつ、参戦します。","fan":"千夏，参战。","off":"千夏，参战。"},{"label":"战斗开始2","jp":"助けが必要な時は、私を呼んでください。","fan":"需要救助的时候，请吩咐。","off":"需要帮助的时候，请叫我一声。"}],"成长":[{"label":"升级1","jp":"成長しました。","fan":"我成长了。","off":"我成长了。"},{"label":"升级2","jp":"最善を尽くして、精進いたします。","fan":"我会尽最大努力，不断精进。","off":"我会尽力做到最好的。"},{"label":"升级3","jp":"これからはもっと、先生のお役に立てそうです。","fan":"这下一来应该可以多帮到老师一些了。","off":"以后应该能给老师帮上更多忙了。"},{"label":"升级4","jp":"より強くなれましたね。","fan":"变得更强了呢。","off":"我又变得更强了呀。"},{"label":"获得专武","jp":"より多くの人を治療するためにはもっと多くの力が必要だ、\nという現実は、面白くない皮肉ですね。\nそれでも私の能力でできる限り……最善を尽くします。","fan":"需要治疗更多的人，因而需要更强大的力量，\n这样的现实，一点也不好笑，真是讽刺呢。\n但尽管如此我也会尽我所能......做到最好。","off":"为了给更多的人治疗，就需要更强的力量，现实就是这样，真是一个不好笑的笑话，不过我会尽我所能，精益求精的。"}],"事件":[{"label":"学生生日","jp":"誕生日です。\n今日だけは、先生を独占してもよさそうですね。\n手を…握ってくれますか？","fan":"是生日。\n就今天一天，似乎独占老师也可以呢。\n能...牵我的手吗？","off":"今天我过生日，那么独占老师一下也可以吧，可以请您握住我的手吗？"},{"label":"老师生日","jp":"お誕生日おめでとうございます先生。\nちょうど良い栄養注射が入荷しました。\nズボンを下ろしてくださ…？いえお尻だけです！","fan":"生日快乐老师。\n刚好进货了一批非常上佳的营养注射剂。\n请您脱下裤...？只、只用露出屁股就可以了！","off":"祝您生日快乐，老师正好进了一批不错的营养针…啊！倒也不必，只是打针而已！"},{"label":"万圣节","jp":"先生にハロウィンのお祝いを。\n飴はいかがですか？\n無糖なので体にいいですよ。","fan":"祝老师万圣节快乐。\n来点糖怎么样？\n是不含糖分的所以很健康哦。","off":"老师，万圣节快乐，要来一点糖果吗？这是无糖的，很健康。"},{"label":"新年","jp":"明けましておめでとうございます先生。\n去年はバタバタしてましたけど…。\n…でも、先生がいてくれてよかったです。","fan":"新年快乐老师。\n虽然去年忙得手忙脚乱的......但是，有老师陪在身边真好。","off":"恭祝新春快乐，老师，去年一直忙的团团转，不过幸好有老师在。"},{"label":"圣诞节","jp":"クリスマスは好きです。街に赤の色が増えますから。\n先生も、赤色は好きですか？\n……言っておきますが、別に血が好きというわけではありませんよ。","fan":"我很喜欢圣诞节。因为街上多了好多赤色的颜色。\n老师也，喜欢赤色吗？\n……话先说在前面，我可不是因为喜欢血才喜欢赤色的哦。","off":"我喜欢圣诞节，因为这一天街道上的红色会变多，老师你也喜欢红色吗？啊，别想太多哦，并不是因为我喜欢血.."},{"label":"春节","jp":"","fan":"老师，祝您新春快乐。\n新的一年里，愿您劳逸结合张弛有度。","off":"老师，祝您新春快乐。\n新的一年里，愿您劳逸结合张弛有度。"},{"label":"中秋","jp":"","fan":"今天就暂停工作，稍稍喘口气如何？\n哎？要和我一起，这……我很荣幸。","off":"今天就暂停工作，稍稍喘口气如何？\n哎？要和我一起，这……我很荣幸。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/12/596744.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/18/317819.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/18/17219.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/12/439990.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/18/443740.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/18/253685.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/12/144477.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/18/7102.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/18/455760.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/