0/images/w_252/h_204/829/103682/2025/5/4/114514.png","url":"https://www.gamekee.com/ba/624154.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"-"},{"label":"卡池抽取","jp":"あっ。うん、ライディング中だったの。\n先生も一緒にどう？まずは軽く200kmくらい。","fan":"啊。嗯，我正在骑行中。\n老师也一起吗？先简简单单骑个200km吧。","off":"我正骑行，老师要不要一起先简单骑个200公里左右。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生。今から一緒にライディングに行かない？","fan":"欢迎回来，老师。现在要不要一起去骑行？","off":"你来了，老师。\n要不要跟我一起去骑行？"},{"label":"登陆2","jp":"待ってたよ。今度はどこに行こっか？","fan":"在等你哦。这次去哪儿？","off":"我正等着你呢，这次该去哪里转转呢？"},{"label":"大厅1","jp":"最近はケイデンスを上げるために練習してるの。\n低いギアでペダルをもっと速く回す方式だよ。","fan":"最近我为了提高回转速正在练习中。\n是在低速档下快速踩踏板的方式。","off":"最近我正在做提高频的练习，就是使用低档齿轮更快的踩动踏板。"},{"label":"大厅2","jp":"最近委員会の活動で忙しくて、ライディングをする時間があまりなくって。\nだから今日は久しぶりに走ってみようと思う。","fan":"最近因为委员会活动很忙，几乎没什么时间骑车。\n所以今天难得有机会要好好骑一下。","off":"最近在忙对策委员会的事，都没什么时间骑行了，所以今天我想痛快的骑一下。"},{"label":"大厅3","jp":"先生もライディング、やってみない？\n私が前で風を防ぐから先生はついてきてくれればいい。\nそうすればきっと走りやすいと思うから。","fan":"老师也想要学学看骑车吗？\n我在前面帮忙挡风，老师跟着我。\n这样会轻松不少。","off":"老师要不要也试试骑行，我在前面破风，\n老师跟在后面就好，这样能轻松不少。\n大厅4"},{"label":"大厅4","jp":"買いたい部品はいっぱいあるけど……\n我慢するしかないか。自転車の部品って高いから。","fan":"虽然我想买的零件有很多……\n但是只能忍着。因为自行车的零件很贵。","off":"虽然有好多想买的配件，不过自行车配件太贵，只能忍一忍了。"},{"label":"大厅5","jp":"実はこのジャージ、お揃いのものなんだけど、\nみんなに着たくないって言われちゃって……。\nとりあえず一人で着てる。","fan":"其实这件单衣，是大家都有的队服，\n但是大家都宁死不穿……。\n所以我自己先穿了。","off":"其实这套运动服是统一服装，\n不过因为大家都不想穿，所以暂时就只有我穿着而已。"},{"label":"回忆大厅1","jp":"……ありがと、先生。","fan":"……谢谢，老师。","off":"谢谢你，老师。"},{"label":"回忆大厅2","jp":"その、何て言うのかな……。\nこんな風にしっかり誰かにサポートしてもらったの、初めてで……。","fan":"那个，该怎么说呢……。\n这样被人帮助，还是第一次……","off":"该怎么说呢？\n我还是第一次像这样被人支持着。"},{"label":"回忆大厅3","jp":"……先生と一緒にいると、毎日色々、新しい事が起きるね。","fan":"……和老师在一起，每天都会发生各种各样，新鲜的事情。","off":"和老师在一起，每天都会遇到各种新鲜事呢。"},{"label":"回忆大厅4","jp":"（……？何でだろ。心臓の音、止まらない……）","fan":"（……？怎么回事呢。心跳的声音，无法停止……）","off":"心跳声停不下来。"},{"label":"回忆大厅5","jp":"……変なの。こういうのも、初めて。","fan":"……真奇怪啊。这样的感觉，还是第一次。","off":"好奇怪，这种感觉也是第一次。\n咖啡馆1"},{"label":"咖啡馆1","jp":"途中でバテないように、カロリーを摂取しておかないと。","fan":"为了骑行途中不疲惫，必须要摄入卡路里。","off":"必须摄取足量卡路里，路上才不会累。"},{"label":"咖啡馆2","jp":"グループライディングも楽しそうだけど……。","fan":"虽然团队骑行好像很好玩……。","off":"组队骑行应该也会很开心。"},{"label":"咖啡馆3","jp":"今日の平均速度は……うん、ちょっと速くなった感じ……。","fan":"今天的平均速度……嗯，感觉稍微变快了些……。","off":"今天的平均速度感觉比平时稍微快一些。"},{"label":"咖啡馆4","jp":"うーん……汗を乾かしたいけど。","fan":"嗯……虽然很想吹干汗水。","off":"我想先擦擦汗。"},{"label":"咖啡馆5","jp":"次はどこに行ってみようかな……。","fan":"下次去哪里呢……。","off":"下次要去哪儿呢？"}],"好感度":[{"label":"好感度1","jp":"一緒に過ごせて楽しい、先生。","fan":"和您一起很开心，老师。","off":"和老师在一起很开心。"},{"label":"好感度2","jp":"次もよろしくね。","fan":"下次也请多关照了。","off":"下次也请多关照的。"},{"label":"好感度3","jp":"気にかけてくれてありがとう。","fan":"谢谢你在意我。","off":"多谢关心。"},{"label":"好感度4","jp":"ん……またお世話になってしまった……。","fan":"嗯……又要麻烦您关照了……。","off":"又麻烦你了。"}],"战斗":[{"label":"编入队伍1","jp":"ん、準備は出来てる。","fan":"嗯，已经准备好了。","off":"准备好了。"},{"label":"编入队伍2","jp":"私？分かった。","fan":"我？明白了。","off":"我知道了。"},{"label":"拎起","jp":"んん…。","fan":"唔…。","off":""},{"label":"任命队长1","jp":"作戦は完璧。始めよう。","fan":"战略完美。出发吧。","off":"完美的作战计划，开始吧。"},{"label":"任命队长2","jp":"作戦開始。大丈夫、私について来て。","fan":"作战开始。没事，跟着我来。","off":"战斗开始。没关系，跟我来。"},{"label":"普通技能","jp":"","fan":"","off":""},{"label":"EX动画1","jp":"これを出す時が来たね。","fan":"该到了它出场的时候了呢。","off":"是时候拿出这个了。"},{"label":"EX动画2","jp":"出すつもりなかったんだけど。","fan":"虽然没准备用到它的。","off":"本来没准备用它的。"},{"label":"EX动画3","jp":"むぅ、仕方ない。","fan":"但是，没办法了。","off":"没办法了。"},{"label":"EX技能1","jp":"ライディング用グレネードだよ。","fan":"这是骑行用的手榴弹哦。","off":"骑行专用手榴弹。"},{"label":"EX技能2","jp":"自転車乗りの必需品だよ。","fan":"骑自行车的必备品哦。","off":"骑行必备。"},{"label":"EX技能3","jp":"効果抜群。","fan":"效果拔群。","off":"效果出众。"},{"label":"战斗开始1","jp":"さあ、出発しよう。","fan":"好了，出发吧。","off":"那么出发吧。"},{"label":"战斗开始2","jp":"始めよう。","fan":"开始吧。","off":"开始吧。"},{"label":"获得BUFF","jp":"ありがとう。","fan":"谢谢。","off":"-"},{"label":"施放BUFF","jp":"準備完了。","fan":"准备完毕。","off":"准备完毕。"},{"label":"掩体","jp":"いったん隠れる。","fan":"暂时隐藏起来。","off":"藏好了。"},{"label":"被CC1","jp":"-","fan":"","off":"-"},{"label":"被CC2","jp":"-","fan":"","off":"-"},{"label":"被CC3","jp":"これじゃ…。","fan":"这下…。","off":"这样的话。"},{"label":"回避","jp":"うん、問題ない。","fan":"嗯，没出问题。","off":"没问题。"},{"label":"队伍移动1","jp":"移動するよ。行こう。","fan":"移动咯。走吧。","off":"准备出发"},{"label":"队伍移动2","jp":"うん、じゃ次。","fan":"嗯，那么去下一处吧。","off":"下一个"},{"label":"回复","jp":"ありがとう、確かに受け取った。","fan":"谢谢，确实接收到了。","off":"谢谢，确实收到了。"},{"label":"中途退出","jp":"ごめん、こんなことになるなんて…","fan":"抱歉，让事情变成这样…。","off":"对不起，没想到会变成这样。"},{"label":"战斗喊叫","jp":"そこ！","fan":"那里！","off":"那边。"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"角色移动","jp":"まだまだやれる。","fan":"还能继续战斗。","off":"就是这种感觉。"},{"label":"战斗胜利1","jp":"うん…","fan":"唔…","off":"-"},{"label":"战斗胜利2","jp":"ふぅ…。お疲れ様。","fan":"呼…。辛苦了。","off":"辛苦了。"},{"label":"关卡完成1","jp":"うん、想定通り。","fan":"嗯，如预想的一样。","off":"符合预期。"},{"label":"关卡完成2","jp":"先生の指揮のおかげ。","fan":"多亏了老师的指挥。","off":"多亏了老师的指挥。"},{"label":"战斗失败1","jp":"準備が足りなかったみたい。","fan":"好像准备还有所不足。","off":"看来是我准备不足。"},{"label":"战斗失败2","jp":"作戦、完璧だったはずなのに…。","fan":"作战，本应该是完美的才对…。","off":"作战计划明明很完美啊。"}],"成长":[{"label":"升级1","jp":"トレーニングはずっと欠かしてない。もっともっと強くなれるはず。","fan":"一定不能疏于训练。必须要变得更强更强。","off":"我一直在训练，应该能变得更强。"},{"label":"升级2","jp":"まだまだ成長期、かも。","fan":"或许，还在成长期中。","off":"我还在成长期，大概。"},{"label":"升级3","jp":"先生、いつも助けてくれてありがとう。","fan":"老师，谢谢您一直帮助我。","off":"老师，谢谢你一直以来的帮助。"},{"label":"升级4","jp":"これでもっとスピードが出せるようになるはず。","fan":"应该还能骑得更快的。","off":"这样应该就能更快的。"},{"label":"获得专武","jp":"これはライディング用に特別に改造された軽量型個人向け火器。\n軽いから素早い戦術行動が可能になるし、\nもちろん長距離のライディングの時も負担にならないの。","fan":"这是为了骑行而特别改造的轻量型单人火器。\n因为很轻便所以可以用于快速的战术行动，\n当然也不会成为长距离骑行的负担。","off":"这是专为骑行特别改良过的轻量型单兵武器，因为轻便，可以采取更敏捷的战术行动，当然长途骑行时负担也比较小。"}],"事件":[{"label":"学生生日","jp":"私の誕生日？……ああ。\nもうそんな日か……\nあ、ありがとう。","fan":"我的生日？……啊。\n已经到这天了啊……\n谢、谢谢。","off":"我的生日？\n时间过得真快啊，谢……谢谢。"},{"label":"老师生日","jp":"今日って、先生のお誕生日……？\nそれじゃお祝いの意味で……\nライディング、行く？","fan":"今天是，老师的生日……？\n那么作为庆祝……\n骑行，去吗？","off":"生日嘛，\n为了庆祝老师的生日，要不要一起骑行？"},{"label":"万圣节","jp":"あ……ハロウィーン……今日だったっけ。\nえーと……それじゃあ、トリックオアライディング……？","fan":"啊……万圣节……是今天啊。\n那个……那么，不给糖就捣蛋……？","off":"万圣节原来就在今天，那不骑行就捣蛋。"},{"label":"新年","jp":"日の出が見られる山岳コースを知ってるの。\n一晩中走って、頂上から日が昇るのを見るんだ。\n一緒に行かない？標高２０００mくらいだから。","fan":"您知道可以看到日出的山地赛道吗。\n骑行一整晚，到达顶峰就可以看到升起的太阳。\n要一起去看看吗？因为海拔不过也就2000m左右。","off":"我知道一条可以看日出的山地路线，骑一晚上正好能在山顶看太阳升起，要不要一起去？海拔才2000米而已。"},{"label":"圣诞节","jp":"こんな日にも自転車かって？\nうーん……特に約束もなかったから……。\nだったら、今から先生と約束があったことにしよっか。\nえ、ライディング抜きで？う、うーん……。","fan":"这样的日子里也骑着自行车？\n嗯……因为也没有特殊的规定不许骑车嘛……。\n所以说，现在就开始做和老师约定好的事情吧。\n欸，那就从自行车上下来？啊，啊……。","off":"这种日子也骑自行车？\n因为我也没有别的约会，所以现在陪老师也可以啊\n不能去骑行？哦……"},{"label":"春节","jp":"","fan":"是新年，今天先休息一天，老师新的一年也请多多指教了。","off":"是新年，今天先休息一天，老师新的一年也请多多指教了。"},{"label":"中秋","jp":"","fan":"偶尔在月光下骑行，也是很新鲜的体验呢。","off":"偶尔在月光下骑行，也是很新鲜的体验呢。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/4/36734.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/983686.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/680345.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/4/62954.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/457164.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/748454.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/4/588543.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/73471.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/2632.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/4/887742.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/561917.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/23819.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/4/597700.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/476733.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/680552.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/4/903262.ogg","ht