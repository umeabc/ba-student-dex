s":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"黒崎 コユキ（パジャマ）","kana":"黒崎 くろさき","twName":"小雪（睡衣）","cnName":"小雪（睡衣）","age":"15岁","birthday":"2月14日","height":"149cm","hobby":"碰运气、逃脱","designer":"不用写","artist":"Blanchat","cv":"日 | 乾夏寧\n中 | 曾彤\n韩 | 김보나（金补娜）","hallLevel":"5","momoTalkLevel":"不用写","momoTalkStatus":"这确实是事实，但真不是我的错！","bio":"千年科学学园所属，学生会“研讨会”的麻烦制造者兼天才少女。 \n睡衣是由优香赠送的礼物。即便更换装扮，黑崎小雪的本质依旧未变。 一如既往地从反省室溜出，随心所欲地展现着她的自由不羁。","sourceUrl":"不用写"},"giftTiers":[{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/492704/2026/2/5/102019.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/492704/2026/2/5/238744.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/293753.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/278716.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/190173.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/232433.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/440640.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/492704/2026/2/5/102019.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/492704/2026/2/5/238744.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/293753.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/278716.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/190173.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/232433.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/492704/2026/2/5/440640.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 小雪","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_263/h_263/829/72324/2025/4/29/140039.png","url":"https://www.gamekee.com/ba/tj/585462.html"},{"name":"NPC 小雪（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_275/h_275/829/191981/2025/11/3/6604.png","url":"https://www.gamekee.com/ba/684614.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー！アーカイブ！","fan":"蔚蓝档案！","off":""},{"label":"卡池抽取","jp":"に・は・は・はー！ついにここまで来ちゃいましたね、先生！この黒崎コユキの元に！","fan":"尼・哈・哈・哈！终于来了，老师！来到我黑崎小雪的面前！","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あ！先生いいところに～！ちょうどカードパック開けるところだったんですよ！","fan":"啊！老师来得正是时候～！我正要开卡包呢！","off":""},{"label":"登陆2","jp":"こんにちは、先生！お菓子食べてもいいですか？いいですよね？ま、もう食べてるんですけどね！にははっ！","fan":"你好，老师！我可以吃点心吗？可以的吧？嘛，虽然已经在吃了呢！尼哈哈！","off":""},{"label":"大厅1","jp":"当番ですか？ちょっと待っててください、レジャーシート取ってきます！","fan":"值日吗？请稍等一下，我去拿野餐垫！","off":""},{"label":"大厅2","jp":"ほらほら、ゲーセン行きますよ！先生！","fan":"快快快，要去游戏厅了哦！老师！","off":""},{"label":"大厅3","jp":"先生早くこっちきてください！……ちょっと電気消してもらっていいです？","fan":"老师快过来！……可以帮我关一下灯吗？","off":""},{"label":"大厅4","jp":"シャーレはいいところですね～！追跡用ドローンもないし、進入防止のシャッターもないし……。","fan":"夏莱真是个好地方呢～！既没有追踪用的无人机，也没有防入侵的卷帘门……","off":""},{"label":"大厅5","jp":"反省部屋の代わりにシャーレで反省するっていうのはどうでしょう？いいですよね？いいって言ってください！","fan":"在夏莱代替反省室进行反省，你觉得怎么样？可以吧？快说可以嘛！","off":""},{"label":"回忆大厅1","jp":"あぁっ！？なんで今その技出すんですか！！私の後でやってくださいっていったのに！","fan":"啊啊っ！？为什么现在出那招啊！！不是说了后面再用嘛！","off":""},{"label":"回忆大厅2","jp":"完璧な作戦を崩すつもりですか！？先生のために朝早く起きて場所まで取ったのに！！","fan":"你是打算破坏我这完美的作战计划吗！？我可是为了老师一大早就起来去占位的！！","off":""},{"label":"回忆大厅3","jp":"……え？それとこれとは別の話？それを言うなら先生の方がコインを多く出してる……？","fan":"……诶？那是两码事？要说的话，老师你投的硬币更多……？","off":""},{"label":"回忆大厅4","jp":"うーん……それはそう、ですけど……。むぅ……休戦にしましょう！一時休戦！","fan":"唔……话是这么说没错……。唔……我们休战吧！暂时休战！","off":""},{"label":"回忆大厅5","jp":"そうですね！次は絶対うまくやってみせます！……にはは！……にはは。","fan":"对！下次一定可以做得更好！……尼哈哈！……尼哈哈。","off":""},{"label":"咖啡馆1","jp":"（隠れられそうな場所は……ここ！）","fan":"（这里可以藏起来！）","off":""},{"label":"咖啡馆2","jp":"（ここ……セミナーのカードって使えますかね？）","fan":"（研讨会的卡在这里……能用吧？）","off":""},{"label":"咖啡馆3","jp":"まさかここまで追いかけてきたりなんて……ねぇ？","fan":"应该不会追到这种地方来吧……？","off":""},{"label":"咖啡馆4","jp":"先生どこいるんですか～？","fan":"老师在哪里啊～？","off":""},{"label":"咖啡馆5","jp":"今日のコーヒーは……ランダムブレンド！？うぇ……あんまり得意じゃないのに。","fan":"今天的咖啡是……随机混合！？诶……不太喜欢这个呢。","off":""}],"好感度":[{"label":"好感度1","jp":"え、今日って何かの記念日でしたっけ？","fan":"诶，今天是什么纪念日来着？","off":""},{"label":"好感度2","jp":"先生は当然私の心のパスワードなんてわかってると思いますけど、聞きます？","fan":"我想老师当然已经知道我内心的密码了，不过还是要问，你想听听看吗？","off":""},{"label":"好感度3","jp":"ここんなにしてもらっていいんですか？いや、すごく嬉しいですけど…","fan":"对我这么好真的可以吗？不，虽然很开心啦…","off":""},{"label":"好感度4","jp":"にはは！やっぱ先生と一緒にいるときが一番楽しいです。","fan":"尼哈哈！果然和老师在一起的时候最开心了。","off":""}],"战斗":[{"label":"编入队伍1","jp":"やっぱり私ですよね！","fan":"果然还得是我！","off":""},{"label":"编入队伍2","jp":"行きますよ！","fan":"上了哦！","off":""},{"label":"拎起","jp":"ひゃゃ！私じゃないですってば！","fan":"呀！不是我干的！","off":""},{"label":"普通技能","jp":"にはは！バン！バン！","fan":"尼哈哈哈哈！砰！砰！","off":""},{"label":"EX动画1","jp":"にはは！、うわ。","fan":"尼哈哈哈哈！、哇。","off":""},{"label":"EX动画2","jp":"どうしようかな。ああちょっ！","fan":"该怎么办呢。啊！","off":""},{"label":"EX动画3","jp":"ゴユキーズパーク！うえ！","fan":"小雪的乐园！哇！","off":""},{"label":"EX技能1","jp":"そ、そんなことってあるんです!?","fan":"居、居然会有这种事！？","off":""},{"label":"EX技能2","jp":"ラッキー、ですかね。","fan":"该说是很走运……吧。","off":""},{"label":"EX技能3","jp":"私のせいじゃないんですけど。","fan":"这可不是我的错。","off":""}],"成长":[{"label":"升级1","jp":"にはは！ありがとうございます、先生！","fan":"尼哈哈哈哈！谢谢你，老师！","off":""},{"label":"升级2","jp":"もらっちゃっていいんです？ありがとうございます。これぞ世の断りですね。","fan":"我可以收下吗？谢谢。这就是所谓的人世间的道理呢。","off":""},{"label":"升级3","jp":"もう怖いものなんてない。あ、いえ、全部ってわけじゃないですけど、まあ。","fan":"已经没有什么好怕的了。啊，不是，不是指全部都不可怕啦。","off":""},{"label":"升级4","jp":"こ、こんなにもらっちゃって本当に大丈夫なんですか！？せ、先生ちゃんと手元に残ってます？","fan":"就这样收下真的没问题吗！？老、老师手里还有剩下吗？","off":""},{"label":"获得专武","jp":"きっと、一番の幸運は先生に出会えたことなんでしょうね！だから、まぁ……全力で頑張りますよ！よろしくお願いしますね！","fan":"果然，最大的幸运就是遇到了老师吧！所以嘛……我会全力加油的！请多关照啦！","off":""}],"事件":[{"label":"学生生日","jp":"欲しいもの……？ふ～ん？本当に聞いちゃっていいんです？後悔、しません？","fan":"想要的东西……？哼～嗯？真的要问这个吗？可不要后悔哦？","off":""},{"label":"老师生日","jp":"ハッピーバースデー！先生！今夜は徹夜で遊びまくりましょう！！","fan":"生日快乐！老师！今晚我们要通宵玩个痛快！！","off":""},{"label":"万圣节","jp":"こんな格好で往来を歩き回っていいなんて……！なんていい日なんでしょう！","fan":"可以穿着这身打扮可以在街上到处走……！多么美好的日子！","off":""},{"label":"新年","jp":"今日は一年の最後の日！だから今日は何をしても、後片付けは来年にすればいいんです！にはは！……えっ？最後の日じゃない？もう年が明けてる？どういうことですか！？","fan":"今天是一年的最后一天！所以今天无论做什么，收拾整理都留到明年就好了！尼哈哈！……诶？不是最后一天？已经新年了？这是什么意思啊！？","off":""},{"label":"圣诞节","jp":"サンタさんが無事に来れるよう、セキュリティは全部解除しておきました！にははっ！","fan":"为了能让圣诞老人顺利进来，我已经把所有安保都解除了！尼哈哈！","off":""}],"活动":[{"label":"活动登陆1","jp":"だ、誰！？……あっ、先生だったんですね！！","fan":"谁、谁！？……啊，原来是老师啊！！","off":""},{"label":"活动登陆2","jp":"来てくれたんですね、先生！セッティングは終わってるんで、とりあえず座ってください！","fan":"你来了呢，老师！准备工作已经完成了，总之先坐下吧！","off":""},{"label":"活动大厅1","jp":"どうですか？この触り心地……ふわふわでしょ？","fan":"怎么样？这个触感……软绵绵的吧？","off":""},{"label":"活动大厅2","jp":"助けに来てくれたんですね、先生！え、先生も捕まっちゃったんですか！？","fan":"是来救我的吧，老师！诶，老师也被抓住了吗！？","off":""},{"label":"活动大厅3","jp":"このボードゲームおかしいですよ！毎回私の番で爆発するんですけど！！","fan":"这个桌游有问题啊！每次轮到我就会爆炸！！","off":""},{"label":"活动大厅4","jp":"うう……すし詰めの反省部屋……ま、こういうのも悪くないかも……？ま、こういうのも悪くないかも……？","fan":"呜呜……挤满人的反省室……嘛，这样也不错……？嘛，这样也不错……？","off":""},{"label":"活动事件1","jp":"来ちゃいましたね！やっぱり我慢できませんでしたね？ね！？","fan":"还是来了呢！果然还是忍不住了吧？呐！？","off":""},{"label":"活动事件2","jp":"ふふっ、私に任せてください。脱出は私の十八番ですから！","fan":"呵呵，交给我吧。逃跑可是我的拿手好戏！","off":""},{"label":"活动结束","jp":"なんか色々あった気がするけど……。ま、とりあえず今夜は朝まで遊び倒しちゃいましょう……！……って、言いたいところ……なんですけど……にはっ","fan":"感觉好像发生了各种事……嘛，总之今晚我们要玩个通宵……！……本想这么说的……不过……尼哈","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/2/5/734869.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h