37816544mvs7qz2r.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルー、アーカイブ。","fan":"ブルー、アーカイブ。","off":""},{"label":"卡池抽取","jp":"183号特別クラス、古畑ラナです。ふむ……再起動は試しましたか？","fan":"183号特别班，古畑拉娜。嗯……您试过重启了吗？","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お世話になっております。古畑ラナです。","fan":"承蒙关照。我是古畑拉娜。","off":""},{"label":"登陆2","jp":"今日も、お会いしたかったです。","fan":"今天也很想见您一面。","off":""},{"label":"大厅1","jp":"はい、古畑ラナです。\n略して「ラナ」と呼んでください。","fan":"是的，我是古畑拉娜。\n简称「拉娜」，请这样称呼我。","off":""},{"label":"大厅2","jp":"暖かいですね。シャーレのいいところです。\n一番の利点は、先生がいらっしゃることですが。","fan":"真暖和。这是夏莱的优点。\n不过最大的优点，是老师您在这里。","off":""},{"label":"大厅3","jp":"無線LANの新しいパスワードですね……「なでてください」。\nあ……なでてくださりありがとうございます。\nパスワードは「なでてください」です。","fan":"新的WiFi密码是吧……「请摸摸我」。\n啊……谢谢您摸我的头。\n密码就是「请摸摸我」。","off":""},{"label":"大厅4","jp":"ご存じでしたか？シャーレの当番表には、drop tableの入力が可能です。\n実行はしていません。先生に迷惑がかかってしまいますので。","fan":"您知道吗？夏莱的值日表上，是可以输入drop table的。\n我没有执行。因为那样会给老师添麻烦的。","off":""},{"label":"大厅5","jp":"実行できるのに、実行してはいけないことが、世にはある……。……なんという難題なのでしょう。\nええ……聡明で優しい先生に止めていただいて、助かっております。","fan":"明明能执行，却不可以执行的事，这世上确实存在……。……这是何等难题啊。\n嗯……多亏聪慧又温柔的老师阻止了我，我才得救。","off":""},{"label":"回忆大厅1","jp":"……お世話になっております、先生。見慣れた天井……ですね。なんとかお会いできてよかったです。","fan":"……承蒙关照，老师。\n熟悉的天花板……是吧。\n总算是见到您了，太好了。","off":""},{"label":"回忆大厅2","jp":"うん？宅配の荷物に入っている理由……？「入ったから」です。列車の乗車券を買ったら、お土産を買えなくなってしまって……。そうしたら、シャーレにちょうど先生宛の段ボールがあるではないですか。なので、お土産になってみました。","fan":"嗯？您问我为什么在快递包裹里……？因为「我进去了」。\n买了列车的车票之后，就没钱买伴手礼了……。\n结果一看，夏莱里正好有个寄给老师的纸箱不是吗。所以，我就试着当伴手礼了。","off":""},{"label":"回忆大厅3","jp":"問題ありません。暇つぶしは得意です――緩衝材はふかふかでしたし、先生が開封の際に気をつけてくださったので、無事です。ふふっ……。","fan":"没有问题。打发时间我很擅长——\n缓冲材料软软的，而且老师开封时很小心，所以我没事。\n呵呵……。","off":""},{"label":"回忆大厅4","jp":"こうして顔が見れて、嬉しいです。すごく、会いたかったです。先生。うぅん……。","fan":"能这样见到您的脸，我很高兴。我真的、\n很想见您。老师。嗯……。","off":""},{"label":"回忆大厅5","jp":"ふぁ……。それでは、おやすみなさい。すやぁ……。","fan":"呼啊……。那么，晚安。呼……呼……。","off":""},{"label":"咖啡馆1","jp":"先生、アボカドはありましたか？アボカドがあったなら、牛乳を6本買わないといけませんので。","fan":"老师，您这儿有牛油果吗？\n要是有牛油果的话，我就得去买六瓶牛奶才行。","off":""},{"label":"咖啡馆2","jp":"賑やかです。みんなと仲良くできると良いですね。","fan":"很热闹。要是能和大家好好相处就好了。","off":""},{"label":"咖啡馆3","jp":"ちゃんと、大人しくしていました。ご心配には及びません。","fan":"我一直都有乖乖待着的。您不必担心。","off":""},{"label":"咖啡馆4","jp":"世界は広いですね。色んな人がいて、考察のし甲斐があります。","fan":"世界真宽广。有各种各样的人，很值得考察一番。","off":""},{"label":"咖啡馆5","jp":"世界真宽广。有各种各样的人，很值得考察一番。","fan":"总觉得和183号气氛不太一样。真有意思。","off":""}],"好感度":[{"label":"好感度1","jp":"先生は、私より私のことを理解されているのですね。感謝です。ウレシイです。","fan":"老师比我更了解我自己呢。感谢。我很开心。","off":""},{"label":"好感度2","jp":"近頃、先生のことを考える頻度が増えました。喜ばしい現象です。","fan":"最近，想老师的频率增加了。这是令人欣喜的现象。","off":""},{"label":"好感度3","jp":"いつも甘やかしてくださり、ありがとうございます。","fan":"谢谢您总是这样宠着我。","off":""},{"label":"好感度4","jp":"検証を重ねるたびに、確信します。私は、先生のことが好きです。","fan":"每一次反复验证，我都会确信。我，喜欢老师。","off":""}],"战斗":[{"label":"编入队伍1","jp":"エキスパートをお探しでしょうか？","fan":"您在寻找专家吗？","off":""},{"label":"编入队伍2","jp":"常時待機中ですので。","fan":"我随时都在待机。","off":""},{"label":"拎起","jp":"高いですね。これが大人の目線……。","fan":"真高啊。这就是大人的视线……。","off":""},{"label":"普通技能","jp":"うにゃー。","fan":"呜喵——。","off":""},{"label":"载具普通技能","jp":"ズドーン。","fan":"滋咚！","off":""},{"label":"EX动画1","jp":"移動研究所、ただいま到着しました。","fan":"移动研究所，现已抵达。","off":""},{"label":"EX动画2","jp":"科学的根拠に基づいてます、ご安心を。","fan":"一切基于科学依据，请放心。","off":""},{"label":"EX动画3","jp":"子犬号、降臨です。","fan":"幼犬号，降临。","off":""},{"label":"EX技能1","jp":"プップー。","fan":"嘟嘟——。","off":""},{"label":"EX技能2","jp":"戦車、お呼びですか。","fan":"这里是坦克，有什么吩咐？","off":""},{"label":"EX技能3","jp":"ブォーン！ブォォー！ブォォー。","fan":"轰——！轰轰——！轰轰——。","off":""}],"成长":[{"label":"升级1","jp":"いつもありがとうございます、先生。まだまだ成長期ですので、乞うご期待、です。","fan":"一直以来谢谢您，老师。我还处在成长期，敬请期待，就是这样。","off":""},{"label":"升级2","jp":"実力がついて、一歩前進するこの感覚……だから成長はやめられません。","fan":"实力提升、向前迈进一步的这种感觉……所以成长是停不下来的。","off":""},{"label":"升级3","jp":"私が成長し続けて、いつか遠い存在になっても……見守っていてくださいね。","fan":"即使我不断成长，终有一天成为遥远的存在……也请您继续守望着我。","off":""},{"label":"升级4","jp":"ありがとうございます、先生。……これからは感謝を表す言葉を、たくさん覚えていきます。","fan":"谢谢您，老师。……今后我会多记一些表达感谢的词语。","off":""},{"label":"获得专武","jp":"ふむ、パンチカードがいっぱい作れそうで良いですね。これで判定も捗りそうです。","fan":"嗯，看来能做出很多穿孔卡了，真不错。这样判定也能更顺利了。","off":""}],"事件":[{"label":"学生生日","jp":"今日は私の誕生日です。プレゼントになってくださり、ありがとうございます。","fan":"今天是我的生日。您愿意成为我的礼物，真的非常感谢。","off":""},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。単一ハードウェア連続稼働記録を、更新されましたね。","fan":"生日快乐，老师。单一硬件的连续运行记录，又被您刷新了呢。","off":""},{"label":"万圣节","jp":"先生、突然ですがおやつまたは飴を、お持ちでしょうか。\n先ほど、変わった服装の通行人に「トリック・オア・トリート」と言われました。\n飴の持ち合わせがなかったためイタズラをしてあげたのですが……あまり喜んでもらえませんでした。","fan":"老师，冒昧一问，点心或者糖果，您带了吗？\n刚才，有位穿着古怪的路人对我说了「不给糖就捣蛋」这句话。\n因为我身上没带糖，所以反过来对他做了一点恶作剧……但他似乎不太高兴的样子。","off":""},{"label":"新年","jp":"幸い、今年も年問題は発生しませんでした。明けましておめでとうございます。","fan":"所幸，今年也没有发生「年份问题」。谨祝新年快乐。","off":""},{"label":"圣诞节","jp":"メリークリスマスです。年問題に対応していました。進捗、先生もご覧になりますか。","fan":"圣诞快乐。我在处理「年份问题」。老师要看看进度吗。","off":""}],"活动":[{"label":"活动登陆1","jp":"ブン、ブブブブブーブブブブブー！\n今のは寒い朝のディーゼルエンジン駆動音です。\nいかがでしょう、似ていましたか。","fan":"嗡，嗡嗡嗡嗡嗡——嗡嗡嗡嗡嗡——！\n刚才那是寒冷清晨的柴油发动机运转声。\n怎么样，像不像？","off":""},{"label":"活动登陆2","jp":"色んな戦車が見られて、テンションが上がります。","fan":"能看到各种各样的坦克，情绪高涨起来了。","off":""},{"label":"活动大厅1","jp":"人が密集しています。子供を迷子にさせないよう、ご注意ください。","fan":"人员相当密集。请注意不要让孩子走散走丢。","off":""},{"label":"活动大厅2","jp":"手を繋げば、迷子防止になります。実験で証明された理論ですので、間違いありません。","fan":"牵起手的话，就能防止走散。\n这是实验证明过的理论，不会有错。","off":""},{"label":"活动大厅3","jp":"なでなでも良いですが、手を繋ぐことも、お忘れなく。","fan":"摸摸头也可以，不过牵手这件事，也请不要忘记。","off":""},{"label":"活动大厅4","jp":"あそこ、楽しそうです。連れていっていただけると嬉しいです。","fan":"那边，看起来很有趣。如果您能带我过去，我会很高兴。","off":""},{"label":"活动事件1","jp":"はたして、183号特別クラスの運命は――……今のは天の声の真似です。","fan":"究竟，183号特别班的命运是——……刚才那是天之声的模仿。","off":""},{"label":"活动事件2","jp":"笑顔の人がたくさんいますね……。こちらまで笑顔になってしまいます。","fan":"面带笑容的人真多啊……。连我这边都要跟着笑起来了。","off":""},{"label":"活动结束","jp":"ゲヘナカップ、終わりましたね。駐車場が混み合う前に、急いで帰りましょう。","fan":"格黑娜杯，结束了呢。趁停车场还没挤满，我们赶紧回去吧。","off":""},{"label":"活动任务1","jp":"にゃあっ。\n私の鼻が……どうかされましたか？汚染されてましたか？変形してましたか？","fan":"喵呜。\n我的鼻子……有什么问题吗？是被污染了吗？还是变形了？","off":""},{"label":"活动任务2","jp":"先生のご活躍を、ずっと眺めていたいです。","fan":"我想一直注视着老师活跃的样子。","off":""},{"label":"活动任务每日结束","jp":"今日はここまでです。続きはまた今度。……そんな寂しそうな顔しないでください。","fan":"今天就到这里了。剩下的下次再继续。……请不要露出那么寂寞的表情嘛。","off":""},{"label":"活动任务登录1","jp":"課題ですね。受けて立ちましょう。","fan":"是课题呢。那就接下吧。","off":""},{"label":"活动任务登陆2","jp":"お仕事です。代わりに終わらせておくことも検討しましたが、先生の楽しみを奪っては、いけませんので。","fan":"是工作。我也考虑过干脆替您先做完它，\n但那样就夺走了老师的乐趣，所以不行。","off":""},{"label":"活动任务获取1","jp":"やりましたね。素敵です。","fan":"做到了呢。真棒。","off":""},{"label":"活动任务获取2","jp":"詳しいことは分かりませんが、先生のことですので。きっと、何か素晴らしいことを成し遂げられたのでしょう。","fan":"详细情况我不太清楚，但毕竟是老师。一定是完成了什么了不起的事情吧。","off":""},{"label":"活动商店1","jp":"私は売りものではありません。それに、先生でしたら、わざわざ購入する必要もないかと。","fan":"我不是商品。\n而且，如果是老师的话，应该没必要特意来购买吧。","off":""},{"label":"活动商店2","jp":"なでなでを、ありがとうございます。何か欲しいものはありますか？","fan":"感谢您摸我的头。您有什么想要的东西吗？","off":""},{"label":"活动商店关闭","jp":"世には「閉店セール」というものが存在すると聞いていましたが……。ここではやっていないのですね。","fan":"我听说过世上有「闭店促销」这种东西……。这里似乎并不举办呢。","off":""},{"label":"活动商店登陆1","jp":"ふむ、等価交換、ですか。","fan":"嗯，等价交换，是吗。","off":""},{"label":"活动商店登陆2","jp":"お買い物の際は、優先順位をつけると良いと思います。","fan":"购物的时候，最好排一下优先顺序。","off":""},{"label":"活动商店购买1","jp":"最適な品といえるでしょう。","fan":"可以说是最合适的商品了。","off":""},{"label":"活动商店购买2","jp":"先生もお使いですか？","fan":"老师也用这个吗？","off":""},{"label":"活动商店购买3","jp":"先生。「お釣りは取っておけ」と言ってみたこと、ありますか？","fan":"老师。您试过说「不用找零了」这句话吗？","off":""},{"label":"活动商店购买4","jp":"買い物メモもなしに……全部覚えられたんですね。カッコ良いです。","fan":"连购物清单都没有……全都记住了呢。真帅气。","off":""},{"label":"minigame_combo_1","jp":"この戦車は、私と一つです。","fan":"这辆坦克，已经与我合二为一了。","off":""},{"label":"minigame_combo_2","jp":"頂点に立つドライバーになりたいです。","fan":"我想成为傲视群雄的车手。","off":""},{"label":"minigame_combo_3","jp":"オーバーフローが懸念されます。","fan":"担心会发生溢流现象呢。","off":""},{"label":"minigame_complete","jp":"先生の処理速度、神業の如く。です。ベリーファスト。","fan":"老师的处理速度，犹如神技。非常之快（Very Fast）。","off":""},{"label":"minigame_geasget_1","jp":"無償の部品、嬉しいですね。","fan":"免费的零件，真令人开心呢。","off":""},{"label":"minigame_geasget_2","jp":"とにかく嵌めてみましょう。",