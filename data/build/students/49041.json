3386.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/737047/2025/5/3/426104.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/790070.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/475347.png","name":"生巧克力组合","desc":"优香为了老师购买的礼品巧克力组合。虽然是超过一万日元的高级巧克力，但不知为何附上了5000日元的发票？"},"ability":{"attrs":[{"name":"生命值","value":"2267"},{"name":"攻击力","value":"49"},{"name":"治愈力","value":"196"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/411538.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/163810.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"优香（体操服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_270/h_270/829/737047/2025/5/3/786193.png","url":"https://www.gamekee.com/ba/170295.html"},{"name":"优香（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/737047/2025/5/3/470337.png","url":"https://www.gamekee.com/ba/643617.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"条件はクリアされました。\n私たちは今日この瞬間を絆と定義し、証明することになるでしょう。","fan":"条件已经达成。在现在这个瞬间，我们获得了能定义为牵绊的证明","off":"条件都已达成，我们就把今天这一刻定义为缘分，并努力去证明它吧！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生。今日も全力であなたをアシストしますね。","fan":"老师，今天我也会尽全力配合您的。","off":"老师，今天我也会全力协助您的！"},{"label":"登陆2","jp":"ようこそ、先生。今から反省会を始めます。あっ、どこに行くんですか？","fan":"欢迎回来，老师。现在开始要开反省会……呜哇，您要跑到哪里去啊！？","off":"欢迎您，老师。我们来开反省会吧！……诶？您要去哪儿？"},{"label":"登陆3","jp":"\\","fan":"\\","off":"\\"},{"label":"大厅1","jp":"せ～ん～せ～い～。もう少し頑張ってください！","fan":"老～师～。请再坚持一会儿。","off":"老、师、啊……！请您再上进一点好吗！"},{"label":"大厅2","jp":"先生。今、先生の行動について言いたいことが34個あります。","fan":"老师，我对于老师现在的行动有34点想说。","off":"老师，针对您刚才的这种行为，我想说的话有34句。"},{"label":"大厅3","jp":"（…そのうちの一つは特別な言葉だけど）","fan":"（虽然其中的一点是特别的）","off":"（不过其中有一句……是特别的。）"},{"label":"大厅4","jp":"でも最近は先生らしくなった気がします。\nはい？私のおかげ、ですか？うえぇっ？…も、もちろんです！","fan":"不过最近也开始有身为一个老师的样子了。\n啊？您说是是多亏了我？欸！那，那是当然了。","off":"但是，我发现您最近越来越有老师的样子了。……什么？您说都是托我的福？……那、那还用说！"},{"label":"大厅5","jp":"先生。お仕事を始める前にまず、これからの目標と方向性を策定してください。","fan":"老师，在开始处理要务之前，请先规划好这之后的目标和方向。","off":"老师，在开始工作之前，请先定好将来的目标和工作方针吧。"},{"label":"回忆大厅0","jp":"まったく…大人なんですから、しっかりと大人らしく計画的な消費をしてください。お小遣いをもらってパーッと使っちゃう子供じゃないんですよ？","fan":"真是的，都已经是大人了就请好好的计划性消费啊。\n又不是一拿到零花钱一下子就花完的小孩子。","off":"真是的，您好歹是大人，就要有大人的样子，平时消费一定要有计划。……又不是一拿到零花钱，转头就全~部花光的小孩子！"},{"label":"回忆大厅1","jp":"それに、こうして領収証の整理を手伝ってくれるのなんて、\n私くらいなんですから…。\n次はもう、絶対に手伝いませんからね！","fan":"而且，也就只有我会这样帮您整理收据什么的了。\n下次我再也不会帮忙的了！","off":"再说，能像这个样子，过来帮您好好整理收据的，也就……只有我了。……下一次，我可绝对不会再帮您了！"},{"label":"回忆大厅2","jp":"15日前にコンビニで購入したチキンサンド500円…\n新刊の漫画購入で450円…。\nん…？一昨日の夜、「クラブ・ふわりん」で2万円…？","fan":"15天前在便利店购买的鸡肉三文治花了500日元…购买最新刊的漫画花了450日元。嗯？前天在轻飘飘俱乐部花了2万日元？","off":"15天前在便利店买的鸡肉三明治500联合币，买新一期的漫画花了450……嗯？前天晚上，在【软绵绵俱乐部】花了……两……两万？！"},{"label":"回忆大厅3","jp":"せ、先生！いったい何ですか、この領収証は！\n生徒たちの模範となるべき教育者が、\nこんな、い、いかがわしいお店に行くだなんて…！\n信じられません！最低です！","fan":"老，老师，这是个什么收据！\n本应作为学生的榜样的教育者居然会去这，这种下流的地方！\n难以置信，您太差劲了。","off":"呃，老师……！这、这什么啊，这个收据……！老师您应该是大家的榜样才对啊，怎、怎么可以去这种低、低级的地方！……真是难以置信，太差劲了！"},{"label":"回忆大厅4","jp":"え、「クラブ・ふわりん」っていう名前の、スマホゲームのガチャ…？\n…ふぅ。てっきり私、その…。","fan":"欸？只是在一个叫做「轻飘飘俱乐部」的手机游戏里面的抽奖？ 唉，我还以为…","off":"嗯？【软绵绵俱乐部】是手机游戏，那只是在抽卡……？唉……我还以为那是……那是……"},{"label":"回忆大厅5","jp":"って、いやいや！それでも一回で2万円は課金しすぎです！\n衝動買いは禁止！消費はちゃんと計画的にっ！","fan":"不对不对！一次两万也氪太多了吧！禁止冲动消费。要有计划性的花钱。","off":"嘛……不对！那也不行！一次就课了两万也太多了吧！……禁止冲动消费！今后花钱要有计划性！"},{"label":"回忆大厅6","jp":"\\","fan":"\\","off":"\\"},{"label":"回忆大厅7","jp":"\\","fan":"\\","off":"\\"},{"label":"回忆大厅8","jp":"\\","fan":"\\","off":"\\"},{"label":"回忆大厅9","jp":"\\","fan":"\\","off":"\\"},{"label":"咖啡馆1","jp":"うん？少し休んでいきますか？私も、約1890秒くらいの余裕はありますから。","fan":"嗯？需要休息一下吗？我还有1890秒的空闲时间。","off":"嗯？要稍微休息一下嘛？我也还有大约1890秒的空闲时间。"},{"label":"咖啡馆2","jp":"なんだか今日は楽しいことがありそうな気がする。確率的に～。","fan":"总感觉今天会有好事发生。有概率的那种～","off":"总感觉……今天会有好事，从概率上讲。"},{"label":"咖啡馆3","jp":"あれ？こんな空間あったっけ？","fan":"嗯？原来这里还有这种地方的吗？","off":"嗯？竟然还有这样的一块地方。"},{"label":"咖啡馆4","jp":"このままだと破産する…。出費を減らさないと…。","fan":"这样下去会破产的，再不减少支出的话…","off":"再这样下去就要破产了……必须要减少支出……"},{"label":"咖啡馆5","jp":"もしこれを購入したら、私は十三日間、学食の基本メニューだけを食べるしかない。それはつらいけど、買わなきゃ！","fan":"买了这个的话，接下来的13天里就只能吃食堂了。虽然很痛苦，但还是不买不行！","off":"如果买了这个，接下来的13天内我在食堂能吃的就只有最便宜的套餐了。好难啊……但我买定了！"}],"好感度":[{"label":"好感度1","jp":"体力も時間も、たくさん使っちゃった気がしますけど、先生といると得した気分です！","fan":"虽然体力和时间都已经消耗了不少…但只要和老师在一起，心情就会很不错！","off":"虽然我感觉自己耗费了很多体力和时间，但是和老师在一起……我又觉得自己赚了。"},{"label":"好感度2","jp":"計算が出来ません…。今、この気持ちがですよ…！","fan":"无法计算……就是指我现在的这个感觉啊……！","off":"我是说……我现在的心情……"},{"label":"好感度3","jp":"いつも測定や、計算だけを考えてたけど、今は…ただこの瞬間を感じていたい。","fan":"我之前一直在思考关于测定、计算什么的，不过现在只想好好地享受这个瞬间。","off":"平时我的大脑一直在测定啊、计算啊……但是现在，我只想感受这一刻。"},{"label":"好感度4","jp":"どうしてかな…説明できない感覚だけど…嫌いじゃない。","fan":"这是为什么呢？虽然这种感觉说不清道不明，但我不讨厌。","off":"为什么呢……这种感觉，我无法用语言解释。但也……不讨厌。"}],"战斗":[{"label":"编入队伍1","jp":"合理的な選択ね。","fan":"明智的选择。","off":"合理的选择。"},{"label":"编入队伍2","jp":"これ、報酬は出るんです？","fan":"搞这个有报酬吗？","off":"这……有报酬吗？"},{"label":"拎起","jp":"ふーん……やっぱり先生は賢いですね。","fan":"哼嗯……果然老师考虑的很周到呢。","off":"啊……果然还是老师聪明。"},{"label":"任命队长1","jp":"敵の位置を確認。先生、指揮をお願いします。","fan":"敌人位置已确认。老师，指挥就拜托您了。","off":"敌人位置已确认。老师，拜托您指挥了。"},{"label":"任命队长2","jp":"敵の位置を確認。距離、至近。戦力、計算完了。","fan":"确认敌人位置。距离，最近方位，战力。计算完毕。","off":"已确认敌人位置。极近距离。战斗力计算完毕。"},{"label":"普通技能","jp":"まだ終わらないわよ！","fan":"还没完呢！","off":"还没结束呢！"},{"label":"EX动画1","jp":"悲しみも怒りも、全て因数分解してやるわ！","fan":"将悲伤和愤怒，全都给因数分解了！","off":"悲伤也好，愤怒也罢。我都会把它们因数分解掉"},{"label":"EX动画2","jp":"現在の状況と条件。よし、これは勝ちね！","fan":"根据现在的状况和条件计算。好，这下赢定了！","off":"现在的状况和条件……好，肯定能赢！"},{"label":"EX动画3","jp":"攻撃が私に命中する確率は…極めて低い！","fan":"对手的攻击能命中我的概率…低到爆炸！","off":"你打中我的概率……极低！"},{"label":"EX技能1","jp":"単なる計算結果に過ぎないわ。","fan":"不过是计算的结果罢了。","off":"单纯的计算结果罢了。"},{"label":"EX技能2","jp":"合理と理性は無慈悲よ。","fan":"公平与理性是冷酷的。","off":"合理与理性是无情的。"},{"label":"EX技能3","jp":"勝利、証明するわ。","fan":"我将证明胜利。","off":"我会求证，得出胜利的答案！"},{"label":"战斗开始1","jp":"計算は完璧。落ち着いて行こう。","fan":"计算是完美的，慎重的前进吧。","off":"我的计算很完美，保持理性行动吧！"},{"label":"战斗开始2","jp":"私たちの勝率はかなり高い。自信を持って行こう。","fan":"我们的胜算十分高，鼓起勇气上吧。","off":"我们的胜率相当高。自信点，上吧！"},{"label":"获得BUFF","jp":"ありがとう。","fan":"谢谢。","off":"谢谢！"},{"label":"施放BUFF","jp":"私の計算は完璧よ。","fan":"我的计算是完美的。","off":"我的计算是完美的。"},{"label":"掩体","jp":"隠れるわ。支援をお願い。","fan":"进入隐蔽，请求掩护。","off":"我躲好了，请求支援！"},{"label":"被CC1","jp":"-","fan":"-","off":"呃"},{"label":"被CC2","jp":"-","fan":"-","off":"呃哼哼"},{"label":"被CC3","jp":"痛い！","fan":"好疼！","off":"好疼啊！"},{"label":"回避","jp":"無駄よ。","fan":"没用的。","off":"没用的！"},{"label":"队伍移动1","jp":"ま、ここまでは計算通りね。","fan":"至今为止都在掌控之中。","off":"嗯，到目前为止都和预计一样。"},{"label":"队伍移动2","jp":"計算が合っていれば、すぐに次の目標が見えてくるはず。","fan":"按照计算的话，应该马上就能看到下一个目标了。","off":"如果我的计算没错，下一个目标就在前方！"},{"label":"回复","jp":"うん、丁度いい量ね。","fan":"嗯，回复量刚刚好呢。","off":"嗯，量正好。"},{"label":"中途退出","jp":"変数が……多すぎる……","fan":"变数，太多了。","off":"变量……太多了……"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"哈"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"哈"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"嘿"},{"label":"角色移动","jp":"行くわよ。","fan":"要走了。","off":"上吧！"},{"label":"战斗胜利1","jp":"計算通り。完璧～。","fan":"完美～与计算一致。","off":"和我的计算一致。完美！"},{"label":"战斗胜利2","jp":"数学は真実を導く。私たちの勝ちよ。","fan":"数学会将我们引领至正确答案，是我们胜利了。","off":"数学通向真理，我们赢了！"},{"label":"关卡完成1","jp":"スマートに勝利～。","fan":"Smart的胜利～","off":"一场聪明的胜仗！"},{"label":"关卡完成2","jp":"運が良かった？いいえ、計算通りです。","fan":"运气好？不对哦。这叫一切都在计算中。","off":"运气好？并不是。都在预料之中。"},{"label":"战斗失败1","jp":"問題設計の方が、間違ってましたからぁ……","fan":"是设计问题的人搞错了……","off":"是……设问的方式有问题啦……"},{"label":"战斗失败2","jp":"計算機が…故障していたとは…","fan":"计算机……没想到居然坏了……","off":"计算器……居然出问题了……"}],"成长":[{"label":"升级1","jp":"成果を見せるチャンス、待ってました！","fan":"终于等到展示成果的机会了！","off":"展示成果的机会终于来啦，我等很久了！"},{"label":"升级2","jp":"数値で感じられる結果というのは、人をドキドキさせますね。","fan":"能用数值感受到的结果，真是让人躁动不已呢。","off":"可以用数值来表现的结果，可真令人心跳加速！"},{"label":"升级3","jp":"次の任務は、黒字を期待してくださいね。","fan":"在下个任务里好好期待盈余吧。","off":"下一次的任务，您应该可以看到盈余了！"},{"label":"升级4","jp":"こんな表現はあまり好きじゃないけど…今の私、測定不能です！","fan":"虽然我不怎么喜欢现在的这种情况…现在的我无法测量！","off":"我不太喜欢这种表达方式……但是……现在的我……无法测定！"},{"label":"获得专武","jp":"これは……ものすごいプラスになるやつだ！","fan":"这是……十分给力的东西啊。","off":"这东西……带来的提升真是难以估量！"}],"事件":[{"label":"学生生日","jp":"今日は私の誕生日です。プレゼントは、私が選びますね。さあ、出かけませんか？高い物じゃなくてもいいので！","fan":"今天是我的生日，所以礼物应该由我自己来挑的对吧。要不出门逛逛？就算不买什么很贵的东西也没所谓的！","off":"今天是我的生日。礼物嘛……我自己来挑吧。来，出去逛逛吧！呃……不用买很贵的也行啦！"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。今日で先生が生まれてから約…はい？計算しちゃダメですか？","fan":"生日快乐，老师。今天是老师出生的第……欸，不能算这个吗？","off":"祝您生日快乐，老师！今天是老师出生后的第……诶？不能算嘛……？"},{"label":"万圣节","jp":"学園都市の人口に比例してみると、現在のキヴォトスに流通している飴の数とそのカロリーは…（ぶつぶつ）","fan":"根据学园都市的人口来计算，现在基沃托斯流通着的糖的数量及其卡路里是……","off":"如果和这个都市的总人口成比例的话，目前在基沃托斯流通的糖果数量及其卡路里是……"},{"label":"新年","jp":"数学でも初めが肝心です。今年の始まりを、一緒に始めましょうか？","fan":"开头在数学上也是十分关键的，所以今年，能和我一起开个好头吗？","off":"在数学里，开头也是很重要的。新年伊始，让我们一同前进吧！"},{"label":"圣诞节","jp":"クリスマスか…。普段こういう日はちっとも楽しくないけど。今は先生がいてくれて、少しは楽しいですね。","fan":"圣诞节吗？平常的这个时候我觉得十分无聊，但是现在老师在我的身边，还是有一点乐趣的。","off":"圣诞节啊……换作以前，我对这种日子真没什么感觉。不过现在有老师在，还是有点开心的。"},{"label":"春节","jp":"","fan":"老师，祝您新春快乐！……经过我的计算，今年您遇到好事的概率很大呢！","off":"老师，祝您新春快乐！……经过我的计算，今年您遇到好事的概率很大呢！"},{"label":"中秋","jp":"","fan":"今天就不要计较卡路里了！……老师，我们一起来分享这些月饼怎么样？","off":"今天就不要计较卡路里了！……老师，我们一起来分享这些月饼怎么样？"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/4/579829.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/700965.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/796346.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/4/462668.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/478994.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/271679.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/4/416767.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/4408/2025/5/19/371784.ogg","https://cdnimg-v2.g