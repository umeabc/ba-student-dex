mages/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/13/9542.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/13/376779.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 晴奈","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/13/815630.png","url":"https://www.gamekee.com/ba/62592.html"},{"name":"★3 晴奈（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/13/481521.png","url":"https://www.gamekee.com/ba/579682.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive"},{"label":"卡池抽取","jp":"運動…そして食欲の季節！まさに美食の祭典…この絶好の機会、堪能するよ他ありませんわ！","fan":"运动…还有食欲的季节！简直就是美食的祭典…在这绝好的机会面前，只能尽情享受了！","off":"这个季节，不仅为运动而生，也为食欲而生……！ \n这绝佳的机会，我一定要好好享受。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさいませ、先生。本日のご予定を伺っても？","fan":"欢迎回来，老师。今天您有什么安排吗？","off":"老师，欢迎回来。\n请问您今天有什么安排呢？"},{"label":"登陆2","jp":"私をこんなに待たせるなんて…でも、先生の事でしたら、私いくらでも待てますわ。","fan":"竟然让我这样等这么久…不过，如果是老师的话，多久我都愿意等。","off":"竟然让我等了这么久……\n不过，如果是老师的话……我无论等多久都没关系……"},{"label":"大厅1","jp":"せっかくの体操服ですし…競技に参加したい気持ちもあるのですが…","fan":"难得穿一次体操服…虽然也想去参加竞技项目…","off":"难得穿了体操服……虽然也想去参加比赛……"},{"label":"大厅2","jp":"試合に出て、応援をし、美味しいものを口にする…実に、完璧な循環ですわ。","fan":"参加比赛，参与应援，品尝美食…实在是完美的循环。","off":"参赛、应援、品尝美食……这真是完美的循环呢。"},{"label":"大厅3","jp":"身体が軽くなったようなこの感覚…体操服とは、良いものですね。","fan":"有种身体变得轻快起来的感觉…体操服是个好东西呢。","off":"感觉身体都变轻快了……体操服真是个好东西呢。"},{"label":"大厅4","jp":"いつもより、心に余裕が生まれた気がします。この服装のおかげかしら？それとも先生の…？","fan":"感觉比平常更加游刃有余。多亏了这身服装吗？还是说多亏了老师…？","off":"感觉心情比平时要轻松许多呢。\n是因为这身衣服吗？ 还是说，因为老师……？"},{"label":"大厅5","jp":"先生、この後、少しお時間いただけますか？絶品の屋台へご案内いたしますわ。","fan":"老师，能稍微借用一下您的时间吗？就让我带您去能称得上绝品的摊子。","off":"老师，稍后能请您抽出一些时间吗？\n我想带您去最棒的路边摊。"},{"label":"回忆大厅1","jp":"心躍る、美味しい競技でしたわね。","fan":"真是令人兴奋的精彩比赛。","off":"真是一场既美味，又让人心跳加速的比赛呢。虽然脸上有些脏了……"},{"label":"回忆大厅2","jp":"顔は少し汚れてしまいましたけれども…ですが、未知の領域とも言える小麦粉の中から、自分の感覚だけで、飴を見つける行為は、","fan":"虽然把脸弄脏了…但是，从称得上未知的领域的小麦粉中，仅凭自身的感觉找到糖，这种行为","off":"不过， 在堪称未知领域的面粉里，仅凭自己的感觉，寻找着糖果……"},{"label":"回忆大厅3","jp":"美食を探求する過程と、どこか似ているような気がして、とても新鮮でした。","fan":"与探索美食的过程，有不谋而合之处，很新鲜的体验。","off":"这和探索美食的过程，有着几分相似之处呢……真是新鲜呢。"},{"label":"回忆大厅4","jp":"あっ！そうです！","fan":"啊！对了！","off":"哦，对了！"},{"label":"回忆大厅5","jp":"先生、いかがでしょう？先程とったこの飴…分けて差し上げましょうか？","fan":"老师意下如何？刚刚找到的这颗糖，要分给您尝尝吗？","off":"老师……想尝尝吗？我刚才拿到的这些糖果……要不要分您一些呢？"},{"label":"咖啡馆1","jp":"さあ、美食の探検と洒落込みましょうか。","fan":"让我们开始华丽的美食探险吧。","off":"那么，就让我们开始美食探险吧。"},{"label":"咖啡馆2","jp":"さて、どこから行きましょう？","fan":"那么，先从哪里开始吧。","off":"那么，该先去哪里呢……？"},{"label":"咖啡馆3","jp":"食事とは、至高の行為。","fan":"所谓饮食，乃是至高无上的行为。","off":"吃饭可是至高无上的事情。"},{"label":"咖啡馆4","jp":"運動効果を高めるためにも、\nきちんとした食事は必要不可欠ですわ。","fan":"为了提高运动效果，好好吃饭是必不可少的。","off":"就算是为了提高运动效果，也必须得好好吃饭。"},{"label":"咖啡馆5","jp":"休憩が終わりましたら、屋台巡りにいきませんか？","fan":"休息完了之后，一起去小吃摊逛逛吗？","off":"等休息结束后， 要一起去路边摊逛逛吗？"}],"好感度":[{"label":"好感度1","jp":"私、先生のお傍にいると、様々な感情が溢れてくるのです…先生はご存知でしたか？","fan":"只要在老师身边，我的心里就会涌现出许多感情…您知道吗？","off":"我只要待在老师身边，内心就会涌出各种各样的感情……\n老师……您明白吗？"},{"label":"好感度2","jp":"先生がいらっしゃるからこそ、私は輝けるのですわ。","fan":"正是因为有老师在我身边，我才能这样充满活力。","off":"因为有老师在，我才能如此闪耀。"},{"label":"好感度3","jp":"運動後の美食は格別なもの、それが先生と共にできるのであれば、尚のこと。","fan":"运动后享用美食这一行为有它的独特之处，如果是能和老师一起的话，更是如此。","off":"运动后的美食，别有一番风味。\n如果是和老师一起享用的话，那就更……"},{"label":"好感度4","jp":"体操服、合っていますか…？うふふ、至極当然のことですが、ありがとうございます。","fan":"体操服，很合适吗…？唔呼呼，虽然是理所当然的事情，还是要谢谢您的称赞。","off":"体操服很适合我吗……？\n虽然这是理所当然的，但还是谢谢您。"}],"战斗":[{"label":"编入队伍1","jp":"味わったら忘れられないようなひと時が..さあ、参りましょう。","fan":"只要品味过就无法忘记的片刻来临了…让我们登场吧。","off":"好了，向着一段品尝过就难以忘却的一刻出发吧。"},{"label":"编入队伍2","jp":"健全な精神は、健全な美食に宿るものですから。","fan":"健全的精神，寄于健全的美食当中。","off":"健全的精神寓于健全的美食之中。"},{"label":"拎起","jp":"胸躍る美食ロードに連れて行って差し上げますわ。","fan":"就让我带您踏上令人心动的美食之路吧。","off":""},{"label":"普通技能","jp":"差し上げますわ。","fan":"送给您。","off":"请收下吧。"},{"label":"EX动画1","jp":"さて、次は…ふふ、楽しいですわ。","fan":"那么，下一个是…呵呵，真是愉快。","off":"那么，接下来是……\n好期待。"},{"label":"EX动画2","jp":"この次は、これぞ探求の道。","fan":"这之后，就是探求之道了。","off":"这之后才是探求之路。"},{"label":"EX动画3","jp":"よいしょっと、更なる美食へ。","fan":"嘿咻，向着更多美食，前进吧。","off":"好，向着更多美食出发吧！"},{"label":"EX技能1","jp":"こういうのはいかがでしょう？","fan":"这样如何？","off":"这样如何呢？"},{"label":"EX技能2","jp":"こういうのも新鮮ですね。","fan":"这种体验也很新鲜呢。","off":"这种体验，也很新鲜呢。"},{"label":"EX技能3","jp":"はい、どうぞ召し上がってください。","fan":"请享用吧。","off":"来，请您好好享用吧。"}],"成长":[{"label":"升级1","jp":"体を動かすのも、たまには良いですね。","fan":"偶尔活动身体也不错呢。","off":"像这样偶尔活动活动身体，也挺开心的。"},{"label":"升级2","jp":"いつも見守ってくださり、ありがとうございます、先生。","fan":"感谢您一直关注着我，老师。","off":"感谢您一直以来对我的照顾，老师。"},{"label":"升级3","jp":"何から何まで、お気遣い、感謝いたします。屋台の案内でしたら、私にお任せください。","fan":"感谢您事无巨细的悉心照料。如果要逛小吃摊的话，就交给我吧","off":"感谢您事无巨细的关心，\n如果您想去路边摊的话，就让我来带路吧。"},{"label":"升级4","jp":"今日という日は、ずっと心に刻まれることでしょう、とても素敵なことがありましたから。","fan":"今天，将会永远铭刻于心中吧，毕竟发生了如此美妙的事情。","off":"我应该会把今天铭记于心吧……\n毕竟，今天是如此美妙。"},{"label":"获得专武","jp":"こちらも総力を挙げて参りましょう。このように目をかけてくださる先生のためにも。","fan":"我也全力以赴吧，这也是为了一直关注我的老师。","off":"就算是为了如此关心我的老师，\n 我也会全力以赴的。"}],"事件":[{"label":"学生生日","jp":"私の誕生日のお祝いだなんて…ありがとうございます。プレゼントは、すでに頂いておりますのに。滅多にない機会ですから、我儘をひとつ。よろしければ…私の屋台巡りに付き合ってください。","fan":"竟然是给我的生日祝福…感谢您。礼物的话，我已经收到了。这可是千载难逢的机会，我有一个任性的请求。如果可以的话…请陪我一起去逛摊子吧。","off":"您竟然会 祝我生日快乐……谢谢您。 \n礼物的话，我觉得已经收到了哦……\n难得有这种机会，所以我想任性一下。\n如果您不介意的话……能陪我逛逛路边摊吗？"},{"label":"老师生日","jp":"ええ、もちろん覚えております。今日は、先生のお誕生日。軽装で動きやすいですし…一緒に遠出なんて、いかがでしょう？","fan":"嗯，我当然记得。今天是老师的生日。刚好，轻装上阵便于活动…一起去远行，如何？","off":"我当然记得，今天是老师的生日。\n正好我现在穿着方便活动的衣服…… 要和我一起出去走走吗？"},{"label":"万圣节","jp":"この格好…ハロウィーンの仮装だと思われてしまったみたいで、その時に、近くの屋台でカボチャのスナックを見つけたのです。一緒に参りませんか？","fan":"这副打扮…会被认为是万圣节装扮吧。到那时，在附近的小摊能找到南瓜做的点心。一起去看看吗？","off":"我现在的衣服……会被人当作是 万圣节装扮吧……？\n等到万圣节的时候， 能在附近的路边摊上发现南瓜零食，\n老师要不要和我一起去看看？"},{"label":"新年","jp":"あけましておめでとうございます、先生。新たな年の記念すべき始まりの日。魅力的な屋台料理がたくさん堪能できる時期でもありますわ。さあ、それでは\n出かけましょうか。","fan":"新年快乐，老师。今天是新的一年中值得纪念的开始之日。是能够享受充满魅力的小吃摊料理的时期。那么，一起出门吧。","off":"老师，祝您新年快乐。 \n今天新年伊始， 值得纪念呢……\n而且今天也是能享用各种路边摊美食的日子，那么让我们出发吧？"},{"label":"圣诞节","jp":"クリスマスを共に過ごす…ふふ、素敵な響きですわね。先生と囲む食卓に相応しい料理をお持ちしましたわ。さあ、いただきましょう。","fan":"和老师一起过圣诞节…呼呼，听起来很棒呢。我带来了能配得上与老师围在桌前共享美食这美妙的氛围的料理。那么，开始享用吧。","off":"和老师一起过圣诞节……听着真美好呢。\n我带来了适合和老师一起享用的料理，来一起尝尝吧。"},{"label":"春节","jp":"","fan":"老师，祝您新春快乐。 \n不知在下次的晄轮大会上，又会有怎样的美食在等待我们呢？","off":"老师，祝您新春快乐。 \n不知在下次的晄轮大会上，又会有怎样的美食在等待我们呢？"},{"label":"中秋","jp":"","fan":"如果将千禧年最尖端的分子料理技术应用于传统的月饼上， \n又会碰撞出怎样的火花呢？我很期待呢。","off":"如果将千禧年最尖端的分子料理技术应用于传统的月饼上， \n又会碰撞出怎样的火花呢？我很期待呢。"}],"活动":[{"label":"活动登陆1","jp":"晄輪大祭…新たな美食の地平がやって参りましたわ。","fan":"晄轮大祭…崭新的美食新大陆到来了。","off":"晄轮大会……\n发现美食新大陆的日子，终于到来了。"},{"label":"活动登陆2","jp":"いらしたのですね、先生。それでは今から私と、屋台征服と洒落込みましょうか","fan":"您来了，老师。那么现在和我一起去征服小摊吧。","off":"您来了，老师。\n那么，接下来请您和我一起，挑战征服路边摊吧？"},{"label":"活动大厅1","jp":"私は太らない体質ですが、たくさん食べられるわけではなく、いつももどかしい気持ちでいっぱいです。","fan":"虽然我是不会胖的体制，但是又不能大吃特吃，这总是很让人烦恼呢。","off":"虽然我是吃不胖的体质， 但也不能吃太多……\n这总是让我苦恼呢。"},{"label":"活动大厅2","jp":"少し体を動かしたくなりました、私も参加してもよろしいでしょうか？パン食い競争に。","fan":"想稍微活动活动身体了，我也可以参加竞技吗？参加吃面包比赛。","off":"我想活动活动身体，我能去参加比赛吗？ \n吃面包大赛就可以。"},{"label":"活动大厅3","jp":"晄輪大祭の屋台はまさに美食の博覧会そのもの！究極の味わいがきっとそこに…！","fan":"晄轮大祭的小摊简直就是美食博览会！究极的味道一定就在那里…！","off":"晄轮大会的路边摊简直就是美食博览会！\n究极的味道一定就在那里……！"},{"label":"活动大厅4","jp":"先生、少しだけ一緒に歩きませんか？いつもと違う格好も乙なものですよ。","fan":"老师，一起散散步吗？与平常不同的服装也是别有一番风味哦。","off":"老师…… 可以稍微陪我走走吗？\n穿着和平时不同的衣服去散步的话， 会别有一番风味哦。"},{"label":"活动进度1","jp":"先生、楽しんでおりますか？私はこの上なく、放下しておりますわ。","fan":"老师，有在好好享受吗？没什么比这更重要了，我可是把一切都放下了。","off":"老师， 玩得开心吗？\n我可是无比享受呢。"},{"label":"活动进度2","jp":"気がついたら、晄輪大祭も終盤に…「楽しい時間はあっという間」っと言いますけれども、思い出はいつまでも残るものですわ。","fan":"回过神来，晄轮大祭也进入到尾声了…虽然说欢乐的时光总是短暂的，但是回忆永远都会存于心中。","off":"不知不觉，晄轮大会也接近尾声了……\n虽然说快乐的时光总是短暂的……\n但这份回忆会永远留在我的心中。"},{"label":"活动进度3","jp":"ご機嫌よ、先生。屋台の制覇なら、済んでおりますわ。","fan":"您好，老师。如果是制霸小摊的话，已经完成了哦。","off":"老师，您好。 \n路边摊我已经逛完啦。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/17/360429.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/17/400370.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/3/7/395424.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/17/318663.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5