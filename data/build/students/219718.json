ee.com/wiki2.0/pro/829/images/w_304/h_240/408107/2026/6/29/69679724ms69gxgt.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/408107/2026/6/29/66494747ms69h51y.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/408107/2026/6/29/39568912ms69h8i4.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/408107/2026/6/29/46660819ms69hbfl.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/408107/2026/6/29/02434428ms69hejd.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/408107/2026/6/29/68380696ms69hwcd.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/408107/2026/6/29/81178407ms69i2b2.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 皋月","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/43637/2025/5/10/780894.png","url":"https://www.gamekee.com/ba/tj/71740.html"}],"voices":{"通常":[{"label":"标题","jp":"ブル～アーカイブ～","fan":"蔚蓝～档案～","off":""},{"label":"卡池抽取","jp":"あら、呼んだかしら、先生？これから幾千年の協力を約束して頂戴？","fan":"啊啦，老师，你叫我了吗？那可要答应我，从今以后，我们要一起合作几千年哦？","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"待っていたのよ、先生。ここは万全の安全対策をしているわ。安心して頂戴。","fan":"我一直在等你哦，老师。这里的安全措施已经万无一失了，放心吧。","off":""},{"label":"登陆2","jp":"ふふっ、待ちくたびれたわよ？今日の仕事はそこにまとめてあるわ。","fan":"哼哼，我可是等你好久了呢。今天的工作我已经整理好放在那里了哦。","off":""},{"label":"大厅1","jp":"あら、どうかしたのかしら？集中力が切れたの？\nふふっ、仕方ないわね。集中力をあげる催眠をかけてあげる。","fan":"啊啦，怎么了吗？注意力涣散了？\n哼哼，真拿你没办法。我来给你施加一个提升专注力的催眠吧。","off":""},{"label":"大厅2","jp":"きゃっ！足に何かが当たって……み、未知の脅威！？\nあ、先生の足だったのね。びっくりした……。\nはぁ……気を緩められないわね。","fan":"噫呀！脚好像碰到了什么……未、未知的威胁！？\n啊，是老师的脚啊。吓我一跳……。\n唉……真是一刻都不能放松呢。","off":""},{"label":"大厅3","jp":"業務時間50分に、休憩10分。これがより効率的な作業の進め方よ。\n体調には気をつけるのよ、先生。あなたの健康が何よりも大事なのだから。","fan":"工作50分钟，休息10分钟。这才是高效率的工作方式哦。\n要注意身体啊，老师。你的健康才是最重要的。","off":""},{"label":"大厅4","jp":"先生と一緒にいると、なんだか落ち着くわ。\nあなたが何をしているのか気を揉まなくて済むからかもしれないわね。","fan":"和老师待在一起，总觉得很安心。\n或许是因为，不用一直担心你在做些什么吧。","off":""},{"label":"大厅5","jp":"仕事は終わったかしら？なら、私の前に座りなさい。\nええ、そうよ……。後の時間は、私だけを見ていて頂戴。","fan":"工作结束了吗？那就坐到我面前来吧。\n对，就是这样……接下来的时间，只准看着我一个人哦。","off":""},{"label":"回忆大厅1","jp":"思い返せば、いつもそうだったわね。\n先生は私の隣を歩いてくれた。","fan":"回想起来，一直都是这样呢。\n老师总是陪在我的身边。","off":""},{"label":"回忆大厅2","jp":"どんなわがままを言っても――\nあなたを拷問したり、催眠をかけてみたりしても。\nどんなことだって、文句も言わずに付き合ってくれた。","fan":"无论我提出多么任性的要求——\n哪怕是想拷问你，试着对你施加催眠。\n不管做了什么，你都会毫无怨言地陪着我。","off":""},{"label":"回忆大厅3","jp":"……私を守るって言ってくれて、ありがとう。\n怖がっているとき、手を握ってくれてありがとう。\nいつでも駆けつけてきてくれて、ありがとう。","fan":"……谢谢你，对我说会保护我。\n谢谢你，在我害怕的时候紧握住我的手。\n谢谢你，无论何时都会赶到我的身边。","off":""},{"label":"回忆大厅4","jp":"だから――\nこれからも……よろしくね、先生。","fan":"所以——\n今后也……请多多关照了，老师。","off":""},{"label":"咖啡馆1","jp":"ここでは日焼け止めは……いらないのかしら。","fan":"在这里……是不是不用涂防晒霜了呢？","off":""},{"label":"咖啡馆2","jp":"ぐ～るぐ～る……ぐ～るぐ～る……。練習はこのくらいで良いかしら。","fan":"转呀转……转呀转……练习到这里就应该差不多了吧。","off":""},{"label":"咖啡馆3","jp":"人口密度が上がっている……。危険度が上がってきたわね。","fan":"人口密度变高了……危险等级也提高了呢。","off":""},{"label":"咖啡馆4","jp":"先生はどこにいるのかしら。背中を預け合いたいのに。","fan":"老师在哪里呢。我还想把后背托付给你呢。","off":""},{"label":"咖啡馆5","jp":"あれは……なんだか危険な香りがするわ。","fan":"那个……好像散发着危险气息呢。","off":""}],"好感度":[{"label":"好感度1","jp":"引き続き、私のそばで守っていて頂戴。","fan":"接下来，也请继续待在我身边保护我吧。","off":""},{"label":"好感度2","jp":"なんだか変な気分ね。情報部の総力をあげて、理由を突き止めた方がいいのかもしれないわ。","fan":"总觉得有点奇怪呢。也许应该动员情报部的全部力量，查清楚原因才行呢。","off":""},{"label":"好感度3","jp":"先生と一緒にいると……どんなに暗い場所でも、あまり怖くないの。","fan":"和老师在一起的话……不管多黑的地方，都不会感到害怕了呢。","off":""},{"label":"好感度4","jp":"千年の約束は絶対よ、先生。これからもずっと、私のそばにいて頂戴ね。","fan":"老师，我们约定好的千年之约，可一定要遵守哦。今后也请一直留在我的身边吧。","off":""}],"战斗":[{"label":"编入队伍1","jp":"私が出るのかしら？","fan":"是轮到我出场了吗？","off":""},{"label":"编入队伍2","jp":"痛いのは苦手なんだけど……。","fan":"我可是很怕疼的呢……","off":""},{"label":"拎起","jp":"あら？抱っこしてほしいのかしら？","fan":"啊啦？你是想让我抱抱吗？","off":""},{"label":"任命队长1","jp":"万魔殿、総攻撃よ。","fan":"万魔殿，全员总攻！","off":""},{"label":"任命队长2","jp":"催眠で終わらせたいのだけど……。","fan":"本来想靠催眠解决的……","off":""},{"label":"普通技能","jp":"嫌～！","fan":"不要～！","off":""},{"label":"EX动画1","jp":"あら、そこにいたの。浜辺は危険がたくさんあるの。さあ、紫外線対策を始めるわよ。","fan":"啊啦，你在那里啊。海边可是充满危险的。来，开始做防晒措施吧。","off":""},{"label":"EX动画2","jp":"こっちに来て頂戴。無防備すぎるわね。遠慮しなくていいのよ？","fan":"快到我这边来。你也太没有防备了。用不着跟我客气哦？","off":""},{"label":"EX动画3","jp":"そのままでは危険よ！じっとしていなさい……。私が塗ってあげるから。","fan":"这样下去可是很危险的！别乱动……我来帮你涂。","off":""},{"label":"EX技能1","jp":"日焼けには注意するのよ。","fan":"要注意防晒哦。","off":""},{"label":"EX技能2","jp":"紫外線がどれだけ危険なのか……知っているわよね？","fan":"紫外线到底有多危险……你应该知道吧？","off":""},{"label":"EX技能3","jp":"遠慮しないで頂戴。","fan":"不用跟我客气。","off":""},{"label":"战斗开始1","jp":"痛くしないでね……？","fan":"可以不要弄疼我吗……？","off":""},{"label":"战斗开始2","jp":"私は隅で応援しているわね。","fan":"那我就在旁边给大家加油吧。","off":""},{"label":"获得BUFF","jp":"あら、ありがとう～","fan":"啊啦，谢谢～","off":""},{"label":"施放BUFF","jp":"コンディション管理は万全よ。","fan":"状态管理可是万无一失的哦。","off":""},{"label":"掩体","jp":"痛いのはイヤよ！","fan":"我怕疼啦！","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"被CC3","jp":"痛いわ","fan":"好痛啊","off":""},{"label":"回避","jp":"ふ～ん、無駄なのに。","fan":"哼嗯～明明是白费功夫。","off":""},{"label":"队伍移动1","jp":"まだ何か残っているのかしら。","fan":"还有什么没解决的吗？","off":""},{"label":"队伍移动2","jp":"終わりじゃないの？","fan":"还没结束吗？","off":""},{"label":"回复","jp":"あら、ありがとう。","fan":"啊啦，谢谢。","off":""},{"label":"中途退出","jp":"先生、助けて!","fan":"老师，救命！","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"角色移动","jp":"ひゃっ！","fan":"噫呀！","off":""},{"label":"战斗胜利1","jp":"ふふっ、当然の結果ね。","fan":"哼哼，这不是理所当然的结果吗。","off":""},{"label":"战斗胜利2","jp":"先生と私の勝利、というべきかしら？","fan":"应该说，这是老师和我的胜利吧？","off":""},{"label":"关卡完成1","jp":"ふふっ、情報が勝利の鍵なのよ？","fan":"哼哼，情报才是胜利的关键哦？","off":""},{"label":"关卡完成2","jp":"感謝してもいいのよ、先生？","fan":"你可以好好感谢我哦，老师？","off":""},{"label":"战斗失败1","jp":"こんな要素、計算にはなかったわ","fan":"这种要素，可没在我的计算之内呢","off":""},{"label":"战斗失败2","jp":"誰にも言わないでちょうだい。","fan":"请别告诉任何人。","off":""}],"成长":[{"label":"升级1","jp":"強くなった気がするわね。ふふっ……データは正直よ？","fan":"感觉自己变强了呢。哼哼……数据可是不会骗人的哦？","off":""},{"label":"升级2","jp":"生存率が上がったわね。","fan":"生存率提高了呢。","off":""},{"label":"升级3","jp":"ふふっ、NKウルトラ計画がまた一歩、進んだわね。","fan":"哼哼，NK Ultra计划又向前迈进了一步呢。","off":""},{"label":"升级4","jp":"いつも助けてもらってばかりね……ありがとう、先生。","fan":"一直都是老师在帮助我呢……谢谢你，老师。","off":""},{"label":"获得专武","jp":"あら、私のために用意してくれたの？ありがとう、先生。でもお礼がないわね……私を好きにする権利、とかどうかしら？","fan":"啊啦，这是特地为我准备的吗？谢谢你，老师。不过，好像手边没有谢礼呢……不如，给老师一个可以对我为所欲为的权利，怎么样？","off":""}],"事件":[{"label":"学生生日","jp":"今日は特別な日――あなたなら、知っているわよね？\nふふっ、プレゼントは……。\n要らないわ。だって先生が――あなたが、目の前にいるんだもの。","fan":"今天可是个很特别的日子——你当然知道是什么吧？\n哼哼，礼物的话……\n不需要哦。因为老师——你，不是就在我的面前吗。","off":""},{"label":"老师生日","jp":"ふふっ、今日は先生の誕生日ね？もちろん、それくらい把握しているわよ。\nさあ、ほしいものを言ってみなさい。なんでもいいのよ？","fan":"哼哼，今天是老师的生日吧？那是当然，这种事情我可是记得清清楚楚。\n来，说说你想要什么吧。什么都可以哦？","off":""},{"label":"万圣节","jp":"Trick ortreat～！催眠とイタズラ、先生はどっちが好きかしら？\nほら……選んで頂戴。","fan":"Trick or Treat～！催眠和恶作剧，老师更喜欢哪一个呢？\n来……选一个吧。","off":""},{"label":"新年","jp":"あけましておめでとう、先生。今年も私のそばで生存率を上げていきましょうね？","fan":"新年快乐，老师。今年也一起提高生存率吧？","off":""},{"label":"圣诞节","jp":"クリスマスって、みんなが浮かれるのよね。\n私？……そうね。ちょっとだけ浮かれているわ。だって、あなたと一緒にいるのだもの。","fan":"圣诞节啊，大家都会变得很兴奋呢。\n我？……嗯，也是有一点点啦。那是因为，有你陪在我身边呀。","off":""}],"活动":[{"label":"活动登陆1","jp":"はあ……こんなことになるなんて……。\n大丈夫よ、先生。なんとかなるわ。","fan":"唉……没想到事情会变成这样……\n没关系的，老师。总会有办法的。","off":""},{"label":"活动登陆2","jp":"まさか漂流するなんて……できることからやっていきましょう。","fan":"没想到居然会被困在海上随波逐流……先从能做的事情开始吧。","off":""},{"label":"活动大厅1","jp":"うん？なに？\n……あまり心配しないで大丈夫？\nふふっ、先生。私を慰めてくれているのかしら？","fan":"嗯？怎么了？\n……不用太担心哦？\n哼哼，老师。你是在安慰我吗？","off":""},{"label":"活动大厅2","jp":"なんだか思っていたのとは違うけれど……。\nまぁ、海は元々危険な場所だものね。仕方がないわ。","fan":"总觉得和我想象中的不太一样呢……\n不过，大海本来就是危险的地方嘛，也没办法呢。","off":""},{"label":"活动大厅3","jp":"この水着？\nああ、大丈夫よ。日焼け止めをちゃんと塗っているもの。\nやっぱり、自分が気に入っているものを着ないとね。","fan":"这套泳装？\n啊，没关系哦。我可是有好好涂防晒霜的呢。\n果然，还是要穿自己喜欢的衣服才行呢。","off":""},{"label":"活动大厅4","jp":"……うん。やっぱり、先生の手は温かい。\n握っていると、安心するの。","fan":"……嗯，老师的手果然很温暖呢。\n握着的话，就会觉得很安心。","off":""},{"label":"活动事件1","jp":"ゆ、幽霊船って……本当かしら？先生、なんとかしなさい……！","fan":"幽、幽灵船……是真的吗？老师，快想想办法啊……！","off":""},{"label":"活动事件2","jp":"マコトちゃん、完全に役に入っちゃってるわね……。まあ、大丈夫だと信じているわ。","fan":"真琴酱已经完全入戏了呢……不过，我相信不会有问题的。","off":""},{"label":"活动结束","jp":"これで全て解決……したのかしら？一件落着、ね。","fan":"这样就全部解决……了吗？总算圆满落幕了呢。","off":""},{"label":"ch0345_minigame_drawturn_1","jp":"うっ…","fan":"唔……","off":""},{"label":"ch0345_minigame_drawturn_2","jp":"予想していたのと違うわね","fan":"和预想的不一样呢","off":""},{"label":"ch0345_minigame_losebattle_1","jp":"レヴィアタン、大丈夫?痛くない?","fan":"利维坦，没事吧？疼不疼？","off":""},{"label":"ch0345_minigame_loseturn_1","jp":"あぁ！","fan":"啊啊！","off":""},{"label":"ch0345_minigame_loseturn_2","jp":"待ってちょうだい！","fan":"等一下啦！","off":""},{"label":"ch0345_minigame_loseturn_3","jp":"うう、ごめんなさい。","fan":"呜呜，对不起。","off":""},{"label":"ch0345_minigame_loseturnspecial_1","jp":"あ、あれ?どうしてこんな結果になってしまったのかしら?","fan":"啊，咦？怎么会变成这样的结果呢？","off":""},{"label":"ch0345_minigame_winbattle_1","jp":"相手を知っていれば負けるわけないじゃない。","fan":"只要了解对手，就不可能会输的呀。","off":""},{"label":"ch0345_minigame_winturn_1","jp":"えへん","fan":"诶哼","off":""},{"label":"ch0345_minigame_winturn_2","jp":"当然ね。","fan":"当然咯。","off":""},{"label":"ch0345_minigame_winturn_3","jp":"通じないわよ","fan":"行不通的哦","off":""},{"label":"ch0345_minigame_winturnspecial_1","jp":"ふふ、これが情報の差よ。。","fan":"呵呵，这就是情报的差距哦。","off":""},{"label":"ch0345_minigame_winturnspecial_2","jp":"やるじゃない。","fan":"干得不错嘛。","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/6/30/12652201ms6w35i7.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/6/30/05331642ms6w3bvu.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/6/30/78195308ms6w3d13.ogg","",""],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/6/30/40815707ms6w3e4e.ogg","",""],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/6/30/92519728ms6w3g21.