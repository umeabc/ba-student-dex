.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/12635.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/590623.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 真纪（野营）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/12/136522.png","url":"https://www.gamekee.com/ba/647136.html"},{"name":"NPC 真纪（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/675941.png","url":"https://www.gamekee.com/ba/643808.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案。"},{"label":"卡池抽取","jp":"碧蓝档案。","fan":"呀，老师！要一起去涂鸦吗~？","off":"呦，老师，要不要一块去涂鸦？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰り、先生。今日のファッションもいい感じだね？","fan":"欢迎回来，老师。今天你看起来也很时尚呢。","off":"老师，你回来啦，哦，今天的穿搭也让人眼前一亮嘛。"},{"label":"登陆2","jp":"遅いじゃん、先生これ以上待たせてたら…\n先生のスマホ、ドカンッ！って爆発させるところだったよ。","fan":"迟到啦，老师让我等了那么久……\n老师的手机，会磅！地一下爆炸哦。","off":"老师，你怎么才来啊，要是再让我干等会，我就让老师的手机嘣的一下炸掉了哦？"},{"label":"大厅1","jp":"あたしの顔に何かついてる？…うん？塗料？","fan":"我的脸上沾了什么吗？……嗯？颜料？","off":"我脸上蹭到什么东西了吗？嗯？颜料？"},{"label":"大厅2","jp":"このグラフィティ素敵でしょ？あたしが描いたの！","fan":"这个涂鸦很帅吧？我画的！","off":"这个涂鸦是不是很酷？我亲手画的。"},{"label":"大厅3","jp":"せっかくセキュリティを突破したのに、\nその足跡も残さなかったら、ハッキングのし甲斐がないよね。ふふっ。","fan":"好不容易才突破了电脑的安保系统，\n如果不留下点痕迹，入侵就没有意义了呢。呵呵。","off":"好不容易突破了防御，要是不留下什么，我这个黑客不是白当了吗？"},{"label":"大厅4","jp":"TANGO DOWN！","fan":"TANGO DOWN！","off":"TANGO DOWN！"},{"label":"大厅5","jp":"キヴォトス中央のサンクトゥムタワーの外壁を、\n全部グラフィティで埋められたら、どんなに素敵だろう…？","fan":"基沃托斯中央的圣塔的外墙，\n全部填满涂鸦的话，该是怎样的壮观啊……？","off":"如果能把基沃托斯中央那个圣所之塔的外墙全部画满涂鸦，肯定帅呆了。"},{"label":"回忆大厅1","jp":"さて、これでいい感じじゃない？\n先生から見て、どう？","fan":"看上去不错吧？\n老师以为如何？","off":"怎么样？感觉不错吧？老师觉得呢？"},{"label":"回忆大厅2","jp":"えぇっ…なんでそんなにイマイチな反応なの？\nもっと芸術魂を燃やして見てみてよ！","fan":"诶……怎么一副不怎么样的表情？\n就让我让你看看艺术之魂更猛烈地燃烧吧！","off":"嗯？你的反应怎么这么不冷不热的呀，让我看看你熊熊燃烧的艺术之魂吧！"},{"label":"回忆大厅3","jp":"先生は何を描いたの？\nえーっと…。\nあはは！なにこれ、めっちゃ面白い！","fan":"老师在画什么？\n让我看看……\n啊哈哈！这是什么，超级好笑的！","off":"老师你在画什么？我看看？哈哈哈哈什么呀这是，太搞笑了吧！"},{"label":"回忆大厅4","jp":"こんな高いところで怖くないのかって？\n大丈夫、先生がそばにいるから。","fan":"站这么高不害怕吗？\n没事的，老师在身边所以没关系。","off":"你问我这么高怕不怕，不怕呀，因为老师陪着我呢。"},{"label":"回忆大厅5","jp":"必要ならいつでもあたしを呼んで。 \n壁も、先生も、いい感じに彩ってあげる！","fan":"有需要请随时叫我。\n墙壁和老师，我都会带来美妙的色彩！","off":"需要的话随时叫我哦，无论是墙还是老师，我都可以让你们大放异彩！"},{"label":"咖啡馆1","jp":"ここの壁にあたしの絵を添えたら、もっと素敵になりそう！","fan":"这里的墙壁如果添上我的画，应该可以变得更好看！","off":"这面墙再加上我的画，应该会更好看。"},{"label":"咖啡馆2","jp":"このふかふかな感じをスプレーで表現するにはどうすればいいのかな？","fan":"这种松松软软的感觉要怎么用喷漆表现出来呢？","off":"这种松软的感觉用喷漆怎么表现呢？"},{"label":"咖啡馆3","jp":"おっと、塗料が付かないように気を付けて、気を付けて…っと。","fan":"哎哟，不要染上颜料，不要染上……","off":"哎呀，当心点当心点，可不能把颜料蹭到衣服上"},{"label":"咖啡馆4","jp":"ここに赤を足したらどうかな？","fan":"在这里加上红色怎么样？","off":"在这边补点红色怎么样？"},{"label":"咖啡馆5","jp":"…すごくいい色…。","fan":"…好美的颜色…。","off":"这个颜色感觉好棒！"}],"好感度":[{"label":"好感度1","jp":"あはは、いつも手伝ってくれてありがとう、先生。","fan":"啊哈哈，感谢你一直以来的帮助，老师。","off":"哈哈，谢谢老师一直帮助我！"},{"label":"好感度2","jp":"一度くらいは、先生の顔を描いてみたいなぁ。","fan":"好想在老师的脸上画画，就一次也行啊。","off":"哈哈，谢谢老师一直帮助我！"},{"label":"好感度3","jp":"せ、先生の写真とか見てたわけじゃないから…！","fan":"我、我才没有看老师的照片……！","off":"我，我可没在看老师的照片哦！"},{"label":"好感度4","jp":"先生と一緒にいると、いい感じのインスピレーションがよく浮かぶような気がする","fan":"和老师在一起的话，感觉就会冒出好多超棒的灵感","off":"感觉和老师在一起的时候，脑子里就会闪现出很棒的灵感。"}],"战斗":[{"label":"编入队伍1","jp":"何々～、なんか面白い事でもあった～","fan":"什么什么~有什么好玩的事情吗~","off":"怎么了怎么了？有什么好玩的事吗？"},{"label":"编入队伍2","jp":"えへへー、任せて","fan":"诶嘿嘿，交给我","off":"嘿嘿，交给我吧！"},{"label":"拎起","jp":"あーれ、あたしの出番じゃ無かった？","fan":"怎么啦，不该我上场吗？","off":"啊？不是该我出战了吗？"},{"label":"任命队长1","jp":"あたしが勝ったら、あの遮蔽物に最高のグラフィティを描こう？","fan":"如果我赢了，我要在这个掩体上画上最棒的涂鸦","off":"如果赢了，我就要在那个掩体上画一个最棒的涂鸦！"},{"label":"任命队长2","jp":"今日のグラフィティのフレーズは～、うん、VERITASが良さそう！","fan":"今天配涂鸦的乐章是~嗯，VERITAS就不错！","off":"今天的涂鸦用什么单词呢？真理？好像不错！"},{"label":"普通技能","jp":"弾けろ！","fan":"弹吧！","off":"炸裂吧！"},{"label":"EX动画1","jp":"やっぱ今日も完璧！","fan":"果然今天很完美！","off":"真是完美的一天！"},{"label":"EX动画2","jp":"いひひー、今回の作品も傑作だね","fan":"诶嘿嘿，这次的作品真是杰作","off":"嘿嘿，这次也画了一幅杰作呀！"},{"label":"EX动画3","jp":"うんうん、気に入った","fan":"嗯嗯，我喜欢","off":"嗯嗯，我喜欢！"},{"label":"EX技能1","jp":"くらえ！","fan":"吃我一招！","off":"看招！"},{"label":"EX技能2","jp":"君達にプレゼント！","fan":"送你们的礼物！","off":"送你们一个礼物！"},{"label":"EX技能3","jp":"えはははっ","fan":"啊哈哈哈","off":"哈哈哈 ！"},{"label":"战斗开始1","jp":"さて、実力、発揮してみようかな","fan":"好了，让你看看我的实力吧","off":"好，来发挥一下实力吧！"},{"label":"战斗开始2","jp":"世界をもっと愉快に！","fan":"让世界更加愉快！","off":"让世界变得更有趣吧！"},{"label":"获得BUFF","jp":"私の出番かな？","fan":"到我出场吗？","off":"该我出场了吧？"},{"label":"施放BUFF","jp":"私は今、心から燃え上がっている！","fan":"我现在啊，要燃烧起来了！","off":"我现在感觉热血沸腾！"},{"label":"被CC1","jp":"あぅ……","fan":"啊呜……","off":"-"},{"label":"被CC2","jp":"きゃあ！","fan":"呀！","off":"-"},{"label":"被CC3","jp":"うえぇ？","fan":"唔诶？","off":"-"},{"label":"回避","jp":"えへへー、無駄無駄ぁ！","fan":"诶嘿嘿，没用没用！","off":"捏嘿嘿，没用没用。"},{"label":"队伍移动1","jp":"早く次のグラフィティを描きに行こう","fan":"去下一个地方涂鸦吧","off":"赶快去画下一个涂鸦吧！"},{"label":"队伍移动2","jp":"さぁさぁ、前進前進！","fan":"好了好了，前进前进！","off":"好了好了，前进前进！"},{"label":"回复","jp":"おぉ、ありがとう。","fan":"哦哦，谢谢。","off":"哦，谢谢。"},{"label":"中途退出","jp":"うぅ、やられちゃった","fan":"呜呜，被摆了一道。","off":"哎，被干掉了。"},{"label":"战斗喊叫","jp":"やぁ！","fan":"呀！","off":"-"},{"label":"战斗喊叫","jp":"やーほ～！","fan":"呀嚯~！","off":"-"},{"label":"战斗喊叫","jp":"これあげる","fan":"这个给你","off":"这个给你！"},{"label":"角色移动","jp":"フォーメーション変更！","fan":"阵型变更！","off":"更换阵型。"},{"label":"战斗胜利1","jp":"素晴らしい結果だね。先生から見てどう？","fan":"很棒的结果呢。老师怎么看？","off":"成果还不错嘛，老师觉得呢？"},{"label":"战斗胜利2","jp":"えへへー、あたしの芸術魂は止められない！","fan":"诶嘿嘿。我的艺术之魂永不停息！","off":"嘿嘿，没有任何人可以阻挡我的艺术之魂！"},{"label":"关卡完成1","jp":"勝った勝ったぁ！","fan":"赢啦赢啦！","off":"赢了赢了！"},{"label":"关卡完成2","jp":"今日も一発かましてやったね！","fan":"今天也一招就解决了呢！","off":"今天也战了个痛！"},{"label":"战斗失败1","jp":"うーわ、失敗したー。皆逃げてー","fan":"呜哇，失败了——大家快逃——","off":"哇……搞砸了，大家快逃！"},{"label":"战斗失败2","jp":"うぅ、今回の作品はだめだ……","fan":"呜呜，这次的作品不太行……","off":"哎……这次的作品不行了。"}],"成长":[{"label":"升级1","jp":"今、最高のインスピレーションが浮かんだ！","fan":"现在，冒出了最棒的灵感！","off":"我现在突然有了一个超棒的灵感！"},{"label":"升级2","jp":"うん、よーし","fan":"嗯，好诶——","off":"嗯。很好！"},{"label":"升级3","jp":"これ、成績をあげるのにも役立つかな","fan":"这个对提高成绩也会有用吗…","off":"这个能帮我提高成绩吗？"},{"label":"升级4","jp":"おほ、すごい力を感じる！","fan":"哦嚯，感觉到了好强的力量！","off":"哦！我感受到一股强大的力量！"},{"label":"获得专武","jp":"この銃で、世界を色鮮やかにに染めるの！","fan":"我要用这把枪，给世界染上鲜艳的色彩！","off":"有了这把枪，我可以把整个世界染的色彩斑斓！"}],"事件":[{"label":"学生生日","jp":"プレゼントに何が欲しいか、って？\n先生の服、あたしがチョイスした色で塗ってみてもいい？","fan":"问我想要什么礼物？\n老师的衣服，我可以涂上颜色吗？用我自己选的颜色","off":"问我想要什么礼物？老师的衣服可以让我涂上喜欢的颜色吗？"},{"label":"老师生日","jp":"先生、お誕生日おめでとう！\nん？なんで知ってるのかって？\nおっと、まだ公開されてない情報だったっけ？","fan":"老师，生日快乐！\n嗯？我怎么知道的？\n哎哟，这是未公开的情报吗？","off":"老师，生日快乐。为什么会知道你的生日？哎呀，这是保密情报来着……"},{"label":"万圣节","jp":"今回のハロウィンのために、先月からコスチュームを準備してたの。\nふふっ、期待してて！","fan":"为了这次万圣节，上个月就准备了服装。\n嘻嘻，要期待哦！","off":"为了这次的万圣节，我从上个月就开始准备衣服了，你就期待着吧！"},{"label":"新年","jp":"ハッピーニューイヤー、先生！\n今年もキラキラしたものをいっぱい描いていこう！","fan":"新年快乐，老师！\n今年也多多画点闪闪发亮的东西吧！","off":"新年快乐，老师，今年也要画很多闪闪发光的东西哦！"},{"label":"圣诞节","jp":"あっちもこっちも綺麗なイルミネーションでいっぱい…。\nこれ、そのまま壁に描き写せないかな？","fan":"那里好像满是美丽的灵感……\n这些，好像不能全都照画在墙上呢？","off":"到处都挂满了好看的彩灯，可以把这幅景象画到墙上吗？"},{"label":"春节","jp":"","fan":"老师，新春快乐呀~\n今年我想创作更多涂鸦，把枯燥的地方都染上色彩\n啊，老师也要来帮忙哦~","off":"老师，新春快乐呀~\n今年我想创作更多涂鸦，把枯燥的地方都染上色彩\n啊，老师也要来帮忙哦~"},{"label":"中秋","jp":"","fan":"中秋节快乐啊老师~\n今晚的月亮真美，下次涂鸦时也画上一轮明月吧！","off":"中秋节快乐啊老师~\n今晚的月亮真美，下次涂鸦时也画上一轮明月吧！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/329972.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/824930.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/632197.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/278768.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/773440.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/986625.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/799367.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/828461.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/849040.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/647524.ogg","https://cdnimg-v2.gamekee.com/wiki