m/ba/620813.html"},{"name":"NPC 爱莉（鬼屋）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/12/119198.png","url":"https://www.gamekee.com/ba/639198.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案"},{"label":"卡池抽取","jp":"お会いできて嬉しいです、先生～\n先生はどんなアイスが好きですか？","fan":"见到您真高兴，老师~\n老师喜欢吃什么冰淇淋呢？","off":"很开心能认识您，老师，老师喜欢什么口味的冰淇凌呢 ？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生～、お帰りなさい。\n今日も一緒にスイーツ食べに行きますよね？","fan":"老师~欢迎回来。\n今天也一起去吃甜品吧？","off":"老师，您回来啦。今天也会一起去吃甜点对吧！"},{"label":"登陆2","jp":"先生、遅いですよ～\n一緒にアイス買いに行きましょう！","fan":"老师，迟到了哦~\n一起去买冰淇淋吧！","off":"老师，您来的好晚啊，我们一起去买冰淇淋吧！"},{"label":"大厅1","jp":"ルンルン～甘いの大好き～","fan":"啦啦~最喜欢甜品了~","off":"啦啦，最喜欢甜食啦！"},{"label":"大厅2","jp":"先生もアイスクリーム好きですよね？ね？","fan":"老师也喜欢冰淇淋吧？对吧？","off":"老师，您也喜欢冰淇淋吧，对吧？"},{"label":"大厅3","jp":"放課後はスイーツタイム～","fan":"放学后是甜点时间~","off":"回家路上，就是甜点时间~"},{"label":"大厅4","jp":"おいしいスイーツのため～今日も一緒に、頑張りましょう！","fan":"为了美味的甜品~今天也一起努力吧！","off":"为了好吃的甜点，今天也一起加油吧！"},{"label":"大厅5","jp":"ん？先生。何か悩みがありそうな顔ですね。","fan":"嗯？老师。总觉得您看起来有心事呢。","off":"嗯..老师，看您好像有什么心事？"},{"label":"大厅6","jp":"そういう時は、さあさあ！美味しいスイーツを食べに！一緒に行きましょう！","fan":"这种时候，来吧来吧！就要去吃美味的甜品！一起去吧！","off":"这种时候啊，来来，一起去吃美味的甜点吧！"},{"label":"回忆大厅1","jp":"-","fan":"-","off":"（嘶溜~）"},{"label":"回忆大厅2","jp":"私の分も買っていただいてありがとうございます、先生。\nあ、甘くて美味しいです！","fan":"连我的份也一起买了，谢谢老师。啊，甜甜的很美味！","off":"非常感谢您，连我的份，也一起买了……老师，甜甜的好好吃啊~！"},{"label":"回忆大厅3","jp":"カフェではなく、外で食べるアイスクリームってすごく久しぶりな気がします。\nそれに、先生と一緒ですし。えへへっ。","fan":"不是在咖啡馆里，而是在外面吃冰淇淋，感觉真是很久没有这样过了呢。\n而且还有老师和我一起。诶嘿嘿。","off":"平常都是在咖啡厅吃冰淇淋，感觉，好久好久没在外面吃了……而且，还是跟老师一起，诶嘿嘿~"},{"label":"回忆大厅4","jp":"い、いえ、全然そんなことは。むしろ懐かしくて、嬉しいです。","fan":"完、完全没有那种事啦。不如说是很怀念，很开心呢。","off":"啊，不，没有……完全没有啦！反而有种很怀念的感觉……好开心！"},{"label":"回忆大厅5","jp":"嬉しいですし、その…。\n何と言えばいいんでしょう、周りに人も少ないですし…。\nすごく、ドキドキすると言いますか…。\n…な、なっ、なんでもありません！\n今のは忘れてください！はは、あはは…","fan":"虽然很开心啦，但是……\n要怎么说呢，周边的人也很少……\n该说是，心跳不已吗……\n……什、什么都没有啦！\n刚才的话请忘掉！哈哈，啊哈哈……","off":"不仅开心，而且……感觉，真安静啊……周围也没有什么人……不知道该不该说，我感觉，心在砰砰乱跳……啊，没，没有没有！请您，当我什么都没说吧！诶嘿嘿，啊哈哈哈……"},{"label":"回忆大厅6","jp":"…ありがとうございます、先生。\n今日も先生のおかげで、もうすでに幸せな一日になりました。","fan":"……谢谢你，老师。\n多亏了老师，今天已经是很幸福的一天啦。","off":"……谢谢您，老师。多亏有老师在，今天，真的好幸福！"},{"label":"咖啡馆1","jp":"放課後にはやっぱりスイーツ！","fan":"放学后果然还是要吃甜品！","off":"在回家路上，就该吃甜点！"},{"label":"咖啡馆2","jp":"いちごとミントは最高！","fan":"草莓和薄荷最棒了！","off":"嗯！薄荷搭草莓最棒了。"},{"label":"咖啡馆3","jp":"んー、何を食べようかな…","fan":"嗯，吃哪个呢...","off":"嗯~吃什么好呢？"},{"label":"咖啡馆4","jp":"今日もやっぱりいちご＆ミント～","fan":"今天果然还是草莓和薄荷~","off":"今天也还是吃，薄荷草莓口味吧！"},{"label":"咖啡馆5","jp":"アイス、アイス～アイスクリーム～","fan":"Ice、Ice~Icecream","off":"冰淇淋，冰淇淋，真好吃?"}],"好感度":[{"label":"好感度1","jp":"えへへっ、少し照れちゃいますね、先生。","fan":"诶嘿嘿，让我有点害羞呢，老师。","off":"老师，我有点不好意思欸.."},{"label":"好感度2","jp":"先生と一緒にいられて、私本当に…嬉しいです！","fan":"和老师在一起，我真的...很开心！","off":"能和老师在一起，我真的好高兴！"},{"label":"好感度3","jp":"先生ー！今日も明日も明後日も、ずっと私と一緒にいてくれますよね！","fan":"老师——！今天明天后天，都会一直和我在一起的对吧！","off":"老师，今天明天还有后天，您都可以一直和我在一起吧！"},{"label":"好感度4","jp":"スイーツもいいですけど、やっぱり先生と一緒にいる方が好きです。","fan":"甜品很好，但是我更喜欢和老师在一起。","off":"甜食虽然很棒，但是我觉得还是跟老师在一起更开心！"}],"战斗":[{"label":"编入队伍1","jp":"全力でお手伝えします！","fan":"全力支援！","off":"我会全力帮忙的！"},{"label":"编入队伍2","jp":"今日も頑張ります！","fan":"今天也要加油！","off":"今天也要加油！"},{"label":"拎起","jp":"あーん……先生も食べますか？","fan":"啊——嗯？老师也要吃吗？","off":"啊——嗯？老师也要吃吗？"},{"label":"普通技能","jp":"みんな、ファイトです！","fan":"大家，加油哦！","off":"大家，加油！"},{"label":"EX动画1","jp":"ふんふん♪ん、へっ？投げるのぉ！？","fan":"呼呼♪诶？抛出去啦！？","off":"要扔出去吗！？"},{"label":"EX动画2","jp":"いただきま…ん、へっ？ええっ！？","fan":"我开动...嗯，诶？诶诶？","off":"我要开吃，欸欸欸！？"},{"label":"EX动画3","jp":"あーん…あ、ちょっ！そんなぁ…","fan":"啊…啊、喂！怎么这样...","off":"怎么这样…."},{"label":"EX技能1","jp":"あっ、あああぁ…","fan":"啊，啊啊啊…","off":"呜呜呜…"},{"label":"EX技能2","jp":"","fan":"","off":""},{"label":"EX技能3","jp":"もったいない…","fan":"浪费了...","off":"好浪费！"}],"成长":[{"label":"升级1","jp":"ありがとうございます、先生！","fan":"谢谢您，老师！","off":"老师，谢谢您！"},{"label":"升级2","jp":"えへへっ、もっと私に頼ってもいいんですよ～。","fan":"诶嘿嘿，可以依靠我更多哦~","off":"可以多依靠我一点哦！"},{"label":"升级3","jp":"じゃーん！強くなりました！","fan":"锵——！我变强啦！","off":"锵！我变强了！"},{"label":"升级4","jp":"いつもありがとうございます～先生、えへへっ。","fan":"一直以来都很感谢您~老师，诶嘿嘿。","off":"老师，谢谢您一直都那么照顾我。"},{"label":"获得专武","jp":"……この武器は……。ありがとうございます。先生。\n強くなるのは、少し怖いことですが……。先生と一緒なら、大丈夫です！","fan":"……这把武器……。非常感谢。老师。\n虽然变强，是件稍微有些害怕的事情……。如果有老师陪我的话，那就没关系！","off":"这件武器..老师，谢谢您，一想到会变强就有点怕怕的，不过只要能跟老师一起就行！"}],"事件":[{"label":"学生生日","jp":"先生～ 今日は私の誕生日です！一緒にアイス食べに行きましょう！\nん？プレゼントですか？\n大丈夫ですよ～先生が私のプレゼントですから！","fan":"老师~ 今天是我的生日！一起去吃冰淇淋吧！\n嗯？礼物吗？\n没关系啦~因为老师就是我的礼物！","off":"老师，今天是我生日，一起去吃冰淇淋吧！礼物？不用啦，老师就是我的礼物嘛！"},{"label":"老师生日","jp":"先生！お誕生日おめでとうございます！\n私が特別に！おいしいスイーツ屋さんを予約しておきましたよ！\nさあさあ、急いで！先生！","fan":"老师！祝您生日快乐！\n我特意！预约了一家好吃的甜品店哦！\n好啦好啦，快来吧！老师！","off":"老师，祝您生日快乐，为了这一天，我可是特意为您预约了好吃的甜品店呢！来吧来吧，快走吧老师！"},{"label":"万圣节","jp":"えへへっ、今日はハロウィーンですね。\n一緒にお化けのコスプレして甘いものを貰いに行ってみましょうか？\nTrick or Treat～","fan":"诶嘿嘿，今天是万圣节呢。\n一起换上怪物的COS装一起去要糖果吧？\n不给糖就捣蛋~","off":"欸嘿，今天是万圣节欸，一起打扮成妖怪然后去要糖果吧！不给糖就捣蛋！"},{"label":"新年","jp":"先生～明けましておめでとうございます～\n今年も美味しいスイーツのため！一緒に頑張りましょう！","fan":"老师~新年快乐~\n为了今年的美味甜品！一起加油吧！","off":"老师，祝您新年快乐，为了美味的甜品，今年也一起加油吧！"},{"label":"圣诞节","jp":"わーい、先生～！クリスマスですよ！\nこういう日にはやっぱりアイスが似合いますよね！\n一緒に買いに行きましょうか？","fan":"喂，老师~！是圣诞节哦！\n这样的日子果然和冰淇淋很配呢！\n一起去买冰淇淋吧？","off":"哇，老师，圣诞节到喽，这种日子就适合吃冰淇淋对吧！我们一起去买吧！"},{"label":"春节","jp":"","fan":"虽然外面有些冷，但老师要不要和我一起吃薄荷巧克力冰激凌呀？\n毕竟今天可是新年呀！","off":"虽然外面有些冷，但老师要不要和我一起吃薄荷巧克力冰激凌呀？\n毕竟今天可是新年呀！"},{"label":"中秋","jp":"","fan":"老师，今晚的月亮很圆很白呢，就像甜品一样！\n让人很有食欲！","off":"老师，今晚的月亮很圆很白呢，就像甜品一样！\n让人很有食欲！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/80443.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/502740.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/153905.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/221993.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/553599.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/718024.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/650829.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w