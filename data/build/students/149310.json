025/4/27/454243.png"]},"sameName":[{"name":"★3 芹香（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/10/3849.png","url":"https://www.gamekee.com/ba/150380.html"},{"name":"★2 芹香","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/10/168094.png","url":"https://www.gamekee.com/ba/46678.html"},{"name":"NPC 芹香(偶像)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/10/535891.png","url":"https://www.gamekee.com/ba/639182.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"blue archive"},{"label":"卡池抽取","jp":"「最高の休暇」にするんだから！妥協はしないわよ！","fan":"这可是我“最棒的假期 ”！绝不会妥协的哦！","off":"我要把它变成“最棒的假期”！决不妥协！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ、先生！ここは涼しいわね！","fan":"欢迎，老师！这里很凉快呢！","off":"老师快进来！这里可凉快啦！"},{"label":"登陆2","jp":"遅いよ、先生！どれだけ待たせる気なの？","fan":"好慢啊，老师！为什么让我等这么久？","off":"也太慢了吧，老师！知道我等了多久嘛？！"},{"label":"大厅1","jp":"やっぱ海って涼しいわね！","fan":"大海边果然很凉爽呢！","off":"还是海边凉快啊！"},{"label":"大厅2","jp":"みんなで遊びにこれて……すっごく楽しい。","fan":"能和大家一起来到这儿玩……真的太开心了。","off":"大家一起来玩……真是太开心了。"},{"label":"大厅3","jp":"全力で遊んだら後悔なんてないんだから","fan":"全身心投入地玩乐过后就不会后悔了！","off":"既然要玩，就要玩得尽兴才不会后悔！"},{"label":"大厅4","jp":"はぁ……疲れた……\nだ、ダメ！休憩する時間がもったいない！","fan":"哈啊……累死了……\n不、不行！休息太浪费时间了！","off":"哈啊……累死了……不，不行！时间用来休息就太浪费了！"},{"label":"大厅5","jp":"先生……その……この水着、どう思う？","fan":"老师……那个……我这身泳装，你觉得怎么样？","off":"老师……那个……我穿这身泳装，老师觉得怎么样？"},{"label":"回忆大厅1","jp":"こ、これでもう良くない？\nそろそろ降りようよ……\nもうやめたいとか、\nそういうんじやないんだけど……","fan":"这，这样差不多就可以了吧？\n差不多该下来了……\n虽然没打算放弃……","off":"测，测试到这个程度就可以了吧？我差不多也该下船了……\n不过我也不是现在不想玩的意思"},{"label":"回忆大厅2","jp":"ちょ、ちょっと！！先生！\n何すんのよ！ 摇れるでしょ！\nこのボ一ト、ひつくり返りやすいんだから！！やめて！","fan":"等、等下！！老师！\n您在干嘛！太晃了吧！\n 这个小艇很容易翻啊！！快停下来！","off":"等，等一下！！老师干什么！这样很晃诶！！\n再，再这样下去，这船很容易侧翻的！！呜哇！别闹啦！"},{"label":"回忆大厅3","jp":"いや、面白そうだからじやないわよ。\n先生、人で遊ばないて。","fan":"不是，什么叫感觉很有意思啊。\n老师，别拿别人找乐子啊。","off":"不是，有趣个头啦。\n老师，不要把别人当玩具耍好不好。"},{"label":"回忆大厅4","jp":"……はあ。もういいわよ。\n先生はそういう人だったわね。\nこういう事するつて予想できてたはずなのに……","fan":"……唉。算了。\n毕竟老师一直都是这样的人呢。\n虽然我早就料到会发生这种事了……","off":"……哎，算了。反正老师本来就是这种人。\n我早该想到会变成这样的……"},{"label":"回忆大厅5","jp":"まあいいわ。私もちょつと思いついたことがあるから。\nさあ、先生！交代よ！！今度は先生の番よ！","fan":"嘛算了。刚好我也想到一个好点子。\n来吧，老师！到我了！这次轮到老师了！","off":"哼，可以。我也有的是办法来治你。\n好了，老师！交换时间到！！这回轮到老师了！"},{"label":"咖啡馆1","jp":"なんか……みんな忙しそうね。","fan":"唔……大家看起来都好忙啊。","off":"嗯……大家看起来都很忙啊。"},{"label":"咖啡馆2","jp":"水鉄砲で遊びたいかも。","fan":"好想玩玩这个水枪啊。","off":"突然好想玩水枪大战啊。"},{"label":"咖啡馆3","jp":"バーベキューしようかな？","fan":"要不要整个烧烤？","off":"想吃点烤串吗？"},{"label":"咖啡馆4","jp":"……掃除でもしよっかな。","fan":"……要不我扫一下地吧。","off":"……先打扫一下吧？"},{"label":"咖啡馆5","jp":"ふう……気持ち良い。","fan":"呼……感觉真不错。","off":"呼……好凉快。"}],"好感度":[{"label":"好感度1","jp":"えん、いますごく楽しいよ、先生。","fan":"嗯，现在的我很开心哦，老师。","off":"……嗯，我现在超级开心，老师。"},{"label":"好感度2","jp":"全力で楽しんでやるんだから、何があったら先生が止めてよね。","fan":"我正准备全身心的好好玩耍，如果发生什么事情的话老师会解决的对吧。","off":"我会玩个痛快的！但要是过头了，老师可得拦着我啊！"},{"label":"好感度3","jp":"この感じ、何だか初めてかも。","fan":"这样的感觉，好像还是第一次。","off":"这种感觉……仔细想想还是第一次呢。"},{"label":"好感度4","jp":"せ、先生。あの…その、一緒に水泳でもする？","fan":"老、老师。那个...那个，要不要一起游泳？","off":"老，老师……那，那个……要，要不要……一起游泳……？"}],"战斗":[{"label":"编入队伍1","jp":"迷っている暇はないわよ。","fan":"可没时间犹豫哦。","off":""},{"label":"编入队伍2","jp":"さっさと行くわよ","fan":"赶紧走吧。","off":""},{"label":"拎起","jp":"るんるん～え、うわぁ！","fan":"噜噜～诶，哇啊！","off":""},{"label":"普通技能","jp":"受け取りなさい！","fan":"吃我这招吧！","off":"接着——！"},{"label":"EX动画1","jp":"ふう、楽しい。うわぁぁぁぁ！","fan":"呼，好开心。哇啊啊啊！","off":"呼，好开心……呃，呃啊？！"},{"label":"EX动画2","jp":"先生ー！うぇえ！","fan":"老师——！唔诶！","off":"老师~！咿啊？！"},{"label":"EX动画3","jp":"意外とあるくない。もうー！","fan":"应该不会发生翻车吧。真是的——！","off":"没想到还不……错呜哇啊啊啊？！"},{"label":"EX技能1","jp":"逃しちゃった。気を付けて。","fan":"失手了。小心。","off":"脱手了，小心啊——！"},{"label":"EX技能2","jp":"飛んでくわよ！","fan":"发射了哦！","off":"要飞出去了呀——！"},{"label":"EX技能3","jp":"よけてー！","fan":"注意闪开！","off":"闪开——！！"}],"成长":[{"label":"升级1","jp":"その…遊ぶのはいいんだけと...。本当にこれでいいんだよね。","fan":"那个...虽然度假真的很放松......但是这样真的可以吗。","off":"那个……玩得是挺开心的……但是真的可以吗……？"},{"label":"升级2","jp":"いいね、いいね。今回は遠慮しないだからね。","fan":"好啊，好啊。这次我就不客气了哦。","off":"好啦好啦~那这次我就不客气啦！"},{"label":"升级3","jp":"やっぱ先生も遊びたいんだよね。言わなくてもわかってるって。","fan":"果然老师也想好好度假一番呢。就算您不说我也能猜到啦。","off":"老师其实也想玩吧？不用说我也知道！"},{"label":"升级4","jp":"水鉄砲大会でも開くつもり？わかった、わたしが全部やっつけてあげる。","fan":"准备办一场水枪大战？我知道啦，我会全部搞定的。","off":"想玩水枪大战是吗？我知道了！看我的吧！"},{"label":"获得专武","jp":"こんなに遊んでばっかで良いのかな……\nせ、先生が良いって言ったんだからね！\nちゃんと責任とってよ！？","fan":"这么玩下去真的没问题吗……\n是、是老师说的可以的哦！\n可要为自己说的话负起责任啊！？","off":"光顾着玩也没关系吗……既，既然老师说了没问题！那你可要负责到底啊！"}],"事件":[{"label":"学生生日","jp":"私の誕生日……？\nそうね……今日1日ずっと一緒に……！\n……何しようかしらね？","fan":"今天是我生日……？\n对哦……今天一整天都陪我……！\n……打算做点什么？","off":"我的，生日……？对哦……那今天一整天都要陪我哦……！\n……玩点什么好呢？"},{"label":"老师生日","jp":"ハッピーバースデー！一緒に遊びましょう！","fan":"Happy Birthday！一起去玩吧！","off":"生日快乐！老师！一起来玩吧！"},{"label":"万圣节","jp":"ハロウィーン！？水着は仮装じゃないわよ！？\n見方によってはそうかもしれないけど……！","fan":"万圣节！？泳装可不是万圣装扮哦！？\n虽然看上去确实很像……","off":"万圣节？！我这可不是万圣节的衣服呀！呃……好像也可以是……！"},{"label":"新年","jp":"新年の格好もあった気がするけど……\nまぁいっか。あけましておめでとう、先生。","fan":"想起来我有一套适合新年穿的服装……\n嘛算了。新年快乐，老师。","off":"其实我本来还准备了新年的衣服来着……算了没事，新年快乐噢，老师。"},{"label":"圣诞节","jp":"今年一年、私は良い子だったかな……\n……せ、先生……どう？","fan":"今年一整年，我应该算是乖孩子吧……\n……老、老师……您觉得呢？","off":"过去这一年，我算是个好孩子吗…………老，老师……觉得呢？"},{"label":"春节","jp":"","fan":"这么多！哪来的钱？！——压岁钱呀，谢谢老师！太好了……这样学院的债再过多少年能还清呢……算了，还不如不算……","off":"这么多！哪来的钱？！——压岁钱呀，谢谢老师！太好了……这样学院的债再过多少年能还清呢……算了，还不如不算……"},{"label":"中秋","jp":"","fan":"……嗯……老师……今天晚上有空的话，来一下度假村的海边吧。别乱想哦！没什么特别的事情！真的！就，就是看看月亮……散散步……","off":"……嗯……老师……今天晚上有空的话，来一下度假村的海边吧。别乱想哦！没什么特别的事情！真的！就，就是看看月亮……散散步……"}],"活动":[{"label":"活动登陆1","jp":"さあ、先生！時間なんて無いわよ！早く行きましょう！","fan":"好了，老师！没有时间了！快点出发吧","off":"快，老师！没时间耽误了！赶紧出发吧！"},{"label":"活动登陆2","jp":"あ、先生！こっち、こっち！","fan":"啊、老师！这边，这边！","off":"啊，老师！这边这边~！"},{"label":"活动大厅1","jp":"ん？どうしたの？なにかやることある？","fan":"嗯？怎么了？有什么要做的事情吗？","off":"嗯？怎么了？还有什么事情要做吗？"},{"label":"活动大厅2","jp":"先生……何してんの。","fan":"老师……在做什么呢。","off":"老师……你在干嘛呀？"},{"label":"活动大厅3","jp":"それ、面白いと思ってんの？ねぇ？","fan":"这个，感觉很有意思呢？对吧？","off":"我说……你玩得好像很开心嘛，嗯？"},{"label":"活动大厅4","jp":"変なことばっかしてないでやることやって！早く！","fan":"不要老做些奇奇怪怪的事情了！快点干正事吧！","off":"……别整这些没用的了！看看时间，干正事吧！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/152134.ogg