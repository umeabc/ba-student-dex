//cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/23619701mtu13je3.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/93179421mtu13nys.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/22360270mtu13qdr.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/41694232mtu13s86.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/492704/2026/8/9/03500190mtu12w5q.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/492704/2026/8/9/22542720mtu130x3.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/31012466mtu135yo.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/45034418mtu137py.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/23619701mtu13je3.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/93179421mtu13nys.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/22360270mtu13qdr.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/8/9/41694232mtu13s86.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"霞","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_258/h_258/829/737047/2025/4/30/253327.png","url":"https://www.gamekee.com/ba/169361"}],"voices":{"通常":[{"label":"标题","jp":"うむっ！ブルーアカイブッ！","fan":"哦哦！碧蓝档案！","off":""},{"label":"卡池抽取","jp":"……聞こえるかな、火薬が炸裂する音が。火がついた爆弾を止めることはできない――それこそがロマンというものだ。","fan":"……能听见吗，火药炸裂的声音。点燃的炸弹是停不下来的——这正是所谓的浪漫。","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おや先生。先に失礼していたよ。\nちょっと追われていてね……しばし匿ってはくれないだろうか？","fan":"哎呀，老师。我先失陪了哦。\n有点被人追赶着……能让我藏一阵子吗？","off":""},{"label":"登陆2","jp":"まさかこんな時に当番とは……いやはや。\nまぁ、構わないさ。ここにいる限りは追われることはないだろうからな。ハーハッハッハッ！","fan":"没想到这种时候居然轮到我值班……真是的。\n嘛，无所谓。只要待在这里，就不会被追了吧。哈哈哈！","off":""},{"label":"大厅1","jp":"シャーレ当番は最高だ！追いかけてくる連中がいないからな！\nまぁ、しかし……道中が不安だがね。","fan":"夏莱值班最棒了！因为没有人追着我跑啊！\n嘛，不过……就是路上的情况让人不安啊。","off":""},{"label":"大厅2","jp":"シャーレは良い立地をしている……しかし……\n温泉がないのだけが残念だ……おや、そんな目をしないでくれよ。","fan":"夏莱的地理位置很不错……但是……\n唯独没有温泉这一点很遗憾……哎呀，别用那种眼神看我嘛。","off":""},{"label":"大厅3","jp":"少しずつ燃えていく芯……あれを眺めていると、血が騒ぐんだ。\n……花火の話だとも。ハーハッハッハッハ！","fan":"缓缓燃烧的引线……每当看着它，就让我热血沸腾。\n……我说的是烟花啦。哈哈哈哈哈！","off":""},{"label":"大厅4","jp":"ん？水着を着ているからって泳ぐわけないだろう。\n……湯船で泳ぐのはマナー違反だからな。披露できなくて残念だ。","fan":"嗯？穿了泳装也不代表我会去游泳吧。\n……在浴池里游泳可是违反礼仪的。没法展示真是遗憾。","off":""},{"label":"大厅5","jp":"読書？ああ、暇つぶしの一環だ。まあ、趣味と言えないこともないがね。\n時は金なり、というだろう？時間は有限だからな。遊んでいてはもったいない。","fan":"读书？啊，是打发时间的一环。嘛，也不能说算不上爱好吧。\n不是有句话叫「时间就是金钱」吗？因为时间有限啊。用来玩耍就太可惜了。","off":""},{"label":"回忆大厅1","jp":"知っているだろう？この辺りは治安が悪いんだ。\nひと一人消えた程度じゃ、誰も気づかない。","fan":"你知道的吧？这附近治安很差。\n只是少了一个人的话，谁都不会注意到。","off":""},{"label":"回忆大厅2","jp":"詰めが甘いよ、先生。\n一を識って、二を知らず、だ。","fan":"考虑得不够周到哦，老师。\n正所谓「知其一，不知其二」。","off":""},{"label":"回忆大厅3","jp":"先生が私を助けようとすればするほど……\n私にとって、良い手駒となる。","fan":"老师越想帮助我……\n就越会成为对我而言好用的一枚棋子。","off":""},{"label":"回忆大厅4","jp":"そして――そういうものであればあるほど、\n手に入れたくなるというのが人の性だ。","fan":"而且——越是那样的东西，\n就越想据为己有，这就是人的本性。","off":""},{"label":"回忆大厅5","jp":"私の本性が知りたいと言っていただろう……？感想はいかがかな？\n引き返したいと言っても――もう遅いがね。","fan":"之前不是说过想知道我的本性吗……？感想如何？\n就算说想回头——也已经太迟了哦。","off":""},{"label":"回忆大厅6","jp":"……サプラーイズ！\nそれっぽかっただろう？そう怖い顔をしないでくれ。冗談だよ。","fan":"……惊喜！\n很有那味儿吧？别摆出那么可怕的表情嘛。开玩笑的啦。","off":""},{"label":"咖啡馆1","jp":"様式美こそ、大切にするものだね。","fan":"形式美学才是最重要的呢。","off":""},{"label":"咖啡馆2","jp":"素晴らしい！これほどの蔵書があるとは……。","fan":"太棒了！竟然有这么多藏书……。","off":""},{"label":"咖啡馆3","jp":"何やら視線を感じたような……気のせいか。","fan":"好像感觉到了什么视线……是错觉吧。","off":""},{"label":"咖啡馆4","jp":"温泉の装飾に……は難しいな。","fan":"用在温泉装饰上……有点难啊。","off":""},{"label":"咖啡馆5","jp":"ふむ、このデザイン……参考になるな。","fan":"唔，这个设计……很有参考价值啊。","off":""}],"好感度":[{"label":"好感度1","jp":"おや、これは大変なことになってしまったな。先生のことが気になって仕方がない。面白い変化だ。","fan":"哎呀，这可不得了啊。在意老师在意得不得了。真是有趣的变化。","off":""},{"label":"好感度2","jp":"随分変わった趣味をしているじゃあないか。まあ私にとっては良いことだがな！ハーッハッハッ！","fan":"你这兴趣可真是与众不同啊。嘛，对我来说倒是件好事！哈哈哈！","off":""},{"label":"好感度3","jp":"おや、自分が今何をしているのか――理解しているのかな？","fan":"哎呀，你现在在做什么——自己心里清楚吗？","off":""},{"label":"好感度4","jp":"……私はちゃんと借りを返す性分でね。はてさて、どうしたものか。","fan":"……我这个人向来有债必还。嗯嗯，这可如何是好。","off":""}],"战斗":[{"label":"编入队伍1","jp":"まだもう一件掘れそうだな！次へ行くぞ！","fan":"好像还能再挖一处啊！出发去下一处！","off":""},{"label":"编入队伍2","jp":"土木？爆破？それとも……？","fan":"土木工程？爆破？还是说……？","off":""},{"label":"拎起","jp":"ああ！溺れた時もこうしてくれると助かる！","fan":"啊！溺水的时候也这样搭把手的话就帮大忙了！","off":""},{"label":"普通技能","jp":"プレゼ～ント！","fan":"礼～物！","off":""},{"label":"EX动画1","jp":"愉快！痛快！ハーッハッハッハッ！","fan":"愉快！痛快！哈哈哈！","off":""},{"label":"EX动画2","jp":"まるで暴れ牛だな！オ、レ！オ、レ！","fan":"简直像头暴走的公牛啊！我，就！是！","off":""},{"label":"EX动画3","jp":"おっと、制御ボタンをつけ忘れてしまったな！ハーッハッハッ！","fan":"哎呀，忘了装上控制按钮了！哈哈哈！","off":""},{"label":"EX技能1","jp":"いたた……ハーッハッハッ！","fan":"好痛……哈哈哈！","off":""},{"label":"EX技能2","jp":"ぐはっ……！面白いじゃないか！","fan":"咳啊……！真有意思！","off":""},{"label":"EX技能3","jp":"がはっ……！まあ、こんな時もあるだろう！","fan":"咳啊……！嘛，人生也有这种时候嘛！","off":""}],"成长":[{"label":"升级1","jp":"おや、いいのかな？私にこんなことをして――ひと夏の火傷ではすまないぞ？","fan":"哎呀，这样好吗？对我做这种事——可不止是灼伤一个夏天就能了事的哦？","off":""},{"label":"升级2","jp":"もらえるものはありがたくいただく主義だが……先生に借りができてしまったな。","fan":"我向来主张有东西就心怀感激地收下……不过这下欠了老师一个人情啊。","off":""},{"label":"升级3","jp":"ここで学んだことを別の場所で活かしても――恨まないでくれよ？","fan":"就算我把在这里学到的东西用在别处——也别记恨我哦？","off":""},{"label":"升级4","jp":"これが夏の思い出、というやつかな？胸の奥がスカッとしたよ。ありがとう、先生。","fan":"这就是所谓的夏日回忆吗？心里感到一阵清爽。谢谢你，老师。","off":""},{"label":"获得专武","jp":"リスクは覚悟の上で共にいる、と考えても良いのだな？それなら重畳――地獄行きの片道切符に、最後まで付き合ってもらおうじゃあないか。ハーハッハッハッハ！","fan":"也就是说，你已经做好承担风险的心理准备才选择与我同行，对吗？既然如此，求之不得——这张通往地狱的单程票，就请你陪我坐到终点吧。哈哈哈哈哈！","off":""}],"事件":[{"label":"学生生日","jp":"ああ、今日は私の誕生日だとも！祝ってもらいに来たぞ！いやぁ～なかなか誕生日だというのに落ち着かなくてな！","fan":"啊啊，今天可是我的生日哦！我是来让人庆祝的！哎呀～明明是生日，却怎么都静不下心来啊！","off":""},{"label":"老师生日","jp":"うむ！実にめでたい日だ！遠慮することはない、先生。パーティーをはじめようじゃあないか！","fan":"唔！真是喜庆的日子！不用客气，老师。让我们开始派对吧！","off":""},{"label":"万圣节","jp":"ふんふふんふん～今日は愉快な日だな先生！うむ！\nああ……そういう日に、するのだがな。","fan":"哼哼哼哼哼～今天真是愉快的一天啊，老师！唔！\n啊……就是要做那种事情的日子嘛。","off":""},{"label":"新年","jp":"あけましておめでとう、先生！\nなんだ急に。時節の挨拶は大切だろう？こっちの界隈では特にな。","fan":"新年快乐，老师！\n怎么这么突然。季节性的问候很重要吧？在这边的圈子里尤其如此。","off":""},{"label":"圣诞节","jp":"クリスマスの時期は寒いからな！温まるものが必要だろう！我ら温泉開発部の出番、というわけだ！\nそんな顔をするな、先生。我々ほどキヴォトスに貢献している部活は他にないのだぞ？","fan":"圣诞时节很冷嘛！需要能让人暖和起来的东西吧！这正是我们温泉开发部大显身手的时候！\n别摆出那种表情，老师。没有哪个社团比我们更致力于为基沃托斯做贡献了，对吧？","off":""}],"活动":[{"label":"活动登陆1","jp":"青い空、広い海！うむ！美しいビーチだ！\nここなら海を一望できる温泉が作れるな！","fan":"蓝蓝的天，广阔的海！唔！真是美丽的海滩！\n在这里能造出可以眺望大海的温泉啊！","off":""},{"label":"活动登陆2","jp":"おお、先生？先生じゃあないか！\n残念ながら温泉はまだできてないぞ？","fan":"哦哦，老师？这不是老师吗！\n遗憾的是，温泉还没建好哦？","off":""},{"label":"活动大厅1","jp":"プライベートビーチ、か。ブルジョワの極みだな。\n我々のように理念を持つのはいかがかな？","fan":"私人海滩，吗。真是资产阶级到了极点啊。\n要不要像我们一样，怀揣理念呢？","off":""},{"label":"活动大厅2","jp":"トリニティに数多存在する「潜在的な温泉」――それが未だ埋もれたままでいる。\nだから、我々が来たのさ。","fan":"圣三一里存在着众多的「潜在温泉」——它们至今仍被埋没着。\n所以，我们才来了。","off":""},{"label":"活动大厅3","jp":"ふむ……あれがティーパーティー、か。\nいいのかね？こうも簡単に接触できて……彼らのSPはどうしたんだ？\nそんな目で見ないでくれ、先生。別に何もしてやいないさ。","fan":"唔……那就是茶话会吗。\n这样好吗？如此轻易就能接触到……他们的保镖都去哪儿了？\n别用那种眼神看我，老师。我什么都没做哦。","off":""},{"label":"活动大厅4","jp":"ん？なんだ、先生！くすぐったいじゃあないか！っはは！やめたまえよ！","fan":"嗯？怎么了，老师！好痒啊！哈哈！快住手！","off":""},{"label":"活动事件1","jp":"痛いなぁ……まったく、イチカちゃんも少しは手加減してほしいものだ。\n私たちの仲だっていうのに……先生もそう思うだろう？","fan":"好痛啊……真是的，希望一花酱下手也能稍微轻一点啊。\n明明我们关系这么好……老师也这么觉得吧？","off":""},{"label":"活动事件2","jp":"――火種が一つ。\n連鎖反応とは、ほんの小さな火種から始まるものさ。\nでは――火種を一つ、落としたら。どうなるのか……気になるだろう？","fan":"——一个火种。\n所谓的连锁反应，就是从一个小小的火种开始的。\n那么——如果丢下一个火种的话。会发生什么呢……很在意吧？","off":""},{"label":"活动结束","jp":"いやぁ～これは一杯食わされたな！ハーハッハッハッハ！\nん？機嫌が良さそうに見える？\n……そう、見えるんだな？","fan":"哎呀～这下可被摆了一道啊！哈哈哈哈哈！\n嗯？看起来我心情很好？\n……是这么看出来的吗？","off":""},{"label":"ch0328_cardgame_act_1","jp":"イオリちゃん！イオリちゃんじゃないか！","fan":"伊织酱！这不是伊织酱吗！","off":""},{"label":"