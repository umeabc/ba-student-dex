img-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブル～アーカイブ、だよ！","fan":"是蔚蓝档案～哦！","off":""},{"label":"卡池抽取","jp":"イブキもみんなと海行く！先生も一緒にしゅっこ～！","fan":"伊吹也要和大家去海边！老师也一起出发～！","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！早く早く！お仕事終わらせて、イブキと一緒に海にいこ～！","fan":"老师！快点快点！快点做完工作，和伊吹一起去海边吧～！","off":""},{"label":"登陆2","jp":"先生！お仕事の準備終わったよー！イブキがやっておいたの！えへへ、イブキ、偉い？","fan":"老师！工作的准备做完啦～！是伊吹先做好了的！诶嘿嘿，伊吹，厉害吧？","off":""},{"label":"大厅1","jp":"先生も水着、きよ～！すごく涼しくて、すごく楽なんだよ！えへへっ！","fan":"老师也穿泳装吧～！又凉快又舒服哦！诶嘿嘿！","off":""},{"label":"大厅2","jp":"わっ！椅子つめたい～！不思議っ！水着で座ったからかなぁ？","fan":"哇！椅子好凉～！好奇怪！是因为穿着泳装坐的吗？","off":""},{"label":"大厅3","jp":"イブキ、当番のお仕事頑張るね！水着だとなんだか楽しいんだよ～！","fan":"伊吹会努力做好值班的工作哦！穿着泳装总觉得很开心呢～！","off":""},{"label":"大厅4","jp":"すずしー…えへへっ！","fan":"好凉快～…诶嘿嘿！","off":""},{"label":"大厅5","jp":"頑張ったらイブキも先輩たちみたいにカッコよくなれるかな？","fan":"努力的话，伊吹也能变得像前辈们一样帅气吗？","off":""},{"label":"回忆大厅1","jp":"先生！こっちこっち～！ここ、すっごく涼しいの！","fan":"老师！这边这边～！这里，特别特别凉快！","off":""},{"label":"回忆大厅2","jp":"どんなにお日様の光が強くても――ここなら…ほら、全然暑くないんだよ～！","fan":"不管太阳光有多强――只要在这里…你看，一点都不热哦～！","off":""},{"label":"回忆大厅3","jp":"だからね！ここなら――もう、パラソル移動しなくてもいいんだよ、先生。","fan":"所以啊！在这里的话――就不用再移动遮阳伞了哦，老师。","off":""},{"label":"回忆大厅4","jp":"…うん。ほんとはね、イブキ、見てたの。先生がよいしょ、よいしょって、パラソル運んでるとこ…。","fan":"……嗯。其实啊，伊吹，都看到了哦。老师“嘿咻、嘿咻”地搬着遮阳伞的样子……。","off":""},{"label":"回忆大厅5","jp":"でもここなら大丈夫だよ！イブキと一緒に、ゆっくり休もうね！","fan":"但是在这里就没问题哦！和伊吹一起，好好休息吧！","off":""},{"label":"咖啡馆1","jp":"海から出たら、砂を落として、身体を拭いて～…。","fan":"从海里出来之后，要把沙子弄掉，把身体擦干～…。","off":""},{"label":"咖啡馆2","jp":"コーヒーを飲んだら、イブキももっと長く遊べるかなぁ？","fan":"喝了咖啡的话，伊吹是不是也能玩得更久一点呢？","off":""},{"label":"咖啡馆3","jp":"先生～まだかなあ～えへへ…。","fan":"老师～还没来吗～诶嘿嘿…。","off":""},{"label":"咖啡馆4","jp":"ここ、プリン売ってるかなぁ？","fan":"这里，有没有卖布丁呢？","off":""},{"label":"咖啡馆5","jp":"コーヒーって、いい匂いがするのにすっごく苦いの、なんでだろ～？","fan":"咖啡明明闻起来很香，却特别苦，这是为什么呢～？","off":""}],"好感度":[{"label":"好感度1","jp":"先生といっぱい遊びたい！ね、先生はどう？イブキはもっともーっと遊びたいよ！","fan":"想和老师一起玩好多好多！呐，老师呢？伊吹想玩更多更多的！","off":""},{"label":"好感度2","jp":"イブキね、先生と一緒にいるとすっごく楽しいんだ！なんでだろね！不思議！","fan":"伊吹啊，和老师在一起的时候特别特别开心！是为什么呢！好不可思议！","off":""},{"label":"好感度3","jp":"えへへ……イブキ、先生のこと、待ってたよ～","fan":"诶嘿嘿……伊吹，一直在等老师哦～","off":""},{"label":"好感度4","jp":"先生、暑くない？こっちこっち！パラソルの下で、イブキとのんびりしよ！","fan":"老师，不热吗？这边这边！到遮阳伞下面，和伊吹一起悠闲地待着吧！","off":""}],"战斗":[{"label":"编入队伍1","jp":"えへへ、イブキがきたよ！","fan":"诶嘿嘿，伊吹来啦！","off":""},{"label":"编入队伍2","jp":"先生も来るの？やったー！","fan":"老师也来吗？太好了！","off":""},{"label":"拎起","jp":"イブキ号、しゅっこ～！","fan":"伊吹号，出发～！","off":""},{"label":"普通技能","jp":"イブキがかわいくしてあげる～！","fan":"让伊吹来帮你变可爱～！","off":""},{"label":"EX动画1-1","jp":"わぁ～！見て見て！きれ～！","fan":"哇～！快看快看！好漂亮～！","off":""},{"label":"EX动画1-2","jp":"えっとね……一番かわいいのは～これ！先生にあげる！","fan":"那个啊……最可爱的是～这个！送给老师！","off":""},{"label":"EX动画1-3","jp":"きれいな貝殻がいっぱい～！はい、先生！","fan":"漂亮的贝壳好多好多～！给，老师！","off":""},{"label":"EX动画2-1","jp":"わあ！すっごくきれー！……むにゃむにゃ。","fan":"哇！好漂亮好漂亮！……唔喵唔喵。","off":""},{"label":"EX动画2-2","jp":"貝殻のみんな～この指と～まれ！……ふわぁ。","fan":"贝壳们～快到这个手指上来～！……呼啊。","off":""},{"label":"EX动画2-3","jp":"先生！これぜーんぶ、イブキが作ったの！……ほめて～","fan":"老师！这些全部，都是伊吹做的！……夸夸我～","off":""},{"label":"EX技能1-1","jp":"はいこれ！お守りだよ！","fan":"给，这个！是护身符哦！","off":""},{"label":"EX技能1-2","jp":"こっちのかわいいの、あげる！","fan":"这边的这个可爱的，送给你！","off":""},{"label":"EX技能1-3","jp":"イブキとお揃いだね！","fan":"和伊吹是一对哦！","off":""},{"label":"EX技能2-1","jp":"えへへ、かわいいでしょー？","fan":"诶嘿嘿，很可爱吧？","off":""},{"label":"EX技能2-2","jp":"ふぅ……かんせーい！","fan":"呼……完～成！","off":""},{"label":"EX技能2-3","jp":"「巨匠」イブキの作品、です！へへ！","fan":"“巨匠”伊吹的作品，请看！嘿嘿！","off":""}],"成长":[{"label":"升级1","jp":"元気もりもり～！えへへっ！","fan":"元气满满～！诶嘿嘿！","off":""},{"label":"升级2","jp":"これからは、イブキが先生をまもるよ！イブキについてきてね！","fan":"从今以后，由伊吹来保护老师！要跟着伊吹哦！","off":""},{"label":"升级3","jp":"もしかして……これが「大人になる」ってこと？","fan":"难道说……这就是“长大成人”的意思吗？","off":""},{"label":"升级4","jp":"イブキ、お船の上でも頑張るよ！","fan":"伊吹，在船上也会加油的！","off":""},{"label":"获得专武","jp":"イブキ、これずっとずーっと大事にするね！絶対！ありがとう、先生！","fan":"伊吹会一直一直珍惜它的！绝对！谢谢你，老师！","off":""}],"事件":[{"label":"学生生日","jp":"今日はね、イブキのお誕生日なの！だからね…先生といっぱい遊びたいなぁ～！","fan":"今天啊，是伊吹的生日哦！所以呢……想和老师一起玩好多好多～！","off":""},{"label":"老师生日","jp":"今日はイブキから、先生にプレゼントがありまーす！はい！とっておきの貝殻だよ！かわいいでしょ～？えへへっ、お誕生日おめでとう！先生！","fan":"今天，伊吹有礼物要送给老师～！给！是最珍贵的贝壳哦！很可爱吧～？诶嘿嘿，生日快乐！老师！","off":""},{"label":"万圣节","jp":"今日はハロウィンだから、このままお外で遊んでも――え？何か上に着た方がいいの？どうして～？","fan":"今天是万圣节，所以就这样在外面玩也――哎？要穿上点什么比较好吗？为什么～？","off":""},{"label":"新年","jp":"おっきなお日様が海から出てきて、きれいだったね～あけましておめでとう！先生！えへへ！","fan":"大大的太阳从海面上升起来，好漂亮呢～新年快乐！老师！诶嘿嘿！","off":""},{"label":"圣诞节","jp":"いっぱい靴下かけたんだ！これでサンタさんから、先生と先輩たちの分もプレゼントもらえるよね！","fan":"挂了满满好多袜子哦！这样的话，圣诞老人就会连老师和前辈们的份也给我们礼物了对吧！","off":""}],"活动":[{"label":"活动登陆1","jp":"イブキね、海、はじめてだから……すっごく楽しみにしてたの。先生と一緒に来れて、イブキ嬉しい！","fan":"伊吹啊，是第一次来海边……所以特别特别期待呢。能和老师一起来，伊吹好开心！","off":""},{"label":"活动登陆2","jp":"イロハ先輩、忙しそう。イブキが手伝ってあげる！","fan":"伊吕波前辈，看起来好忙。伊吹来帮你！","off":""},{"label":"活动大厅1","jp":"先生、どうしたの～？えへへ、イブキと遊んでくれるの？","fan":"老师，怎么啦～？诶嘿嘿，要陪伊吹玩吗？","off":""},{"label":"活动大厅2","jp":"チアキ先輩はね、いつもイブキの写真をい～っぱい撮ってくれるんだ！だから、イブキが映ってる写真、こーんなにあるの！","fan":"千秋前辈啊，总是给伊吹拍好多好多的照片！所以啊，有伊吹的照片，有这么多这么多哦！","off":""},{"label":"活动大厅3","jp":"先生！みて！すごい！すごーい！ここから、ここまで！ぜーんぶ海だよ～！","fan":"老师！快看！好厉害！好厉害！从这里，到那里！全部都是海哦～！","off":""},{"label":"活动大厅4","jp":"お話しできるお魚さん、いるかなぁ？映画でね、見たの！こんにちはー！っておしゃべりできるんだよ！","fan":"会不会有会说话的小鱼呢？在电影里看到的哦！能打招呼说“你好～”的那种！","off":""},{"label":"活动事件1","jp":"みんな、ケンカしないで……ケンカはいやだよぉ……。うぅ……イブキが悪い子だから……？イブキのせい……？","fan":"大家，不要吵架……伊吹讨厌吵架啦……。呜呜……是因为伊吹是坏孩子吗……？都是伊吹的错……？","off":""},{"label":"活动事件2","jp":"アイアイ！キャプテン！ヨーホー！","fan":"哎哎！船长！哟嚯！","off":""},{"label":"活动结束","jp":"あのねあのね、イブキ、海で遊ぶの、本当に楽しかったよ！だからまた、みんなで、来よう、ね……ぐーぐー……。","fan":"那个那个，伊吹在海边玩，真的好开心哦！所以下次，大家再一起来吧……呼噜呼噜……。","off":""},{"label":"活动任务1","jp":"えっへん！イブキはいま、お仕事中なのです！遊ぶのはお仕事が終わってから、だよ！","fan":"咳咳！伊吹现在正在工作中呢！玩要等做完工作之后，才行哦！","off":""},{"label":"活动任务2","jp":"イブキ、一人でできるもん。でも先生と一緒にお仕事するのは、好き！","fan":"伊吹一个人也做得到的。但是和老师一起工作，伊吹喜欢！","off":""},{"label":"活动任务每日结束","jp":"","fan":"","off":""},{"label":"活动任务登录1","jp":"いらっしゃーい先生！ここはイブキが担当しているよ！イブキも、ぱんでもにうむ〜そさえてぃ〜の一員、だからね！","fan":"欢迎光临～老师！这里由伊吹负责哦！伊吹也是万~魔~殿的一员，所以哦！","off":""},{"label":"活动任务登陆2","jp":"わ～！難しそう……！先生はこれ、ぜんぶわかるの？すごい！すごーい！","fan":"哇～！看起来好难……！老师这个，全都看得懂吗？好厉害！好厉害！","off":""},{"label":"活动任务获取1","jp":"よくできました、っと。えへへ！ハンコのきれいな押し方、教えてもらったの！","fan":"“做得好”，就这样。诶嘿嘿！盖章的好看方法，是别人教伊吹的哦！","off":""},{"label":"活动任务获取2","jp":"先生、忙しい？イブキも、先生をお手伝いする～！","fan":"老师，很忙吗？伊吹也来帮老师的忙～！","off":""},{"label":"minigame_drawturn_1","jp":"えぇ、あとちょっとー","fan":"诶，就差一点点了～","off":""},{"label":"minigame_drawturn_2","jp":"もっかいいこー!","fan":"再来一次——！","off":""},{"label":"minigame_losebattle_1","jp":"うぅぅ、イブキ、悪い子だった?","fan":"呜呜，伊吹，是不是变成坏孩子了？","off":""},{"label":"minigame_loseturn_1","jp":"うぅぅー","fan":"呜呜呜～","off":""},{"label":"minigame_loseturn_2","jp":"頑張って!","fan":"加油！","off":""},{"label":"minigame_loseturn_3","jp":"大丈夫だよ！","fan":"没关系的！","off":""},{"label":"minigame_loseturnspecial_1","jp":"痛いの、痛いの、とんでけー！","fan":"痛痛，飞走啦～！","off":""},{"label":"minigame_winbattle_1","jp":"いひひ、カニカニさん、だーいすきー!","fan":"嘿嘿，小螃蟹先生，最喜欢了——！","off":""},{"label":"minigame_winturn_1","jp":"えい！","fan":"嘿！","off":""},{"label":"minigame_winturn_2","jp":"やったー!","fan":"太好了——！","off":""},{"label":"minigame_winturn_3","jp":"えへへ～ん","fan":"诶嘿嘿～","off":""},{"label":"minigame_winturnspecial_1","jp":"意地悪は、メッ！","fan":"使坏的话，不行！","off":""},{"label":"minigame_winturnspecial_2","jp":"カニカニさん、すごーい！","fan":"螃蟹螃蟹，好厉害！","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/5/47090924msfnce1f.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/5/02797188msfmzhw5.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/5/97475788msfn01t9.ogg","",""],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/5/18656089msfn0duf.ogg","",""],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/5/12523874msfn0fm2.ogg","",""],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/5/53578674msfn0gvp.ogg","",""],"大厅及咖啡馆|大厅3":["htt