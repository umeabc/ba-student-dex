i2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/5/870903.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/5/425526.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 真白（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/5/133575.png","url":"https://www.gamekee.com/ba/81812.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"正義実現委員会1年生マシロ、お呼びが掛かりましたのでこちらに。\n未熟者ですが、いついかなる時もベストを尽くします。","fan":"正义实现委员会1年级的学生真白，应您呼唤来到这里。\n虽然还有很多不成熟的地方，但任何时候我都会全力以赴。","off":"正义实现部的新人真白，应召前来。虽然我还不太成熟，但任何时候，我都会竭尽全力。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ、先生。今日も一緒に、正義のために頑張りましょう。","fan":"欢迎，老师。今天也一起为了正义努力吧。","off":"您来啦，老师。为了维护正义，今天也一起加油吧。"},{"label":"登陆2","jp":"お待ちしておりました。すぐにでもご命令を。","fan":"我在等您。请下达命令。","off":"等您很久了，请随时下达命令。"},{"label":"大厅1","jp":"あ、出撃ですか？","fan":"啊，要出击吗？","off":"啊，要出击了吗？"},{"label":"大厅2","jp":"お呼びですか、先生？","fan":"您叫我吗，老师？","off":"您找我吗，老师？"},{"label":"大厅3","jp":"私たち正義実現委員会の目標は悪を滅し、\nこの学園の正義を立て直すこと…です。","fan":"我们正义实现委员会的目标是消灭邪恶，\n重建这个学园的正义…。","off":"我们正义实现部的目标就是，在崔尼蒂惩奸除恶，伸张正义。"},{"label":"大厅4","jp":"正義を実現させるためには、苦しい訓練だろうと神経をすり減らす試練だろうと、いくらでも耐えると誓いましたが…\n先輩たちと一緒に過ごす時間があまりにも楽しくて…僭越ですが思わず正義のことを忘れてしまいそうです。","fan":"为了实现正义，不管是痛苦的训练还是消磨意志的考验，\n我发誓无论如何都要忍耐…和前辈们一起度过的时间太开心了……\n虽然很冒昧，但好像不由地忘记了正义。","off":"我发过誓，为了实现正义，无论多么艰苦的训练、多么困难的考验，我都会忍受下去。……但是，和前辈们在一起的时间又真的很快乐。快乐到好像连维护正义的事情都忘记了。……有点不合适。"},{"label":"大厅5","jp":"あのう…念のために申し上げますが、今触っているのは作戦用コンソールではありません…。","fan":"那个……小心起见，现在触摸的不是作战用的控制台…。","off":"……那个，慎重起见，我斗胆说一句。您现在摸的……并不是作战用的控制台。"},{"label":"回忆大厅1","jp":"ふう…。\n今日に限って暑いですね。","fan":"唔…。\n今天特别热啊。","off":"哈……怎么感觉今天特别热……"},{"label":"回忆大厅2","jp":"完璧な狙撃のためなら、これぐらいの暑さは十分耐えられます。","fan":"为了完成完美的狙击，这种程度的炎热我还是能够忍受的。","off":"不过为了达成完美的狙击，这种程度的酷热我还是可以忍受的。"},{"label":"回忆大厅3","jp":"少し…汗臭かったりしないかな…？","fan":"会不会有点…汗臭…？","off":"就是……会不会闻到一股汗味……"},{"label":"回忆大厅4","jp":"こんな夏の日には、他の生徒たちの白い制服が羨ましいですね。","fan":"这样的夏天，真羡慕其他学生能穿白色的制服啊。","off":"一到这种大夏天，我就开始有点羡慕其他人穿的那种白色制服了……"},{"label":"回忆大厅5","jp":"先生…なんだか視線がいやらしい気がしますが…。\nきちんと目標を注視されているんですよね？","fan":"老师…总觉得您的视线有点恼人…。\n请好好地注视着目标吧？","off":"……老师，总感觉您的眼神好像有点不对劲。您应该……是在认真的盯紧目标吧？"},{"label":"咖啡馆1","jp":"たまにはこういうとこも悪くないですね。","fan":"偶尔这样也不错呢。","off":"偶尔来下这种地方，也挺不错的。"},{"label":"咖啡馆2","jp":"可愛いな…。ふふっ。","fan":"可爱呢…。呼呼。","off":"真可爱啊……诶嘿嘿。"},{"label":"咖啡馆3","jp":"（こういう装飾、ツルギ先輩は好きじゃないかな…）","fan":"（这样的装饰，鹤城前辈会不喜欢吗……）","off":"鹤城前辈……应该不喜欢这样的装饰吧。"},{"label":"咖啡馆4","jp":"（ハスミ先輩の羽、この家具みたいにフワフワしてそうだったな）","fan":"（莲见前辈的翅膀，和这个家具一样软绵绵的。）","off":"莲见前辈的翅膀，会不会就和这个家具一样柔软呢？"},{"label":"咖啡馆5","jp":"（明鏡止水…）","fan":"（明镜止水…）","off":"心如止水……"},{"label":"咖啡馆6","jp":"（ツルギ先輩の首、大丈夫なのかな…？）","fan":"（鹤城前辈的脖子没事吧…？）","off":"鹤城前辈的脖子……应该没事吧？"}],"好感度":[{"label":"好感度1","jp":"先生の持つ正義はきっと格好いい正義なのでしょう。","fan":"老师身上的正义一定是非常帅气的正义吧。","off":"老师所抱持的正义，一定是一种很酷的正义吧？"},{"label":"好感度2","jp":"もしも先生が悪の行いをしたら、その時は…。いや、そんなはずありません！先生は正義そのものですから！","fan":"如果老师犯下恶行的话，那个时候…。不，不可能这样！老师就是正义本身！","off":"如果老师有一天做了坏事，那我就……不，不会那样的！毕竟老师就是正义的化身！"},{"label":"好感度3","jp":"先生と一緒に過ごす時間はなんだかいつも短く感じます。","fan":"和老师度过的时间总是感觉过的很快。","off":"总感觉，和老师相处的时间……特别的短。"},{"label":"好感度4","jp":"好きです、本当に……。も、もちろん、正義のことです！","fan":"喜欢，真的……。当，当然，我是在说正义！","off":"我真的……很喜欢……啊，当，当然……说的是正义！"}],"战斗":[{"label":"编入队伍1","jp":"ベストを尽くします。","fan":"做到最好。","off":"我会尽全力的。"},{"label":"编入队伍2","jp":"ご期待に答えてみせます。","fan":"我会回应您对我的期望。","off":"不会辜负您的期待。"},{"label":"拎起","jp":"狙撃ポイント、変更ですか？","fan":"狙击点位，要变更吗？","off":""},{"label":"普通技能","jp":"残り1人。","fan":"剩余1人。","off":"还剩一个。"},{"label":"EX动画1","jp":"弾丸装填、照準よし…射撃開始！","fan":"子弹装填，瞄准完毕…射击开始！","off":"装填子弹，已经瞄准。开始射击！"},{"label":"EX动画2","jp":"目標を確認、排除します！","fan":"目标确认，进行扫除！","off":"目标已确认，开始清除！"},{"label":"EX动画3","jp":"ターゲット補足…距離は十分です。","fan":"目标充足…距离足够。","off":"已发现目标，在射程范围内。"},{"label":"EX技能1","jp":"ファイア！","fan":"开火！","off":"开火。"},{"label":"EX技能2","jp":"命中です。","fan":"命中了。","off":"命中了！"},{"label":"EX技能3","jp":"ヒット！","fan":"Hit！","off":"中了！"},{"label":"战斗开始1","jp":"みんな所定の位置に。","fan":"大家到指定的位置。","off":"所有人就位！"},{"label":"战斗开始2","jp":"戦闘をはじめます。","fan":"开始战斗。","off":"战斗开始！"},{"label":"特殊载具","jp":"正義を実現するときです。","fan":"正义实现之时。","off":"实现正义的时候到了。"},{"label":"特殊载具","jp":"（-）ゼロ、起動。","fan":"-","off":""}],"成长":[{"label":"升级1","jp":"支援、感謝します。","fan":"感谢支援。","off":"感谢您的支援。"},{"label":"升级2","jp":"巨大な力を感じられますね。","fan":"感受到了巨大的力量。","off":"可以感受到……一股强大的力量。"},{"label":"升级3","jp":"ふん…正義が思い上がります。","fan":"哼…正义高涨起来了。","off":"啊……斗志燃烧起来了！"},{"label":"升级4","jp":"正義のために、頑張ります。","fan":"为了正义而努力。","off":"为了正义，我会尽我所能！"},{"label":"获得专武","jp":"これぞ……\n本当の正義……。","fan":"这才是……\n真正的正义……。","off":"这……才是真正的正义！"}],"事件":[{"label":"学生生日","jp":"そうですか。今日が私の誕生日だったんですね…。\nすっかり忘れてました。気にかけてくださって、ありがとうございます。","fan":"这样啊。今天是我的生日呢…。\n忘得一干二净了。谢谢您还记得。","off":"原来如此，今天是我的生日啊……我都忘得一干二净。谢谢您这么为我着想。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。\n先生の一日が正義で満たされるよう、お祈りします。","fan":"祝你生日快乐，老师。\n祝老师的一天充满正义。","off":"祝您生日快乐，老师。衷心祝愿，今天的老师一身正气！"},{"label":"万圣节","jp":"トリニティのすべての聖人を称える祝日が始まりました。\nカボチャのお化け…？悪い夢でも見ましたか？","fan":"褒扬圣三一所有圣人的节日开始了。\n南瓜妖怪…？做噩梦了吗？","off":"称颂崔尼蒂所有贤者的节日来临了！嗯？南瓜妖怪……？您做噩梦了吗？\n新年"},{"label":"新年","jp":"明けましておめでとうございます。今年こそ、この地から悪を完全に追い出せるよう、さらに努力します。","fan":"新年快乐。今年，我会更加努力将邪恶从这个地方完全赶走。","off":"恭祝新春快乐！今年我一定要再接再厉，彻底消灭掉这个地方的黑暗势力。"},{"label":"圣诞节","jp":"トリニティの聖なる日ですね。このような日でも、ゲヘナの悪党たちは悪行をなしているんでしょうか…。","fan":"是圣三一的圣日啊。即使在这样的日子，格黑娜的恶党们也会做恶行吗…。","off":"今天对崔尼蒂来说是一个重要的日子。在这样的日子里，歌赫娜的恶徒们……还会不会为非作歹呢？"},{"label":"春节","jp":"","fan":"老师，恭祝您新春快乐！今年，也一起维护正义吧！","off":"老师，恭祝您新春快乐！今年，也一起维护正义吧！"},{"label":"中秋","jp":"","fan":"我很喜欢这个节日。在皎洁的月光下，一切邪恶都无处遁形！","off":"我很喜欢这个节日。在皎洁的月光下，一切邪恶都无处遁形！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/5/654531.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/306703.ogg","https:/