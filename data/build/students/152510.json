mekee.com/wiki2.0/images/w_252/h_204/829/43758/2025/5/13/873932.png","url":"https://www.gamekee.com/ba/639186.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"blue archive"},{"label":"卡池抽取","jp":"ヴァルキューレ警察学校所属、生活安全局ライフセーバーのキリノです！危険な状況は本官にお任せください！","fan":"本官是女武神警察学校所属，生活安全局的救生员桐乃！危险的状况就交给本官吧！","off":"我是隶属于瓦尔基丽警员学院生活安全局的救生员桐乃！危险的情况请交给本警员来处理吧！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お待ちしておりました、先生！準備運動でもいかがでしょう！","fan":"等您好久啦，老师！来做做准备运动吧！","off":"我一直在等您呢，老师！要从热身运动开始吗？"},{"label":"登陆2","jp":"こんにちは、先生！今日も安全な一日を過ごしてらしゃいますか？","fan":"老师好！今天也度过安全的一天吧！","off":"您好，老师！今天也度过了安全的一天吗？"},{"label":"大厅1","jp":"水に入るときは心臓に遠いところから濡らしていくんですよ！","fan":"下水的时候要从离心脏远的肢端开始浸水哦！","off":"下水的时候要从远离心脏的地方开始慢慢打湿身体哦！"},{"label":"大厅2","jp":"ん？本官の助けが必要でしょうか！？","fan":"嗯？需要本官协助吗？！","off":"嗯？需要本警员帮忙吗？！"},{"label":"大厅3","jp":"反応確認、緊急報告、呼吸確認…その次は…い、言わないでください！もうすぐ思い出しますから！","fan":"确认反应，报告紧急情况，确认呼吸……接下来是……别、别提醒啦！马上就能想起来了！","off":"确认反应，紧急报警，检查呼吸……然后是……\n别，别说！我马上就想起来了！"},{"label":"大厅4","jp":"溺れても心配しないでください！本官が助けに行きますから！","fan":"就算溺水了也不用担心！本官会来帮忙的！","off":"掉进水里时请不要担心！本警员会救您的！"},{"label":"大厅5","jp":"水難事故はいつ何時でも発生するものです！シャーレのオフィスだって例外ではありません！","fan":"溺水事故无论何时何地都有可能发生！夏莱的办公室里也不例外！","off":"溺水事故是随时都可能发生的！沙勒的办公室也不例外！"},{"label":"回忆大厅1","jp":"先生！大丈夫ですか！？","fan":"老师！您没事吧？！","off":"老师！您没事吧？！"},{"label":"回忆大厅2","jp":"よかった…目が覚めたんですね。大変なことになってしまったのかと思いました。心肺蘇生法は…必要なさそうですね。","fan":"太好了……您终于醒了。还以为情况严重了呢。心肺复苏……看来是没必要了。","off":"太好了……睁开眼睛了，我还以为老师出大事了呢。\n心肺复苏术……好像不需要做了。"},{"label":"回忆大厅3","jp":"水辺では、常に周囲の状況に注意を払う必要があります！どんなに泳ぎに自信がある人でも、不測の事態はいつでも起こりうるからです。","fan":"在水边，要时常注意周围的情况啊！善泳者溺，意外情况随时都可能发生。","off":"在水边必须时刻注意周围的情况！\n就算是对游泳再有自信的人，意外事件也随时都可能发生。"},{"label":"回忆大厅4","jp":"もちろん、本官のようなライフセーバーがいれば問題ないのですが！","fan":"当然了，只要有本官这样的救生员在就没关系了！","off":"当然，有像本警员这样的救生员在就没有问题了！"},{"label":"回忆大厅5","jp":"本官がいつも見守っているのでご安心ください！","fan":"本官会一直守护着老师的，请放心吧！","off":"当然，有像本警员这样的救生员在就没有问题了！"},{"label":"咖啡馆1","jp":"ん、安全な場所ですね！","fan":"嗯，是个安全的地方呢！","off":"嗯！这里看起来很安全！"},{"label":"咖啡馆2","jp":"あの人、少し心配ですね...見張っておきます！","fan":"那个人，有点令人担心……我去看看！","off":"那个人，我有点担心……得留心观察一下。"},{"label":"咖啡馆3","jp":"奉仕、傾聴、誠実！そして笑顔！忘れないように！","fan":"服务，倾听，真诚！还有笑容！可不能忘记了！","off":"（服务，倾听，真诚，还有微笑！绝对不能忘记！）"},{"label":"咖啡馆4","jp":"これ、ウォーターパークにもほしいですね！","fan":"这个要是在水上乐园里也有就好了！","off":"这个……要是水上乐园里也有就好了！"},{"label":"咖啡馆5","jp":"AEDの位置は…","fan":"AED的位置是在……","off":"AED的位置在……"}],"好感度":[{"label":"好感度1","jp":"先生！水泳は得意ですか？本官が教えましょうか？","fan":"老师！您擅长游泳吗？本官来教您怎么样？","off":"老师，您泳游得好吗？需要本警员教您吗？"},{"label":"好感度2","jp":"その…もうすぐ休憩時間なのですが…ほん、本官と一緒にウォータースライダーに…乗りませんか？","fan":"那个……马上就要到休息时间了……要、要不要，和本官一起……去坐水滑梯呢？","off":"那个……马上就要到休息时间了……要，要不要跟本警员一起……去玩水滑梯？"},{"label":"好感度3","jp":"えっと、一緒に泳ぎませんか？","fan":"那个，要一起游泳吗？","off":"那个，要不要一起下水……？"},{"label":"好感度4","jp":"その…本官はいつも先生を見守っています、だから先生も…本官のことを…","fan":"就是…本官一直守护着老师，所以老师能不能…也对本官…","off":"那个，本警员会一直守护着老师。所以老师也……可以多依赖本警员一点……"}],"战斗":[{"label":"编入队伍1","jp":"本官の出番ですね!","fan":"轮到本官出场了呢！","off":""},{"label":"编入队伍2","jp":"出動します！","fan":"出动！","off":""},{"label":"拎起","jp":"な、なんですか?","fan":"什、什么事？","off":""},{"label":"普通技能","jp":"受け取ってください！","fan":"收下这个吧！","off":"请，请接好咯！"},{"label":"EX动画1","jp":"どれどれ…そこ、止まってください！","fan":"我看看……那边的，请停下来！","off":"我看看……那边的！请立刻停止！"},{"label":"EX动画2","jp":"危なさそうな人は…あっ、そこ！","fan":"看起来危险的人在……啊，在那里！","off":"有危险人物吗……啊！那边！"},{"label":"EX动画3","jp":"ん？あ、危ない！","fan":"嗯？啊，危险！","off":"嗯……啊！有危险！"},{"label":"EX技能1","jp":"本官が出動します！","fan":"本官出动了！","off":"本警员出动！"},{"label":"EX技能2","jp":"ライフセーバーが来ましたよ！","fan":"救生员来啦！","off":"救生员来了！"},{"label":"EX技能3","jp":"危険な遊びはやめてください！","fan":"请不要做危险的游戏！","off":"请不要拿生命开玩笑！"}],"成长":[{"label":"升级1","jp":"本官、更に精進します！","fan":"本官，更进一步了！","off":"本警员，会继续努力精进的！"},{"label":"升级2","jp":"水泳の腕がちょっと上がったような気がします！か、勘違いじゃないですよね…","fan":"感觉游泳的水平都上升了！应、应该不是错觉吧……","off":"游泳技术似乎有所提升！不，不会是错觉吧？"},{"label":"升级3","jp":"一に安全、二も安全！先生の安全も、本官が守りますよ！","fan":"安全，然后还是安全！老师的安全，就由本官来保护！","off":"第一是安全，第二也是安全！老师的安全也将由我来守护！"},{"label":"升级4","jp":"まだまだ未熟者ですが…先生の期待に応えられるようなライフセーバーになって見せます！","fan":"虽然还远未成熟……不过本官会努力成为不负老师期待的救生员的！","off":"虽然还不太熟练……但我会努力成为配得上老师期待的救生员！"},{"label":"获得专武","jp":"しゃ、射撃が得意ではありませんが…先生のために、全力を尽くします！","fan":"虽、虽然并不擅长射击……但是为了老师，本官会竭尽全力的！","off":"射，射击虽然不算太优秀，但为了老师的安全，我会全力以赴！"}],"事件":[{"label":"学生生日","jp":"祝ってくださりありがとうございます！先生も楽しく安全な一日を過ごしください！","fan":"谢谢您的生日祝福！老师也要度过开心又安全的一天啊！","off":"谢谢您的祝福！希望老师也能度过愉快又安全的一天。"},{"label":"老师生日","jp":"おめでとうございます、先生！ウォーターパークにいらしゃって際には、お誕生日プレゼントとして、スライダーを二回連続案内しますね！","fan":"生日快乐，老师！来水上乐园的时候，作为生日礼物，可以带您连坐两回水滑梯哦！","off":"生日快乐，老师！如果您来水上乐园玩，作为生日礼物，我们可以让您连续乘坐两次水滑梯哦！"},{"label":"万圣节","jp":"賑やかなお祭りには危険がつきものです！プールではありませんが、事故には気をつけたいところです！","fan":"热闹的节日也潜藏着危险！虽然不是泳池，还是要小心事故才对！","off":"热闹的庆典总是暗藏危险！虽然不是泳池，但也要留意安全事故！"},{"label":"新年","jp":"今年は皆が安全に過ごせますように！","fan":"希望今年大家都能安全度过！","off":"希望大家今年都能平安度过。"},{"label":"圣诞节","jp":"メリークリスマス、です！先生、本官の行きつけのお店で一緒に食べませんか？","fan":"圣诞快乐，老师！要不要和本官一起去常去的店吃点什么呢？","off":"圣诞快乐！老师，要不要和本警员一起去经常去的店呀？"},{"label":"春节","jp":"","fan":"新春快乐，老师！今年可以为水上乐园写一副春联吗？横批本警员已经想好了，就写“安全第一”！","off":"新春快乐，老师！今年可以为水上乐园写一副春联吗？横批本警员已经想好了，就写“安全第一”！"},{"label":"中秋","jp":"","fan":"老师！想漂在泳池里赏月吗？可以试试这个特制的月饼游泳圈哦！","off":"老师！想漂在泳池里赏月吗？可以试试这个特制的月饼游泳圈哦！"}],"活动":[{"label":"活动登陆1","jp":"おかえりなさい！先生は、スライダーと波のプール、どちらが好きですか？","fan":"欢迎回来！水滑梯和冲浪泳池，老师喜欢哪一个呢？","off":"欢迎光临！水滑梯和造浪池，老师更喜欢哪个呢？"},{"label":"活动登陆2","jp":"中務キリノ、今回はライフセーバーをしております！","fan":"中务桐乃，本次担任救生员！","off":"中务桐乃将担任本次的救生员！"},{"label":"活动大厅1","jp":"水着を着るために、グルメ巡りをしばらく我慢していましたが…気がついたら、フードコート巡りをしてしまいました…","fan":"为了穿这身泳装，忍住了没有去美食旅行……结果一不小心，开始逛小吃摊了……","off":"为了穿泳装，我忍了好久，都不敢去吃好吃的……\n回过神一看，才发现自己已经在美食广场吃了个遍……"},{"label":"活动大厅2","jp":"ウォータースライダーは如何ですか？本官は一番スリル満点のスライダーをおすすめします！","fan":"去滑水滑梯怎么样？本官会推荐最滑的滑梯的！","off":"水滑梯怎么样？本警员给您推荐一条最刺激的滑道吧！"},{"label":"活动大厅3","jp":"子供たちが遊ぶ姿、かわいいですね！","fan":"小孩子们玩水的样子，真可爱呢！","off":"孩子们玩耍的样子好可爱啊！"},{"label":"活动大厅4","jp":"はい、本官が必要な仕事でしょうか？何でも言ってください！","fan":"嗯，是有需要本官的工作吗？请尽管开口吧！","off":"嗯？需要本警员帮忙吗？请尽管开口！"},{"label":"活动事件1","jp":"ウォーターパークに怪物だなんて、何と言うことでしょう！","fan":"水上乐园里竟然会出现怪物，真是出人意料！","off":"水上乐园里竟然有怪物，太荒唐了吧……！"},{"label":"活动事件2","jp":"今度は本官が活躍する番ですね！先生とお客様の安全は、本官が守ります！","fan":"现在正是本官大显身手的时候！老师和客人们的安全，就由本官来保护！","off":"这次总算轮到本警员大显身手了！老师和游客们的安全就由我来守护！"},{"label":"活动结束","jp":"かなり心配でしたが、無事に終わりましたね！お疲れ様でした！","fan":"虽然一波三折，但总算是顺利结束了呢！辛苦啦！","off":"让您担心了，不过总算圆满结束了！辛苦您了！"},{"label":"活动任务1","jp":"あははは！ライフセーバーをくすぐるのは禁止ですよ～！","fan":"啊哈哈哈！挠救生员的痒痒可是不行的哦~！","off":"哈，哈哈，啊哈哈！禁止挠救生员痒痒！"},{"label":"活动任务2","jp":"えへへ、そんな急かすなくても、本官がお手伝いしますので！","fan":"嘿嘿，不用那么着急也可以，本官会帮忙的！","off":"呵呵，不用催这么紧，本警员会帮您的！"},{"label":"活动任务每日结束","jp":"今日もお疲れ様でした！よかったら、すっきりした気持ちで、食事にでも行きませんか？","fan":"今天也辛苦啦！不如就保持着这种清爽的心情，一起去吃饭怎么样？","off":"今天也辛苦啦，要不要轻松一下，去吃点好的？"},{"label":"活动任务登录1","jp":"今日のお仕事です！結構多いですが、頑張りましょう！","fan":"这是今天的工作！虽然挺多的，我们一起加油吧！","off":"这是今天要做的事！虽然不少，但我会加油的！"},{"label":"活动任务登陆2","jp":"一つ一つ丁寧に…本官も頑張りますよ、先生！","fan":"一件一件仔细地处理……本官也会努力的，老师！","off":"一步一步慢慢来！本警员也会加油的，老师！"},{"label":"活动任务获取1","jp":"さすが先生です！すごいです！","fan":"不愧是老师，真厉害！","off":"不愧是老师！好厉害！"},{"label":"活动任务获取2","jp":"お疲れ様でした、先生！","fan":"辛苦啦，老师！","off":"辛苦了，老师！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/510633.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/1/10/773149.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2025/8/30/439982.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/243875.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/1/10/600979.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2025/8/30/886940.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/778995.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/1/10/462575.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2025/8/30/823668.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/391950.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/1/10/712148.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2025/8/30/21235.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/im