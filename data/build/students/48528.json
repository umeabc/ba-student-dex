5/12/698948.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/820828.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/546208.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/161621.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/721251.png","name":"好美的限定巧克力","desc":"好美亲手制作的手工巧克力。从各方面看来，都是其他地方找不到的限定版中的限定版。"},"ability":{"attrs":[{"name":"生命值","value":"761"},{"name":"攻击力","value":"122"},{"name":"治愈力","value":"227"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/862595.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/768419.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 好美（乐队）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_637/h_625/829/86082/2025/5/12/81115.png","url":"https://www.gamekee.com/ba/620883.html"},{"name":"NPC 好美（鬼屋）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/12/283650.png","url":"https://www.gamekee.com/ba/639189.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案。"},{"label":"卡池抽取","jp":"小さいからって舐めないで！将来性はものすっごいんだから！","fan":"不要因为我个子小就瞧不起我，我可是很有前途的！","off":"别因为我个子小就看不起我，我的潜力可是很大的！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"頭撫でないでっ！もうっ…子ども扱いは嫌なの。","fan":"不要摸我的头！我不喜欢被当成小孩子看。","off":"别摸我的头！真是的，我讨厌别人把我当小孩。"},{"label":"登陆2","jp":"私も…あと何年か経ったら…妹じゃなくて、恋人に見えるかな？","fan":"我也…再过几年才能不被当做妹妹，而是恋人来看待呢？","off":"如果再过几年，我会不会看起来，就不止像你的妹妹了呢？"},{"label":"大厅1","jp":"牛乳なら1L飲んでる。仕方なく、毎日、毎日、毎日ね！","fan":"牛奶的话每天都喝一升，没有办法，每天，每天，每天都。","off":"牛奶我每天都要喝一升，有什么办法？每天喝每天喝每天喝！"},{"label":"大厅2","jp":"と、当番になれば、先生と美味しいお菓子を食べる時間があるはずよね？","fan":"值，值班的话，就有更多和老师一起吃美味的点心的时间了吧。","off":"如果我值日，就有时间和老师一起吃好吃的零食了吧！"},{"label":"大厅3","jp":"ほら、今日も頑張って！私が手伝ってあげるから！","fan":"好啦，今天也加油哦！我也会给你帮忙的！","off":"好啦，今天也加油吧，我也会帮你的！"},{"label":"大厅4","jp":"あの、先生、疲れてない？\nお、美味しいスイーツでも食べに行く？","fan":"那个，老师，累了没？\n要，要不要去吃好吃的甜点？","off":"那个，老师你累不累呀，要不要一起去吃好吃的甜点啊？"},{"label":"大厅5","jp":"ほら！私がいる限りサボろうとするのは諦めなさい！さ、仕事の時間よ！任務を始めましょう！","fan":"好啦！有我在就别想着偷懒了，现在是工作的时间哦，快点开始任务吧！","off":"喂！我在这盯着你还想偷懒啊？来，该干活了，开始执行任务吧。"},{"label":"回忆大厅1","jp":"ほんと、先生には驚かされっぱなしっていうか、\n振り回されっぱなしっていうか……","fan":"真是的，总是被老师吓一跳，被耍得团团转……","off":"……真是的，老师总喜欢吓唬人呢……真是，让人捉摸不透。"},{"label":"回忆大厅2","jp":"……ん？何をそんな、じっと見てるわけ？\nねぇ、まさかまた変なこと考えてないでしょうね？","fan":"……嗯？为什么那样看着我？\n我说，老师不会又在想些什么奇怪的事情吧？","off":"嗯？你直勾勾地盯着我干什么……啊，一看就知道，你一定又在想什么奇怪的事吧！"},{"label":"回忆大厅3","jp":"私は先生のオモチャじゃないんだから、いい加減やめないと本当に怒るよ。","fan":"我又不是老师的玩具，再不收敛点我真的生气了哦。","off":"哼，我可不是老师的玩具！要是不适可而止的话，我就真生气啦！"},{"label":"回忆大厅4","jp":"……いやまあ、別に心の底から嫌、って\nわけじゃないけど……。……ふふっ。","fan":"……不是啦，倒也没有真的感到讨厌……呵呵。","off":"虽然，其实也没有那么讨厌……诶嘿嘿。"},{"label":"回忆大厅5","jp":"（いつか……）\n（いつかこうやって隣に……堂々と、並んで歩ける日が……）","fan":"（总有一天……）\n（总有一天要像这样……堂堂正正地，走在老师身边……）","off":"（早晚……早晚有一天，我和你并肩散步时，能被称赞“很般配”的日子，也会到来吧。）"},{"label":"咖啡馆1","jp":"美味しいスイーツが食べたーい、あっ！先生！","fan":"想吃好吃的甜点~！啊，老师！","off":"我想吃好吃的点心！啊，老师！"},{"label":"咖啡馆2","jp":"ん？えー…牛乳は、嫌い。飲まなきゃいけないって分かってるから、尚更！えっ？それ、い、イチゴ牛乳？","fan":"嗯？欸—…牛奶，不喜欢。因为知道不能不喝，就更！欸？那个是，草，草莓牛奶？","off":"嗯？我讨厌牛奶！因为我知道必须要喝，所以更讨厌了，嗯？是草莓牛奶吗？"},{"label":"咖啡馆3","jp":"…私の成長はまだ終わってないの！信じて！","fan":"…我的成长还没有结束呢！相信我！","off":"我还没有发育完呢！真的！"},{"label":"咖啡馆4","jp":"ふふっ。一眠りしていこっかな。","fan":"呼呼。要不要去小睡一下呢。","off":"要不要打个盹呢？"},{"label":"咖啡馆5","jp":"はあ…先生はなんであんなに空気が読めないんだろう。","fan":"唉…老师为什么这么读不懂气氛呢。","off":"老师为什么这么不会看人脸色呢？"}],"好感度":[{"label":"好感度1","jp":"な、なんて言うかその……は、恥ずかしいんだけど！","fan":"那，那个，说什么好呢……有，有点害羞！","off":"怎么说呢？那个，太尴尬了吧！"},{"label":"好感度2","jp":"今日は…楽しかった。う、嘘じゃない！","fan":"今天…很开心。没，没有说谎！","off":"今天，很开心，是真的！"},{"label":"好感度3","jp":"か、勘違いしないで！先生との時間が楽しすぎただけだから！……はっ、何か言い間違えた気がする！？","fan":"不，不要误会了！只是和老师在一起的时间太开心了！……啊！总感觉说错了什么！？","off":"别误会了。我只是觉得和老师在一起很开心而已，嗯…感觉说错话了！"},{"label":"好感度4","jp":"あ、あ…ありがと！い、今はこの言葉しか浮かばないの。でも…次はその…","fan":"啊，啊…谢谢！现在只能想到这句话。但是…下次…那个…","off":"谢、谢、谢谢，现在我只能想到这些话了，但是，下次，那个…"}],"战斗":[{"label":"编入队伍1","jp":"私が合流したことに感謝しなさい。","fan":"好好感谢我来合流的事吧。","off":"我可是专程过来和大家汇合的，还不快谢谢我？"},{"label":"编入队伍2","jp":"仕様がないわね、行くわよ。","fan":"真是没有办法，要上了哟。","off":"真没办法，走吧！"},{"label":"拎起","jp":"ひゃっ！？き、急になによ！？","fan":"呀！？突、突然之间干什么！？","off":"啊？！搞什么啊！"},{"label":"普通技能","jp":"これはどう！？","fan":"这个如何！？","off":"这招如何？"},{"label":"EX动画1","jp":"くらえっ！","fan":"吃我这招！","off":"吃我一发！"},{"label":"EX动画2","jp":"ふんっ、やっつけてやる！","fan":"哼，收拾你！","off":"干掉你！"},{"label":"EX动画3","jp":"覚悟しなさい！","fan":"做好觉悟吧！","off":"给我死心吧！"},{"label":"EX技能1","jp":"はあぁぁ！","fan":"哈哈哈！","off":"嗨！"},{"label":"EX技能2","jp":"これでどう！？","fan":"这招怎么样！？","off":"这发怎么样？"},{"label":"EX技能3","jp":"これでもくらえ！","fan":"也尝尝这招！","off":"再吃一发！"},{"label":"战斗开始1","jp":"ぶっ壊してやるわ。","fan":"来大闹一场吧。","off":"打垮他们！"},{"label":"战斗开始2","jp":"許せない。","fan":"不可饶恕。","off":"饶不了你！"}],"成长":[{"label":"升级1","jp":"あ、あ…ありがとう！","fan":"啊，谢……谢谢！","off":"谢、谢、谢谢！"},{"label":"升级2","jp":"ふふーん、先生！もっと私に頼ってもいいのよ！","fan":"哼哼，老师，更多依靠我一点也可以哦！","off":"哼哼，老师，尽管放心交给我吧！"},{"label":"升级3","jp":"よぉーし！私、これでもっと強くなった！きっと背も伸びたよね！","fan":"好耶！这下我变得更强了！身高也一定长高了吧！","off":"太好了，这样我就更强了，个子也会长高吧！"},{"label":"升级4","jp":"ありがとう先生。…いつか恩返しするから。","fan":"谢谢老师。…总有一天会还这份人情的。","off":"谢谢老师，总有一天我会回报你的！"},{"label":"获得专武","jp":"こんなの貰っちゃったら……\n本気で頑張るしかないじゃん！","fan":"拿到这种东西的话……\n不就不得不认真努力起来了嘛！","off":"收下这种东西，就只能尽全力了吗！"}],"事件":[{"label":"学生生日","jp":"お、お祝いしてくれてありがとう。\n（あと誕生日が何回来たら…そばにいた時に、お似合いって思ってもらえるのかな？）\nべ、別に何も、変なことは考えてないけど？何をそんなにじっと見つめてるのよ？！","fan":"谢，谢谢你给我庆祝。\n（还要过多少个生日…站在他身边的时候才会被人觉得相配呢？）\n我，我可没有考虑什么奇怪的事，为什么这样紧紧的盯着我？","off":"谢谢你的祝福，还得过多少生日，才能让大家觉得我们站在一起比较相称呢，干嘛！我又没胡思乱想，一直盯着我干什么！"},{"label":"老师生日","jp":"誕生日おめでとう、先生！近くに良いスイーツ屋さんがあるの、行こ！","fan":"生日快乐，老师！附近有家好吃的甜品店，走吧！","off":"老师，生日快乐。附近有家很棒的便利店，走吧！"},{"label":"万圣节","jp":"Trick or Treat～放課後スイーツ部には特別な日、ハロウィーンよ！外に行こう！\n幽霊には興味ないけど、飴は大事だからね！","fan":"不给糖就捣蛋~万圣节对于放学后点心部是个特别的日子。去外面吧！\n虽然对幽灵没有兴趣，但是糖可是很重要的哦。","off":"不给糖就捣蛋，对甜点部来说，万圣节是个很特别的节日，我们出去吧，我对幽灵没兴趣。但是吃糖要紧！"},{"label":"新年","jp":"明けましておめでとう！今年の目標？そんなの決まってるでしょ！ナイスバディになることよ！！","fan":"新年快乐！今年的目标？当然是身材变好哦！","off":"新年快乐，今年的目标那还用问吗？肯定是练成完美身材啊！"},{"label":"圣诞节","jp":"メリークリスマス！クリスマスって大好き！街が、私の好きな色でいっぱいになるから！","fan":"圣诞节快乐！最喜欢圣诞节了！因为街道会全变成我喜欢的颜色！","off":"圣诞快乐！我喜欢圣诞节，因为街上到处都是我喜欢的颜色！"},{"label":"春节","jp":"","fan":"新春快乐！今年一定能长得更高，绝对不会再被当成小孩子了！","off":"新春快乐！今年一定能长得更高，绝对不会再被当成小孩子了！"},{"label":"中秋","jp":"","fan":"月饼也算一种甜点吧……？喏，分你一块！","off":"月饼也算一种甜点吧……？喏，分你一块！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/951191.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/542164.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/93697.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/635481.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/133377.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/434639.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/537912.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/552162.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/693593.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/343795.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/618016.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/210075.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/352305.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/103076.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/20/520827.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/imag