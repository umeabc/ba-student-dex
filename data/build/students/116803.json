iki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"樱子(礼服)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/10/139518.png","url":"https://www.gamekee.com/ba/581924.html"},{"name":"★3 樱子（偶像）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_699/h_698/829/86082/2025/5/10/474762.png","url":"https://www.gamekee.com/ba/68786.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"blue archive"},{"label":"卡池抽取","jp":"トリニティー総合学園、シスターフッド所属の歌住サクラコです。日々に安寧があらんことを。","fan":"我是圣三一综合学园修女会所属的歌住樱子。愿安宁常与您同在。","off":"我是崔尼蒂综合学院姐妹会的成员歌住樱子，愿安宁常伴您左右。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お待ちしておりました、先生。今日も祝福があらんことを。","fan":"等您好久了，老师。愿今日也有赐福与您同在。","off":"我正等着您呢，老师，愿今日祝福已与您同在。"},{"label":"登陆2","jp":"あ、先生…。ちょうど、先生のために祈りを捧げていたところです。","fan":"啊，老师…。正好，现在在为老师祈祷呢。","off":"老师，我正好在为您祈祷。"},{"label":"大厅1","jp":"シャーレで先生の補佐を…普段の仕事と違うので、少し緊張します。","fan":"在夏莱担任老师的副手……和平时的工作不一样，有点紧张呢。","off":"在沙勒辅佐老师和平时的工作不太一样，稍微有些紧张呢。"},{"label":"大厅2","jp":"聖堂の仕事、ですか？大丈夫ですよ、日程の調整は済ませております。","fan":"圣堂的工作吗？没问题的，已经调整好日程了。","off":"您是说圣堂的工作吗？没关系的，我把日程都安排好了。"},{"label":"大厅3","jp":"はい、先生。私にできることがありましたら、なんなりと…。","fan":"我在，老师。要是有我能帮上忙的地方的话，请随意吩咐……","off":"老师，如果有什么我能做的，请您尽管吩咐。"},{"label":"大厅4","jp":"聖堂に関することも、一般的な業務も、それ以外でも…なんなりとお申し付けくださいね。","fan":"不管是关于圣堂的事，还是一般的工作，又或者其他事情……都请随意吩咐我吧。","off":"不管是和圣堂有关的工作，还是普通的工作，或者其他工作，您都可以吩咐我。"},{"label":"大厅5","jp":"お疲れのご様子ですね。私にお手伝いできることはありますか？","fan":"您看起来很累呢。有什么我能帮忙的吗？","off":"您看起来很累呢，有什么我能帮上忙的吗？"},{"label":"回忆大厅1","jp":"先生に対して、あまり隠し事をしたくはないのですが…\n私の立場上、全てを明かすことは難しく——","fan":"尽管我并不想对老师有所隐瞒……但是以我的立场，实在是很难把一切都挑明——","off":"虽然我原本不想对老师有所隐瞒。\n但站在我的立场上，很难去把这一切说的明明白白。"},{"label":"回忆大厅2","jp":"ですが、私に「秘密があるという事実」だけでも…\nお伝えすることができて、良かったです。","fan":"但是，就算能对老师说的只有「我们有一些秘密」这件事本身……能传达给老师，就很好了。","off":"可是只要能把我怀揣着秘密这件事告诉老师。\n我就很满足了。"},{"label":"回忆大厅3","jp":"理解を得られるとは思っておりません。\nそれを望むことも…\nそれでも、私の素顔をお見せしたいという気持ちは…あるのです。","fan":"我并不奢望得到老师的理解。就算这样，我也……想对老师展现我的真实面貌。","off":"我很清楚，你恐怕无法理解我，我也没有对此抱有奢望。\n但就算如此，我也想向你展现出自己真实的一面。"},{"label":"回忆大厅4","jp":"その…そのような私でも良いのか、不安ではあったのですが。","fan":"这样……这样的我没问题吗，尽管我对此很不安……","off":"其实。\n我一直很不安，少年看见这样的我，这真的好吗？"},{"label":"回忆大厅5","jp":"思っていたよりも早く、答えを頂いてしまいましたね。\n本当に…ありがとうございます、先生。","fan":"还是从您那里得到了意料之外的果断回答呢。真的是……非常感谢您，老师。","off":"但没想到您这么快就给出了答案。\n真的非常感谢您，老师。"},{"label":"咖啡馆1","jp":"ここが、先生が飾りつけているという…。","fan":"这里，据说是老师亲手装饰的……","off":"听说这里都是老师亲手布置的。"},{"label":"咖啡馆2","jp":"いろんな方がいらしていますね。","fan":"有不少人在呢。","off":"这里有形形色色的人呢。"},{"label":"咖啡馆3","jp":"聖堂とは雰囲気が随分と違いますね。","fan":"这里和圣堂的气氛差别还真大呢。","off":"和圣堂的氛围完全不一样啊。"},{"label":"咖啡馆4","jp":"たまには…こういう場所にいるのも良いものです。","fan":"偶尔……待在这样的地方也不错呢。","off":"偶尔待在这种地方也不错。"},{"label":"咖啡馆5","jp":"形は違いますが、穏やかな気持ちになります。","fan":"虽然形式不太一样，还是能令人安下心来呢。","off":"这里能让我感到另一种平静。"}],"好感度":[{"label":"好感度1","jp":"先生、そのっ…何でもありません…","fan":"老师，那个……不，什么都没有……","off":"老师，你……\n不没什么。"},{"label":"好感度2","jp":"先生に何かをお伝えするたびに、このような言葉で良いのだろうかと悩んでしまいます。","fan":"每次想要对老师说些什么的时候，都会像这样为要说的话是否合适而烦恼呢。","off":"每次想对老师说些什么的时候，我都会苦恼那些话是否合适。"},{"label":"好感度3","jp":"先生ほど私を理解して下さる方も、あまりおりませんでしたので…。","fan":"能像老师这样理解我的，几乎没有别人了……","off":"能像老师这样理解我的人很少。"},{"label":"好感度4","jp":"一応皆のためのシスター…ですから、ですが…その…","fan":"我再怎么说也是修女之身……所以，所以……那个……","off":"我首先是一名为大家服务的修女。可是。"}],"战斗":[{"label":"编入队伍1","jp":"かしこまりました。","fan":"遵命。","off":"明白了。"},{"label":"编入队伍2","jp":"お呼びでしょうか？","fan":"您叫我吗？","off":"您叫我吗？"},{"label":"拎起","jp":"あ、あら…？これは…？","fan":"哎呀……？这是……？","off":"您这是。"},{"label":"任命队长1","jp":"幸いがあらんことを。","fan":"愿幸运与你同在。","off":"愿幸运与我们同在。"},{"label":"任命队长2","jp":"皆様、何卒よろしくお願いします。","fan":"各位，拜托你们了。","off":"诸位拜托你们了。"},{"label":"普通技能","jp":"結局、こうなってしまうのですね。","fan":"结果还是走到这一步了吗。","off":"结果还是变成这样了。"},{"label":"EX动画1","jp":"この弾丸に祝福を。","fan":"赐福于这枚子弹。","off":"为这枚子弹献上祝福。"},{"label":"EX动画2","jp":"我らを恵みを与えたまえ。","fan":"赐予我等恩惠吧。","off":"请赐予我们恩惠。"},{"label":"EX动画3","jp":"恩寵に感謝を。","fan":"感谢神的恩宠。","off":"感谢您的恩宠。"},{"label":"EX技能1","jp":"悔い改めてください！","fan":"请悔改吧！","off":"忏悔吧。"},{"label":"EX技能2","jp":"貴方のためなのです！","fan":"这是为了你好！","off":"这发子弹是送给你的。"},{"label":"EX技能3","jp":"受け止めてください！","fan":"接下这发！","off":"收下吧。"},{"label":"战斗开始1","jp":"共に参りましょう。","fan":"一同前进吧。","off":"一起前进吧。"},{"label":"战斗开始2","jp":"これも一つの試練なのですね。","fan":"这也是试炼之一呢。","off":"这也是一种试炼。"},{"label":"获得BUFF","jp":"助かります。","fan":"帮大忙了。","off":"多谢。"},{"label":"施放BUFF","jp":"私に力を！","fan":"赐我力量吧！","off":"赐予我力量吧。"},{"label":"掩体","jp":"無駄です。","fan":"没用的。","off":"没用的。"},{"label":"被CC1","jp":"-","fan":"-","off":"-"},{"label":"被CC2","jp":"-","fan":"-","off":"-"},{"label":"被CC3","jp":"-","fan":"-","off":"-"},{"label":"被CC4","jp":"\\","fan":"\\","off":"\\"},{"label":"被CC6","jp":"\\","fan":"\\","off":"\\"},{"label":"回避","jp":"信仰心が足りていませんよ。","fan":"你们的信仰不够虔诚。","off":"你们的信仰还不够虔诚。"},{"label":"队伍移动1","jp":"続けて参ります。","fan":"继续前进。","off":"继续前进吧。"},{"label":"队伍移动2","jp":"まだ終わっておりません！","fan":"还没有结束！","off":"还没有结束。"},{"label":"回复","jp":"感謝します。","fan":"十分感谢。","off":"十分感谢。"},{"label":"中途退出","jp":"私が至らないばかりに…","fan":"都是我的失误……","off":"都怪我实力不足。"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"角色移动","jp":"-","fan":"-","off":"-"},{"label":"战斗胜利1","jp":"皆様に恩寵があらんことを。","fan":"愿恩宠与诸位同在。","off":"感谢各位。"},{"label":"战斗胜利2","jp":"平和でありますように。","fan":"愿一切回归平静。","off":"能顺利解决就好。"},{"label":"关卡完成1","jp":"皆様に感謝を。","fan":"感谢各位。","off":"愿恩宠与诸位同在。"},{"label":"关卡完成2","jp":"解決できて何よりです。","fan":"任务解决了就最好不过。","off":"愿和平永在。"},{"label":"战斗失败1","jp":"私の、失態です…","fan":"是我失态了……","off":"是我疏忽了。"},{"label":"战斗失败2","jp":"面目ありません……","fan":"实在是丢脸……","off":"我很惭愧。"}],"成长":[{"label":"升级1","jp":"あっ、ありがとうございます。こうして目をかけていただくのは、あまり…慣れませんね。","fan":"啊，非常感谢。被如此关注，我还……不太习惯。","off":"谢谢你，像这样被人关心，我还有些不习惯呢。"},{"label":"升级2","jp":"このご恩をどう返していけばよいのでしょう？","fan":"这份恩情该如何回报才好呢？","off":"真不知该如何报答您的恩情。"},{"label":"升级3","jp":"その行いに、祝福があらんことを。","fan":"愿赐福与您的善行同在。","off":"愿祝福与您的善行同在。"},{"label":"升级4","jp":"施しを遠慮するものではありませんね。ありがとうございます。","fan":"您真是不吝施舍呢。十分感谢。","off":"我不会拒绝您的好意，谢谢。"},{"label":"获得专武","jp":"私に慈悲を与えてくださるのですね。有難く頂戴いたします。\nいつか、このご恩をお返しできる日が訪れますように。","fan":"将慈悲赐予我了呢。非常感谢，总有一天我会回报这份恩情的。","off":"感谢您的慈悲，总有一天我会报答您的恩情。"}],"事件":[{"label":"学生生日","jp":"ありがとうございます、先生。誕生日を祝ってもらうのは、やはり、幸せのことですね。","fan":"感谢您，老师。在生日能得到祝福，果然是很幸福的一件事呢。","off":"谢谢你，老师，能在生日得到祝福，果然是一件幸福的事。"},{"label":"老师生日","jp":"感謝に満ちた特別の日ですね。私にとっても、そう。","fan":"今天是充满感谢的特别日子呢。对于我来说也是一样。","off":"对我来说，今天也是一个值得感恩的特别日子。"},{"label":"万圣节","jp":"祝祭の日の前日、一番騒がしい日ですね。いいえ、嫌いわけではありません。喜びは、分け合うほど大きくなりますから。","fan":"万圣节的前夜，是最喧闹的日子呢。不，我并不是讨厌这样的气氛。因为欢乐越是分享就越会增多嘛。","off":"万圣节的前夜总是最热闹的时候。不，我并不讨厌他，因为越是分享快乐就会变得越多。"},{"label":"新年","jp":"一年が過ぎ、新たな年を迎えることが出来ました。今年も、先生にとって幸せな年でありますよう。","fan":"旧的一年过去，迎来了新的一年。愿今年也是对老师而言幸福的一年。","off":"今天是辞旧迎新的日子，愿老师今年也度过幸福的一年。"},{"label":"圣诞节","jp":"はい。今日は間違いなく特別な日です！先生にも、伝わるとよいのですが……","fan":"嗯，今天毫无疑问是特别的日子！如果老师也能明白就好了……","off":"今天的确是个特殊的日子，希望老师也能感受到。"},{"label":"春节","jp":"","fan":"老师，祝您新春快乐，我会一直为您祈祷，愿祝福与您同在。","off":"老师，祝您新春快乐，我会一直为您祈祷，愿祝福与您同在。"},{"label":"中秋","jp":"","fan":"愿所有漂泊的人都能团圆。","off":"愿所有漂泊的人都能团圆。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/884963.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/455620.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/982893.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/478035.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/875201.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/830029.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/917300.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/95922.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/677558.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/378238.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/179173.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/17/263726.ogg"],"大厅及咖啡馆|大厅1":