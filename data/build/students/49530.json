/11/97916.png","url":"https://www.gamekee.com/ba/578167.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive~!"},{"label":"卡池抽取","jp":"白衣の天使が！\nあなたを訪ねて来ましたよ！！","fan":"白衣天使！\n来看你咯！","off":"白翼天使降临到您的身边啦~！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！新しいメールが届きました！楽しい任務を、今日も始めましょう！","fan":"老师！收到了新邮件！快乐的任务，今天也开始吧！","off":"老师，收到了新的信件~！今天也该开始做有趣的任务啦！"},{"label":"登陆2","jp":"きゃあ！ようこそ！先生が来るのを待ってましたよ！","fan":"呀！欢迎！我一直在等着老师您来！","off":"呀，欢迎欢迎~！我一直在等老师来呢！"},{"label":"大厅1","jp":"あっ先生！顔色が悪いです！\n簡単な手術をしましょうか？！","fan":"啊老师！你脸色好差！\n让我为您做个简单的手术吧？！","off":"哎呀老师，您的脸色怎么这么差呀！要不我给您做个简单的手术吧！"},{"label":"大厅2","jp":"活力や笑顔をご所望なら！\nこのハナエにお任せください！","fan":"如果您希望的是活力和笑容的话！\n这些就包在花绘身上吧！","off":"如果您想要活力和微笑，那就请交给花江吧！"},{"label":"大厅3","jp":"先生が好きなタイプは？\nハツラツとした 可愛い女の子ですよね？","fan":"老师喜欢的类型是？\n元气满满的可爱女孩子对吧？","off":"老师喜欢什么类型呢？是活泼开朗又可爱的女孩子对吧！"},{"label":"大厅4","jp":"今日はやることがたくさんあるので怠けちゃだめですよ！","fan":"今天要做的事情堆积如山，不可以偷懒哦！","off":"今天有好多事情要做，可不要偷懒哦！"},{"label":"大厅5","jp":"あっ！なんだかいいことが起きそうな予感！","fan":"啊！总感觉会发生点什么好事！","off":"啊，突然感觉要发生好事情了~"},{"label":"回忆大厅1","jp":"さあ、ではまず傷口を消毒するので、\n靴下を脱いで大人しくしていてください！","fan":"那么，首先我会给您的伤口消毒，\n请把袜子脱了，不要乱动哦！","off":"来，现在要先清理一下伤口。请把袜子脱下来，然后乖乖的不要动！"},{"label":"回忆大厅2","jp":"きちんと消毒しないと、傷から炎症を起こして\n大変なことになってしまうかもしれません。","fan":"如果不好好消毒，可能伤口会发炎，\n搞不好可能会恶化的。","off":"如果不好好消毒的话，伤口会发炎。伤势可能会变得很严重哦！"},{"label":"回忆大厅3","jp":"少し痛いかもですけど、我慢してくださいね！\nん、しょっ…！ きれいきれいにっ…と！","fan":"虽然可能会有些痛，但请忍耐哦！\n嗯，好...！清理得干干净净...！","off":"会有一点疼，稍微忍一下哦~……嗯，好嘞！干干净净的~"},{"label":"回忆大厅4","jp":"はい、よく我慢できました！\nもう少しですよー。","fan":"好了，做得真棒！\n还有一会儿就结束啦。","off":"好，你表现得很好哦~再坚持一下下哦~！"},{"label":"回忆大厅5","jp":"特別におまけで、傷が早く治る魔法の呪文をかけてあげましょう！\nでは、痛いの痛いの、飛んでけ～！\nどうですか？痛くなくなりましたか？","fan":"再特殊附赠您伤口快点愈合的咒语吧！\n痛痛，通通飞走啦~！\n怎么样？是不是不那么痛啦？","off":"特别为老师附赠一个魔法吧，这个咒语能让伤口愈合的更快哦~要开始啦……不痛不痛，妈咪妈咪哄！……怎么样？是不是一点都不疼啦~"},{"label":"咖啡馆1","jp":"友達がたくさんできて、毎日が楽しいです！","fan":"交到了好多朋友，每天都很开心！","off":"因为我有很多朋友，所以每天都过得很开心~！"},{"label":"咖啡馆2","jp":"こんにちは！ハナエです！よろしくお願いします！","fan":"你好呀！这里是花绘！请多多关照！","off":"您好，我是花江~请多多关照~！"},{"label":"咖啡馆3","jp":"るんるん～手術が必要な人～？誰かいないのかな～","fan":"啦啦~需要手术的人~？有谁需要手术吗~","off":"啦啦~有没有人需要做手术啊？……没有嘛？"},{"label":"咖啡馆4","jp":"救援も！希望も！そして愛も！ハナエはすべて備え持っていますよ！","fan":"救援！希望！还有爱！花绘全部都备好了哦！","off":"救助他人，胸怀希望，还有给予爱心。这些都是花江与生俱来的美德哦！"},{"label":"咖啡馆5","jp":"早くウサギさんや猫さんと遊びたいな！","fan":"好想快点和兔子猫猫一起玩！","off":"好想快点和小兔子小猫咪一起玩啊！"}],"好感度":[{"label":"好感度1","jp":"先生のおかげで、私は幸せになれます！","fan":"因为有老师，我变得幸福！","off":"多亏了老师，我才能变得幸福！"},{"label":"好感度2","jp":"私も先生に頂いた幸せを、他の人達に分けてあげられるよう頑張ります！","fan":"我要努力，将从老师那里获得的幸福，努力分给其他的人！","off":"为了把老师给我的幸福和其他人一起分享，我会努力的！"},{"label":"好感度3","jp":"痛みに打ち勝つのは治療ではなく、愛なんですね！先生が教えてくれたんです。","fan":"战胜疼痛的不是治疗，而是爱！这是老师教我的。","off":"帮助人克服痛苦的不是治疗，而是爱啊~这是老师教给我的！"},{"label":"好感度4","jp":"えへへ～、先生のほっぺた～、つん！","fan":"诶嘿嘿~老师嘟嘟脸颊~捏捏！","off":"诶嘿嘿，老师的脸蛋~我戳！"}],"战斗":[{"label":"编入队伍1","jp":"治療なら私に任せてください！","fan":"治疗什么的就交给我吧！","off":"治疗就请交给我吧！"},{"label":"编入队伍2","jp":"私が手伝います。","fan":"我来帮忙。","off":"我来帮忙！"},{"label":"拎起","jp":"見てください！こんなに元気になりましたよ！","fan":"请看！我已经变得这么精神了哦！","off":"快看这个，是不是被治得干干净净啦？"},{"label":"普通技能","jp":"痛いの痛いの、飛んでけ～！","fan":"痛痛飞走啦~！","off":"乖乖~不疼不疼哦~！"},{"label":"EX动画1","jp":"わあ！だめ！ひぃ捕まった！","fan":"哇！不行！呀抓住了！","off":"哇……不好！嘿！抓住了~"},{"label":"EX动画2","jp":"あ、危ない！ご安心ください。","fan":"危、危险！请放心。","off":"啊……危险！……哈~不怕不怕~！"},{"label":"EX动画3","jp":"あぁ！キャッチ！これで安全です。","fan":"啊啊！抓住了！这下子安全了。","off":"啊……我抓！……现在安全啦~"},{"label":"EX技能1","jp":"投薬を始めます。少し効きすぎたかも？","fan":"开始开药啦。稍微有效过头了吗？","off":"开始给药！……嗯？药效是不是太强了……"},{"label":"EX技能2","jp":"治療を開始します。あっ、入れすぎちゃった。","fan":"治疗开始啦。啊、放多了。","off":"开始治疗！……啊，我放太多了……"},{"label":"EX技能3","jp":"これで痛みがなくなるはず！た、多分","fan":"这下子疼痛该消失无踪了！大、大概","off":"这样大概就不疼啦~！大，大概吧……"},{"label":"战斗开始1","jp":"さあ、私も到着しましたよ","fan":"好了，我也到场咯","off":"好~我也到了哦~"},{"label":"战斗开始2","jp":"ドキドキしますね。","fan":"心怦怦跳呢。","off":"好激动~！"},{"label":"特殊载具","jp":"ぶぶー　救急車が来ました","fan":"嘟嘟——救护车来啦","off":"嘟嘟~救护车来啦！"},{"label":"特殊载具","jp":"具合の悪い方々に用意を知らせてす、救護騎士団が到着しました","fan":"请身体不舒服的人做好准备，救护骑士团来啦","off":"伤病者的福音，救援骑士团来啦！"}],"成长":[{"label":"升级1","jp":"いつも元気いっぱいの私ですけど、今はいつも以上に元気が満ちあふれてます！","fan":"一直都元气满满的我，今后会更加地元气四射！","off":"我总是充满活力，不过现在比平时更有活力啦！"},{"label":"升级2","jp":"具合の悪い方が一人もいなくなったら良いですね！私と先生で実現させていきましょう！","fan":"如果没有生病的人就好了呢！我和老师一定要将这个愿望实现！","off":"要是所有的人都能健健康康的就好啦~！老师和我一起实现这个愿望吧！"},{"label":"升级3","jp":"もっと努力します！先生のために！そして、先輩達にとって自慢の後輩になるために！","fan":"要更加努力！为了老师！为了成为让前辈们感到骄傲的后辈！","off":"我还会继续努力~！不仅为了老师，也是为了让自己能成为前辈们的骄傲！"},{"label":"升级4","jp":"ミスをすることもありますが、落ち込んだりしません。先生が、助けて下さいますから！","fan":"虽然偶尔也会有失误，但我不会消沉。因为，有老师帮助我！","off":"会犯错，但是我不会沮丧！因为老师会帮助我的！"},{"label":"获得专武","jp":"この武器には……愛がたくさんつまっています！","fan":"这件武器……充满了爱呢！","off":"这件武器之中，充满了爱~！"}],"事件":[{"label":"学生生日","jp":"今日は私の誕生日です！誕生日プレゼントに、先生の一日が欲しいです。","fan":"今天是我的生日！生日礼物的话，我想要老师的一天。","off":"今天是我的生日~生日礼物嘛……我想要老师陪我一天！"},{"label":"老师生日","jp":"今日は最高に嬉しい日です！先生！お誕生日おめでとうございます！","fan":"今天是最高兴的一天！老师！生日快乐！","off":"今天是我最开心的一天~老师~祝您生日快乐~！"},{"label":"万圣节","jp":"あっ。ハロウィンが始まりました。\n早く出かけましょう～お祭りが始まりますから！","fan":"啊。万圣节开始了。\n快点出门吧~节日祭典开始哦！","off":"啊，万圣节到啦！赶紧出去看看吧，庆典要开始啦~！"},{"label":"新年","jp":"ハッピーニューイヤー！今年も幸せな一年になりますように！","fan":"HappyNewYear！希望今年也是幸福的一年！","off":"新年快乐~！希望今年也是幸福的一年！"},{"label":"圣诞节","jp":"みんなが幸せな クリスマスです！ \nトリニティの女子生徒なら、誰もがドキドキする日ですよ！","fan":"大家看起来都很开心的圣诞节！\n这一天圣三一的女孩子们，每个人都小鹿乱撞！","off":"圣诞节来了，好快乐呀！崔尼蒂所有的女生，都紧张激动地盼着这一天呢！"},{"label":"春节","jp":"","fan":"新春快乐~！花江今年也会带着活力和微笑，陪在老师身边~！","off":"新春快乐~！花江今年也会带着活力和微笑，陪在老师身边~！"},{"label":"中秋","jp":"","fan":"老师，中秋节快乐~！希望所有人都能像我和老师一样，和自己重要的人健健康康地团圆！","off":"老师，中秋节快乐~！希望所有人都能像我和老师一样，和自己重要的人健健康康地团圆！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/528602.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/908397.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/549665.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/513816.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/375129.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/230430.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee