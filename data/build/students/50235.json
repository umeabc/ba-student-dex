https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/199149.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/877500.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/375374.png","name":"百夜堂限定甜點","desc":"百夜堂為迎接情人節所販售的特別甜點。沒有公告也沒有出現在菜單上，至於實際上想賣給誰，靜子不願透露"},"ability":{"attrs":[{"name":"生命值","value":"1471"},{"name":"攻击力","value":"77"},{"name":"治愈力","value":"226"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/150138.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/588376.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 静子（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/12/591721.png","url":"https://www.gamekee.com/ba/162572.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！","fan":"碧蓝档案！","off":"蔚蓝档案"},{"label":"卡池抽取","jp":"えへへ、お祭り運営委員会のシズコです～。\nこれからよろしくお願いしますね、先生？え？\n……ああ、はいはいそうですよ、営業用の台詞です！","fan":"诶嘿嘿，我是祭典运营委员会的静子~。\n接下来还请多多关照，老师？欸？\n……啊，对对，是的，是客套话","off":"诶嘿嘿~我是庆典运营管理部的镜子，以后请多多关照~老师\n诶……啊……对对对，这是营业用的台词。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あっ、おかえりなさい先生！にゃんにゃん！\n……うん、今のは完璧。","fan":"啊，欢迎回来老师！喵喵\n……（嗯，刚才的完美。）","off":"欢迎回来老师~喵喵。\n刚才的很完美。"},{"label":"登陆2","jp":"うう……疲れた…。\nあっ、先生、おかえりなさい！さあさあこちらへ、遠慮なさらず～！","fan":"啊~……好累……。\n啊，老师，欢迎回来！这边随便坐~！","off":"啊……累死了……\n老师您回来了，快来快来这边请，不用客气。"},{"label":"大厅1","jp":"お呼びでしょうか？今日はどんな仕事のお手伝いをします？何でもお任せあれですよ～！","fan":"叫我吗？今天要帮忙做什么工作呢？不管什么都交给我！","off":"您叫我了吗？今天需要帮您做什么呢？不管是什么，尽管交给我吧！"},{"label":"大厅2","jp":"最近そばにいるだけで、知らず知らずのうちに気が緩んでしまうんですよね～。\n……先生のせいですよ？","fan":"最近只是待在老师旁边，就不知不觉变得松懈起来了。\n……都是老师的错哟？","off":"最近只是待在老师身边而已，可经常不知不觉就松懈下来了。\n嗯。这都要怪老师哦。"},{"label":"大厅3","jp":"あ、帰ったらまだ百夜堂の仕事があるんでした。\n……大変だね、ですか？\nいえいえ、大したことでは無いですよ〜。これも私がやるべきことですから。","fan":"啊，回去之后还有百夜堂的工作。\n……真不容易，吗?\n不不，也不是什么大不了的事，而且这也是我该做的。","off":"回去还有百夜堂的工作要做呢，你问我是不是很累？\n不累不累，没什么大不了的啦，这都是我应该做的。"},{"label":"大厅4","jp":"え？可愛い、ですか？\nはあ、揶揄わないでください、先生は私の素顔を知ってるじゃないですか……\n……それが可愛い？う、ぐっ……。","fan":"欸？可爱，吗？\n哈？请不要捉弄我，老师不是知道我的素颜吗……\n……素颜很可爱？呜、呜……。","off":"您说我很可爱？啊……请您别损我了，老师又不是不知道我本来什么样子。\n……那样才最可爱？……呜……"},{"label":"大厅5","jp":"先生財布の紐は固い方ですか？気を付けた方が良いですよ、\n百鬼夜行のお祭りと百夜堂のあんみつは、それをこじ開けてしまうほど魅力的ですからね？","fan":"老师，钱包的扣子还紧吗？还是注意一下比较好哦，\n百鬼夜行的祭典和百夜堂的豆沙水果凉粉可是有能把它打开的魅力哦。","off":"老师~有看好自己的钱包吗？要时刻小心哦。\n因为百鬼夜行的庆典和百夜堂的馅蜜可是魅力十足，足以把紧闭的钱包撬开哦。"},{"label":"回忆大厅1","jp":"ふふっ、お帰りなさいませ～ご主人様～？","fan":"欸嘿嘿，欢迎回来~主人~","off":"嘿嘿~欢迎你回来，主~人~"},{"label":"回忆大厅2","jp":"そうですよぉ～。見ての通り、現在進行形でおサボり中で～す。","fan":"对哦，如你所见，现在进行时的偷懒中。","off":"对的呀，你没看错，我现在摸鱼摸得正开心呢。"},{"label":"回忆大厅3","jp":"……不思議ですね。こういうことはしちゃいけないって、気を張ってなきゃって、ずっと思ってたはずなんですが……。\n先生と一緒にいると……。\nなんだか、気が抜けちゃうって言うか……。","fan":"真不可思议呢，明明不能做这样的事，明明必须要振作起来的，明明一直是这样想的……\n和老师在一起就……\n总感觉，就会放松下来……","off":"真不可思议啊，明明知道自己不能偷懒，明明知道要打起精神来，明明一直都是这么想的来着。但是只要和老师在一起。总感觉一点干劲都没有了。"},{"label":"回忆大厅4","jp":"ほら、先生？こっちに来てください。\n……私をこんな風にした責任、取ってくれますよね？","fan":"喂，老师，来这里\n……你会负起把我变成这样的责任的吧？","off":"来呀老师，请您到这边来。\n是您让我变成这个样子的，您会负责的吧。"},{"label":"咖啡馆1","jp":"萌え萌えきゅ～ん……これで合ってるかな？","fan":"萌~萌~啾……这样对了吗？","off":"萌萌比心~\n我做的对不对？"},{"label":"咖啡馆2","jp":"次のお祭りに向けて、しっかりと計画を立てなくちゃ。","fan":"下次的祭典，要好好地策划才行。","off":"要给下次的庆典制定一个详细的计划了。"},{"label":"咖啡馆3","jp":"百夜堂の新メニュー、何にしようかな……？","fan":"百夜堂的新菜单，要加什么呢……？","off":"百夜堂的新菜单该怎么安排呢？"},{"label":"咖啡馆4","jp":"次のお祭りに、何か新しくて大胆な試みを……全員で着物風バニーガール、とか？","fan":"下次的祭典里，有没有什么新鲜大胆的尝试……全员穿和服风的兔女郎怎么样","off":"下次的庆典，我想大胆一点，搞点不一样的，比如让所有人穿上和风兔女郎。"},{"label":"咖啡馆5","jp":"ここ、百夜堂の出張店舗の場所に良さそう！","fan":"这里摆百夜堂的移动店铺感觉挺好的！","off":"把这里当成百夜堂的临时店铺，好像不错"}],"好感度":[{"label":"好感度1","jp":"（ち、近い！せ、先生との距離がこんな！大丈夫かな！大丈夫なのかな！！）","fan":"（太，太近了！和，和老师的距离这么近！没关系吗？真的没关系吗！？）","off":"（——好近！老师，他今天也在！可以吗？真的可以吗！）"},{"label":"好感度2","jp":"この甘い気持ち、百夜堂のあんみつを口いっぱいに頬張った時みたいな……。","fan":"这份心情，和把百夜堂的豆沙水果凉粉塞满嘴一样……","off":"这种甜蜜的感觉，简直就像我嘴里面填满了百叶堂的馅蜜一样。"},{"label":"好感度3","jp":"先生と一緒にいると、いつも……まるでお祭りの日みたいな気分になります。本当に不思議ですね。","fan":"只要和老师在一起，就像……一直在祭典一样的心情。真的不可思议呢。","off":"每次我和老师在一起，感觉就像在过节一样呢，真的很奇怪诶"},{"label":"好感度4","jp":"楽しいお祭りもいつかは終わるもの、と言いますね……。でもせめて、本当にその時が来るまで……もう少し、そばにいても……いいですか？","fan":"开心的祭典也终有一天会结束，总是这么说呢……。但是至少，到那个时候之前……能让我待在老师身边吗？","off":"有句话说，天下没有不散的宴席，\n但是至少，在宴席散去之前，能在我身边多待一会儿吗？"}],"战斗":[{"label":"编入队伍1","jp":"流石先生、お目が高いですね。","fan":"不愧是老师，眼光真好。","off":"不愧是老师，很有眼光嘛。"},{"label":"编入队伍2","jp":"よし、お祭りの予算稼ぐチャンス、じゃなくて、っが、頑張ります。","fan":"好，为祭典赚预算的机会！不是，我，我会加油的。","off":"好耶，这是提高庆典预算的好机会。\n啊……不……不对，我会加油的~"},{"label":"拎起","jp":"サービス料は別ですよ？","fan":"服务费另算哦？","off":""},{"label":"普通技能","jp":"邪魔はさせません！","fan":"不要来碍事！","off":"不许碍事！"},{"label":"EX动画1","jp":"百夜堂出張販売です！うわあっ！","fan":"百夜堂的移动贩卖，呜哇！","off":"百夜堂出摊啦~哎？？"},{"label":"EX动画2","jp":"百夜堂はどこへでも出張販売します！わっ、茶器がー！","fan":"百夜堂哪里都能移动贩卖！哇，茶具要——！","off":"无论顾客在哪儿，百叶堂都能为您服务！\n哎——我的家具！"},{"label":"EX动画3","jp":"ここで活動資金を稼がないと……うわーっ！","fan":"如果不在这里赚活动资金的话……哇！","off":"一定要在这里赚点活动经费……\n啊——"},{"label":"EX技能1","jp":"こ、こんなことではめげません","fan":"才，才不会因为这种事气馁！","off":"我才不会这样放弃呢！"},{"label":"EX技能2","jp":"ちょっ、激しすぎます！","fan":"等，太激烈了！","off":"太激烈了吧"},{"label":"EX技能3","jp":"うぇ、お店の物なのに……","fan":"欸，明明是店里的东西……","off":"这个都是店里的东西啊——"}],"成长":[{"label":"升级1","jp":"えへへ、シズコは～先生がシズコのこと大切にしてくれてと～っても嬉しいです～。にゃんにゃん！……うん、私可愛い！","fan":"诶嘿嘿，静子啊，老师很珍惜静子静子很高兴。喵喵！……（嗯，我很可爱！）","off":"诶嘿嘿~老师对静子~这么照顾，静子真的超级开心。\n喵喵~唔，我真可爱。"},{"label":"升级2","jp":"わ～い、成長しました～！ブイ！","fan":"哇，我成长了！","off":"哇~我成长啦~"},{"label":"升级3","jp":"ま、まあ？期待に応えられるようには頑張りますけど……？","fan":"那，那个？虽然还是会努力回应期待的……？","off":"行……行吧，既然您这么期待，那我就努力一下下了。"},{"label":"升级4","jp":"先生にこんなに良くしてもらって……シズコ、改めて頑張ります！百夜堂の店主兼看板娘として！","fan":"从老师这里拿到这么好的东西……静子，努力！作为百夜堂店主兼看板娘！","off":"老师对静子这么好，静子一定会加倍努力的，\n毕竟静子可是百夜堂的店长兼看板娘啊。"},{"label":"获得专武","jp":"これ、どんなお祭りでも手に入らない非売品……ですね、えへへ、大切にします！先生。","fan":"这个是，无论是怎样的祭典都入手不了的…………非卖品，诶嘿嘿，我会珍惜的！老师。","off":"这可是任何庆典上都买不到的非卖品，\n嘿嘿，我会好好珍惜的，老师。"}],"事件":[{"label":"学生生日","jp":"えっ、わ、私の誕生日を祝ってくださるんですか？\n……っ！あ、み、見ないでください！今、多分見せられない顔になってますから……！\n……っ、えへっ、えへへっ……！","fan":"欸？庆，庆祝我的生日吗？\n……啊，请，请不要看！现在我大概是不能看的表情……！\n……诶嘿嘿，诶嘿嘿……！","off":"您祝我生日快乐？……\n请别看我，我的表情现在肯定没法见人……诶嘿嘿……"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！\nさ、百夜堂に行きましょう。お祭り運営委員会の委員長権限で、お祭りみたいなお誕生日会を開きますから！","fan":"生日快乐，老师！\n那就去百夜堂吧。我会用祭典运营委员会的委员长权限，举办像祭典一样的生日庆祝会！","off":"老师~祝你生日快乐。来，我们去百叶堂吧，\n我会用庆典运营管理部部长的权力，开一场像庆典一样的生日宴会。"},{"label":"万圣节","jp":"トリックオアトリート！さあ先生、やって来た生徒には、百夜堂のあんみつを押し売りしてやりましょう！\nえ、ダメなんですか？どうして！？","fan":"Trick or treat！那么老师，把百夜堂的豆沙水果凉粉强行推销给来的学生吧！\n欸？不行吗？为什么！？","off":"不给糖就捣蛋！\n老师老师，如果有人过来就强迫他，来买百夜堂的馅蜜吧！\n不行吗？……为什么？"},{"label":"新年","jp":"ハッピーニューイヤー！お正月ですし、こたつの中でぬくぬくするとしましょう～\nちょっ、あ、あと5分だけ……！","fan":"Happy New Year！毕竟是正月，就在被炉里暖暖地过吧~\n等，就，就五分钟……","off":"新年快乐~\n既然是新年，就在被炉里暖暖和和的待着吧~\n——再让我待五分钟就行。"},{"label":"圣诞节","jp":"今日はクリスマス！お祭りの日です！私たちお祭り運営委員会はもちろん見逃しませんよ！さあいきましょう、先生！","fan":"今天是圣诞节！祭典的日子！我们祭典运营委员会当然不会放过这个机会！那么出发吧，老师！","off":"今天是圣诞节，是举办庆典的日子，\n我们庆典运营管理部肯定不能缺席。好了，老师快走。\n春节"},{"label":"春节","jp":"","fan":"老师，新春快乐~\n才不是营业状态，刚刚的新春祝福是认真的。","off":"老师，新春快乐~\n才不是营业状态，刚刚的新春祝福是认真的。"},{"label":"中秋","jp":"","fan":"百夜堂今日限定独家配方月饼，老师您快尝尝吧。\n吃完之后记得代表沙勒找我们订购月饼礼盒哦~","off":"百夜堂今日限定独家配方月饼，老师您快尝尝吧。\n吃完之后记得代表沙勒找我们订购月饼礼盒哦~"}],"活动":[{"label":"活动登陆1","jp":"百夜堂の出張販売です、さあご主人様、必要なものは何でしょうか？","fan":"百夜堂的移动贩卖，那么主人有什么需要的呢？","off":"百夜堂出摊啦~\n来来来，主人~需要什么呢？"},{"label":"活动登陆2","jp":"あっ、先生、いらしゃいませ、さあさあ、お好きなだけ見ていてください","fan":"啊，老师！欢迎光临，想看多久看多久都可以。","off":"老师，欢迎光临。\n来来来，你随便看，随便挑。"},{"label":"活动商店1","jp":"お祭りでも、いえ、お祭りだからこそ、百夜堂は止まりませんよ、まあ、私たちは同時にお祭り運営委員会でもあるので。当たり前なんですけどね。えへ。","fan":"就算是祭典，不，正是因为是祭典，百夜堂才不会停，但是，我们同时也是祭典运营委员会，所以是理所当然的就是了。诶嘿","off":"就算是庆典……不对，\n正因为是庆典，百夜堂才不会休息。\n不过因为我们也是庆典运营管理部，不休息也是理所当然的。诶嘿嘿~"},{"label":"活动商店2","jp":"よし、ここは萌え萌えキュン、え？これちょっとふるいですか？そうなんですか？","fan":"好，这里要萌~萌~啾，欸？这个有点老土了？是这样吗","off":"好，这里应该~萌萌比心。\n诶？这个已经过时了吗？真的假的？"},{"label":"活动商店关闭","jp":"お祭りは終わってしまいましたが、まだまだ営業中です、残り物には福があるっていますから、さあ先生、どうぞ。","fan":"虽然祭典已经结束了，但商店还在营业。剩下来的东西都是有福之物，来吧老师，请挑选。","off":"虽然庆典结束了，但我们仍然在营业。\n据说大家分享之后剩下的部分叫做福根儿~老师可别错过呦~。"},{"label":"活动商店购买1","jp":"あっそれ！いえいえ、どうぞどうぞ、別に甘えたら貰おうとか思ていたわけではなく。","fan":"啊，那个。没有没有，请。并没有想着撒娇了的话就能拿到老师的钱什么的","off":"没……没事没事，你请你请，\n绝对不是因为我想把卖剩下的给吞了。"},{"label":"活动商店购买2","jp":"それは選ぶとは流石先生、お目が高いです。","fan":"居然选了这个。不愧是老师，真有眼光。","off":"真是会选，不愧是老师，眼光独到。"},{"label":"活动商店购买3","jp":"お買い上げありがとうございます！ご主人様。","fan":"感谢购买，主人。","off":"感谢您的购买。主人。"},{"label":"活动商店购买4","jp":"あ、それ、やぱりいい品だと思いますよね。えへへ。","fan":"啊，那个，果然会觉得是好东西吗？诶嘿嘿。","off":"啊，你也觉得这是好东西，对吧？"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/226809.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/78642.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/2/13080633muqyixn6.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/197268.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/371339.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/2/67795103muqyiyva.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/884713.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/486467.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/2/87188053muqyj247.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/956098.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/690504.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/2/73812966muqyj334.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/914842.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/960706.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/1609130/2026/9/2/92214770muqyj43w.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/20/550435.ogg","