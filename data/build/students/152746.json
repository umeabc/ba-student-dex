ameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルー～アー～カイ～ブ～","fan":"蔚蓝~档~案~","off":""},{"label":"卡池抽取","jp":"あー、どもども。ヴァルキューレ警察学校、公安局の志真コノカっす。今日の占い、一緒に見てみません？","fan":"啊——你好你好，我是瓦尔基里警察学校公安局的志真木乃香，一起看看今天的运势吧？","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ちわーっす。調子どっすか？","fan":"你好啊，状态如何？","off":""},{"label":"登陆2","jp":"見ない間に前科持ちになってたり……なーんて、冗談ですって！","fan":"不知不觉间就有了前科啊……呵呵，那是开玩笑的！","off":""},{"label":"大厅1","jp":"あたしが居なくてもヴァルキューレは大丈夫っすよ。というか、いるほうが逮捕率あがるんすよね……なーんか、ちょっかいかけてくるっていうか。だから、こっちいる方がいい気がする、なんちゃって。","fan":"就算我没有，瓦尔基里也没问题的。说起来，我在的时候好像能提高逮捕率呢……感觉好像得有人过来探个究竟。所以我觉得还是让这边有人比较好，开玩笑的。","off":""},{"label":"大厅2","jp":"先生、文章うまいっすねぇ～いいなぁ。あ、でも始末書と反省文なら得意なんで、必要な時は言ってください！","fan":"老师文章写的很好嘛，真好啊。啊，不过写检讨我可是很擅长的，需要的时候请告诉我吧！","off":""},{"label":"大厅3","jp":"お茶～お茶～っと。……このティーバッグ、そろそろ替え時かな。30番煎じはさすがに味しなくなってきた……。","fan":"喝茶～喝茶～。……这个茶包该换了。经历了30次冲泡的茶已经没什么味道了……","off":""},{"label":"大厅4","jp":"懲戒！懲戒！懲戒！……って、繰り返し言われると面白く感じてきません？まぁ、これ以上はマズいっすけど……。","fan":"惩戒！惩戒！惩戒！……这样反复被念叨的话，不会渐渐觉得有点好笑吗？不过再这样下去就糟糕了……。","off":""},{"label":"大厅5","jp":"先生、今日の運勢どうでした？","fan":"先生，今天的运势怎么样？","off":""},{"label":"回忆大厅1","jp":"あーあ、びしょ濡れ……。うぅ……さっむ。","fan":"啊啊，浑身湿透了……呜……好冷。","off":""},{"label":"回忆大厅2","jp":"降り始めちゃいましたね。夜までは止まないらしいのに……はぁ……まぁ、頭を冷やすにはちょうどよかったっすかね。","fan":"开始下雨了。好像会下一晚……唉……不过，倒是正好让脑袋冷静下来了呢。","off":""},{"label":"回忆大厅3","jp":"はぇ？ああ、うーん。悔しくないって言ったら嘘になるっすよ。いろいろ無駄骨になるわ、濡れ鼠になるわ……。","fan":"哼？啊，嗯……如果说不后悔那肯定是骗人的。又是白忙一场，还淋成了落汤鸡……","off":""},{"label":"回忆大厅4","jp":"でも、占いの通りっす。バディが隣にいたから、良い1日になりました。……先生のおかげっすよ。","fan":"不过，果然应验了占卜。因为有搭档在身边，所以过了一天愉快的日子……多亏了老师的帮助啊。","off":""},{"label":"回忆大厅5","jp":"だから、どちらかというと――幸せです……あっ、いや、その！こうやって雨宿りもできて、ラッキーで幸せだなって意味で！そ、それだけ……っすから……。","fan":"所以，说起来——我挺幸福的。啊，不对，是说，能这样一起避雨，真是幸运，很幸福！就……只是这样而已……。","off":""},{"label":"咖啡馆1","jp":"人が～おおいなぁ～","fan":"真多啊～","off":""},{"label":"咖啡馆2","jp":"（さぁて犯罪者は……まぁ、ここにはいないか）","fan":"罪犯……嘛，应该不在这里吧？","off":""},{"label":"咖啡馆3","jp":"あれっ？あたしのバッジ……どこやったっけ……。","fan":"等等？我的徽章……放在哪里了……。","off":""},{"label":"咖啡馆4","jp":"平和だなー。はぁ……暇だ。","fan":"多么和平——唉……好闲啊。","off":""},{"label":"咖啡馆5","jp":"これって合法なんっすか？","fan":"这合法吗？","off":""}],"好感度":[{"label":"好感度1","jp":"なんですか、先生。私のこと好きなんですか。もっと優しい子とかいっぱいいるのに。","fan":"老师，是喜欢我吗？比我优秀的人多了去了，怎么就喜欢我呢？","off":""},{"label":"好感度2","jp":"あの、私も一応女の子なんで、こう見えて繊細なんですよ！","fan":"那个，我再怎么说也是女孩子，别看我大大咧咧的，其实心思很细腻的！","off":""},{"label":"好感度3","jp":"先生のバディやってるといいことだらけっすね。","fan":"做老师的搭档总是能遇到好事呢。","off":""},{"label":"好感度4","jp":"いつもありがとうございます。いや、その、いろいろと。","fan":"一直谢谢您。总之，很多事情都要感谢您。","off":""}],"战斗":[{"label":"编入队伍1","jp":"はいはい、やりますよと。ああ面倒。","fan":"好好，我会做啦。啊，真麻烦。","off":""},{"label":"编入队伍2","jp":"今日の占い、何だったっけ。","fan":"今天的运势是什么来着？","off":""},{"label":"拎起","jp":"腰が伸びる。","fan":"该做一下伸展了。","off":""},{"label":"任命队长1","jp":"あ、令状持ってます? 私はないっすよ。","fan":"啊，你带逮捕令了吗？我可没带哦。","off":""},{"label":"任命队长2","jp":"どこに隠れたのかな。","fan":"藏在哪呢？","off":""},{"label":"普通技能","jp":"私の本！ちゃんと賠償してよね！","fan":"我的书！给我好好赔偿！","off":""},{"label":"EX动画1","jp":"警察登場！","fan":"警察登场！","off":""},{"label":"EX动画2","jp":"正義執行！","fan":"正义执行！","off":""},{"label":"EX动画3","jp":"はあ！悔いしまっときなぁ！","fan":"你悔改吧！","off":""},{"label":"EX技能1","jp":"捕まえ甲斐がある！","fan":"值得抓捕！","off":""},{"label":"EX技能2","jp":"抵抗しなさんなって。","fan":"别抵抗了。","off":""},{"label":"EX技能3","jp":"文句があるならバルキュレに入ることだね。","fan":"有什么抱怨，到了瓦尔基里再说吧。","off":""},{"label":"战斗开始1","jp":"手をあげろ！動いたら撃つ！あ、動いてもいいからね。","fan":"举起手来！再动就开枪了！啊，动也可以啦。","off":""},{"label":"战斗开始2","jp":"現行犯発見！出動！","fan":"发现现行犯！出动！","off":""},{"label":"获得BUFF","jp":"感謝感激雨あられ~","fan":"感谢之情如滔滔江水连绵不绝~","off":""},{"label":"施放BUFF","jp":"ただで帰れると思わないでよ。","fan":"别以为可以就这样回去。","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"被CC3","jp":"","fan":"","off":""},{"label":"回避","jp":"ちゃんと狙わないと当たらないっすよ。","fan":"不好好瞄准可打不中人啊。","off":""},{"label":"队伍移动1","jp":"ここで帰っちゃダメっすか……","fan":"现在回去不行吗……","off":""},{"label":"队伍移动2","jp":"ええ、残りは明日にしません……","fan":"知道啦，今日事今日毕……","off":""},{"label":"回复","jp":"あざっす","fan":"谢谢你","off":""},{"label":"中途退出","jp":"け、警察を呼んで！","fan":"叫、叫警察！","off":""},{"label":"战斗喊叫","jp":"よっしゃ！","fan":"好咧！","off"