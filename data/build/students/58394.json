cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/944200.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/82691.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/592538.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/11/694839.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/944200.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/82691.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/592538.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"738"},{"name":"攻击力","value":"126"},{"name":"治愈力","value":"234"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/873344.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/81014.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 日富美","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/972177.png","url":"https://www.gamekee.com/ba/66256.html"},{"name":"★3 日富美（赛车）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_503/h_503/408107/2026/9/28/72247981mvs62rlc.png","url":"https://www.gamekee.com/ba/725713.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive~"},{"label":"卡池抽取","jp":"あ、相変わらず地味めな私ですが……よろしくお願いします！","fan":"啊，还是那个普普通通的我……请多关照！","off":"我还是那么不起眼呢……如果您不介意的话，就请多指教啦~！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！海ですよ、海！海が私たちのことを待ってます！","fan":"老师！海，是大海！大海在等着我们呢。","off":"老师！大海，是大海啊！大海正等着我们呢！"},{"label":"登陆2","jp":"今日は良い天気ですね、先生。一緒に海沿いで、お散歩でもしませんか？","fan":"今天是个好天气呢，老师。不来一起沿着海边散步吗？","off":"老师，今天天气真好呀！要不要一起去海边散步呀？"},{"label":"大厅1","jp":"海に行くとのことで、少しおしゃれをしてみたんですが……","fan":"因为要去海边，所以想稍微打扮得漂亮点的说……","off":"听说要去海边……我就稍微打扮了一下。"},{"label":"大厅2","jp":"い、いかがでしょう？地味、ですかね……？","fan":"怎，怎么样？会不会……有点土气……？","off":"您……觉得怎么样？看起来会不会太普通了？"},{"label":"大厅3","jp":"夏の海でバカンスとはいっても、ペロロ様のぬいぐるみは欠かせません！","fan":"即使是在海边度假，佩洛洛大人的玩偶也是必需的！","off":"在夏日海边享受度假，怎么能少了佩洛洛大人的玩偶呢？"},{"label":"大厅4","jp":"ペロロ様の羽が濡れてしまわないように防水対策も徹底してます！","fan":"为了不沾湿佩洛洛大人的翅膀，要彻彻底底地做好防水！","off":"为了防止佩洛洛大人柔软的羽毛被水浸湿，要做好万全的防水工作。"},{"label":"大厅5","jp":"……あれ？先生、シャーレの前に駐車していたはずのクルセイダーちゃん、どこに行ったかご存知ですか？","fan":"……咦？老师，本该停在夏莱前面的十字军酱，你知道它去哪里了吗？","off":"老，老师……您看到停在沙勒大楼前的十字军坦克了吗？"},{"label":"回忆大厅1","jp":"ふんふん～♪隅々までキレイに～♪","fan":"哼♪~哼♪~，边边角角也要洗得干干净净。","off":"哼哼~边边角角全都变干净~！"},{"label":"回忆大厅2","jp":"クルセイダーちゃんを、錆びさせるわけにはいきませんからね。\nそもそもみんなで使うものですし、キレイな状態で学園に戻さないと。","fan":"因为可不能让十字军酱生锈呀。\n毕竟这是大家一起要用的东西，要干净地还给学校才是","off":"小小十字军可不能生锈哦。\n毕竟是大家共用的东西，得洗干净了再放回去才行。"},{"label":"回忆大厅3","jp":"あ、先生。あまり近くにいると、水がかかってしまうかもしれませんよ？","fan":"啊，老师，太靠近的话，可能会被水淋湿哦","off":"老师小心点，离得太近可能会被水淋湿哦。"},{"label":"回忆大厅4","jp":"水着だから、濡れても平気……ですか？","fan":"因为穿着泳装所以淋湿也没关系……吗？","off":"您说……穿着泳装淋湿了也没关系？"},{"label":"回忆大厅5","jp":"確かにそうですね。\nあ、ではせっかくですし、この後は一緒に泳ぎにも行きましょう！","fan":"确实是这样诶！那正好，等下一起去游泳怎么样！","off":"确实如此呢……对了，机会难得，之后我们一起去游泳吧！"},{"label":"咖啡馆1","jp":"カフェでこの格好は……ちょっと恥ずかしいですね。","fan":"在咖啡厅穿成这样……有点不好意思呢……","off":"在咖啡厅里穿成这样……感觉有些不好意思呢。"},{"label":"咖啡馆2","jp":"夏っぽい家具がたくさん！","fan":"夏天风格的家具有好多！","off":"好多充满夏日氛围的家具哦……"},{"label":"咖啡馆3","jp":"（な、なんだか注目されてるような……？）","fan":"（总……总觉得像是有人盯着看一样……）","off":"（怎么感觉大家都在关注我……）"},{"label":"咖啡馆4","jp":"（夏の暖かい日差し……気持ち良い……）","fan":"（夏天的日光炎而不热，好舒适……）","off":"（夏日温暖的阳光……好舒服啊~）"},{"label":"咖啡馆5","jp":"（夏限定のペロロ様グッズは無いのかな……？）","fan":"（有没有夏日限定的佩洛洛谷子呢……？）","off":"（有没有夏日限定的佩洛洛大人周边呢？）"}],"好感度":[{"label":"好感度1","jp":"こうして先生と一緒にいられて、今年の夏は最高の思い出になりそうです。","fan":"这样和老师呆在一起，将会成为这个夏天最棒的回忆。","off":"因为和老师在一起，这个夏天一定会成为我最珍贵的回忆！"},{"label":"好感度2","jp":"先生と一緒なら深い海の底でも怖くありません。","fan":"和老师在一起的话，深海也不那么恐怖了。","off":"和老师在一起，就算到深海也不害怕！"},{"label":"好感度3","jp":"なんだか……胸がドキドキします。","fan":"不知道为什么……心跳得好厉害。","off":"总觉得……心脏怦怦直跳……"},{"label":"好感度4","jp":"先生、来年の夏もまた私と一緒にいてくださいね。","fan":"老师，明年夏天也请继续陪我哦。","off":"老师，明年夏天也请和我一起度过吧！"}],"战斗":[{"label":"编入队伍1","jp":"今から泳ぎに行くんですか？！","fan":"现在就要去游泳了吗？！","off":"现在要去游泳吗？"},{"label":"编入队伍2","jp":"バカンスにはピッタリの日ですね。","fan":"超级适合度假的日子呢。","off":"是个适合度假的好日子呢~"},{"label":"拎起","jp":"ひゃあっ！？","fan":"咿呀！？","off":""},{"label":"普通技能","jp":"期間限定ペロロ様爆弾です！","fan":"期间限定佩洛洛炸弹！","off":"限定版，佩洛洛大人炸弹！"},{"label":"EX动画1","jp":"お、落ち着いてください、クルセイダーちゃん！","fan":"请..请冷静下来，十字军酱！","off":"小小十字军……请冷静点！"},{"label":"EX动画2","jp":"……わぁ、うわぁぁ！","fan":"哇，呜哇啊啊！","off":"哇……哇？！"},{"label":"EX动画3","jp":"……うわぁ、落ちる！","fan":"呜哇，要掉下去了！","off":"要……要掉下来啦！"},{"label":"EX技能1","jp":"うえぇ、行きます！","fan":"呜诶，我出发了！","off":"好，我要上啦！"},{"label":"EX技能2","jp":"あ、あれぇ、操縦桿が……","fan":"诶，操纵杆它……","off":"啊，那个……操纵杆……！"},{"label":"EX技能3","jp":"せ、戦車前進です！","fan":"坦，坦克前进！","off":"坦克，前进！"},{"label":"EX技能-召唤物NS","jp":"危険ですので、皆さん戦車から離れてください！","fan":"危险！请大家远离！","off":"危险！请大家远离！"}],"成长":[{"label":"升级1","jp":"えへへ……。これで私も少しくらい地味ではなくなったでしょうか？","fan":"欸嘿嘿……。这样一来我是不是不那么土气了一点呢。","off":"啊哈哈，这样是不是就没那么贫乏了呢？"},{"label":"升级2","jp":"私、もっと頑張ります！","fan":"我，要更加努力！","off":"我会更加努力的！"},{"label":"升级3","jp":"泳ぎの練習でしたら、いっぱいしてきました！","fan":"已经练习了好久好久的游泳了！","off":"我已经练过很多次游泳啦！"},{"label":"升级4","jp":"ペロロ様のためなら……！","fan":"如果是为了佩洛洛大人的话……！","off":"为了佩洛洛大人……"},{"label":"获得专武","jp":"この銃器、防水加工はされてるんでしょうか……？","fan":"这把枪，有没有做防水处理呀……？","off":"这把枪……应该是防水的吧。"}],"事件":[{"label":"学生生日","jp":"何か誕生日に欲しいもの……ですか？\n……ありがとうございます、でも大丈夫です。先生と一緒に過ごすこのバカンスが、私にとっては最高の誕生日プレゼントですから！","fan":"想要什么生日礼物……吗？\n……谢谢你，但是没关系哦。因为和老师一起度过的暑假，对我来说已经是最珍贵的生日礼物了！","off":"我的……生日礼物？\n不用了，没关系的！可以跟老师一起度假，对我来说就是最好的礼物。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！お祝いに私のこの、ペロロ様の浮き輪をプレゼントします！","fan":"生日快乐，老师！为表示我的祝贺，这个佩洛洛游泳圈送给你！","off":"老师，生日快乐！为了表示祝贺，我要把我最爱的佩洛洛泳圈送您当礼物！"},{"label":"万圣节","jp":"え、ハロウィンの衣装？あ、いえ、これは普通に水着で……\nあはは、ちょっと季節違いかもですが……","fan":"诶，万圣节的服装？啊，不是的，这只是普通的泳装啦……\n啊哈哈，虽然有点不符合时节啦……","off":"万，万圣节服装……？这只是很普通的泳衣啊？啊哈哈……不过确实跟季节有些不搭。"},{"label":"新年","jp":"明けましておめでとうございます、先生。今年の夏も、楽しみにしてますね！","fan":"新年快乐，老师。今年的夏天也要期待哦！","off":"新年快乐，老师！今年夏天我也很期待啊~"},{"label":"圣诞节","jp":"さっきシャーレの建物の前で、雪に埋もれたペロロ様を見かけまして……。\n裸の状態で、サンタさんの帽子だけを被っていたのですが、寒くないのでしょうか……？","fan":"刚刚在夏莱的大楼前面，看到了埋在雪地里的佩洛洛大人……。\n没有穿衣服，只戴着一个圣诞帽，它会不会冷呀……？","off":"刚刚在沙勒大楼前面，我看到了一个被雪埋没的佩洛洛……\n这么冷的天，它只戴了个圣诞帽……会不会冷呢？"},{"label":"春节","jp":"","fan":"老师，祝您新春快乐。今年夏天我能再和老师一起去海边吗？","off":"老师，祝您新春快乐。今年夏天我能再和老师一起去海边吗？"},{"label":"中秋","jp":"","fan":"老师，中秋节快乐！这是我抢到的佩洛洛限定月饼，老师要一起尝尝吗？","off":"老师，中秋节快乐！这是我抢到的佩洛洛限定月饼，老师要一起尝尝吗？"}],"活动":[{"label":"活动登陆1","jp":"爽やかの海の香りがしますね！","fan":"感受了大海清爽的香气呢！","off":"哇~是大海清爽的味道！"},{"label":"活动登陆2","jp":"楽しいバカンスになるどいいですね！","fan":"这么愉快的假期可真好啊！","off":"希望大家能度过一个快乐的假期！"},{"label":"活动大厅1","jp":"準備万端です！ペロロ様の浮き輪もしっかり持ちましだ！","fan":"准备万全！佩洛洛大人的泳圈也好好地带着！","off":"万无一失！游泳时需要的佩洛洛泳圈也准备好啦~"},{"label":"活动大厅2","jp":"あれ？脱衣所の鍵、確かここ置いだはず……","fan":"咦？更衣室的钥匙，应该是放在这里来着……","off":"嗯？刚才明明把更衣室的钥匙放到这里了呀……"},{"label":"活动大厅3","jp":"あの……えっと……そんなにジーど見られると、恥ずかしです","fan":"那个…这…这样盯着我看的话，我会害羞的","off":"啊哈哈……请别这样看着我，我会不好意思的……"},{"label":"活动大厅4","jp":"ついに来ましだ！海ですよ！海！","fan":"终于到了！海，是大海！","off":"终于坐上电车来到海边啦~！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/816888.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/661990.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/453201.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/90536.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/833757.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/667194.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/505543.ogg","https://cdnimg-v2.gamekee.c