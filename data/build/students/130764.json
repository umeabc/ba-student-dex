/cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":""},{"label":"卡池抽取","jp":"こんにちは、先生！栅川中学一年、佐天涙子です。よろしくお願いします！","fan":"您好，老师！我是栅川中学一年纪的佐天泪子。请多指教！","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！お待ちしてました！今日は何をするんですか？","fan":"老师！已经等你很久了！今天要去干什么呢？","off":""},{"label":"登陆2","jp":"おかえりなさい、先生。私にできること、何かありますか？","fan":"欢迎回来，老师。有什么我能效劳的地方吗？","off":""},{"label":"大厅1","jp":"ここって、私たちの世界に似ているようで全然違って…面白いんですよね。","fan":"这里和原来的世界完全不同…很有意思呢。","off":""},{"label":"大厅2","jp":"え？今から散歩？…私も行きたいです！連れていってください、先生！","fan":"欸？现在要出去散步吗？…我也要去！带上我一起吧，老师！","off":""},{"label":"大厅3","jp":"何から何まで、面白い世界ですね、ここ！","fan":"这里的一切都很有意思，真是个有趣的世界！","off":""},{"label":"大厅4","jp":"偶然ではありましたけど…ここに来てよかったです！","fan":"虽然说来到这个世界不过是个偶然…但是我还是想说，能来到这里真是太好了！","off":""},{"label":"大厅5","jp":"先生はどうですか？私たちが来てから…毎日がちょっとは楽しくなりました？","fan":"老师是怎么想的？从我们到来的那天开始…所度过的每一日，是否有增加些许欣喜呢？","off":""},{"label":"回忆大厅1","jp":"ん～、特に変わったところは…なさそうかな。\n…先生、顔がこわばってません？ただのバッティングマシーンですって。","fan":"嗯，看起来也没什么奇怪的。\n…老师，怎么板着张脸，是不是有些紧张？不必紧张，不过是台击球机器罢了","off":""},{"label":"回忆大厅2","jp":"はい。でも、たぶん大丈夫です。バッティングには、それなりに自信がありますから。","fan":"不过，应该没什么问题。我对自己的棒球水平还是有自信的。","off":""},{"label":"回忆大厅3","jp":"…なんですか、その疑いの眼差しは。じゃあ、賭けでもします？","fan":"…什么啊，那充满怀疑的眼神。\n来赌一把吗？","off":""},{"label":"回忆大厅4","jp":"3球以内に打てなかったら、大人しく打席を離れます、その代わり、もし1球でも打てたら、そこの自販機で飲み物を奢ってください！","fan":"如果在三球内，我没打中的话，就会老老实实离开击球位。相对的，哪怕我打中一球，那就要请我喝那边自动贩卖机里的饮料","off":""},{"label":"回忆大厅5","jp":"どうですか？先生にとっても、悪い話じゃないですよね？…へへっ。","fan":"如何？对于老师来说，也不是什么坏事。…嘿嘿。","off":""},{"label":"咖啡馆1","jp":"あれ？あの人は…！","fan":"嗯？那个人是…！","off":""},{"label":"咖啡馆2","jp":"おお！なんかここすごいですね！","fan":"哦哦！总觉得这里很厉害的样子！","off":""},{"label":"咖啡馆3","jp":"一見普通っぽいですけど、よくよく見るとちょっと変わってる…うんん、楽しい！","fan":"虽然乍一看很普通的样子，细细观察的话可以看出来是暗藏玄机呢。","off":""},{"label":"咖啡馆4","jp":"ここが噂に聞く異世界のカフェ…","fan":"这就是传说中的异世界咖啡厅…","off":""},{"label":"咖啡馆5","jp":"なんだか落ち着きますね！えへ！","fan":"感觉心情平静了下来呢！欸嘿嘿！","off":""}],"好感度":[{"label":"好感度1","jp":"なんて言ったらいいんですかね…「ありがとうございます」、じゃ全然足りない気がします…","fan":"该怎么说好呢…谢谢…也万全不足以表达此时的心情…","off":""},{"label":"好感度2","jp":"え？ええ？あたしにですか？本当にいいんですか？","fan":"欸？欸欸？这是给我的吗？这样做真的好吗？","off":""},{"label":"好感度3","jp":"先生には助けられてばかりですね、はは...","fan":"总是受到老师的帮助呢，哈哈…","off":""},{"label":"好感度4","jp":"ここに来てから楽しいことばかりなのは、きっと先生のおかけなんだと思います。","fan":"自从来到这里，遇上的尽是些开心的事，这肯定都是托老师的福。","off":""}],"战斗":[{"label":"普通技能","jp":"お、お味は、どうでしょう…？","fan":"味道…如何？","off":""},{"label":"EX动画1","jp":"う？うぅ...な、なに！？","fan":"唔？呜哇？什么东西！？","off":""},{"label":"EX动画2","jp":"来た！","fan":"来了！","off":""},{"label":"EX动画3","jp":"来ると思った！","fan":"要来了！","off":""},{"label":"EX技能1","jp":"ここは…よいしょ！","fan":"这边是…嘿咻！","off":""},{"label":"EX技能2","jp":"は―！","fan":"哈—！","off":""},{"label":"EX技能3","jp":"させない！やー！","fan":"才不会让你得逞！呀—！","off":""}],"成长":[{"label":"升级1","jp":"く、くれるんですか？ありがとうございます！頑張ります！","fan":"给、给我的吗？谢谢！我会努力的！","off":""},{"label":"升级2","jp":"よく分からないけど、なんだか強くなった気が！","fan":"虽然不是很明白，但是总觉得变强了呢！","off":""},{"label":"升级3","jp":"うわ！体中から力が湧いてくる！こういうものなんですか！","fan":"呜哇！力量正从体内源源不断地喷涌而出！原来是这种感觉啊！","off":""},{"label":"升级4","jp":"先生、あたし今なら何でもできそうな気がします！","fan":"老师，我感觉到，现在的我无所不能！","off":""},{"label":"获得专武","jp":"え？これはあたしに？へ、変な感じですね…ありがとうございます。と、とりあえず頑張りますね！それしか言えなくて、すみません、はは...","fan":"欸？这个要给我吗？有种奇怪的感觉呢…感谢您。总、总之，我会加油的！只能这么说了，哈哈…","off":""}],"事件":[{"label":"老师生日","jp":"ハッピーバースデー！お誕生日おめでとうございます、先生！何か欲しいもの、ありますか？","fan":"Happy birthday！生日快乐，老师！有什么想要的礼物吗？","off":""},{"label":"万圣节","jp":"ハロウィーン…！先生！私たちも何か被りに行きましょう！","fan":"万圣节…！老师！我们也变装出去玩把！","off":""},{"label":"新年","jp":"あけましておめでとうございます！先生！時間が経つのって、本当あっという間ですね……。今年もよろしくお願いします、先生！","fan":"新年快乐！老师！时间流逝就如同白驹过隙…今年也请多指教，老师！","off":""},{"label":"圣诞节","jp":"ここにもクリスマスがあるんですか！？じゃあじゃあ、サンタさんが飛んでるところ、見れますかね！？","fan":"这个世界也有圣诞节吗！？那能不能看到飞在天上的圣诞老人！？","off":""}],"活动":[{"label":"活动登陆1","jp":"来てくれたんですね、先生。では早速に行きましょう！","fan":"您来了啊，老师。那么赶紧出发吧！","off":""},{"label":"活动登陆2","jp":"待ってましたよ、先生！","fan":"久等了，老师！","off":""},{"label":"活动大厅1","jp":"あれ？先生？どうかしました？","fan":"老师？怎么了吗？","off":""},{"label":"活动大厅2","jp":"何かお手伝いしましょうか？","fan":"有什么我能帮到您的地方吗？","off":""},{"label":"活动大厅3","jp":"むむ、先生、今は遊んでる場合じゃないですよ！","fan":"唔唔，老师，现在不是玩耍的时候！","off":""},{"label":"活动大厅4","jp":"もう、先生、集中！集中ですよ！","fan":"真是的，老师，集中精神！集中精神！","off":""},{"label":"活动事件1","jp":"もう残り半分？最後まで頑張りましょう！","fan":"还剩下一半？加把劲坚持到最后吧！","off":""},{"label":"活动事件2","jp":"そろそろ終わりが見えてきましたね。","fan":"已经能看到终点了呢。","off":""},{"label":"活动结束","jp":"最後にもう一度見ていきませんか？","fan":"再最后看一眼吗？","off":""},{"label":"活动商店1","jp":"あれ？何かお探しですか？","fan":"您在找什么？","off":""},{"label":"活动商店2","jp":"ええと…見てもらいたいのはあたしじゃなくで、あっちなんですけど...","fan":"嗯…想让您看的不是我，而是那边…","off":""},{"label":"活动商店关闭","jp":"やり残しはないか？チェック、チェックですよ。","fan":"有没有还没完成的事？好好确认哦。","off":""},{"label":"活动商店登陆1","jp":"じゃん！色々用意してみました！","fan":"锵！准备了很多东西哦！","off":""},{"label":"活动商店登陆2","jp":"こちらです、先生！好きなものを選んちゃっでください！","fan":"在这边，老师！请选择心仪的商品吧！","off":""},{"label":"活动商店购买1","jp":"お！それいいですね！","fan":"哦！那个很不错呢！","off":""},{"label":"活动商店购买2","jp":"ふむ、お目が高いですね～なんちゃって。","fan":"唔姆，眼光独到呢~开玩笑的。","off":""},{"label":"活动商店购买3","jp":"お探しの物はそれだったんですね、納得です。","fan":"您找的东西是那个吗，我认可您的眼光了。","off":""},{"label":"活动商店购买4","jp":"おお！やっぱり！あたしもそれがいいと思ってました！","fan":"哦哦！果然！我也觉得那个很好！","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/928975.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/399645.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/382571.ogg","",""],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/157999.ogg","",""],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/886090.ogg","",""],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/748354.ogg","",""],"大厅及咖啡馆|大厅3":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/660886.ogg","",""],"大厅及咖啡馆|大厅4":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/3/894992.ogg","",""],"大厅及咖啡馆|大厅5":["https://cdnimg-v2.gamekee.