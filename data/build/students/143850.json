s://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/236746/2025/5/17/854082.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/17/530620.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/17/713112.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"965"},{"name":"攻击力","value":"115"},{"name":"治愈力","value":"246"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/17/708322.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/17/94621.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★2 明里","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/17/7993.png","url":"https://www.gamekee.com/ba/62126.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive~哼哼~"},{"label":"卡池抽取","jp":"年の暮れ……そして新年。\n言葉の響きに胸が躍りますね。\nそこに美味しいお料理があれば、言うことなしです★","fan":"年末……紧接着是新年。\n光是听到这个就让我激动不已。\n而若往后皆有美食相伴，那我便心满意足了★","off":"年末……还有新年~\n光是想到这些词我就心潮澎湃呢！如果还有美味的菜肴，就最好不过了~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あら★いらしたんですね、先生。\nそれでは、今から食べたい物をお伝えします～","fan":"啊啦★老师来了呢。\n那就让我告诉你我现在想吃的东西吧~","off":"哎呀，老师来啦~\n那我就告诉您，我现在想吃什么吧！"},{"label":"登陆2","jp":"おかえりなさい、先生★\nずーっと、先生のこと待ってました。\nいつから、ですか？\nそれは秘密です★","fan":"欢迎，老师。\n一直，等着老师哦。\n从什么时候开始么？\n秘密哦★","off":"欢迎老师~我一直在等您呢。\n……问我从什么时候开始等的？这可是秘密哦~"},{"label":"大厅1","jp":"どうでしょう～？私の着物姿。\n可愛いって言いたくなったり……しませんか～？","fan":"如何呀？穿着和服的我。\n难道不会想要说我很可爱吗？","off":"我穿和服怎么样~？\n会不会，想夸我可爱呢？"},{"label":"大厅2","jp":"今なら！私とのデートが！\nなんと0円！お買い得ですよ～！\n\n……あ、サボろうとしてるんじゃないかって疑ってますね？\n\n私をなんだと思ってるんですか？\n……正解です★","fan":"正是现在！和我的约会竟然只要0元！买到就是赚到哦！\n\n......啊，在怀疑我是不是在摸鱼怠工么？\n\n究竟把人家想成啥样了呀？\n\n......猜对了哦！","off":"就是现在！和我约会竟然仅需0元！很划算哦~\n……啊，老师该不会在怀疑我想摸鱼吧？您是怎么看我的啊……\n哼哼，回答正确~"},{"label":"大厅3","jp":"フフッ、先生のそばにいると、ついはしゃいでしまいます。\nどうしてでしょうね～？","fan":"嘻嘻，待在老师旁边的时候，不由得就欢快闹腾起来了呢。\n这究竟是为什么呢？","off":"哼哼~只要待在老师身边，我不知不觉就会变得快乐起来啦。\n……为什么会这样呢~？"},{"label":"大厅4","jp":"私、先生に期待しても、いいですか～？\n……あらま、二つ返事だなんて。\nとんでもないことを、期待しちゃうかもしれないのに…？フフッ★","fan":"我可以对老师抱有期待么~？\n......哎哟，立即就同意了呢。\n我可是会期待一些老师难以想象的事情哦？嘻嘻★","off":"我可以对老师抱有期待嘛~？\n哎呀，居然答应地这么快。我说不定会期待一些不切实际的事情哦~嘿嘿~"},{"label":"大厅5","jp":"え？何をしてるの、って？\nご覧の通り、先生に\n寄りかかってるんですよ～？\nフフッ、嫌です、離れません、\nこのままがいいです★","fan":"诶？问我在做什么嘛？\n如你所见，在依靠着老师哦。\n嘻嘻，不要哦，就是不走，这样待着就行★","off":"嗯？您问我在做什么？\n应该能看出来吧~我在靠着老师呀。\n嘿嘿~不要，我就不起来！这样可舒服啦~"},{"label":"回忆大厅1","jp":"ふぅ……思ったより、力が要りますね。大丈夫ですよ、先生。まだいけます。","fan":"唔...比想象中的要更费力呢。没事的、老师。 我还行。","off":"啊……没想到是个体力活呢。\n没关系的老师，我还能坚持！"},{"label":"回忆大厅2","jp":"気遣ってくださって嬉しいです……でもやっぱり、楽しみで仕方がないんです。","fan":"谢谢您的关心...不过, 我果然真的很期待呀。","off":"谢谢老师关心我，我很开心！但是……我还是太期待了，实在忍不住呢。"},{"label":"回忆大厅3","jp":"どんなお餅ができるのか。それでどんな料理が作れるのか……","fan":"会做出怎样的年糕呢。然后能做出什么样的料理呢...","off":"会做出什么样的年糕呢……？用年糕又能做出什么样的食物呢？"},{"label":"回忆大厅4","jp":"……それを、先生と一緒に食べられると思うと……","fan":"...一想到能跟老师一起吃...","off":"一想到，能和老师一起品尝……"},{"label":"回忆大厅5","jp":"……ねえ、先生。お餅ができたら、一番に食べてほしいです。いいですよね？","fan":"...那个、老师。年糕做好以后、我希望老师能吃第一口。可以吗?","off":"您知道吗老师？等年糕做好了，我希望老师能第一个品尝，可以吗？"},{"label":"咖啡馆1","jp":"今日の日替わり\nメニューは\nなんでしょう～？","fan":"今日的菜单是什么呢？","off":"今天的每日菜单是什么呢~？"},{"label":"咖啡馆2","jp":"特別な料理を食べて、\n素晴らしい時間を過ごす…\nなんて素敵なんでしょう★","fan":"尝一尝特别的料理，度过一段美妙的时光...真是太美好了★","off":"享用特别的菜肴，度过美好的时光，多么美妙啊~"},{"label":"咖啡馆3","jp":"口コミの力は\n凄まじいです。読んで\nいるだけでお腹が空いて\nきちゃいますから。","fan":"饮食测评的力量可真厉害。光是读一读肚子就饿得咕咕叫了。","off":"病毒式传播的力量太惊人了，光是看一看都能看饿呢……"},{"label":"咖啡馆4","jp":"評価の点数より、\nレビュー数のほうが\n大事ですよ？","fan":"比起评分，评价数量才更重要哦。","off":"评论数比评分更重要哦~"},{"label":"咖啡馆5","jp":"私だって、いつも\n食べ物のことばかり\n考えてるわけじゃ、\nないですよ～？","fan":"就算是我，也不是一直都想着吃的东西哦。","off":"我可不是一直只想着吃哦？"}],"好感度":[{"label":"好感度1","jp":"先生、どこが行きたい場所はありますか？\n運転でしたら、私にお任せください！","fan":"老师，有想去的地方吗？\n驾驶可以放心交给我哦。","off":"老师，有想去的地方嘛？\n开车可以交给我哦~"},{"label":"好感度2","jp":"食事は生きる上で最も重要と言っても過言ではありません。\nでも、それよりも重要なものだって、世の中には、あるのかな、ないのかな？うふふ～","fan":"说吃喝是生存下去最重要的因素也不为过。\n\n不过，比这还重要的东西，不知道在这世上是否存在呢？嘻嘻。","off":"把饮食当成人生的头等大事也不为过！\n不过，要说世上比这更重要的东西……是有呢，还是没有呢~哼哼~"},{"label":"好感度3","jp":"せっかくの晴れ着ですから、先生に見てもらいたい気持ちが、あったり？なかったり？うふふ～","fan":"好不容易穿上了这副盛装，想让老师好好看看的心情，是有，还是没有呢？嘻嘻。","off":"难得穿上新衣服，有点想让老师看看……好像又不希望。哼哼~"},{"label":"好感度4","jp":"わかってます、先生が生徒を大切に思うのは、当たり前のこと。\nでも、先生。実は私、普通であんまり好きじゃないです。","fan":"我明白，老师重视学生是很理所应当的。\n但是，老师，我实际上可不是很喜欢普通。","off":"我知道，老师重视学员再正常不过了。\n可是老师，我其实不怎么喜欢平凡哦~？"}],"战斗":[{"label":"编入队伍1","jp":"ワクワク、してますか～？","fan":"是不是已经开始期待了呢～？","off":"是不是感到心动了呢？"},{"label":"编入队伍2","jp":"楽しみにしていてください、フフッ。","fan":"敬请期待哦，呵呵。","off":"敬请期待，呵呵。"},{"label":"拎起","jp":"お正月は、美味しいものに溢れていますね、色々と。","fan":"正月里，美味的东西到处都是呢，各种意义上。","off":"这世上让人想吃的东西真的很多，对吧？"},{"label":"普通技能","jp":"スペシャルな一発、いきますよ！","fan":"来个特别的哦！","off":"来一发特别的吧~！"},{"label":"普通技能","jp":"いつものお願いします！","fan":"老样子，拜托了！","off":"还是老样子，拜托咯！"},{"label":"EX动画1","jp":"あはっ！運転は慣れてるんですよ！","fan":"啊哈！我开车可不再生疏了哦！","off":"哼哼~我开车可是很熟练的哦？"},{"label":"EX动画2","jp":"あはは！楽しいですね！","fan":"哈哈，真是开心呢！","off":"啊哈哈~好开心呐！"},{"label":"EX动画3","jp":"ふう～走りましょうか？","fan":"嗯~开始赛跑吧？","off":"嗯~要跑跑看嘛？"},{"label":"EX技能1","jp":"あら？もったいないですね？","fan":"哎呀，可真是浪费呢。","off":"哎呀，好可惜啊~"},{"label":"EX技能2","jp":"安全第一、ですよ～。","fan":"安全第一哟！","off":"安全第一哦~"},{"label":"EX技能3","jp":"緊急停止...何でもないですよ。","fan":"紧急停止...没什么哦。","off":"紧急停车！什么事都没发生哦~"}],"成长":[{"label":"升级1","jp":"私がどこまで食べられるか...いいえ、どこまで成長できるか、見守っていてくださいね！","fan":"我究竟能吃下多少...不，究竟能成长到哪种程度，请好好看着我哦。","off":"我能吃下多少……不，是能成长到什么程度，就请老师来见证啦！"},{"label":"升级2","jp":"まだまだ食べられますよ～、新年は、美味しいものがいっぱいですからね。味わわないと、もったいないです！","fan":"我还能吃好多好多哦。新年就是有好多好吃的东西。不尝遍就太可惜了！","off":"我还吃得下哦~\n因为新年有很多好吃的，如果不尝尝看就太可惜啦！"},{"label":"升级3","jp":"うふ、この先、どんなスペシャルメニューに出会えるのでしょう？楽しみですね、先生！","fan":"嘿嘿，以后会有什么特别菜单等着我呢？很期待吧，老师！","off":"哼哼~今年的特色菜单是什么呢，我可以期待一下嘛，老师~？"},{"label":"升级4","jp":"先生といると、た～くさん新鮮な体験ができるんです。でも、もっと新しい体験も......してみたいかも？","fan":"和老师在一起，能够有很多奇异的体验呢。不过，我还想跟老师有更新奇的体验呢。","off":"和老师在一起，可以获得很多新奇的体验。不过……老师不想再尝试一点，更新奇的体验嘛~？"},{"label":"获得专武","jp":"わあ～！ありがとうございます★\nこれでぜ～んぶ、吹き飛ばせちゃいます！\nフフッ……大丈夫ですよ、先生。\nちゃんと手加減しますから★","fan":"哇！谢谢老师★\n有了它啥都能打飞啦！\n嘻嘻......老师，别担心哦。\n我会手下留情的★","off":"哇~谢谢你！\n有了它，就能把一切都解决掉啦。\n诶嘿嘿~没关系的老师，我会掌握好分寸的！"}],"事件":[{"label":"学生生日","jp":"誕生日お祝い、ありがとうございます、先生。\nでは祝ってくださったついでに～ホールケーキをもう3個、いただいてもいいですか～？","fan":"老师，感谢你的生日祝福。\n那么庆祝完我能顺便把三个蛋糕卷都吃掉么？","off":"谢谢老师的生日祝福！\n那么，趁着为我庆生，可以拜托老师再给我买三个大蛋糕吗？"},{"label":"老师生日","jp":"誕生日ですね、先生！自分のことのように嬉しいです！\nあら？違いますよ、決してバースデーケーキが楽しみだからでは……\n……あります★","fan":"老师的生日诶！就好像自己生日一样开心诶！\n啊呀？不是哦，我可不是因为很喜欢吃生日蛋糕才开心哦......\n......喜欢蛋糕哦★","off":"老师，今天是您的生日诶！我就像自己过生日一样高兴。\n哎呀，没有哦~我绝对不是因为期待生日蛋糕才……\n……才怪啦~"},{"label":"万圣节","jp":"お菓子をもらったら、イタズラしちゃいけないんですか？\n……別にそんな決まりはない？\n今の話……\n本気にしちゃいますよ……？\nふふふ……★","fan":"拿了点心之后就不可以恶作剧了吗？\n......其实并没有这种规定？\n我可是会把这句话当真的哦？\n嘻嘻……★","off":"为什么给了糖就不可以捣蛋呢？\n嗯……？您说并没有规定不可以？\n这句话，您会负责吧~？哼哼~"},{"label":"新年","jp":"新年明けまして\nおめでとうございます～★\nさあ、お節を食べに行きましょう！\n運転は私がしますから。先生、急いでください！","fan":"新年快乐～★\n来吧，让我们来吃年饭吧！\n驾驶就交给我吧，老师，赶紧呀！","off":"新年快乐~\n来，我们去吃御节料理吧！我来开车，老师，请抓紧时间哦~"},{"label":"圣诞节","jp":"クリスマス……\n大晦日……年明け……\nフフッ、私の大好きなシーズンです。\nだって、美味しいものがいっぱいなんですもの！","fan":"圣诞节......\n大晦日......新年......\n嘻嘻，这可是我最喜欢的季节。\n因为有好多好多好吃的东西！","off":"圣诞节……年末……年初！\n嘿嘿，这个季节我非常喜欢。因为……有很多好吃的！"},{"label":"春节","jp":"","fan":"新春快乐哦~老师！\n趁着这样的衣服，总觉得胃口比平时更好了呢！\n走，我们去逛庙会吧！","off":"新春快乐哦~老师！\n趁着这样的衣服，总觉得胃口比平时更好了呢！\n走，我们去逛庙会吧！"},{"label":"中秋","jp":"","fan":"老师~中秋快乐！\n嗯……今年想要尝试不太一样的东西呢！\n桂花酒酿怎么样？里面加了好多好多圆子的那种！","off":"老师~中秋快乐！\n嗯……今年想要尝试不太一样的东西呢！\n桂花酒酿怎么样？里面加了好多好多圆子的那种！"}],"活动":[{"label":"活动登陆1","jp":"わあ！先生！お参り、もう行きましたか？\nまだでしたら…私と一緒に、いかがですか？","fan":"哇！是老师，新年参拜已经去过了吗？\n还没有的话，能跟我一起去么？","off":"哇~老师，您已经许过新年愿望了吗？\n如果还没有的话……要不要和我一起呢~？"},{"label":"活动登陆2","jp":"寒いときに何かを食べると、身体が温まるって言いますよね。\nほら、たくさんのお節が私たちを待ってますよ～？","fan":"据说冷的时候吃点东西的话，身体就会暖暖的。\n你看！好多新年料理等着我呢！","off":"不是说天冷的时候吃点东西，身体就会变暖嘛？\n来吧，有很多御节料理在等着我们呢！"},{"label":"活动大厅1","jp":"何かありましたか？先生？","fan":"发生什么了吗？老师？","off":"出什么事了吗，老师？"},{"label":"活动大厅2","jp":"あら、私にイタズラですか？先生～？\nいいんですか？\n私の仕返しは…ちょっと、変わってるかもですよ？","fan":"哎呀，对我恶作剧么？老师？\n你确定吗？\n我的反击可是有点奇怪的哦！","off":"哎呀，您这是在和我开玩笑嘛？\n老师，真的没关系吗，我的反击……可能会有点特别哦~？"},{"label":"活动大厅3","jp":"先生、退屈ですか？\n私でしたら、先生を退屈させませんけど、いかがですか…？","fan":"老师，很无聊吗？\n我的话，可不会让老师感到无聊，如何呢...?","off":"老师，很无聊嘛？\n我可以给老师解闷哦~怎么样？"},{"label":"活动大厅4","jp":"先生ばかりずるいです。\nはいっ、捕まえました★\nもう離しませんよ～","fan":"光是老师可太狡猾了。\n嘿，抓到啦★\n可不会再让你逃跑哦。","off":"都是老师在逗我，不公平。\n嘿~抓到你啦，现在我再也不会放开您了哦~？"},{"label":"活动事件1","jp":"何か水々しい…違いますね、肉々しい…これでもなくて…\nはい！騒々しいことが起こってるみたいです。","fan":"怎么有点湿湿的......\n不对，肉肉的......\n好像也不是......","off":"怎么好像发生了什么新鲜的……不对，很美味的……也不对，\n……是很热闹的事情！"},{"label":"活动事件2","jp":"いろんな意味で、めちゃくちゃ★ですね。\n私は嫌いじゃないですけど、\nこういうの、苦手な方もいるかもしれません。","fan":"在各种意义上都是乱七八糟的状况呢。\n虽说我并不讨厌，却也还是有难以应付这种状况的人存在呢。","off":"从各种方面来看……都是一件噼里啪啦的事情呢~\n虽然我不介意……但应该会有人觉得很难办吧~"},{"label":"活动结束","jp":"お正月ムードも落ち着きましたね。\nお節、と～っても美味しかったです★","fan":"正月的喧闹气氛渐渐消失了。\n新春料理真是好好吃诶★","off":"新年的氛围快过去了……御节料理真是太好吃了！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/309597.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2025/8/25/687110.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/83323.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/512384.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2025/8/25/680197.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/591865.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/802163.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2025/8/25/365139.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/118374.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2025/5/20/858711.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2025/8/25/947203.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/236746/2