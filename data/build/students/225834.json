://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/98832564mudz53dz.webp"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/1017575/2026/8/23/47277650mudz18gn.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/82191082mudz25oo.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/42475624mudz2rlf.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/15282303mudz3bu0.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/45907742mudz3s63.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/36102660mudz44br.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/32137873mudz4hxf.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/8/23/98832564mudz53dz.webp"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！","fan":"蔚蓝档案！","off":""},{"label":"卡池抽取","jp":"183号特別クラスの学級委員長、仁木アンナです。\nごめんなさいね、サインはまた今度。","fan":"我是183号特别班的学级委员长，仁木安娜。\n不好意思，签名就下次吧。","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生。\n今日は何を\nお手伝いしましょう？","fan":"你好，老师。\n今天需要我帮什么忙？","off":""},{"label":"登陆2","jp":"良い天気……勲章授与にふさわしい日です。\nそうは思いませんか？","fan":"真是好天气……是个适合颁发勋章的日子。\n你不觉得吗？","off":""},{"label":"大厅1","jp":"ああ、こちらは\n私のイチオシの勲章です。触ってみますか？\n金メッキなので\nとてもしっかりしているんです。","fan":"啊，这是我首推的勋章。要摸摸看吗？\n因为是镀金的，所以非常结实。","off":""},{"label":"大厅2","jp":"シャーレは暖かいですね。\n183号特別クラスよりも、\nずっと……少し、暑いくらい。\nいいですね。","fan":"夏莱真暖和呢。\n比183号特别班要暖和得多……甚至有点热。\n真不错。","off":""},{"label":"大厅3","jp":"書類がたくさん……\n先生も、私と同じ\n管理職だったなんて……！\nシャーレも\n連帯責任制なんですか？\nお互い大変ですね……。","fan":"文件好多……\n没想到老师也和我一样是搞管理的……！\n夏莱也是连带责任制吗？\n咱们都挺辛苦的呢……。","off":""},{"label":"大厅4","jp":"工学で守るべきものは\nただ一つ。\n動くべきものが動き、\nそれ以外は静止する。\nそれだけです。","fan":"工学所要守护的，只有一样东西。\n该动的就动，其余的都静止。\n仅此而已。","off":""},{"label":"大厅5","jp":"ここ、工具が\n少なすぎる気がします……。これでは\nヘリくらいしか作れません。\n予備の部品、\n作っておいてもいいですか？","fan":"这里的工具，我觉得太少了……。\n这样下去只能造架直升机了。\n我可以先做点备用零件吗？","off":""},{"label":"回忆大厅1","jp":"本当に、飾って、\nしまいました……。……そんな勇気、私には\nないと思っていたのに。","fan":"真的，把它挂出来了……。\n……我本来以为自己没有这种勇气的。","off":""},{"label":"回忆大厅2","jp":"先生が、私に……。……ふふっ、\nそんな表彰コメント、\n初めて聞きました。ありがとうございます、\nこのような賞を\nいただくことができて、\n本当に光栄です。","fan":"老师，给我的……。\n……呵呵，\n这样的表彰评语，我还是第一次听到。\n谢谢你，能获得这样的奖项，我真的非常荣幸。","off":""},{"label":"回忆大厅3","jp":"……もっと、\n自慢話や苦労話が\n出てくるかと\n思ったのですが。今はもう、\n感極まってしまって……\n何がなんだか。","fan":"……我本来以为会有更多自夸的话和诉苦的话的。\n可现在我已经激动得……不知该说什么好了。","off":""},{"label":"回忆大厅4","jp":"ありがとうございます、\n先生。こんな日が来るだなんて、\n本当に思っていなくて……。夢が一気に、全て\n叶ってしまったような……\nそんな気持ちです。","fan":"谢谢你，老师。\n我真的没想到会有这么一天……。\n感觉就像是梦想一下子全部实现了一样……就是这样的心情。","off":""},{"label":"回忆大厅5","jp":"これからも、ずっと……ええ！ずっと……。ふふっ……！","fan":"从今往后，也一直……\n嗯！一直……。呵呵……！","off":""},{"label":"咖啡馆1","jp":"（サインペンの準備、\nよし）","fan":"（签名笔的准备，好了）","off":""},{"label":"咖啡馆2","jp":"この椅子、\n素晴らしいですね。\n座れるし、軽いから\n振り回しやすい……。","fan":"这把椅子，真不错呢。\n能坐，又轻便，很容易挥舞……。","off":""},{"label":"咖啡馆3","jp":"素敵なデザイン……\n感銘を受けました。","fan":"出色的设计……我深受感动。","off":""},{"label":"咖啡馆4","jp":"ああ……気づいて\nしまったのですね。\nええ、そうです。\n私が仁木アンナです。","fan":"啊……还是被你发现了呢。\n嗯，没错。我就是仁木安娜。","off":""},{"label":"咖啡馆5","jp":"（この部屋から\nレスリングの才能の\n波動を感じます……）","fan":"（从这房间里，我感受到了摔跤才能的波动……）","off":""}],"好感度":[{"label":"好感度1","jp":"もし私が……\nただの一般人だったら……それでも先生は、私を……\n……い、いえ、今のは聞かなかったことに。","fan":"如果我……\n要是我是个普通人的话……即便如此老师还是……\n……不，不，刚才的话就算我没说过。","off":""},{"label":"好感度2","jp":"先生からいただけるお褒めの言葉……\nいつもいただけるものだとは思っていません。\n本当に……ありがとうございます。","fan":"老师给的夸奖之词……\n我并不认为这是理所当然能得到的东西。\n真的……非常感谢您。","off":""},{"label":"好感度3","jp":"見栄っ張りな私を……\n嫌いにならないでいてくださって、ありがとうございます。","fan":"爱慕虚荣的我……谢谢你没有讨厌我。","off":""},{"label":"好感度4","jp":"先生と共に過ごすすべての時間が――\n私にとって、最高の勲章です。","fan":"与先生共度的每一刻时光——\n对我来说，这是最高的荣誉。","off":""}],"战斗":[{"label":"编入队伍1","jp":"科学者にお任せあれ。","fan":"就交给科学家吧。","off":""},{"label":"编入队伍2","jp":"編成……いい肩書ですね。","fan":"编队……是个好头衔呢。","off":""},{"label":"拎起","jp":"わっ！高い！空中殺法を使ってもいいですか？","fan":"哇！好高！我可以用空中杀法吗？","off":""},{"label":"任命队长1","jp":"サインのお願い、断りづらいんですよね。","fan":"请求签名，总是很难拒绝呢。","off":""},{"label":"任命队长2","jp":"学術大会のようなものでしょうか？","fan":"这就像是学术大会一样的东西吧？","off":""},{"label":"普通技能","jp":"天才が一緒で嬉しいですよね？","fan":"和天才一起，很高兴对吧？","off":""},{"label":"EX动画1","jp":"科学とロープワークの融合っ！","fan":"科学与绳索技术的融合！","off":""},{"label":"EX动画2","jp":"生まれつき優秀でごめんなさい。","fan":"天生优秀，真是抱歉。","off":""},{"label":"EX动画3","jp":"リングがあったら鬼に金棒だったのに……！","fan":"要是有擂台的话，那就是如虎添翼了……！","off":""},{"label":"EX技能1","jp":"必殺技、いきます！","fan":"必杀技，要上了！","off":""},{"label":"EX技能2","jp":"うりゃあっ！！","fan":"嘿呀！！","off":""},{"label":"EX技能3","jp":"ババーン！これでどうでしょう！？","fan":"铛铛！这个怎么样！？","off":""},{"label":"战斗开始1","jp":"あまり慣れていませんが……やってみましょう！","fan":"虽然不太习惯……但来试试吧！","off":""},{"label":"战斗开始2","jp":"う、撃たないでください！私は特別クラスの学級委員長ですよ！？","fan":"呜、请别开枪！我可是特别班的学级委员长哦！？","off":""},{"label":"获得BUFF","jp":"共同著書に感謝します。","fan":"感谢你共同著书。","off":""},{"label":"施放BUFF","jp":"","fan":"","off":""},{"label":"掩体","jp":"天才的な遮蔽をご覧あれ。","fan":"看看这天才般的隐蔽。","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"被CC3","jp":"","fan":"","off":""},{"label":"回避","jp":"ロープワーク、回避！","fan":"绳索工事，回避！","off":""},{"label":"队伍移动1","jp":"はぁ……はぁ……くっ、持久力が。","fan":"哈……哈……唔，体力……。","off":""},{"label":"队伍移动2","jp":"走りは……専門外です。","fan":"跑步嘛……不在我的专业范围内。","off":""},{"label":"回复","jp":"勲章をいただけるよう、連絡してみましょう。","fan":"我们试着联系一下，争取能获得勋章。","off":""},{"label":"中途退出","jp":"時間と予算があれば…","fan":"要是有时间和预算的话……","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"角色移动","jp":"はっ！","fan":"哈！","off":""},{"label":"战斗胜利1","jp":"天才科学者の勝利、ですね。","fan":"天才科学家的胜利，对吧。","off":""},{"label":"战斗胜利2","jp":"原理を理解すれば簡単です。","fan":"只要理解了原理，就很简单。","off":""},{"label":"关卡完成1","jp":"まだ知識の１０％も使ってませんけど？","fan":"我才用了不到10%的知识哦？","off":""},{"label":"关卡完成2","jp":"とても簡単な定理でしたね。","fan":"真是个非常简单的定理呢。","off":""},{"label":"战斗失败1","jp":"ろ、論文撤回です!","fan":"论、论文撤回！","off":""},{"label":"战斗失败2","jp":"うっ、肩が抜けてしまいます","fan":"呜，肩膀要脱臼了","off":""}],"成长":[{"label":"升级1","jp":"ただでさえ天才なのに……\nこのままでは、もっと天才になってしまいます……本当に、いいんですか、先生？","fan":"明明本就是天才……\n再这样下去，我会变成更厉害的天才……真的，老师，没问题吗？","off":""},{"label":"升级2","jp":"もう勲章をつける場所がありません……\nズボンにでもつけましょうか。","fan":"已经没有地方再挂勋章了……\n要不放在裤子上吧。","off":""},{"label":"升级3","jp":"また実績が増えてしまいましたね。","fan":"业绩又增加了呢。","off":""},{"label":"升级4","jp":"ふふ……自分の才能が恐ろしいくらいです。","fan":"呵呵……我的才能真是可怕。","off":""},{"label":"获得专武","jp":"ありがとうございます、先生。\nいただいたこちら、電動工具と\n同じくらい多用な使い道があって……\n本当に助かります。","fan":"谢谢你，老师。\n这个送给我的东西，和电动工具一样用途广泛……\n真的帮大忙了。","off":""}],"事件":[{"label":"学生生日","jp":"とても些細な\nことなのですが……今日は何月何日か、\n分かりますか？あ、いえ……\nふと気になって。","fan":"虽然是很小的事情……\n你知道今天是几月几号吗？\n啊，不……只是突然有点在意。","off":""},{"label":"老师生日","jp":"先生、お誕生日\nおめでとうございます。ええ……まさに、\n歴史的な瞬間と言えるでしょう。","fan":"老师，生日快乐。\n嗯……这可以说是历史性的瞬间吧。","off":""},{"label":"万圣节","jp":"ハロウィーンって、\n驚いたらお菓子がもらえる\n日だと思っているのですが……。\nええ……先程、稼働中の\nCNC加工機からビットが\nブッ壊れた音がして……。\nすっごく驚いたので……\nお菓子、もらえたりしますか？","fan":"我一直以为万圣节是被吓到就能得到糖果的日子……。\n嗯……刚才，运行中的CNC加工机的钻头发出了爆裂的声音……。\n因为被吓得好厉害……能给我糖果吗？","off":""},{"label":"新年","jp":"あけまして\nおめでとうございます、先生。本年も\n閃きの絶えない素晴らしい\n一年となりますよう。","fan":"新年快乐，老师。\n愿今年也是灵感源源不断的精彩一年。","off":""},{"label":"圣诞节","jp":"同士サンタ、今年も\n来てくださるのでしょうか？煙突が楽に通れるよう、\n色々と準備して\nおいたのですが……。","fan":"同志圣诞老人，今年也会来吗？\n为了让他能轻松穿过烟囱，我做了各种准备……。","off":""}],"活动":[{"label":"活动登陆1","jp":"レッドウィンターが誇る\n科学者の学級――183号特別クラスへ、\nようこそ！\nそして、私が183号\n特別クラスの委員長、\n仁木アンナです。","fan":"欢迎来到红冬引以为傲的科学家班——183号特别班！\n然后，我就是183号特别班的委员长，仁木安娜。","off":""},{"label":"活动登陆2","jp":"戦車づくり？\nそんなのお茶の子\nさいさいです。","fan":"造坦克？\n那种事情小菜一碟。","off":""},{"label":"活动大厅1","jp":"ええ、\n私がその天才ですよ。正真正銘のホンモノ、