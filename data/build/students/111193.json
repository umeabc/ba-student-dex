ttps://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/976023.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/858247.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/157597/2025/5/13/711416.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/685824.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/143333.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/976023.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/581615.png","name":"巧克力夾心餅","desc":"萌製作的巧克力夾心餅。在香甜的棉花糖上還加入了巧克力，的確能稱得上是毀滅性的熱量"},"ability":{"attrs":[{"name":"生命值","value":"759"},{"name":"攻击力","value":"91"},{"name":"治愈力","value":"228"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/623439.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/651468.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 萌绘（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/13/976566.png","url":"https://www.gamekee.com/ba/164332.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ～。","fan":"碧蓝档案~。","off":"blue archive"},{"label":"卡池抽取","jp":"SRT特殊学園、RABBIT小隊の風倉モエ。\nくひひ……支援なら、私に任せて。","fan":"SRT特殊学园，RABBIT小队的风仓萌绘。\n诶嘿嘿……支援的话，就交给我吧。","off":"SRT特种学院RABBIT小队所属，风仓萌绘前来报道，\n后方的支援工作就都交给我吧。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ああ、お帰り先生。\n今日も相変わらず忙しそうだね、くひひ……。","fan":"啊，欢迎回来老师。\n今天也是一如既往的忙碌呢，诶嘿嘿……。","off":"老师，欢迎回来。你今天也是老样子，还是那么忙，嘿嘿。"},{"label":"登陆2","jp":"お、先生じゃん。\nなーんかずっと忙しそうだね？","fan":"噢，这不是老师嘛。\n还——是一直那么忙呢？","off":"这不是老师吗？最近一直很忙的样子。"},{"label":"大厅1","jp":"そろそろRABBIT小隊の備品でも補充しておくか……。","fan":"差不多该准备RABBIT小队的备用品了……。","off":"差不多要补充RABBIT小队的备用库存了。"},{"label":"大厅2","jp":"はむ……糖分補給は大事っしょ。\nこれは譲ってたまるか！","fan":"啊姆……糖分补给可是很重要的。\n这个可不能轻易让出去！","off":"糖分补给可是很重要的，这个我不能让步。"},{"label":"大厅3","jp":"あー……前に先輩が作ってくれた、あのいなり寿司が食べたい気分。","fan":"啊……好想吃以前前辈做给我的那个稻荷寿司。","off":"好想吃以前前辈给我做过的稻荷寿司啊。"},{"label":"大厅4","jp":"全く、どうして基本的な補給品として飴をカウントしちゃいけないんだ？\n糖分はオペレーターにとって、燃料みたいなもんなのに","fan":"真是的，为什么不能把糖作为基本的补给品来看待呢？\n糖分对操作员来说就像燃料一样","off":"真是的，为什么糖果不算最基本的补给品呢？\n对于我们通讯员来说，糖分就是燃料啊。"},{"label":"大厅5","jp":"仕事、忙しそうじゃん。手伝ってあげようか？\nまぁ、任せてみなって。くひひ……。","fan":"工作，看起来很忙嘛。我来帮你吧？\n嘛，就交给我试试吧。诶嘿嘿……。","off":"工作看起来很忙，需要我帮把手吗？就交给我试试，嘿嘿。"},{"label":"回忆大厅1","jp":"先生……世の中には色んなものがあるでしょ。\n押しちゃいけないボタンとか、超えちゃダメな一線とか。\n中には、一度選んだら取り返しのつかない、破滅に繋がるようなものもある。","fan":"老师……世界上有各种而样的东西对吧。\n比如说不能按下的按钮，不可逾越的界限什么的。\n其中，也会有一旦选择就无法挽回，甚至导致毁灭的东西。","off":"老师，这个世界上有着各种各样的禁忌，\n比如不能按下的按钮，比如不能越过的那条线。\n在这些禁忌里，有些一旦被打破，就会导致毁灭，再也无法回头。"},{"label":"回忆大厅2","jp":"一歩間違えたら終わり、それでも自分の心を満足させられるかもしれない……\nそんな時、先生はどうする？","fan":"一步走错，满盘皆输。但是这样自己的心或许会得到满足……\n那是时候，老师会怎么做？","off":"只要走错一步，就会坠入深渊。\n但如果你能因此满足自己内心的欲望，这种时候老师会怎么做？"},{"label":"回忆大厅3","jp":"無意味な質問だってことは分かってるよ。\n先生は真面目だしね。","fan":"虽然我知道这是没有意义的问题啦。\n老师是很认真的人呢。","off":"我也知道这个问题没什么意义，毕竟老师是个规矩人嘛。"},{"label":"回忆大厅4","jp":"でも私は……その一線を、超えちゃうかもしれない。\nだってその破滅の瞬間は、私自身を証明できる機会でもある。","fan":"但是我……或许会迈出逾越界限的那一步。\n因为那个毁灭的瞬间，也是证明我自己的机会。","off":"可是我就不一样了，我可能会越过那条线，\n因为迎来毁灭的那个瞬间，正是我证明自己的机会。"},{"label":"回忆大厅5","jp":"だから、先生……\nその一線……私と一緒に、超えてみない？","fan":"所以，老师……\n那一步……要不要和我一起，试着越过？","off":"所以老师你愿意和我一起越过那条线吗？"},{"label":"咖啡馆1","jp":"何かこう、大事な発射ボタンとか落ちてないもんかねー……？","fan":"像这样，重要的发射按钮怎么会掉下来呢……？","off":"这里是不是少了什么重要的发射按钮？"},{"label":"咖啡馆2","jp":"くひひ……","fan":"诶嘿嘿……","off":"嘿嘿嘿嘿。"},{"label":"咖啡馆3","jp":"ここ、新しい拠点にしちゃって良い？","fan":"把这里，作为新据点怎么样？","off":"要不要把这里当成新的据点呢？"},{"label":"咖啡馆4","jp":"……まあ、割と落ち着くかも。","fan":"……唔，这里比较能安静下来呢。","off":"总觉得很安心。"},{"label":"咖啡馆5","jp":"飴が足りない……。","fan":"糖分不足啦……。","off":"糖分要不足了。"}],"好感度":[{"label":"好感度1","jp":"なんだか先生には、いつも助けてもらってばかりの気がするね。くひひ……","fan":"总觉得老师总是帮助我呢。诶嘿嘿……","off":"感觉老师一直在帮助我呢。"},{"label":"好感度2","jp":"なんかこう、一線を超えそうな感じ","fan":"总觉得这样，似乎超越了那条界限呢","off":"总觉得好像要越界了呢。"},{"label":"好感度3","jp":"飴、要る？私の食べかけしかないけど。","fan":"要糖吗？虽然只有我舔过的。","off":"要吃糖吗？虽然我全都舔过了。"},{"label":"好感度4","jp":"先生と一緒なら、ド派手な破滅を迎えるのも…くひひ……","fan":"和老师在一起的话，即使迎来华丽的毁灭也…诶嘿嘿……","off":"只要和老师在一起，就算迎来华丽的毁灭也……嘿嘿嘿。"}],"战斗":[{"label":"编入队伍1","jp":"なになに。どこかから危険な匂いがするね","fan":"什么什么。从哪里传来了危险的味道呢","off":"怎么啦怎么啦？我好像闻到了危险的味道。"},{"label":"编入队伍2","jp":"私の手伝いが必要って感じ","fan":"感觉我很重要呢","off":"是不是需要我的帮助？"},{"label":"拎起","jp":"くひひっ、派手に吹き飛ばしちゃうよ〜","fan":"咕嘿嘿，要华丽的地炸上天咯~","off":"咕嘿嘿，老师和想我一起多炸点东西吗？"},{"label":"普通技能","jp":"ファイア！","fan":"开火！","off":"开火。"},{"label":"EX动画1","jp":"くひひ……全弾発射！","fan":"诶嘿嘿……全弹发射！","off":"嘿，全弹发射。"},{"label":"EX动画2","jp":"ふう…ふう…もう我慢できない","fan":"呼…呼…我要忍不住了","off":"我要忍不住了。"},{"label":"EX动画3","jp":"いや、ぞくぞくするね","fan":"一个一个来哦","off":"这种毛骨悚然的快感。"},{"label":"EX技能1","jp":"さあ、派手に行こうか","fan":"好了，华丽地上吧","off":"好了，华丽的绽放吧。"},{"label":"EX技能2","jp":"くひひ……これだからやめられない…","fan":"诶嘿嘿……正因如此才停不下来呢…","off":"就是这个最上瘾。"},{"label":"EX技能3","jp":"ふう…ふう…綺麗……","fan":"呼…呼…好美……","off":"好美啊。"}],"成长":[{"label":"升级1","jp":"くひひ……サンキュー、先生。","fan":"诶嘿嘿……Thankyou，老师。","off":"嘿嘿嘿，老师，谢谢你。"},{"label":"升级2","jp":"もっと、もっとやれるはず…！","fan":"还能，还能做得更好…！","off":"还不够，还能继续。"},{"label":"升级3","jp":"先生が色々くれるから、もうお腹一杯だよ。","fan":"老师给了我那么多，肚子已经饱饱的啦。","off":"老师给了我这么多，肚子都撑圆了。"},{"label":"升级4","jp":"昂ぶってきた。良いね、楽しくなってきたよ！","fan":"高涨起来了。好啊，高兴起来吧！","off":"好兴奋，不错，感觉有意思起来了。"},{"label":"获得专武","jp":"RABBIT-224式拳銃、確かに受け取った。\n……ねぇ、これ結構小さいけど、ちゃんと火力出る？","fan":"RABBIT-224式手枪，我收到了。\n……喂，这么小巧，威力能好好发挥吗？","off":"Rabbit 224式手枪收到，\n怎么这么小，火力够吗？"}],"事件":[{"label":"学生生日","jp":"誕生日ケーキ？いや別に、私には花火さえあればそれで……。\nそうだね、どうせならド派手で強烈なのを……くひひ。","fan":"生日蛋糕？啊其实不用这样，我只要有烟花就好了……。\n对了，如果可以的话我想要超华丽超震撼的那种……诶嘿嘿。","off":"生日蛋糕？不用，给我一发盛大的烟花就好了。\n难得有机会就找老师要一个超级华丽的。"},{"label":"老师生日","jp":"誕生日おめでと、先生。ってことで……\n一発派手に、お祝いの花火とかどう？","fan":"生日快乐，老师。说起来……\n来一发华丽的庆祝烟花怎么样？","off":"老师生日快乐。那么要来一发华丽的生日烟花吗？"},{"label":"万圣节","jp":"このカボチャのランタン……\nあの粉をかけたらもっと綺麗に燃えそうじゃん……はあ、はあ……","fan":"这个南瓜灯笼……\n撒上那个粉末的话会燃烧得更漂亮吧……斯哈斯哈……","off":"这个南瓜灯要是给它撒上白磷粉，一定会燃烧得更漂亮吧。"},{"label":"新年","jp":"山海経では新年に花火を打ち上げて厄除けをする風習があるらしいよ。\nほんっと、良い文化だねぇ……くひひ。","fan":"好像山海经有新年燃放鞭炮，驱除厄运的风俗呢。\n真的， 是个好文明呢……诶嘿嘿。","off":"听说山海经新年有放烟花除旧迎新的风俗，这可真是个好风俗，可嘿嘿。"},{"label":"圣诞节","jp":"今年のクリスマスは、RABBIT小隊全員で七面鳥を食べることになってさ。\nん？もちろんいつもの公園でだよ。\nん？消防法……？なにそれ？","fan":"今年的圣诞节要和RABBIT小队全员吃烤火鸡呢。\n嗯？当然是在一直住着的公园吃咯。\n嗯？消防法……？那是啥呀？","off":"今年圣诞节我们rabbit小队的队员要一起吃火鸡，\n当然是在我们一直待在那个公园里吃。\n消防安全法，那是什么？"},{"label":"春节","jp":"","fan":"老师，既然新春到了，那想不想看一场灿烂的烟花秀呢？","off":"老师，既然新春到了，那想不想看一场灿烂的烟花秀呢？"},{"label":"中秋","jp":"","fan":"飞到月亮上再也回不来，这也是一种自寻毁灭吗？","off":"飞到月亮上再也回不来，这也是一种自寻毁灭吗？"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/13/381548.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/237857.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/25/586968.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/13/699965.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/879603.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/25/898399.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/13/918187.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/398033.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/25/164545.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/13/479062.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/34008.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/2/25/921484.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/13/436411.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images