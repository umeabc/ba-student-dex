:"佳代子（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/737047/2025/5/10/48156.png","url":"https://www.gamekee.com/ba/586470.html"},{"name":"佳代子（礼服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/737047/2025/5/10/736375.png","url":"https://www.gamekee.com/ba/614736.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案。"},{"label":"卡池抽取","jp":"怒ってないから、誤解しないでね。先生。\n顔が怖いってよく言われるんだ。","fan":"我并没有在生气，请别误会。老师。\n因为经常有人说我面容可怖。","off":"我没有生气，不要误会啊老师，经常有人说我看起来很凶。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生。じゃあ仕事を始めようか。","fan":"欢迎回来，老师。那么开始工作吧。","off":"老师，你回来了，那就开始工作吧。"},{"label":"登陆2","jp":"次の依頼が入った。 この感じ、なんだか慣れ親しんだやつだね。\nシャーレは、便利屋と似ているところがあるように感じる。","fan":"接到了新的委托。总觉得这种感觉很熟悉呢。\n夏莱和便利屋某种程度上也很相似。","off":"接到新的委托了，这种感觉好像有点熟悉，看来沙勒和便利屋有很多相似的地方。"},{"label":"大厅1","jp":"なんか用？まあ、問題があったら解決してあげるけど。","fan":"有什么事吗？嘛，有什么事的话我会帮你解决的。","off":"有事吗？嗯..如果有什么问题我可以帮你解决啊。"},{"label":"大厅2","jp":"…知ってる。怖い顔だってね。よく誤解されるから。","fan":"...我知道的。我面容可怖。因为经常被人误解。","off":"我知道，我表情有点吓人是吧，经常有人误会。"},{"label":"大厅3","jp":"かわ…いい？ふざけないで、先生。","fan":"说我可爱...？别开玩笑了，老师。","off":"可、爱？别开玩笑了老师。"},{"label":"大厅4","jp":"先生を手伝う。それが約束だから。","fan":"我会帮助老师。约定好了。","off":"我会帮助老师的，因为那是我们的约定。"},{"label":"大厅5","jp":"依頼には最善を尽くすよ。それがプロとしての心構えだから。","fan":"我会尽我所能完成委托。因为这是专业人士的觉悟。","off":"委托..我会尽力完成的，作为专业人士，这是基本素质。"},{"label":"回忆大厅1","jp":"ここまで付いてこなくてもよかったのに、先生。","fan":"你不需要跟我到这里来的，老师。","off":"不用一直陪我到这么大老远的地方来啦，老师。"},{"label":"回忆大厅2","jp":"今は、いないのかな…。","fan":"现在不在吗...。","off":"哎呀，它现在不在吗？"},{"label":"回忆大厅3","jp":"雨が降ってたから、見に来ただけ。\n…多分、大丈夫。一人でも平気な子だから。","fan":"因为下雨了，所以来看看。\n...大概，没关系。毕竟这家伙一个人也过得很好。","off":"因为开始下雨了，所以我来看看，应该没问题吧，小家伙一个人也能过得挺好的。"},{"label":"回忆大厅4","jp":"縛られることも、傷つけられることもないのはいいけど…。\nでも、一人は寂しいから…。","fan":"不被束缚，不会受伤，所以很好...\n但是，一个人会寂寞...","off":"虽然没失去自由，也没有受伤什么的，这已经挺好的了，不过一个人还是很孤单吧。"},{"label":"回忆大厅5","jp":"…放っておけなかった。\nただ、それだけ。別に深い意味はないから。\n先生、分かった？","fan":"...是个不能丢下不管的家伙。\n只是这样而已。没什么别的意思。\n嗯，老师？","off":"想到它我就放心不下，仅此而已，这话可没有什么别的意思，知道了吗，老师？"},{"label":"咖啡馆1","jp":"意外と…可愛い？ふうん、つまらない冗談…だね。","fan":"意外地...可爱？别开玩笑了...吧。","off":"你说没想到我还、、挺可爱？这个玩笑一点都不好笑.."},{"label":"咖啡馆2","jp":"まあ、怖い顔だっていうのはわかってる。","fan":"嘛，我知道我面容可怖。","off":"啊，我知道我的表情有点吓人。"},{"label":"咖啡馆3","jp":"はあ…心配。","fan":"啊...真担心。","off":"额啊.真担心。"},{"label":"咖啡馆4","jp":"ふーん、少しは興味が沸いてきた。","fan":"唔，稍微有点意思呢。","off":"嗯？稍微提起点兴趣了。"},{"label":"咖啡馆5","jp":"これからの計画は… まあ、いいか。","fan":"接下来的计划...嘛，算了。","off":"之后的计划、算了，管他呢。"}],"好感度":[{"label":"好感度1","jp":"問題があったら、いつでも訪ねてくるといい。","fan":"如果有什么事的话，可以随时来找我。","off":"如果有什么问题，可以随时来找我的。"},{"label":"好感度2","jp":"便利屋は先生を歓迎するはず。……たぶん。","fan":"便利屋应该一直欢迎老师。……大概。","off":"便利屋，应该也是欢迎老师的，我猜。"},{"label":"好感度3","jp":"先生の依頼なら、いつでも歓迎だよ。","fan":"如果是老师的委托的话，无论何时都欢迎。","off":"老师如果有什么委托，我们随时欢迎。"},{"label":"好感度4","jp":"先生と一緒に仕事ができて良かった。","fan":"和老师一起工作真好。","off":"能和老师一起工作，很开心。"}],"战斗":[{"label":"编入队伍1","jp":"今行く。","fan":"现在动身。","off":"现在就去。"},{"label":"编入队伍2","jp":"依頼なら……やらなきゃね。","fan":"如果是委托的话……没办法不做呢。","off":"如果是委托，那就必须完成了。"},{"label":"拎起","jp":"ふーん……。","fan":"唔……。","off":"嗯…"},{"label":"任命队长1","jp":"行こう。","fan":"走吧。","off":"走吧。"},{"label":"任命队长2","jp":"それくらい、簡単なこと。","fan":"这种程度，小菜一碟。","off":"就这么简单。"},{"label":"普通技能","jp":"覚悟して。","fan":"做好觉悟。","off":"觉悟吧。"},{"label":"EX动画1","jp":"はぁ……","fan":"哈啊……","off":"嗯.."},{"label":"EX动画2","jp":"仕方ないか。","fan":"没办法呢。","off":"没办法。"},{"label":"EX动画3","jp":"ふぅ……","fan":"呼……","off":"欸.."},{"label":"EX技能1","jp":"この機を生かす。","fan":"利用这个机会。","off":"利用这个机会。\nEX技能2"},{"label":"EX技能2","jp":"これで戦況が変わるはず。","fan":"这下子战况要改变了。","off":"这应该会改变战局。"},{"label":"EX技能3","jp":"攻撃のタイミングを狙おう。","fan":"抓好攻击的时机。","off":"瞄准攻击的时机。"},{"label":"战斗开始1","jp":"落ち着いて、作戦通りにやればいい。","fan":"冷静，按照计划行事即可。","off":"冷静下来，按照计划去做。"},{"label":"战斗开始2","jp":"警戒を緩めないで。","fan":"不要放松警惕。","off":"不要放松警惕。"},{"label":"获得BUFF","jp":"支援、受け取った。","fan":"收到了，支援。","off":"支援，收到了。"},{"label":"施放BUFF","jp":"本気で行くよ。","fan":"我要认真了。","off":"我要认真了。"},{"label":"掩体","jp":"遮蔽物発見。","fan":"发现掩体。","off":"找到掩体。"},{"label":"被CC1","jp":"くそ…。","fan":"可恶","off":"混蛋.."},{"label":"被CC2","jp":"けっ","fan":"咳","off":"（喘息）"},{"label":"被CC3","jp":"-","fan":"唔","off":"（喘息）"},{"label":"回避","jp":"この程度","fan":"就这点本事吗","off":"就这点本事？"},{"label":"队伍移动1","jp":"大体片付いたみたいだね。","fan":"大概清理得差不多了呢。","off":"好像已经清理干净了。"},{"label":"队伍移动2","jp":"次の目標はあっちだね、移動しよう。","fan":"下一个目标在那边吧，出发吧。","off":"下一个目标在那边，我们走吧。"},{"label":"回复","jp":"ありがたくもらう。","fan":"感谢。","off":"感激。"},{"label":"中途退出","jp":"-","fan":"-","off":"（喘息）"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"（喊叫）"},{"label":"战斗喊叫","jp":"行くよ。","fan":"上了哦","off":"来了。"},{"label":"战斗喊叫","jp":"喰らって","fan":"吃我这招！","off":"吃我一击。"},{"label":"特殊载具","jp":"-","fan":"-","off":"连这种事都要我干.."},{"label":"特殊载具","jp":"-","fan":"-","off":"没办法.."},{"label":"角色移动","jp":"フォーメーション変更。","fan":"阵型更换。","off":"改变阵型。"},{"label":"战斗胜利1","jp":"相手が悪かったね","fan":"敌人不堪一击嘛","off":"你惹错人了。"},{"label":"战斗胜利2","jp":"ウォームアップにもならない","fan":"连热身运动都算不上","off":"连热身都算不上。"},{"label":"关卡完成1","jp":"お疲れ、先生。","fan":"辛苦了，老师。","off":"辛苦了，老师。"},{"label":"关卡完成2","jp":"先生の選択が功を奏したね。","fan":"老师的抉择奏效了。","off":"老师的选择，奏效了。"},{"label":"战斗失败1","jp":"ごめん、ちょっと油断した。","fan":"对不起，我大意了。","off":"对不起，我有点大意了。"},{"label":"战斗失败2","jp":"覚えときなよ","fan":"给我记好了","off":"给我记住了。"}],"成长":[{"label":"升级1","jp":"あえて私を選ぶなんて……。\nそれが戦略的に正しい選択なら、いいんだけど。","fan":"居然选了我吗……\n如果战略上来说这是明智的选择的话，也不是不行。","off":"竟然选择了我？我希望这是在战略上正确的选择。"},{"label":"升级2","jp":"準備はこれでオーケー。次は私にまかせて。","fan":"准备到这里就可以了。接下来就交给我吧。","off":"这样准备就ok了，接下来就交给我吧。"},{"label":"升级3","jp":"期待に答えられるかどうかわからないけど。","fan":"虽然不知道能不能回应你的期待。","off":"不知道，能不能回应你的期待。"},{"label":"升级4","jp":"ありがとう先生。これからも…よろしく。","fan":"谢谢你老师。今后也...请多关照。","off":"谢谢老师，今后也请多关照了。"},{"label":"获得专武","jp":"先生が決めたことなら異論はないけど……。\nはあ……何でもない。期待されてる分、頑張るよ。","fan":"如果这是老师的决定的话，我没有异议……\n啊……没什么。我会努力回应您的期待的。","off":"如果这是老师的决定，我不会反对，没什么，既然你对我报以期待，我会努力的。"}],"事件":[{"label":"学生生日","jp":"誕生日？えっと。いや、便利屋以外の人にお祝いしてもらったのは初めてで…。\nあ、ありがと…。","fan":"生日？那个。第一次有便利屋以外的人为我庆祝...\n谢、谢谢...","off":"生日？没，除了便利屋的人以外，你还是第一个祝我生日快乐的，谢、谢谢。"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\nうーん、こういう日ってどんな話をすればいいんだ…？","fan":"生日快乐，老师。\n唔，这样的日子里要说些什么呢…？","off":"生日快乐，老师，嗯..这种日子该说点啥来着？"},{"label":"万圣节","jp":"街が眩しくて、甘そうなものでいっぱいだ。あんまり慣れない空気…。\nうーん、でも、一緒に行ってみようか？","fan":"眩目的街道，到处都是甜蜜的东西。不是很习惯这样的氛围...\n嗯，但是，要不要一起出去走走？","off":"街上灯光好耀眼，到处都是甜蜜的气息，这种感觉对我来说太陌生了，不过要不要一起去看看？"},{"label":"新年","jp":"新年か…。今年も、よろしくね。","fan":"新年了啊...今年也请多关照了。","off":"新年了，新的一年，也多关照了。"},{"label":"圣诞节","jp":"メリークリスマス。\n恋人たちの日か…。\nふーん…。","fan":"圣诞快乐。\n恋人们的节日吗...嗯...","off":"圣诞快乐，这是情侣们的节日啊.."},{"label":"春节","jp":"","fan":"新春啊……\n新的一年也请老师多多关照了。我知道，我会多笑一笑的，嗯。","off":"新春啊……\n新的一年也请老师多多关照了。我知道，我会多笑一笑的，嗯。"},{"label":"中秋","jp":"","fan":"我并不讨厌这种团聚的时刻。老师，中秋快乐。","off":"我并不讨厌这种团聚的时刻。老师，中秋快乐。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/10/215981.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/298541.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/672082.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/10/849030.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/713661.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/643173.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/10/234023.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/481593.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/158196.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/10/234602.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/97266.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/382329.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/737047/2025/5/10/308833.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/964920.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/5/17/693559.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.co