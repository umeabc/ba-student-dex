","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_553/h_553/829/72324/2025/5/12/401897.png","url":"https://www.gamekee.com/ba/67654.html"},{"name":"NPC 真纪（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/675941.png","url":"https://www.gamekee.com/ba/643808.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブぅ……","fan":"碧蓝档案……","off":"Blue Archive..."},{"label":"卡池抽取","jp":"うぇ……キャンプ……。\nお休みの日なのに出かけるの……？","fan":"呃...露营...\n明明是休息日却要出门吗...？","off":"呜呜，竟然要去露营……明明是休息日，又要出去吗……？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あ、先生。おはよう。\nあれ……また出かけるの……？","fan":"啊，老师。早上好。\n啊咧...又要出门吗...？","off":"啊，老师，你来啦？该不会接下来又要出去吧……？"},{"label":"登陆2","jp":"今日寒いね！\nあったかくなるよう、執務室の電子機器に負荷をかけておいたよ！","fan":"今天好冷啊！\n为了让办公室暖和一点，我给电子设备加了点负荷！","off":"老师，今天真的很冷对吧？所以我把办公室的电子设备全都打开来取暖了，让它们超负荷运转！"},{"label":"大厅1","jp":"今天好冷啊！\n为了让办公室暖和一点，我给电子设备加了点负荷！","fan":"涂鸦的时候也经常爬高楼，\n但和登山的感觉还是不一样呢。\n果然没有Wi-Fi的话，能量就会耗尽...","off":"涂鸦的时候也经常登上高楼，但感觉登山又是另外一回事。没了WIFI，还是会有种一下子失去能量的感觉……"},{"label":"大厅2","jp":"秋だけじゃなくて、他の季節にも紅葉が残ってたら山の景色も鮮やかなのになぁ……\nまぁでも……紅葉は長く続かないからこそ価値があるんだよね？","fan":"如果不仅仅是秋天，其他季节也有红叶的话，\n山上的景色会更鲜艳吧...\n嘛...不过红叶正是因为不会长久才有价值吧？","off":"如果不光是秋天，其他三个季节也有枫叶就好了，这样山上的风景肯定会更多姿多彩的……可是正因为枫叶不会在树上停留太久，才更有观赏价值吧？"},{"label":"大厅3","jp":"この三つ編み？うん、あたしが編んだんだ。\nお団子ってちょっと時間かかっちゃうから\n休みの日にはやりたくないんだよね……。","fan":"这个辫子？嗯，是我编的。\n团子有点费时间，\n所以休息日不太想做...","off":"是说这条辫子吗？嗯，是我自己编的。平时的丸子头扎起来很花时间，休息日就懒得扎了……"},{"label":"大厅4","jp":"チヒロ先輩って、なんであんなに朝早く来れるんだろう？\nまさか……0時前に寝てるとか！？","fan":"千寻前辈为什么能那么早来呢？\n难道...她晚上0点前就睡觉了吗！？","off":"千寻前辈为什么能每天都那么早起床来活动室呢？难道……她12点前就睡了吗？！"},{"label":"大厅5","jp":"グラフィティの材料はね、ペンキ以外にも色々あるんだ。\nこの前、あたしが洞窟で壁画を描いたようにね！\nペンキは消すのも大変だし……\nこれからはリサイクルできる天然の材料を探そうかなぁ。","fan":"涂鸦的材料除了油漆还有很多哦。\n就像我之前在洞穴里画的壁画一样！\n油漆清理起来也很麻烦...\n以后还是找一些可以回收的天然材料吧。","off":"涂鸦的材料除了油漆，还有很多种可以用。就像上次画洞穴壁画一样！毕竟油漆很难擦除……今后，我得多找些可回收的天然材料。"},{"label":"回忆大厅1","jp":"うっ、うぐぐ……。\nまた同じとこで死んじゃった……。","fan":"呜，咕咕咕...\n又在同一个地方死掉了...","off":"呜呜，呜呜呜……又死在同一个地方了……"},{"label":"回忆大厅2","jp":"というかパッドの操作ムズ……。\nあとはもうラスボスだけなんだけど……\n同じとこでミスっちゃうんだよね……","fan":"话说手柄操作好难...\n明明只剩下最终BOSS了...\n但总是在同一个地方失误...","off":"嗯，没想到手柄还挺难操作的……本来打完最后一个BOSS就可以了，结果总是重复同样的错误……"},{"label":"回忆大厅3","jp":"普段と違うから難易度上がってるし……だからなのかな。\n妙に競争心が湧いちゃって。他に娯楽もないしさー……\n逆にゲームに集中しちゃうかんじ。\nもしかして、これがキャンプの醍醐味ってやつなのかな？","fan":"因为和平常不一样，难度也提高了...\n所以才会这样吧。\n莫名涌起了竞争心。\n毕竟也没有其他娱乐...\n反而更专注于游戏了。\n莫非这就是露营的乐趣吗？","off":"可是因为现在很难操作，难度也跟着上升了……害我的好胜心莫名燃起来了。而且周围也没有其他可以消遣的东西，所以感觉精力也更加集中在游戏上了。难道，这就是传说中露营的乐趣所在吗？"},{"label":"回忆大厅4","jp":"えっ！？もうこんな時間！？\nどうしよう……","fan":"诶！？已经这个时间了！？\n怎么办...","off":"啊，时间这么快就到了？这下麻烦了……"},{"label":"回忆大厅5","jp":"先生ぇ～\nあともう一回だけ……\n本当にこれで最後にするから……\nもうちょっとだけ待って！","fan":"老师～再来一次...\n真的这是最后一次了...\n再等我一下！","off":"老师， 这次真的，真的是最后一次了……再等我一下下！"},{"label":"咖啡馆1","jp":"今日は外に出たくないなぁ……","fan":"今天不想出门...","off":"今天真不想出门……"},{"label":"咖啡馆2","jp":"あ、最高のインスピレーションが浮かんだ！","fan":"啊，突然有了绝妙的灵感！","off":"啊，我有了个很棒的灵感！"},{"label":"咖啡馆3","jp":"前、チヒロ先輩に借りた簡易ベッド、使ってみようかな？","fan":"之前从千寻前辈那里借的简易床，要不要试试看呢？","off":"把之前从千寻前辈那借来的一次性床具铺到这里怎么样？"},{"label":"咖啡馆4","jp":"なに？この変な名前のWi-Fi……","fan":"这是什么？这个奇怪名字的Wi-Fi...","off":"这个名字怪怪的WIFI是怎么回事……？"},{"label":"咖啡馆5","jp":"（ここにBOOM、インストールできるかな？……やってみよ！）","fan":"（这里能来个BOOM吗？...试试看吧！）","off":"（这里也能安装BOOM吗？……干脆来挑战一下吧！）"}],"好感度":[{"label":"好感度1","jp":"いつもありがど、先生。これは本心だよ。","fan":"一直以来谢谢了，老师。这是真心话哦。","off":"一直以来都很谢谢你，老师。这是我的真心话！"},{"label":"好感度2","jp":"山に登のは大変だけど、でも先生が一緒なら、まあいいがな！","fan":"登山虽然很累，但如果是和老师一起的话，嘛，也行吧！","off":"爬山虽然很辛苦……但如果有老师陪着，就不觉得辛苦啦。"},{"label":"好感度3","jp":"先生、一緒に散歩てもどう？べ、別に他意はないよ！天気も良いし…","fan":"老师，要不要一起散步？才、才没有别的意思呢！只是天气不错而已…","off":"老师，要不要一起去散步？也不是因为突然转了性子什么的……只是觉得天气不错？"},{"label":"好感度4","jp":"あれ、おかしいな。さっき先生の顔、すごくキラキラして見えたのに。","fan":"啊咧？好奇怪。刚才老师的脸看起来闪闪发光的…","off":"（咦？好奇怪……刚才老师的样子看起来好耀眼……）"}],"战斗":[{"label":"编入队伍1","jp":"もー！キャンプだけで手一杯なんだけど！？","fan":"真是的！明明光是出来露营就够让我手忙脚乱的了！？","off":"啊——要出门吗？"},{"label":"编入队伍2","jp":"え？出かけないとなの？","fan":"欸？不用我上吗？","off":"哎呀？光是露营就忙的不可开交啦！"},{"label":"拎起","jp":"あ、これいいね！このまま連れてってよ～","fan":"啊~这个真不错！就这样带我一起去嘛～","off":"啊~这样~登山也不用害怕了！"},{"label":"普通技能","jp":"私の芸術を見てでよね","fan":"请看看我的艺术吧！","off":"好好领略一下我的艺术！"},{"label":"EX动画1","jp":"電波どこ？あった！え！ちょーあああ","fan":"信号在哪里？找到了！诶？！啊啊啊——","off":"总算……捕捉到信号啦！……呃，呃呃呃……啊呜？！"},{"label":"EX动画2","jp":"繋がれ繋がれ！よし！ああ","fan":"连接吧连接吧！好！啊——","off":"快连上，快连上……有了！哇，哇啊啊！"},{"label":"EX动画3","jp":"お願い繋がで！あええ","fan":"拜托了快连上！啊？诶诶？","off":"拜托，拜托……哇！诶，诶诶……？！"},{"label":"EX技能1","jp":"うわ、ミスだ。まあ、いいが。","fan":"哇，失误了。算了，无所谓。","off":"呜哇，搞错了……！幸好没伤到。"},{"label":"EX技能2","jp":"うぐぐぐぐ、げー、今の見た？","fan":"唔咕咕咕咕，呃——，刚才看到了吗？","off":"唔咕咕…………嘿嘿，看到了吗？"},{"label":"EX技能3","jp":"うえああ、ちゃ、着地成功！","fan":"呜哇啊啊，啊，着地成功！","off":"呃呀啊啊哈？！成，成功落地……！"}],"成长":[{"label":"升级1","jp":"キャンプにも慣れてきた気はするけど…これで良いことなのがなぁ…","fan":"虽然感觉对露营也习惯了…但这样真的好吗…","off":"感觉露营的本领变强了…………这算是好事吗？"},{"label":"升级2","jp":"まだ道は遠いけど、どこに向かえは分かったきがする。","fan":"虽然路还很长，但好像知道该往哪里走了。","off":"虽然要走的路还很长，但感觉找到点方向了！"},{"label":"升级3","jp":"うん、これならもっと頑張るぞ。","fan":"嗯，这样的话我会更努力的。","off":"嗯，这样就能再加把劲儿了！"},{"label":"升级4","jp":"うおお、インスピレーションが湧いてきた。","fan":"哦哦，灵感涌出来了！","off":"噢噢，我有灵感了！"},{"label":"获得专武","jp":"このマシンガン、イイ感じに改造したけど……\n登山にはちょっと重すぎるんだよね……\nそろそろ軽量化しなきゃ。","fan":"这把机枪我改造得不错...\n但带去登山还是有点重...\n得想办法轻量化了。","off":"这把机枪虽然改造得很厉害，但带上登山的话也太重了……是不是该轻装上阵比较好？"}],"事件":[{"label":"学生生日","jp":"わぁ……もうあたしの誕生日か。\nふふっ、プレゼントはいいよ。\n先生には、いつもお世話になってるからね。","fan":"哇...已经是我的生日了啊。\n哦呵呵，礼物就不用了。\n因为老师一直都很照顾我嘛。","off":"哇……不知不觉我的生日又到了。嘿嘿，礼物就算啦。毕竟一直受老师各种照顾嘛。"},{"label":"老师生日","jp":"わあ、先生！お誕生日おめでとう！\nお祝いとして、シャーレの外壁に先生の肖像画を大きく描いたんだけど――\nあはは、冗談冗談。\nなにか欲しいものあったら言ってね、なんでもいいよ！","fan":"哇，老师！生日快乐！\n作为庆祝，我在夏莱的外墙上画了你的肖像画——\n啊哈哈，开玩笑的开玩笑的。\n如果有什么想要的就说吧，什么都行！","off":"哇，老师！生日快乐！我在沙勒大楼的外墙上画了老师的巨幅肖像画，当做礼物送给老师——啊哈哈，开玩笑，开玩笑的。别那么吃惊好嘛。不过如果有想要的礼物尽管开口，什么都行！"},{"label":"万圣节","jp":"やっほ！ハロウィンだよ、先生。\n芸術魂を思いっきり燃やせる日でもあるんだ。\nどう？あたしと一緒に燃やしにいかない？","fan":"呀吼~！今天是万圣节哦，老师。\n这也是可以尽情燃烧艺术魂的日子。\n怎么样？要不要和我一起去燃烧一下？","off":"呀吼！万圣节到啦，老师。今天可是能尽情燃烧想象力和艺术之魂的日子。怎么样？要不要跟我一起燃烧一下艺术之魂？"},{"label":"新年","jp":"先生、明けましておめでとう。\n今日夕方、時間があえば光の海岸で会おうね！\nあ……えっと、光の海岸はゲームの地名だよ！","fan":"老师，新年快乐。\n今天傍晚如果有时间的话，我们在光之海岸见吧！\n啊...那个，光之海岸是游戏里的地名哦！","off":"老师，新年快乐。今晚有空的话，我们光之海岸见吧！嗯？那是在哪儿……？啊，我忘了说是游戏里的了。"},{"label":"圣诞节","jp":"メリークリスマス、先生！\n今日は寒いから部屋の中でクリスマスリースをたくさん作ろう。\nシャーレを覆っちゃうくらい、いっぱい！","fan":"圣诞快乐，老师！\n今天很冷，所以在房间里做很多圣诞花环吧。\n多到能把夏莱都盖住！","off":"圣诞快乐，老师！今天好冷啊，我们一起在屋里做圣诞花环吧！要做好多好多，多到能挂满整个沙勒！"},{"label":"春节","jp":"","fan":"老师！新年到了！听说今天AR游戏里会刷新叫“年”的怪兽，是限时的哦！我们一起去抓吧！这次可不能忘了给手机充电！","off":"老师！新年到了！听说今天AR游戏里会刷新叫“年”的怪兽，是限时的哦！我们一起去抓吧！这次可不能忘了给手机充电！"},{"label":"中秋","jp":"","fan":"……自从开始露营，才知道在远离喧嚣的自然中，能看到这么美的满月啊。感觉我的灵感都蠢蠢欲动了，得马上画下来！","off":"……自从开始露营，才知道在远离喧嚣的自然中，能看到这么美的满月啊。感觉我的灵感都蠢蠢欲动了，得马上画下来！"}],"活动":[{"label":"活动登陆1","jp":"暇だなぁ……\n携帯ゲーム機でも持ってくれば良かった……","fan":"好无聊啊...\n要是带了掌机就好了...","off":"好无聊……早知道就带个游戏机来了……"},{"label":"活动登陆2","jp":"電磁波を感じてみたいかも……","fan":"有点想感受一下信号...","off":"好想感受到电波……"},{"label":"活动大厅1","jp":"うぅ……年末特番を見れないなんて……。チヒロ先輩ひどい！","fan":"呜...看不到年末特别节目...\n千寻前辈太过分了！","off":"呜呜……年底有好多有趣的节目，可是却没办法看直播……千寻前辈也太过分了！"},{"label":"活动大厅2","jp":"あの雲……サーバーコンピューターに似てるかも。","fan":"那朵云...有点像服务器计算机。","off":"啊，那片云……总觉得和服务器的电脑长得有点像呢。"},{"label":"活动大厅3","jp":"うぅ、キーボード打ちたい～\n暇すぎるよぉ～！\nねぇ先生、なにか手を使うおもちゃとか持ってない？\n輪ゴムでもいいから！","fan":"呜，好想打字啊～\n太无聊了～！\n呐，老师，有没有什么能用手玩的玩具？\n橡皮筋也行！","off":"呜呜，双手好久没离开过键盘了，现在感觉好闲啊，受不了了——哎老师，你有没有什么可以用手玩的玩具之类？哪怕是根橡皮筋也好啊！"},{"label":"活动大厅4","jp":"先生は楽しんでるみたいだね、\nキャンプ。\nじゃあ、あたしもちょっとは楽しんでみよっかな！","fan":"老师好像很享受露营呢。\n那我也稍微享受一下吧！","off":"原来老师很享受露营啊。那，我也努力打起精神吧！"},{"label":"活动事件1","jp":"自然のキャンバスに何か描いてみようかな","fan":"要不要在自然的画布上画点什么呢。","off":"用大自然当作画布，画点什么吧。"},{"label":"活动事件2","jp":"（あ、壁画……消すの忘れてた）\n（ま、別に何も起こらないよね？）","fan":"（啊，壁画...忘记擦了）\n（嘛，应该不会有什么问题吧？）","off":"（啊，那幅壁画……我忘记擦掉了。算了，不会有什么事的！）"},{"label":"活动结束","jp":"思ってたよりは悪くなかったかも？\n夕飯の水炊きは美味しかったし……。\nスマホ持ってきていいなら、また来たいかも。\nべ、別にキャンプが好きになったわけじゃないよ…！","fan":"比想象中要好一些吧？\n晚饭的水煮菜也很好吃...\n如果能带手机的话，还想再来一次。\n才、才不是喜欢上露营了呢...！","off":"嗯，真是次不错的经历呢，比想象中好多了。尤其是晚上吃的水煮锅真的超棒的……带上手机的话，再来一次也可以。当，当然，不是喜欢上露营了的意思……！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/191981/2026/4/6/931354.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/6/8/73655693mrbyif1b.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images