ages/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルー！アー、カイ、ブッ！","fan":"碧~蓝~档~案~","off":""},{"label":"卡池抽取","jp":"ボク、ワイルドハント芸術学院の薄葉リツ！よろしくねっ！","fan":"我是狂猎艺术学院的薄叶律！多多关照咯！","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"やっほ～先生、何してた～？","fan":"呀吼～老师你在干什么～？","off":""},{"label":"登陆2","jp":"いい天気だね！遊びにいこうよ先生！","fan":"今天是个好天气！我们一起出去玩吧！","off":""},{"label":"大厅1","jp":"部活？大好きだよ！みんなを幸せにできるもん！","fan":"社团活动？我最喜欢了！因为可以让大家感到幸福！","off":""},{"label":"大厅2","jp":"岩や粘土を見るとさ、中に入ってる子を形にしてあげなきゃ！ってなるんだ。先生はどう？","fan":"当看到岩石和粘土的时候就在想应该把里面的小人给做出来！嗯这种感觉。老师怎么想的？","off":""},{"label":"大厅3","jp":"見ただけじゃ大きさわかんないなぁ……先生、ギューってしてもいい？","fan":"只是光看着还是没办法理解它的大小啊....老师你能抱着它让我看看吗？","off":""},{"label":"大厅4","jp":"シャーレって居心地いいね～大理石に触ってるときみたい！","fan":"在夏莱的时候心情舒畅～就像在抚摸大理石的时候一样！","off":""},{"label":"大厅5","jp":"せ～んせ♪仕事はそのへんにして、ボクと遊んでよ～！","fan":"老～师，工作上的事情先放一边快来陪我玩嘛～！","off":""},{"label":"回忆大厅1","jp":"あー……\nすずしー……","fan":"啊一真凉快","off":""},{"label":"回忆大厅2","jp":"ここ、すごくない？\nむかーしからある地下貯水槽らしいんだけど……","fan":"这里，很厉害吧？好像是很久之前就有的某个蓄水池…","off":""},{"label":"回忆大厅3","jp":"おっきい穴を掘って、いっぱい柱を立てて……\n一つ一つに彫刻されてるんだ……","fan":"挖掘了巨大的洞穴，然后立起一根根柱子..一个一个的雕刻成现在的样子","off":""},{"label":"回忆大厅4","jp":"……きれいでしょ？\nどうしても先生に見せたかったんだ。","fan":"...很漂亮吧？无论如何也想让老师看看这里","off":""},{"label":"回忆大厅5","jp":"ね、こっちきて。\nボクと同じ景色、見ようよ。","fan":"呐，到这里来。老师来和我看同样的风景吧","off":""},{"label":"咖啡馆1","jp":"あのへんに作品置けるかな～？","fan":"那里能放我的作品吧～？","off":""},{"label":"咖啡馆2","jp":"ここ、もうちょっと風通しよくならないかな～？あ！……あそこ、穴あけられるかも！","fan":"这里，感觉氛围不是很好～？啊！…那里，好像还可以再开一个洞！","off":""},{"label":"咖啡馆3","jp":"コーヒーのいい匂い……表現できないかなぁ。","fan":"咖啡的醇香..难以言表啊。","off":""},{"label":"咖啡馆4","jp":"うーん、次の輸入品は～っと……","fan":"嗯，下一次带进去的东西～是什么呢","off":""},{"label":"咖啡馆5","jp":"ここのケーキを持って帰ったら……きっと、学院のみんなも喜んでくれるよね！","fan":"如果把这里的蛋糕带回学院的话...学院的大家一定会很高兴吧！","off":""}],"好感度":[{"label":"好感度1","jp":"ねね、先生の顔の彫像、作ってもいい？","fan":"呐呐，我能给老师做一个面部雕像吗？","off":""},{"label":"好感度2","jp":"……これが先生の肌の感触。うん！再現できるかも！","fan":"……这就是老师脸的触感。嗯！感觉可以做出来!","off":""},{"label":"好感度3","jp":"最近、なんか彫るぞ！ってとき、先生の顔しか浮かんでこないんだよ～……なんでかなぁ？","fan":"最近，想着要雕刻了！的时候，脑海里只能浮现出老师的脸～……这是为什么呢？","off":""},{"label":"好感度4","jp":"なんかさ？先生を見てると……胸がギュ～ってなるんだよね。","fan":"就是那个，一看到老师的时候……胸口就会一紧是为什么呢。","off":""}],"战斗":[{"label":"编入队伍1","jp":"なになに～？なんかやるの～？","fan":"是什么～？我能做些什么吗～？","off":""},{"label":"编入队伍2","jp":"おもしろそう！ボクも混ぜてよ！","fan":"好有意思的样子！让我也加入进去！","off":""},{"label":"拎起","jp":"ふんふふ～ん♪……あっ、先生だ！","fan":"哼哼哼哼嗯～……啊，是老师！","off":""},{"label":"普通技能","jp":"えいやっ！","fan":"诶呀！","off":""},{"label":"EX动画1","jp":"ふふっ、ちょうどいいのがあるんだ～","fan":"嘿嘿，正好有好东西～","off":""},{"label":"EX动画2","jp":"すっごいの、持ってきたよ！","fan":"我带来了很厉害的东西哦！","off":""},{"label":"EX动画3","jp":"たしかこの辺に……！","fan":"我记得在这附近..","off":""},{"label":"EX技能1","jp":"はい、これ食べて！張り切ってこ～！","fan":"来，吃这个！要元气满满哦～！","off":""},{"label":"EX技能2","jp":"元気出して！えいえいおー！","fan":"打起精神！加油哦!","off":""},{"label":"EX技能3","jp":"ほら、まだいけるよね！","fan":"看吧，还能继续吧!","off":""}],"成长":[{"label":"升级1","jp":"えっ！ボクにくれるの！？ホントに～？","fan":"诶，给我的吗！真的～？","off":""},{"label":"升级2","jp":"これで、どんなおっきい岩でも運べるね！","fan":"这样一来，不论是多大的石头都能运走了！","off":""},{"label":"升级3","jp":"ありがと先生！ボク、もっと頑張るね！","fan":"谢谢你老师！我，会更加努力的哦！","off":""},{"label":"升级4","jp":"みてみて！こ～んなに強くなったんだよ～！","fan":"看快看！我变的这么～强了哦～！","off":""},{"label":"获得专武","jp":"わぁ！これ、ずーっと欲しかったんだ！ありがとね、先生！うれしい！","fan":"哇啊！这个，我一直都很想要呢！谢谢你老师！我很高兴!","off":""}],"事件":[{"label":"学生生日","jp":"ねね！知ってた？今日はボクの誕生日！今日はず～っと、先生と遊びたいな～！","fan":"呐呐！知道吗？今天是我的生日哦！我想要和老师今天一天一直在一起玩~！","off":""},{"label":"老师生日","jp":"先生、生まれてきてくれてありがとね！ボク、先生がいてくれて、ホント幸せなんだ！","fan":"老师，您能降生于世真是太好了！我呢，只要老师能在这里就觉得很幸福了！","off":""},{"label":"万圣节","jp":"先生！早く早く～！今日はキャンディーとチョコの争奪戦だよ！","fan":"老师！快点快点啦~！今天是糖果和巧克力的争夺战哟！","off":""},{"label":"新年","jp":"ハッピーニューイヤー先生！鐘叩くやつ見に行こ！！……え？もう終わってるの？","fan":"新年快乐老师！我们一起去看新年敲钟吧！！诶？已经结束了吗？","off":""},{"label":"圣诞节","jp":"先生！雪！！お外が真っ白だよ！せっかくだし、一緒に雪で彫刻しない？","fan":"老师！是雪啊！！外面一片纯白哦！机会难得，要不要一起做冰雕？","off":""}],"活动":[{"label":"活动登陆1","jp":"先生！こっちこっち～！","fan":"老师！这里这里哦～！","off":""},{"label":"活动登陆2","jp":"なんだか話がごちゃごちゃしちゃってるね……ま、やるだけやってみるよ！","fan":"总感觉要求乱七八糟的呢...嘛，也只有试一试了！","off":""},{"label":"活动大厅1","jp":"ん、先生？ボクの顔、粉でもついてる？","fan":"嗯，老师？我的脸上，有细粉粘在上面？","off":""},{"label":"活动大厅2","jp":"あは！あははっ！も～！そんなにつっつくなら……お返しだ～っ！","fan":"阿哈，啊哈哈哈！真是的~你这样戳我的话...看我的回击～！","off":""},{"label":"活动大厅3","jp":"み、みんな、どんよりしないで～","fan":"大，大家，不要那样无精打采嘛~","off":""},{"label":"活动大厅4","jp":"どんなピンチでも大丈夫！特殊交易部は……いつだって、抜け道を見つけ出すんだよ！","fan":"不论是什么样的危机都没关系！特殊交易部就是……不论如何，我们都会找出出路的！","off":""},{"label":"活动事件1","jp":"こういう依頼は初めてだけど……ミヨちゃんの作戦なら、きっと大丈夫！","fan":"虽然这种委托还是第一次的说...但是如果是美代的作战计划，那一定能行的说！","off":""},{"label":"活动事件2","jp":"今回の依頼……割と面白いかも？","fan":"这次的委托...好像还挺有意思的？","off":""},{"label":"活动结束","jp":"ひゃあ～終わった終わった～……あれ？みんなヘロヘロ？","fan":"呀～结束了结束了….嗯？大家好像都很不舍?","off":""},{"label":"活动任务1","jp":"うん？どしたの？","fan":"嗯！怎么了？","off":""},{"label":"活动任务2","jp":"大変だったけど、楽しかった？えへへ、ボクと一緒だねっ！","fan":"虽然和麻烦，但是很开心？诶嘿嘿，我也是一样！","off":""},{"label":"活动任务每日结束","jp":"今日はもう扉閉めちゃったんだ。また明日ね。","fan":"今天要关门了哦！明天再见咯。","off":""},{"label":"活动任务登录1","jp":"楽しいことがいっぱいだよ～！へへ、期待しててね先生！","fan":"好多有意思的事情呢~！嘿嘿，敬请期待哦老师！","off":""},{"label":"活动任务登陆2","jp":"難しいことはあっても、不可能はな～い！","fan":"即使有困难，也没有什么是不可能的事情！","off":""},{"label":"活动任务获取1","jp":"すっご～い！先生、なんでもできるんだね～！","fan":"好厉害啊！老师，就好像什么都能办到一样～！","off":""},{"label":"活动任务获取2","jp":"ご褒美は忘れちゃダメだよ～","fan":"可不能忘记赞美我哦~","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/191981/2025/9/8/633746.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/191981/2026/5/6/1780751536898_1780063406000_a15vjkez42_u7881q7vlu.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43637/2025/8/25/463641.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/191981/2026/5/6/1780751558703_1780063408000_pqs9co90vr_6qoblah7cg.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.c