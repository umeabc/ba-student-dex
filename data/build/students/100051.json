iki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/280756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 亚子 （礼服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/3/951866.png","url":"https://www.gamekee.com/ba/611610.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive"},{"label":"卡池抽取","jp":"ゲヘナ学園風紀委員会所属の行政官、天雨アコ。今後は業務提携とのことで、どうぞよろしくお願いいたしますね。","fan":"格黑娜学园风纪委员会所属的行政官天雨亚子。今后我们会有业务方面的合作，请多多关照。","off":"我是歌赫娜风纪委员会的行政官天雨亚子，今后的业务合作还请多多关照"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あら、おはようございます先生。ではお仕事を始めましょうか？ 終わるまで、帰れるとは思わないでくださいね？","fan":"呀，早上好，老师。那么开始请工作吧？在把这些工作做完之前，请不要回去哦？","off":"啊，老师，您来了，那就开始办公吧\n完成所有工作前可不许回去哦~"},{"label":"登陆2","jp":"あら、先生。予定より早かったですね？それについては褒めてあげましょう。","fan":"呀，老师。比计划中更快完成呢，那我就表扬你一下吧。","off":"老师，您好啊~\n今天您来的比预定时间还早呢~这一点倒是值得表扬"},{"label":"大厅1","jp":"先生？手が止まっていませんか？ 残業になると私の帰りも遅くなって、私が困るのですが。","fan":"老师？工作没有停下来吧？要是加班导致我回去很晚的话，我很为难呢。","off":"老师，您是在偷懒吗？\n要是因为加班导致我晚归的话，我会很为难哦"},{"label":"大厅2","jp":"…進捗が良くないですね。 はあ、仕方ありません。 私も手伝います。","fan":"……进展不是很顺利呢。啊，真是没办法。我来帮忙吧。","off":"进展不顺啊……\n唉，没办法了，我也会帮忙的"},{"label":"大厅3","jp":"今からはお食事はもちろん、お手洗いなども含めて全部私が管理しますから、言った通りにしてください。 まさか、不満なんて無いですよね？","fan":"从现在开始，吃饭自不必说，包括去洗手间等事情都由我来管理，请按照我说的做。老师应该不会有不满什么的吧？","off":"从现在开始，吃饭的时间自不必说，\n去卫生间的时间也都由我来管理，一切都请按我说的做\n哎呀？您该不会有什么不满吧？"},{"label":"大厅4","jp":"なんだ、やればできるじゃないですか？って先生、まさかとは思いますが… 先ほどまではサボっていたということですか…！？","fan":"什么呀，认真去做的话不是很简单的吗？话说老师，我想应该不会吧……难道说刚才在摸鱼吗…！？","off":"啊呀，认真去做的话不是做的很好吗？\n等等，老师，别告诉我之前您是在偷懒！"},{"label":"大厅5","jp":"お疲れの時は言ってくださいね。それをケアするのもまた、私の役目ですので。","fan":"感到疲累的时候请和我说哦。毕竟照顾老师，也是我的职责。","off":"如果工作累了请随时告诉我，\n毕竟照顾老师也是我身为秘书的职责"},{"label":"回忆大厅1","jp":"うぅっ、こんな格好……っ！","fan":"呜，这种样子......！","off":"竟然会变成这幅模样——"},{"label":"回忆大厅2","jp":"この屈辱、絶対に忘れませんからね……！","fan":"这份屈辱，绝对不会忘记的……！","off":"这份屈辱，我是绝对不会忘的！"},{"label":"回忆大厅3","jp":"えっ！？ま、待ってください！これ以上は約束と違うじゃないですか！？お、お散歩！？正気ですか！？このまま！？","fan":"啊！？啊，请等一下！这和约定的不一样吧！？\n散、散步！？你认真的吗！？就这样！？","off":"等等，这跟说好的不一样吧\n什么？散步？认真的吗？就这么出去？"},{"label":"回忆大厅4","jp":"そ、それは流石に…。ご、ごめんなさい…少し調子に乗り過ぎました…","fan":"这、这真的是太......。对不起……有点得意忘形了……","off":"那也太……\n对不起……是我太得意忘形了"},{"label":"回忆大厅5","jp":"あ、あの……いつまでこうしていれば良いんですか……？","fan":"那，那个……一直保持这样就可以了吗……？","off":"我……我说，要这样子呆到什么时候啊"},{"label":"咖啡馆1","jp":"なるほど……まあ、悪くない設備ですね。","fan":"原来如此……嘛，设备还不错呢。","off":"嗯……这里的设备还不错"},{"label":"咖啡馆2","jp":"次のシャーレとの提携業務は…","fan":"下一个和夏莱合作的业务是...","off":"下次和沙勒的合作……"},{"label":"咖啡馆3","jp":"委員長…きちんとお食事を取られてるでしょうか…？","fan":"委员长她…有好好地吃饭吗…？","off":"会长有没有好好吃饭呢……"},{"label":"咖啡馆4","jp":"なんだかフワフワとした雰囲気ですね…まあ、どうでも良いのですが…","fan":"总觉得气氛很舒服呢……嘛，怎么样都好啦……","off":"大家看起来全都一副悠闲的样子嘛……\n倒也无所谓"},{"label":"咖啡馆5","jp":"いざという時には…あ、いえ、それでは委員長が困ってしまいますね。やめておきましょう。","fan":"在紧急情况下…啊，不，那样的话会让委员长为难的。还是算了吧。","off":"但紧急情况下……\n不，那样会长就该为难了，还是算了吧"}],"好感度":[{"label":"好感度1","jp":"あのう...ちょっと距離が近くないですか？い、いえ、意識しているとかではなく。","fan":"那个...不觉得距离稍微有点近了吗？不、不是说我感觉上的距离。","off":"距离是不是有点太近了……不……我不介意"},{"label":"好感度2","jp":"業務外での関係でもお望みなんですか。そういうのは早いですよ、まだ…","fan":"您希望拥有业务合作以外的关系吗。那样有些太早，还…","off":"您期待跟我有工作以外的关系吗？\n我觉得有点为时过早……还不是时候呢……"},{"label":"好感度3","jp":"これがどういう感情なのか…もう少し検討する時間をください。本当に…少しでいいので。","fan":"这是什么样的感情呢……请再给我一点判断的时间。真的……一点就好了。","off":"这种感情到底是什么？\n请给我一点时间考虑一下……真的，只要一点时间就好"},{"label":"好感度4","jp":"ああ…えっ？認めますよ。先生のことが嫌いだと思っていません。 で？それで？だたらなんなんですか？","fan":"啊…诶？我认可老师你了哦。没有觉得老师讨厌。 然后？然后呢？然后怎么了？","off":"哈……好吧，我承认，我不讨厌老师\n——所以呢？那又怎样？"}],"战斗":[{"label":"编入队伍1","jp":"お仕事ですね。はい、お任せください。","fan":"是工作呢。好的，请交给我吧。","off":"有工作是吗？好的，请交给我吧"},{"label":"编入队伍2","jp":"シャーレとしての業務上の指示ということでしょうか。でしたら仕方がありません。","fan":"是作为夏莱的业务上的指示吗。那就没办法了。","off":"您这是……以沙勒的名义分配任务吗？\n那就没办法了"},{"label":"拎起","jp":"本当は穏便に済ませたかったのですが……やるしか無さそうですね。","fan":"本来想和平解决的......看来没办法了呢。","off":"现在看来，也只能动手了吧？"},{"label":"普通技能","jp":"風紀委員会からの支給品です。","fan":"风纪委员会送来的补给。","off":"风纪委员会的补给来了！"},{"label":"EX动画1","jp":"判明しているデータをお送りします。","fan":"向您发送明确的数据。","off":"向您发送已解析的战斗数据"},{"label":"EX动画2","jp":"データは、これと、これと…","fan":"数据是，把这个和这个……","off":"数据是这个……还有这个！"},{"label":"EX动画3","jp":"風紀委員の情報収集能力、お見せします。","fan":"让你见识一下风纪委员的情报收集能力。","off":"让您见识一下风纪委员的情报收集能力吧"},{"label":"EX技能1","jp":"分析完了、弱点は把握済です","fan":"分析完毕，弱点已经掌握。","off":"分析完毕，已掌握敌方弱点"},{"label":"EX技能2","jp":"後はお任せしますね。","fan":"之后就交给我吧。","off":"之后就交给您了"},{"label":"EX技能3","jp":"ふふっ、準備は万全ですから。","fan":"呵呵，因为准备万全了。","off":"万事俱备！"}],"成长":[{"label":"升级1","jp":"先生からのご支援、ありがたく頂戴しますね。","fan":"感谢老师的帮助。","off":"感谢老师的支援，我就收下了"},{"label":"升级2","jp":"成長…していますね。自分でもその、ビックリです。","fan":"正在成长呢…我自己也吓了一跳。","off":"我正在成长？\n就连我自己都有点惊讶呢"},{"label":"升级3","jp":"こういうことは気軽にすることではないでしょうに。何が狙いですか？何かして欲しいことでも？","fan":"明明这种事情很费精力的。给我这样的好处，有什么意图？想要我做什么来回报？","off":"这种事……不是随随便便就能做到的吧？\n您的目的是什么？或者说，您对我有什么期待呢？"},{"label":"升级4","jp":"その…ありがとうございます、先生。 まあ…何ですかその顔は。私だって何かをしてもらえば、感謝ぐらいします。まったく。","fan":"那个…谢谢老师。 什么嘛……这是什么表情。如果为我做了点什么，我至少也会表达感谢的。真是的。","off":"啊？谢谢老师……\n您那是什么表情？受到帮助我当然也会好好道谢！真是的……"},{"label":"获得专武","jp":"まったく、こういう大胆なアプローチを平然と……まあいいでしょう。あなたの目の前にいる生徒がどれだけ優秀なのか、骨の髄まで教えてあげます。","fan":"真是的，这么大胆的接近，还很坦然的样子……这样也好。就让我告诉你你眼前的学生到底有多优秀，让你深入骨髓地感受到吧。","off":"真是的……这么大胆的接近我……\n好吧，既然如此，那我会让老师知道我究竟有多么优秀"}],"事件":[{"label":"学生生日","jp":"私の、誕生日…？ …先生、今はそれより大事なお仕事がたくさん…え？私の誕生日より大事な仕事なんてない…？ またそういう…まあ、一応感謝はしておきます。","fan":"我的生日…老师，现在有很多比这更重要的工作…诶？没有工作比我生日更重要…？又说这样的话……嘛，总之先谢谢你了。","off":"我的生日？老师，还有比这更重要的事呢……\n您说没什么比我的生日更重要？\n真是的，又说这种话……\n总之谢谢了"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。ふふっ、せっかくならと先週から完璧なスケジュールを立てておきました。 寸分の隙も無い、完璧な一日にしてあげましょう。","fan":"生日快乐，老师。呵呵，难得从上周开始就制定了完美的日程。没有一点空隙，就让你度过完美的一天吧。","off":"老师，生日快乐\n机会难得，我可是提前一周制定好了这份完美的日程\n保证让老师每一分钟都不浪费，度过完美的一天！"},{"label":"万圣节","jp":"ハロウィーン、お菓子を交換し合う日ですね。 まあ、お仕事に糖分摂取は必要ですし…先生も、いかがですか？","fan":"万圣节，是互相交换糖果的日子呢。嘛，为了工作也需要摄取糖分…老师也来点怎么样？","off":"万圣节，是互送糖果的节日吗？\n工作也需要糖分，老师，您也来些糖果吧！"},{"label":"新年","jp":"明けましておめでとうございます、先生。 新年だからといって、仕事があることに変わりはありませんが。まあ、少しぐらいお手伝いしますよ。","fan":"新年快乐，老师。虽然说是新年，但是还是要和往常一样工作哦。不过，我可以稍微帮一下老师哦。","off":"新年快乐，老师\n当然了，虽说是新年，工作还是要做的\n不过，我会在一旁协助老师哦。"},{"label":"圣诞节","jp":"さあ先生、聖夜を共に過ごしましょうか？ ……この大量の仕事を片付けないことには、帰るに帰れませんからね。","fan":"那么，老师，我们一起度过平安夜吧？……如果不把这么多的工作收拾完的话，想回也回不去呢。","off":"老师，您要和我一起度过平安夜吧？\n如果不把这么多工作处理完的话，想回都回不去呢"},{"label":"春节","jp":"","fan":"老师，要处理完所有工作后才能开始您的新春假期哦\n别担心，我会协助您的","off":"老师，要处理完所有工作后才能开始您的新春假期哦\n别担心，我会协助您的"},{"label":"中秋","jp":"","fan":"您的请假申请我收到了，但您并没有提前一周向我申请呢\n算了，毕竟是团圆的日子呢，这次就例外吧","off":"您的请假申请我收到了，但您并没有提前一周向我申请呢\n算了，毕竟是团圆的日子呢，这次就例外吧"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/3/565930.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/488996.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/657654.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/3/733457.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/548139.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/876117.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/3/490961.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/432874.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/527932.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/3/155109.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/476148.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/508703.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/3/882865.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/228452.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/17/651624.ogg"],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/157597/2025/5/3/7