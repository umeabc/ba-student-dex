381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 梓","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/315788.png","url":"https://www.gamekee.com/ba/77111.html"},{"name":"★3 梓（赛车）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_552/h_552/1609130/2026/9/29/31259903mvsdrf6d.png","url":"https://www.gamekee.com/ba/725722"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"blue archive"},{"label":"卡池抽取","jp":"白洲アズサ、目標地点の海に到着。すぐに予定の任務を始める。\n……別に浮かれてるとか、そういうわけじゃない。","fan":"白洲梓，到达目标地点大海。马上开始进行预定的任务。\n……并没有感觉兴奋什么的，才没有这样的事。","off":"白洲梓抵达目标地点：海边，马上执行任务。\n我并没有觉得特别兴奋"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"待ってた、先生。早く行こう、次の任務は何？","fan":"等你好久了，老师。快出发吧，下一个任务是什么？","off":"我正等你呢。老师。\n下个任务是什么？快出发吧。"},{"label":"登陆2","jp":"できれば、このままずっと…… ん？あれ、先生、いつの間に……？","fan":"如果可以的话，就这样一直……嗯？啊咧，老师？什么时候来的……？","off":"真希望就这样一直……\n你什么时候来的？"},{"label":"大厅1","jp":"な、何でそんなじっと見てるんだ…？や、やっぱりちょっとこれは派手過ぎたか？","fan":"为、为什么这样盯着我看呢……？啊，果然这个打扮有点太夸张了吗…？","off":"干嘛？怎么直勾勾的盯着我？\n看……看来我的打扮还是太花哨了。"},{"label":"大厅2","jp":"正直、自分ではよく分からない。 自分が今どんな姿で、良いのか、悪いのかも…。 だから…先生が良いと言ってくれるなら、それでいい。","fan":"老实说，我自己也不太清楚，自己现在是什么样子，好看吗，还是难看呢…。所以……如果老师说好看的话，那我就放心了。","off":"说实话，我自己判断不了穿这样到底好不好看，\n所以要是老师觉得好，我就听老师的。"},{"label":"大厅3","jp":"ん？何をしてたのか…？別に、何もしてなかったよ。\n…こういう時間も悪くない。","fan":"嗯？问我刚刚在干嘛吗… 其实，我没在做什么。\n……偶尔这样放空也不错。","off":"我在干什么？\n没干什么，偶尔放松一下也不错。"},{"label":"大厅4","jp":"先生といると色んなことが経験できる。 \nこんなの、前までは想像もできなかった。","fan":"能和老师在一起，经历各种各样的事情。\n这样的事情，在以前是想也不敢想的。","off":"跟老师在一起可以体验各种各样的事情，要是在以前，我根本不敢奢望这些。"},{"label":"大厅5","jp":"これ、偽装にもならないし、防備としても頼りない…。\n……でもそれが良い？……どういう意味だ？","fan":"这件衣服，既不能作为伪装，作为防御装备也不可靠…。\n……但是这样就很好？……什么意思？","off":"这身衣服既不能用来伪装，又不能用来防御，没有任何用处。\n……反而更强大了？什么意思？"},{"label":"回忆大厅1","jp":"わぁ……！\nこんなの初めて……目に映る全部がキラキラして、すごい……","fan":"哇……！\n第一次见到这样的景象……映入眼帘的全部都闪闪发光，真漂亮……","off":"哇……\n我还是第一次看到眼前的一切都闪闪发光，好漂亮。"},{"label":"回忆大厅2","jp":"何にも邪魔されずに、こうして何もかもを見渡せる場所があったなんて……。\n何だか、不思議な感覚……","fan":"居然能看到这样没有任何遮挡物，一眼就能望穿的地方……。\n总觉得不可思议……","off":"现在竟然可以不受任何干扰，把一切美景尽收眼底。好神奇。"},{"label":"回忆大厅3","jp":"元々、こういう開けた場所はあまり好きじゃなかった。\n隠れる場所も無いし、周囲の警戒も大変で……","fan":"我以前不太喜欢这样开放的地方。\n没有隐藏的地方，警戒四周也很难……","off":"其实我不怎么喜欢这种地方，太开阔了。\n没有地方可以藏身，想对四周保持警戒也很困难。"},{"label":"回忆大厅4","jp":"でも今は……全然不安じゃない。\nきっとこれは、うん……","fan":"但是如今......完全没有不安的感觉......\n这一定是因为，嗯......","off":"不过现在我一点都不紧张。\n我想这一定是因为……"},{"label":"回忆大厅5","jp":"今の私の視界には、いつもこうやって……\n……先生が、いてくれるからかな。","fan":"可能是因为，现在我目所能及的地方，一直都能看见......\n......老师的存在吧。","off":"现在在我的视野中能一直看到老师的身影吧。"},{"label":"咖啡馆1","jp":"意外と動きやすいし、悪くない……","fan":"意外地便于活动呢，还不错......","off":"还行，动起来好像也没想象的那么不方便。"},{"label":"咖啡馆2","jp":"なんだか視線を感じるような……","fan":"总觉得有视线在盯着我……","off":"总感觉有人在看我。"},{"label":"咖啡馆3","jp":"……ふふっ。","fan":"…（笑）","off":"-"},{"label":"咖啡馆4","jp":"やっぱりこれ、可愛い……","fan":"这个果然，好可爱……","off":"这个真的好可爱。"},{"label":"咖啡馆5","jp":"ちょっと疲れたかもしれない……","fan":"可能是有点累了……","off":"感觉有点累了。"}],"好感度":[{"label":"好感度1","jp":"うん、良い感じだ。先生は？","fan":"嗯，感觉不错。老师呢？","off":"嗯，我相当满意，老师觉得呢？"},{"label":"好感度2","jp":"こうやって悩むことがないのは良いことだ。","fan":"像这样无忧无虑真好啊。","off":"像这样无忧无虑是好事。"},{"label":"好感度3","jp":"もう少し……もう少しこのまま……この時間が続いてほしい。","fan":"再稍微......再稍微这样呆一会......希望此刻能持续下去。","off":"这段时间要是能再久一点点就好了。"},{"label":"好感度4","jp":"海は楽しい所……。うん、理解した。","fan":"大海是快乐的地方......。嗯，理解了。","off":"大海会让人快乐，嗯，我理解了。"}],"战斗":[{"label":"编入队伍1","jp":"うん。","fan":"嗯。","off":"-"},{"label":"编入队伍2","jp":"了解。","fan":"了解。","off":"明白"},{"label":"拎起","jp":"ふーん。","fan":"唔。","off":"-"},{"label":"任命队长1","jp":"邪魔は許さない。","fan":"不容许干扰。","off":"不允许有人妨碍"},{"label":"任命队长2","jp":"では、突入する。","fan":"那么，进行突入。","off":"好，冲吧"},{"label":"普通技能","jp":"補給を行う。","fan":"进行补给。","off":"实施补给"},{"label":"EX动画1","jp":"広い空と海……は！うぅ……","fan":"广阔的天空和大海……啊！呜呜……","off":"大海和天空都好美——啊？"},{"label":"EX动画2","jp":"風が気持ちいい…あっ、なんで？！","fan":"风吹得好舒服...…啊、为什么？！","off":"风吹的好舒服——干嘛？"},{"label":"EX动画3","jp":"先生はどこに……は！あぁ！","fan":"老师在哪里……啊…啊！","off":"老师吗——哎？"},{"label":"EX技能1","jp":"逃がさない！","fan":"别想逃！","off":"别想逃"},{"label":"EX技能2","jp":"そこ！","fan":"那里！","off":"找到了"},{"label":"EX技能3","jp":"目標を捕捉！","fan":"目标捕捉！","off":"已捕获目标"},{"label":"战斗开始1","jp":"邪魔者は排除する。","fan":"清除干扰者。","off":"清除妨碍者"},{"label":"战斗开始2","jp":"Initium venandi!","fan":"狩猎开始了！","off":"Initium venandi!"},{"label":"获得BUFF","jp":"うん、悪くない。","fan":"嗯，感觉还不错。","off":"嗯，还不错"},{"label":"施放BUFF","jp":"あっ、よし！","fan":"好的！","off":"很好"},{"label":"掩体","jp":"ここに隠れる。","fan":"在这里隐蔽。","off":"我在这里躲一下"},{"label":"被CC1","jp":"-","fan":"-","off":"-"},{"label":"被CC2","jp":"-","fan":"-","off":"-"},{"label":"被CC3","jp":"これぐらい。","fan":"就这种程度吗。","off":"不过如此"},{"label":"回避","jp":"見えてる！","fan":"看到了！","off":"我全看到了"},{"label":"队伍移动1","jp":"さあ、次の位置へ。","fan":"那么，去往下一个位置。","off":"走，该去下个位置了。"},{"label":"队伍移动2","jp":"迅速に行こう！","fan":"迅速前行！","off":"行动要迅速"},{"label":"回复","jp":"支援感謝する。","fan":"感谢你的支援。","off":"感谢支援"},{"label":"中途退出","jp":"少し浮かれすぎたか……","fan":"稍微有些浮躁了吗......","off":"可能是有点兴奋过头了"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"战斗喊叫","jp":"-","fan":"-","off":"-"},{"label":"角色移动","jp":"-","fan":"-","off":""},{"label":"战斗胜利1","jp":"当然の結果だ。何を着ていても、成果には関係ない。","fan":"理所当然的结果。无论穿什么，都不会影响胜利。","off":"胜利是理所当然，和穿什么衣服无关"},{"label":"战斗胜利2","jp":"任務完了、次の場所へ行こう。","fan":"任务完成，前往下一地点。","off":"任务完成，去下一个地点吧"},{"label":"关卡完成1","jp":"こうなるのは、最初から分かりきってたこと。","fan":"这是从一开始就知道的事情。","off":"这样的结局，我早就预料到了"},{"label":"关卡完成2","jp":"これは……いろんな意味で気持ちがいい。","fan":"这……从各种意义上来说都让人心情愉悦。","off":"心情不错，各种意义上"},{"label":"战斗失败1","jp":"油断した、ごめん……","fan":"我大意了，抱歉......","off":"大意了，抱歉"},{"label":"战斗失败2","jp":"予想外だった……","fan":"没有料到......","off":"没有想到"}],"成长":[{"label":"升级1","jp":"日々のサポートに感謝する。この借りはいつか必ず。","fan":"感谢你一直以来对我的照顾。总有一天会报答你的。","off":"谢谢你一直支援我，这份恩情总有一天……"},{"label":"升级2","jp":"確実に成長してる。","fan":"真的在成长。","off":"我确实又成长了"},{"label":"升级3","jp":"いつも適切なサポートを助かる。","fan":"你一直以来对我恰当的支援帮了大忙。","off":"你总能雪中送炭，帮大忙了"},{"label":"升级4","jp":"うん、悪くない気分だ。","fan":"嗯，感觉还不错。","off":"感觉还不错"},{"label":"获得专武","jp":"ちょうどこういうのが欲しかったところだ、ありがとう。後悔はさせない。","fan":"我正想要这样的一把枪，谢谢。我不会让你后悔的。","off":"这东西我正好用得上，谢谢，我不会让你后悔的"}],"事件":[{"label":"学生生日","jp":"ん…？誕生日…？\n……そっか。……ありがとう、先生。","fan":"嗯…？生日…？\n……这样啊。……谢谢你，老师。","off":"生日快乐？\n……谢谢老师"},{"label":"老师生日","jp":"誕生日おめでとう。先生。 \nこんなことを言える余裕がある日々を、一緒に生きられていること ……本当に、嬉しく思う。","fan":"生日快乐。老师。\n能一起生活在，有余力说出这种话的日子里……真的很开心。","off":"生日快乐，老师，我居然能平静的向老师送出祝福，这样悠闲从容的生活真好啊。"},{"label":"万圣节","jp":"まあ、みんなが派手な衣装を着てる日だし。 \n私もこうして……少しくらいはしゃいでも良いかな。","fan":"嘛，是大家都穿着华丽服装的日子。\n我也这样……稍微欢闹一下也可以吧。","off":"我觉得在圣诞节穿这种衣服一点都不合适。\n……就是要这个味儿？我不明白你的意思。"},{"label":"新年","jp":"また無事に一年を終えられた。次の夏も、また…… \nい、いや、期待してるわけじゃ……","fan":"又顺利地度过了一年。今天的夏天也……\n不，不，我才没有期待呢……","off":"又平安的度过了一年，今年夏天也……\n没有，我也没那么期待。"},{"label":"圣诞节","jp":"こういう日に着るものじゃないと思うけど…\n……だからこそ良い？ 意味が分からない……","fan":"我觉得不应该在这种日子穿这种衣服的…\n……正因为如此才好？不明白……","off":"我觉得在圣诞节穿这种衣服一点都不合适。\n……就是要这个味儿？我不明白你的意思。"},{"label":"春节","jp":"","fan":"老师新春快乐。\n没关系，我接受过严格的训练，能够抵抗现在的寒冷。","off":"老师新春快乐。\n没关系，我接受过严格的训练，能够抵抗现在的寒冷。"},{"label":"中秋","jp":"","fan":"这么明亮的月光，任何企图在深夜突袭的敌人都会无处遁形吧。","off":"这么明亮的月光，任何企图在深夜突袭的敌人都会无处遁形吧。"}],"活动":[{"label":"活动登陆1","jp":"夏… 海…\nあ、な、なんでこんなにこちを見てるんだ。","fan":"夏天...大海...\n啊，为什么这么看着我。","off":"大海，夏天。\n怎么了？你在看什么？"},{"label":"活动登陆2","jp":"お帰り、先生。 やるべきことがまだまだたくさんあるよ。","fan":"欢迎回来，老师。还有很多事情必须要做呢。","off":"老师，你来了，我们还有很多活没干呢。"},{"label":"活动大厅1","jp":"この水着、かわいい。","fan":"这件泳衣好可爱。","off":"这件泳装好可爱，嘿嘿。"},{"label":"活动大厅2","jp":"せ、先生？いつから見ていた？","fan":"老、老师？从什么时候就在看了？","off":"老师，你从什么时候开始看我的？"},{"label":"活动大厅3","jp":"み、見ないで。こういうの慣れてないから…","fan":"别、别看我。这样很不习惯……","off":"不要看我，我还不习惯这种。"},{"label":"活动大厅4","jp":"その…やっぱり何でもない。気にしないで。","fan":"那个……没什么。别放在心上。","off":"没……没有，当我没说吧。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/149163.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/380544.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/218216.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/783527.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/19/450140.ogg","htt