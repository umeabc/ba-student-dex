mg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/366314.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/488890.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"980"},{"name":"攻击力","value":"114"},{"name":"治愈力","value":"366"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/179117.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/123154.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 亚津子","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_296/h_296/829/86082/2025/5/13/449547.png","url":"https://www.gamekee.com/ba/158662.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー、アーカイブ。","fan":"碧蓝、档案。","off":"blue archive！"},{"label":"卡池抽取","jp":"アリウススクワッド、秤アツコ。……ふふ、畏まりすぎたかな？","fan":"这里是阿里乌斯小队的亚津子。呵呵……是不是太拘谨了？","off":"啊，这个……谢谢你，老师。我很喜欢。我会为了老师去用的。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生。\n私にできること、ある？","fan":"你好，老师。\n有什么，我可以做的事情吗？","off":"你好，老师。有什么我可以做的吗？"},{"label":"登陆2","jp":"おかえり、先生。\n今日もよろしくね。","fan":"欢迎回来，老师。\n今天也请多多关照。","off":"快请进，老师。今天也请多多关照。"},{"label":"大厅1","jp":"ミサキと「ツーショット」を撮ったよ。……二人とも変な顔、\nふふ。もう一回、撮りたいかも。","fan":"和美咲拍了“ 双人合照”哦。\n两个人表情都好奇怪，呵呵……想要重新再拍一张呢。","off":"我和美咲拍了“双人照”。……两个人的表情都好奇怪，呵呵。还想重拍一张。"},{"label":"大厅2","jp":"その……変に聞こえるかもしれないけど……\n先生の写真、撮ってもいい？","fan":"那个……虽然可能听上去有点奇怪……\n我，可以拍一张老师的照片吗？","off":"那个……我这么问也许有点奇怪……老师，可以给你拍张照吗？"},{"label":"大厅3","jp":"こんな日でも、先生はお仕事なんだ。\nサッちゃんも今頃……ううん、なんでもない。","fan":"即使是现在，老师也还在工作啊。\n纱酱估计现在也……嗯，没什么。","off":"这种日子，老师也在工作啊。\n小纱现在应该也……呃，没什么。"},{"label":"大厅4","jp":"先生、私の水着、大丈夫そう？\n変じゃないかな。","fan":"老师，我的泳装，看起来没问题吧？\n不会奇怪吧。","off":"老师，我的泳装怎么样？不奇怪吧？"},{"label":"大厅5","jp":"お祭りの景品コーナーで焼きそばの交換券をもらったんだ。\nヒヨリ、気に入ってくれるかな。","fan":"收到了一张祭典景品角的炒面兑换券。\n日和，应该会很喜欢吧。","off":"我在庆典的抽奖处领到了炒面的兑换券。日和会喜欢吗？"},{"label":"回忆大厅1","jp":"写真、いっぱい撮ってきたけど……\nこうして撮られるのは初めて。\nこういうとき、どうしたらいいか分からない……","fan":"虽然给别人拍了很多照片……\n但是还是第一次有别人给自己拍。\n也不是很清楚，这种时候应该做点什么……","off":"虽然拍过很多照片……不过，像这样被拍还是第一次呢。\n不知道这种时候该怎么做比较好……"},{"label":"回忆大厅2","jp":"こう、笑えばいいのかな？\nもっとお花のほうに寄る……？\nわかった。","fan":"这样笑可以吗？\n再更靠近花一点……？\n我明白了。","off":"像这样笑就可以了吗？\n再往花那边靠一些……？好的。"},{"label":"回忆大厅3","jp":"ハマナス……いいにおい。","fan":"玫瑰花……\n好香。","off":"沙滩玫瑰的香味……真美妙。"},{"label":"回忆大厅4","jp":"偶然見つけた場所だけど……\n先生のおかげで、ここに来れた。","fan":"虽然是偶然发现的地方……\n但还是托老师的福，才能来到这里。","off":"多亏了老师，才能在偶然间发现这样的地方。"},{"label":"回忆大厅5","jp":"ありがとう先生。\n素敵な思い出になったよ。","fan":"谢谢你老师。\n这将会是我美好的回忆。","off":"谢谢你，老师。带我创造了这么美好的回忆。"},{"label":"咖啡馆1","jp":"いい写真、撮れるかな？","fan":"可以拍出好看的照片吗？","off":"能拍到好看的照片吗？"},{"label":"咖啡馆2","jp":"（サッちゃん、元気にしてるといいな）","fan":"（纱酱，现在过得还好吗）","off":"（小纱，希望你能过得好。）"},{"label":"咖啡馆3","jp":"どこかで、お花の香りがする。","fan":"感觉闻到哪里传来的花香。","off":"好像从哪儿飘来了花香。"},{"label":"咖啡馆4","jp":"ここ、ゆっくりできそう。","fan":"感觉可以在这里悠闲地休息。","off":"这里应该可以放松休息。"},{"label":"咖啡馆5","jp":"これは……？初めてみた。","fan":"这个是……？还是第一次见。","off":"这是……？第一次见到。"}],"好感度":[{"label":"好感度1","jp":"先生の隣にいるね。……なんとなく、そうしたいの。","fan":"呆在老师身边……不知道为什么，好像一直就这样。","off":"我会待在老师身旁的。……我也不知道为什么，就是想这样。"},{"label":"好感度2","jp":"先生には、いつももらってばかり。私からもいろいろ、したいのに……","fan":"老师，一直总是对我笑。我也渐渐变得想对老师绽放笑容了……","off":"我总是单方面地接受老师的好意。我也想为你做点什么……"},{"label":"好感度3","jp":"ふふ、ありがとう。記念に写真、撮っておくね。","fan":"呵呵，谢谢。作为纪念，来拍一张照片吧。","off":"呵呵，谢谢你。拍张照片留念吧。"},{"label":"好感度4","jp":"あっ、こういうときは……ちゃんとお礼を、だったね。はい、こちらこそ、よろしくお願いします。","fan":"啊，这种时候……一定要注意礼节，是这样吧。嗯，谢谢，也请多多关照。","off":"啊，这种时候……得好好道谢才行。嗯，是我应该请您多多关照。"}],"战斗":[{"label":"编入队伍1","jp":"呼んでくれてうれしい。","fan":"很高兴你叫我。","off":""},{"label":"编入队伍2","jp":"確認した。","fan":"确认好了。","off":""},{"label":"拎起","jp":"……やっぱ、レンズ越しはもったいないかも。","fan":"…… 果然，隔着镜头看，未免太可惜了。","off":""},{"label":"普通技能","jp":"いい香り。","fan":"好香。","off":"呵呵，好香的味道。"},{"label":"EX动画1","jp":"先生、笑って。","fan":"老师，请笑一下。","off":"老师，笑一下。"},{"label":"EX动画2","jp":"写真、撮ってあげる。","fan":"为你拍一张照片。","off":"我给你拍个照。"},{"label":"EX动画3","jp":"一枚撮らせて。","fan":"一张就好。","off":"让我拍一张吧。"},{"label":"EX技能1","jp":"ここ、いい写真を撮れそう。","fan":"这里，应该能拍出好看的照片。","off":"这里，拍照应该会很好看。"},{"label":"EX技能2","jp":"はい、チーズ。","fan":"321，茄子。","off":"来，茄——子。"},{"label":"EX技能3","jp":"はい、撮るね。","fan":"好，拍了哦。","off":"好，我要拍咯。"}],"成长":[{"label":"升级1","jp":"くれるの……？大切にするね。","fan":"给我的吗……？我会好好珍惜的。","off":"给我的吗……？我会好好珍惜的。"},{"label":"升级2","jp":"学んでいくって、楽しいね。","fan":"渐渐地学到更多，我很开心。","off":"了解彼此，真是件愉快的事。"},{"label":"升级3","jp":"こんなに……もしかして私、期待されてるのかな……？","fan":"这样的东西……莫非您对我这么期待吗……？","off":"竟然这样……难道说，老师对我有所期待吗……？"},{"label":"升级4","jp":"ありがとう、先生。いつも新しい景色、みせてくれて。","fan":"谢谢你，老师。总是带我看到新的风景。","off":"谢谢你，老师。总是让我看到全新的风景。"},{"label":"获得专武","jp":"あ、これ……ありがとう、先生。\nすごく、気に入ったよ。\nこれは先生のために、使うから。","fan":"啊，这个……谢谢，老师。\n真的很喜欢呢。\n我会为了老师而使用它的。","off":"啊，这个……谢谢你，老师。我很喜欢。我会为了老师去用的。"}],"事件":[{"label":"学生生日","jp":"ありがとう、先生。\nプレゼントは大丈夫……\nそれより、一緒に散歩してほしい。","fan":"谢谢，老师。\n礼物的话没关系啦……\n比起礼物，我更希望您陪我一起散步。","off":"谢谢你，老师。礼物就不用了……我更想和你一起去散步。"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\n今日はプレゼントを渡す日、だよね。覚えてるよ。\nプレゼントに……私はどうかな？\n今日一日は、先生の言う事、なんでも聞くよ。","fan":"生日快乐，老师。\n今天是赠送礼物的日子，对吧。我还记着的哦。\n礼物嘛……把我送给老师如何？\n今天一天，无论什么，只要是老师说的，我都会做的。","off":"生日快乐，老师。今天是赠送礼物的日子。我一直记着呢。\n把我自己当作礼物……怎么样？今天一天，老师说什么我都会听的。"},{"label":"万圣节","jp":"いたずら……お菓子……？\nごめん、ハロウィーンのことはまだ、よく知らなくて。\nだから先生に、教えてもらいたい。","fan":"捣蛋……糖果……？\n抱歉，关于万圣节的事情，还不是很了解。\n所以老师，可以告诉我吗。","off":"恶作剧……糖果……？抱歉，我还不太了解万圣节。\n因为不太了解，所以希望老师能教教我。"},{"label":"新年","jp":"明けましておめでとう、先生。\n新しい年……今年はなにが起こるのか、楽しみだね。","fan":"新年快乐，老师。\n新的一年……今年会发生什么呢，好期待啊。","off":"新年快乐，老师。\n新的一年……今年会发生什么事情呢，我很期待。"},{"label":"圣诞节","jp":"メリークリスマス、先生。\n特別な日は、写真にしなきゃ。\nはい、こっち見て。","fan":"圣诞快乐，老师。\n在这特别的日子里，一定要拍一张。\n来，看这边。","off":"圣诞快乐，老师。特别的日子应该拍照留念哦。来，看这边好吗？"},{"label":"春节","jp":"","fan":"老师，新年好！要在沙滩上放烟花吗？那，我跟你一起去准备吧。","off":"老师，新年好！要在沙滩上放烟花吗？那，我跟你一起去准备吧。"},{"label":"中秋","jp":"","fan":"老师，你也是来看月亮的吗？听说，今天这样的日子应该一起吃“月饼”。和老师一起吃……应该会更甜吧。","off":"老师，你也是来看月亮的吗？听说，今天这样的日子应该一起吃“月饼”。和老师一起吃……应该会更甜吧。"}],"活动":[{"label":"活动登陆1","jp":"海のお祭り…\nこんなの、はじめて。","fan":"海边的祭典...\n还是第一次参加。","off":"我还是……第一次体验这种海边的庆典。"},{"label":"活动登陆2","jp":"先生、楽しんでる？","fan":"老师也享受其中吗？","off":"老师，玩得开心吗？"},{"label":"活动大厅1","jp":"砂に触れたり、波を追いかけたり…\n海って、楽しいね。","fan":"感受着沙子的触感，被起起伏伏的海浪追逐着……\n海边，很开心。","off":"触摸细沙，追逐海浪……在海边真开心。"},{"label":"活动大厅2","jp":"野外ステージ…楽しそう。\n先生、一緒に見に行こう。","fan":"户外演出......好期待啊。\n老师，也一起去看吧。","off":"露天舞台……好像很有意思。老师，一起去看看吧。"},{"label":"活动大厅3","jp":"みんなと一緒だから、楽しいんだと思う。\nもちろん「みんな」の中には、先生もいるよ。","fan":"感觉只要是和大家在一起，就会觉得很开心。\n当然「大家」里面也有老师哦。","off":"和大家一起来很开心。当然，“大家”也包括老师。"},{"label":"活动大厅4","jp":"お祭りに連れてきてくれて、ありがとう。\n先生も、楽しんでね。","fan":"谢谢你带我来祭典。\n老师也享受其中呢。","off":"谢谢你带我来参加庆典。老师也要玩得开心哦。"},{"label":"活动事件1","jp":"お祭りの間は、何も起こらないといいな…\nこんなに楽しい時間、めったにないから。","fan":"希望祭典期间不要发生什么意外......\n因为很少有这么开心的时间。","off":"希望庆典期间不要发生任何事情……难得有这样开心的时光。"},{"label":"活动事件2","jp":"お祭りはあと少しで…\nはじまりがあれば終わりがある、っていうけど…\nちょっと、寂しいな。","fan":"祭典接近尾声了......\n虽然说......有开始就有结束......\n但还是有点寂寞。","off":"庆典快要结束了……虽然说有始就有终……不过还是有点遗憾呢。"},{"label":"活动结束","jp":"お祭り、終わっちゃったね…\nでも大丈夫だよ。海は、変わらずきれいだから。","fan":"祭典结束了呢......\n但是没关系。大海还是一如既往的美丽。","off":"庆典结束了……不过没关系。因为大海依旧美丽。"},{"label":"活动任务1","jp":"呼んだ？","fan":"您叫我吗？","off":"是在叫我吗？"},{"label":"活动任务2","jp":"ふふ、私じゃなくて隣を見て。","fan":"呵呵，别看我啦看旁边。","off":"呵呵，别看我呀，看我旁边。"},{"label":"活动任务每日结束","jp":"今日のお仕事はこれで終わり、少し休もうか、先生。","fan":"今天的工作到这里就结束了，稍微休息一会儿吧，老师。","off":"今天的任务到此结束。休息一会儿吧，老师。"},{"label":"活动任务登录1","jp":"こんにちは、先生。\nはい、これ、やることリストだよ。","fan":"你好，老师。\n来，给您，这里是待办清单哦。","off":"你好，老师。给，这是待办事项清单。"},{"label":"活动任务登陆2","jp":"…多いね。一つずつ、終わらせていこう。","fan":"任务好多啊......一件一件地完成吧。","off":"……好多啊，一件件来吧。"},{"label":"活动任务获取1","jp":"お疲れ様、先生。","fan":"辛苦啦，老师。","off":"辛苦了，老师。"},{"label":"活动任务获取2","jp":"先生、頑張ってるね。\n私もやる気出てきた。","fan":"老师，很努力呢。\n我也打起精神了。","off":"老师真努力呀。我也有斗志了。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/86082/2025/5/23/793526.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/1/18/629881.ogg","https://cdnimg-v2.gamekee.c