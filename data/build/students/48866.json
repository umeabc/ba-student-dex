25/5/12/252545.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/584696.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/65433.png","name":"巧克力口味妖怪MAX","desc":"为纪念情人节推出的巧克力口味妖怪MAX。虽然让人清醒的效果卓越，但是否普通的妖怪MAX比更加好喝还需要与晴讨论。"},"ability":{"attrs":[{"name":"生命值","value":"751"},{"name":"攻击力","value":"88"},{"name":"治愈力","value":"230"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/267974.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/252259.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 晴（野营）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/12/535161.png","url":"https://www.gamekee.com/ba/609143.html"},{"name":"NPC 晴（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/854782.png","url":"https://www.gamekee.com/ba/643810.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案。"},{"label":"卡池抽取","jp":"会えて嬉しい、先生。\nミレニアムの力を、先生に見せてあげる。","fan":"见到您真高兴，老师。\n就让老师见识下千禧的力量吧。","off":"很高兴认识你，老师，我会让老师见识一下千禧年的实力。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"や、先生。コーヒーはいかが？","fan":"呀，老师。来杯咖啡怎么样？","off":"呀！老师，来杯咖啡吗？"},{"label":"登陆2","jp":"ようこそ、先生。私の予想より約43秒早く到着したね。","fan":"欢迎呢，老师。比我预计的要早到大约43秒呢。","off":"老师，欢迎您，你比我预测的早到了43秒。"},{"label":"大厅1","jp":"こう見えてゲームは結構上手い方だよ。\n先生も一度相手してみる？","fan":"不管你信不信，我可是超级擅长游戏的哦。\n老师要不要挑战我试试？","off":"看不出来吧？我超会打游戏的哦，老师要不要和我比试一下？"},{"label":"大厅2","jp":"チート…？いくらハッカーでも、楽しさのためにやってるゲームにそんなのを使うはずないでしょ。","fan":"作弊…？即使是黑客，在为快乐而生的游戏中也不会用到作弊手段吧。","off":"作弊？虽然我是黑客，但是打游戏最重要的是开心嘛，我不会作弊的。"},{"label":"大厅3","jp":"私たちがやることが、そんなに過激に見えた?","fan":"我们（黑客们）做的事看起来有那么过激吗？","off":"在你看来，我们做的事情有那么极端吗？"},{"label":"大厅4","jp":"知識は自由であるべき…。うん、やっぱりいい言葉だね。","fan":"知识应是自由的…。嗯，说得真好。","off":"知识，应该是自由的，嗯，这句话说得真好。"},{"label":"大厅5","jp":"この甘い炭酸飲料こそ知性ある人の飲み物だよ。","fan":"甜甜的碳酸饮料才应该是理性的人喝的东西呀。","off":"这种甜甜的碳酸饮料，才是高智商人士该喝的东西呢。"},{"label":"回忆大厅1","jp":"ふう…急に夕立だなんて。\n最近は、天気予報も信頼できなくて困るね。","fan":"呼…突然下起了阵雨。\n最近的天气预报真让人不知道该不该信。","off":"嗯…怎么突然下雨了，最近连天气预报都不敢信了，真麻烦。"},{"label":"回忆大厅2","jp":"さて…この後、何をしようか？\n（ん…今の言葉、もしかして変な意味に聞こえたかな？）","fan":"那么…现在要做什么？\n（不对…刚刚那句话会不会听起来很奇怪？）","off":"嗯，接下来干什么呢？（出声）\n我刚才说的话不会让人误解成什么不好的意思了吧？（心声）"},{"label":"回忆大厅3","jp":"（でも、ネットカフェなんて私も初めてだし、\n普通こういう所で何をするものなのかも知らないし…）\n（というかこの空間、狭くて…先生の顔が近い…っ）","fan":"（可是我也是第一次来网咖，不知道其他人都在这里做什么…..。）\n（而且这空间实在太狭小了，老师的脸靠得好近……。）","off":"可我第一次来网吧这种地方，也不知道别人一般会在这里干什么，\n而且这里也太窄了，老师的脸好近！"},{"label":"回忆大厅4","jp":"え、さ、先にシャワーを浴びてくるって？ちょっと、なっ、どうして？！\nあ、雨に濡れたから、髪を洗いに？…ごめん、いや、気にしないで。\nネットカフェには、シャワーの設備もあるんだね。","fan":"你，你要先去洗澡？等等，你在想什么？！\n啊。你说头发被雨淋湿要去洗一下？……是我误会了啊。\n网咖也有浴室吗？","off":"您要先去洗个澡？等下，为什么？头发淋湿了要去洗一下，对不起，没事，当我没说吧。"},{"label":"回忆大厅5","jp":"あ、見て、先生。ドリンクバーが無料だって。\nエナジードリンクもあるかな？\nネットも自由に使えるし、ドリンクも無料だし。\nこれは素晴らしい、完全に私のような人間のための空間。","fan":"你看这个，老师。饮料吧免费耶。\n不知道有没有能量饮料？\n不止可以自由地使用网络，连饮料也免费。\n完全为我这种人准备的空间嘛！","off":"原来网吧还有洗澡的地方啊，啊，老师快看，\n饮料是免费的欸，不知道有没有能量饮料，网络也能随便用，\n饮料也不要钱，这也太幸福了，完全就是给我这种人设计的地方啊。"},{"label":"回忆大厅6","jp":"ここになら、いつまででもずっといられそうだね？\nあ、えっと…今のも、別に変な意味ではないから。誤解しないでね…。","fan":"想在这里待多久都可以？\n所以说……我没有在说奇怪的话。不要误会……。","off":"要在这里呆多久我都愿意，那个，刚才那句话没什么特别的意思，不要误会哦。"},{"label":"咖啡馆1","jp":"これをこうやって直して、あそこをああやって直せば…\nよし。すぐ改造してみようかな？","fan":"这里这样改改，那里那样改改的话......\n好。让我们来改造试试吧？","off":"这里可以这么修，那里在那么修一下，好，马上改造一下试试吧。"},{"label":"咖啡馆2","jp":"ふーん。うん？\nああ、何してるかって？新作のゲームを やってたの。","fan":"唔——嗯？\n啊，你问我在做什么吗？我在玩新出的游戏啦。","off":"嗯？啊，问我在干什么？在玩新出的游戏呢。"},{"label":"咖啡馆3","jp":"自販機からエナジードリンクだけが出るようにはできないのかな…？","fan":"自动贩卖机不能只卖能量饮料吗…？","off":"不能让自动售货机只卖能量饮料吗？"},{"label":"咖啡馆4","jp":"ううーん…。ちょっと一眠りしてから続けようかな？","fan":"唔...唔。小睡一会儿再继续吧？","off":"嗯…要不要先眯一会再继续呢？"},{"label":"咖啡馆5","jp":"糖分が足りない…。","fan":"糖分不足了…。","off":"糖分不足…"}],"好感度":[{"label":"好感度1","jp":"この研究が終わったら、次は先生のことを研究してみたいな。","fan":"研究完这个，我想研究一下老师试试呢。","off":"等这项研究结束了，下次想研究一下老师。"},{"label":"好感度2","jp":"人の心も、顕微鏡で覗き込んで、見ることが出来たら良いのに…。","fan":"如果人的内心也能用显微镜窥测就好了…。","off":"要是人的心灵也可以用显微镜去观察就好了。"},{"label":"好感度3","jp":"先生に惹かれるこの心は、どんな力学で証明できるんだろう…。","fan":"被老师吸引的这颗心，怎样用力学来证明呢…。","off":"用什么样的力学，才能证明这颗被老师吸引的心呢？"},{"label":"好感度4","jp":"私の能力で時間を巻き戻せるのかって？\nさぁ…でも私はこの瞬間を永遠に楽しみたいけど。","fan":"以我的能力可以使时光倒流吗？\n谁知道呢…但是我想永停留在这瞬间。","off":"你问我的能力能不能让时间倒流？谁知道呢？但是我很想永远享受现在这个瞬间。"}],"战斗":[{"label":"编入队伍1","jp":"私の実力を証明してみせる機会だねー","fan":"到了证明我实力的时候了呢。","off":"证明我实力的机会到了。"},{"label":"编入队伍2","jp":"任せて。","fan":"交给我吧。","off":"交给我。"},{"label":"拎起","jp":"アテナ3号、問題なし。","fan":"雅典娜3号，没有问题。","off":""},{"label":"普通技能","jp":"これは痛いよ。","fan":"这个很痛的哦。","off":"这下会很痛哦。"},{"label":"EX动画1","jp":"電磁パルス、稼働開始","fan":"电磁脉冲，开始运转。","off":"电磁脉冲，开始运行。"},{"label":"EX动画2","jp":"EMPドローン、稼働。","fan":"EMP无人机，启动。","off":"EMP无人机，启动。"},{"label":"EX动画3","jp":"第一段階エミッター、作動開始。","fan":"第一阶段发射器，开始运作。","off":"第一阶段发射器，开始运行。"},{"label":"EX技能1","jp":"装備を停止する。","fan":"装备失效。","off":"设备停止。"},{"label":"EX技能2","jp":"予想通りかぁ。","fan":"和预料的一样吗。","off":"和预期一样啊。"},{"label":"EX技能3","jp":"みんな、後ろに下がって。","fan":"大家退后。","off":"大家，退后。"},{"label":"战斗开始1","jp":"さあ、思い切りかき回してみようか。","fan":"那么，尽情地大闹一场吧。","off":"好，来尽情的搞一搞破坏吧。"},{"label":"战斗开始2","jp":"まずは、データを集めてみようか。","fan":"首先是，收集下数据吧。","off":"先来收集一下数据吧。"},{"label":"特殊载具","jp":"テックレベル7、登場完了。","fan":"TechLevel7登场。","off":"Tech Level 7登机完毕。"},{"label":"特殊载具","jp":"これで終わらせよう。","fan":"用这个了结了吧。","off":"就用这一击作为结束吧。"}],"成长":[{"label":"升级1","jp":"ん～、これは目を見張る結果だね。","fan":"唔～令人刮目相看的结果呢。","off":"嗯？效果还挺惊人的嘛。"},{"label":"升级2","jp":"もっと多くのデータが必要だね。","fan":"还需要更多的数据。","off":"我还需要更多的数据。"},{"label":"升级3","jp":"この込み上げる力も、数値化出来るのかなぁ。","fan":"这涌上来的力量，能不能用数值计算呢。","off":"涌现出来的这股力量，能不能量化呢？"},{"label":"升级4","jp":"未知の知識を探求するのは、いつだって楽しいことだね。","fan":"探寻未知的领域，一直都是件愉快的事情呢。","off":"探索未知的知识，总是很有趣呢。"},{"label":"获得专武","jp":"古い武器だけど……この武器には数値化できない思い出が込められてる。","fan":"虽然这把枪很旧了……但它包含了无法用数字衡量的回忆。","off":"虽然是一件旧武器，不过这件武器里面，包含着无法量化的记忆。"}],"事件":[{"label":"学生生日","jp":"うーん、私が言ったラズベリーパイはこれじゃないけど…。\nでも誕生日を祝ってくれてありがとう。","fan":"唔，虽然我说的树莓派不是这个…….\n但还是谢谢你为我庆祝生日。","off":"嗯..我说的树莓派不是这个东西，不过谢谢你为我庆祝生日。\n（编者注：此处的树莓派应为一款卡片式电脑）"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\n今日一日はどんなコードを書いてもバグが出ないハレのご加護を授けよう。","fan":"生日快乐，老师。\n赠予你一天无论输入什么也不会出BUG的晴之加护。","off":"生日快乐，老师，今天晴会保佑你，不管些什么代码都不会出现漏洞。"},{"label":"万圣节","jp":"外のお祭りを楽しみに出かけないのかって?\nハロウィーンのお祭りはモニターの中でも開かれているもの。","fan":"为什么我不去外面享受节日？\n因为万圣节可以在屏幕后享受和在外面同样的乐趣。","off":"你问我为什么不去外面过节？万圣节的庆典，用显示器也能看嘛。"},{"label":"新年","jp":"ハロー、ニューワールド。","fan":"Hello, new world.","off":"Hello,new world.\n（编者注：此处的\"hello world\"程序为测试时常用的程序代码）"},{"label":"圣诞节","jp":"あれ知ってる、先生？\nクリスマスは1年の中で“あれ”が一番多く行われる日なの。\nふふ、それはそう…ハッキングだよ。","fan":"你知道吗，老师？\n圣诞节是一年中做“那个”事情最多的一天。\n嘿嘿。你知道我的意思…“那个”当然是，黑客骇入。","off":"老师，你知道么，一年之中圣诞节是发生那个次数最多的一天，\n没错，就是破解入侵哦！"},{"label":"春节","jp":"","fan":"希望新的一年里不要遇到那么多bug了","off":"希望新的一年里不要遇到那么多bug了"},{"label":"中秋","jp":"","fan":"今天，是团圆的节日吗？﻿\n﻿即使是我，也有想呆在老师身边的时候呢……","off":"今天，是团圆的节日吗？﻿\n﻿即使是我，也有想呆在老师身边的时候呢……"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/645336.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/98075.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/567333.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/43893.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/654049.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/253033.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/528471.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/589971.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/866587.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/72324/2025/5/20/476449.o