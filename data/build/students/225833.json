es/w_304/h_240/408107/2026/8/23/44801429mue56fhu.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_146/h_116/408107/2026/8/23/30666379mue5aped.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_146/h_116/408107/2026/8/23/82280516mue5b1zi.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルー……ん～……あっ！アーカイブ！","fan":"蔚蓝……嗯～……啊！档案！","off":""},{"label":"卡池抽取","jp":"どもども～！183号特別クラス、二木エリナで～す。\nえー、本日はお日柄もよく――……\nあれ、なんて言うんだっけ？","fan":"你好你好～！我是183号特别班级的二木艾莉娜～。\n嗯——，今天真是黄道吉日——……\n咦，那句话怎么说来着？","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ぐぅ……\nむにゃむにゃ……。\nハッ！？\nね、寝てないです！温かいからつい\n瞑想していたら……\nその……。","fan":"唔……咕哝咕哝……。哈！？\n我、我没睡！因为太暖和了，一不小心就冥想了起来……\n那个……。","off":""},{"label":"登陆2","jp":"どーも、先生～！\n風邪には気をつけてくださいね！","fan":"你好，老师～！请小心别着凉哦！","off":""},{"label":"大厅1","jp":"先生って、レスリング好きです？\nなんか才能ありそうですよね～\n一緒に動画見てたら\n興味湧いたりして！？","fan":"老师，你喜欢摔跤吗？总觉得你很有天赋呢～\n要是和我一起看视频的话，说不定会提起兴趣呢！？","off":""},{"label":"大厅2","jp":"うわ……\nすっごい仕事の量……\n大丈夫です？\n連邦生徒会の懲戒って\nすごいんですね。\nまさかこんなになんて……。","fan":"哇……这工作量也太大了……\n没事吧？联邦学生会的惩戒可真厉害呢。\n没想到会这么……。","off":""},{"label":"大厅3","jp":"そ、そこに居てください！\nうっ……ううぅっ……！\nぶえっくしょぉおおんっっ！！！\nほえ……うわあっ！！？\nす、すぐハンカチ\n持ってきますから！！","fan":"请、请站在那里！\n呜……呜呜……！阿——嚏——！！！\n诶……哇啊！！？\n我、我马上拿手帕来！！","off":""},{"label":"大厅4","jp":"勉強って何でこんなに\nやりたくないんでしょ。\nもっと面白かったら良いのに。\n踊りながらしたら……\nもしかして面白かったり？","fan":"学习这种东西，为什么会这么不想做呢。\n要是再有趣一点就好了。\n要是边跳舞边学习……说不定会变得有趣？","off":""},{"label":"大厅5","jp":"なんでレスリングのマスクを\n被らないのか、って……？\nし、しーっ！！！\nそれ、被らない派に言っちゃ\nダメなやつですから！？相手が私で\nよかったですよほんと！？","fan":"你问我为什么不戴摔跤面具……？\n嘘、嘘——！！！\n这种话可不能对『不戴面具派』说啊！？还好对方是我，真的！？","off":""},{"label":"回忆大厅1","jp":"へへっ、綺麗ですよね？\nゲホゲホ。雪の結晶を\nポリビニルアセタールで\n固めたものです。時間が経ったとしても、\n温かい場所でも溶けません。","fan":"嘿嘿，很漂亮吧？\n咳咳。这是用聚乙烯醇缩醛把雪结晶固定住的。就算过了很久，在暖和的地方也不会融化。","off":""},{"label":"回忆大厅2","jp":"せっかくなので一番大きくて\n綺麗なものを探そうとしたら……\nこんな時間になってしまって。ズビズビ……\nせっかくなので、\n永久に光る\n雪結晶にしてみました。どうでしょう？\nこれを見るたびに、\n私のことを\n思い出してくれますか？","fan":"本来想趁这个机会找一朵最大最漂亮的……\n结果不知不觉就弄到这么晚了。吸溜吸溜……\n既然这样，我就做了一朵永远发光的雪结晶。怎么样？\n每次看到它的时候，会不会想起我呢？","off":""},{"label":"回忆大厅3","jp":"ふふっ！やったぁ！\n喜んでもらえてよかったです。すごいですよね……\nこれも、あれも、\nぜーんぶ化学なんです。先生と、私も……\n化学で説明できるわけです。","fan":"嘻嘻！太好了！\n你能喜欢真是太好了。很厉害吧……\n这个也好，那个也好，全——都是化学哦。老师和我……\n都能用化学来解释呢。","off":""},{"label":"回忆大厅4","jp":"見えているものも、情報処理も、\n電気信号でしかありません。\nなのに反応しあうんです。どれもただの\n電気信号でしかないのに、\n感情なんて名前が\n付いてしまいました。いえ、それが\n嫌というわけではなく……。","fan":"看得见的东西也好，信息处理也好，都不过是电信号而已。\n可它们却会互相反应。明明都只是单纯的电气信号，却被安上了『感情』这样的名字。\n不，我并不是讨厌这一点……。","off":""},{"label":"回忆大厅5","jp":"こんな風に反応が起こるなら、\n同じがいいな、と思って。なーんて！ゲホゲホ！\n私、風邪でおかしく\nなっちゃったのかもしれません！あははっ……！\nははっ……。","fan":"要是能这样产生反应的话，我想和你一样就好了，这么想着。骗你的啦！咳咳！\n我说不定是因为感冒而变得奇怪了呢！啊哈哈……！\n哈哈……。","off":""},{"label":"咖啡馆1","jp":"わ～！\n風が入ってこなくて\n最高！","fan":"哇～！\n没有风灌进来，太棒了！","off":""},{"label":"咖啡馆2","jp":"服かわいい～！\nそれどこで\n買ったんですか！？","fan":"衣服好可爱～！\n你是在哪里买的！？","off":""},{"label":"咖啡馆3","jp":"あぁ……\nレッドウィンターの\n繫華街より\n良いかも……。","fan":"啊……\n也许比红冬的繁华街还好……。","off":""},{"label":"咖啡馆4","jp":"あったかーい……\n風邪引かなくて\nすみそうです！","fan":"好暖和～……\n看起来不用担心感冒了！","off":""},{"label":"咖啡馆5","jp":"あの人、化学者の\n素質があるかも！？","fan":"那个人，说不定有化学家的天赋！？","off":""}],"好感度":[{"label":"好感度1","jp":"勉強は嫌いだけど\n先生がついててくれるなら……いいかも？","fan":"虽然讨厌学习，\n但要是老师陪着我的话……也许可以？","off":""},{"label":"好感度2","jp":"先生、鈍感だって言われません？\nあ、そう……いえ、聞いてみただけです。","fan":"老师，有没有人说过你迟钝？\n啊，这样……不，我只是问问而已。","off":""},{"label":"好感度3","jp":"一緒にカフェ行ったりお出かけしたり……。\nこれの意味、分からないとは言わせませんよ？","fan":"一起去咖啡馆、一起出去玩……。\n这个的意义，我可不会让你说不知道哦？","off":""},{"label":"好感度4","jp":"もっと会いに来てくださいよね。\nあそこがどれだけ退屈な場所か、知っているならなおさら。","fan":"请多来见我吧。\n你要是知道那里是个多无聊的地方，就更应该来了。","off":""}],"战斗":[{"label":"编入队伍1","jp":"終わったら寄り道していいんですよね？やった～！","fan":"结束后可以顺路去逛逛，对吧？太棒了～！","off":""},{"label":"编入队伍2","jp":"化学で食らわせちゃいますっと！","fan":"就让我用化学来教训你吧！","off":""},{"label":"拎起","jp":"う、うわあっ！高い所は苦手です！","fan":"呜、哇啊！我恐高啊！","off":""},{"label":"任命队长1","jp":"ちょっとあっち見てってもいいですか?","fan":"能请您稍微往那边看一下吗？","off":""},{"label":"任命队长2","jp":"うんうん、ダサくない!","fan":"嗯嗯，一点也不土！","off":""},{"label":"普通技能","jp":"強くなりましたよ～！とつげーき！","fan":"我变强了哦～！冲——锋！","off":""},{"label":"EX动画1","jp":"化学は祝福なりぃ～！","fan":"化学即是祝福～！","off":""},{"label":"EX动画2","jp":"これなら大丈夫では？","fan":"这样就没问题了吧？","off":""},{"label":"EX动画3","jp":"延長戦といきまっしょい！","fan":"让我们进入加时赛吧！","off":""},{"label":"EX技能1","jp":"お礼はまた後ほど！","fan":"谢礼之后再说！","off":""},{"label":"EX技能2","jp":"勉強した甲斐がありましたぁ！","fan":"学习总算没有白费呢！","off":""},{"label":"EX技能3","jp":"タッグマッチみたいですね！","fan":"就像双打比赛一样呢！","off":""},{"label":"战斗开始1","jp":"ちょちょーっと終わらせて遊びに行きましょい！","fan":"三两下搞定它，然后去玩吧！","off":""},{"label":"战斗开始2","jp":"チャンピオンニュルーじゃー！","fan":"冠军驾到啦——！","off":""},{"label":"获得BUFF","jp":"ビクトリーに感謝！","fan":"感谢胜利！","off":""},{"label":"施放BUFF","jp":"濃度5000倍！","fan":"浓度5000倍！","off":""},{"label":"掩体","jp":"勉強の方が増しかも","fan":"说不定学习更有用呢","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"うわぁ!","fan":"哇啊！","off":""},{"label":"被CC3","jp":"","fan":"","off":""},{"label":"回避","jp":"回避も攻撃ですよ!","fan":"回避也是攻击哦！","off":""},{"label":"队伍移动1","jp":"うーん…血中酸素濃度が…","fan":"嗯……血氧浓度……","off":""},{"label":"队伍移动2","jp":"リングより広いと困るよー。","fan":"场地比擂台还宽敞的话就难办了呢～。","off":""},{"label":"回复","jp":"ドーパミンドバドバー!","fan":"多巴胺喷涌而出！","off":""},{"label":"中途退出","jp":"弁解は罪…いや、そうですけど!","fan":"辩解即是罪……不，确实如此！","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"角色移动","jp":"","fan":"","off":""},{"label":"战斗胜利1","jp":"甘い成果でしたぶいっ","fan":"真是甜美的成果，哟！","off":""},{"label":"战斗胜利2","jp":"チャンピオンのタイトルは守られました!イェイ!","fan":"冠军头衔保住了！耶！","off":""},{"label":"关卡完成1","jp":"楽勝でしたね!よし!","fan":"轻松取胜呢！好耶！","off":""},{"label":"关卡完成2","jp":"カフェでもやっていきません?","fan":"要不要去咖啡馆坐坐？","off":""},{"label":"战斗失败1","jp":"やあ!降参!降参!","fan":"呀！投降！投降！","off":""},{"label":"战斗失败2","jp":"もっと勉強しとけばよかった","fan":"早知道就多学点习了","off":""}],"成长":[{"label":"升级1","jp":"ふぇ？勉強自体は好きですよ？\n参考書開いたり書き取りするのが嫌いなだけで。","fan":"诶？学习本身我是喜欢的哦？\n我只是讨厌翻开参考书、抄写东西而已。","off":""},{"label":"升级2","jp":"努力は苦いですけど成果は甘いものですから！\nオブラートがほしいところです……。","fan":"努力是苦涩的，但成果是甜美的！\n真想裹上一层糖衣啊……。","off":""},{"label":"升级3","jp":"強くなったら説得力も増しますよね？えへっ！","fan":"变强了，说话也更有说服力了吧？嘿嘿！","off":""},{"label":"升级4","jp":"あ～～こういう時なんて言うんだっけ？\nあれですよ、あれ！\nああ、そう！「ありがとうございます」！","fan":"啊～～这种时候该怎么说来着？\n就是那个、那个！\n啊，对了！『谢谢你』！","off":""},{"label":"获得专武","jp":"これで熊相手でも\nバッチリです！\nもちろん弁論も！","fan":"有了这个，就算对上熊也万无一失！\n当然辩论也一样！","off":""}],"事件":[{"label":"学生生日","jp":"ご、ゴホンゴホン！\nカフェで誕生日ケーキ！\nゴホンゴホン！\nせ、先生も風邪には\n気をつけてください～\nはあ、まさか「誕生日」に\n風邪を引いちゃうなんて……ごっ、ゴホンゴホン！！","fan":"咳、咳咳！在咖啡馆吃生日蛋糕！\n咳咳！老、老师也要注意别感冒哦～\n唉，没想到竟然在『生日』这天感冒了……咳、咳咳！！","off":""},{"label":"老师生日","jp":"お誕生日おめでとう\nございます、先生！誕生日で思い出したんですけど、\n化学の力で誕生日を当てる\n方法があるんです。\n特定の物質が\nRNAの弱化で濃度が\n変わるらしいんですけど……一度試してみて、\nいいですか？","fan":"生日快乐，老师！\n说到生日我突然想起来了，有能用化学的力量猜出生日的方法哦。\n听说特定物质会因为RNA的弱化而改变浓度……要不要试一次，可以吗？","off":""},{"label":"万圣节","jp":"「家を訪ね、お菓子を\n貰えなければイタズラする」\n……。\nそれなら、183号は\n毎日がハロウィンですね。\n熊が来ますし……。","fan":"「挨家挨户敲门，不给糖果就捣蛋」……。\n这么说的话，183号班每天都是万圣节呢。\n毕竟会有熊来嘛……。","off":""},{"label":"新年","jp":"あけまして\nおめでとうございます！今年は新しい服や美味しいものが\nたくさんもらえますよ～に！\nえへへっ！","fan":"新年快乐！\n希望今年能收到很多新衣服和好吃的东西～！\n诶嘿嘿！","off":""},{"label":"圣诞节","jp":"サンタ、ですか？\nトナカイが引くソリで\n世界中を周るなんて\nありえないと思いますよ！\n同志ジェド・マロースなら\n分かります。\n馬は速いですし！","fan":"圣诞老人？\n让驯鹿拉雪橇绕世界一周什么的，我觉得根本不可能哦！\n要是同志严寒老人的话我倒能理解。毕竟马跑得快嘛！","off":""}],"活动":[{"label":"活动登陆1","jp":"外の人！？\nえっ、本当に……！？どーぞどーぞ！\n大歓迎です！","fan":"外面的人！？诶，真的……！？\n请进请进！热烈欢迎！","off":""},{"label":"活动登陆2","jp":"最近の新聞\n持ってたりします？一ヶ月以内だとめっちゃ\n嬉しいです！","fan":"你有最近的报纸吗？要是一个月以内的\n我会超高兴的！","off":""},{"label":"活动大厅1","jp":"うぅ……\nうううぅぅっ……！\n……んあ～～っ！くしゃみ\n引っ込んじゃったぁ！！","fan":"唔……呜呜呜……！\n……嗯啊～～！喷嚏缩回去了！！","off":""},{"label":"活动大厅2","jp":"ヒィッ！\nビックリしたぁ……！またトナカイかと\n思ったぁ！","fan":"咿！\n吓我一跳……！还以为是驯鹿又来了呢！","off":""},{"label":"活动大厅3","jp":"ん？お腹空いたんです？んじゃなんか作りますね！\n私