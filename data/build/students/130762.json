h_61/829/43637/2025/4/26/163858.png","items":[]}],"gifts":[],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"997"},{"name":"攻击力","value":"107"},{"name":"治愈力","value":"205"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/759052.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/43947.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":""},{"label":"卡池抽取","jp":"常盤台中学2年、御坂美琴。私の手伝いが必要なら言ってちょうだい。","fan":"我是常盘台中学二年生，御坂美琴。如果需要我帮忙的话，记得说哦。","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あ、先生。こっち、こっち。ちょっと来るの遅いわよ。待ってたんだから。","fan":"啊，老师，在这在这，你稍微迟到了一点哟...我可等了好一会呢。","off":""},{"label":"登陆2","jp":"お疲れ様、先生。私？ずっとここにいたけど。","fan":"辛苦啦老师，我吗？一直在这里呀。","off":""},{"label":"大厅1","jp":"なんとなーく、一人で出かけるのはまだハードル高いというか……。","fan":"该怎么说呢，感觉一个人出门，还是有点太难了。","off":""},{"label":"大厅2","jp":"停電の時に助けてほしい？はいはい、冗談でしょ。\n……まぁ、助けなくもないけどさ。","fan":"停电的时候希望我帮你？好好好....是开玩笑吧？虽然我也没有没帮过就是了。","off":""},{"label":"大厅3","jp":"たまーに、学園都市に似てると感じる事があるんだよね、ここ。","fan":"有时候，还是感觉这里和学园都市好像啊。","off":""},{"label":"大厅4","jp":"先生、よかったら風にあたらない？","fan":"老师！可以的话要一起出去吹吹风吗？","off":""},{"label":"大厅5","jp":"ここってしゃべる猫も多いわよね……一体どういう事なのかしら？\nあ、いや！なんでもない！","fan":"这里会说话的猫好多啊……到底是什么情况？啊！没什么。","off":""},{"label":"回忆大厅1","jp":"うーーーん。ずっと眺めてたら、ちょっとは可愛く見えてきたような……","fan":"嗯......一直看着的话，是觉得有点可爱了呢......","off":""},{"label":"回忆大厅2","jp":"結局、これはブタなの……？\nそれともカバ？……えっ、鳥！？嘘でしょ！？","fan":"话说，这个是猪？还是河马？诶？是鸟吗？骗人的吧！？","off":""},{"label":"回忆大厅3","jp":"そ、それはそうだけど……あはは……ま、どっちでもいいわ。","fan":"话是这么说没错……啊哈哈哈……嘛，反正没什么关系的。","off":""},{"label":"回忆大厅4","jp":"というか、よく考えたら……\nこれ、先生からのプレゼントなのよね。","fan":"嗯，仔细想了想的话……这个毕竟是老师赠与的礼物嘛。","off":""},{"label":"回忆大厅5","jp":"……大切にするわ。ありがとう、先生。","fan":"嘿嘿，我会好好珍惜的。谢谢老师。","off":""},{"label":"咖啡馆1","jp":"ここがシャーレのカフェ...。","fan":"这就是夏莱的咖啡厅吗？","off":""},{"label":"咖啡馆2","jp":"何なのあれ？","fan":"那是啥啊？","off":""},{"label":"咖啡馆3","jp":"変なものが沢山あるわね。","fan":"奇怪的东西有好多啊。","off":""},{"label":"咖啡馆4","jp":"こ、これは結構可愛いかも。","fan":"这，这还有点可爱呢。","off":""},{"label":"咖啡馆5","jp":"うん？誰かに呼ばれてる？","fan":"嗯？是有谁在叫我吗？","off":""}],"好感度":[{"label":"好感度1","jp":"なんか...ずっともらってばっかだけど、いいの？","fan":"感觉...一直都是我在接受恩惠，这样真的好吗？","off":""},{"label":"好感度2","jp":"ちょっと照れ臭いかも...有難くもらうけど。","fan":"虽说稍微有点难为情...但我会心怀感激收下的。","off":""},{"label":"好感度3","jp":"たまにはこういうのも悪くないわね、うん。","fan":"偶尔这样来一次，也不错嘛。对吧。","off":""},{"label":"好感度4","jp":"私も、何かしたいんだけど、その...\n手伝えること、ないかしら。","fan":"我也该帮忙做点什么，要不...我来帮你打打下手吧。","off":""}],"战斗":[{"label":"编入队伍1","jp":"うん？何？参加すればいいの？","fan":"嗯？什么？是要我来参加吗？","off":""},{"label":"编入队伍2","jp":"手伝って欲しいの？それくらいなら...まぁ。","fan":"是要我来帮忙吗？如果只是简单的帮一下的话（也不是不行）。","off":""},{"label":"拎起","jp":"何か用？","fan":"叫我干嘛？","off":""},{"label":"任命队长1","jp":"よし、いくわよ。","fan":"好，我要上了。","off":""},{"label":"任命队长2","jp":"ここに行くの？オッケー。","fan":"要去这边吗？OK。","off":""},{"label":"普通技能","jp":"これは痛いわよ！","fan":"这下可是很痛的哦！","off":""},{"label":"EX动画1","jp":"あとで後悔するんじゃないわよ！","fan":"你可别等会后悔呀！","off":""},{"label":"EX动画2","jp":"そっちがやる気なら！","fan":"既然是你先动手的话！","off":""},{"label":"EX动画3","jp":"そんなに見たいなら！","fan":"既然你那么想看的话！","off":""},{"label":"EX技能1","jp":"よく見てなさい！","fan":"好好见识下吧！","off":""},{"label":"EX技能2","jp":"食らえ！","fan":"接招吧！","off":""},{"label":"EX技能3","jp":"これはどう？","fan":"这招如何？","off":""},{"label":"战斗开始1","jp":"早く終わらせるわよ！","fan":"快点结束吧！","off":""},{"label":"战斗开始2","jp":"これ全部やるの?とりあえずわかったわ！","fan":"这些都要干掉吗？总之我明白了！","off":""},{"label":"获得BUFF","jp":"おっ、サンキュー！","fan":"哦！谢谢！","off":""},{"label":"施放BUFF","jp":"ちょっと本気出そうかな。","fan":"稍微拿出点真本事吧!","off":""},{"label":"掩体","jp":"ここよさそうね。","fan":"这里还不错嘛。","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"