80756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 白子","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/888839.png","url":"https://www.gamekee.com/ba/46677.html"},{"name":"★3 白子（骑行）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/697418.png","url":"https://www.gamekee.com/ba/85351.html"},{"name":"★3 白子*恐怖","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/904453.png","url":"https://www.gamekee.com/ba/162557.html"},{"name":"NPC 白子（1年级）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/807938.png","url":"https://www.gamekee.com/ba/624154.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"-"},{"label":"卡池抽取","jp":"釣りの時間だよ、先生。行こう。","fan":"现在是钓鱼的时间，老师，走吧。","off":"钓鱼时间到了，老师，走吧。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰り、先生。今来たばっかの人にかける言葉じゃないかもしれないけど…\n外、出ようか？","fan":"欢迎回来，老师。这句话可能不适合对刚回来的人说…出门吗？","off":"老师，你来啦。虽然你才刚来，这样说好像不太合适......要不要去外面？"},{"label":"登陆2","jp":"待てたよ、先生。","fan":"久等了，老师。","off":"我一直在等你呢，老师。"},{"label":"大厅1","jp":"そう何度もあるチャンスじゃないから、出来る事は最大限やってみる。","fan":"这不是什么常有的机会，能够做的事只有全力以赴。","off":"只要做得到，就尽量去尝试吧，因为机会并不会一直都有。"},{"label":"大厅2","jp":"先生、何かしたい事ある？どこに行って、何したい、それどもお腹空いた？","fan":"老师有什么想做的事吗？想去哪里？想做什么？还是说您肚子饿了？","off":"老师，有什么事情想做吗？要不要去什么地方？肚子饿了吗？"},{"label":"大厅3","jp":"これ、先生のために着てる。ん、大物とってくるから、期待してて。","fan":"这个，是为了老师才穿上的。嗯，一定会抓条大鱼回来的，请期待哦。","off":"这身衣服是为了老师而穿的。嗯，我会抓个大家伙回来的，拭目以待吧。"},{"label":"大厅4","jp":"エアコンや扇風機もいいけど、水中の方が好きかも。","fan":"作为消暑手段，空调或者风扇都挺好的，不过，我或许更喜欢在泡在水里呢。","off":"空调和风扇也不错......但在水里更舒服。"},{"label":"大厅5","jp":"そう言えば、先生は泳げる？教えようか？","fan":"说起来，老师会游泳吗？要我教你游泳吗？","off":"对了老师，你会游泳吗？要不要我教你？"},{"label":"回忆大厅1","jp":"ただいま、先生。ん、成功した、これで作れるよ。","fan":"我回来了，老师。嗯，成功了，这样一来就能够制作了。","off":"我回来了，老师。嗯，成功了，可以用这个做了。"},{"label":"回忆大厅2","jp":"パンフレットで見た、あの料理。料理道具も準備したから、問題ない。","fan":"在宣传册上看到的那种料理。料理用的道具也准备好了，没有问题。","off":"宣传册上看到的那道菜，做菜的工具也都备好了，没问题的"},{"label":"回忆大厅3","jp":"先生が一緒に来てくれてよっかた。一人だったら、途中でやめてたかもしれない。","fan":"老师能够一起来真是太好了。如果只有我一人的话，可能就半途而废了。","off":"还好，有老师陪我一起来。如果只有我自己，可能早就半途而废了。"},{"label":"回忆大厅4","jp":"…そんなことない、今も、これを考えるようになったきっかけも…\nすべて、先生がいてくれだから。","fan":"…没有那种事，现在我能够有这样的想法也是…\n全都是因为老师在我身边。","off":"不，不是这样的。不管是现在，还是让我变得能这样想，都是因为，有老师在我身边。"},{"label":"回忆大厅5","jp":"先生、ありがとう。","fan":"老师，感谢您。","off":"老师，谢谢你。"},{"label":"咖啡馆1","jp":"ここでは、取れそうにない。","fan":"这里好像没有什么可收获的。","off":"在这里......应该钓不到鱼。"},{"label":"咖啡馆2","jp":"あれは…？","fan":"那个是…？","off":"那是什么？"},{"label":"咖啡馆3","jp":"釣り堀があれば…","fan":"要是有钓鱼池的话…","off":"要是有钓鱼塘的话......"},{"label":"咖啡馆4","jp":"あれ、取れるかな？","fan":"那个能不能拿下来呢…","off":"咦？能钓到吗？"},{"label":"咖啡馆5","jp":"ん？今の音は…？","fan":"嗯？刚刚的声音是…？","off":"嗯？刚才的声音是？"}],"好感度":[{"label":"好感度1","jp":"またこんな…いや、ありがとう、先生。","fan":"又做了这种事情…感谢您，老师。","off":"老师总是这样......没什么，谢谢老师！"},{"label":"好感度2","jp":"ありがとう、先生。ところで、食べたい海産物とか、ある？","fan":"感谢您，老师。您有什么想吃的海产品吗？","off":"谢谢你，老师。对了，你有什么想吃的海鲜吗？"},{"label":"好感度3","jp":"先生のためなら、なんでも取ってくるよ。","fan":"如果是为了老师，什么东西我都能带回来。","off":"只要老师想吃，我什么都能钓回来。"},{"label":"好感度4","jp":"「楽しいか？」って…ん、凄く。","fan":"您问我开心吗？嗯，非常开心。","off":"我开不开心？嗯，很开心啊。"}],"战斗":[{"label":"编入队伍1","jp":"なんど、ここに釣りの道具が…","fan":"这里居然有钓鱼的道具。","off":"啊......正好这里有钓具。"},{"label":"编入队伍2","jp":"ん、準備完了。","fan":"嗯，准备完成。","off":"嗯，准备就绪。"},{"label":"拎起","jp":"ん、釣りの準備はできてる?","fan":"嗯，钓鱼的准备好了吗？","off":""},{"label":"普通技能","jp":"ん、これ要らない。","fan":"嗯，不需要这个。","off":"嗯，这个不需要。"},{"label":"EX动画1","jp":"-","fan":"-","off":"嗯。嗯！"},{"label":"EX动画2","jp":"…来た！","fan":"…上钩了！","off":"嗯！来了！"},{"label":"EX动画3","jp":"今！","fan":"就是现在！","off":"就是现在！"},{"label":"EX技能1","jp":"大物だ！","fan":"是条大鱼！","off":"是条大鱼。"},{"label":"EX技能2","jp":"逃がさない！","fan":"不会让你跑掉的！","off":"你跑不掉的。"},{"label":"EX技能3","jp":"狙いは精確！","fan":"目标明确！","off":"目标正确。"}],"成长":[{"label":"升级1","jp":"釣りは道具が命、ありがとう、先生","fan":"对于钓鱼来说道具就是生命。感谢您，老师。","off":"来钓鱼的话，工具是最重要的，谢谢老师。"},{"label":"升级2","jp":"これなら、もっと大きのが釣れるかも。","fan":"这样一来，也许能钓到更大的鱼。","off":"有了这个，说不定能钓到更大的。"},{"label":"升级3","jp":"お返しに、大物を釣ってくるね、期待してて。","fan":"作为回报，我会钓条大鱼回来，敬请期待。","off":"作为回报，我会给老师钓一条大家伙，尽管期待吧。"},{"label":"升级4","jp":"よし、今すぐ出発しよう。","fan":"现在就出发吧。","off":"好，马上出发吧"},{"label":"获得专武","jp":"こういう所に来ても、先生は変わらないね。いつも支援…いや、助けてくれて、ありがとう。","fan":"就算来到这种地方，老师也不会变呢。支援…不，感谢您的一直以来的帮助。","off":"就算来到了这里，老师也一点没变呢。谢谢你一直支援......啊不对，是帮助我。"}],"事件":[{"label":"学生生日","jp":"あ、誕生日、おぼえてくれたんだ、ありがとう、先生。","fan":"啊，您还记得我的生日，感谢您，老师。","off":"啊，生日，老师还记得啊，谢谢你。"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。誕生日のご馳走、お刺身でいい？","fan":"生日快乐，老师。作为生日宴会的主菜，刺身可以吗？","off":"生日快乐，老师！生日宴上......要不就吃生鱼片吧！"},{"label":"万圣节","jp":"ハロウィーン…カボチャを被った人を見たよ。私も被ってみようかな…","fan":"万圣节到了，看到了头戴南瓜的人，我要不也试着戴戴看吧…","off":"万圣节......我看到有人戴着南瓜头套，我也戴戴看吧"},{"label":"新年","jp":"新年…だね。明けましておめでとう、先生。ん、新年も一緒に色んな所行こう。","fan":"新年到了。祝您新年快乐，老师。嗯，今年也要一起去很多地方呢。","off":"新年......到了。新年快乐，老师！嗯！新的一年也要一起去很多地方。"},{"label":"圣诞节","jp":"クリスマス…か。水中の方が暖か…くはない、やっぱり無理か…","fan":"圣诞节吗…还是水里更…不，也不会更暖和，果然还是不行吗…","off":"毕竟是......圣诞节吗？说不定水里反而更暖和，呃，好像并没有，看来这样还是太勉强了。"},{"label":"春节","jp":"","fan":"新春快乐，老师。听说有句话......叫年年有“鱼”？我们也快去钓鱼吧！什么？不是这个鱼？嗯，不要在意细节，今天我一定要钓到条大家伙给老师看看。","off":"新春快乐，老师。听说有句话......叫年年有“鱼”？我们也快去钓鱼吧！什么？不是这个鱼？嗯，不要在意细节，今天我一定要钓到条大家伙给老师看看。"},{"label":"中秋","jp":"","fan":"海上的月光真美。老师，我们来比赛游泳吧。向着月亮的方向，谁游得更远就算胜利。放心，如果老师累了，我会背你回来的。","off":"海上的月光真美。老师，我们来比赛游泳吧。向着月亮的方向，谁游得更远就算胜利。放心，如果老师累了，我会背你回来的。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/5/753353.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/292713.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/179173.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/5/395121.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/937880.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/18/492635.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/