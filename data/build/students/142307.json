g-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"睦月（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/737047/2025/5/10/613639.png","url":"https://www.gamekee.com/ba/150223.html"},{"name":"睦月","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/737047/2025/5/10/179293.png","url":"https://www.gamekee.com/ba/54505.html"},{"name":"睦月（特工）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/737047/2025/5/10/663300.png","url":"https://www.gamekee.com/ba/614743.html"}],"voices":{"通常":[{"label":"标题","jp":"","fan":"碧蓝档案~库呼呼~","off":""},{"label":"卡池抽取","jp":"ふふふ、ムツキちゃん大変身！さあ、何して欲しい？何でも言ってごらん？","fan":"呵呵呵，睦月酱大变身！来吧，想让我做什么？什么都可以说哦？","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"いらっしゃい！せーんせい。ドレス姿のかわいいムツキちゃんを待たせるなんて、いいご身分だね。","fan":"欢迎光临！老——师。让穿着礼服的可爱睦月酱等这么久，老师架子可真大呢。","off":""},{"label":"登陆2","jp":"こっちこっち！今日は何して遊ぶ？","fan":"这边这边！今天要玩什么？","off":""},{"label":"大厅1","jp":"どう？ムツキちゃん、大人っぽい？くふ、正直に言っていいんだよ。今日の私は、いつもより大人なんだから。","fan":"怎么样？睦月酱，有没有成熟一点？库呼，可以老实说哦。今天的我，可是比平时更成熟呢。","off":""},{"label":"大厅2","jp":"問題でーす、どうしてムツキちゃんはドレスを着ているのでしょう？当てられたら特別なプレゼントをあげる。間違えたら罰として、私の椅子になってもらおうかな","fan":"问题来啦——睦月酱为什么会穿着礼服呢？猜对的话，我就给你一份特别的礼物。猜错的话，就罚你当我的椅子好了。","off":""},{"label":"大厅3","jp":"今日はいつもより大人っぽい遊びをしようよ。何をするかは先生が決めていいよ。","fan":"今天来玩点比平时更成熟的游戏吧。要玩什么，就由老师来决定吧。","off":""},{"label":"大厅4","jp":"さっきお姉さんって呼ばれちゃった。ドレス着てたからかな？くふふ、先生からも、呼ばれてみたいなぁ","fan":"刚才有人叫我姐姐了。是因为我穿了礼服吗？库呼呼~也想听老师这么叫我呢。","off":""},{"label":"大厅5","jp":"このドレス、便利屋のみんなと選んだの。特別な思い出の服だからね。大切に着たいんだ","fan":"这件礼服，是我和便利屋的大家一起选的。毕竟是装着特别回忆的衣服嘛。我想好好珍惜着穿。","off":""},{"label":"回忆大厅1","jp":"あのね、こう見えても私、結構信頼してるんだよ、先生のこと。","fan":"那个啊，别看我这样，其实我还是挺信任老师的哦。","off":""},{"label":"回忆大厅2","jp":"え、意外？いつもいたずらばっかりしてるから？くふふ、私だって誰かで構わずやるわけじゃないって。","fan":"诶，很意外？因为我平时总是在恶作剧？库呼呼~我也不是对谁都会这么做的啦。","off":""},{"label":"回忆大厅3","jp":"まあだからそのお金をどうするかは任せるよ。先生なら、ちゃんと意味のあることに使ってくれるでしょ？どっかに寄付してもいいし、先生の活動資金にしてもいいし。","fan":"所以啊，这笔钱要怎么用，就交给老师决定吧。如果是老师的话，一定会把它用在有意义的地方，对吧？捐到哪里也可以，当成老师的活动资金也可以。","off":""},{"label":"回忆大厅4","jp":"それが嫌なら、先生が預かるってことにして。私たちの未来のためにとっておいてもいいかもね","fan":"如果不想那样的话，就先交给老师保管吧。也可以为了我们的未来，先把它留起来呢。","off":""},{"label":"回忆大厅5","jp":"えー？何を言っているのかって？","fan":"诶——？你问我在说什么？","off":""},{"label":"回忆大厅6","jp":"くふふ、さあ、どういう意味だろうね？","fan":"库呼呼~谁知道是什么意思呢？","off":""},{"label":"咖啡馆1","jp":"ここでみんなとドレスパーティーしたいなー","fan":"真想在这里和大家开一场礼服派对啊——","off":""},{"label":"咖啡馆2","jp":"ふふふ、先生ってこういうのが好きなんだ","fan":"呵呵，原来老师喜欢这种地方啊。","off":""},{"label":"咖啡馆3","jp":"誰か遊んでくれないかな？","fan":"有没有人来陪我玩呢？","off":""},{"label":"咖啡馆4","jp":"あれ、いじったら面白そう！","fan":"那个，动一动好像会很有意思！","off":""},{"label":"咖啡馆5","jp":"くふふ、楽しいなぁ。なんか好きなんだよね、ここ。","fan":"库呼呼~真开心啊。不知道为什么，我还挺喜欢这里的。","off":""}],"好感度":[{"label":"好感度1","jp":"先生さあ、自分がやってることの意味、ちゃーんとわかってるの？くふふ","fan":"老师啊，你真的——知道自己在做什么吗？库呼呼~","off":""},{"label":"好感度2","jp":"アハハ、わたしも先生のこと、だーい好き、いろんな意味でね。","fan":"啊哈哈，我也最喜欢老师了哦。各种意义上都是。","off":""},{"label":"好感度3","jp":"ふーん、この感情の名前、私知ってる。気になるなら、教えてあげよっか？","fan":"嗯——这种感情的名字，我知道哦。要是好奇的话，要不要我告诉你呀？","off":""},{"label":"好感度4","jp":"へー、ふーん、そっかー、先生は、もーっと、私と仲良くなりたいんだね。","fan":"嘿——嗯——这样啊——老师是想和我变得更——亲近一点呢。","off":""}],"战斗":[{"label":"编入队伍1","jp":"ここで遊ぶの？いいよ、なにする？","fan":"要在这里玩吗？好啊，要玩什么？","off":""},{"label":"编入队伍2","jp":"くふふ、任せて！","fan":"库呼呼~交给我吧！","off":""},{"label":"拎起","jp":"なになに？どういう遊び？","fan":"什么什么？是什么样的游戏？","off":""},{"label":"普通技能","jp":"ちょーっと熱いよ！","fan":"会有点烫哦！","off":""},{"label":"EX动画1","jp":"くふふ、騙されちゃった？","fan":"库呼呼~被骗到了吗？","off":""},{"label":"EX动画2","jp":"サプライズ！","fan":"Surprise！","off":""},{"label":"EX动画3","jp":"じゃーん！これなーんだ！","fan":"锵锵！猜猜这是什么！","off":""},{"label":"EX技能1","jp":"ほらほら、かわいいわたあめだよ","fan":"看呀看呀，是可爱的棉花糖哦。","off":""},{"label":"EX技能2","jp":"あはは、こらえ！","fan":"啊哈哈，接招！","off":""},{"label":"EX技能3","jp":"予想できたかな？","fan":"猜到了吗？","off":""}],"成长":[{"label":"升级1","jp":"ムツキちゃん、成長したみたい。さて、どこが成長したでしょうか？","fan":"睦月酱好像成长了呢。那么，猜猜看是哪里成长了？","off":""},{"label":"升级2","jp":"これってつまり、もーっとすごいいたずらしてもいいってことだよね、くふふ","fan":"这也就是说，我可以做更——厉害的恶作剧了，对吧？库呼呼。","off":""},{"label":"升级3","jp":"だいじょうぶ？手に負えなくなっても知らないよ","fan":"真的没问题吗？到时候管不住我，我可不负责哦。","off":""},{"label":"升级4","jp":"アハハハ！もっと楽しく遊べそう！","fan":"啊哈哈哈！感觉能玩得更开心了！","off":""},{"label":"获得专武","jp":"くふふ、これこれ、この手応えが好きなんだよねー","fan":"库呼呼~，就是这个这个，我就喜欢这种手感呢——","off":""}],"事件":[{"label":"学生生日","jp":"あはは、お祝いしてくれてありがとう、先生！先生が喜ぶかなって思ってドレスを着てみたんだけど、どう？嬉しい？","fan":"啊哈哈，谢谢你帮我庆祝，老师！我想着老师会不会喜欢，所以特地穿了礼服哦。怎么样？开心吗？","off":""},{"label":"老师生日","jp":"先生！今日誕生日だよね！じゃあパーティーしよ！パーティー！","fan":"老师！今天是你的生日对吧！那就开派对吧！派对！","off":""},{"label":"万圣节","jp":"私のドレスが赤い理由…何でかわかる？血がついても目立たないから。なんて、あはは、騙された？","fan":"我的礼服是红色的理由……你知道是为什么吗？因为就算沾到血，也不会显眼。开玩笑的，啊哈哈，被骗到了吗？","off":""},{"label":"新年","jp":"先生、あけおめー！今年も楽しい一年になるといいね！先生も、そう思うでしょ？","fan":"老师，新年快乐——！今年也能变成开心的一年就好了呢！老师也这么觉得吧？","off":""},{"label":"圣诞节","jp":"クリスマスにドレスを着るのって、何か特別な意味があるのかな？一緒に調べてみない？くふふ","fan":"圣诞节穿礼服，是不是有什么特别的意义呢？要不要一起查查看？库呼呼~","off":""}],"活动":[{"label":"活动登陆1","jp":"さてさて、どんな事件が待ってるのかなぁ？","fan":"那么那么，会有什么事件在等着我们呢？","off":""},{"label":"活动登陆2","jp":"今回もすっごく面白そう！","fan":"这次也感觉会超级有趣！","off":""},{"label":"活动大厅1","jp":"いたずらは本番のように。本番はいたずらのように。","fan":"恶作剧要像正式演出一样认真。正式演出也要像恶作剧一样轻松。","off":""},{"label":"活动大厅2","jp":"うーん、潜入ルートはあっち、かな？","fan":"嗯——潜入路线是……那边，吧？","off":""},{"label":"活动大厅3","jp":"なにー？ムツキちゃんと遊びたいのー？くふふ","fan":"怎么啦？想和睦月酱一起玩吗？库呼呼~","off":""},{"label":"活动大厅4","jp":"仕事が終わったら、一緒にオペラ観に行かない？絶対楽しいよ！","fan":"工作结束之后，要不要一起去看歌剧？一定会很好玩的哦！","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/191981/2026/4/29/1780057241302_1780057226091_d6zslphh6r_b0tzcp94h4.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892179340_1779883551551_ywx7znr3x2_xpk00omuun.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/829/492704/2026/4/27/1779892185353_177988