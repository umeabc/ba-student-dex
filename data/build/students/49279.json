label":"关卡完成1","jp":"よく分からないけど…勝つのはいい事だね。～","fan":"虽然我不是很懂...不过胜利是好事呢~","off":"不是很懂……不过，赢了就好~"},{"label":"关卡完成2","jp":"勝利？…私達が？","fan":"赢了吗？...我们这边？","off":"胜利了……？我们嘛？"},{"label":"战斗失败1","jp":"もう少しちゃんとしてれば…。","fan":"如果再稍微认真一点的话…。","off":"应该再认真一点的……"},{"label":"战斗失败2","jp":"負けた？…いつ？","fan":"输了吗？...什么时候？","off":"输了……？什么时候……？"}],"成长":[{"label":"升级1","jp":"これ～食べられるの～？","fan":"这个~能吃吗~ ?","off":"这个……能吃嘛？"},{"label":"升级2","jp":"おお…体中に何か神秘的な力が…。","fan":"噢噢…身体里有股神秘的力量…。","off":"啊……感觉身体里有股……神秘的力量~"},{"label":"升级3","jp":"強くなった～のかな～？","fan":"变强了...吗？","off":"是不是……变强一点了~"},{"label":"升级4","jp":"できれば～戦車みたいに強くなりたい。","fan":"可以的话，想变得像坦克一样强。","off":"如果可以……我想变得……和坦克一样强~"},{"label":"获得专武","jp":"これ……私の？","fan":"这是...我的？","off":"这是……给我的……？"}],"事件":[{"label":"学生生日","jp":"今日が私の誕生日…？本当に…？","fan":"今天是我的生日？真的吗？","off":"你说今天是我的生日……？真的嘛？"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\n今日が誕生日っていうことは…\n先生が生まれた日は、今日ってこと？","fan":"生日快乐，老师。\n今天生日的话，也就是说...\n老师是今天这个日子里出生的吗？","off":"生日快乐，老师~今天是你的生日，也就是说……老师是在今天出生的……"},{"label":"万圣节","jp":"カボチャスープ飲みたいな","fan":"想喝南瓜汤…","off":"我想喝……南瓜汤……"},{"label":"新年","jp":"初夢にトマトが出て来たけど…\nこれは、縁起良いのかな？","fan":"初梦里出现了西红柿...\n这是好运的征兆吗？","off":"初梦梦到了番茄……这是好兆头嘛？"},{"label":"圣诞节","jp":"サンタクロースは、誰が悪い子なのか知ってるの？\nそれ…なまはげじゃない？","fan":"圣诞老人知道谁是坏孩子吗？\n那样...不就是生剥鬼了吗？","off":"圣诞老人……知道谁是坏孩子……？那不是……会抓小孩的声波鬼嘛？"},{"label":"春节","jp":"","fan":"新春快乐~期待老师，能在今年给我更多的灵感","off":"新春快乐~期待老师，能在今年给我更多的灵感"},{"label":"中秋","jp":"","fan":"老师，这轮明月又出现了呢。夜色，依然那么美丽呢。","off":"老师，这轮明月又出现了呢。夜色，依然那么美丽呢。"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/19/600669.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/19/208144.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/332339/2026/3/13/756679.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/19/120000.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/103682/2025/5/19/197512.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_