},"ability":{"attrs":[{"name":"生命值","value":"1075"},{"name":"攻击力","value":"97"},{"name":"治愈力","value":"214"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/336820.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/84017.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":""},{"label":"卡池抽取","jp":"あら、自己紹介はしたはずだけど…もしかして覚えてないのかしら？うふふっ。","fan":"我应该已经做过自我介绍了…难道您不记得了吗？","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"いらっしゃい、先生。…こう見えて、結構待ったんだゾ☆","fan":"欢迎您的光临，老师…我可是等了相当久了。","off":""},{"label":"登陆2","jp":"ん？…なんとなく、ここにいただけよぉ。ガイドもいないし、\nあんまり出かけたくなくって。","fan":"嗯？…还是呆在这里好。没有向导，不太想出门。","off":""},{"label":"大厅1","jp":"先生のお仕事って、私が知ってるものと同じようで違うのねぇ。","fan":"老师的工作，和我所熟知的不太一样呢。","off":""},{"label":"大厅2","jp":"お仕事、大変そうねぇ…手伝いましょうか？…もちろん、普通のやり方よぉ。","fan":"您的工作，似乎很不容易…要我帮忙吗？…当然，是用普通的做法。","off":""},{"label":"大厅3","jp":"実はまだ、今も頭がちょっと痛むのよぉ。","fan":"其实，直到现在头还是有些痛。","off":""},{"label":"大厅4","jp":"リモコン…？たしかに大事だけどぉ…別にアレ自体に何かあるわけじゃないのよ？","fan":"遥控器…？那的确是比较重要的东西…但是遥控器本身并没有什么特别之处哦。","off":""},{"label":"大厅5","jp":"そういえばココって何が美味しいのかしらぁ？おすすめのお店、連れてってくれない？","fan":"说起来这里有什么美食吗？能否请您带我去您推荐的店？","off":""},{"label":"回忆大厅1","jp":"…なぁに？どうかしたのかしらぁ。","fan":"…怎么了？您有什么事吗？","off":""},{"label":"回忆大厅2","jp":"いずれにせよ、いつかこうなる事だったと思うのだけど？そうでしょう？","fan":"无论如何，我倒是认为总有一天会变成这个样子。难道不是吗？","off":""},{"label":"回忆大厅3","jp":"…リモコン？…それ、聞いちゃう？ちょっと気配りが足りないかもぉ？","fan":"…遥控器？…您真的要问这个吗？您还是不够善解人意呢。","off":""},{"label":"回忆大厅4","jp":"女の子が話そうとしていないならぁ…無理に聞こうとしちゃダメだゾ☆","fan":"如果女孩子没有打算说出来的话…还要追根究底可是不行的哦。","off":""},{"label":"回忆大厅5","jp":"いい？あなたは何も見ていないし、そもそも何も起きてなかった。…そうよねぇ、先生？","fan":"听好了？您什么都没有看见，说到底什么都没有发生过。…是这样吧，老师？","off":""},{"label":"咖啡馆1","jp":"あら、なかなか可愛いインテリアじゃない？","fan":"相当可爱的装饰。","off":""},{"label":"咖啡馆2","jp":"センスあるじゃない。","fan":"还挺有品味。","off":""},{"label":"咖啡馆3","jp":"面白そうな子が多いわねぇ。","fan":"有很多有趣的孩子呢。","off":""},{"label":"咖啡馆4","jp":"なんだか…落ち着くかも。","fan":"总觉得…平静下来了。","off":""},{"label":"咖啡馆5","jp":"気を使わなくていい場所だからかしら…悪くないわね。","fan":"感觉还不错，是因为处在不会让人心生顾虑的地方吗…","off":""}],"好感度":[{"label":"好感度1","jp":"貴方って、他の人にもこんな感じなの？うふふ、これはきっと、相当の人気力ね。","fan":"您对其他人也是这样吗？这可真是，相当有人气呢。","off":""},{"label":"好感度2","jp":"ん？これも先生だからかしら？","fan":"嗯？这也是因为老师的职责吗？","off":""},{"label":"好感度3","jp":"偶には頭の中を覗ぎたいなぁと思っているのよ～あっ、まだやってないから心配しないで頂戴。","fan":"偶尔也会想看看您的脑海里到底在想什么~啊，还没有这么干过所以不必担心。","off":""},{"label":"好感度4","jp":"ちょっとよそ者相手にやりすぎじゃないかしら？","fan":"您不觉得您对于一个外人，已经做得有些多了吗？","off":""}],"战斗":[{"label":"编入队伍1","jp":"前に出るタイプじゃないんだけどなあ。","fan":"我可是不会出现在台前的那类人。","off":""},{"label":"编入队伍2","jp":"必要って言うなら、やってあげるけど。","fan":"只要你说需要的话，我就会帮你。","off":""},{"label":"拎起","jp":"ん？","fan":"嗯？","off":""},{"label":"任命队长1","jp":"あら？こんな事もするの？","fan":"哦？要让我当队长吗？","off":""},{"label":"任命队长2","jp":"今日は機嫌がよくて助かったわね。","fan":"我今天心情很好，你们真是很走运。","off":""},{"label":"普通技能","jp":"自分で動くタイプじゃないの。","fan":"我可是不会亲自动手的那类人。","off":""},{"label":"EX动画1","jp":"ん～本当に大丈夫？","fan":"嗯~真的没事吗？","off":""},{"label":"EX动画2","jp":"ここまでするつもりはなかったけど。","fan":"虽然没打算做到这种地步。","off":""},{"label":"EX动画3","jp":"本当、しょうがないだから。","fan":"真的是，没办法呢。","off":""},{"label":"EX技能1","jp":"結局こうなっちゃうのよね。","fan":"结果还是变成这样了。","off":""},{"label":"EX技能2","jp":"だから、言ったじゃない？","fan":"所以啊，我不是说了吗？","off":""},{"label":"EX技能3","jp":"好きにやって頂戴？","fan":"放马过来吧。","off":""},{"label":"战斗开始1","jp":"まっ、あくまでお手伝いだしぃ。","fan":"嘛，反正我只是来帮忙而已。","off":""},{"label":"战斗开始2","jp":"ちょっとだけ、やってみようかしら。","fan":"那就先行动起来吧？","off":""},{"label":"获得BUFF","jp":"助かるわ～","fan":"帮大忙了~","off":""},{"label":"施放BUFF","jp":"本気にさせたいのかしら。","fan":"想让我认真起来吗。","off":""},{"label":"掩体","jp":"あらあら。","fan":"阿拉阿拉。","off":""},{"label":"被CC1","jp":"","fan":"","off":""},{"label":"被CC2","jp":"","fan":"","off":""},{"label":"被CC3","jp":"","fan":"","off":""},{"label":"回避","jp":"無駄なことをするのね。","fan":"不过是在做无用功。","off":""},{"label":"队伍移动1","jp":"まだいるの？","fan":"居然还有吗？","off":""},{"label":"队伍移动2","jp":"まだ終わらないの?","fan":"还没完吗……？","off":""},{"label":"回复","jp":"ありがとう。","fan":"感谢。","off":""},{"label":"中途退出","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"角色移动","jp":"","fan":"","off":""},{"label":"战斗胜利1","jp":"余裕力って感じな戦いだったぞ。","fan":"这是一场轻松的战斗。","off":""},{"label":"战斗胜利2","jp":"この借りは、後で全部返してもらいうわよ。","fan":"这份恩情，之后可要还给我哦。","off":""},{"label":"关卡完成1","jp":"結構頑張ったんだけど、何かかご褒美ないのかしら？","fan":"我可是很努力了，难道就没有什么奖励吗？","off":""},{"label":"关卡完成2","jp":"できないっとは言ってないぞ。","fan":"我可没有说我做不到。","off":""},{"label":"战斗失败1","jp":"だから言ったでしょう？","fan":"所以啊，我已经说过了吧？","off":""},{"label":"战斗失败2","jp":"こういうのが得意な子に任せてよね。","fan":"这种事就应该交给专业人士。","off":""}],"成长":[{"label":"升级1","jp":"悪くないかもぉ～それで、私は何をすればいいのかしら？","fan":"这样也不错~所以，我应该做什么？","off":""},{"label":"升级2","jp":"借りは作らない主義だけどぉ、覚えておくわね。","fan":"虽然我信奉不欠人情债的主义，不过，就暂且记下这份恩情吧。","off":""},{"label":"升级3","jp":"頭がすっきりするって感じ？","fan":"这就是突然变得耳聪目明的感觉？","off":""},{"label":"升级4","jp":"なんだか能力使いやすくなったかもぉ。ん？気になるなら試してみる？","fan":"总觉得对能力的使用更熟练了。嗯？要是在意的话，要来试试吗？","off":""},{"label":"获得专武","jp":"あなたも変わってるわねぇ。ああ、悪い意味では無いのよぉ。…普通は頭の中を読んでない相手のことなんて、信じないんだけど…疑ってない程度、って事にしておこうかしら？","fan":"你可真是奇怪。啊啊，没有什么不好的意思…一般来说，我不会信任未经过读心的人…不过，就当作是您还未到值得怀疑的程度吧。","off":""}],"事件":[{"label":"老师生日","jp":"先生のお誕生日よね？どう祝ってあげましょう。…ちなみに、一緒に過ごしたい子とか、いるかしら？","fan":"今天是老师的生日？让我们来一起庆祝吧…顺便一提，您有想和哪个孩子一起过生日吗？","off":""},{"label":"万圣节","jp":"外が騒がしいわね。まあ…ココなら構わないけどぉ。","fan":"外面真是吵闹。不过，在这里的话也没什么关系。","off":""},{"label":"新年","jp":"あけましておめでと、先生。…ココでもこの挨拶で合ってるのかしらぁ？","fan":"新年快乐，老师。…在这里也能用这句问候吗？","off":""},{"label":"圣诞节","jp":"クリスマス、ねぇ…。先生は、何回サンタになったのかしら？","fan":"是圣诞节呢…老师已经扮过几次圣诞老人了？","off":""}],"活动":[{"label":"活动登陆1","jp":"待ってたわよぉ、先生。それじゃ始めましょうか？","fan":"恭候您多时了，老师。那么就开始吧。","off":""},{"label":"活动登陆2","jp":"なにか手伝いましょうかぁ？これはコッチの話だから、協力するゾ☆","fan":"需要我帮忙吗？这是我们这边的事呢，我会帮忙的。","off":""},{"label":"活动大厅1","jp":"へぇ？そういう事しちゃうんだぁ。","fan":"欸，还会做这种事啊。","off":""},{"label":"活动大厅2","jp":"他にやることがあるんじゃなぁい？","fan":"您是不是还有其他的工作？","off":""},{"label":"活动大厅3","jp":"…私の我慢にも限界があるんだゾ☆","fan":"…我的忍耐也是有限度的。","off":""},{"label":"活动大厅4","jp":"…あらあら。これ、大丈夫かしらぁ？","fan":"…这个，没关系吗？","off":""},{"label":"活动事件1","jp":"うまくいってる～？","fan":"进展顺利吗~？","off":""},{"label":"活动事件2","jp":"そろそろ終わりが見えてきたかしら？","fan":"已经能看到终点了。","off":""},{"label":"活动结束","jp":"やり残したことはないか、もう一回確認してみるといいゾ☆","fan":"有没有什么遗漏的事，请再确认一次。","off":""},{"label":"活动任务1","jp":"諦め、って言葉を知らない感じかしらぁ？","fan":"字典里没有放弃这个词语就是这种感觉吗？","off":""},{"label":"活动任务2","jp":"へぇ…？","fan":"欸…？","off":""},{"label":"活动任务每日结束","jp":"","fan":"","off":""},{"label":"活动任务登录1","jp":"進捗を確認してみましょうかぁ。","fan":"来确认一下进度吧。","off":""},{"label":"活动任务登陆2","jp":"確認にきたのねぇ。何か手伝いましょうかぁ？","fan":"您来确认进度了呢。有什么我能帮忙的吗？","off":""},{"label":"活动任务获取1","jp":"なかなか頑張ったんじゃなぁい？褒めてつかわすゾ☆","fan":"这不是相当努力吗？就给您一点奖赏吧。","off":""},{"label":"活动任务获取2","jp":"少しは役に立んじゃなぁい？","fan":"我有帮到您吗？","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/78106.ogg","",""],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/774031.ogg","",""],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/25214.ogg","",""],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/849041.ogg","",""],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/903026.ogg","",""],"大厅及咖啡馆|大厅2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/804206.ogg","",""],"大厅及咖啡馆|大厅3":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/527986.ogg","",""],"大厅及咖啡馆|大厅4":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/250550.ogg","",""],"大厅及咖啡馆|大厅5":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/2