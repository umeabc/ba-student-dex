2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":[]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/72324/2025/5/6/264811.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/6/924188.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/6/660082.png","name":"巧克力蛋包饭","desc":"花凛为了迎接情人节所准备的蛋包饭。用巧克力代替番茄酱画上了爱心，调和了蛋包饭本身风味和巧克力香甜的一道优秀料理。"},"ability":{"attrs":[{"name":"生命值","value":"790"},{"name":"攻击力","value":"126"},{"name":"治愈力","value":"219"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/6/670513.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/6/718664.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 花凛（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/6/631232.png","url":"https://www.gamekee.com/ba/89275.html"},{"name":"1★ 花凛（制服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/6/384549.png","url":"https://www.gamekee.com/ba/645822.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"蔚蓝档案。"},{"label":"卡池抽取","jp":"元々私の主はミレニアムそのものだけど、今日だけは…先生がご主人様だ。","fan":"我曾经的主人是千年学园，只是今天…老师是我的主人。","off":"虽然我真正的主人是千禧年，不过今天，老师是我的主人。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"うん？先生か。…待ってた。","fan":"嗯？老师吗。……我在等您。","off":"嗯？是老师啊，等你很久了。"},{"label":"登陆2","jp":"先生のスケジュールは確認した。今日もよろしく。","fan":"已经确认好了老师的日程安排。今天也请多关照。","off":"老师的日程已经确认了，今天也请多关照。"},{"label":"大厅1","jp":"ターゲット確認。目標を排除する。\n…冗談。隠れなくていいよ。","fan":"目标确认。目标清除。\n……开玩笑。不用吓得躲起来。","off":"目标已锁定，准备歼灭..开玩笑的，不用躲起来的。"},{"label":"大厅2","jp":"問題ない。先生。その件はもうとっくに解決した。","fan":"没问题。老师。这件事已经干净利落地解决了。","off":"没问题，老师，那件事早就解决了。"},{"label":"大厅3","jp":"…どうやって？そ、それは…。…気にしなくても大丈夫だ。","fan":"……怎么办？这、这个啊……。…不用放在心上。","off":"怎么解决的？那个，怎么解决的并不重要。"},{"label":"大厅4","jp":"今日はどんな任務を遂行する？\nなんであれ、私は手伝うよ。","fan":"今天要执行什么任务？不管怎样，我会帮忙的。","off":"今天要执行什么任务？无论什么样的任务，我都会帮您的。"},{"label":"回忆大厅1","jp":"ほ、本当に…こんなことでご褒美になるのか…？\nあ…いや…やっぱり…","fan":"真、真的……这样的奖赏可以吗……？\n啊…没…果然……","off":"这，这样子真的也能算是奖励吗，啊，不是，只是觉得.."},{"label":"回忆大厅2","jp":"恥ずかしすぎる。\nでも、先生がいいなら…。","fan":"太羞耻了。\n但是，老师觉得可以的话……","off":"这样太让人害羞了，不过要是老师喜欢的话。"},{"label":"回忆大厅3","jp":"うん？もっと強く…？わ、わかった。","fan":"嗯？力道更重点……？好、好的。","off":"嗯？再用力点？知、知道了。"},{"label":"回忆大厅4","jp":"先生がいいなら…私も…いい。","fan":"老师觉得行的话…我…都没关系。","off":"老师喜欢的话，那我也喜欢。"},{"label":"回忆大厅5","jp":"ああっ！い、いきなり立たないで！危ないから！","fan":"啊！别、别突然站起来啊！很危险的！","off":"嗯？别、别突然站起来啊，这样很危险的。"},{"label":"咖啡馆1","jp":"可愛いもの？好きだよ。それも、すごく。何か問題が？","fan":"可爱的东西？我很喜欢哦。而且，是非常喜欢。有什么问题吗？","off":"可爱的东西？当然喜欢了，而且是非常喜欢，怎么？有什么问题吗？"},{"label":"咖啡馆2","jp":"ネル先輩やアスナ先輩はいつも先頭に立つから。\n私？彼女たちの背後を守るのが私の役割。","fan":"尼禄前辈和明日奈前辈一直都带领着大家。\n我？守护在她们的身后就是我的使命。","off":"尼禄前辈和明日奈前辈都冲在前线，我？我负责保护她们的身后。"},{"label":"咖啡馆3","jp":"数学の勉強をしなきゃいけない。\nはあ。数字はうんざりだ。","fan":"不得不学习数学呢。\n哈。数字可真讨厌。","off":"还得学数学？嗯 ..看见数字就头疼。"},{"label":"咖啡馆4","jp":"綺麗な場所だ…。私もいつかおしゃれな…\nあっ？き、聞いてた？！","fan":"美丽的地方……我也想有天能变得漂亮…\n啊？您、您听到了？！","off":"这地方好漂亮啊，什么时候我也能..啊？你听见了？"},{"label":"咖啡馆5","jp":"たまには休憩も大事。","fan":"偶尔休息也很重要","off":"偶尔休息一下也是很重要的。"}],"好感度":[{"label":"好感度1","jp":"珍しい気分。こんな気持ちは…初めてだから。","fan":"少有的感觉。这种心情……还是第一次体验。","off":"这种感觉很不一般，这还是我第一次有这种心情。"},{"label":"好感度2","jp":"伝えたい気持ちができた。それを伝えるのがきっと、私にとってもっとも大事な任務になる。","fan":"突然有了想要传达给老师的心情。传达这份心情，对我而言一定是更加重要的任务。","off":"我有一份心意想要传达，把它传达出去，对我来说无疑是最重要的任务。"},{"label":"好感度3","jp":"先生がそばにいるというだけで、特別な気持ちになる。…どうしてだろう。","fan":"老师仅仅是待在我身边，就会有种特殊的感觉。……这是为什么呢。","off":"老师仅仅是在我身边，就让我感觉很特别，为什么呢？"},{"label":"好感度4","jp":"成長してると思う。生徒として、メイドとして、そして…な、なんでもない。","fan":"我觉得我正在成长。作为学生、作为女仆、还有……没、没什么","off":"我认为自己正在成长，作为一个女生，作为一名女仆，还有… 没、没有了。"}],"战斗":[{"label":"编入队伍1","jp":"後方支援を任せて","fan":"后方支援交给我吧","off":"后方支援交给我。"},{"label":"编入队伍2","jp":"狙撃なら、専門だから","fan":"狙击方面，我可是专家","off":"狙击是我的专长。"},{"label":"拎起","jp":"視界、良好。","fan":"视野，良好。","off":""},{"label":"普通技能","jp":"外さない。","fan":"逃不掉的。","off":"不会打偏的。"},{"label":"EX动画1","jp":"ターゲット確認。","fan":"目标确认。","off":"确认目标。"},{"label":"EX动画2","jp":"目標を捉えた。","fan":"捕捉到目标。","off":"目标已捕获。"},{"label":"EX动画3","jp":"私に任せて。","fan":"交给我吧。","off":"交给我。"},{"label":"EX技能1","jp":"先生の敵は逃がさない。","fan":"老师的敌人，别想逃掉。","off":"不会放走老师的敌人。"},{"label":"EX技能2","jp":"任務…開始。","fan":"任务…开始","off":"任务开始。"},{"label":"EX技能3","jp":"一発で吹っ飛ばす。","fan":"一炮轰飞","off":"一枪就让你灰飞烟灭。"},{"label":"战斗开始1","jp":"こちらカリン、ポイント到着","fan":"这里花凛，到达狙击点","off":"这里是花凛，到达指定地点。"},{"label":"战斗开始2","jp":"敵を確認した。全員、作戦開始","fan":"敌人确认。全员，作战开始","off":"已确认敌人，全员行动开始！"},{"label":"特殊载具","jp":"C&Cのヘリの力、見せてあげる","fan":"C&C直升机的力量，就让你见识见识","off":"让你见识一下，C&C直升机的威力。"},{"label":"特殊载具","jp":"02、空中支援を始める","fan":"开始空中支援","off":"呼号ZERO TWO开始空中支援。"}],"成长":[{"label":"升级1","jp":"ありがとう先生。先生がくれたこの力は、C&Cの助けを必要とする人達のために使う。","fan":"谢谢老师。老师给予我的这份力量，我会为了帮助了C&C的重要的人们使用。","off":"谢谢老师，老师给我的这份力量，我会用在需要C&C帮助的那些人身上。"},{"label":"升级2","jp":"この力、先生の為に。","fan":"这份力量，我要为了老师使用。","off":"我会把这力量，献给老师！"},{"label":"升级3","jp":"どんな依頼でも、私に任せて。","fan":"无论是什么样的委托，都交给我吧。","off":"有什么委托尽管交给我吧。"},{"label":"升级4","jp":"訓練は苦いけど、その実は甘いものだ。","fan":"虽然训练很辛苦，但结果很甜蜜。","off":"训练虽然辛苦，但果实是甜蜜的。"},{"label":"获得专武","jp":"戦争の勝率は、武器の発展具合に比例するもの。\n先生、これからの私の活躍を期待してて。","fan":"战争的胜率和武器的先进程度成正比。\n老师，请期待今后我的表现吧。","off":"战争的胜利与武器的发达程度成正比，老师，期待我在未来的活跃吧。"}],"事件":[{"label":"学生生日","jp":"誕生日か…。別に喜ぶようなことではないけど。\n先生が祝ってくれると、特別な気分になるね。","fan":"生日吗……其实也没什么值得高兴的。\n但是如果老师祝我生日快乐的话，就会有种特别的心情。","off":"生日啊？我没觉得这是什么值得高兴的事，\n不过老师这么一祝福我，还真有种特殊的感觉呢。"},{"label":"老师生日","jp":"おめでとう先生。\n無愛想だから…うまく話せないけど。\n先生がここに来てくれて本当に、嬉しい。","fan":"生日快乐老师。\n我是个很冷淡的人……也不会说什么好听的话。\n但是老师能来到这里，我真的很开心。","off":"生日快乐，老师，我这个人不太懂人际交往，\n也不太会说话，不过老师你来了，我是真的很开心。"},{"label":"万圣节","jp":"トリートオアファイアー！飴をくれないと発砲する！\n…あれ？こういうのじゃない？","fan":"不给糖就捣蛋！不给糖的话我就开炮了！\n……啊咧？不该是这样的吗？","off":"不给糖就捣蛋，如果不给我糖，我就要发射导弹了.. 啊，不是这个意思…"},{"la