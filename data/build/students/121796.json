":[{"name":"生命值","value":"675"},{"name":"攻击力","value":"138"},{"name":"治愈力","value":"228"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43758/2025/5/13/147477.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43758/2025/5/13/424374.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"Blue Archive."},{"label":"卡池抽取","jp":"土木、建設、撤去…工務が必要なときは、いつでも呼んでくれ。革命とストライキなら…なお歓迎だ！","fan":"土木、建设、拆迁…需要工务的时候，请随时叫我。 革命和罢工的话…更欢迎！","off":"如果有土木、建筑、拆除等劳务需求，随时都可以联系我。\n如果是革命和罢工，那更是举双手欢迎！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"さあ！今日も安全第一！シャーレ無事故新記録を目指そうではないか！","fan":"今天也是安全第一！以夏莱工事无事故的新纪录为目标！","off":"今天也是安全第一！\n一起挑战沙勒无事故的新记录吧！"},{"label":"登陆2","jp":"遅刻ではないか、サボタージュか？シャーレの先生がサボタージュすることが、一体何の証明になるのか、私には理解できないが。","fan":"不是迟到了，而是偷懒怠工吗？\n虽然我不能理解夏莱的老师偷懒怠工能够证明什么。","off":"啊……知道啦，是消极怠工吗？\n虽然我也不理解，沙勒的老师消极怠工是想证明什么……"},{"label":"大厅1","jp":"安全、よし！確認、よし！無事故、よし！","fan":"安全，OK！确认，OK！无事故，OK！","off":"安全，OK！确认，OK！无事故，OK！"},{"label":"大厅2","jp":"プリンなら何を混ぜでも好きだ！カスタードクリームでも、チョコレートでも、フルーツでも！水を混ぜたプリンは除くかな…","fan":"布丁的话加什么都喜欢！加卡仕达酱也好，加巧克力也好，加水果也好，全部都喜欢！加了水的布丁除外…","off":"不管加什么东西布丁都很好吃！\n可以放卡仕达酱，也可以放巧克力，也可以拌水果……！\n啊……加水除外。"},{"label":"大厅3","jp":"（次回のグーデター名目は何にしようかな？）","fan":"（下次要用什么名目政变呢…）","off":"（下次要用什么名义发起政变呢……？）"},{"label":"大厅4","jp":"先生、夜勤の頻度が高いのでは？時間外手当は、きちんと受け取っているのか？","fan":"老师上夜班是不是太过频繁了？有好好的收取加班费吗？","off":"老师夜班是不是上太多了……？有按标准拿到加班费吗？"},{"label":"大厅5","jp":"先輩は今頃、どうしているのだろう？元気にしているといいのだが。","fan":"不知道前辈现在过得怎么样？要是充满精神就好了。","off":"前辈现在在做什么呢……？希望她一切顺利。"},{"label":"回忆大厅1","jp":"今日は寒いから、遠くまでよく見えるな。\nほら、先生もそこに立ってないで、のぼってこい。","fan":"今天天气比较冷，可以看到很远的地方呢。\n老师也别傻站着了，上来吧。","off":"诶嘿嘿……多亏今天这么冷，远处也能看得清清楚楚。\n来，老师也别在那傻站着了，站上来看看吧。"},{"label":"回忆大厅2","jp":"心配は無用だ！象が登っても壊れないくらい、、頑丈に建ててある。","fan":"不必担心！即使是上来一头大象也不会塌，这里足够结实。","off":"……完全不用担心，这个很结实。\n就算站上一头大象，也没问题！"},{"label":"回忆大厅3","jp":"そう言えばこの足場、あたしたち工務部にどこに似ている気がするな。\n建設に欠かせない重要な資材だが、作業が終わったら、まるで最初から存在しなかったかような消えてしまう。","fan":"说起来这个脚手架，和我们工务部有些像啊。\n虽然是对建筑来说不可或缺的重要器材，等到工事结束后，就仿佛从最初就不曾存在一般就此消失。","off":"说起来……这脚手架和我们工务部很像呢。\n虽然都是建设时不可或缺的重要工具，但每次施工结束后就不见了……\n就好像从来没有出现过一样。"},{"label":"回忆大厅4","jp":"だからなのかな、現場のどの風景より、足場から見下ろすこの景色が私は一番好きだ。建物の端から、更に一歩進んだ先、誰かがこの外壁の外側で、一生懸命に汗を流したという、痕跡の視点","fan":"正因如此，比起现场的种种风景，我还是更喜欢从脚手架之上俯瞰的景色。\n有谁在这高墙之外努力挥洒汗水，才让建筑的顶点延伸在更高的天际线，像这样作为见证者来看待，充满痕迹的视角。","off":"或许正因如此，和现场的任何风景相比，从脚手架上俯瞰的这副景色，才是最美的。\n站在比建筑边缘更远一步的地方，有人在墙外忙碌，并挥洒着自己的汗水。\n每每看到这样的……"},{"label":"回忆大厅5","jp":"完工した建物からは感じることができないこの景色を、私は先生と共有したかった。","fan":"我一直都想把这份从竣工的建筑物中无法感觉到的景色分享给老师。","off":"……这种在竣工的建筑里感受不到的景色，我就想和老师一起分享。"},{"label":"咖啡馆1","jp":"現場の最重要項目は、一に安全、二に安全だ。","fan":"对工地来说，最重要的项目第一是安全，第二还是安全。","off":"在工地上最重要的，第一是安全，第二还是安全！"},{"label":"咖啡馆2","jp":"ここの建築様式は…悪くないだだけ言っておこう…","fan":"这里的建筑样式…还不错…","off":"这里的建筑风格……还算不错。"},{"label":"咖啡馆3","jp":"私たち工務部の手にかかれば、この程度…","fan":"交给我们工务部来做的话，不过是小菜一碟。","off":"如果把这里交给我们工务部的话……小菜一碟。"},{"label":"咖啡馆4","jp":"週3日労働…何て美し響き…","fan":"每周工作三天…多么美妙的话语…","off":"做三休四……这是多么动听的天籁之音呐。"},{"label":"咖啡馆5","jp":"ここのプリンは、事務局にから普及されるものとは違うように思うな。","fan":"这里的布丁，和事务局普及的布丁不太一样啊。","off":"这里的布丁……和事务局供应的布丁看着不太一样诶。"}],"好感度":[{"label":"好感度1","jp":"先生のおかけて、あたしたちの部は、より格好たるものとなった！","fan":"多亏了老师，我们工务部变得更加像样了！","off":"多亏了老师，我们工务部变得更团结了！"},{"label":"好感度2","jp":"先生になら、いつでも背中を任せられるな！","fan":"如果是老师的话，无论何时都可以放心地把背后交出去呢！","off":"如果是老师的话，无论何时我都能放心地把后背交给你的！"},{"label":"好感度3","jp":"この気持ちは…その…革命的だな！","fan":"这份心情…那个…真是富有革命性！","off":"这种感情……该怎么形容……？\n就……啊，革命性质的！"},{"label":"好感度4","jp":"独占だなんで、ブルジョワがやるような悪質な行為だが、先生が相手だと、少し欲が出てしまうな。","fan":"独占什么的，就像是那些资产阶级会做出的恶劣的行为，但是如果独占的对象是老师的话，我的心里，也燃起了些许贪欲呢。","off":"虽然垄断是资本家的恶劣行为，但如果垄断的对象是老师的话……\n……嘿嘿，我也有些贪心呢。"}],"战斗":[{"label":"编入队伍1","jp":"ふむ、今日の現場はどこだ？","fan":"嗯，今天的工地在哪？","off":"嗯……今天的工地现场在哪里？"},{"label":"编入队伍2","jp":"最善を尽くし、労働の価値を証明しよう。","fan":"竭尽全力证明劳动的价值吧。","off":"竭尽全力去证明劳动的价值吧！"},{"label":"拎起","jp":"労働者の権利を！より高らかに叫ぶのだ！","fan":"劳动者的权利！要更加高声地喊出来！","off":""},{"label":"普通技能","jp":"皆！頭上に気を付けろ！","fan":"大家！注意头顶！","off":"大家，当心头顶！！"},{"label":"EX动画1","jp":"低品質なプリンを許すな！","fan":"绝对无法容许低品质布丁的存在！","off":"绝对不能容忍劣质布丁！！"},{"label":"EX动画2","jp":"レッドウィンター連邦学園の事務局は変革せよ！","fan":"要求改革红冬联邦学院事务局！","off":"改革红冬事务局！！"},{"label":"EX动画3","jp":"ストライキを開始する！","fan":"罢工开始！","off":"开始罢工！！"},{"label":"EX技能1","jp":"労働者の権利を！更なる保障を！","fan":"劳动者的权利应得到更进一步的保障！","off":"劳动者应该争取权利！要求保障！！"},{"label":"EX技能2","jp":"全キヴォトスの労働者よ！団結せよ！","fan":"全基沃托斯的劳动者啊！团结起来！","off":"基沃托斯的劳动者，团结起来！！"},{"label":"EX技能3","jp":"志を一つに！恐れることはない！","fan":"团结一心！无所畏惧！","off":"团结一致，我们无所畏惧！！"}],"成长":[{"label":"升级1","jp":"努力と労働の代価として、成長があるのは当然のことだ！","fan":"付出了努力与劳动，获得成长也是理所当然的事情！","off":"既然付出了努力与劳动，那成长也是理所应当的。"},{"label":"升级2","jp":"先生の指導は分かりやすくていい、感謝する！","fan":"老师的指导简单易懂呢，非常感谢！","off":"老师的指导很简单易懂呢，谢谢！"},{"label":"升级3","jp":"革命を成功させるために、啓蒙は必要不可欠だ！","fan":"为了让革命成功，启蒙是不可缺少的！","off":"革命想要成功的话，启蒙是必不可少的！"},{"label":"升级4","jp":"これで次回の作業も、安全に進行できそうだ！","fan":"这样一来下次的作业也能安全进行了！","off":"接下来的工作，也能安全进行了！"},{"label":"获得专武","jp":"丈夫で信頼できる装備こそ、現場のベストパートナーだ。そういう意味で…こいつはあたしを失望させたことがない。","fan":"坚固且可以信用的装备才是工地的最佳拍档。这么说来…这家伙从未让我失望过。","off":"即使有可靠的装备，才是在工地现场的最佳拍档。\n这么说的话，这家伙……从来没让我失望过。"}],"事件":[{"label":"学生生日","jp":"ふふ…先生、今日がなんの日か、分かるか？\nそうだとも。市民が自由を求めて武器を手にし、勇敢に立ち上がった偉大なる記念日！ん…あたしの誕生日…？…あ、忘れてた。","fan":"哼哼…老师，知道今天是什么日子吗？\n今天是市民为了追求自由而拿起武器，勇敢地站起来的伟大的纪念日！\n嗯…？我的生日…？…啊，忘记了。","off":"诶嘿嘿……老师，你知道今天是什么日子吗？\n没~错！今天可是市民们为了追求自由，拿起武器勇敢反抗的伟大纪念日！\n诶……？是我的生日？啊，我忘记了……"},{"label":"老师生日","jp":"おめでとう、先生。今日は、あなたと言うもう一人の同志の生誕を祝おうじゃないか。","fan":"生日快乐。让我们来庆祝一位被叫做“老师”的同志的生日吧。","off":"老师，祝你生日快乐！\n今天，就让我们一起庆祝又一位同志的诞生吧！"},{"label":"万圣节","jp":"過去に、ハロウィン限定のカボチャ混ぜプリンを食べたことがあったが。\n微かな甘みに高級感があって…これがおやつに支給されるなら、週末の仕事も構わないと思ったんだ…\nうひゃっ！？あ、あたしは、今なんて…！？","fan":"曾经吃过加入南瓜的万圣节限定布丁。\n有一种散发着隐隐约约的甜味的高级感…如果能派发这种布丁的话，即便是周末工作也没有关系…\n…！？我、我刚刚说了什么…！？","off":"我曾经吃过万圣节限定的南瓜布丁，味道很高级，有着淡淡的甜味。\n如果能供给这种零食的话，哪怕是周末，我也可以工作！\n……诶？！我，我刚刚说了什么……"},{"label":"新年","jp":"今年こそレッドウィンター連邦学園の事務局を占拠し、労働者にとっての地上の楽園が築けますように！","fan":"今年一定要占领学院的事务局，将其建设为劳动者的地上乐园！","off":"希望今年能占领红冬学院的事务局，把它建设成劳动者的地上乐园！"},{"label":"圣诞节","jp":"良い子にしかプレゼントを配給しないだなんて…サンタクロースめ、やつは悪辣なブルジョワに違いない。","fan":"只会给好孩子发礼物…圣诞老人这家伙，不过是个恶毒的资产阶级罢了。","off":"居然只给好孩子发礼物，圣诞老人那家伙，分明就是恶毒的资本家！"},{"label":"春节","jp":"","fan":"新春，是辞旧迎新的重要日子。\n所以每年春节前后，我们都会用各种手段保证工务部的成员们能顺利拿到工资。\n平平安安回家，开开心心过节。","off":"新春，是辞旧迎新的重要日子。\n所以每年春节前后，我们都会用各种手段保证工务部的成员们能顺利拿到工资。\n平平安安回家，开开心心过节。"},{"label":"中秋","jp":"","fan":"老师，中秋快乐！俗话说，休息是为了更好的劳动。今天，要不要和我一起去工地赏月呢？\n……什么？你说你要加班？\n……岂有此理，我这就去找联邦理事会！","off":"老师，中秋快乐！俗话说，休息是为了更好的劳动。今天，要不要和我一起去工地赏月呢？\n……什么？你说你要加班？\n……岂有此理，我这就去找联邦理事会！"}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/929589.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/463917.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/22/19071253mt4hub4k.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/676678.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/191981/2025/7/3/986312.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/22/72544620mt4hucoy.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/199907.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/366764.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/22/00680165mt4hui3r.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/538031.mp3","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/591016.mp3","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/492704/2026/7/22/29106745mt4hujl5.ogg"],"大厅及咖啡馆|大厅1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/550953.ogg","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/43758/2025/5/20/479931.o