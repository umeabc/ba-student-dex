"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/13/920300.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/137740.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/13/542702.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/13/169100.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/13/94383.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/926540.png","name":"包裝粗糙的手工巧克力","desc":"心菜使用不熟練的動作認真包裝的手工巧克力。本人堅決主張是市售品。被叮嚀過「請絕對要一個人吃！」"},"ability":{"attrs":[{"name":"生命值","value":"1028"},{"name":"攻击力","value":"94"},{"name":"治愈力","value":"322"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/878515.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/227330.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"心奈(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/5/24/44005555mqs11m9z.png","url":"https://www.gamekee.com/ba/710110.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":"blue archive"},{"label":"卡池抽取","jp":"訓育支援部「梅花園」のココナです！\nち、違います！これでもれっきとした教官なんですよ！？","fan":"训育支援部「梅花园」的心奈！\n才、才不是呢！虽然我很小但我可是教官哦？","off":"我是训育支援部梅花园的心奈！\n别……别看我小，我可是正经的教官哦。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生！\nあ、いえ、待ちわびてたとかでは……その、まあ少しは","fan":"欢迎回来，老师！\n啊，不，我才没有在等你……那个，只是有点","off":"老师，欢迎回来！\n没，我没有在等你，就等了一下下而已。"},{"label":"登陆2","jp":"一人前のレディーを待たせるなんて、減点です！","fan":"让一位成熟的淑女等待，真是扣分！","off":"居然让这样一位淑女等你，扣分。"},{"label":"大厅1","jp":"それでは、今日もよろしくお願いしますね。","fan":"那么，今天也请多多关照啦。","off":"那今天也请多多关照。"},{"label":"大厅2","jp":"私だって、いつもちゃんと授業してるんですよ\n……先生も、受けてみますか？","fan":"我的话，可是一直都在认真讲课哦\n……老师，要不要听听看？","off":"我也会讲课，老师要不要听听看？"},{"label":"大厅3","jp":"こ、ココナちゃんって呼ばないでください！\n小さい子みたいじゃないですか！","fan":"请、请不要叫我小心奈！\n不觉得像小孩子吗！","off":"别，别叫我小奈，听着就像在叫小孩子一样。"},{"label":"大厅4","jp":"どうかしましたか？\n……え、呼んだだけ？どういうことですか……","fan":"有什么事吗？\n……诶，只是叫叫我？这样吗……","off":"有什么事吗？就是叫叫我？为什么？"},{"label":"大厅5","jp":"ああもう、突っつかないでください！\n子どもじゃないんですから！","fan":"啊真是的，别再戳我了！\n我已经不是小孩子了！","off":"真是的，不要再戳我了，我又不是小孩子。"},{"label":"回忆大厅1","jp":"その……別に、ニンジンを好きになったわけではありませんからね。","fan":"那个……才不是，喜欢上胡萝卜了哦。","off":"不过，我还是讨厌吃胡萝卜。"},{"label":"回忆大厅2","jp":"せっかく先生と一緒に来たわけですし、一人前の教官として仕方なく食べているだけです。分かりましたか？全く、先生はいつも無理やり……。","fan":"只是难得和老师一起来了，作为独当一面的教官才不得不吃掉而已。明白了吗？真是的，老师总是这样强人所难…","off":"只是难得和老师来一次，而我又是成熟的教官，所以才勉强吃了下去。\n明白了没？真是的，老师总是这样勉强我。"},{"label":"回忆大厅3","jp":"もしどうしてもニンジンを食べないといけない場合は……\n今度からは、ここに来ます。","fan":"假如不论如何都要吃胡萝卜的话……\n下次开始，就来这里吧。","off":"如果我必须吃胡萝卜的话，那下次我们还来这里吧。"},{"label":"回忆大厅4","jp":"先生と一緒に来たお店、ということもありますし……\n良いですか？好きになってはないですよ？分かってます？","fan":"毕竟这也是和老师一起来过的店……\n话说过前头哦？才不是喜欢上了哦？明白了吗？","off":"因为这里是我和老师第一次一起来的地方，好吗？\n我可不是喜欢上了胡萝卜，明白了没？"},{"label":"回忆大厅5","jp":"ただまあ……ニンジンも、そこまで悪くはないかもしれません。","fan":"不过嘛……胡萝卜，可能也没那么糟吧","off":"不过嘛，胡萝卜有时也没那么难吃呢。"},{"label":"咖啡馆1","jp":"これは、一体……？","fan":"这个，到底是……？","off":"这个是做什么的？"},{"label":"咖啡馆2","jp":"何だか変なものがたくさんですね","fan":"总觉得奇怪的东西好多。","off":"感觉好多奇怪的东西。"},{"label":"咖啡馆3","jp":"これ、梅花園にも欲しい……","fan":"这个，梅花园也有就好了……","off":"要是梅花园也有这个就好了。"},{"label":"咖啡馆4","jp":"シュン姉さん、どこに行っちゃったのかな……？","fan":"瞬姐姐，去哪了呢……？","off":"瞬姐姐去哪里了？"},{"label":"咖啡馆5","jp":"これは教育に役立ちそうですね","fan":"这个好像可以用来授课呢。","off":"这个可以用来教导小朋友。"}],"好感度":[{"label":"好感度1","jp":"うん、私は子供じゃありません！何度も言ってるんじゃないですか！","fan":"哼，我才不是小孩子！说过多少遍了！","off":"我说过多少次了，我才不是小孩子"},{"label":"好感度2","jp":"私もいつか、先生みたいに......い、いいえ、何でもないです！","fan":"我什么时候，也能成为像老师一样的......啊、没、没什么！","off":"总有一天我也要成为老师这样的……\n我什么都没说"},{"label":"好感度3","jp":"不思議です。先生と一緒にいると、何だか胸がぽかぽかして","fan":"真奇妙。和老师在一起，不知道为什么，心里暖暖的","off":"好神奇，不知道为什么，只要和老师在一起，我的心里就会觉得暖暖的"},{"label":"好感度4","jp":"私は教官ですが、教官にも先生は必要なんです。","fan":"虽然我是教官，但是教官也是需要老师的。","off":"虽然我是教官，但教官也需要老师"}],"战斗":[{"label":"编入队伍1","jp":"悪くない選択ですね","fan":"不错的选择嘛","off":"不失为一个明智的选择。"},{"label":"编入队伍2","jp":"ココナにお任せください","fan":"交给心奈吧","off":"就交给心奈我吧。"},{"label":"拎起","jp":"お？どうかしましたか？","fan":"噢？怎么了吗？","off":"出什么事了吗？"},{"label":"任命队长1","jp":"さあ、授業の時間です","fan":"好了，到上课的时间了","off":"好，上课时间到。"},{"label":"任命队长2","jp":"教官としての真髄、お見せしましょう","fan":"就让你看看，教官的真正实力","off":"让你见识一下教官的真正实力。"},{"label":"普通技能","jp":"飴ならたくさんありますよ","fan":"糖的话我这里有很多哦","off":"我这里有很多糖。"},{"label":"EX动画1","jp":"さて採点しますよ","fan":"那么开始打分咯","off":"那我就来打分。"},{"label":"EX动画2","jp":"今日の点数は","fan":"这次的分数是","off":"今天的分数是……"},{"label":"EX动画3","jp":"テストを返しますよ","fan":"公布分数噢","off":"要公布成绩了。"},{"label":"EX技能1","jp":"よくできました","fan":"做得真棒","off":"做的很好。"},{"label":"EX技能2","jp":"１００点満点、花丸です","fan":"100分满分，给你盖个小花花","off":"100分，满分，给你一朵小红花。"},{"label":"EX技能3","jp":"次もこの調子で","fan":"下次也要保持这个状态哦","off":"下次也要再接再厉哦。"},{"label":"战斗开始1","jp":"張り切っていきましょう","fan":"打起精神前进吧","off":"打起精神出发吧。"},{"label":"战斗开始2","jp":"私についてきてください","fan":"请跟着我","off":"跟我来。"},{"label":"获得BUFF","jp":"ありがとうございます","fan":"谢谢","off":"谢谢你。"},{"label":"施放BUFF","jp":"ココナの本気、見せてあげます","fan":"让你见识见识，心奈的认真","off":"让你看看心奈的真本事。"},{"label":"掩体","jp":"隠れます","fan":"藏起来了","off":"藏好了。"},{"label":"被CC1","jp":"いた","fan":"痛","off":"痛"},{"label":"被CC2","jp":"あ","fan":"啊","off":"啊"},{"label":"被CC3","jp":"痛いです","fan":"好痛","off":"好痛啊"},{"label":"回避","jp":"それで全力ですか？未熟ですね","fan":"这就是你的全力了吗？真是幼稚呢","off":"这就是你的全力吗？太稚嫩了"},{"label":"队伍移动1","jp":"次の場所へ行きましょう","fan":"前往下一个地方吧","off":"去下个地方。"},{"label":"队伍移动2","jp":"この先には何があるのでしょう","fan":"这前面会有什么呢","off":"前面会有什么呢？"},{"label":"回复","jp":"ありがとうございます","fan":"谢谢","off":"谢谢。"},{"label":"中途退出","jp":"ま、まだ大丈夫です","fan":"我、我没事","off":"我……没事……"},{"label":"战斗喊叫","jp":"","fan":"","off":""},{"label":"战斗喊叫","jp":"行きます","fan":"我上了","off":"我上了。"},{"label":"战斗喊叫","jp":"逃がしません","fan":"别想逃","off":"不准跑。"},{"label":"角色移动","jp":"移動しましょう","fan":"进行移动","off":"我们出发吧。"},{"label":"战斗胜利1","jp":"いい感じですね。次もよろしくお願いします","fan":"不错的感觉。下次也拜托了","off":"感觉很不错呢，下次也拜托啦。"},{"label":"战斗胜利2","jp":"へんへん、当然です。これでも一人前の教官ですから","fan":"哼哼，当然的结果。我可是独当一面的教官啊","off":"哼，那当然，别看我这样，我可是成熟的教官"},{"label":"关卡完成1","jp":"へんへん、これぐらい楽勝です","fan":"哼哼，这点程度，轻松获胜","off":"哼嘿，小事一桩。"},{"label":"关卡完成2","jp":"なんだって、もう一人前ですから","fan":"怎么说我也可以独当一面啊","off":"我已经是独当一面的大人了。"},{"label":"战斗失败1","jp":"うわぁん。つ、つぎこそは……！","fan":"呜呜呜呜......下、下次","off":"下次我一定赢。"},{"label":"战斗失败2","jp":"うわぁん。シュン姉さんに言いつけてやるぅ","fan":"呜呜呜呜......我要去告诉瞬姐姐","off":"我要去找瞬姐姐告状。"}],"成长":[{"label":"升级1","jp":"私はもう一人前ですが、同時にまだまだ成長期です","fan":"虽然我已经足够出色，但同时还在成长中","off":"虽然我已经是独当一面的大人了，但也还在成长中哦。"},{"label":"升级2","jp":"少しは、シュン姉さんみたいになれたでしょうか","fan":"我能不能成为像瞬姐姐一样的人呢","off":"我有没有变得更像瞬姐姐一点呢？"},{"label":"升级3","jp":"我能不能成为像瞬姐姐一样的人呢","fan":"那个......谢谢你","off":"谢谢你老师。"},{"label":"升级4","jp":"人生は学びの連続、と聞いたことがあります！","fan":"我听说，人生就是不断的学习！","off":"我听过一句话叫做学海无涯。"},{"label":"获得专武","jp":"時には厳しく、時には優しく……\nやるべき時にきちんとやれるのが、良い教官だと思います。\n私も、やりますよ！","fan":"宽严相济……\n在该做什么的时候做什么，才是合格的教官。\n我也会践行！","off":"时而严格时而温柔，在正确的时候做好正确的事情，\n我觉得这样才是一名合格的教官，我也会努力这么做的。"}],"事件":[{"label":"学生生日","jp":"あ、私の誕生日……覚えててくれたんですね\nえへへ、ありがとうございます！","fan":"啊，我的生日……您还记得啊\n诶嘿嘿，谢谢你！","off":"我的生日您还记得呀？\n谢谢您。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。\nどうですか、ちゃんと覚えていましたよ。\n……私の誕生日も、覚えてますか？","fan":"生日快乐，老师。\n怎么样，我可是好好记住了哦。\n……我的生日，您也还记得吗？","off":"老师，祝您生日快乐。怎么样？我可是好好记着呢，我的生日你也记着吗？"},{"label":"万圣节","jp":"ハロウィーンの飴、ですか？\nわ、私はもちろんあげる側です！\n教官なので！ですがその、一応飴は嫌いではないので……","fan":"万圣节的糖果，吗？\n我、我当然是发糖的！\n因为我是教官！虽然这样，我也不讨厌糖就是啦……","off":"万圣节糖果？我可是教官，当然是负责发糖果的了，不过我也不讨厌糖果。"},{"label":"新年","jp":"あけましておめでとうございます、先生！\n私は今年も教官として立派に頑張りますので、応援してくれると嬉しいです。\n今年もよろしくお願いします！","fan":"新年快乐，老师！\n今年我也要作为教官好好努力，如果您能支持我的话，我很高兴。\n今年也请多多关照！","off":"老师，祝您新年快乐。\n身为优秀的教官，我今年也会好好努力，希望您能为我加油。"},{"label":"圣诞节","jp":"クリスマス…今年もサンタさんは来るのでしょうか？\nあ、いえ！私は教官なので、楽しみにしてるとかそういうのではなく……！","fan":"圣诞节……今年圣诞老人会来的吧？\n啊、不是！我可是教官，怎么能期待这样的事情呢……！","off":"圣诞节？圣诞老人今年也会来吗？\n不行，我可是教官，才没有期待这种事。"},{"label":"春节","