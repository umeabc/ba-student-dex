72.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 朱音（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/9/866320.png","url":"https://www.gamekee.com/ba/168947.html"},{"name":"★2 朱音","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/9/204800.png","url":"https://www.gamekee.com/ba/66752.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー、アーカイブ。うふふっ。","fan":"碧蓝、档案。嘿嘿~","off":""},{"label":"卡池抽取","jp":"ミレニアムサイエンススクール、コールサインゼロスリー室笠アカネ。生徒としてご挨拶申し上げます。ふふっ、もともと生徒なのですけどね？","fan":"千年科学学园，代号 03，室笠朱音。\n以学生的身份向您致意。\n呵呵，不过我本来就是学生就是了？","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生。「授業の準備」は整えております。","fan":"欢迎回来，老师。“上课的准备” 已经做好了。","off":""},{"label":"登陆2","jp":"本日の「授業」はどの単元でしょうか？\nメリハリのある指導、よろしくおねがいしますね。","fan":"今天的 “课程” 是哪一部分呢？\n请您对我进行张弛有度的指导吧。","off":""},{"label":"大厅1","jp":"先生とご主人様、どちらでお呼びしましょう？\nなるほど……先生をご希望ですか。\n承知しました、「先生」。","fan":"老师，还是主人…… 我该用哪个称呼您好呢？\n原来如此…… 您希望我叫您老师吗。\n我明白了，老师。","off":""},{"label":"大厅2","jp":"「生徒」として先生に接する……なんだか不思議な感覚です。\nもちろん、私は普段から先生の生徒ではあるのですが。","fan":"以 “学生” 的身份面对老师…… 总觉得有种奇妙的感觉。\n当然啦，我本来就一直是老师的学生。","off":""},{"label":"大厅3","jp":"お掃除にも流儀があります。私は少しばかり好みが偏っていますけれど……。\nふふっ。どちらの「お掃除」も、ですね。凝り性なんです。","fan":"打扫也是有讲究的。虽然我的喜好稍微有些特别……\n呵呵。两种 “打扫” 都是呢。我就是有点较真。","off":""},{"label":"大厅4","jp":"ミレニアムの専属教員に、なってくださったりしませんか？\nそうすれば毎日先生の授業を受けられますし……。\n「ミレニアムの先生」いい響きだと思うのですが。","fan":"您愿意…… 成为千年学园的专属老师吗？\n那样的话，我就能每天都听您讲课了……\n“千年学园的老师”，我觉得这个称呼真的很好听。","off":""},{"label":"大厅5","jp":"私は「優等生」と評されることが多いのですが……。人は誰しも内に秘めたものがありますので。冗談ですよ。\n内面までそうとは限りません。人は誰しも内に秘めたものがありますので。冗談ですよ。\nですから――冗談ですよ。\n先生と生徒の火遊びなんて……いかがでしょう？冗談ですよ。","fan":"大家常常说我是 “优等生”……\n但无论是谁，内心都会藏着不为人知的一面哦。开玩笑的。\n所以说 —— 是玩笑啦。\n老师和学生之间的玩火游戏…… 您觉得怎么样？开玩笑的。","off":""},{"label":"回忆大厅1","jp":"ふふっ。\n思っていたより……気恥ずかしいものですね。","fan":"呵呵。\n比我想象的…… 还要让人害羞呢。","off":""},{"label":"回忆大厅2","jp":"自分に対して、素直になる……。\nどうにも慣れない感覚です。","fan":"对自己坦诚一点……\n这种感觉，我怎么也习惯不了。","off":""},{"label":"回忆大厅3","jp":"ええ、仰る通りです。\n私にとって、必要なことだったのだと思います。","fan":"嗯，您说得没错。\n我想，这对我来说是很有必要的事。","off":""},{"label":"回忆大厅4","jp":"先生には色々とご迷惑をおかけしてしまいました。\nそれでも、先生と出会えた私はやはり――\nええ、本当に幸運だったと思っています。","fan":"给老师添了很多麻烦。\n即便如此，能和老师相遇的我果然还是 ——\n嗯，我真的觉得非常幸运。","off":""},{"label":"回忆大厅5","jp":"すべては流れ、いずれ忘れられていくのでしょう。\n今この瞬間でさえ、いつかは……。","fan":"一切都会流逝，最终都会被遗忘吧。\n就连现在这个瞬间，也总有一天会……","off":""},{"label":"回忆大厅6","jp":"ですが、私は覚えています。\nたとえ先生が忘れてしまったとしても。\n本当に大切なものは、決して失われませんから。","fan":"但是，我会记得的。\n就算老师您忘记了也没关系。\n因为真正重要的东西，绝对不会消失。","off":""},{"label":"咖啡馆1","jp":"ひとまずケーキを用意したいところですね。","fan":"先把蛋糕准备好比较好呢。","off":""},{"label":"咖啡馆2","jp":"ここはなんだか落ち着きますね。","fan":"这里总让人觉得很安心。","off":""},{"label":"咖啡馆3","jp":"あの家具、部室にも置きたいですね。","fan":"那件家具，真想也摆在社团活动室里。","off":""},{"label":"咖啡馆4","jp":"（掃除が行き届いてはいますが……詰めが甘いですね）","fan":"（虽然打扫得很干净…… 但细节还是不够到位啊）","off":""},{"label":"咖啡馆5","jp":"（この広さ……必要な爆薬の量は……）","fan":"（这片空间…… 需要的炸药量大概是……）","off":""}],"好感度":[{"label":"好感度1","jp":"ときどき、想像してしまうのです。もしも先生と違う出会い方をしていたら、と。例えば……「同級生」だったのなら……。ふふっ、ですが……やはり先生は「先生」なのでしょうね。","fan":"我偶尔会忍不住想象。\n如果与老师是以另一种方式相遇，会是怎样呢。\n比如说…… 成为 “同班同学” 的话……\n呵呵，不过…… 老师果然还是 “老师” 呢。","off":""},{"label":"好感度2","jp":"制服を着るのは当たり前です。ですが、似合うと言っていただけるのはいつでも嬉しいのですよ？","fan":"穿制服是理所当然的事。\n但每当您说很适合我，我依旧会感到开心哦？","off":""},{"label":"好感度3","jp":"いつもありがとうございます、先生。そして……そして……。ふぅ、覚悟したつもりでしたが、意外と難しいものですね。いえ、ですから、その……お、お慕い申して……おります……。","fan":"一直以来谢谢您，老师。\n然后…… 然后……\n呼，明明已经做好了准备，却意外地很难说出口呢...\n不、所以说…… 那、那个……\n我…… 敬慕…… 您……","off":""},{"label":"好感度4","jp":"放課後、誰も来ない教室があるのですが……お誘いしたら、先生は来てくださるのでしょうか？……ふふっ。冗談です。今は、まだ。","fan":"放学后，有一间谁都不会来的教室……\n如果我邀请您，老师会来吗？\n…… 呵呵。开玩笑的。\n现在…… 还不行。","off":""}],"战斗":[{"label":"编入队伍1","jp":"どちらへ行かれますか？","fan":"请问您要前往何处？","off":""},{"label":"编入队伍2","jp":"ミレニアムの日常をごゆっくりお楽しみください","fan":"请您尽情享受千年学园的日常吧。","off":""},{"label":"拎起","jp":"改まってこうお呼びするのも新鮮ですね。……先生？","fan":"像这样正式地被您呼唤，感觉还真新鲜呢。…… 老师？","off":""},{"label":"普通技能","jp":"さあ、お掃除を始めましょう。","fan":"来吧，开始打扫吧。","off":""},{"label":"EX动画1","jp":"あら、こんにちは？","fan":"哎呀，你好呀？","off":""},{"label":"EX动画2","jp":"こちらにいらっしゃったのですね。","fan":"原来你在这里呀。","off":""},{"label":"EX动画3","jp":"伏せていてくださいね。","fan":"请趴下哦。","off":""},{"label":"EX技能1","jp":"では、仕上げといきましょう。","fan":"那么，来做收尾工作吧。","off":""},{"label":"EX技能2","jp":"本日のお仕事は、こちらで終わり。","fan":"今天的工作，到此结束。","off":""},{"label":"EX技能3","jp":"綺麗に掃除いたしましょう。","fan":"让我把这里打扫干净吧。","off":""}],"成长":[{"label":"升级1","jp":"完璧なメイドとして、文武両道でなければなりません。生徒としても同じく。","fan":"作为完美的女仆，必须文武双全。\n身为学生亦是如此。","off":""},{"label":"升级2","jp":"いつも気にかけてくださりありがとうございます。ご主人様に応えられるよう、尽力いたします。","fan":"谢谢您一直以来的关心。\n我会竭尽全力，回应主人的期待。","off":""},{"label":"升级3","jp":"すべては毎日の積み重ね。もしも、その日常を先生が共にしてくださるとしたら……あるいは、異なる未来が待ち受けているのかもしれません。","fan":"一切都源于日复一日的积累。\n倘若那些日常能与老师一同度过……\n或许，会有截然不同的未来在等待着我们。","off":""},{"label":"升级4","jp":"余裕ができてきたので、新しいお掃除の仕方を考えていたんです。最近は撤去用の爆裂カートリッジを研究していまして……。","fan":"现在总算有了余裕，我正在思考新的清扫方式。\n最近一直在研究用于清理的爆破弹壳……","off":""},{"label":"获得专武","jp":"キヴォトスにおいて、銃は必需品です。それはメイドだろうと、生徒だろうと変わりません。数多ある銃の中……先生から頂戴したこの「掃除道具」と共に、これからも精進いたしますね。","fan":"在基沃托斯，枪械是必需品。\n无论是女仆，还是学生，这一点都不会改变。\n在众多枪械之中…… 我会与老师赠予的这件 “清扫工具” 一同，今后也继续精进。","off":""}],"事件":[{"label":"学生生日","jp":"先生、今日が何の日かご存知ですか？\nそう、私の誕生日です。\nそして今日は「生徒」として伺いました。\n「メイド」では許されずとも、多少はワガママを言っても良いのではないかな、と……。\nですから、プレゼントとして……先生のお時間が、欲しいです。","fan":"老师，您知道今天是什么日子吗？\n没错，是我的生日。\n而且今天，我是以 “学生” 的身份来见您的。\n就算是作为女仆不被允许的任性，稍微任性一点也没关系吧……\n所以，作为礼物…… 我想要老师的时间。","off":""},{"label":"老师生日","jp":"今日は先生のお誕生日ですよね。もちろん覚えています。\nそれで……お祝いは、どちらの私からをご所望ですか？\n生徒？それともメイド？","fan":"今天是老师的生日呢。我当然记得。\n那么…… 您希望是哪一个我来为您庆祝呢？\n学生？还是女仆？","off":""},{"label":"万圣节","jp":"ハロウィーン……お菓子と悪戯があふれる日……。\nそこで今日はお菓子を焼いてきました。\n一緒に召し上がってくださいますよね？","fan":"万圣节…… 满是糖果和恶作剧的日子……\n所以我今天烤了点心过来。\n您会和我一起品尝的吧？","off":""},{"label":"新年","jp":"明けましておめでとうございます、先生。本年もよろしくお願いいたします\n今日の私は「メイド」ではありませんので。\nお堅い挨拶は抜きにして……一緒にお参りに行きませんか？","fan":"新年快乐，老师。今年也请多指教。\n今天的我并不是 “女仆” 哦。\n那些拘谨的问候就免了…… 要不要一起去参拜？","off":""},{"label":"圣诞节","jp":"クリスマス、ですね。もしかして……プレゼントを期待しても？\nふふっ、別に用意されていなくても構いません。\n先生が隣にいてくださるだけで十分ですから。","fan":"圣诞节呢。说不定…… 我可以期待一下礼物？\n呵呵，就算没有准备也没关系。\n只要老师在我身边，就足够了。","off":""}],"活动":[{"label":"活动登陆1","jp":"お待ちしておりました、先生。","fan":"恭候您多时了，老师。","off":""},{"label":"活动登陆2","jp":"行きたい場所があれば、遠慮なく仰ってくださいね。","fan":"如果有想去的地方，请尽管吩咐。","off":""},{"label":"活动大厅1","jp":"こうして先生と時間を過ごせること……。\n私は、それが本当に嬉しいのです。","fan":"能像这样和老师共度时光……\n我真的感到非常开心。","off":""},{"label":"活动大厅2","jp":"お腹が空いたら仰ってくださいね。\n「メイド」の私であれば手料理をご用意するところですが……。\n今は、「生徒」ですから。","fan":"肚子饿了的话请告诉我哦。\n如果是身为「女仆」的我，本会为您亲手料理……\n但现在，我是「学生」。","off":""},{"label":"活动大厅3","jp":"お呼びでしょうか、先生？\n呼んだだけ、ですか……？\nうふふっ、あらあら。","fan":"您在叫我吗，老师？\n只是随便叫一声而已吗……？\n嘻嘻，哎呀哎呀。","off":""},{"label":"活动大厅4","jp":"ふふっ。\n先生は……どうなのか教えていただけますか？","fan":"呵呵。\n老师…… 可以告诉我您的想法吗？","off":""},{"label":"活动事件1","jp":"普段から賑やかですが、今日のミレニアムは一入ですね。\n活気があるのは、良いことですが。","fan":"平时就很热闹，而今天的千年学园更是格外喧嚣呢。\n不过充满活力，也是一件好事。","off":""},{"label":"活动事件2","jp":"いよいよ大詰めですね。","fan":"终于要迎来重头戏了呢。","off":""},{"label":"活动结束","jp":"ミレニアムEXPO、お楽しみいただけましたか？","fan":"千年学园EXPO，您玩得开心吗？","off":""},{"label":"活动结束2","jp":"私は先生とご一緒できて光栄でした。","fan":"能和老师一同度过，我感到十分荣幸。","off":""}]},"voiceAudio":{"通常|标题":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/4/475269.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/7/5/04183682msez51tr.ogg"],"通常|卡池抽取":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/4/66378.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/7/5/57166947msez3rnl.ogg"],"大厅及咖啡馆|登陆1":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/4/641833.ogg","","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/audio/191981/2026/7/5/78946856msez4g9j.ogg"],"大厅及咖啡馆|登陆2":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_0/h_0/829/492704/2026/3/4/818871.mp3","","https://cdnimg-v2.game