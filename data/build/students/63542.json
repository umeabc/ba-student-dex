/cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/835004.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/266843.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","fan":"碧蓝档案。","off":""},{"label":"卡池抽取","jp":"みんなのために歌うバーチャル・シンガー、初音ミクです！よろしくお願いします！","fan":"这里是为大家而歌唱的虚拟歌姬，初音未来！请多多关照！","off":""}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生！\n今日は何の歌が良いですか？","fan":"你好呀，老师！\n今天唱什么歌好呢？","off":""},{"label":"登陆2","jp":"あっ、待ってましたよ、先生！\nさあ、新しいステージの準備を始めましょう！","fan":"啊，我在等你哦，老师！\n那么，开始新舞台的准备吧！","off":""},{"label":"大厅1","jp":"私は元々バーチャル・シンガーですが、このキヴォトスでこうして、自由に歌える身体を貰えました。 お礼と言っては何ですが、私にできることであれば何でも言ってください！","fan":"我本来是没有形态的虚拟歌姬，因为基沃托斯而有了能够自由歌唱的身体。为了表达我的谢意，如果有我能帮上忙的，无论如何请吩咐！","off":""},{"label":"大厅2","jp":"先生のためなら、たくさん歌っちゃいますよ！","fan":"为了老师，我要唱好多好多歌！","off":""},{"label":"大厅3","jp":"今、ミクのこと呼びましたか？","fan":"您刚刚叫我了吗？","off":""},{"label":"大厅4","jp":"首にネギを巻いたら、もっと素敵な声で歌えるんですか……？","fan":"脖子上缠上大葱，唱歌的声音能变得更美妙吗……？","off":""},{"label":"大厅5","jp":"私はバーチャル・シンガー、歌を歌い、そこに込められた想いを届ける存在です！","fan":"我是虚拟歌姬，是将歌曲中蕴含的感情，通过歌声传达给大家的存在！","off":""},{"label":"回忆大厅1","jp":"（みんなが私の歌に、言葉に……耳を傾けてくれてる）","fan":"（大家都在倾听……我的歌、我的话语）","off":""},{"label":"回忆大厅2","jp":"（自分の気持ちを込めて歌うのって、こんなに気持ち良いことだったんだ……！）","fan":"（注入感情地歌唱，这样的感觉真好……！）","off":""},{"label":"回忆大厅3","jp":"（こんな風に、みんなのために歌えるなんて……嬉しい、楽しい……！）","fan":"（能像这样子为了大家而歌唱……好开心，好开心……！）","off":""},{"label":"回忆大厅4","jp":"（このままずっと、ずっと歌っていたい……！）","fan":"（想要一直这样唱下去……！）","off":""},{"label":"咖啡馆1","jp":"素敵なステージ……！","fan":"好漂亮的舞台……！","off":""},{"label":"咖啡馆2","jp":"キヴォトスの技術力って、すごい……！","fan":"基沃托斯的技术力，好厉害……！","off":""},{"label":"咖啡馆3","jp":"～～～♪～～～♪","fan":"啊～♪ 啊～♪","off":""},{"label":"咖啡馆4","jp":"このカフェの音楽、何だか落ち着くなぁ。","fan":"这家咖啡厅放的音乐，总觉得让人很安心呢。","off":""},{"label":"咖啡馆5","jp":"（これ……ネギ？どうして……？）","fan":"（这个是……大葱？为什么……？）","off":""}],"好感度":[{"label":"好感度1","jp":"もっと私と、歌ってくれますか","fan":"能和我一起唱更多的歌吗","off":""},{"label":"好感度2","jp":"なんだか、甘酸っぱい歌を歌いたい気分です","fan":"不知道为什么，好想要唱点酸酸甜甜的歌","off":""},{"label":"好感度3","jp":"先生の気持ちは、確かにここになるって思います","fan":"老师的心情确实传达到了我这里","off":""},{"label":"好感度4","jp":"先生の為に、歌ってもいいですか？","fan":"能为老师而歌唱吗？","off":""}],"战斗":[{"label":"编入队伍1","jp":"私の出番ですか","fan":"到我出场了吗","off":""},{"label":"编入队伍2","jp":"準備は完璧！","fan":"准备完美！","off":""},{"label":"普通技能","jp":"みんなに届け！","fan":"传达给大家！","off":""},{"label":"EX动画1","jp":"お待たせしました！","fan":"久等啦！","off":""},{"label":"EX动画2","jp":"ここからは、私のステージだよ","fan":"开始我的舞台了哟","off":""},{"label":"EX动画3","jp":"本ステージ","fan":"我的主场","off":""},{"label":"EX技能1","jp":"ミュージック、スタート！","fan":"音乐！","off":""},{"label":"EX技能2","jp":"もっともっと楽しくしちゃうよ！","fan":"让我们变得更加更加快乐吧！","off":""},{"label":"EX技能3","jp":"さあ、はじめよ！","fan":"好，开始吧！","off":""}],"成长":[{"label":"升级1","jp":"なんだか胸の奥で、素敵なメロディーが！","fan":"不知道为什么，心底出现了美妙的旋律！","off":""},{"label":"升级2","jp":"ふふ、ありがとうございます。","fan":"呼呼，谢谢。","off":""},{"label":"升级3","jp":"これで、もっともっと素敵な歌を……！","fan":"以后要唱出更多更多美妙的歌曲……！","off":""},{"label":"升级4","jp":"次のステージも、楽しみにしていてくださいね。","fan":"请期待下一次的舞台噢。","off":""},{"label":"获得专武","jp":"これで、もっともっとたくさんの方に、歌を届けてみせます……！","fan":"这样一来，就能为大家献上更多更多的歌曲……！","off":""}],"事件":[{"label":"学生生日","jp":"今日は私にとって、すっごく特別な日……\nこんな大切な日に先生と一緒にいられて……私、幸せです！","fan":"今天对来我说是非常特别的日子……\n能在这么重要的日子和老师在一起……我好幸福！","off":""},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！\n私のお誕生日の歌、聞いてください！\n先生がお望みでしたら、今日は一日中歌っちゃいますよ！","fan":"生日快乐，老师！\n请聆听我为您而唱的生日歌！\n如果老师希望的话，我可以为您唱一整天！","off":""},{"label":"万圣节","jp":"えっと……どなたですか？インタビューでしたら、マネージャーさんを\n通してもらえると……。\n……なんて。ふふっ、ちょっとした悪戯です。だって、今日はハロウィンですから！","fan":"那个……有什么事吗？如果是采访的话，请咨询我的经济人……。\n……开玩笑啦。嘻嘻，浅浅恶作剧一下。因为，今天是万圣节嘛！","off":""},{"label":"新年","jp":"明けましておめでとうございます、先生！\n今年もまた、良い一年にしましょう！","fan":"新年快乐，老师！\n今年也会是很好的一年！","off":""},{"label